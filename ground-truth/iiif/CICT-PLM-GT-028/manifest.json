                "language": "ta",
                "format": "text/plain",
                "value": "ஒழுக்கம்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-028/canvas#xywh=0,234,391,37"
            }
