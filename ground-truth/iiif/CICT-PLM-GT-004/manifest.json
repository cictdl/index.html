                "language": "ta",
                "format": "text/plain",
                "value": "அறன்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-004/canvas#xywh=0,163,416,40"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-004/anno/margin-2",
