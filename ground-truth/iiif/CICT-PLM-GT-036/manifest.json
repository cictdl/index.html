                "language": "ta",
                "format": "text/plain",
                "value": "ணர்தல்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-036/canvas#xywh=0,189,386,37"
            }
