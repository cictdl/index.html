                "language": "ta",
                "format": "text/plain",
                "value": "வறிதல்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-022/canvas#xywh=0,177,395,39"
            }
          ]
        }
