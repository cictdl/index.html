                "language": "ta",
                "format": "text/plain",
                "value": "கேழ்வி"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-042/canvas#xywh=0,204,384,37"
            }
          ]
        }
