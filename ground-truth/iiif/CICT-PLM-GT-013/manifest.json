                "language": "ta",
                "format": "text/plain",
                "value": "அடக்கம்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-013/canvas#xywh=0,217,407,38"
            },
