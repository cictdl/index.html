                "language": "ta",
                "format": "text/plain",
                "value": "புறங்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-019/canvas#xywh=0,206,415,40"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-019/anno/margin-4",
