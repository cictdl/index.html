          "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas/annotations",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-1",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "தவஞ்செய்வார் தங்கருமஞ் செய்வார்மற் றெல்லாம் மவஞ்செய்வா ராசையுடப் பட்டு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,107,2865,39"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-2",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "தவமுந் தவமுயல்வார்க் காகும் மதநை யஃதிலார் மேற்கொள் வது"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,146,2865,38"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-3",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "தந்நுயிர் தான்றப் பெற்றாநை யேநைய மந்நுயி ரெல்லாந் தொழும்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,184,2865,39"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-4",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "ஒந்நாரைத் தேறலு முவந்தாரை யாக்கலும் எண்ணித் தவத்தால் வரும்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,223,2865,38"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-5",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "கூற்றங் குதித்தலுங் கைகூடும நோற்றலின்னா தலைப்பட்ட வர்க்கு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,261,2865,38"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-6",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "சுடச்சுடரும் பொன்போ லொளிவிடுந் துன்பஞ்சுடச்சுட நோகிப் பவர்க்கு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,299,2865,39"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-7",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "உற்றநோய் நீக்கியுயிர்க்குறுகண் செய்யாமையற்றே தவத்திற் குறிப்பு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,338,2865,38"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-8",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "இலர்பலராகிய காரணம் நோற்பார் சிலர்பலர் நோலா தவர்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,376,2865,38"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-9",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "துறந்தார்க்குத் துப்புரவு வேண்டி மறந்தார்கொல் மற்றை யவர்க டவம்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,414,2865,39"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/line-10",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "வேண்டிய வேண்டியாங் கெய்தலாற் செய்தவம் மீண்டு முயலப் படும்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,453,2865,38"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/margin-4",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "தவம்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/canvas#xywh=0,223,401,38"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-027/anno/margin-6",
