      "annotations": [
        {
          "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas/annotations",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-1",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "ஓஒ விநிதெ யெமக்கிந்நோய் செய்தகண் டாஅமிடற்பட்டது"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,127,2888,34"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-2",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "கதுமெனத் தாநோக்கித் தாநெ கலுழும் மகநகத் தக்க துடைத்து"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,161,2888,34"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-3",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "கண்டான் கலுழ்வ தெவன்கொலொ தண்டாநோய் தான்காட்ட யான்கண் டது"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,195,2888,34"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-4",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "தெரிந்துணரா நோக்கிய வொண்கண் பரிந்துணராப் பைதலு ழப்பதெ வன்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,229,2888,33"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-5",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "படலாற்றா றபைதலு ழக்கும் கடலாற்றாற்க் காமநோயுற்ற வென் கண்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,262,2888,34"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-6",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "வாராக்காற்று ஞ்சா வரிற்றுஞ்சா வாயிடை யாரஞரு ற்றந கண்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,296,2888,34"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-7",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "பேணாது பெட்டரு ளர்மந்நொ கொண்கநைக் காணாத மையல கண்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,330,2888,33"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-8",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "பெயலாற்றா நீருலந்த வொண்கண்ணு யலாற்றா வுய்வில்நோயயென் கணிறுத்து"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,363,2888,34"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-9",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "மறைபெறலலூரற் கரிதென்றெ நெம்போல றைபறை கண்ணா கத்து"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,397,2888,34"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/line-10",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "உழந்துழந் துண்ணீரறுக விழைந்திழைந்து வேண்டி யவற்கண்ட கண்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,431,2888,34"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/margin-4",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "கண்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,229,404,33"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/margin-5",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "விதுப்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/canvas#xywh=0,262,404,34"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-118/anno/margin-6",
