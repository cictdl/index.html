                "language": "ta",
                "format": "text/plain",
                "value": "மை"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-034/canvas#xywh=0,209,381,36"
            }
          ]
