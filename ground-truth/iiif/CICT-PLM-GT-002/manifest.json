      "annotations": [
        {
          "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas/annotations",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-1",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "வானின்றுலகம் வழங்கி வருதலாற் றானமுர்த மென்று ணுரப் பாற்று"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,46,2870,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-2",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "துப்பார்க்குத் துப்பாய துப்பாக்கித் துப்பார்க்குத் துப்பாய தூஉம் மழை"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,78,2870,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-3",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "விண்ணின்று பொய்ப்பின் விரிநீர் வியநுலகத் துண்ணின் றுடற்றும்பசி"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,110,2870,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-4",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "ஏரி னுழாஅ ருழவர் புயலெந்நும் வாரி வளங்குன்றியக்கால்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,142,2870,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-5",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "கெடுப்பதூஉங் கெட்டார்க்குச் சார்வாய்மற் றாங் கெப்பதூஉ மெல்லாமழை"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,174,2870,33"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-6",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "விசும்பிற் றுளிவீழி னல்லான்மற் றாங்கே பசும்புற் றலைகாண்பரிது"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,207,2870,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-7",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "நெடுங்கடலுந் தன்னீர்மை குன்றுந் தடிந்தெழிலி தானல்கா தாகி விடின்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,239,2870,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-8",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "சிறப்பொடு பூசநை செல்லாது வாநம் வறக்குமேல் வானோர்க்கு மீண்டு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,271,2870,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-9",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "தாநம் தவமிரண்டுந் தங்கா வியநுலகம் வாநம் வழங்கா தெநின்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,303,2870,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/line-10",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "நீரின் றமையா துலகெனின் யார்யார்க்கும் வாநின் றமையா தொளுக்கு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,335,2870,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/margin-3",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "வான்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/canvas#xywh=0,110,402,32"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-002/anno/margin-4",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
