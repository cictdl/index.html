      "annotations": [
        {
          "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas/annotations",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-1",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "ஒற்றுமு றைசான்ற நூலுமி வையிரண்டுந் தெற்றென்க மந்நவன் கண்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,72,2624,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-2",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "எல்லார்க்குமெ ல்லா நிகழ்பவை யெஞ்ஞான்றும் வல்லறிதல் வேந்தன் றொழில்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,107,2624,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-3",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "ஒற்றினானொ ற்றிப் பொரு டேராமந்நவன் கொற்றங் கொளக்கிடந்ததில்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,142,2624,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-4",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "ஒற்றறித் தந்த பொருளையு மற்றுமோர் ஒற்றிநானொ ற்றிக் கொள்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,177,2624,36"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-5",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "ஒற்றெற் றுணராமை யாள்க வுடன்மூவர் சொற்றொக்க தேறப் படும்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,213,2624,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-6",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "சிறப்பாய வொற்றின்கட் செய்யற்கச் செய்யின் புலப்படுத்தானாகும் மிறை"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,248,2624,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-7",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "கடாஅ வுருவோடு கண்ணஞ்சாதி யாண்டுமு காஅமை வல்லதெ ஒற்று"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,283,2624,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-8",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "துறந்தார் படிவத்த தாகி யிறந்தாராய்ந்தெ ன்செயிநுஞ் சோர்விரதொ ற்று"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,318,2624,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-9",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "மறந்தவை கேட்கவற் றாகி யறிந்தவை ஐயப்பாடி ல்லதெ ஒற்று"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,353,2624,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/line-10",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "விநைசெய்வார் தன்சுற்றம் வேண்டாதாரெ ன்றாங்க ளைவரையுமா ராய்வா ஒற்று"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,388,2624,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/margin-3",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "ஒற்றா"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/canvas#xywh=0,142,367,35"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-059/anno/margin-4",
