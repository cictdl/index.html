                "language": "ta",
                "format": "text/plain",
                "value": "நிலமை"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-012/canvas#xywh=0,245,398,35"
            }
          ]
