                "language": "ta",
                "format": "text/plain",
                "value": "உறுப்பு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-124/canvas#xywh=0,242,394,37"
            },
            {
