                "language": "ta",
                "format": "text/plain",
                "value": "புல்லறி"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-085/canvas#xywh=0,193,402,38"
            },
