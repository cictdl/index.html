                "language": "ta",
                "format": "text/plain",
                "value": "சேர்ந்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-070/canvas#xywh=0,219,373,37"
            },
