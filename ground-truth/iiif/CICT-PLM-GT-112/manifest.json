                "language": "ta",
                "format": "text/plain",
                "value": "ரைத்தல்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-112/canvas#xywh=0,303,392,35"
            }
          ]
        }
