                "language": "ta",
                "format": "text/plain",
                "value": "அறிதல்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-050/canvas#xywh=0,225,394,38"
            }
