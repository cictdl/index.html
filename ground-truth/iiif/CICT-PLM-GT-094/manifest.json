      "annotations": [
        {
          "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas/annotations",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-1",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "அகடாராரல்லலு ழப்பர்சூ தெந்நு முகடியால் மூடப் பட்டார்க்கு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,77,2871,36"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-2",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "சிறுமை பலசெய்து சீரிழக்கும் சூதின் வறுமை தருவதொன்றில்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,113,2871,37"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-3",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "பொருள் கெடுத்துப் பொய்மேற் கொளிஇ யருள்கெடுத்து அல்லலு ழப்பிக்குஞ் சூது"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,150,2871,37"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-4",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "பளகிய செல்வமும் பண்புங் கெடுக்குங் கழகத்துக் காலை புகின்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,187,2871,37"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-5",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "கவறுங் கழகமுங் கையுந் தருக்கி லிவறியார் யில்லாகி யார்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,224,2871,37"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-6",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "உருளாயம்மொவ் வாது கூறின் றிற் பொருளாயம் போஒய்ப் புறமெ படும்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,261,2871,37"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-7",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "வேண்டர்க வேண்டிநுஞ் சூதிநை வென்றதாற்றூண் டிற்பொன் மீன்விளுங்கி யற்று"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,298,2871,37"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-8",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "ஒன்றெய்தி நூறிழக்குஞ் சூதிற்குமு ண்டாங்கொல் நன்றெய்தி வாழ்வதோராறு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,335,2871,37"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-9",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "இழை த்தொறுங் காதலிக்குஞ் சூதெபோற் றுன்பமு ழைத்தொறுங் காதற்று யிர்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,372,2871,37"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/line-10",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
                "type": "TextualBody",
                "language": "ta",
                "format": "text/plain",
                "value": "உடைசெல்வம் மூணொளி கல்வியென்றை ந்தும டையாவாமா யங் கொளில்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/canvas#xywh=0,409,2871,37"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-094/anno/margin-4",
              "type": "Annotation",
              "motivation": "supplementing",
              "body": {
