                "language": "ta",
                "format": "text/plain",
                "value": "படர்"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-117/canvas#xywh=0,205,398,29"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-117/anno/margin-5",
