                "language": "ta",
                "format": "text/plain",
                "value": "ச்சு"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-064/canvas#xywh=0,264,379,38"
            }
          ]
        }
