                "format": "text/plain",
                "value": "அறி"
              },
              "target": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-043/canvas#xywh=0,173,396,39"
            },
            {
              "id": "https://www.digitalarchives.cict.in/ground-truth/iiif/CICT-PLM-GT-043/anno/margin-4",
