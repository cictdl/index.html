        <Coords points="0,219 2900,219 2900,252 0,252" />
        <Baseline points="0,246 2900,246" />
        <TextEquiv>
          <Unicode>கோட்டுப்புச் சூடினுங் காயு மொருத்தினயக் காட்டி மறைததிரொ வென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;} ilakkanam {kural:1317;verification:verified;words:வழுத்தினாள்=தெரிநிலைவினைமுற்று|தும்மினேன்=தெரிநிலைவினைமுற்று|ஆக=அசைநிலை|அழித்து=வினையெச்சம்|அழுதாள்=தெரிநிலைவினைமுற்று|யார்=வினாப்பெயர்|உள்ளி=வினையெச்சம்|தும்மினீர்=தெரிநிலைவினைமுற்று|என்று=வினையெச்சம்;ani:சொற்பொருட்பின்வருநிலை;edugai:ழு/ா;eetruseer:என்று;}" comments="kural=1317; numeral=௬">
