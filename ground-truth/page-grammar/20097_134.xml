        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:1203;verification:verified;words:நினைப்பவர்=வினையாலணையும்பெயர்|போன்று=வினையெச்சம்|நினையார்=எதிர்மறைவினைமுற்று|கொல்=வினாஇடை|தும்மல்=தொழிற்பெயர்|சினைப்பது=வினையாலணையும்பெயர்|போன்று=வினையெச்சம்|கெடும்=தெரிநிலைவினைமுற்று;ani:எடுத்துக்காட்டுவமை;edugai:னை;eetruseer:பிறப்பு;}" comments="kural=1203; numeral=௨">
        <Coords points="0,127 2960,127 2960,163 0,163" />
        <Baseline points="0,157 2960,157" />
        <TextEquiv>
          <Unicode>நிநைப்பது  பொன்று நிநையார் கொறும்மல் சிநைப்பது போன்று கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
