        <TextEquiv>
          <Unicode>எநைத்து நிநைப்பினுங் காயாரநைத்தன்றொ  காதலர் செய்யுஞ் சிறப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;} ilakkanam {kural:1201;verification:verified;words:உள்ளினும்=வினையெச்சம்|தீராப்=எதிர்மறைபெயரெச்சம்|பெரு=பண்புப்பெயர்|மகிழ்=பண்புப்பெயர்|செய்தலால்=தொழிற்பெயர்|கள்ளினும்=பொருட்பெயர்|காமம்=பண்புப்பெயர்|இனிது=குறிப்புவினைமுற்று;togai:பெருமகிழ்=பண்புத்தொகை;ani:உயர்வுநவிற்சி;edugai:ள்;eetruseer:காசு;}" comments="kural=1201; numeral=௪">
