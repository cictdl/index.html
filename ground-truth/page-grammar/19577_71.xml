        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;} ilakkanam {kural:681;verification:verified;words:அன்புடைமை=பண்புப்பெயர்|ஆன்ற=பெயரெச்சம்|குடிப்பிறத்தல்=தொழிற்பெயர்|வேந்து=பொருட்பெயர்|அவாம்=பெயரெச்சம்|பண்புடைமை=பண்புப்பெயர்|தூது=பொருட்பெயர்|உரைப்பான்=வினையாலணையும்பெயர்|பண்பு=பண்புப்பெயர்;ani:சொற்பொருட்பின்வருநிலை;edugai:ன்/ண்;eetruseer:பிறப்பு;}" comments="kural=681; numeral=௬">
