        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:1167;verification:verified;words:காமம்=பண்புப்பெயர்|கடும்=உரிச்சொல்|புனல்=பொருட்பெயர்|நீந்தி=வினையெச்சம்|கரை=இடப்பெயர்|காணேன்=எதிர்மறைவினைமுற்று|யாமத்து=காலப்பெயர்|உம்=உம்மை|யான்=சுட்டுப்பெயர்|ஏ=ஏகாரம்|உளேன்=குறிப்புவினைமுற்று;togai:கடும்புனல்=பண்புத்தொகை;ani:உருவகம்;edugai:ா;eetruseer:உளேன் — மலர் வாய்பாடு;}" comments="kural=1167; numeral=௯">
