        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;} ilakkanam {kural:902;verification:verified;words:பேணாது=எதிர்மறைவினையெச்சம்|பெண்=பொருட்பெயர்|விழைவான்=வினையாலணையும்பெயர்|ஆக்கம்=பண்புப்பெயர்|பெரிய=பண்புப்பெயர்|ஓர்=எண்ணுப்பெயர்|நாண்=பண்புப்பெயர்|ஆக=அசைநிலை|நாணு=பண்புப்பெயர்|தரும்=தெரிநிலைவினைமுற்று;togai:பெண்விழைவான்=வேற்றுமைத்தொகை;ani:சொற்பொருட்பின்வருநிலை;edugai:ணா/ணா;eetruseer:தரும் (மலர் வாய்பாடு);}" comments="kural=902; numeral=௭">
