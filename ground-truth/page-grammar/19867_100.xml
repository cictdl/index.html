      <TextLine id="r_main_l1" custom="readingOrder {index:0;} ilakkanam {kural:978;verification:verified;words:பணியும்=தெரிநிலைவினைமுற்று|ஆம்=அசைநிலை|என்றும்=காலப்பெயர்|பெருமை=பண்புப்பெயர்|சிறுமை=பண்புப்பெயர்|அணியும்=தெரிநிலைவினைமுற்று|ஆம்=அசைநிலை|தன்னை=சுட்டுப்பெயர்|வியந்து=வினையெச்சம்;ani:முரண்;edugai:ணி;eetruseer:மலர்;}" comments="kural=978; numeral=௧">
        <Coords points="0,82 2832,82 2832,121 0,121" />
        <Baseline points="0,114 2832,114" />
        <TextEquiv>
          <Unicode>பணியுமாமெ ன்றும் பெருமை சிறுமை யணியுமாந் தந்நை வியந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:979;verification:verified;words:பெருமை=பண்புப்பெயர்|பெருமிதம்=பண்புப்பெயர்|இன்மை=பண்புப்பெயர்|சிறுமை=பண்புப்பெயர்|பெருமிதம்=பண்புப்பெயர்|ஊர்ந்து=வினையெச்சம்|விடல்=தொழிற்பெயர்;ani:முரண்,சொற்பொருட்பின்வருநிலை;edugai:ரு;eetruseer:மலர்;}" comments="kural=979; numeral=௨">
        <Coords points="0,121 2832,121 2832,160 0,160" />
        <Baseline points="0,153 2832,153" />
        <TextEquiv>
          <Unicode>பெருமை பெருமிதமி ன்மைசி சிறுமை பெருமித மூர்ந்து விடும்</Unicode>
        </TextEquiv>
      </TextLine>
