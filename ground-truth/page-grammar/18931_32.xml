        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;} ilakkanam {kural:297;verification:verified;words:பொய்யாமை=தொழிற்பெயர்|பொய்யாமை=தொழிற்பெயர்|ஆற்றின்=வினையெச்சம்|அறம்=பொருட்பெயர்|பிற=பொருட்பெயர்|செய்யாமை=தொழிற்பெயர்|செய்யாமை=தொழிற்பெயர்|நன்று=குறிப்புவினைமுற்று;ani:மடக்கு;edugai:ய்;eetruseer:நன்று (காசு);}" comments="kural=297; numeral=௭">
        <Coords points="0,296 2690,296 2690,333 0,333" />
        <Baseline points="0,327 2690,327" />
        <TextEquiv>
          <Unicode>பொய்யாமை பொய்யாமை யாற்றின் அறம்பிற செய்யாமை செய்யாமை நன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:298;verification:verified;words:புறம்=இடப்பெயர்|தூய்மை=பண்புப்பெயர்|நீரான்=பொருட்பெயர்|அமையும்=தெரிநிலைவினைமுற்று|அகம்=இடப்பெயர்|தூய்மை=பண்புப்பெயர்|வாய்மையால்=பண்புப்பெயர்|காண=வினையெச்சம்|படும்=தெரிநிலைவினைமுற்று;togai:புறள்தூய்மை=பண்புத்தொகை|அகந்தூய்மை=பண்புத்தொகை;ani:முரண்,எடுத்துக்காட்டுவமை;eetruseer:படும் (காசு);}" comments="kural=298; numeral=௮">
