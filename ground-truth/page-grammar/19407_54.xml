        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;} ilakkanam {kural:518;verification:verified;words:வினைக்கு=தொழிற்பெயர்|உரிமை=பண்புப்பெயர்|நாடிய=பெயரெச்சம்|பின்றை=காலப்பெயர்|அவனை=சுட்டுப்பெயர்|அதற்கு=சுட்டுப்பெயர்|உரிய=பெயரெச்சம்|ஆக=வினையெச்சம்|செயல்=வியங்கோள்வினைமுற்று;edugai:னை/த;eetruseer:மலர்;}" comments="kural=518; numeral=௪">
