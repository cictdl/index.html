        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:513;verification:verified;words:அன்பு=பண்புப்பெயர்|அறிவு=பண்புப்பெயர்|தேற்றம்=தொழிற்பெயர்|அவா=பண்புப்பெயர்|இன்மை=தொழிற்பெயர்|இ=சுட்டுப்பெயர்|நான்கு=எண்ணுப்பெயர்|உம்=உம்மை|நன்கு=உரிச்சொல்|உடையான்=வினையாலணையும்பெயர்|கண்=வேற்றுமைஉருபு|ஏ=ஏகாரம்|தெளிவு=தொழிற்பெயர்;togai:அன்பறிவு=உம்மைத்தொகை;ani:சொற்பொருட்பின்வருநிலை;edugai:ன்;eetruseer:மலர்;}" comments="kural=513; numeral=௨">
