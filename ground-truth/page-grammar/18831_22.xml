          <Unicode>பயநில பல்லார்முற் சொல்லல் நயநில நட்டார்கட் செய்தலிற் றீது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:200;verification:verified;words:சொல்லுக=வியங்கோள்வினைமுற்று|சொல்லில்=தொழிற்பெயர்|பயன்=பொருட்பெயர்|உடைய=பெயரெச்சம்|சொல்லற்க=வியங்கோள்வினைமுற்று|சொல்லில்=தொழிற்பெயர்|பயனிலா=எதிர்மறைபெயரெச்சம்|சொல்=தொழிற்பெயர்;ani:மடக்கு,முரண்;edugai:ல்;eetruseer:மலர்;}" comments="kural=200; numeral=௮">
        <Coords points="0,453 2863,453 2863,491 0,491" />
        <Baseline points="0,484 2863,484" />
        <TextEquiv>
          <Unicode>சொல்லுக சொல்லிற் பயனுடைய சொல்லற்கச் சொல்லிற் பயநிலாச் சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:197;verification:verified;words:நயனில=எதிர்மறைபெயரெச்சம்|சொல்லினும்=வினையெச்சம்|உம்=உம்மை|சொல்லுக=வியங்கோள்வினைமுற்று|சான்றோர்=வினையாலணையும்பெயர்|பயனில=எதிர்மறைபெயரெச்சம்|சொல்லாமை=தொழிற்பெயர்|நன்று=குறிப்புவினைமுற்று;edugai:ய;eetruseer:மலர்;}" comments="kural=197; numeral=௯">
