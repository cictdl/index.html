        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;} ilakkanam {kural:192;verification:verified;words:பயனில=எதிர்மறைபெயரெச்சம்|பல்லார்=பண்புப்பெயர்|முன்=இடப்பெயர்|சொல்லல்=தொழிற்பெயர்|நயனில=எதிர்மறைபெயரெச்சம்|நட்டார்=வினையாலணையும்பெயர்|கண்=வேற்றுமைஉருபு|செய்தல்=தொழிற்பெயர்|இன்=வேற்றுமைஉருபு|தீது=குறிப்புவினைமுற்று;ani:சொற்பொருட்பின்வருநிலை;eetruseer:காசு;}" comments="kural=192; numeral=௭">
