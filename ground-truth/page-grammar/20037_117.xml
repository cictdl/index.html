        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:1150;verification:verified;words:தாம்=சுட்டுப்பெயர்|வேண்டின்=வினையெச்சம்|நல்குவர்=தெரிநிலைவினைமுற்று|காதலர்=வினையாலணையும்பெயர்|யாம்=சுட்டுப்பெயர்|வேண்டும்=பெயரெச்சம்|கெளவை=தொழிற்பெயர்|எடுக்கும்=தெரிநிலைவினைமுற்று|இவ்=சுட்டுப்பெயர்|ஊர்=இடப்பெயர்;edugai:ா(ம்)/ெ(ள);eetruseer:நாள்;}" comments="kural=1150; numeral=௮">
