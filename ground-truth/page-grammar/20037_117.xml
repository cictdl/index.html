        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:1147;verification:verified;words:ஊரவர்=வினையாலணையும்பெயர்|கெளவை=தொழிற்பெயர்|எரு=பொருட்பெயர்|ஆக=வினையெச்சம்|அன்னை=பொருட்பெயர்|சொல்=தொழிற்பெயர்|நீர்=பொருட்பெயர்|ஆக=வினையெச்சம்|நீளும்=பெயரெச்சம்|இந்=சுட்டுப்பெயர்|நோய்=பண்புப்பெயர்;togai:அன்னைசொல்=வேற்றுமைத்தொகை;ani:உருவகம்;edugai:ர;eetruseer:காசு;}" comments="kural=1147; numeral=௯">
