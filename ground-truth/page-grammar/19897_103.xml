        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;} ilakkanam {kural:1005;verification:verified;words:கொடுப்பது=வினையாலணையும்பெயர்|உம்=உம்மை|துய்ப்பது=வினையாலணையும்பெயர்|உம்=உம்மை|இல்லார்க்கு=வினையாலணையும்பெயர்|அடுக்கிய=பெயரெச்சம்|கோடி=எண்ணுப்பெயர்|உண்டு=குறிப்புவினைமுற்று|ஆயினும்=வினையெச்சம்|இல்=எதிர்மறைஇடை;ani:சொற்பொருட்பின்வருநிலை;edugai:ட்;eetruseer:இல்;}" comments="kural=1005; numeral=௪">
        <Coords points="0,201 2783,201 2783,239 0,239" />
