        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;} ilakkanam {kural:743;verification:verified;words:உயர்வு=பண்புப்பெயர்|அகலம்=பண்புப்பெயர்|திண்மை=பண்புப்பெயர்|அருமை=பண்புப்பெயர்|இ=சுட்டுப்பெயர்|நான்கு=எண்ணுப்பெயர்|இன்=சாரியை|அமைவு=தொழிற்பெயர்|அரண்=பொருட்பெயர்|என்று=வினையெச்சம்|உரைக்கும்=பெயரெச்சம்|நூல்=பொருட்பெயர்;togai:உயர்வகலம்=உம்மைத்தொகை;ani:சொற்பொருட்பின்வருநிலை;edugai:ய/மை;eetruseer:நாள்;}" comments="kural=743; numeral=௩">
        <Coords points="0,160 2700,160 2700,197 0,197" />
        <Baseline points="0,190 2700,190" />
        <TextEquiv>
          <Unicode>உயர்வகலந் திண்மை யருமையிந் நான்கின் நமைவுவரண் யென்றுரைக்கும் நூல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;} ilakkanam {kural:746;verification:verified;words:எல்லா=பண்புப்பெயர்|பொருள்=பொருட்பெயர்|உம்=உம்மை|உடைத்தாய்=வினையெச்சம்|இடத்து=காலப்பெயர்|உதவும்=பெயரெச்சம்|நல்=பண்புப்பெயர்|ஆள்=பொருட்பெயர்|உடையது=வினையாலணையும்பெயர்|அரண்=பொருட்பெயர்;togai:நல்லாள்=பண்புத்தொகை;edugai:ல்;eetruseer:காசு;}" comments="kural=746; numeral=௪">
