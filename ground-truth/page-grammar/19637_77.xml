        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:742;verification:verified;words:மணிநீர்=பொருட்பெயர்|உம்=உம்மை|மண்=இடப்பெயர்|உம்=உம்மை|மலை=இடப்பெயர்|உம்=உம்மை|அணி=பண்புப்பெயர்|நிழல்=பொருட்பெயர்|காடு=இடப்பெயர்|உம்=உம்மை|உடைய=பெயரெச்சம்|அது=வினையாலணையும்பெயர்|அரண்=பொருட்பெயர்;togai:மணிநீரும்=உவமைத்தொகை|அணிநிழற்=பண்புத்தொகை;ani:உவமை;edugai:ணி/ா;eetruseer:காசு;}" comments="kural=742; numeral=௨">
        <Coords points="0,124 2700,124 2700,160 0,160" />
        <Baseline points="0,154 2700,154" />
        <TextEquiv>
