        <Baseline points="0,295 2754,295" />
        <TextEquiv>
          <Unicode>மந்நதூய்மை செய்விநை தூய்மை யிரண்டும் யினந்தூய்மை துவா வரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;} ilakkanam {kural:453;verification:verified;words:மனத்தான்=பொருட்பெயர்|ஆம்=தெரிநிலைவினைமுற்று|மாந்தர்க்கு=பொருட்பெயர்|உணர்ச்சி=தொழிற்பெயர்|இனத்தான்=பொருட்பெயர்|ஆம்=தெரிநிலைவினைமுற்று|இன்னான்=சுட்டுப்பெயர்|எனப்படும்=பெயரெச்சம்|சொல்=பொருட்பெயர்;ani:சொற்பொருட்பின்வருநிலை;edugai:ன/ன;eetruseer:பிறப்பு;}" comments="kural=453; numeral=௭">
        <Coords points="0,302 2754,302 2754,339 0,339" />
        <Baseline points="0,333 2754,333" />
