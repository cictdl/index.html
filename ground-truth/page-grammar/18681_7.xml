        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:49;verification:verified;words:அறன்=பண்புப்பெயர்|என=வினையெச்சம்|பட்டது=வினையாலணையும்பெயர்|ஏ=ஏகாரம்|இல்=இடப்பெயர்|வாழ்க்கை=தொழிற்பெயர்|அஃது=சுட்டுப்பெயர்|உம்=உம்மை|பிறன்=பொருட்பெயர்|பழிப்ப=பெயரெச்சம்|அது=சுட்டுப்பெயர்|இல்லாயின்=எதிர்மறைவினையெச்சம்|நன்று=குறிப்புவினைமுற்று;togai:இல்வாழ்க்கை=வேற்றுமைத்தொகை;edugai:ற;eetruseer:காசு;}" comments="kural=49; numeral=௯">
