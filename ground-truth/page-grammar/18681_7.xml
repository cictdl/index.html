        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:42;verification:verified;words:துறந்தார்=வினையாலணையும்பெயர்|கு=வேற்றுமைஉருபு|உம்=உம்மை|துவ்வாதவர்=வினையாலணையும்பெயர்|கு=வேற்றுமைஉருபு|உம்=உம்மை|இறந்தார்=வினையாலணையும்பெயர்|கு=வேற்றுமைஉருபு|உம்=உம்மை|இல்வாழ்வான்=வினையாலணையும்பெயர்|என்பான்=வினையாலணையும்பெயர்|துணை=பொருட்பெயர்;ani:சொற்பொருட்பின்வருநிலை;eetruseer:நாள்;}" comments="kural=42; numeral=௨">
