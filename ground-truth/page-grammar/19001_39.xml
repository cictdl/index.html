      <TextLine id="r_main_l10" custom="readingOrder {index:9;} ilakkanam {kural:370;verification:verified;words:ஆரா=எதிர்மறைபெயரெச்சம்|இயற்கை=பண்புப்பெயர்|அவா=பண்புப்பெயர்|நீப்பின்=வினையெச்சம்|அந்நிலை=சுட்டுப்பெயர்|ஏ=ஏகாரம்|பேரா=எதிர்மறைபெயரெச்சம்|இயற்கை=பண்புப்பெயர்|தரும்=தெரிநிலைவினைமுற்று;ani:சொற்பொருட்பின்வருநிலை;edugai:ரா;eetruseer:மலர்;}" comments="kural=370; numeral=௰">
        <Coords points="0,397 2774,397 2774,434 0,434" />
        <Baseline points="0,428 2774,428" />
        <TextEquiv>
          <Unicode>ஆரா வியற்கை யவா நீக்கிய ந்நிலையெ பேரா வியற்கை தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அற்றவ ரென்பர வாவற்றார் மற்றையார ற்றாக வற்றதி லர்
அஞ்சுவ தோரும றனெ யொருவநை வஞ்சிப்ப தோறுமவா
தூஉய்மை யென்பத வாவின்மை மற்றது வாய்அமை வேண்ட வரும்
அவாவென்ப வெல்லா முயிர்க்கு மெஞ் ஞான்றுந் தவாஅப் பிறப்பீநும் வித்து
வேண்டுங்கால் வேண்டும் பிறவாமை மற்றது வேண்டாமை வேண்ட வரும்
வேண்டாமை யந்ந விழுச்செல்வ மீண்டில்லை யாண்டும் அஃதொப்பதில்
அவவில்லார்க் கில்லாகுந் துன்பம் அஃதுண்டே ற்றவாஅது மென்மேல் வரும்
இன்பமி டையறா தீண்டும் அவாவெந்நுந் துன்பத்துட் டுன்பங் கெடின்
அவாவிநை யாற்ற வறுப்பிற்ற வாவிநைத் தான்வேண்டு மாற்றான் வரும்
ஆரா வியற்கை யவா நீக்கிய ந்நிலையெ பேரா வியற்கை தரும்</Unicode>
      </TextEquiv>
