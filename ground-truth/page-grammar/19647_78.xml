        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;} ilakkanam {kural:759;verification:verified;words:செய்க=வியங்கோள்வினைமுற்று|பொருள்=பொருட்பெயர்|ஐ=வேற்றுமைஉருபு|செறுநர்=வினையாலணையும்பெயர்|செருக்கு=பண்புப்பெயர்|அறுக்கும்=பெயரெச்சம்|எஃகு=பொருட்பெயர்|அதனின்=சுட்டுப்பெயர்|கூரிய=பெயரெச்சம்|தில்=அசைநிலை;ani:உருவகம;edugai:ய்/ஃ;eetruseer:காசு;}" comments="kural=759; numeral=௬">
