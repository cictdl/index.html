        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;} ilakkanam {kural:753;verification:verified;words:பொருள்=பொருட்பெயர்|என்னும்=பெயரெச்சம்|பொய்யா=எதிர்மறைபெயரெச்சம்|விளக்கம்=பொருட்பெயர்|இருள்=பொருட்பெயர்|அறுக்கும்=தெரிநிலைவினைமுற்று|எண்ணிய=பெயரெச்சம்|தேயத்து=இடப்பெயர்|சென்று=வினையெச்சம்;ani:உருவகம்;edugai:ண்;eetruseer:காசு;}" comments="kural=753; numeral=௭">
        <Coords points="0,297 2792,297 2792,336 0,336" />
        <Baseline points="0,329 2792,329" />
        <TextEquiv>
          <Unicode>பொருளெந்நும் பொய்யா விளக்கம் யிருளறுக்குமெண்ணிய தேயத்திற சென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:751;verification:verified;words:பொருள்=பொருட்பெயர்|அல்=எதிர்மறைஇடை|அல்லவரை=வினையாலணையும்பெயர்|பொருள்=பொருட்பெயர்|ஆகச்=வினையெச்சம்|செய்யும்=பெயரெச்சம்|பொருள்=பொருட்பெயர்|அல்லது=எதிர்மறைஇடை|இல்லை=குறிப்புவினைமுற்று|பொருள்=பொருட்பெயர்;ani:சொற்பொருட்பின்வருநிலை;edugai:ர;eetruseer:பிறப்பு;}" comments="kural=751; numeral=௮">
        <Coords points="0,336 2792,336 2792,376 0,376" />
