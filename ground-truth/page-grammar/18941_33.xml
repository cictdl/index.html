        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:302;verification:verified;words:செல்லா=எதிர்மறைபெயரெச்சம்|இடத்து=இடப்பெயர்|சினம்=பண்புப்பெயர்|தீது=குறிப்புவினைமுற்று|செல்=பெயரெச்சம்|இடத்து=இடப்பெயர்|உம்=உம்மை|இல்=எதிர்மறைஇடை|அதனின்=சுட்டுப்பெயர்|தீய=பண்புப்பெயர்|பிற=பண்புப்பெயர்;togai:செல்லிடத்தும்=வேற்றுமைத்தொகை;ani:முரண்;edugai:ல்/ல்;eetruseer:பிற (மலர் வாய்பாடு);}" comments="kural=302; numeral=௨">
        <Coords points="0,140 2761,140 2761,177 0,177" />
        <Baseline points="0,171 2761,171" />
        <TextEquiv>
          <Unicode>செல்லா விடத்திற் சிநந்தீது செல்லிடத்து மில்லதநிற் றீய பிற</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;} ilakkanam {kural:301;verification:verified;words:செல்=பெயரெச்சம்|இடத்து=இடப்பெயர்|காப்பான்=வினையாலணையும்பெயர்|சினம்=பண்புப்பெயர்|காப்பான்=வினையாலணையும்பெயர்|அல்=எதிர்மறைபெயரெச்சம்|இடத்து=இடப்பெயர்|காக்கின்=வினையெச்சம்|என்=வினாப்பெயர்|காவாக்கால்=எதிர்மறைவினையெச்சம்|என்=வினாப்பெயர்;togai:செல்லிடத்துக்=வேற்றுமைத்தொகை|சினங்காப்பான்=வேற்றுமைத்தொகை|அல்லிடத்துக்=வேற்றுமைத்தொகை;ani:முரண்,சொற்பொருட்பின்வருநிலை;edugai:ல்/ல்;eetruseer:என்? (காசு வாய்பாடு);}" comments="kural=301; numeral=௩">
