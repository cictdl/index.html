        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;} ilakkanam {kural:633;verification:verified;words:பிரித்தல்=தொழிற்பெயர்|உம்=உம்மை|பேணி=வினையெச்சம்|கொளல்=தொழிற்பெயர்|உம்=உம்மை|பிரிந்தார்=வினையாலணையும்பெயர்|பொருத்தல்=தொழிற்பெயர்|உம்=உம்மை|வல்லது=குறிப்புவினைமுற்று|அமைச்சு=பொருட்பெயர்;ani:சொற்பொருட்பின்வருநிலை;edugai:ரி/ரு;eetruseer:காசு;}" comments="kural=633; numeral=௬">
        <Coords points="0,302 2708,302 2708,340 0,340" />
        <Baseline points="0,333 2708,333" />
        <TextEquiv>
