        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:632;verification:verified;words:வன்கண்=பண்புப்பெயர்|குடி=பொருட்பெயர்|காத்தல்=தொழிற்பெயர்|கற்று=வினையெச்சம்|அறிதல்=தொழிற்பெயர்|ஆள்வினை=தொழிற்பெயர்|ஓடு=வேற்றுமைஉருபு|ஐந்து=எண்ணுப்பெயர்|உடன்=அசைநிலை|மாண்டது=வினையாலணையும்பெயர்|அமைச்சு=பொருட்பெயர்;togai:வன்கண்=பண்புத்தொகை|குடிகாத்தல்=வேற்றுமைத்தொகை;edugai:ன்/ந்;eetruseer:காசு;}" comments="kural=632; numeral=௨">
        <Coords points="0,150 2708,150 2708,188 0,188" />
        <Baseline points="0,181 2708,181" />
        <TextEquiv>
