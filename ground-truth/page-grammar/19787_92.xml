        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:892;verification:verified;words:பெரியாரை=பண்புப்பெயர்|பேணாது=எதிர்மறைவினையெச்சம்|ஒழுகின்=வினையெச்சம்|பெரியாரால்=பண்புப்பெயர்|பேரா=எதிர்மறைபெயரெச்சம்|இடும்பை=பண்புப்பெயர்|தரும்=தெரிநிலைவினைமுற்று;ani:சொற்பொருட்பின்வருநிலை;edugai:ர;eetruseer:காசு;}" comments="kural=892; numeral=௯">
