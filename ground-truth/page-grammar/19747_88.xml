        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:853;verification:verified;words:இகல்=பண்புப்பெயர்|என்னும்=பெயரெச்சம்|எவ்வ=பண்புப்பெயர்|நோய்=பொருட்பெயர்|நீக்கின்=வினையெச்சம்|தவல்=தொழிற்பெயர்|இல்லா=எதிர்மறைபெயரெச்சம்|தாவு=பண்புப்பெயர்|இல்=எதிர்மறைஇடை|விளக்கம்=பண்புப்பெயர்|தரும்=தெரிநிலைவினைமுற்று;togai:எவ்வநோய்=பண்புத்தொகை;ani:உருவகம்;eetruseer:மலர்;}" comments="kural=853; numeral=௯">
