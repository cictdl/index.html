        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:857;verification:verified;words:மிகல்=தொழிற்பெயர்|மேவல்=தொழிற்பெயர்|மெய்=பண்புப்பெயர்|பொருள்=பொருட்பெயர்|காணார்=எதிர்மறைவினைமுற்று|இகல்=பண்புப்பெயர்|மேவல்=தொழிற்பெயர்|இன்னா=பண்புப்பெயர்|அறிவின்=பண்புப்பெயர்|னவர்=வினையாலணையும்பெயர்;togai:மிகல்மேவல்=வேற்றுமைத்தொகை|மெய்ப்பொருள்=பண்புத்தொகை|இகல்மேவல்=வேற்றுமைத்தொகை;ani:இயைபு/ஒலிநயம்;eetruseer:காசு;}" comments="kural=857; numeral=௮">
