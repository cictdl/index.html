        <TextEquiv>
          <Unicode>புல்லவையுட் பொய்ச்சாந்துஞ் சொல்லற்க நல்லவையுண் ணந்கு செலச்சொல்லா தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:720;verification:verified;words:அங்கணத்துள்=இடப்பெயர்|உக்க=பெயரெச்சம்|அமிழ்து=பொருட்பெயர்|அற்று=சுட்டுப்பெயர்|ஆல்=அசைநிலை|தம்=சுட்டுப்பெயர்|கணத்தார்=வினையாலணையும்பெயர்|அல்லார்=வினையாலணையும்பெயர்|முன்=இடப்பெயர்|கோட்டி=பொருட்பெயர்|கொளல்=தொழிற்பெயர்;ani:உவமை,சொற்பொருட்பின்வருநிலை;edugai:ங்/ல்;eetruseer:பிறப்பு;}" comments="kural=720; numeral=௯">
