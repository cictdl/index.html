      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:1219;verification:verified;words:நனவினால்=பொருட்பெயர்|நல்காரை=வினையாலணையும்பெயர்|நோவர்=தெரிநிலைவினைமுற்று|கனவினால்=பொருட்பெயர்|காதலர்=பொருட்பெயர்|காணா=எதிர்மறைபெயரெச்சம்|அவர்=சுட்டுப்பெயர்;eetruseer:தவர்;}" comments="kural=1219; numeral=௮">
