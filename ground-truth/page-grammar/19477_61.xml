        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:587;verification:verified;words:மறைந்தவை=வினையாலணையும்பெயர்|கேட்கவல்=பெயரெச்சம்|ஆகி=வினையெச்சம்|அறிந்தவை=வினையாலணையும்பெயர்|ஐயப்பாடு=தொழிற்பெயர்|இல்லது=எதிர்மறைவினைமுற்று|ஏ=ஏகாரம்|ஒற்று=பொருட்பெயர்;ani:முரண்;edugai:றை/றி;eetruseer:காசு;}" comments="kural=587; numeral=௯">
