        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:586;verification:verified;words:துறந்தார்=வினையாலணையும்பெயர்|படிவத்தர்=பண்புப்பெயர்|ஆகி=வினையெச்சம்|இறந்து=வினையெச்சம்|ஆராய்ந்து=வினையெச்சம்|என்=வினாப்பெயர்|செயினும்=வினையெச்சம்|சோர்வு=தொழிற்பெயர்|இலது=எதிர்மறைவினைமுற்று|ஒற்று=பொருட்பெயர்;edugai:ற/ன;eetruseer:காசு;}" comments="kural=586; numeral=௮">
        <Coords points="0,318 2624,318 2624,353 0,353" />
        <Baseline points="0,347 2624,347" />
