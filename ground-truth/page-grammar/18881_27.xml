        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;} ilakkanam {kural:247;verification:verified;words:அருள்=பண்புப்பெயர்|இல்லார்க்கு=வினையாலணையும்பெயர்|அ=சுட்டுப்பெயர்|உலகம்=இடப்பெயர்|இல்லை=எதிர்மறைஇடை|பொருள்=பொருட்பெயர்|இல்லார்க்கு=வினையாலணையும்பெயர்|இ=சுட்டுப்பெயர்|உலகம்=இடப்பெயர்|இல்லாகி=எதிர்மறைவினையெச்சம்|யாங்கு=அசைநிலை;ani:எடுத்துக்காட்டுவமை,முரண்;eetruseer:காசு;}" comments="kural=247; numeral=௰">
        <Coords points="0,484 2865,484 2865,522 0,522" />
        <Baseline points="0,515 2865,515" />
        <TextEquiv>
          <Unicode>அருளிலார்க் கவ்வுலக மில்லை பொருளிலார்க் கிவ்வுலக மில்லாகி யாங்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அருள்சேர்ந்த நெஞ்சிநார்க் கில்லை யிருள்சேர்ந்த விந்நா வுலகம் புகல்
மந்நுயி ரோம்பி யருளாள்வர் கில்லென்ப தந்நுயி ரஞ்சும் விநை
நல்லாற்றா நாடி யருளாள்கப் பல்லாற்றாற் றேறிநு மஃதே துணை
அல்லல் அருளாள்வார்க் கில்லை வளிவழங்கு மல்லன்மா ஞாலங் கரி
பொருணீங்கிப் பொய்ச்சாந்தா ரென்ப ரருணீங்கி யல்லவை செய்தொளுகு வார்
பொருளற்றாற் பூப்ப ரொருகால் அருளற்றா ராற்றா மற் றாறற் லரிது
அருட்செல்வஞ் செல்வத்துட் செல்வம் பொருட்செல்வம் பூரியார் கண்ணு முள
வலியார்முற் றந்நை நிநைக்கதான் றன்னின் மெலியார்மேற் செல்லு மிடத்து
தெருளாதான் மெய்ப்பொருள் கண்டற்றாற் றேறின் னருளாதான் செய்யு மறம்
அருளிலார்க் கவ்வுலக மில்லை பொருளிலார்க் கிவ்வுலக மில்லாகி யாங்கு</Unicode>
      </TextEquiv>
    </TextRegion>
