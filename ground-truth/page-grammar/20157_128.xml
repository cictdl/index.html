          <Unicode>ஒருநாளெளு நாழ்போற்  செல்லுஞ்சேந் செந்றார் வருநாழ்வைத்தேங்குபவற்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:1261;verification:verified;words:வாள்=பண்புப்பெயர்|அற்று=வினையெச்சம்|புற்கென்ற=பெயரெச்சம்|கண்=சினைப்பெயர்|உம்=உம்மை|அவர்=சுட்டுப்பெயர்|சென்ற=பெயரெச்சம்|நாள்=காலப்பெயர்|ஒற்றி=வினையெச்சம்|தேய்ந்த=பெயரெச்சம்|விரல்=சினைப்பெயர்;ani:சொற்பொருட்பின்வருநிலை;edugai:ள;eetruseer:விரல் (நாள் வாய்பாடு);}" comments="kural=1261; numeral=௯">
