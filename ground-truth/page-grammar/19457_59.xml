        <Baseline points="0,424 2891,424" />
        <TextEquiv>
          <Unicode>கடிதோச்சி மெல்ல வெறிக நெடிதாக்கம் நீங்காமை வேண்டு பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;} ilakkanam {kural:570;verification:verified;words:கல்லார்=வினையாலணையும்பெயர்|பிணிக்கும்=பெயரெச்சம்|கடுங்கோல்=பொருட்பெயர்|அது=சுட்டுப்பெயர்|அல்லது=எதிர்மறைஇடை|இல்லை=எதிர்மறைஇடை|நிலக்கு=இடப்பெயர்|பொறை=பொருட்பெயர்;togai:கடுங்கோல்=பண்புத்தொகை;ani:உயர்வுநவிற்சி;edugai:ல்/ல்;eetruseer:மலர்;}" comments="kural=570; numeral=௰">
        <Coords points="0,431 2891,431 2891,470 0,470" />
        <Baseline points="0,463 2891,463" />
        <TextEquiv>
          <Unicode>கல்லார்ப் பிணிக்குங் கடுங்கோல துவல்லதி ல்லை நிலற்குப் பொறை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>கடுஞ்சொல்லன் கண்ணிலனா யின் நெடுஞ்செல்வம் நீடின்றி யாங்கே கெடும்
இநத்தாற்றி யெண்ணாத வேந்தன் சிநத்தாற்றிச் சீறிற் சிறுகும் திரு
அருஞ்செவ்வி யிந்நா முகத்தான் பெருஞ்செல்வம் பேய்கண் டந்நது டைத்து
வெருவந்த செய்தொழுகும் வெங்கோல னாயினொ ருவந்துமொ ல்லைக் கெடும்
இறைகடியநெ ன்றுரைக்குமி ன்னாச்சொல் வேந்தனு றைகடுகி யொல்லைக் கெடும்
கடுமொழியுங் கையிகழ்ந்த தண்டமும் வேந்தன டுமுரண் டேய்க்குமாம்
செருவந்த போழ்திற் சிறைசெய்யா வேந்தன் வெருவந்து வெய்து கெடும்
தக்காங்கு நாடித் தலைச்செய்யா வண்ணத்தாலொ த்தாங்கொ றுப்பது வேந்து
கடிதோச்சி மெல்ல வெறிக நெடிதாக்கம் நீங்காமை வேண்டு பவர்
கல்லார்ப் பிணிக்குங் கடுங்கோல துவல்லதி ல்லை நிலற்குப் பொறை</Unicode>
      </TextEquiv>
