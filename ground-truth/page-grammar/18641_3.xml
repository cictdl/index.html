        <Baseline points="0,98 3076,98" />
        <TextEquiv>
          <Unicode>மலர்மிசை யெகிநான் மாணடி சேர்ந்தார் நிலமிசை நீடு வாழ்வா / ர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;} ilakkanam {kural:4;verification:verified;words:வேண்டுதல்=தொழிற்பெயர்|வேண்டாமை=தொழிற்பெயர்|இலான்=வினையாலணையும்பெயர்|அடி=சினைப்பெயர்|சேர்ந்தார்=வினையாலணையும்பெயர்|கு=வேற்றுமைஉருபு|யாண்டு=காலப்பெயர்|உம்=உம்மை|இடும்பை=பண்புப்பெயர்|இல=குறிப்புவினைமுற்று;ani:முரண்;edugai:ண்/ண்;eetruseer:இல (காசு வாய்பாடு);}" comments="kural=4; numeral=௪">
