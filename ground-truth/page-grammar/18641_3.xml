        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;} ilakkanam {kural:3;verification:verified;words:மலர்=பொருட்பெயர்|மிசை=வேற்றுமைஉருபு|ஏகினான்=தெரிநிலைவினைமுற்று|மாண்=உரிச்சொல்|அடி=சினைப்பெயர்|சேர்ந்தார்=வினையாலணையும்பெயர்|நிலம்=இடப்பெயர்|மிசை=வேற்றுமைஉருபு|நீடு=உரிச்சொல்|வாழ்=பெயரெச்சம்|வார்=வினையாலணையும்பெயர்;togai:மலர்மிசை=வேற்றுமைத்தொகை|மாணடி=பண்புத்தொகை|நிலமிசை=வேற்றுமைத்தொகை|நீடுவாழ்=வினைத்தொகை;ani:உருவகம்;edugai:ல/ல;eetruseer:வார் (நாள் வாய்பாடு);}" comments="kural=3; numeral=௩">
