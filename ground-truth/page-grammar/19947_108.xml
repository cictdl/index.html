        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:1055;verification:verified;words:கரப்பிலார்=வினையாலணையும்பெயர்|வையகம்=இடப்பெயர்|அத்து=சாரியை|உண்மை=பண்புப்பெயர்|ஆல்=வேற்றுமைஉருபு|கண்=சினைப்பெயர்|நின்று=வினையெச்சம்|இரப்பவர்=வினையாலணையும்பெயர்|மேற்கொள்=வினையெச்சம்|வது=வினையாலணையும்பெயர்;edugai:ர;eetruseer:பிறப்பு;}" comments="kural=1055; numeral=௨">
        <Coords points="0,120 2711,120 2711,157 0,157" />
        <Baseline points="0,150 2711,150" />
        <TextEquiv>
          <Unicode>கரப்பிலார் வையகத்து ண்மையார்க் காணினி ரப்பவர் மேற்கொள் வது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;} ilakkanam {kural:1054;verification:verified;words:இரத்தல்=தொழிற்பெயர்|உம்=உம்மை|ஈதல்=தொழிற்பெயர்|ஏ=ஏகாரம்|போலும்=குறிப்புவினைமுற்று|கரத்தல்=தொழிற்பெயர்|கனவு=பொருட்பெயர்|உம்=உம்மை|தேற்றாதார்=வினையாலணையும்பெயர்|மாட்டு=வேற்றுமைஉருபு;ani:உவமை,சொற்பொருட்பின்வருநிலை;eetruseer:காசு;}" comments="kural=1054; numeral=௩">
