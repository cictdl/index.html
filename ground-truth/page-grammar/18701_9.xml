        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;} ilakkanam {kural:63;verification:verified;words:தம்=சுட்டுப்பெயர்|பொருள்=பொருட்பெயர்|என்ப=குறிப்புவினைமுற்று|தம்=சுட்டுப்பெயர்|மக்கள்=பொருட்பெயர்|அவர்=சுட்டுப்பெயர்|பொருள்=பொருட்பெயர்|தம்தம்=சுட்டுப்பெயர்|வினையான்=தொழிற்பெயர்|வரும்=தெரிநிலைவினைமுற்று;togai:தம்பொருள்=வேற்றுமைத்தொகை|அவர்பொருள்=வேற்றுமைத்தொகை;ani:மடக்கு;edugai:ம்;eetruseer:பிறப்பு;}" comments="kural=63; numeral=௩">
        <Coords points="0,164 2956,164 2956,204 0,204" />
        <Baseline points="0,196 2956,196" />
        <TextEquiv>
          <Unicode>தம்பொரு ளென்பாதம் மக்க ளவர்பொருட் டந்தம் விநையான் வரும்</Unicode>
