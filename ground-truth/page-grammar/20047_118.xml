        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;} ilakkanam {kural:1159;verification:verified;words:தொடின்=வினையெச்சம்|சுடின்=வினையெச்சம்|அல்லது=எதிர்மறைஇடை|காமம்=பொருட்பெயர்|நோய்=பொருட்பெயர்|போல=உவமைஉருபு|விடின்=வினையெச்சம்|சுடல்=தொழிற்பெயர்|ஆற்றும்=தெரிநிலைவினைமுற்று|ஓ=வினாஇடை|தீ=பொருட்பெயர்;togai:காமநோய்=பண்புத்தொகை;ani:எடுத்துக்காட்டுவமை;edugai:டி;eetruseer:தீ;}" comments="kural=1159; numeral=௭">
