        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:257;verification:verified;words:உண்ணாமை=தொழிற்பெயர்|வேண்டும்=குறிப்புவினைமுற்று|புலால்=பொருட்பெயர்|பிறிது=பண்புப்பெயர்|ஒன்றன்=எண்ணுப்பெயர்|புண்=பொருட்பெயர்|அது=சுட்டுப்பெயர்|உணர்வார்=வினையாலணையும்பெயர்|பெறின்=வினையெச்சம்;ani:உருவகம்;edugai:ண்/ண்;eetruseer:காசு;}" comments="kural=257; numeral=௯">
