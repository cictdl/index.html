        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:58;verification:verified;words:பெற்றால்=வினையெச்சம்|பெறின்=வினையெச்சம்|பெறுவர்=தெரிநிலைவினைமுற்று|பெண்டிர்=பொருட்பெயர்|பெரும்=உரிச்சொல்|சிறப்பு=பண்புப்பெயர்|புத்தேளிர்=பொருட்பெயர்|வாழும்=பெயரெச்சம்|உலகு=இடப்பெயர்;togai:பெருஞ்சிறப்புப்=பண்புத்தொகை;edugai:ற்/த்;eetruseer:உலகு (பிறப்பு வாய்பாடு);}" comments="kural=58; numeral=௮">
