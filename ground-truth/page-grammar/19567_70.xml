        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;} ilakkanam {kural:674;verification:verified;words:வினை=தொழிற்பெயர்|பகை=பண்புப்பெயர்|என்று=வினையெச்சம்|இரண்டின்=எண்ணுப்பெயர்|எச்சம்=பொருட்பெயர்|நினையும்=பெயரெச்சம்|கால்=காலப்பெயர்|தீ=பொருட்பெயர்|எச்சம்=பொருட்பெயர்|போல=உவமைஉருபு|தெறும்=தெரிநிலைவினைமுற்று;togai:வினைபகை=உம்மைத்தொகை|தீயெச்சம்=வேற்றுமைத்தொகை;ani:உவமை;eetruseer:காசு;}" comments="kural=674; numeral=௭">
