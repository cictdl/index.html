        <Baseline points="0,326 2647,326" />
        <TextEquiv>
          <Unicode>விநைப்பகை யென்றிரண்டினெச்சம் நிநையுங்காற்றீ யெச்சம் பொலத் தெறும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:679;verification:verified;words:நட்டார்=வினையாலணையும்பெயர்|கு=வேற்றுமைஉருபு|நல்ல=பண்புப்பெயர்|செயல்=தொழிற்பெயர்|இன்=வேற்றுமைஉருபு|விரைந்தது=வினையாலணையும்பெயர்|ஏ=ஏகாரம்|ஒட்டார்=வினையாலணையும்பெயர்|ஐ=வேற்றுமைஉருபு|ஒட்டி=வினையெச்சம்|கொளல்=வியங்கோள்வினைமுற்று;ani:முரண்;edugai:ட்/ட்;eetruseer:மலர்;}" comments="kural=679; numeral=௮">
