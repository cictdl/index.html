        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:814;verification:verified;words:அமரகத்து=இடப்பெயர்|ஆற்று=பொருட்பெயர்|அறுக்கும்=பெயரெச்சம்|கல்லா=எதிர்மறைபெயரெச்சம்|மா=பொருட்பெயர்|அன்னார்=வினையாலணையும்பெயர்|தமரின்=பொருட்பெயர்|தனிமை=பண்புப்பெயர்|தலை=குறிப்புவினைமுற்று;togai:அமரகத்து=வேற்றுமைத்தொகை;ani:உவமை;edugai:ம/ெம;eetruseer:மலர்;}" comments="kural=814; numeral=௨">
