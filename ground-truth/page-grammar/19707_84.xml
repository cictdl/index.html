        <Baseline points="0,160 2932,160" />
        <TextEquiv>
          <Unicode>அமரகத்தா ற்றுக்குங் கல்லாமா வந்நார் தமரிற் றநிமை தலை</Unicode>
        </TextEquiv>
      </TextLine>
