        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:734;verification:verified;words:உறு=உரிச்சொல்|பசி=பண்புப்பெயர்|உம்=உம்மை|ஓவா=எதிர்மறைபெயரெச்சம்|பிணி=பண்புப்பெயர்|உம்=உம்மை|செறு=பெயரெச்சம்|பகை=பண்புப்பெயர்|உம்=உம்மை|சேரா=எதிர்மறைவினையெச்சம்|இயல்வது=வினையாலணையும்பெயர்|நாடு=இடப்பெயர்;togai:உறுபசியும்=பண்புத்தொகை|செறுபகையும்=வினைத்தொகை;edugai:று/ரா;eetruseer:நாள்;}" comments="kural=734; numeral=௯">
