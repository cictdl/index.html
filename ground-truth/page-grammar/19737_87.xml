        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:843;verification:verified;words:அறிவிலார்=வினையாலணையும்பெயர்|தாம்=சுட்டுப்பெயர்|தம்மை=சுட்டுப்பெயர்|ஐ=வேற்றுமைஉருபு|பீழிக்கும்=பெயரெச்சம்|பீழை=பண்புப்பெயர்|செறுவார்=வினையாலணையும்பெயர்|கு=வேற்றுமைஉருபு|உம்=உம்மை|செய்தல்=தொழிற்பெயர்|அரிது=குறிப்புவினைமுற்று;ani:சொற்பொருட்பின்வருநிலை;edugai:றி/று;eetruseer:காசு;}" comments="kural=843; numeral=௨">
