        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;} ilakkanam {kural:1137;verification:verified;words:கடல்=பொருட்பெயர்|அன்ன=உவமைஉருபு|காமம்=பண்புப்பெயர்|உழந்து=வினையெச்சம்|உம்=உம்மை|மடல்=பொருட்பெயர்|ஏறா=எதிர்மறைபெயரெச்சம்|பெண்=பொருட்பெயர்|இன்=வேற்றுமைஉருபு|பெரு=உரிச்சொல்|தக்க=பெயரெச்சம்|தில்=அசைநிலை;ani:உவமை;edugai:ட/ண்;eetruseer:காசு;}" comments="kural=1137; numeral=௬">
