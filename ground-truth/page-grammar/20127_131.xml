      <TextLine id="r_main_l1" custom="readingOrder {index:0;} ilakkanam {kural:1233;verification:verified;words:தணந்தமை=தொழிற்பெயர்|சால=உரிச்சொல்|அறிவிப்ப=வினையாலணையும்பெயர்|போலும்=அசைநிலை|மணந்த=பெயரெச்சம்|நாள்=காலப்பெயர்|வீங்கிய=பெயரெச்சம்|தோள்=சினைப்பெயர்;ani:உருவகம்;edugai:ண;eetruseer:காசு;}" comments="kural=1233; numeral=௧">
        <Coords points="0,132 2816,132 2816,169 0,169" />
        <Baseline points="0,162 2816,162" />
