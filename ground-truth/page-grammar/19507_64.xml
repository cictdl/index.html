        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;} ilakkanam {kural:620;verification:verified;words:ஊழ்=பொருட்பெயர்|உம்=உம்மை|உப்பக்கம்=இடப்பெயர்|காண்பர்=தெரிநிலைவினைமுற்று|உலைவு=தொழிற்பெயர்|இன்றி=எதிர்மறைவினையெச்சம்|தாழாது=எதிர்மறைவினையெச்சம்|உஞற்றுபவர்=வினையாலணையும்பெயர்|(உஞற்று)பவர்=வினையாலணையும்பெயர்;ani:உயர்வுநவிற்சி;edugai:ழை/ா;eetruseer:பிறப்பு;}" comments="kural=620; numeral=௰">
        <Coords points="0,410 2694,410 2694,447 0,447" />
        <Baseline points="0,440 2694,440" />
        <TextEquiv>
          <Unicode>ஊழையுமு ப்பக்கங் காண்பரு லைவின்றித் தாளாது ஞற்று பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அருமை யுடைத்தென்ற் றசாவாமை வேண்டும் பெருமை முயற்சி தரும்
தாளாண்மை யெந்நுந் தகைமைக்கட் டங்கிற்றே வேளாண்மை யெந்நுஞ் செருக்கு
இன்பம் விளையான் விநைவிளைவான் றன்கேழீர் துன்பந் துடைத்தூன்றுந் தூண்
முயற்சி திருவிநை யாக்கும் முயற்சின்மை யின்மை புகுத்தி விடும்
தாளாண்மை யில்லாதான் வேளாண்மை பேடிகை வாளாண்மை போலக் கெடும்
விநைக்கண் விநைக்கெடலோ ம்பல் விநைக்குறை தீர்ந்தாரிற் றீர்ந்தான்று லகு
பொறியின்மை யார்க்கும் பழியன்ற் றிவறிந்தா ள்விநை யின்மை பழி
மடியுளாள் மாமுகடி யென்ப மடியிலான் றாளுளா டாமரையி நாள்
தெய்வத்தா லாவ தெநிநு முயற்சிதன் மெய்வருந்த்தக் கூலி தரும்
ஊழையுமு ப்பக்கங் காண்பரு லைவின்றித் தாளாது ஞற்று பவர்</Unicode>
      </TextEquiv>
