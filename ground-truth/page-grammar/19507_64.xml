        <Baseline points="0,366 2694,366" />
        <TextEquiv>
          <Unicode>மடியுளாள் மாமுகடி யென்ப மடியிலான் றாளுளா டாமரையி நாள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:619;verification:verified;words:தெய்வத்தான்=பொருட்பெயர்|ஆகாது=எதிர்மறைவினைமுற்று|(ஆகா)தெனினும்=வினையெச்சம்|முயற்சி=தொழிற்பெயர்|தன்=சுட்டுப்பெயர்|மெய்=சினைப்பெயர்|வருத்த=பெயரெச்சம்|கூலி=பொருட்பெயர்|தரும்=தெரிநிலைவினைமுற்று;togai:மெய்வருத்தக்=வேற்றுமைத்தொகை;edugai:ய்/ெய்;eetruseer:பிறப்பு;}" comments="kural=619; numeral=௯">
