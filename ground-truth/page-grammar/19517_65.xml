        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;} ilakkanam {kural:628;verification:verified;words:இன்பம்=பண்புப்பெயர்|விழையான்=வினையாலணையும்பெயர்|இடும்பை=பண்புப்பெயர்|இயல்பு=பண்புப்பெயர்|என்பான்=வினையாலணையும்பெயர்|துன்பம்=பண்புப்பெயர்|உறுதல்=தொழிற்பெயர்|இலன்=குறிப்புவினைமுற்று;ani:முரண்;edugai:ன்;eetruseer:மலர்;}" comments="kural=628; numeral=௯">
