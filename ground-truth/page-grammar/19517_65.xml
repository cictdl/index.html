        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;} ilakkanam {kural:623;verification:verified;words:இடும்பைக்கு=பண்புப்பெயர்|இடும்பை=பண்புப்பெயர்|படுப்பர்=தெரிநிலைவினைமுற்று|இடும்பைக்கு=பண்புப்பெயர்|இடும்பை=பண்புப்பெயர்|படாஅ=எதிர்மறைபெயரெச்சம்|தவர்=வினையாலணையும்பெயர்;ani:மடக்கு,சொற்பொருட்பின்வருநிலை;edugai:டு;eetruseer:மலர்;}" comments="kural=623; numeral=௬">
        <Coords points="0,285 2651,285 2651,322 0,322" />
        <Baseline points="0,315 2651,315" />
        <TextEquiv>
          <Unicode>இடும்பைக்கி டும்பை படுப்பர் யிடும்பைக்கி டும்பை படா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;} ilakkanam {kural:629;verification:verified;words:இன்பத்துள்=பண்புப்பெயர்|இன்பம்=பண்புப்பெயர்|விழையாதான்=வினையாலணையும்பெயர்|துன்பத்துள்=பண்புப்பெயர்|துன்பம்=பண்புப்பெயர்|உறுதல்=தொழிற்பெயர்|இலன்=குறிப்புவினைமுற்று;ani:முரண்,சொற்பொருட்பின்வருநிலை;edugai:ன்;eetruseer:மலர்;}" comments="kural=629; numeral=௭">
        <Coords points="0,322 2651,322 2651,358 0,358" />
        <Baseline points="0,352 2651,352" />
        <TextEquiv>
          <Unicode>இன்பத்துள் ளின்பம் விழையாதான் றுன்பத்துட் டுன்பமு றுதல் லிலன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;} ilakkanam {kural:627;verification:verified;words:இலக்கம்=பொருட்பெயர்|உடம்பு=சினைப்பெயர்|இடும்பை=பண்புப்பெயர்|கு=வேற்றுமைஉருபு|என்று=வினையெச்சம்|கலக்கத்தை=தொழிற்பெயர்|கையாறு=பண்புப்பெயர்|ஆக=வினையெச்சம்|கொள்ளாது=எதிர்மறைவினைமுற்று|ஆம்=அசைநிலை|மேல்=இடப்பெயர்;togai:உடம்பிடும்பைக்=வேற்றுமைத்தொகை;ani:உருவகம்;edugai:—;eetruseer:நாள்;}" comments="kural=627; numeral=௮">
        <Coords points="0,358 2651,358 2651,395 0,395" />
        <Baseline points="0,388 2651,388" />
