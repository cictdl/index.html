        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;} ilakkanam {kural:487;verification:verified;words:பொள்ளென=அசைநிலை|ஆங்கு=சுட்டுப்பெயர்|ஏ=ஏகாரம்|புறம்=இடப்பெயர்|வேரார்=எதிர்மறைவினைமுற்று|காலம்=காலப்பெயர்|பார்த்து=வினையெச்சம்|உள்=இடப்பெயர்|வேர்ப்பர்=தெரிநிலைவினைமுற்று|ஒள்ளிய=பண்புப்பெயர்|அவர்=சுட்டுப்பெயர்;ani:சொற்பொருட்பின்வருநிலை,முரண்;eetruseer:மலர்;}" comments="kural=487; numeral=௫">
