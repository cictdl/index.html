        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;} ilakkanam {kural:806;verification:verified;words:எல்லைக்கண்=இடப்பெயர்|கண்=வேற்றுமைஉருபு|நின்றார்=வினையாலணையும்பெயர்|துறவார்=எதிர்மறைவினைமுற்று|தொலைவிடத்து=இடப்பெயர்|உம்=உம்மை|தொல்லைக்கண்=காலப்பெயர்|கண்=வேற்றுமைஉருபு|நின்றார்=வினையாலணையும்பெயர்|தொடர்பு=தொழிற்பெயர்;ani:மடக்கு;edugai:ல்;eetruseer:தொடர்பு;}" comments="kural=806; numeral=௭">
