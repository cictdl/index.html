        <Baseline points="0,165 2721,165" />
        <TextEquiv>
          <Unicode>ஒருபொளுது வாழ்வதறியாரு வகத்துக் கருதுவ கோடியு மல்ல பல</Unicode>
        </TextEquiv>
      </TextLine>
