        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;} ilakkanam {kural:923;verification:verified;words:ஈன்றாள்=வினையாலணையும்பெயர்|முகத்தே=சினைப்பெயர்|உம்=உம்மை|இன்னாது=குறிப்புவினைமுற்று|ஆல்=அசைநிலை|என்=வினாப்பெயர்|மற்று=அசைநிலை|சான்றோர்=வினையாலணையும்பெயர்|முகத்து=சினைப்பெயர்|களி=தொழிற்பெயர்;ani:எடுத்துக்காட்டுவமை;edugai:ன்;eetruseer:காசு;}" comments="kural=923; numeral=௰">
        <Coords points="0,427 2862,427 2862,466 0,466" />
        <Baseline points="0,459 2862,459" />
        <TextEquiv>
          <Unicode>ஈன்றாள் முகத்தேயுமி ந்நாதாலெ ன்மற்றுச் சான்றோர் முகத்துக் களி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>கள்ளுண்ணாப் போழ்திற் களித்தாநைக் காணுங்காலு ள்ளான்கொலு ண்டதன் சோர்வு
களித்தாநைக் காரணங் காட்டுதல் கீழ்ணீர்க் குளித்தாநைத் தீத்துரீ யற்று
களித்தறியெனென்பது கைவிடுக நெஞ்சத்தொழித்தது மாங்கெ மிகும்
துஞ்சிநார் செத்தாரின் வேறல்லாரெ ஞ்ஞான்றும் நஞ்சுண்பார் கள்ளுண் பவர்
உள்ளொற்றி யுள்ளூர் நகப்படுவரெ ஞ்ஞான்றும் கள்ளொற்றிக் கண்சாய் பவர்
உளக கப் படாரொ ளியிழப்பரெ ஞ்ஞான்றும் கட்காத கொண்டொழுகு வார்
உண்ணற்க கள்ளை யுணிலுண்கச் சான்றோர் ரலெண்ணப் படவேண்டா தார்
கையறி யாமை விலைகொயுடைத் தெவிலை கொடுத்து மெய்யறி யாமை கொளல்
நாணெந்நும் நல்லாள் புறங்கொடுக்குங் கள்ளெந்நும் பேணாப் பெருங்குற்றத் தார்க்கு
ஈன்றாள் முகத்தேயுமி ந்நாதாலெ ன்மற்றுச் சான்றோர் முகத்துக் களி</Unicode>
      </TextEquiv>
    </TextRegion>
