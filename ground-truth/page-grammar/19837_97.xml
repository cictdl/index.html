        <Baseline points="0,151 2911,151" />
        <TextEquiv>
          <Unicode>மருந்தெந வேண்டாவாமாக்கைக் கருந்தியதற்றமை போற்றி யுணின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;} ilakkanam {kural:947;verification:verified;words:தீ=பொருட்பெயர்|அளவு=பண்புப்பெயர்|அன்றி=எதிர்மறைவினையெச்சம்|தெரியான்=எதிர்மறைவினைமுற்று|பெரிது=பண்புப்பெயர்|உண்ணின்=வினையெச்சம்|நோய்=பொருட்பெயர்|அளவு=பண்புப்பெயர்|இன்றி=எதிர்மறைவினையெச்சம்|படும்=தெரிநிலைவினைமுற்று;togai:தீயள=வேற்றுமைத்தொகை|நோயள=வேற்றுமைத்தொகை;ani:சொற்பொருட்பின்வருநிலை;edugai:ய;eetruseer:படும்;}" comments="kural=947; numeral=௩">
