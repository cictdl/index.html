        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;} ilakkanam {kural:942;verification:verified;words:மருந்து=பொருட்பெயர்|என=அசைநிலை|வேண்டாவாம்=எதிர்மறைவினைமுற்று|யாக்கைக்கு=பொருட்பெயர்|அருந்தியது=வினையாலணையும்பெயர்|அற்றது=வினையாலணையும்பெயர்|போற்றி=வினையெச்சம்|உணின்=வினையெச்சம்;eetruseer:உணின்;}" comments="kural=942; numeral=௨">
