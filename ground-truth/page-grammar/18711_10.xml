        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;} ilakkanam {kural:75;verification:verified;words:அன்புற்று=வினையெச்சம்|அமர்ந்த=பெயரெச்சம்|வழக்கு=பொருட்பெயர்|என்ப=தெரிநிலைவினைமுற்று|வையகத்து=இடப்பெயர்|இன்புற்றார்=வினையாலணையும்பெயர்|எய்தும்=பெயரெச்சம்|சிறப்பு=பண்புப்பெயர்;ani:சொற்பொருட்பின்வருநிலை;edugai:ன்;eetruseer:பிறப்பு;}" comments="kural=75; numeral=௫">
