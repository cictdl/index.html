        <Coords points="0,264 2921,264 2921,296 0,296" />
        <Baseline points="0,290 2921,290" />
        <TextEquiv>
          <Unicode>நாணு மறந்தேந அவர்மறக் கல்லாவென் மாணா மடநெஞ்சிற் பட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;} ilakkanam {kural:1298;verification:verified;words:எள்ளின்=வினையெச்சம்|இளிவாம்=தெரிநிலைவினைமுற்று|என்று=வினையெச்சம்|எண்ணி=வினையெச்சம்|அவர்=சுட்டுப்பெயர்|திறம்=பண்புப்பெயர்|உள்ளும்=தெரிநிலைவினைமுற்று|உயிர்க்கு=பொருட்பெயர்|காதல்=பண்புப்பெயர்|நெஞ்சு=பொருட்பெயர்;togai:அவர்திறம்=வேற்றுமைத்தொகை;edugai:ள்;eetruseer:நெஞ்சு;}" comments="kural=1298; numeral=௬">
