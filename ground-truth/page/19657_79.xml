    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,94 2876,94 2876,475 0,475"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=761; numeral=௧">
        <Coords points="0,94 2876,94 2876,132 0,132"/>
        <Baseline points="0,125 2876,125"/>
        <TextEquiv>
          <Unicode>உறுப்பமைந்தூ றஞ்சா வெல்படை வேந்தன் வெறுக்கையு ளெல்லாந் தலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=762; numeral=௨">
        <Coords points="0,132 2876,132 2876,170 0,170"/>
        <Baseline points="0,163 2876,163"/>
        <TextEquiv>
          <Unicode>உலைவிடத்தூ றஞ்சா வன்கண் தொலைவிடத்துத் தொல்படைக் கல்லால் ரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=763; numeral=௩">
        <Coords points="0,170 2876,170 2876,208 0,208"/>
        <Baseline points="0,201 2876,201"/>
        <TextEquiv>
          <Unicode>ஒலித்தக்காலெ ந்நாமு வரி யெலிப்பகை நாகமு யிர்ப்பக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=764; numeral=௪">
        <Coords points="0,208 2876,208 2876,246 0,246"/>
        <Baseline points="0,239 2876,239"/>
        <TextEquiv>
          <Unicode>அழிவின்ற றைபோகா தாகி வழிவந்த வன்க ணதுவெ படை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=765; numeral=௫">
        <Coords points="0,246 2876,246 2876,284 0,284"/>
        <Baseline points="0,277 2876,277"/>
        <TextEquiv>
          <Unicode>கூற்றுடன்று மேல்வரிநுங் கூடி யெதிர்நிற்குமா ற்ற லதுவெ படை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=766; numeral=௬">
        <Coords points="0,284 2876,284 2876,322 0,322"/>
        <Baseline points="0,315 2876,315"/>
        <TextEquiv>
          <Unicode>மறமானம் மாண்ட வழிச்செலவு தேற்றமெ ந்நான்கெ ஞ்மம் படைக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=767; numeral=௭">
        <Coords points="0,322 2876,322 2876,360 0,360"/>
        <Baseline points="0,354 2876,354"/>
        <TextEquiv>
          <Unicode>தார்தாங்கிச் செல்வது தாநை தலைவந்த போர்தாங்குந் தன்மை யறிந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=768; numeral=௮">
        <Coords points="0,360 2876,360 2876,399 0,399"/>
        <Baseline points="0,392 2876,392"/>
        <TextEquiv>
          <Unicode>அடற்றகையுமா ற்றலுமி ல்லெநினும் தாநை படற்றகையாற் பாடு பெறும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=769; numeral=௯">
        <Coords points="0,399 2876,399 2876,437 0,437"/>
        <Baseline points="0,430 2876,430"/>
        <TextEquiv>
          <Unicode>சிறுமையுஞ் செல்லாத் துனிவும் வறுமையுமி ல்லாயின் வெல்லும் படை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=770; numeral=௰">
        <Coords points="0,437 2876,437 2876,475 0,475"/>
        <Baseline points="0,468 2876,468"/>
        <TextEquiv>
          <Unicode>நிலைமக்கள் சால வுடைத்தெநிநும் தாநைத் தலைமக்களி ல்வழி யில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>உறுப்பமைந்தூ றஞ்சா வெல்படை வேந்தன் வெறுக்கையு ளெல்லாந் தலை
உலைவிடத்தூ றஞ்சா வன்கண் தொலைவிடத்துத் தொல்படைக் கல்லால் ரிது
ஒலித்தக்காலெ ந்நாமு வரி யெலிப்பகை நாகமு யிர்ப்பக் கெடும்
அழிவின்ற றைபோகா தாகி வழிவந்த வன்க ணதுவெ படை
கூற்றுடன்று மேல்வரிநுங் கூடி யெதிர்நிற்குமா ற்ற லதுவெ படை
மறமானம் மாண்ட வழிச்செலவு தேற்றமெ ந்நான்கெ ஞ்மம் படைக்கு
தார்தாங்கிச் செல்வது தாநை தலைவந்த போர்தாங்குந் தன்மை யறிந்து
அடற்றகையுமா ற்றலுமி ல்லெநினும் தாநை படற்றகையாற் பாடு பெறும்
சிறுமையுஞ் செல்லாத் துனிவும் வறுமையுமி ல்லாயின் வெல்லும் படை
நிலைமக்கள் சால வுடைத்தெநிநும் தாநைத் தலைமக்களி ல்வழி யில்</Unicode>
      </TextEquiv>
    </TextRegion>
