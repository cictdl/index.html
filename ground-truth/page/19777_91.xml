    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,71 2808,71 2808,441 0,441"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=889; numeral=௧">
        <Coords points="0,71 2808,71 2808,108 0,108"/>
        <Baseline points="0,101 2808,101"/>
        <TextEquiv>
          <Unicode>எட்பக வந்ந சிறுமைத்தெயாயிநுமு ட்பகை யுள்ளதாங் கேடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=884; numeral=௨">
        <Coords points="0,108 2808,108 2808,145 0,145"/>
        <Baseline points="0,138 2808,138"/>
        <TextEquiv>
          <Unicode>மநமாணா வுட்பகை தோன்றின் யிநமாணா வேதம் பலவுமந்  தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=885; numeral=௩">
        <Coords points="0,145 2808,145 2808,182 0,182"/>
        <Baseline points="0,175 2808,175"/>
        <TextEquiv>
          <Unicode>உறன்முறையானு ட்பகை தோன்றினி றன்முறையானே தம் பலவுந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=886; numeral=௪">
        <Coords points="0,182 2808,182 2808,219 0,219"/>
        <Baseline points="0,212 2808,212"/>
        <TextEquiv>
          <Unicode>ஒன்றாமை யொன்றியார் கட்படிநெ ஞ்ஞான்றும் பொன்றாமை பொன்றல ரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=881; numeral=௫">
        <Coords points="0,219 2808,219 2808,256 0,256"/>
        <Baseline points="0,249 2808,249"/>
        <TextEquiv>
          <Unicode>நிழல்நீருமி ந்நாத விந்நா தமர்நீருமி ந்நாவாமி ந்நா செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=890; numeral=௬">
        <Coords points="0,256 2808,256 2808,293 0,293"/>
        <Baseline points="0,286 2808,286"/>
        <TextEquiv>
          <Unicode>உடம்பாடி லாதவர் கேண்மை குடம்பையுட் பாம்போடு றைந் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=882; numeral=௭">
        <Coords points="0,293 2808,293 2808,330 0,330"/>
        <Baseline points="0,323 2808,323"/>
        <TextEquiv>
          <Unicode>வாள்போற பகைவரை யஞ்சற்க வஞ்சுக கோள்போற் பகைவர் தொடர்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=888; numeral=௮">
        <Coords points="0,330 2808,330 2808,367 0,367"/>
        <Baseline points="0,360 2808,360"/>
        <TextEquiv>
          <Unicode>அரம்பொருதப் பொன்போலத் தேயும் உரம்பொருது ட்பகை யுற்ற குடி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=883; numeral=௯">
        <Coords points="0,367 2808,367 2808,404 0,404"/>
        <Baseline points="0,397 2808,397"/>
        <TextEquiv>
          <Unicode>உட்பகை யஞ்சித்தற் கார்க்க வுலைவிடத்து மட்பகைமாண் தெறும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=887; numeral=௰">
        <Coords points="0,404 2808,404 2808,441 0,441"/>
        <Baseline points="0,434 2808,434"/>
        <TextEquiv>
          <Unicode>செப்பின் புணர்ச்சிபோற் கூடிநுங் கூடாதெ யுட்பகை யுற்ற குடி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>எட்பக வந்ந சிறுமைத்தெயாயிநுமு ட்பகை யுள்ளதாங் கேடு
மநமாணா வுட்பகை தோன்றின் யிநமாணா வேதம் பலவுமந்  தரும்
உறன்முறையானு ட்பகை தோன்றினி றன்முறையானே தம் பலவுந் தரும்
ஒன்றாமை யொன்றியார் கட்படிநெ ஞ்ஞான்றும் பொன்றாமை பொன்றல ரிது
நிழல்நீருமி ந்நாத விந்நா தமர்நீருமி ந்நாவாமி ந்நா செயின்
உடம்பாடி லாதவர் கேண்மை குடம்பையுட் பாம்போடு றைந் தற்று
வாள்போற பகைவரை யஞ்சற்க வஞ்சுக கோள்போற் பகைவர் தொடர்பு
அரம்பொருதப் பொன்போலத் தேயும் உரம்பொருது ட்பகை யுற்ற குடி
உட்பகை யஞ்சித்தற் கார்க்க வுலைவிடத்து மட்பகைமாண் தெறும்
செப்பின் புணர்ச்சிபோற் கூடிநுங் கூடாதெ யுட்பகை யுற்ற குடி</Unicode>
      </TextEquiv>
    </TextRegion>
