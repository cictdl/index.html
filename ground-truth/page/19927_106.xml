    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,83 2685,83 2685,445 0,445"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1032; numeral=௧">
        <Coords points="0,83 2685,83 2685,119 0,119"/>
        <Baseline points="0,113 2685,113"/>
        <TextEquiv>
          <Unicode>உழுவாரு லகத்தார்க்கா ணியஃ தற்றாதொ ழுவாரெ யெல்லாம் பொறுத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1033; numeral=௨">
        <Coords points="0,119 2685,119 2685,155 0,155"/>
        <Baseline points="0,149 2685,149"/>
        <TextEquiv>
          <Unicode>உழுதுண்டு வாழ்வாரெ வாழ்வார் மற்றெல்லாந் தொழுதுண்டு பின்செல் பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1035; numeral=௩">
        <Coords points="0,155 2685,155 2685,192 0,192"/>
        <Baseline points="0,185 2685,185"/>
        <TextEquiv>
          <Unicode>இரவாரி ரப்பவக்கொன்றீ யவார் கரவாது கைசெய்தூண் மாலை யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1034; numeral=௪">
        <Coords points="0,192 2685,192 2685,228 0,228"/>
        <Baseline points="0,221 2685,221"/>
        <TextEquiv>
          <Unicode>பலகொடை நீழலுந் தன்குடைக்கீட் காண்பார லகுடை நீழ லவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1036; numeral=௫">
        <Coords points="0,228 2685,228 2685,264 0,264"/>
        <Baseline points="0,257 2685,257"/>
        <TextEquiv>
          <Unicode>உழவிநார் கைமடங்கினி ல்லை விழைவதூஊம் விட்டொமென் பார்க்கு நிலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1031; numeral=௬">
        <Coords points="0,264 2685,264 2685,300 0,300"/>
        <Baseline points="0,294 2685,294"/>
        <TextEquiv>
          <Unicode>சுழன்றுமொய்ப் பின்னது லகம தநாலு ழன்று முளவெ தலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1039; numeral=௭">
        <Coords points="0,300 2685,300 2685,336 0,336"/>
        <Baseline points="0,330 2685,330"/>
        <TextEquiv>
          <Unicode>செல்லாழ் கிளவனி ருப்பி நிலம்டந்தை புல்லாள புறள விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1037; numeral=௮">
        <Coords points="0,336 2685,336 2685,373 0,373"/>
        <Baseline points="0,366 2685,366"/>
        <TextEquiv>
          <Unicode>தொடிப்புழுதி கஃசா வுணக்கிற் பிடித்தெருவும் வேண்டாது சாலபு படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1038; numeral=௯">
        <Coords points="0,373 2685,373 2685,409 0,409"/>
        <Baseline points="0,402 2685,402"/>
        <TextEquiv>
          <Unicode>ஏரிநும் நன்றாமெ ருவிடுதல் மற்றதனபின் நீரிநும் நன்றதன் காப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1040; numeral=௰">
        <Coords points="0,409 2685,409 2685,445 0,445"/>
        <Baseline points="0,438 2685,438"/>
        <TextEquiv>
          <Unicode>இலமென்றி கையிர் ப்பாரைக் காணின் நிலமெந்நும் நல்லாள் நகும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>உழுவாரு லகத்தார்க்கா ணியஃ தற்றாதொ ழுவாரெ யெல்லாம் பொறுத்து
உழுதுண்டு வாழ்வாரெ வாழ்வார் மற்றெல்லாந் தொழுதுண்டு பின்செல் பவர்
இரவாரி ரப்பவக்கொன்றீ யவார் கரவாது கைசெய்தூண் மாலை யவர்
பலகொடை நீழலுந் தன்குடைக்கீட் காண்பார லகுடை நீழ லவர்
உழவிநார் கைமடங்கினி ல்லை விழைவதூஊம் விட்டொமென் பார்க்கு நிலை
சுழன்றுமொய்ப் பின்னது லகம தநாலு ழன்று முளவெ தலை
செல்லாழ் கிளவனி ருப்பி நிலம்டந்தை புல்லாள புறள விடும்
தொடிப்புழுதி கஃசா வுணக்கிற் பிடித்தெருவும் வேண்டாது சாலபு படும்
ஏரிநும் நன்றாமெ ருவிடுதல் மற்றதனபின் நீரிநும் நன்றதன் காப்பு
இலமென்றி கையிர் ப்பாரைக் காணின் நிலமெந்நும் நல்லாள் நகும்</Unicode>
      </TextEquiv>
    </TextRegion>
