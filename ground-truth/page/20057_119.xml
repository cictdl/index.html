      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1161; numeral=௧">
        <Coords points="0,116 2845,116 2845,146 0,146"/>
        <Baseline points="0,140 2845,140"/>
        <TextEquiv>
          <Unicode>மறபபென்மற்றி யாநிதொ நோயை யிறைப்பவர்க்கூ ற்றுநீர் போல மிகும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1162; numeral=௨">
        <Coords points="0,146 2845,146 2845,175 0,175"/>
        <Baseline points="0,170 2845,170"/>
        <TextEquiv>
          <Unicode>கரத்தலுமா ற்றெனிந் நோயைநோய் செய்தார்க்கு ரைத்தலும் நாணுத் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1165; numeral=௩">
        <Coords points="0,175 2845,175 2845,205 0,205"/>
        <Baseline points="0,199 2845,199"/>
        <TextEquiv>
          <Unicode>துப்பினெ வனாவன் மற்கொறு யிர்வரவு நட்பினுள் ளாற்று பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1168; numeral=௪">
        <Coords points="0,205 2845,205 2845,234 0,234"/>
        <Baseline points="0,229 2845,229"/>
        <TextEquiv>
          <Unicode>மந்நுயிரெ ல்லாந் துயிற்றி யளித்திராக் கெந்நல்த்தி ல்லை துணை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1170; numeral=௫">
        <Coords points="0,234 2845,234 2845,264 0,264"/>
        <Baseline points="0,258 2845,258"/>
        <TextEquiv>
          <Unicode>உள்ளம்பொன்று ள்வழிச் செல்கற்பின் வெள்ளநீர் நீந்தல மன்னோவென் கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1163; numeral=௬">
        <Coords points="0,264 2845,264 2845,293 0,293"/>
        <Baseline points="0,288 2845,288"/>
        <TextEquiv>
          <Unicode>காமமும் நாணு முயிர்காவாத் தூங்குமென் நோனா வுடம்பின கத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1169; numeral=௭">
        <Coords points="0,293 2845,293 2845,323 0,323"/>
        <Baseline points="0,318 2845,318"/>
        <TextEquiv>
          <Unicode>கொடியார் கொடிமையிற் றாங்கொடிய வின்னா நெடிய கழியுமிரா</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1166; numeral=௮">
        <Coords points="0,323 2845,323 2845,352 0,352"/>
        <Baseline points="0,347 2845,347"/>
        <TextEquiv>
          <Unicode>இன்பங் கடல்மற்றுக் காமம ஃதடுங்காற துன்பம தநிற் பெரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1167; numeral=௯">
        <Coords points="0,352 2845,352 2845,382 0,382"/>
        <Baseline points="0,377 2845,377"/>
        <TextEquiv>
          <Unicode>காமக் கடும்புநல் நீந்திக் கரைகாணேன் யாமத்தும் யாநெ யுளன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1164; numeral=௰">
        <Coords points="0,382 2845,382 2845,411 0,411"/>
        <Baseline points="0,406 2845,406"/>
        <TextEquiv>
          <Unicode>காமக் கடல்மன்னுமு ண்டெ யதுநீந்தும் ஏமப் புநைமந்நுமில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>மறபபென்மற்றி யாநிதொ நோயை யிறைப்பவர்க்கூ ற்றுநீர் போல மிகும்
கரத்தலுமா ற்றெனிந் நோயைநோய் செய்தார்க்கு ரைத்தலும் நாணுத் தரும்
துப்பினெ வனாவன் மற்கொறு யிர்வரவு நட்பினுள் ளாற்று பவர்
மந்நுயிரெ ல்லாந் துயிற்றி யளித்திராக் கெந்நல்த்தி ல்லை துணை
உள்ளம்பொன்று ள்வழிச் செல்கற்பின் வெள்ளநீர் நீந்தல மன்னோவென் கண்
காமமும் நாணு முயிர்காவாத் தூங்குமென் நோனா வுடம்பின கத்து
கொடியார் கொடிமையிற் றாங்கொடிய வின்னா நெடிய கழியுமிரா
இன்பங் கடல்மற்றுக் காமம ஃதடுங்காற துன்பம தநிற் பெரிது
காமக் கடும்புநல் நீந்திக் கரைகாணேன் யாமத்தும் யாநெ யுளன்
காமக் கடல்மன்னுமு ண்டெ யதுநீந்தும் ஏமப் புநைமந்நுமில்</Unicode>
      </TextEquiv>
