      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=913; numeral=௧">
        <Coords points="0,76 2803,76 2803,112 0,112"/>
        <Baseline points="0,105 2803,105"/>
        <TextEquiv>
          <Unicode>பொருட்பெண்டீர் பொய்மை முயக்கம் யிருட்டறையிலெ யதல் பிணந்தழிஇயற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=918; numeral=௨">
        <Coords points="0,112 2803,112 2803,148 0,148"/>
        <Baseline points="0,142 2803,142"/>
        <TextEquiv>
          <Unicode>ஆயும றிவிநர ல்லார் ணங்கென்ப மாய மகழீர் முயக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=917; numeral=௩">
        <Coords points="0,148 2803,148 2803,185 0,185"/>
        <Baseline points="0,178 2803,178"/>
        <TextEquiv>
          <Unicode>நிறைநெஞ்சமி ல்லவர் தோய்வார் பிறநெஞ்சிற் பேணிப் புணர்பவர் தோழ்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=919; numeral=௪">
        <Coords points="0,185 2803,185 2803,221 0,221"/>
        <Baseline points="0,215 2803,215"/>
        <TextEquiv>
          <Unicode>வரைவிலா மானிழையார் மென்றோழ் புரையிலாப் பூரியர்களா ழும ளறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=911; numeral=௫">
        <Coords points="0,221 2803,221 2803,258 0,258"/>
        <Baseline points="0,251 2803,251"/>
        <TextEquiv>
          <Unicode>அன்பின் விழையார் பொருள்விழையுமா யிழையார்யின்சொல்லி ழுக்கந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=912; numeral=௬">
        <Coords points="0,258 2803,258 2803,294 0,294"/>
        <Baseline points="0,288 2803,288"/>
        <TextEquiv>
          <Unicode>பயன்றூக்கிப் பண்புரைக்கும் பண்பின் மகழீர் நயன்றூக்கி நள்ளார் விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=914; numeral=௭">
        <Coords points="0,294 2803,294 2803,331 0,331"/>
        <Baseline points="0,324 2803,324"/>
        <TextEquiv>
          <Unicode>பொருட்பொருளார் புந்நலந் தோயார் அருட்பொருளா யும றிவி நவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=915; numeral=௮">
        <Coords points="0,331 2803,331 2803,367 0,367"/>
        <Baseline points="0,361 2803,361"/>
        <TextEquiv>
          <Unicode>பொதுநலத்தார் புந்நல்ந் தோயார் மதிநலத்தின் மாண்ட வறிவி நவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=916; numeral=௯">
        <Coords points="0,367 2803,367 2803,404 0,404"/>
        <Baseline points="0,397 2803,397"/>
        <TextEquiv>
          <Unicode>தந்நலம் பாரிப்பார் தோயார் தகைசெருக்கிப் புந்நலம் பாரிப்பார் தோள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=920; numeral=௰">
        <Coords points="0,404 2803,404 2803,440 0,440"/>
        <Baseline points="0,433 2803,433"/>
        <TextEquiv>
          <Unicode>இருமநப் பெண்டீருங் கள்ளுங் கவறுந் திருநீக்கப் பட்டார் தொடர்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>பொருட்பெண்டீர் பொய்மை முயக்கம் யிருட்டறையிலெ யதல் பிணந்தழிஇயற்று
ஆயும றிவிநர ல்லார் ணங்கென்ப மாய மகழீர் முயக்கு
நிறைநெஞ்சமி ல்லவர் தோய்வார் பிறநெஞ்சிற் பேணிப் புணர்பவர் தோழ்
வரைவிலா மானிழையார் மென்றோழ் புரையிலாப் பூரியர்களா ழும ளறு
அன்பின் விழையார் பொருள்விழையுமா யிழையார்யின்சொல்லி ழுக்கந் தரும்
பயன்றூக்கிப் பண்புரைக்கும் பண்பின் மகழீர் நயன்றூக்கி நள்ளார் விடல்
பொருட்பொருளார் புந்நலந் தோயார் அருட்பொருளா யும றிவி நவர்
பொதுநலத்தார் புந்நல்ந் தோயார் மதிநலத்தின் மாண்ட வறிவி நவர்
தந்நலம் பாரிப்பார் தோயார் தகைசெருக்கிப் புந்நலம் பாரிப்பார் தோள்
இருமநப் பெண்டீருங் கள்ளுங் கவறுந் திருநீக்கப் பட்டார் தொடர்பு</Unicode>
      </TextEquiv>
