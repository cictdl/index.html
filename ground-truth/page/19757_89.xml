    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,92 2946,92 2946,476 0,476"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=868; numeral=௧">
        <Coords points="0,92 2946,92 2946,131 0,131"/>
        <Baseline points="0,124 2946,124"/>
        <TextEquiv>
          <Unicode>குநநிலநாய்க் குற்றம் பலவாயின் மாற்றார்க்கி னனிலநா யெமாப் புடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=865; numeral=௨">
        <Coords points="0,131 2946,131 2946,169 0,169"/>
        <Baseline points="0,162 2946,162"/>
        <TextEquiv>
          <Unicode>வழிநோக்கான் வாய்ப்பந செய்யான் பழிநோக்கான் பண்பிலரன் பற்றார்க்கிநிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=863; numeral=௩">
        <Coords points="0,169 2946,169 2946,207 0,207"/>
        <Baseline points="0,200 2946,200"/>
        <TextEquiv>
          <Unicode>அஞ்சும றியான்ன மைவிலனீ கலான் றஞ்சமெ ழியன் பகைக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=866; numeral=௪">
        <Coords points="0,207 2946,207 2946,246 0,246"/>
        <Baseline points="0,239 2946,239"/>
        <TextEquiv>
          <Unicode>காணாச் சினத்தான் கழிபெருங் காமத்தான் பேணாமை பேணப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=867; numeral=௫">
        <Coords points="0,246 2946,246 2946,284 0,284"/>
        <Baseline points="0,277 2946,277"/>
        <TextEquiv>
          <Unicode>கொடுத்துங் கொளல்வேண்டு மன்ற மடுத்திருந்து மாணாது  செய்வான் பகை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=864; numeral=௬">
        <Coords points="0,284 2946,284 2946,322 0,322"/>
        <Baseline points="0,315 2946,315"/>
        <TextEquiv>
          <Unicode>நீங்கான் வெகுளி நிறைவில்நெ ஞ்ஞான்று மாங்காணுமி யார்க்குமெ ழிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=869; numeral=௭">
        <Coords points="0,322 2946,322 2946,361 0,361"/>
        <Baseline points="0,354 2946,354"/>
        <TextEquiv>
          <Unicode>செருவார்க்குஞ் சேணிகவா வின்பம் அறிவில்லா வஞ்சு பகைவர்ப் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=862; numeral=௮">
        <Coords points="0,361 2946,361 2946,399 0,399"/>
        <Baseline points="0,392 2946,392"/>
        <TextEquiv>
          <Unicode>அன்பிலனா ன்ற துணையிலன் றான்றுவ்வானெ ன்பரியுமே திலான் றுப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=870; numeral=௯">
        <Coords points="0,399 2946,399 2946,437 0,437"/>
        <Baseline points="0,430 2946,430"/>
        <TextEquiv>
          <Unicode>கல்லான் வெகுளுஞ் குறுபொருளென்று மொல்லாநை யொல்லா தொளி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=861; numeral=௰">
        <Coords points="0,437 2946,437 2946,476 0,476"/>
        <Baseline points="0,469 2946,469"/>
        <TextEquiv>
          <Unicode>வலியார்க்கு மாறேற்றலொ ம்புக வோம்பா மெலியார்மேல் மேக பகை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>குநநிலநாய்க் குற்றம் பலவாயின் மாற்றார்க்கி னனிலநா யெமாப் புடைத்து
வழிநோக்கான் வாய்ப்பந செய்யான் பழிநோக்கான் பண்பிலரன் பற்றார்க்கிநிது
அஞ்சும றியான்ன மைவிலனீ கலான் றஞ்சமெ ழியன் பகைக்கு
காணாச் சினத்தான் கழிபெருங் காமத்தான் பேணாமை பேணப் படும்
கொடுத்துங் கொளல்வேண்டு மன்ற மடுத்திருந்து மாணாது  செய்வான் பகை
நீங்கான் வெகுளி நிறைவில்நெ ஞ்ஞான்று மாங்காணுமி யார்க்குமெ ழிது
செருவார்க்குஞ் சேணிகவா வின்பம் அறிவில்லா வஞ்சு பகைவர்ப் பெறின்
அன்பிலனா ன்ற துணையிலன் றான்றுவ்வானெ ன்பரியுமே திலான் றுப்பு
கல்லான் வெகுளுஞ் குறுபொருளென்று மொல்லாநை யொல்லா தொளி
வலியார்க்கு மாறேற்றலொ ம்புக வோம்பா மெலியார்மேல் மேக பகை</Unicode>
      </TextEquiv>
