    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,84 2783,84 2783,404 0,404"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1196; numeral=௧">
        <Coords points="0,84 2783,84 2783,116 0,116"/>
        <Baseline points="0,111 2783,111"/>
        <TextEquiv>
          <Unicode>ஒருதலையானி ந்நாது காமங்காற் போல விருதலை யாநுமி நிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1193; numeral=௨">
        <Coords points="0,116 2783,116 2783,148 0,148"/>
        <Baseline points="0,143 2783,143"/>
        <TextEquiv>
          <Unicode>வீழுநர் வீழப் படுவார்க்க மைந்த்தெ வாழுனமெ ந்நுஞ் செருக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1192; numeral=௩">
        <Coords points="0,148 2783,148 2783,180 0,180"/>
        <Baseline points="0,175 2783,175"/>
        <TextEquiv>
          <Unicode>வாழ்வார்க்கு வாநம் பயந்தற்றால் வீழ்வார்க்கு வீழ்வார ழிக்குமளி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1195; numeral=௪">
        <Coords points="0,180 2783,180 2783,212 0,212"/>
        <Baseline points="0,206 2783,206"/>
        <TextEquiv>
          <Unicode>யாங்காதல் கொண்டாரடெல்க்கெவன் செய்தொ தாங்காதல் கொள்ளாக் கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1197; numeral=௫">
        <Coords points="0,212 2783,212 2783,244 0,244"/>
        <Baseline points="0,238 2783,238"/>
        <TextEquiv>
          <Unicode>பருவரலும் பைதலுங் காணான்கொல் காமன்னொ ருவர்கண் ணின்றொழுக லான்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1198; numeral=௬">
        <Coords points="0,244 2783,244 2783,276 0,276"/>
        <Baseline points="0,270 2783,270"/>
        <TextEquiv>
          <Unicode>வீழ்வாரிநி ன்சொற் செபறாஅது உலகத்து வாழ்வாரின் வன்கணாரில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1199; numeral=௭">
        <Coords points="0,276 2783,276 2783,308 0,308"/>
        <Baseline points="0,302 2783,302"/>
        <TextEquiv>
          <Unicode>நசையில்லார் நல்காரெ நினும வர்மாட்டி சையுமி நிய செவிக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1200; numeral=௮">
        <Coords points="0,308 2783,308 2783,340 0,340"/>
        <Baseline points="0,334 2783,334"/>
        <TextEquiv>
          <Unicode>உறாஅர்க்கு றுநோயு ரைப்பாய் கடலைச் செறாய வாழியெ நெஞ்சு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1191; numeral=௯">
        <Coords points="0,340 2783,340 2783,372 0,372"/>
        <Baseline points="0,366 2783,366"/>
        <TextEquiv>
          <Unicode>தாம்வீழார் தாம்வீழப் பெற்றவர் பெற்றாரெ காமத்துக் காழில் கநி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1194; numeral=௰">
        <Coords points="0,372 2783,372 2783,404 0,404"/>
        <Baseline points="0,398 2783,398"/>
        <TextEquiv>
          <Unicode>வீழப் படுவார்க் கெளியிலரெ தாம்வீழ்வார் வீழப் படாரெ நின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>ஒருதலையானி ந்நாது காமங்காற் போல விருதலை யாநுமி நிது
வீழுநர் வீழப் படுவார்க்க மைந்த்தெ வாழுனமெ ந்நுஞ் செருக்கு
வாழ்வார்க்கு வாநம் பயந்தற்றால் வீழ்வார்க்கு வீழ்வார ழிக்குமளி
யாங்காதல் கொண்டாரடெல்க்கெவன் செய்தொ தாங்காதல் கொள்ளாக் கடை
பருவரலும் பைதலுங் காணான்கொல் காமன்னொ ருவர்கண் ணின்றொழுக லான்
வீழ்வாரிநி ன்சொற் செபறாஅது உலகத்து வாழ்வாரின் வன்கணாரில்
நசையில்லார் நல்காரெ நினும வர்மாட்டி சையுமி நிய செவிக்கு
உறாஅர்க்கு றுநோயு ரைப்பாய் கடலைச் செறாய வாழியெ நெஞ்சு
தாம்வீழார் தாம்வீழப் பெற்றவர் பெற்றாரெ காமத்துக் காழில் கநி
வீழப் படுவார்க் கெளியிலரெ தாம்வீழ்வார் வீழப் படாரெ நின்</Unicode>
      </TextEquiv>
    </TextRegion>
