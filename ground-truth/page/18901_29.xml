    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,107 2865,107 2865,491 0,491"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=266; numeral=௧">
        <Coords points="0,107 2865,107 2865,146 0,146"/>
        <Baseline points="0,139 2865,139"/>
        <TextEquiv>
          <Unicode>தவஞ்செய்வார் தங்கருமஞ் செய்வார்மற் றெல்லாம் மவஞ்செய்வா ராசையுடப் பட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=262; numeral=௨">
        <Coords points="0,146 2865,146 2865,184 0,184"/>
        <Baseline points="0,177 2865,177"/>
        <TextEquiv>
          <Unicode>தவமுந் தவமுயல்வார்க் காகும் மதநை யஃதிலார் மேற்கொள் வது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=268; numeral=௩">
        <Coords points="0,184 2865,184 2865,223 0,223"/>
        <Baseline points="0,216 2865,216"/>
        <TextEquiv>
          <Unicode>தந்நுயிர் தான்றப் பெற்றாநை யேநைய மந்நுயி ரெல்லாந் தொழும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=264; numeral=௪">
        <Coords points="0,223 2865,223 2865,261 0,261"/>
        <Baseline points="0,254 2865,254"/>
        <TextEquiv>
          <Unicode>ஒந்நாரைத் தேறலு முவந்தாரை யாக்கலும் எண்ணித் தவத்தால் வரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=269; numeral=௫">
        <Coords points="0,261 2865,261 2865,299 0,299"/>
        <Baseline points="0,292 2865,292"/>
        <TextEquiv>
          <Unicode>கூற்றங் குதித்தலுங் கைகூடும நோற்றலின்னா தலைப்பட்ட வர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=267; numeral=௬">
        <Coords points="0,299 2865,299 2865,338 0,338"/>
        <Baseline points="0,331 2865,331"/>
        <TextEquiv>
          <Unicode>சுடச்சுடரும் பொன்போ லொளிவிடுந் துன்பஞ்சுடச்சுட நோகிப் பவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=261; numeral=௭">
        <Coords points="0,338 2865,338 2865,376 0,376"/>
        <Baseline points="0,369 2865,369"/>
        <TextEquiv>
          <Unicode>உற்றநோய் நீக்கியுயிர்க்குறுகண் செய்யாமையற்றே தவத்திற் குறிப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=270; numeral=௮">
        <Coords points="0,376 2865,376 2865,414 0,414"/>
        <Baseline points="0,407 2865,407"/>
        <TextEquiv>
          <Unicode>இலர்பலராகிய காரணம் நோற்பார் சிலர்பலர் நோலா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=263; numeral=௯">
        <Coords points="0,414 2865,414 2865,453 0,453"/>
        <Baseline points="0,446 2865,446"/>
        <TextEquiv>
          <Unicode>துறந்தார்க்குத் துப்புரவு வேண்டி மறந்தார்கொல் மற்றை யவர்க டவம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=265; numeral=௰">
        <Coords points="0,453 2865,453 2865,491 0,491"/>
        <Baseline points="0,484 2865,484"/>
        <TextEquiv>
          <Unicode>வேண்டிய வேண்டியாங் கெய்தலாற் செய்தவம் மீண்டு முயலப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>தவஞ்செய்வார் தங்கருமஞ் செய்வார்மற் றெல்லாம் மவஞ்செய்வா ராசையுடப் பட்டு
தவமுந் தவமுயல்வார்க் காகும் மதநை யஃதிலார் மேற்கொள் வது
தந்நுயிர் தான்றப் பெற்றாநை யேநைய மந்நுயி ரெல்லாந் தொழும்
ஒந்நாரைத் தேறலு முவந்தாரை யாக்கலும் எண்ணித் தவத்தால் வரும்
கூற்றங் குதித்தலுங் கைகூடும நோற்றலின்னா தலைப்பட்ட வர்க்கு
சுடச்சுடரும் பொன்போ லொளிவிடுந் துன்பஞ்சுடச்சுட நோகிப் பவர்க்கு
உற்றநோய் நீக்கியுயிர்க்குறுகண் செய்யாமையற்றே தவத்திற் குறிப்பு
இலர்பலராகிய காரணம் நோற்பார் சிலர்பலர் நோலா தவர்
துறந்தார்க்குத் துப்புரவு வேண்டி மறந்தார்கொல் மற்றை யவர்க டவம்
வேண்டிய வேண்டியாங் கெய்தலாற் செய்தவம் மீண்டு முயலப் படும்</Unicode>
      </TextEquiv>
    </TextRegion>
