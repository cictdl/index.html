      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=141; numeral=௧">
        <Coords points="0,123 2974,123 2974,163 0,163"/>
        <Baseline points="0,156 2974,156"/>
        <TextEquiv>
          <Unicode>பிறன்பொருளாற் பெட்டொழுகும் பேதைமை ஞாலத் தறம்பொருள் கண்டார்க ணில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=142; numeral=௨">
        <Coords points="0,163 2974,163 2974,203 0,203"/>
        <Baseline points="0,196 2974,196"/>
        <TextEquiv>
          <Unicode>அறன்கடை நின்றாரு ளெல்லாம் பிறன்கடை கண்டாரிற் பேதையா ரில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=143; numeral=௩">
        <Coords points="0,203 2974,203 2974,244 0,244"/>
        <Baseline points="0,237 2974,237"/>
        <TextEquiv>
          <Unicode>விழிந்தாரின் வேறல்லர் மன்றற் தெழிந்தாரிற் தீமை புரிந்தொழுகு வார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=144; numeral=௪">
        <Coords points="0,244 2974,244 2974,284 0,284"/>
        <Baseline points="0,277 2974,277"/>
        <TextEquiv>
          <Unicode>எநைத்துணைய ராயிநு மெந்நாந் திநைத்துணையுந் தேரான் பிறநில்ப் புகல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=145; numeral=௫">
        <Coords points="0,284 2974,284 2974,325 0,325"/>
        <Baseline points="0,318 2974,318"/>
        <TextEquiv>
          <Unicode>எழிதெந் வில்லிரப்பா நெய்து மெஞ் ஞான்றும் விழியாது நிர்க்கும் பழி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=146; numeral=௬">
        <Coords points="0,325 2974,325 2974,365 0,365"/>
        <Baseline points="0,358 2974,358"/>
        <TextEquiv>
          <Unicode>பகைபாவம் அச்சம் பழியெந் நான்கு மிகவாவா மில்லிரப்பான் கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=147; numeral=௭">
        <Coords points="0,365 2974,365 2974,406 0,406"/>
        <Baseline points="0,399 2974,399"/>
        <TextEquiv>
          <Unicode>அறனியலா னில்வாழ்வா னென்பான் பிறநியலாள் பெண்மை நயவா தவன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=148; numeral=௮">
        <Coords points="0,406 2974,406 2974,446 0,446"/>
        <Baseline points="0,439 2974,439"/>
        <TextEquiv>
          <Unicode>பிறன்மநை நோக்காத பேராண்மை சான்றோர்க் கறன்னறொ வான்ற வொழுக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=149; numeral=௯">
        <Coords points="0,446 2974,446 2974,487 0,487"/>
        <Baseline points="0,480 2974,480"/>
        <TextEquiv>
          <Unicode>நலக்குரியரி யாரெநின் நாம நீர் வைப்பிற் பிறர்க்குரியா டோடோயா தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=150; numeral=௰">
        <Coords points="0,487 2974,487 2974,527 0,527"/>
        <Baseline points="0,520 2974,520"/>
        <TextEquiv>
          <Unicode>அறன்வரையா னல்ல செயிநு பிறன்வரையாள் பெண்மை நயவாமை நன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>பிறன்பொருளாற் பெட்டொழுகும் பேதைமை ஞாலத் தறம்பொருள் கண்டார்க ணில்
அறன்கடை நின்றாரு ளெல்லாம் பிறன்கடை கண்டாரிற் பேதையா ரில்
விழிந்தாரின் வேறல்லர் மன்றற் தெழிந்தாரிற் தீமை புரிந்தொழுகு வார்
எநைத்துணைய ராயிநு மெந்நாந் திநைத்துணையுந் தேரான் பிறநில்ப் புகல்
எழிதெந் வில்லிரப்பா நெய்து மெஞ் ஞான்றும் விழியாது நிர்க்கும் பழி
பகைபாவம் அச்சம் பழியெந் நான்கு மிகவாவா மில்லிரப்பான் கண்
அறனியலா னில்வாழ்வா னென்பான் பிறநியலாள் பெண்மை நயவா தவன்
பிறன்மநை நோக்காத பேராண்மை சான்றோர்க் கறன்னறொ வான்ற வொழுக்கு
நலக்குரியரி யாரெநின் நாம நீர் வைப்பிற் பிறர்க்குரியா டோடோயா தார்
அறன்வரையா னல்ல செயிநு பிறன்வரையாள் பெண்மை நயவாமை நன்று</Unicode>
      </TextEquiv>
