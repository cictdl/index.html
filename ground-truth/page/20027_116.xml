      <Coords points="0,118 2834,118 2834,456 0,456"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1131; numeral=௧">
        <Coords points="0,118 2834,118 2834,152 0,152"/>
        <Baseline points="0,146 2834,146"/>
        <TextEquiv>
          <Unicode>காமமு ழந்நு வருந்திநார்க்கெ காம மடலல்ல தில்லை வலி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1136; numeral=௨">
        <Coords points="0,152 2834,152 2834,186 0,186"/>
        <Baseline points="0,180 2834,180"/>
        <TextEquiv>
          <Unicode>மடலூர்தல் யாமத்துமு ள்ளுவென் மன்றம் படலெல்லாம் பேதைக்கென் கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1135; numeral=௩">
        <Coords points="0,186 2834,186 2834,220 0,220"/>
        <Baseline points="0,214 2834,214"/>
        <TextEquiv>
          <Unicode>தொடலைக் குறுந்தொடி தந்தான் மடலொடு மாலை யுழக்குந் துயர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1140; numeral=௪">
        <Coords points="0,220 2834,220 2834,254 0,254"/>
        <Baseline points="0,247 2834,247"/>
        <TextEquiv>
          <Unicode>யாங்காணிற் காண நகுப வறிவில்லார் யாம்பட்ட தாம்படா வாறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1133; numeral=௫">
        <Coords points="0,254 2834,254 2834,287 0,287"/>
        <Baseline points="0,281 2834,281"/>
        <TextEquiv>
          <Unicode>நாணொடு நல்லாண்மை பண்டுடையெனின்றுடையென் காமுற்றாரேறும் மடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1137; numeral=௬">
        <Coords points="0,287 2834,287 2834,321 0,321"/>
        <Baseline points="0,315 2834,315"/>
        <TextEquiv>
          <Unicode>கடலந்ந காமமு ழந்தும் மடலேறாப் பெண்ணிற் பெருந்தக்க தில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1138; numeral=௭">
        <Coords points="0,321 2834,321 2834,355 0,355"/>
        <Baseline points="0,349 2834,349"/>
        <TextEquiv>
          <Unicode>நிறையழியர் மந்நழியர் தெந்நாது காமம் மறையிறந்து மன்று படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1139; numeral=௮">
        <Coords points="0,355 2834,355 2834,389 0,389"/>
        <Baseline points="0,383 2834,383"/>
        <TextEquiv>
          <Unicode>அறிவிலாரெ ல்லாருமொ ன்றெயெந்க் காமம் மறுகின் மறுகு மருண்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1134; numeral=௯">
        <Coords points="0,389 2834,389 2834,422 0,422"/>
        <Baseline points="0,416 2834,416"/>
        <TextEquiv>
          <Unicode>காமக் கடல்ம் ந்நு முண்டொமதுந்நதும் மேம்ப்புநை ம்ந்நு மில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1132; numeral=௰">
        <Coords points="0,422 2834,422 2834,456 0,456"/>
        <Baseline points="0,450 2834,450"/>
        <TextEquiv>
          <Unicode>நோனா வுடம்புமு யிரு மடலேறும் நாணினை நீக்கி நிறுத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>காமமு ழந்நு வருந்திநார்க்கெ காம மடலல்ல தில்லை வலி
மடலூர்தல் யாமத்துமு ள்ளுவென் மன்றம் படலெல்லாம் பேதைக்கென் கண்
தொடலைக் குறுந்தொடி தந்தான் மடலொடு மாலை யுழக்குந் துயர்
