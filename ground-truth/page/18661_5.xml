    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,150 3084,150 3084,563 0,563"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=21; numeral=௧">
        <Coords points="0,150 3084,150 3084,192 0,192"/>
        <Baseline points="0,184 3084,184"/>
        <TextEquiv>
          <Unicode>ஒழுக்கத்து நீத்தார் பெருமை விழுப்பத்துள் வேண்டும் பனுவற் றுணிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=22; numeral=௨">
        <Coords points="0,192 3084,192 3084,233 0,233"/>
        <Baseline points="0,225 3084,225"/>
        <TextEquiv>
          <Unicode>துறந்தார் பெருமை துணைக்கூறின் வையத் திறந்தாரை யெண்ணிக்கொண் டற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=23; numeral=௩">
        <Coords points="0,233 3084,233 3084,274 0,274"/>
        <Baseline points="0,267 3084,267"/>
        <TextEquiv>
          <Unicode>இருமை வகைதெரிந் தீண்டறம் பூண்டார் பெருமை பிறங்கிற் றுலகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=24; numeral=௪">
        <Coords points="0,274 3084,274 3084,315 0,315"/>
        <Baseline points="0,308 3084,308"/>
        <TextEquiv>
          <Unicode>உரனென்னுந் தோட்டியா னோரைந்துங் காப்பான் வரனென்னும் வைப்புக்கோர் வித்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=25; numeral=௫">
        <Coords points="0,315 3084,315 3084,356 0,356"/>
        <Baseline points="0,349 3084,349"/>
        <TextEquiv>
          <Unicode>ஐந்தவித்தா னாற்ற லகல்விசும்பு ளார்கோமா னிந்திரனே சாலுங் கரி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=26; numeral=௬">
        <Coords points="0,356 3084,356 3084,398 0,398"/>
        <Baseline points="0,390 3084,390"/>
        <TextEquiv>
          <Unicode>செயற்கரிய செய்வார் பெரியர் சிறியர் செயற்கரிய செய்கலா தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=27; numeral=௭">
        <Coords points="0,398 3084,398 3084,439 0,439"/>
        <Baseline points="0,432 3084,432"/>
        <TextEquiv>
          <Unicode>சுவையொளி யூறோசை நாற்றமென் றைந்தின் வகைதெரிவான் கட்டே யுலகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=28; numeral=௮">
        <Coords points="0,439 3084,439 3084,480 0,480"/>
        <Baseline points="0,473 3084,473"/>
        <TextEquiv>
          <Unicode>நிறைமொழி மாந்தர் பெருமை நிலத்து மறைமொழி காட்டிவிடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=29; numeral=௯">
        <Coords points="0,480 3084,480 3084,521 0,521"/>
        <Baseline points="0,514 3084,514"/>
        <TextEquiv>
          <Unicode>குணமென்னுங் குன்றேறி நின்றார் வெகுளி கணமேயுங் காத்தலரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=30; numeral=௰">
        <Coords points="0,521 3084,521 3084,563 0,563"/>
        <Baseline points="0,555 3084,555"/>
        <TextEquiv>
          <Unicode>அந்தண ரென்போ ரறவோர்மற் றெவ்வுயிர்க்குஞ் செந்தண்மை பூண்டொழுக லான்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>ஒழுக்கத்து நீத்தார் பெருமை விழுப்பத்துள் வேண்டும் பனுவற் றுணிவு
துறந்தார் பெருமை துணைக்கூறின் வையத் திறந்தாரை யெண்ணிக்கொண் டற்று
இருமை வகைதெரிந் தீண்டறம் பூண்டார் பெருமை பிறங்கிற் றுலகு
உரனென்னுந் தோட்டியா னோரைந்துங் காப்பான் வரனென்னும் வைப்புக்கோர் வித்து
ஐந்தவித்தா னாற்ற லகல்விசும்பு ளார்கோமா னிந்திரனே சாலுங் கரி
செயற்கரிய செய்வார் பெரியர் சிறியர் செயற்கரிய செய்கலா தார்
சுவையொளி யூறோசை நாற்றமென் றைந்தின் வகைதெரிவான் கட்டே யுலகு
நிறைமொழி மாந்தர் பெருமை நிலத்து மறைமொழி காட்டிவிடும்
குணமென்னுங் குன்றேறி நின்றார் வெகுளி கணமேயுங் காத்தலரிது
அந்தண ரென்போ ரறவோர்மற் றெவ்வுயிர்க்குஞ் செந்தண்மை பூண்டொழுக லான்</Unicode>
      </TextEquiv>
    </TextRegion>
