    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,127 2888,127 2888,465 0,465"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1176; numeral=௧">
        <Coords points="0,127 2888,127 2888,161 0,161"/>
        <Baseline points="0,155 2888,155"/>
        <TextEquiv>
          <Unicode>ஓஒ விநிதெ யெமக்கிந்நோய் செய்தகண் டாஅமிடற்பட்டது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1173; numeral=௨">
        <Coords points="0,161 2888,161 2888,195 0,195"/>
        <Baseline points="0,189 2888,189"/>
        <TextEquiv>
          <Unicode>கதுமெனத் தாநோக்கித் தாநெ கலுழும் மகநகத் தக்க துடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1171; numeral=௩">
        <Coords points="0,195 2888,195 2888,229 0,229"/>
        <Baseline points="0,223 2888,223"/>
        <TextEquiv>
          <Unicode>கண்டான் கலுழ்வ தெவன்கொலொ தண்டாநோய் தான்காட்ட யான்கண் டது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1172; numeral=௪">
        <Coords points="0,229 2888,229 2888,262 0,262"/>
        <Baseline points="0,256 2888,256"/>
        <TextEquiv>
          <Unicode>தெரிந்துணரா நோக்கிய வொண்கண் பரிந்துணராப் பைதலு ழப்பதெ வன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1175; numeral=௫">
        <Coords points="0,262 2888,262 2888,296 0,296"/>
        <Baseline points="0,290 2888,290"/>
        <TextEquiv>
          <Unicode>படலாற்றா றபைதலு ழக்கும் கடலாற்றாற்க் காமநோயுற்ற வென் கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1179; numeral=௬">
        <Coords points="0,296 2888,296 2888,330 0,330"/>
        <Baseline points="0,324 2888,324"/>
        <TextEquiv>
          <Unicode>வாராக்காற்று ஞ்சா வரிற்றுஞ்சா வாயிடை யாரஞரு ற்றந கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1178; numeral=௭">
        <Coords points="0,330 2888,330 2888,363 0,363"/>
        <Baseline points="0,357 2888,357"/>
        <TextEquiv>
          <Unicode>பேணாது பெட்டரு ளர்மந்நொ கொண்கநைக் காணாத மையல கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1174; numeral=௮">
        <Coords points="0,363 2888,363 2888,397 0,397"/>
        <Baseline points="0,391 2888,391"/>
        <TextEquiv>
          <Unicode>பெயலாற்றா நீருலந்த வொண்கண்ணு யலாற்றா வுய்வில்நோயயென் கணிறுத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1180; numeral=௯">
        <Coords points="0,397 2888,397 2888,431 0,431"/>
        <Baseline points="0,425 2888,425"/>
        <TextEquiv>
          <Unicode>மறைபெறலலூரற் கரிதென்றெ நெம்போல றைபறை கண்ணா கத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1177; numeral=௰">
        <Coords points="0,431 2888,431 2888,465 0,465"/>
        <Baseline points="0,459 2888,459"/>
        <TextEquiv>
          <Unicode>உழந்துழந் துண்ணீரறுக விழைந்திழைந்து வேண்டி யவற்கண்ட கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>ஓஒ விநிதெ யெமக்கிந்நோய் செய்தகண் டாஅமிடற்பட்டது
கதுமெனத் தாநோக்கித் தாநெ கலுழும் மகநகத் தக்க துடைத்து
கண்டான் கலுழ்வ தெவன்கொலொ தண்டாநோய் தான்காட்ட யான்கண் டது
தெரிந்துணரா நோக்கிய வொண்கண் பரிந்துணராப் பைதலு ழப்பதெ வன்
படலாற்றா றபைதலு ழக்கும் கடலாற்றாற்க் காமநோயுற்ற வென் கண்
வாராக்காற்று ஞ்சா வரிற்றுஞ்சா வாயிடை யாரஞரு ற்றந கண்
பேணாது பெட்டரு ளர்மந்நொ கொண்கநைக் காணாத மையல கண்
பெயலாற்றா நீருலந்த வொண்கண்ணு யலாற்றா வுய்வில்நோயயென் கணிறுத்து
மறைபெறலலூரற் கரிதென்றெ நெம்போல றைபறை கண்ணா கத்து
உழந்துழந் துண்ணீரறுக விழைந்திழைந்து வேண்டி யவற்கண்ட கண்</Unicode>
      </TextEquiv>
    </TextRegion>
