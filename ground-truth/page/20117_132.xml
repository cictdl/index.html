    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,149 2896,149 2896,509 0,509"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1227; numeral=௧">
        <Coords points="0,149 2896,149 2896,185 0,185"/>
        <Baseline points="0,178 2896,178"/>
        <TextEquiv>
          <Unicode>காலை யரும்பிப் பகலெலாம் போதாகி மாலை மலருமிந்    நோய்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1223; numeral=௨">
        <Coords points="0,185 2896,185 2896,221 0,221"/>
        <Baseline points="0,214 2896,214"/>
        <TextEquiv>
          <Unicode>பநியரும்பிப் பைதல்கொண் மாலைத்  துநியரும்பித்துநன்பம் வளர வரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1229; numeral=௩">
        <Coords points="0,221 2896,221 2896,257 0,257"/>
        <Baseline points="0,250 2896,250"/>
        <TextEquiv>
          <Unicode>பதிமருண்டு பைத லுழக்கும் மதிமருண்டு மாலை படர்தரும் போழ்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1224; numeral=௪">
        <Coords points="0,257 2896,257 2896,293 0,293"/>
        <Baseline points="0,286 2896,286"/>
        <TextEquiv>
          <Unicode>காதல ரில்வழி மாலை கொலைக்களத் தேதிலர் போல வரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1226; numeral=௫">
        <Coords points="0,293 2896,293 2896,329 0,329"/>
        <Baseline points="0,322 2896,322"/>
        <TextEquiv>
          <Unicode>மாலைநோய் செய்தார் மணந்தார கலாத காலை யறிந்த திலென்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1228; numeral=௬">
        <Coords points="0,329 2896,329 2896,365 0,365"/>
        <Baseline points="0,358 2896,358"/>
        <TextEquiv>
          <Unicode>அழல்போலு மாலைக்குத் தூதா கியாயன் குழல்போலுங் கொல்லும் படை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1225; numeral=௭">
        <Coords points="0,365 2896,365 2896,401 0,401"/>
        <Baseline points="0,394 2896,394"/>
        <TextEquiv>
          <Unicode>காலைக்குச் செய்தநன்  றென்கொல் லெவன்கொல்லியான மாலைக்குச் செய்தபகை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1230; numeral=௮">
        <Coords points="0,401 2896,401 2896,437 0,437"/>
        <Baseline points="0,430 2896,430"/>
        <TextEquiv>
          <Unicode>பொருண்மாலை யாளரை யுள்ளி மருண்மாலை மாயுமென்  மாவுயிர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1221; numeral=௯">
        <Coords points="0,437 2896,437 2896,473 0,473"/>
        <Baseline points="0,466 2896,466"/>
        <TextEquiv>
          <Unicode>மாலை நீயல்லை மணந்தாருயிருண்நநுணும் வேலை நிவாழி பொழுது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1222; numeral=௰">
        <Coords points="0,473 2896,473 2896,509 0,509"/>
        <Baseline points="0,502 2896,502"/>
        <TextEquiv>
          <Unicode>புன்கண்ணை வாழி மருண்மாலை யெங்கேழ்போல் வன்கண்ண தொநின்றுணை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>காலை யரும்பிப் பகலெலாம் போதாகி மாலை மலருமிந்    நோய்
பநியரும்பிப் பைதல்கொண் மாலைத்  துநியரும்பித்துநன்பம் வளர வரும்
பதிமருண்டு பைத லுழக்கும் மதிமருண்டு மாலை படர்தரும் போழ்து
காதல ரில்வழி மாலை கொலைக்களத் தேதிலர் போல வரும்
மாலைநோய் செய்தார் மணந்தார கலாத காலை யறிந்த திலென்
அழல்போலு மாலைக்குத் தூதா கியாயன் குழல்போலுங் கொல்லும் படை
காலைக்குச் செய்தநன்  றென்கொல் லெவன்கொல்லியான மாலைக்குச் செய்தபகை
பொருண்மாலை யாளரை யுள்ளி மருண்மாலை மாயுமென்  மாவுயிர்
மாலை நீயல்லை மணந்தாருயிருண்நநுணும் வேலை நிவாழி பொழுது
புன்கண்ணை வாழி மருண்மாலை யெங்கேழ்போல் வன்கண்ண தொநின்றுணை</Unicode>
      </TextEquiv>
    </TextRegion>
