    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,92 2731,92 2731,468 0,468"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=431; numeral=௧">
        <Coords points="0,92 2731,92 2731,130 0,130"/>
        <Baseline points="0,123 2731,123"/>
        <TextEquiv>
          <Unicode>செருக்குஞ் சிநமுஞ் சிறுமையுமி ல்லார் பெருக்கம் பெருமித நீத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=434; numeral=௨">
        <Coords points="0,130 2731,130 2731,167 0,167"/>
        <Baseline points="0,161 2731,161"/>
        <TextEquiv>
          <Unicode>செயற்பால செய்யா திவறியான் செல்வமு யற்பால தின்றிக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=435; numeral=௩">
        <Coords points="0,167 2731,167 2731,205 0,205"/>
        <Baseline points="0,198 2731,198"/>
        <TextEquiv>
          <Unicode>பற்றுள்ளமெ ந்நுமி வறன்மை யெற்றுள்ளுமெ ண்ணப் படுவதொன் றன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=438; numeral=௪">
        <Coords points="0,205 2731,205 2731,243 0,243"/>
        <Baseline points="0,236 2731,236"/>
        <TextEquiv>
          <Unicode>வியவற்க மெ ஞ்ஞான்றுந் தந்நை நயவற்க நன்றி பயவா விநை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=439; numeral=௫">
        <Coords points="0,243 2731,243 2731,280 0,280"/>
        <Baseline points="0,273 2731,273"/>
        <TextEquiv>
          <Unicode>காதல காதல றியாமை யுய்க்கிற்பின் னே தில வேதிலார் நூல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=437; numeral=௬">
        <Coords points="0,280 2731,280 2731,318 0,318"/>
        <Baseline points="0,311 2731,311"/>
        <TextEquiv>
          <Unicode>வருமுந்நர்க் காவாதான் வாட்கை யெரிமுந்நர் வைத்தூறு போலக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=436; numeral=௭">
        <Coords points="0,318 2731,318 2731,355 0,355"/>
        <Baseline points="0,349 2731,349"/>
        <TextEquiv>
          <Unicode>தன்குத்தம் நீக்கிப் பிறர்குற்றங் காண்கிற்பின் நென்குற்ற மாகுமி றைக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=433; numeral=௮">
        <Coords points="0,355 2731,355 2731,393 0,393"/>
        <Baseline points="0,386 2731,386"/>
        <TextEquiv>
          <Unicode>குற்றமெ கார்க்கப் பொருளாகக் குற்றமெ யற்ற தரூம் பகை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=432; numeral=௯">
        <Coords points="0,393 2731,393 2731,430 0,430"/>
        <Baseline points="0,424 2731,424"/>
        <TextEquiv>
          <Unicode>திநைத்துணையாங் குற்றம் வரிநும் பநைத்துணையாய்க் கொள்வார் பழிநாணு வார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=440; numeral=௰">
        <Coords points="0,430 2731,430 2731,468 0,468"/>
        <Baseline points="0,461 2731,461"/>
        <TextEquiv>
          <Unicode>இவறலு மாண்பிறந்த மாநமு மாணா வுவகையுமே தமி றைக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>செருக்குஞ் சிநமுஞ் சிறுமையுமி ல்லார் பெருக்கம் பெருமித நீத்து
செயற்பால செய்யா திவறியான் செல்வமு யற்பால தின்றிக் கெடும்
பற்றுள்ளமெ ந்நுமி வறன்மை யெற்றுள்ளுமெ ண்ணப் படுவதொன் றன்று
வியவற்க மெ ஞ்ஞான்றுந் தந்நை நயவற்க நன்றி பயவா விநை
காதல காதல றியாமை யுய்க்கிற்பின் னே தில வேதிலார் நூல்
வருமுந்நர்க் காவாதான் வாட்கை யெரிமுந்நர் வைத்தூறு போலக் கெடும்
தன்குத்தம் நீக்கிப் பிறர்குற்றங் காண்கிற்பின் நென்குற்ற மாகுமி றைக்கு
குற்றமெ கார்க்கப் பொருளாகக் குற்றமெ யற்ற தரூம் பகை
திநைத்துணையாங் குற்றம் வரிநும் பநைத்துணையாய்க் கொள்வார் பழிநாணு வார்
இவறலு மாண்பிறந்த மாநமு மாணா வுவகையுமே தமி றைக்கு</Unicode>
      </TextEquiv>
    </TextRegion>
