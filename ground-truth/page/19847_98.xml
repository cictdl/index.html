    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,84 2833,84 2833,488 0,488"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=951; numeral=௧">
        <Coords points="0,84 2833,84 2833,124 0,124"/>
        <Baseline points="0,117 2833,117"/>
        <TextEquiv>
          <Unicode>இற்பிறந்தார் கண்ணல்லதி ல்லை யியல்பாகச் செப்பமும் நாணு மொருங்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=956; numeral=௨">
        <Coords points="0,124 2833,124 2833,165 0,165"/>
        <Baseline points="0,158 2833,158"/>
        <TextEquiv>
          <Unicode>சலம்பற்றிச் சால்பல செய்யார் மாசற்ற குலம்பற்றி வாழ்து மென்பார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=954; numeral=௩">
        <Coords points="0,165 2833,165 2833,205 0,205"/>
        <Baseline points="0,198 2833,198"/>
        <TextEquiv>
          <Unicode>அடுக்கிய கோடி பெறினுங் குடிப்பிறந்தார் குன்றுவ செய்தலி லர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=955; numeral=௪">
        <Coords points="0,205 2833,205 2833,246 0,246"/>
        <Baseline points="0,238 2833,238"/>
        <TextEquiv>
          <Unicode>வளங்குவது ழ்வீழ்ந்தக் கண்ணும் பளங்குடிப் பண்பிற் றலைப்பிரிதலி ன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=952; numeral=௫">
        <Coords points="0,246 2833,246 2833,286 0,286"/>
        <Baseline points="0,279 2833,279"/>
        <TextEquiv>
          <Unicode>ஒழுக்கமும் நாண்மும் வாய்மையிம் மூன்று மிழுக்கார் குடிப்பிறந்தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=957; numeral=௬">
        <Coords points="0,286 2833,286 2833,327 0,327"/>
        <Baseline points="0,319 2833,319"/>
        <TextEquiv>
          <Unicode>குடிப்பிறந்தார் கண்விளங்குங் குற்ற விசும்பின் மதிக்கண் மருப்போலு யர்ந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=959; numeral=௭">
        <Coords points="0,327 2833,327 2833,367 0,367"/>
        <Baseline points="0,360 2833,360"/>
        <TextEquiv>
          <Unicode>நிலத்திற் பிறந்த்து கார்காட்டுங் காட்டுங் குலத்திற் பிறந்தாவாய்ச் சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=960; numeral=௮">
        <Coords points="0,367 2833,367 2833,407 0,407"/>
        <Baseline points="0,400 2833,400"/>
        <TextEquiv>
          <Unicode>நலம்வேண்டில் நாணுடமை வேண்டுங் குலம்வேண்டில் வேண்டுக யார்க்கும் பணிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=958; numeral=௯">
        <Coords points="0,407 2833,407 2833,448 0,448"/>
        <Baseline points="0,441 2833,441"/>
        <TextEquiv>
          <Unicode>நலத்தின்கண் ணாரின்மை தோன்றின வநைக் குலத்தின்கண் ணய்யப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=953; numeral=௰">
        <Coords points="0,448 2833,448 2833,488 0,488"/>
        <Baseline points="0,481 2833,481"/>
        <TextEquiv>
          <Unicode>நகைஈகை யின்சொல் லிகழாமை நான்கின் வகையென்பவாய்மைக குடிக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>இற்பிறந்தார் கண்ணல்லதி ல்லை யியல்பாகச் செப்பமும் நாணு மொருங்கு
சலம்பற்றிச் சால்பல செய்யார் மாசற்ற குலம்பற்றி வாழ்து மென்பார்
அடுக்கிய கோடி பெறினுங் குடிப்பிறந்தார் குன்றுவ செய்தலி லர்
வளங்குவது ழ்வீழ்ந்தக் கண்ணும் பளங்குடிப் பண்பிற் றலைப்பிரிதலி ன்று
ஒழுக்கமும் நாண்மும் வாய்மையிம் மூன்று மிழுக்கார் குடிப்பிறந்தார்
குடிப்பிறந்தார் கண்விளங்குங் குற்ற விசும்பின் மதிக்கண் மருப்போலு யர்ந்து
நிலத்திற் பிறந்த்து கார்காட்டுங் காட்டுங் குலத்திற் பிறந்தாவாய்ச் சொல்
நலம்வேண்டில் நாணுடமை வேண்டுங் குலம்வேண்டில் வேண்டுக யார்க்கும் பணிவு
நலத்தின்கண் ணாரின்மை தோன்றின வநைக் குலத்தின்கண் ணய்யப் படும்
நகைஈகை யின்சொல் லிகழாமை நான்கின் வகையென்பவாய்மைக குடிக்கு</Unicode>
      </TextEquiv>
    </TextRegion>
