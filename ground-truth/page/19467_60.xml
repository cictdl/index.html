    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,82 2717,82 2717,446 0,446"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=571; numeral=௧">
        <Coords points="0,82 2717,82 2717,118 0,118"/>
        <Baseline points="0,112 2717,112"/>
        <TextEquiv>
          <Unicode>கண்ணோட்டமெ ந்நுங் களிபெருங் காரிகை யுண்மையாலு ண்டிவ் வுலகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=572; numeral=௨">
        <Coords points="0,118 2717,118 2717,155 0,155"/>
        <Baseline points="0,148 2717,148"/>
        <TextEquiv>
          <Unicode>கண்ணோட்டத் துள்ளது லகியல ஃதிலாரு ண்மை நிலற்குப் பொறை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=576; numeral=௩">
        <Coords points="0,155 2717,155 2717,191 0,191"/>
        <Baseline points="0,185 2717,185"/>
        <TextEquiv>
          <Unicode>மண்ணோ டியைந்த மரத்தநையர் கண்ணோ டியைந்துகண் ணோடா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=575; numeral=௪">
        <Coords points="0,191 2717,191 2717,228 0,228"/>
        <Baseline points="0,221 2717,221"/>
        <TextEquiv>
          <Unicode>கண்ணுக்க ணிகலங் கண்ணோட்டம ஃதின்றேற் புண்ணென்று ணரப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=573; numeral=௫">
        <Coords points="0,228 2717,228 2717,264 0,264"/>
        <Baseline points="0,257 2717,257"/>
        <TextEquiv>
          <Unicode>பண்ணெந்நாம் பாடற்கி யைபின்றேற் கண்ணெந்நாங் கண்ணோட்டமி ல்லாத கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=574; numeral=௬">
        <Coords points="0,264 2717,264 2717,300 0,300"/>
        <Baseline points="0,294 2717,294"/>
        <TextEquiv>
          <Unicode>உளபோன் முகத்தெவன் செய்யும் அளவிநாற் கண்ணோட்டமி ல்லாத கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=577; numeral=௭">
        <Coords points="0,300 2717,300 2717,337 0,337"/>
        <Baseline points="0,330 2717,330"/>
        <TextEquiv>
          <Unicode>கண்ணோட் டமி ல்லவர் கண்ணிலர் கண்ணுடையா கண்ணோட்டமி ன்மையுமில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=578; numeral=௮">
        <Coords points="0,337 2717,337 2717,373 0,373"/>
        <Baseline points="0,367 2717,367"/>
        <TextEquiv>
          <Unicode>கருமஞ் சிதையாமற்க் கண்ணோட வல்லார்க்கு ரிமை யுடைத்திவ் வுலகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=580; numeral=௯">
        <Coords points="0,373 2717,373 2717,410 0,410"/>
        <Baseline points="0,403 2717,403"/>
        <TextEquiv>
          <Unicode>பெயக்கண்டு நஞ்சுண் டமைவர் நயத்தக்க நாகரிகம் வேண்டு பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=579; numeral=௰">
        <Coords points="0,410 2717,410 2717,446 0,446"/>
        <Baseline points="0,440 2717,440"/>
        <TextEquiv>
          <Unicode>ஒறுத்தாற்றும் பண்பிநார் கண்ணுங்கண் ணோடிப் பொறுத்தாற்றும் பண்பெ தலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>கண்ணோட்டமெ ந்நுங் களிபெருங் காரிகை யுண்மையாலு ண்டிவ் வுலகு
கண்ணோட்டத் துள்ளது லகியல ஃதிலாரு ண்மை நிலற்குப் பொறை
மண்ணோ டியைந்த மரத்தநையர் கண்ணோ டியைந்துகண் ணோடா தவர்
கண்ணுக்க ணிகலங் கண்ணோட்டம ஃதின்றேற் புண்ணென்று ணரப் படும்
பண்ணெந்நாம் பாடற்கி யைபின்றேற் கண்ணெந்நாங் கண்ணோட்டமி ல்லாத கண்
உளபோன் முகத்தெவன் செய்யும் அளவிநாற் கண்ணோட்டமி ல்லாத கண்
கண்ணோட் டமி ல்லவர் கண்ணிலர் கண்ணுடையா கண்ணோட்டமி ன்மையுமில்
கருமஞ் சிதையாமற்க் கண்ணோட வல்லார்க்கு ரிமை யுடைத்திவ் வுலகு
பெயக்கண்டு நஞ்சுண் டமைவர் நயத்தக்க நாகரிகம் வேண்டு பவர்
ஒறுத்தாற்றும் பண்பிநார் கண்ணுங்கண் ணோடிப் பொறுத்தாற்றும் பண்பெ தலை</Unicode>
      </TextEquiv>
