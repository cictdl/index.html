    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,70 2679,70 2679,435 0,435"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=727; numeral=௧">
        <Coords points="0,70 2679,70 2679,107 0,107"/>
        <Baseline points="0,100 2679,100"/>
        <TextEquiv>
          <Unicode>பகையகத்துப் பேடிகை யொள்வாள் அவையகத்து ளஞ்சு பவன்கற்ற நூல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=726; numeral=௨">
        <Coords points="0,107 2679,107 2679,143 0,143"/>
        <Baseline points="0,137 2679,137"/>
        <TextEquiv>
          <Unicode>வாளொடென் வன்கண்ணர ல்லார்க்கு நூலொடென் நுண்ணவை யஞ்சு பவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=728; numeral=௩">
        <Coords points="0,143 2679,143 2679,180 0,180"/>
        <Baseline points="0,173 2679,173"/>
        <TextEquiv>
          <Unicode>பல்லவை கற்றும் பயமிலரெ நல்லவையுண ண்கு செலச்சொல்லா தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=723; numeral=௪">
        <Coords points="0,180 2679,180 2679,216 0,216"/>
        <Baseline points="0,209 2679,209"/>
        <TextEquiv>
          <Unicode>பகையகத்துச் சாவாரெ ழியர ரியர வையகத்த ஞ்சா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=730; numeral=௫">
        <Coords points="0,216 2679,216 2679,252 0,252"/>
        <Baseline points="0,246 2679,246"/>
        <TextEquiv>
          <Unicode>உளரெநினுமி ல்லாரொடொ ப்பர் களநஞ்சிக் கற்ற செலச்சொலா தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=724; numeral=௬">
        <Coords points="0,252 2679,252 2679,289 0,289"/>
        <Baseline points="0,282 2679,282"/>
        <TextEquiv>
          <Unicode>கற்றாருட் கற்ற செலச்சொல்லித் தான்கற்ற மிக்காருண் மிக்க கொழல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=722; numeral=௭">
        <Coords points="0,289 2679,289 2679,325 0,325"/>
        <Baseline points="0,319 2679,319"/>
        <TextEquiv>
          <Unicode>கற்றாருட் கற்றாரெ நப்படுவர் கற்றார்முடற் கற்ற செலச்சொல்லு வார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=721; numeral=௮">
        <Coords points="0,325 2679,325 2679,362 0,362"/>
        <Baseline points="0,355 2679,355"/>
        <TextEquiv>
          <Unicode>வகையறிந்து வால்லவை வாய்சோரா சொல்லின் துகையறிந்த தூய்மை யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=725; numeral=௯">
        <Coords points="0,362 2679,362 2679,398 0,398"/>
        <Baseline points="0,392 2679,392"/>
        <TextEquiv>
          <Unicode>ஆற்றின ளவறிந்து கற்க வவையஞ்சா மாற்றங் கொடுத்தற் பொருட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=729; numeral=௰">
        <Coords points="0,398 2679,398 2679,435 0,435"/>
        <Baseline points="0,428 2679,428"/>
        <TextEquiv>
          <Unicode>கல்லா தவரிற் கடையென்ப கற்றறிந்து நல்லார வையஞ்சு வார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>பகையகத்துப் பேடிகை யொள்வாள் அவையகத்து ளஞ்சு பவன்கற்ற நூல்
வாளொடென் வன்கண்ணர ல்லார்க்கு நூலொடென் நுண்ணவை யஞ்சு பவர்க்கு
பல்லவை கற்றும் பயமிலரெ நல்லவையுண ண்கு செலச்சொல்லா தார்
பகையகத்துச் சாவாரெ ழியர ரியர வையகத்த ஞ்சா தவர்
உளரெநினுமி ல்லாரொடொ ப்பர் களநஞ்சிக் கற்ற செலச்சொலா தார்
கற்றாருட் கற்ற செலச்சொல்லித் தான்கற்ற மிக்காருண் மிக்க கொழல்
கற்றாருட் கற்றாரெ நப்படுவர் கற்றார்முடற் கற்ற செலச்சொல்லு வார்
வகையறிந்து வால்லவை வாய்சோரா சொல்லின் துகையறிந்த தூய்மை யவர்
ஆற்றின ளவறிந்து கற்க வவையஞ்சா மாற்றங் கொடுத்தற் பொருட்டு
கல்லா தவரிற் கடையென்ப கற்றறிந்து நல்லார வையஞ்சு வார்</Unicode>
      </TextEquiv>
