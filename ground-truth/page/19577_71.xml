    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,75 2739,75 2739,440 0,440"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=686; numeral=௧">
        <Coords points="0,75 2739,75 2739,112 0,112"/>
        <Baseline points="0,105 2739,105"/>
        <TextEquiv>
          <Unicode>கற்றுக்கண்ணஞ்சான் செலச்சொல்லிக் காலத்தாற்றக்க தறிவதாந்  தூது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=685; numeral=௨">
        <Coords points="0,112 2739,112 2739,148 0,148"/>
        <Baseline points="0,142 2739,142"/>
        <TextEquiv>
          <Unicode>தொகச் சொல்லித் தூவாத நீக்கி நகச்சொல்லி நன்றி பயப்பதாந் தூது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=687; numeral=௩">
        <Coords points="0,148 2739,148 2739,185 0,185"/>
        <Baseline points="0,178 2739,178"/>
        <TextEquiv>
          <Unicode>கடனறிந்து காலங் கருதி யிடனறிந்தெண்ணி யரைப்பான் றலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=683; numeral=௪">
        <Coords points="0,185 2739,185 2739,221 0,221"/>
        <Baseline points="0,215 2739,215"/>
        <TextEquiv>
          <Unicode>நூலாரமுன் நூல்வல்லார் குதல் வேலாரமுன் வென்றி விநையுரைப்பான் பண்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=688; numeral=௫">
        <Coords points="0,221 2739,221 2739,258 0,258"/>
        <Baseline points="0,251 2739,251"/>
        <TextEquiv>
          <Unicode>தூய்மை துணைமை துணிவுடமை யிம்மூன்றும்  வாய்மை வழியுரைப்பான் பண்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=681; numeral=௬">
        <Coords points="0,258 2739,258 2739,294 0,294"/>
        <Baseline points="0,288 2739,288"/>
        <TextEquiv>
          <Unicode>அன்புடைமை யான்ற குடிப்பிறத்தல் வேந்தவாம் பண்புடைமை தூதுரைப்பான் பண்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=684; numeral=௭">
        <Coords points="0,294 2739,294 2739,331 0,331"/>
        <Baseline points="0,324 2739,324"/>
        <TextEquiv>
          <Unicode>அறிவுரு வாராய்ந்த கல்விஇம் மூன்றஞ் செறிவுடையான் செல்க விநைக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=689; numeral=௮">
        <Coords points="0,331 2739,331 2739,367 0,367"/>
        <Baseline points="0,361 2739,361"/>
        <TextEquiv>
          <Unicode>விடுமாற்றம் வேந்தர்க்கு ரைப்பான் வடுமாற்றம் வாய்சோரா வன்க ணவன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=682; numeral=௯">
        <Coords points="0,367 2739,367 2739,404 0,404"/>
        <Baseline points="0,397 2739,397"/>
        <TextEquiv>
          <Unicode>அன்பறிவா ராய்ந்த சொல்வண்மை தூதுரைப்பார்க் கின்றியமையாத மூன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=690; numeral=௰">
        <Coords points="0,404 2739,404 2739,440 0,440"/>
        <Baseline points="0,434 2739,434"/>
        <TextEquiv>
          <Unicode>இறுதி பயப்பிநுமெ ஞ்சாதி றைவாக் குறுதி பயப்பதா ந் தூது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>கற்றுக்கண்ணஞ்சான் செலச்சொல்லிக் காலத்தாற்றக்க தறிவதாந்  தூது
தொகச் சொல்லித் தூவாத நீக்கி நகச்சொல்லி நன்றி பயப்பதாந் தூது
கடனறிந்து காலங் கருதி யிடனறிந்தெண்ணி யரைப்பான் றலை
நூலாரமுன் நூல்வல்லார் குதல் வேலாரமுன் வென்றி விநையுரைப்பான் பண்பு
தூய்மை துணைமை துணிவுடமை யிம்மூன்றும்  வாய்மை வழியுரைப்பான் பண்பு
அன்புடைமை யான்ற குடிப்பிறத்தல் வேந்தவாம் பண்புடைமை தூதுரைப்பான் பண்பு
அறிவுரு வாராய்ந்த கல்விஇம் மூன்றஞ் செறிவுடையான் செல்க விநைக்கு
விடுமாற்றம் வேந்தர்க்கு ரைப்பான் வடுமாற்றம் வாய்சோரா வன்க ணவன்
அன்பறிவா ராய்ந்த சொல்வண்மை தூதுரைப்பார்க் கின்றியமையாத மூன்று
இறுதி பயப்பிநுமெ ஞ்சாதி றைவாக் குறுதி பயப்பதா ந் தூது</Unicode>
      </TextEquiv>
    </TextRegion>
