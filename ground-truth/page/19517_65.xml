      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=630; numeral=௧">
        <Coords points="0,103 2651,103 2651,139 0,139"/>
        <Baseline points="0,133 2651,133"/>
        <TextEquiv>
          <Unicode>இந்நாமை யென்பமெ னக்கொளினா குந்தநொ ந்நார் விளையுஞ் சிறப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=622; numeral=௨">
        <Coords points="0,139 2651,139 2651,176 0,176"/>
        <Baseline points="0,169 2651,169"/>
        <TextEquiv>
          <Unicode>வெள்ளத் தநைய விடும்பை யறிவுடையாரு ள்ளத்தினு ள்ளக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=624; numeral=௩">
        <Coords points="0,176 2651,176 2651,212 0,212"/>
        <Baseline points="0,206 2651,206"/>
        <TextEquiv>
          <Unicode>மடுத்தவா யெல்லாம் பகடற்றா லுற்ற விடுக்கண் ணிடுக்கட படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=626; numeral=௪">
        <Coords points="0,212 2651,212 2651,249 0,249"/>
        <Baseline points="0,242 2651,242"/>
        <TextEquiv>
          <Unicode>அற்றோமென்ற ல்லற் படுபவோ பெற்றோமென்றோ ம்புத றேற்றா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=625; numeral=௫">
        <Coords points="0,249 2651,249 2651,285 0,285"/>
        <Baseline points="0,279 2651,279"/>
        <TextEquiv>
          <Unicode>அடுக்கி வரினும ழிவிலானு ற்ற விடுக்கண் ணிடுக்கட் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=623; numeral=௬">
        <Coords points="0,285 2651,285 2651,322 0,322"/>
        <Baseline points="0,315 2651,315"/>
        <TextEquiv>
          <Unicode>இடும்பைக்கி டும்பை படுப்பர் யிடும்பைக்கி டும்பை படா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=629; numeral=௭">
        <Coords points="0,322 2651,322 2651,358 0,358"/>
        <Baseline points="0,352 2651,352"/>
        <TextEquiv>
          <Unicode>இன்பத்துள் ளின்பம் விழையாதான் றுன்பத்துட் டுன்பமு றுதல் லிலன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=627; numeral=௮">
        <Coords points="0,358 2651,358 2651,395 0,395"/>
        <Baseline points="0,388 2651,388"/>
        <TextEquiv>
          <Unicode>இலக்கமு டம்பிடும்பைக் கென்றுங் கலக்கத்தைக் கையாறாக் கொள்ளாதார் மேல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=628; numeral=௯">
        <Coords points="0,395 2651,395 2651,431 0,431"/>
        <Baseline points="0,425 2651,425"/>
        <TextEquiv>
          <Unicode>இன்பம் விழையான் னிடும்பை யியல்பென்பான் றுன்பமு தைலி லன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=621; numeral=௰">
