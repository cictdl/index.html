    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,89 2831,89 2831,464 0,464"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=398; numeral=௧">
        <Coords points="0,89 2831,89 2831,126 0,126"/>
        <Baseline points="0,119 2831,119"/>
        <TextEquiv>
          <Unicode>ஒருமைக் கட்டான் கற்ற கல்வி ஒருவர்க் கெழுமையு மேமாப் புடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=397; numeral=௨">
        <Coords points="0,126 2831,126 2831,164 0,164"/>
        <Baseline points="0,157 2831,157"/>
        <TextEquiv>
          <Unicode>யாதாநும் நாடாமாலூ ராமாலெ ந்நொருவன் சாந்தநையுங் கல்லாத வாறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=400; numeral=௩">
        <Coords points="0,164 2831,164 2831,201 0,201"/>
        <Baseline points="0,194 2831,194"/>
        <TextEquiv>
          <Unicode>கேடில் விழுச்செல்வம் கல்வி யொருவர்க்கு மாடல்ல மற்றை யவை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=393; numeral=௪">
        <Coords points="0,201 2831,201 2831,239 0,239"/>
        <Baseline points="0,232 2831,232"/>
        <TextEquiv>
          <Unicode>கண்ணுடையர் யாவரெ கற்றோர் முகத்திரண்டு புண்ணுடையார் கல்லா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=392; numeral=௫">
        <Coords points="0,239 2831,239 2831,276 0,276"/>
        <Baseline points="0,269 2831,269"/>
        <TextEquiv>
          <Unicode>எண்ணென்ப யேநை யெழுத்தென்ப விவ்விரண் டுங் கண்ணென்ப வாளுமு யிர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=396; numeral=௬">
        <Coords points="0,276 2831,276 2831,314 0,314"/>
        <Baseline points="0,307 2831,307"/>
        <TextEquiv>
          <Unicode>தொட்டநைத் தூறும் மணல்க்கேணி மாந்தர்க்குக் கற்றநைத் தூறும் றிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=399; numeral=௭">
        <Coords points="0,314 2831,314 2831,351 0,351"/>
        <Baseline points="0,344 2831,344"/>
        <TextEquiv>
          <Unicode>தாமின் புறுவது லகின் புறக் கண்டு காமுறுவர் கற்றறிந் தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=394; numeral=௮">
        <Coords points="0,351 2831,351 2831,389 0,389"/>
        <Baseline points="0,382 2831,382"/>
        <TextEquiv>
          <Unicode>உவப்பத் தலைக்கூடி யுள்ளப் பிரிதல் லநைத்தே புலவர் தொழில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=395; numeral=௯">
        <Coords points="0,389 2831,389 2831,426 0,426"/>
        <Baseline points="0,420 2831,420"/>
        <TextEquiv>
          <Unicode>உடையார்முந் நில்லார்போல் லெக்கற்றுங் கற்றார் கடையரே கல்லா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=391; numeral=௰">
        <Coords points="0,426 2831,426 2831,464 0,464"/>
        <Baseline points="0,457 2831,457"/>
        <TextEquiv>
          <Unicode>கற்கக் கசடறக் கற்பவை கற்றபின் நிற்க வதர்க்குத் தக</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>ஒருமைக் கட்டான் கற்ற கல்வி ஒருவர்க் கெழுமையு மேமாப் புடைத்து
யாதாநும் நாடாமாலூ ராமாலெ ந்நொருவன் சாந்தநையுங் கல்லாத வாறு
கேடில் விழுச்செல்வம் கல்வி யொருவர்க்கு மாடல்ல மற்றை யவை
கண்ணுடையர் யாவரெ கற்றோர் முகத்திரண்டு புண்ணுடையார் கல்லா தவர்
எண்ணென்ப யேநை யெழுத்தென்ப விவ்விரண் டுங் கண்ணென்ப வாளுமு யிர்க்கு
தொட்டநைத் தூறும் மணல்க்கேணி மாந்தர்க்குக் கற்றநைத் தூறும் றிவு
தாமின் புறுவது லகின் புறக் கண்டு காமுறுவர் கற்றறிந் தார்
உவப்பத் தலைக்கூடி யுள்ளப் பிரிதல் லநைத்தே புலவர் தொழில்
உடையார்முந் நில்லார்போல் லெக்கற்றுங் கற்றார் கடையரே கல்லா தவர்
கற்கக் கசடறக் கற்பவை கற்றபின் நிற்க வதர்க்குத் தக</Unicode>
      </TextEquiv>
