    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,142 2907,142 2907,519 0,519"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=121; numeral=௧">
        <Coords points="0,142 2907,142 2907,179 0,179"/>
        <Baseline points="0,172 2907,172"/>
        <TextEquiv>
          <Unicode>அடக்க மமரரு ள்ளுய்க்கும் அடங்காமை யாரிரு ளுய்த்து விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=122; numeral=௨">
        <Coords points="0,179 2907,179 2907,217 0,217"/>
        <Baseline points="0,210 2907,210"/>
        <TextEquiv>
          <Unicode>காக்கப் பொருளா வடக்கத்தை யாக்க மதனிநூங் கில்லை யுயிர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=123; numeral=௩">
        <Coords points="0,217 2907,217 2907,255 0,255"/>
        <Baseline points="0,248 2907,248"/>
        <TextEquiv>
          <Unicode>செறிவறிந்து சீர்மை பயக்கும் அறிவறிந் தாற்றி னடங்கப் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=124; numeral=௪">
        <Coords points="0,255 2907,255 2907,293 0,293"/>
        <Baseline points="0,286 2907,286"/>
        <TextEquiv>
          <Unicode>நிலையிற் றிரியா தடங்கியான் றோற்ற மலையிநு  மாணப் பெரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=125; numeral=௫">
        <Coords points="0,293 2907,293 2907,330 0,330"/>
        <Baseline points="0,323 2907,323"/>
        <TextEquiv>
          <Unicode>எல்லார்க்கும் நன்றாம் பணிதல் லவருள்ளுஞ் செல்வர்க்கே செல்வந் தகைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=126; numeral=௬">
        <Coords points="0,330 2907,330 2907,368 0,368"/>
        <Baseline points="0,361 2907,361"/>
        <TextEquiv>
          <Unicode>ஒருமையு ளாமைபோ லைந்தடக்க லாற்றின் எழுமையு மேமாப் புடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=127; numeral=௭">
        <Coords points="0,368 2907,368 2907,406 0,406"/>
        <Baseline points="0,399 2907,399"/>
        <TextEquiv>
          <Unicode>யாகாவா ராயிநும் நாகாக்கக் காவாக்காற் சோகாப்பர் சொல்லிழுக்கப் பட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=128; numeral=௮">
        <Coords points="0,406 2907,406 2907,443 0,443"/>
        <Baseline points="0,437 2907,437"/>
        <TextEquiv>
          <Unicode>ஒன்றாநுந் தீய்ச்சொற் பொருட்பய நுண்டாயி ன்னறாகா தாகி விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=129; numeral=௯">
        <Coords points="0,443 2907,443 2907,481 0,481"/>
        <Baseline points="0,474 2907,474"/>
        <TextEquiv>
          <Unicode>தீயிநாற் சுட்டபுண் ணுள்ளாறு மாறாதே நாவிநாற் சுட்ட வடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=130; numeral=௰">
        <Coords points="0,481 2907,481 2907,519 0,519"/>
        <Baseline points="0,512 2907,512"/>
        <TextEquiv>
          <Unicode>கதங்காத்துக் கற்றடங்க லாற்றுவான் செவ்வி யறம் பார்க்கு மாற்றி நுளைந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அடக்க மமரரு ள்ளுய்க்கும் அடங்காமை யாரிரு ளுய்த்து விடும்
காக்கப் பொருளா வடக்கத்தை யாக்க மதனிநூங் கில்லை யுயிர்க்கு
செறிவறிந்து சீர்மை பயக்கும் அறிவறிந் தாற்றி னடங்கப் பெறின்
நிலையிற் றிரியா தடங்கியான் றோற்ற மலையிநு  மாணப் பெரிது
எல்லார்க்கும் நன்றாம் பணிதல் லவருள்ளுஞ் செல்வர்க்கே செல்வந் தகைத்து
ஒருமையு ளாமைபோ லைந்தடக்க லாற்றின் எழுமையு மேமாப் புடைத்து
யாகாவா ராயிநும் நாகாக்கக் காவாக்காற் சோகாப்பர் சொல்லிழுக்கப் பட்டு
ஒன்றாநுந் தீய்ச்சொற் பொருட்பய நுண்டாயி ன்னறாகா தாகி விடும்
தீயிநாற் சுட்டபுண் ணுள்ளாறு மாறாதே நாவிநாற் சுட்ட வடு
கதங்காத்துக் கற்றடங்க லாற்றுவான் செவ்வி யறம் பார்க்கு மாற்றி நுளைந்து</Unicode>
      </TextEquiv>
