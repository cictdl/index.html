    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,82 2839,82 2839,469 0,469"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=483; numeral=௧">
        <Coords points="0,82 2839,82 2839,121 0,121"/>
        <Baseline points="0,114 2839,114"/>
        <TextEquiv>
          <Unicode>அருவிநை யென்பது ளவோ கருவியாற் காலம றிந்து செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=484; numeral=௨">
        <Coords points="0,121 2839,121 2839,159 0,159"/>
        <Baseline points="0,152 2839,152"/>
        <TextEquiv>
          <Unicode>ஞாலங் கருதிநுங் கைகூடும் காலங் கருதி யிடத்தாற் செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=481; numeral=௩">
        <Coords points="0,159 2839,159 2839,198 0,198"/>
        <Baseline points="0,191 2839,191"/>
        <TextEquiv>
          <Unicode>பகல்வெல்லுங் கூகையைக் காக்கை யிகல்வெல்லும் வேந்தர்க்கு வேண்டும் பொழுது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=489; numeral=௪">
        <Coords points="0,198 2839,198 2839,237 0,237"/>
        <Baseline points="0,230 2839,230"/>
        <TextEquiv>
          <Unicode>எய்தற் கரியதி யைந்தக்கால் நநிலையெ செய்தற் கரிய செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=487; numeral=௫">
        <Coords points="0,237 2839,237 2839,275 0,275"/>
        <Baseline points="0,269 2839,269"/>
        <TextEquiv>
          <Unicode>புள்ளெந் வாங்கெ புறம்போகாக் காலம்பார்த்து ள்வேர்ப்பரொ ள்ளி யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=486; numeral=௬">
        <Coords points="0,275 2839,275 2839,314 0,314"/>
        <Baseline points="0,307 2839,307"/>
        <TextEquiv>
          <Unicode>ஊக்க முடையான் னொ டுக்கம் பொருதகர் தாக்கற்குப் பேருந் தகைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=488; numeral=௭">
        <Coords points="0,314 2839,314 2839,353 0,353"/>
        <Baseline points="0,346 2839,346"/>
        <TextEquiv>
          <Unicode>செறுநரைக் காணிற் சுமக்க வெருவரைக் காணிற் கிழக்காந் தலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=490; numeral=௮">
        <Coords points="0,353 2839,353 2839,392 0,392"/>
        <Baseline points="0,385 2839,385"/>
        <TextEquiv>
          <Unicode>கொக்கொக்க கூம்பும் பருவத்து மற்றதன குத்தொக்கச் சீர்த்த விடத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=482; numeral=௯">
        <Coords points="0,392 2839,392 2839,430 0,430"/>
        <Baseline points="0,424 2839,424"/>
        <TextEquiv>
          <Unicode>பருவத்தோட டொட்ட வொழுகல் திருவிநைத் தீராமை யார்க்குங் கயறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=485; numeral=௰">
        <Coords points="0,430 2839,430 2839,469 0,469"/>
        <Baseline points="0,462 2839,462"/>
        <TextEquiv>
          <Unicode>காலங் கருதி யிருப்பர் கலங்காது ஞாலங் கருது பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அருவிநை யென்பது ளவோ கருவியாற் காலம றிந்து செயல்
ஞாலங் கருதிநுங் கைகூடும் காலங் கருதி யிடத்தாற் செயின்
பகல்வெல்லுங் கூகையைக் காக்கை யிகல்வெல்லும் வேந்தர்க்கு வேண்டும் பொழுது
எய்தற் கரியதி யைந்தக்கால் நநிலையெ செய்தற் கரிய செயல்
புள்ளெந் வாங்கெ புறம்போகாக் காலம்பார்த்து ள்வேர்ப்பரொ ள்ளி யவர்
ஊக்க முடையான் னொ டுக்கம் பொருதகர் தாக்கற்குப் பேருந் தகைத்து
செறுநரைக் காணிற் சுமக்க வெருவரைக் காணிற் கிழக்காந் தலை
கொக்கொக்க கூம்பும் பருவத்து மற்றதன குத்தொக்கச் சீர்த்த விடத்து
பருவத்தோட டொட்ட வொழுகல் திருவிநைத் தீராமை யார்க்குங் கயறு
காலங் கருதி யிருப்பர் கலங்காது ஞாலங் கருது பவர்</Unicode>
      </TextEquiv>
