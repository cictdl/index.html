    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,76 2759,76 2759,446 0,446"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=711; numeral=௧">
        <Coords points="0,76 2759,76 2759,113 0,113"/>
        <Baseline points="0,106 2759,106"/>
        <TextEquiv>
          <Unicode>அவையறிந்தா ராய்ந்து சொல்லுக சொல்லின் றொகையறிந்த தூய்மை யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=713; numeral=௨">
        <Coords points="0,113 2759,113 2759,150 0,150"/>
        <Baseline points="0,143 2759,143"/>
        <TextEquiv>
          <Unicode>அவையறியார் சொல்லைமேற் கொள்பவர் சொல்லை வகையறியார் வல்லதூஉமில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=716; numeral=௩">
        <Coords points="0,150 2759,150 2759,187 0,187"/>
        <Baseline points="0,180 2759,180"/>
        <TextEquiv>
          <Unicode>ஆற்றி நிலைதளர்ந் தற்றே வியன்புலமெ ற்றுணர்வார் முந்நரி ளுக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=715; numeral=௪">
        <Coords points="0,187 2759,187 2759,224 0,224"/>
        <Baseline points="0,217 2759,217"/>
        <TextEquiv>
          <Unicode>நன்றென்ற வற்றுள்ளும் நன்றே முதுவருண் முந்து கிளவாச் செறிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=712; numeral=௫">
        <Coords points="0,224 2759,224 2759,261 0,261"/>
        <Baseline points="0,254 2759,254"/>
        <TextEquiv>
          <Unicode>இடைதெரிந்து நன்குணர்ந்து சொல்லுக சொல்லின் நடைதெரிந்த நன்மை யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=717; numeral=௬">
        <Coords points="0,261 2759,261 2759,298 0,298"/>
        <Baseline points="0,291 2759,291"/>
        <TextEquiv>
          <Unicode>கற்றறிந்தார் கல்வி விளங்குங் கசடறச் சொற்றெரிய வல்லார் கத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=718; numeral=௭">
        <Coords points="0,298 2759,298 2759,335 0,335"/>
        <Baseline points="0,328 2759,328"/>
        <TextEquiv>
          <Unicode>உணர்வது டையார்முற் சொல்லல் வழர்வதன் பாத்தியுண் ணீர்சொரிந் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=719; numeral=௮">
        <Coords points="0,335 2759,335 2759,372 0,372"/>
        <Baseline points="0,365 2759,365"/>
        <TextEquiv>
          <Unicode>புல்லவையுட் பொய்ச்சாந்துஞ் சொல்லற்க நல்லவையுண் ணந்கு செலச்சொல்லா தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=720; numeral=௯">
        <Coords points="0,372 2759,372 2759,409 0,409"/>
        <Baseline points="0,402 2759,402"/>
        <TextEquiv>
          <Unicode>அங்கணத்துட் பெய்க வமுதற்றாற் றங்கணத்தர் ரல்லார்முற் கோட்டி கொளல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=714; numeral=௰">
        <Coords points="0,409 2759,409 2759,446 0,446"/>
        <Baseline points="0,439 2759,439"/>
        <TextEquiv>
          <Unicode>ஒளியார்முந் நொள்ளியரா தல் வெளியார்முன் வான்சுதை வண்ணங் கொளல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அவையறிந்தா ராய்ந்து சொல்லுக சொல்லின் றொகையறிந்த தூய்மை யவர்
அவையறியார் சொல்லைமேற் கொள்பவர் சொல்லை வகையறியார் வல்லதூஉமில்
ஆற்றி நிலைதளர்ந் தற்றே வியன்புலமெ ற்றுணர்வார் முந்நரி ளுக்கு
நன்றென்ற வற்றுள்ளும் நன்றே முதுவருண் முந்து கிளவாச் செறிவு
இடைதெரிந்து நன்குணர்ந்து சொல்லுக சொல்லின் நடைதெரிந்த நன்மை யவர்
கற்றறிந்தார் கல்வி விளங்குங் கசடறச் சொற்றெரிய வல்லார் கத்து
உணர்வது டையார்முற் சொல்லல் வழர்வதன் பாத்தியுண் ணீர்சொரிந் தற்று
புல்லவையுட் பொய்ச்சாந்துஞ் சொல்லற்க நல்லவையுண் ணந்கு செலச்சொல்லா தார்
அங்கணத்துட் பெய்க வமுதற்றாற் றங்கணத்தர் ரல்லார்முற் கோட்டி கொளல்
ஒளியார்முந் நொள்ளியரா தல் வெளியார்முன் வான்சுதை வண்ணங் கொளல்</Unicode>
      </TextEquiv>
