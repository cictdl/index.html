        <Baseline points="0,211 2724,211"/>
        <TextEquiv>
          <Unicode>நநவிநாற்  கண்டதூஉ மாங்கெ கநவுந்தான் கண்ட பொழுதெயநிது</Unicode>
        </TextEquiv>
