        <Coords points="0,151 2724,151 2724,184 0,184"/>
        <Baseline points="0,178 2724,178"/>
        <TextEquiv>
          <Unicode>கநவிநா லுண்டாகுங் காமம் நநவிநா நல்காரை நாடித் தறர்க்கு</Unicode>
