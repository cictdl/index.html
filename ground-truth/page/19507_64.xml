    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,77 2694,77 2694,447 0,447"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=611; numeral=௧">
        <Coords points="0,77 2694,77 2694,114 0,114"/>
        <Baseline points="0,108 2694,108"/>
        <TextEquiv>
          <Unicode>அருமை யுடைத்தென்ற் றசாவாமை வேண்டும் பெருமை முயற்சி தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=613; numeral=௨">
        <Coords points="0,114 2694,114 2694,151 0,151"/>
        <Baseline points="0,145 2694,145"/>
        <TextEquiv>
          <Unicode>தாளாண்மை யெந்நுந் தகைமைக்கட் டங்கிற்றே வேளாண்மை யெந்நுஞ் செருக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=615; numeral=௩">
        <Coords points="0,151 2694,151 2694,188 0,188"/>
        <Baseline points="0,182 2694,182"/>
        <TextEquiv>
          <Unicode>இன்பம் விளையான் விநைவிளைவான் றன்கேழீர் துன்பந் துடைத்தூன்றுந் தூண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=616; numeral=௪">
        <Coords points="0,188 2694,188 2694,225 0,225"/>
        <Baseline points="0,218 2694,218"/>
        <TextEquiv>
          <Unicode>முயற்சி திருவிநை யாக்கும் முயற்சின்மை யின்மை புகுத்தி விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=614; numeral=௫">
        <Coords points="0,225 2694,225 2694,262 0,262"/>
        <Baseline points="0,255 2694,255"/>
        <TextEquiv>
          <Unicode>தாளாண்மை யில்லாதான் வேளாண்மை பேடிகை வாளாண்மை போலக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=612; numeral=௬">
        <Coords points="0,262 2694,262 2694,299 0,299"/>
        <Baseline points="0,292 2694,292"/>
        <TextEquiv>
          <Unicode>விநைக்கண் விநைக்கெடலோ ம்பல் விநைக்குறை தீர்ந்தாரிற் றீர்ந்தான்று லகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=618; numeral=௭">
        <Coords points="0,299 2694,299 2694,336 0,336"/>
        <Baseline points="0,329 2694,329"/>
        <TextEquiv>
          <Unicode>பொறியின்மை யார்க்கும் பழியன்ற் றிவறிந்தா ள்விநை யின்மை பழி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=617; numeral=௮">
        <Coords points="0,336 2694,336 2694,373 0,373"/>
        <Baseline points="0,366 2694,366"/>
        <TextEquiv>
          <Unicode>மடியுளாள் மாமுகடி யென்ப மடியிலான் றாளுளா டாமரையி நாள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=619; numeral=௯">
        <Coords points="0,373 2694,373 2694,410 0,410"/>
        <Baseline points="0,403 2694,403"/>
        <TextEquiv>
          <Unicode>தெய்வத்தா லாவ தெநிநு முயற்சிதன் மெய்வருந்த்தக் கூலி தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=620; numeral=௰">
        <Coords points="0,410 2694,410 2694,447 0,447"/>
        <Baseline points="0,440 2694,440"/>
        <TextEquiv>
          <Unicode>ஊழையுமு ப்பக்கங் காண்பரு லைவின்றித் தாளாது ஞற்று பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அருமை யுடைத்தென்ற் றசாவாமை வேண்டும் பெருமை முயற்சி தரும்
தாளாண்மை யெந்நுந் தகைமைக்கட் டங்கிற்றே வேளாண்மை யெந்நுஞ் செருக்கு
இன்பம் விளையான் விநைவிளைவான் றன்கேழீர் துன்பந் துடைத்தூன்றுந் தூண்
முயற்சி திருவிநை யாக்கும் முயற்சின்மை யின்மை புகுத்தி விடும்
தாளாண்மை யில்லாதான் வேளாண்மை பேடிகை வாளாண்மை போலக் கெடும்
விநைக்கண் விநைக்கெடலோ ம்பல் விநைக்குறை தீர்ந்தாரிற் றீர்ந்தான்று லகு
பொறியின்மை யார்க்கும் பழியன்ற் றிவறிந்தா ள்விநை யின்மை பழி
மடியுளாள் மாமுகடி யென்ப மடியிலான் றாளுளா டாமரையி நாள்
தெய்வத்தா லாவ தெநிநு முயற்சிதன் மெய்வருந்த்தக் கூலி தரும்
ஊழையுமு ப்பக்கங் காண்பரு லைவின்றித் தாளாது ஞற்று பவர்</Unicode>
      </TextEquiv>
    </TextRegion>
