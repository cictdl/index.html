    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,79 2647,79 2647,442 0,442"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=675; numeral=௧">
        <Coords points="0,79 2647,79 2647,115 0,115"/>
        <Baseline points="0,109 2647,109"/>
        <TextEquiv>
          <Unicode>பொருள்கருவி காலம் விநையிடநோடைந்தும் மருடீர வெண்ணிச் செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=671; numeral=௨">
        <Coords points="0,115 2647,115 2647,152 0,152"/>
        <Baseline points="0,145 2647,145"/>
        <TextEquiv>
          <Unicode>சூக்ஷி முடிவு துணி வெய்தலத்துணிவு தாட்சியிற்றங்கு தறீது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=677; numeral=௩">
        <Coords points="0,152 2647,152 2647,188 0,188"/>
        <Baseline points="0,181 2647,181"/>
        <TextEquiv>
          <Unicode>செய்விநை செய்வான் செயன்முறை யவ்விநை யுள்ளறிவாநுள்ளங் கொளல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=678; numeral=௪">
        <Coords points="0,188 2647,188 2647,224 0,224"/>
        <Baseline points="0,218 2647,218"/>
        <TextEquiv>
          <Unicode>விநையான் விநையாக்கிக் கோடநநைகவள் யாநை யான்னாநையா தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=672; numeral=௫">
        <Coords points="0,224 2647,224 2647,260 0,260"/>
        <Baseline points="0,254 2647,254"/>
        <TextEquiv>
          <Unicode>தூங்குக தூங்கிச் செயற்பால தூங்கற்கத் தூங்காது செய்யும் விநை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=673; numeral=௬">
        <Coords points="0,260 2647,260 2647,297 0,297"/>
        <Baseline points="0,290 2647,290"/>
        <TextEquiv>
          <Unicode>ஒல்லும் வாயெல்லாம் விநைநன்றெ யல்லாக்காற் செல்லும்வாய் நோக்கிச் செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=674; numeral=௭">
        <Coords points="0,297 2647,297 2647,333 0,333"/>
        <Baseline points="0,326 2647,326"/>
        <TextEquiv>
          <Unicode>விநைப்பகை யென்றிரண்டினெச்சம் நிநையுங்காற்றீ யெச்சம் பொலத் தெறும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=679; numeral=௮">
        <Coords points="0,333 2647,333 2647,369 0,369"/>
        <Baseline points="0,363 2647,363"/>
        <TextEquiv>
          <Unicode>நட்டார்க்கு நல்ல செயலில் விரைந்ததெ ஒட்டாரை யொட்டிக் கொளல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=680; numeral=௯">
        <Coords points="0,369 2647,369 2647,406 0,406"/>
        <Baseline points="0,399 2647,399"/>
        <TextEquiv>
          <Unicode>உறைசிறியருண்ணடுங்கல ஞ்சிக் குறைபெரின் கொள்வர் பெரியார் பணிந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=676; numeral=௰">
        <Coords points="0,406 2647,406 2647,442 0,442"/>
        <Baseline points="0,435 2647,435"/>
        <TextEquiv>
          <Unicode>முடிவுமி டையூறு முற்றியாங்கெய்தும் படுபயநும் பார்த்துச் செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>பொருள்கருவி காலம் விநையிடநோடைந்தும் மருடீர வெண்ணிச் செயல்
சூக்ஷி முடிவு துணி வெய்தலத்துணிவு தாட்சியிற்றங்கு தறீது
செய்விநை செய்வான் செயன்முறை யவ்விநை யுள்ளறிவாநுள்ளங் கொளல்
விநையான் விநையாக்கிக் கோடநநைகவள் யாநை யான்னாநையா தற்று
தூங்குக தூங்கிச் செயற்பால தூங்கற்கத் தூங்காது செய்யும் விநை
ஒல்லும் வாயெல்லாம் விநைநன்றெ யல்லாக்காற் செல்லும்வாய் நோக்கிச் செயல்
விநைப்பகை யென்றிரண்டினெச்சம் நிநையுங்காற்றீ யெச்சம் பொலத் தெறும்
நட்டார்க்கு நல்ல செயலில் விரைந்ததெ ஒட்டாரை யொட்டிக் கொளல்
உறைசிறியருண்ணடுங்கல ஞ்சிக் குறைபெரின் கொள்வர் பெரியார் பணிந்து
முடிவுமி டையூறு முற்றியாங்கெய்தும் படுபயநும் பார்த்துச் செயல்</Unicode>
      </TextEquiv>
