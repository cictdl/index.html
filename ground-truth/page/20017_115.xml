    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,124 2780,124 2780,410 0,410"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1122; numeral=௧">
        <Coords points="0,124 2780,124 2780,156 0,156"/>
        <Baseline points="0,150 2780,150"/>
        <TextEquiv>
          <Unicode>உடம்போடு யிருடை யெந்நை மற்றந்ந மடந்தையோடெ ம்முடை நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1125; numeral=௨">
        <Coords points="0,156 2780,156 2780,188 0,188"/>
        <Baseline points="0,182 2780,182"/>
        <TextEquiv>
          <Unicode>உள்ளுவன் மந்நியான் மறப்பின் மறப்பறியெநொள்ளமர் கண்ணாழ் குணம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1124; numeral=௩">
        <Coords points="0,188 2780,188 2780,220 0,220"/>
        <Baseline points="0,214 2780,214"/>
        <TextEquiv>
          <Unicode>வாழ்தலு யிர்க்கண்ணாளா யிழை சாதல தற்கன்ன நீங்குமி டத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1123; numeral=௪">
        <Coords points="0,220 2780,220 2780,251 0,251"/>
        <Baseline points="0,246 2780,246"/>
        <TextEquiv>
          <Unicode>கருமணியுட பாவாய்நீ போதாயாம் வீழுந் திருநுதற்கில்லை யிடம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1121; numeral=௫">
        <Coords points="0,251 2780,251 2780,283 0,283"/>
        <Baseline points="0,277 2780,277"/>
        <TextEquiv>
          <Unicode>பாலொடு தேன்கலந் தற்றெ பநிமொழி வாலெயிறூ றிய நீர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1128; numeral=௬">
        <Coords points="0,283 2780,283 2780,315 0,315"/>
        <Baseline points="0,309 2780,309"/>
        <TextEquiv>
          <Unicode>நெஞ்சத்தார் காத லவராக வெய்துண்டல் அஞ்சுதும் வேபாக் கறிந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1129; numeral=௭">
        <Coords points="0,315 2780,315 2780,346 0,346"/>
        <Baseline points="0,341 2780,341"/>
        <TextEquiv>
          <Unicode>இமைப்பிற் கரப்பாக றிவல நைத்தற்கெ ஏதிலரெ ந்நுமி வ் வூர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1130; numeral=௮">
        <Coords points="0,346 2780,346 2780,378 0,378"/>
        <Baseline points="0,372 2780,372"/>
        <TextEquiv>
          <Unicode>உவந்துறைவருள்ளத்து ரென்றும் மிகந்துறைவரேதில ரெநநு மிவ்வூர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1126; numeral=௯">
        <Coords points="0,378 2780,378 2780,410 0,410"/>
        <Baseline points="0,404 2780,404"/>
        <TextEquiv>
          <Unicode>கண்ணுள்ளிற் போகாரி மைப்பிற் பருகுவரா ருண்ணியரெங்காத லவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>உடம்போடு யிருடை யெந்நை மற்றந்ந மடந்தையோடெ ம்முடை நட்பு
உள்ளுவன் மந்நியான் மறப்பின் மறப்பறியெநொள்ளமர் கண்ணாழ் குணம்
வாழ்தலு யிர்க்கண்ணாளா யிழை சாதல தற்கன்ன நீங்குமி டத்து
கருமணியுட பாவாய்நீ போதாயாம் வீழுந் திருநுதற்கில்லை யிடம்
பாலொடு தேன்கலந் தற்றெ பநிமொழி வாலெயிறூ றிய நீர்
நெஞ்சத்தார் காத லவராக வெய்துண்டல் அஞ்சுதும் வேபாக் கறிந்து
இமைப்பிற் கரப்பாக றிவல நைத்தற்கெ ஏதிலரெ ந்நுமி வ் வூர்
உவந்துறைவருள்ளத்து ரென்றும் மிகந்துறைவரேதில ரெநநு மிவ்வூர்
கண்ணுள்ளிற் போகாரி மைப்பிற் பருகுவரா ருண்ணியரெங்காத லவர்</Unicode>
      </TextEquiv>
    </TextRegion>
