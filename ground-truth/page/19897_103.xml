    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,89 2783,89 2783,464 0,464"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1009; numeral=௧">
        <Coords points="0,89 2783,89 2783,126 0,126"/>
        <Baseline points="0,120 2783,120"/>
        <TextEquiv>
          <Unicode>அன்பொரிஇ தற்சேற்ற றநோக்காதீ ட்டிய வொண்பொருள் கொழ்வார் பிறர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1001; numeral=௨">
        <Coords points="0,126 2783,126 2783,164 0,164"/>
        <Baseline points="0,157 2783,157"/>
        <TextEquiv>
          <Unicode>வைத்தான்வாய் சான்ற பெரும்பொருள ஃதுண்ணான் செத்தான் செயக்கிடந்ததில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1007; numeral=௩">
        <Coords points="0,164 2783,164 2783,201 0,201"/>
        <Baseline points="0,195 2783,195"/>
        <TextEquiv>
          <Unicode>அற்றார்க்கொன்றா ற்றான் செல்வம் மிகநலம் பெற்றாடமியன் மூத் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1005; numeral=௪">
        <Coords points="0,201 2783,201 2783,239 0,239"/>
        <Baseline points="0,232 2783,232"/>
        <TextEquiv>
          <Unicode>கொடுப்பதூஉந் துய்ப்பதூஊ மில்லார்க்க டுக்கிய கோடியுண் டாயிநுமில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1003; numeral=௫">
        <Coords points="0,239 2783,239 2783,277 0,277"/>
        <Baseline points="0,270 2783,270"/>
        <TextEquiv>
          <Unicode>ஈட்டமி வறி யிசைவேண்டா வாடவர் தோற்றநிலற்குப் பொறை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1002; numeral=௬">
        <Coords points="0,277 2783,277 2783,314 0,314"/>
        <Baseline points="0,307 2783,307"/>
        <TextEquiv>
          <Unicode>பொருளானாமேல்வாமொன்றீ யாவாறு மருளானா மாணாப் பிறப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1004; numeral=௭">
        <Coords points="0,314 2783,314 2783,352 0,352"/>
        <Baseline points="0,345 2783,345"/>
        <TextEquiv>
          <Unicode>எச்சமென்றெ ன்நெண்ணுங் கொல்லொ ஒருவரா நச்சப் படா தவன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1006; numeral=௮">
        <Coords points="0,352 2783,352 2783,389 0,389"/>
        <Baseline points="0,382 2783,382"/>
        <TextEquiv>
          <Unicode>ஏதம் பெருஞ்செல்வந் தான்றூவான் றக்கார்க்கொன்றீ தலி யலா தான்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1008; numeral=௯">
        <Coords points="0,389 2783,389 2783,427 0,427"/>
        <Baseline points="0,420 2783,420"/>
        <TextEquiv>
          <Unicode>நச்சப் படாஅதவன் செல்வம் நடுவூரின் நச்சு மரம்பழுத் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1010; numeral=௰">
        <Coords points="0,427 2783,427 2783,464 0,464"/>
        <Baseline points="0,457 2783,457"/>
        <TextEquiv>
          <Unicode>சீருழைச் செல்வர் சிறுதுளி மாறி  வறங்கூர்ந் தநையது டைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அன்பொரிஇ தற்சேற்ற றநோக்காதீ ட்டிய வொண்பொருள் கொழ்வார் பிறர்
வைத்தான்வாய் சான்ற பெரும்பொருள ஃதுண்ணான் செத்தான் செயக்கிடந்ததில்
அற்றார்க்கொன்றா ற்றான் செல்வம் மிகநலம் பெற்றாடமியன் மூத் தற்று
கொடுப்பதூஉந் துய்ப்பதூஊ மில்லார்க்க டுக்கிய கோடியுண் டாயிநுமில்
ஈட்டமி வறி யிசைவேண்டா வாடவர் தோற்றநிலற்குப் பொறை
பொருளானாமேல்வாமொன்றீ யாவாறு மருளானா மாணாப் பிறப்பு
எச்சமென்றெ ன்நெண்ணுங் கொல்லொ ஒருவரா நச்சப் படா தவன்
ஏதம் பெருஞ்செல்வந் தான்றூவான் றக்கார்க்கொன்றீ தலி யலா தான்
நச்சப் படாஅதவன் செல்வம் நடுவூரின் நச்சு மரம்பழுத் தற்று
சீருழைச் செல்வர் சிறுதுளி மாறி  வறங்கூர்ந் தநையது டைத்து</Unicode>
      </TextEquiv>
    </TextRegion>
