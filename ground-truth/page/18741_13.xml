    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,154 2869,154 2869,520 0,520"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=101; numeral=௧">
        <Coords points="0,154 2869,154 2869,191 0,191"/>
        <Baseline points="0,184 2869,184"/>
        <TextEquiv>
          <Unicode>செய்யாமற் செய்த உதவிக்கு வையகமும் வாநகமு மாற்ற லரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=102; numeral=௨">
        <Coords points="0,191 2869,191 2869,227 0,227"/>
        <Baseline points="0,221 2869,221"/>
        <TextEquiv>
          <Unicode>காலத்தி நாற்செய்த நன்றி சிறிதெநினும் ஞாலத்தின் மாணப் பெரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=103; numeral=௩">
        <Coords points="0,227 2869,227 2869,264 0,264"/>
        <Baseline points="0,257 2869,257"/>
        <TextEquiv>
          <Unicode>பயன்மாக்காச் செய்த வுதவி நயன்றூக்கி நன்மை கடலிற் பெரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=104; numeral=௪">
        <Coords points="0,264 2869,264 2869,300 0,300"/>
        <Baseline points="0,294 2869,294"/>
        <TextEquiv>
          <Unicode>திநைத்துணை நன்றி செயிநும் பநைத்துணையாக் கொள்வார் பயன்றெரி வாரர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=105; numeral=௫">
        <Coords points="0,300 2869,300 2869,337 0,337"/>
        <Baseline points="0,330 2869,330"/>
        <TextEquiv>
          <Unicode>உதவி வரைத்தன்றுதவி யுதவி செய்யப்பட்டார் சால்பின் வரைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=106; numeral=௬">
        <Coords points="0,337 2869,337 2869,373 0,373"/>
        <Baseline points="0,367 2869,367"/>
        <TextEquiv>
          <Unicode>மறவற்க மாசற்றா கேண்மை துறவற்க துன்பத்துட்டுப்பாயார் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=107; numeral=௭">
        <Coords points="0,373 2869,373 2869,410 0,410"/>
        <Baseline points="0,403 2869,403"/>
        <TextEquiv>
          <Unicode>எழுமை யெளுபிறப்பு முள்ளுவர் தங்கண் விழுமந் துடைத்தவர் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=108; numeral=௮">
        <Coords points="0,410 2869,410 2869,446 0,446"/>
        <Baseline points="0,440 2869,440"/>
        <TextEquiv>
          <Unicode>நன்றி மறப்பது நன்றன்று நன்றல்ல தன்றே மறப்பதுநன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=109; numeral=௯">
        <Coords points="0,446 2869,446 2869,483 0,483"/>
        <Baseline points="0,476 2869,476"/>
        <TextEquiv>
          <Unicode>கொன்றந்ந யிந்நா செயிநு மவர் செய்த வொன்றுநன் றுள்ளக்கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=110; numeral=௰">
        <Coords points="0,483 2869,483 2869,520 0,520"/>
        <Baseline points="0,513 2869,513"/>
        <TextEquiv>
          <Unicode>எந்நன்றி கொன்றார்க்கு முய்வுண்டா முய்வில்லை செய்ந்நன்றி கொன்ற மகற்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>செய்யாமற் செய்த உதவிக்கு வையகமும் வாநகமு மாற்ற லரிது
காலத்தி நாற்செய்த நன்றி சிறிதெநினும் ஞாலத்தின் மாணப் பெரிது
பயன்மாக்காச் செய்த வுதவி நயன்றூக்கி நன்மை கடலிற் பெரிது
திநைத்துணை நன்றி செயிநும் பநைத்துணையாக் கொள்வார் பயன்றெரி வாரர்
உதவி வரைத்தன்றுதவி யுதவி செய்யப்பட்டார் சால்பின் வரைத்து
மறவற்க மாசற்றா கேண்மை துறவற்க துன்பத்துட்டுப்பாயார் நட்பு
எழுமை யெளுபிறப்பு முள்ளுவர் தங்கண் விழுமந் துடைத்தவர் நட்பு
நன்றி மறப்பது நன்றன்று நன்றல்ல தன்றே மறப்பதுநன்று
கொன்றந்ந யிந்நா செயிநு மவர் செய்த வொன்றுநன் றுள்ளக்கெடும்
எந்நன்றி கொன்றார்க்கு முய்வுண்டா முய்வில்லை செய்ந்நன்றி கொன்ற மகற்கு</Unicode>
      </TextEquiv>
    </TextRegion>
