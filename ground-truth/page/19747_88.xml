      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=856; numeral=௧">
        <Coords points="0,85 2834,85 2834,123 0,123"/>
        <Baseline points="0,117 2834,117"/>
        <TextEquiv>
          <Unicode>யிகலின் மிகலிநிதெ ன்பவன் வாடகை தவலுங் கெடலும் ணித்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=858; numeral=௨">
        <Coords points="0,123 2834,123 2834,161 0,161"/>
        <Baseline points="0,155 2834,155"/>
        <TextEquiv>
          <Unicode>இகலிற்கெ திர்சாய்தலா க்கம தநை மிக்லூக்கிநூ க்கமாங் கேடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=859; numeral=௩">
        <Coords points="0,161 2834,161 2834,200 0,200"/>
        <Baseline points="0,193 2834,193"/>
        <TextEquiv>
          <Unicode>இகல்காணானா க்கம் வருங்கால தநை மிகல்காணுங் கேடு தரறக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=854; numeral=௪">
        <Coords points="0,200 2834,200 2834,238 0,238"/>
        <Baseline points="0,231 2834,231"/>
        <TextEquiv>
          <Unicode>இன்பத்துள் யின்பம் விளையாதான றுன்பத்துடடுன் பமுறுத லிலன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=851; numeral=௫">
        <Coords points="0,238 2834,238 2834,276 0,276"/>
        <Baseline points="0,269 2834,269"/>
        <TextEquiv>
          <Unicode>இகலென்ப வெல்லா வுயிர்க்கும் பகலெந்நும் பண்பின்மை பாரிக்கு நோய்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=855; numeral=௬">
        <Coords points="0,276 2834,276 2834,314 0,314"/>
        <Baseline points="0,307 2834,307"/>
        <TextEquiv>
          <Unicode>இகலெதிர் சாய்ந்தொழுக வல்லாரை யாரெ மிக்லூக்குந் தன்மை யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=860; numeral=௭">
        <Coords points="0,314 2834,314 2834,352 0,352"/>
        <Baseline points="0,345 2834,345"/>
        <TextEquiv>
          <Unicode>இகலானாமி ந்நாத வெல்லா நகலானாம் நந்நயமெ ந்நுஞ் செருக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=857; numeral=௮">
        <Coords points="0,352 2834,352 2834,390 0,390"/>
        <Baseline points="0,383 2834,383"/>
        <TextEquiv>
          <Unicode>மிகன்மேவன் மெய்ப்பொருள் காணாரி கன் மேவனி ன்னா வ றிவி நவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=853; numeral=௯">
        <Coords points="0,390 2834,390 2834,428 0,428"/>
        <Baseline points="0,421 2834,421"/>
        <TextEquiv>
          <Unicode>இகலெந்நுமெ வ்வநோய் நீக்கிற் தவலில்லாத் தாவில் விளக்கந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=852; numeral=௰">
        <Coords points="0,428 2834,428 2834,466 0,466"/>
        <Baseline points="0,459 2834,459"/>
        <TextEquiv>
          <Unicode>பக்கருதிப் பற்றா செயிநும் யிகல்கருதி யிந்நாசெய் யாமை தலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>யிகலின் மிகலிநிதெ ன்பவன் வாடகை தவலுங் கெடலும் ணித்து
இகலிற்கெ திர்சாய்தலா க்கம தநை மிக்லூக்கிநூ க்கமாங் கேடு
இகல்காணானா க்கம் வருங்கால தநை மிகல்காணுங் கேடு தரறக்கு
இன்பத்துள் யின்பம் விளையாதான றுன்பத்துடடுன் பமுறுத லிலன்
இகலென்ப வெல்லா வுயிர்க்கும் பகலெந்நும் பண்பின்மை பாரிக்கு நோய்
இகலெதிர் சாய்ந்தொழுக வல்லாரை யாரெ மிக்லூக்குந் தன்மை யவர்
இகலானாமி ந்நாத வெல்லா நகலானாம் நந்நயமெ ந்நுஞ் செருக்கு
மிகன்மேவன் மெய்ப்பொருள் காணாரி கன் மேவனி ன்னா வ றிவி நவர்
இகலெந்நுமெ வ்வநோய் நீக்கிற் தவலில்லாத் தாவில் விளக்கந் தரும்
