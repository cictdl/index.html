        <Baseline points="0,98 3076,98"/>
        <TextEquiv>
          <Unicode>மலர்மிசை யெகிநான் மாணடி சேர்ந்தார் நிலமிசை நீடு வாழ்வா / ர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=4; numeral=௪">
        <Coords points="0,105 3076,105 3076,140 0,140"/>
        <Baseline points="0,133 3076,133"/>
        <TextEquiv>
          <Unicode>வேண்டுதல் வேண் டாமை யில னடி சேர்ந்தார்க்கி யாண்   டு மிடும்பை யில</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=5; numeral=௫">
        <Coords points="0,140 3076,140 3076,174 0,174"/>
        <Baseline points="0,168 3076,168"/>
        <TextEquiv>
          <Unicode>இருள்சே ரிருவினையுஞ் சேரா விறைவன் பொருள்சேர் புக  ழ் புரிந்தார் மாட்டு</Unicode>
        </TextEquiv>
      </TextLine>
