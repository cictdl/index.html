        <Baseline points="0,63 3076,63"/>
        <TextEquiv>
          <Unicode>கற்றதி னா லாய பயனென்கொல்  வாலறிவா நற்றா டொழாஅ ரெனி / ன்</Unicode>
        </TextEquiv>
      </TextLine>
