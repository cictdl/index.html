    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,72 2624,72 2624,423 0,423"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=581; numeral=௧">
        <Coords points="0,72 2624,72 2624,107 0,107"/>
        <Baseline points="0,101 2624,101"/>
        <TextEquiv>
          <Unicode>ஒற்றுமு றைசான்ற நூலுமி வையிரண்டுந் தெற்றென்க மந்நவன் கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=582; numeral=௨">
        <Coords points="0,107 2624,107 2624,142 0,142"/>
        <Baseline points="0,136 2624,136"/>
        <TextEquiv>
          <Unicode>எல்லார்க்குமெ ல்லா நிகழ்பவை யெஞ்ஞான்றும் வல்லறிதல் வேந்தன் றொழில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=583; numeral=௩">
        <Coords points="0,142 2624,142 2624,177 0,177"/>
        <Baseline points="0,171 2624,171"/>
        <TextEquiv>
          <Unicode>ஒற்றினானொ ற்றிப் பொரு டேராமந்நவன் கொற்றங் கொளக்கிடந்ததில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=588; numeral=௪">
        <Coords points="0,177 2624,177 2624,213 0,213"/>
        <Baseline points="0,206 2624,206"/>
        <TextEquiv>
          <Unicode>ஒற்றறித் தந்த பொருளையு மற்றுமோர் ஒற்றிநானொ ற்றிக் கொள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=589; numeral=௫">
        <Coords points="0,213 2624,213 2624,248 0,248"/>
        <Baseline points="0,241 2624,241"/>
        <TextEquiv>
          <Unicode>ஒற்றெற் றுணராமை யாள்க வுடன்மூவர் சொற்றொக்க தேறப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=590; numeral=௬">
        <Coords points="0,248 2624,248 2624,283 0,283"/>
        <Baseline points="0,276 2624,276"/>
        <TextEquiv>
          <Unicode>சிறப்பாய வொற்றின்கட் செய்யற்கச் செய்யின் புலப்படுத்தானாகும் மிறை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=585; numeral=௭">
        <Coords points="0,283 2624,283 2624,318 0,318"/>
        <Baseline points="0,311 2624,311"/>
        <TextEquiv>
          <Unicode>கடாஅ வுருவோடு கண்ணஞ்சாதி யாண்டுமு காஅமை வல்லதெ ஒற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=586; numeral=௮">
        <Coords points="0,318 2624,318 2624,353 0,353"/>
        <Baseline points="0,347 2624,347"/>
        <TextEquiv>
          <Unicode>துறந்தார் படிவத்த தாகி யிறந்தாராய்ந்தெ ன்செயிநுஞ் சோர்விரதொ ற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=587; numeral=௯">
        <Coords points="0,353 2624,353 2624,388 0,388"/>
        <Baseline points="0,382 2624,382"/>
        <TextEquiv>
          <Unicode>மறந்தவை கேட்கவற் றாகி யறிந்தவை ஐயப்பாடி ல்லதெ ஒற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=584; numeral=௰">
        <Coords points="0,388 2624,388 2624,423 0,423"/>
        <Baseline points="0,417 2624,417"/>
        <TextEquiv>
          <Unicode>விநைசெய்வார் தன்சுற்றம் வேண்டாதாரெ ன்றாங்க ளைவரையுமா ராய்வா ஒற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>ஒற்றுமு றைசான்ற நூலுமி வையிரண்டுந் தெற்றென்க மந்நவன் கண்
எல்லார்க்குமெ ல்லா நிகழ்பவை யெஞ்ஞான்றும் வல்லறிதல் வேந்தன் றொழில்
ஒற்றினானொ ற்றிப் பொரு டேராமந்நவன் கொற்றங் கொளக்கிடந்ததில்
ஒற்றறித் தந்த பொருளையு மற்றுமோர் ஒற்றிநானொ ற்றிக் கொள்
ஒற்றெற் றுணராமை யாள்க வுடன்மூவர் சொற்றொக்க தேறப் படும்
சிறப்பாய வொற்றின்கட் செய்யற்கச் செய்யின் புலப்படுத்தானாகும் மிறை
கடாஅ வுருவோடு கண்ணஞ்சாதி யாண்டுமு காஅமை வல்லதெ ஒற்று
துறந்தார் படிவத்த தாகி யிறந்தாராய்ந்தெ ன்செயிநுஞ் சோர்விரதொ ற்று
மறந்தவை கேட்கவற் றாகி யறிந்தவை ஐயப்பாடி ல்லதெ ஒற்று
விநைசெய்வார் தன்சுற்றம் வேண்டாதாரெ ன்றாங்க ளைவரையுமா ராய்வா ஒற்று</Unicode>
      </TextEquiv>
