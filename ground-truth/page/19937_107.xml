    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,73 2798,73 2798,445 0,445"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1046; numeral=௧">
        <Coords points="0,73 2798,73 2798,110 0,110"/>
        <Baseline points="0,103 2798,103"/>
        <TextEquiv>
          <Unicode>நற்பொருள் நன்குணர்ந்து சொல்லிநும் நல்கூர்ந்தார் சொற்பொருள் சோர்வு படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1043; numeral=௨">
        <Coords points="0,110 2798,110 2798,147 0,147"/>
        <Baseline points="0,141 2798,141"/>
        <TextEquiv>
          <Unicode>தொல்வரவுந் தொழிலுங் கெடுக்குந் தொகையாக நல்குரவெ ந்நும் நசை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1047; numeral=௩">
        <Coords points="0,147 2798,147 2798,185 0,185"/>
        <Baseline points="0,178 2798,178"/>
        <TextEquiv>
          <Unicode>நலஞ்சாரா நல்குரவீ ன்றதா யாநும் பிறன்போல நோக்கப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1045; numeral=௪">
        <Coords points="0,185 2798,185 2798,222 0,222"/>
        <Baseline points="0,215 2798,215"/>
        <TextEquiv>
          <Unicode>நல்குரவெ ந்நுமி டும்பையுட் பல்குறைத் துன்பங்கள் சென்று படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1049; numeral=௫">
        <Coords points="0,222 2798,222 2798,259 0,259"/>
        <Baseline points="0,252 2798,252"/>
        <TextEquiv>
          <Unicode>நெருப்பிநுட்டுஞ்சலு மாகும் யிரப்பினுள் யாதொன்றுங் காண்பாரிடத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1041; numeral=௬">
        <Coords points="0,259 2798,259 2798,296 0,296"/>
        <Baseline points="0,290 2798,290"/>
        <TextEquiv>
          <Unicode>இன்மையினி ந்நாதி யாதெநின் னின்மையின் னின்மையெ யிந்நாத்தில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1050; numeral=௭">
        <Coords points="0,296 2798,296 2798,333 0,333"/>
        <Baseline points="0,327 2798,327"/>
        <TextEquiv>
          <Unicode>துப்புர வில்லார் துவரத் துறவாமை யுப்பிற்குங் காடிக்குங் கூற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1042; numeral=௮">
        <Coords points="0,333 2798,333 2798,371 0,371"/>
        <Baseline points="0,364 2798,364"/>
        <TextEquiv>
          <Unicode>இன்மை யெநவொரு பாவி மறுமையும் யிம்மையும ன்றிக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1048; numeral=௯">
        <Coords points="0,371 2798,371 2798,408 0,408"/>
        <Baseline points="0,401 2798,401"/>
        <TextEquiv>
          <Unicode>இன்றும் வருவது கொல்லொ நெருனலுள் கொன்றது போலுந் திரப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1044; numeral=௰">
        <Coords points="0,408 2798,408 2798,445 0,445"/>
        <Baseline points="0,438 2798,438"/>
        <TextEquiv>
          <Unicode>இற்பிறந்தார் கண்ணேயுமி ன்மை யிழிவந்த சொற்பிறக்குஞ் சோர்வு படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>நற்பொருள் நன்குணர்ந்து சொல்லிநும் நல்கூர்ந்தார் சொற்பொருள் சோர்வு படும்
தொல்வரவுந் தொழிலுங் கெடுக்குந் தொகையாக நல்குரவெ ந்நும் நசை
நலஞ்சாரா நல்குரவீ ன்றதா யாநும் பிறன்போல நோக்கப் படும்
நல்குரவெ ந்நுமி டும்பையுட் பல்குறைத் துன்பங்கள் சென்று படும்
நெருப்பிநுட்டுஞ்சலு மாகும் யிரப்பினுள் யாதொன்றுங் காண்பாரிடத்து
இன்மையினி ந்நாதி யாதெநின் னின்மையின் னின்மையெ யிந்நாத்தில்
துப்புர வில்லார் துவரத் துறவாமை யுப்பிற்குங் காடிக்குங் கூற்று
இன்மை யெநவொரு பாவி மறுமையும் யிம்மையும ன்றிக் கெடும்
இன்றும் வருவது கொல்லொ நெருனலுள் கொன்றது போலுந் திரப்பு
இற்பிறந்தார் கண்ணேயுமி ன்மை யிழிவந்த சொற்பிறக்குஞ் சோர்வு படும்</Unicode>
      </TextEquiv>
