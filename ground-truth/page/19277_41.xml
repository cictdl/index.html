      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=381; numeral=௧">
        <Coords points="0,167 2839,167 2839,205 0,205"/>
        <Baseline points="0,198 2839,198"/>
        <TextEquiv>
          <Unicode>படைகுடி கூழமைச்சு நட்பரணா றும் உடையான் ரசருளேறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=383; numeral=௨">
        <Coords points="0,205 2839,205 2839,244 0,244"/>
        <Baseline points="0,237 2839,237"/>
        <TextEquiv>
          <Unicode>தூங்காமைக் கல்வி துணிவுடமை யிம்மூன்றும் நீங்கா நிலநான் பவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=384; numeral=௩">
        <Coords points="0,244 2839,244 2839,282 0,282"/>
        <Baseline points="0,275 2839,275"/>
        <TextEquiv>
          <Unicode>றனிழுக்கா தல்லவை நீக்கி மறனிழுக்கா மாநமு டைய தரசு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=390; numeral=௪">
        <Coords points="0,282 2839,282 2839,321 0,321"/>
        <Baseline points="0,314 2839,314"/>
        <TextEquiv>
          <Unicode>கொடையளி செங்கோல் குடியோம்பல் நான்குமு டையநாம் வேந்தர்க் கொளி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=386; numeral=௫">
        <Coords points="0,321 2839,321 2839,359 0,359"/>
        <Baseline points="0,352 2839,352"/>
        <TextEquiv>
          <Unicode>காக்ஷிக் கெழியன் கடுஞ்சொல்லன ல்லனேன் மீக்கூரும் மந்ந நிலம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=387; numeral=௬">
        <Coords points="0,359 2839,359 2839,397 0,397"/>
        <Baseline points="0,390 2839,390"/>
        <TextEquiv>
          <Unicode>இஞ்சொலாலீ த்தளிக்க வல்லார்க்குத் தண்சொலா ற்றானகண் டநைத்திவ் வுலகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=385; numeral=௭">
        <Coords points="0,397 2839,397 2839,436 0,436"/>
        <Baseline points="0,429 2839,429"/>
        <TextEquiv>
          <Unicode>இயற்றலு மீட்டலும் காத்தலுங் காத்தல் வகுத்தலும் வல்ல தரசு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=389; numeral=௮">
        <Coords points="0,436 2839,436 2839,474 0,474"/>
        <Baseline points="0,467 2839,467"/>
        <TextEquiv>
          <Unicode>செவிகைப்பச் சொற்பொருக்கும் பண்புடை வேந்தன் கவிகைக்கீழ்த் தங்குமு லகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=382; numeral=௯">
        <Coords points="0,474 2839,474 2839,512 0,512"/>
        <Baseline points="0,506 2839,506"/>
        <TextEquiv>
          <Unicode>அஞ்சாமை யீயகை யறிவூக்கமி ந்நான்கும் எஞ்சாமை வேந்தர்க் கியல்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=388; numeral=௰">
        <Coords points="0,512 2839,512 2839,551 0,551"/>
        <Baseline points="0,544 2839,544"/>
        <TextEquiv>
          <Unicode>முறைசெய்து காப்பாத்தும் மந்நவன் மக்கட்கி றையென்று வைக்கப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>படைகுடி கூழமைச்சு நட்பரணா றும் உடையான் ரசருளேறு
தூங்காமைக் கல்வி துணிவுடமை யிம்மூன்றும் நீங்கா நிலநான் பவர்க்கு
றனிழுக்கா தல்லவை நீக்கி மறனிழுக்கா மாநமு டைய தரசு
கொடையளி செங்கோல் குடியோம்பல் நான்குமு டையநாம் வேந்தர்க் கொளி
காக்ஷிக் கெழியன் கடுஞ்சொல்லன ல்லனேன் மீக்கூரும் மந்ந நிலம்
இஞ்சொலாலீ த்தளிக்க வல்லார்க்குத் தண்சொலா ற்றானகண் டநைத்திவ் வுலகு
இயற்றலு மீட்டலும் காத்தலுங் காத்தல் வகுத்தலும் வல்ல தரசு
செவிகைப்பச் சொற்பொருக்கும் பண்புடை வேந்தன் கவிகைக்கீழ்த் தங்குமு லகு
அஞ்சாமை யீயகை யறிவூக்கமி ந்நான்கும் எஞ்சாமை வேந்தர்க் கியல்பு
முறைசெய்து காப்பாத்தும் மந்நவன் மக்கட்கி றையென்று வைக்கப் படும்</Unicode>
      </TextEquiv>
