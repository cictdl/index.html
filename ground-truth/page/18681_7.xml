    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,163 2964,163 2964,561 0,561"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=41; numeral=௧">
        <Coords points="0,163 2964,163 2964,203 0,203"/>
        <Baseline points="0,196 2964,196"/>
        <TextEquiv>
          <Unicode>இல்வாழ்வா நென்பா னியல்புடைய மூவர்க்கும் நல்லாற்றி னின்றதுணை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=42; numeral=௨">
        <Coords points="0,203 2964,203 2964,243 0,243"/>
        <Baseline points="0,236 2964,236"/>
        <TextEquiv>
          <Unicode>துறந்தார்க்குந் துவ்வா தவர்க்கு மிறந்தார்க்கும் யில்வாழ்வா னென்பான்றுணை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=43; numeral=௩">
        <Coords points="0,243 2964,243 2964,283 0,283"/>
        <Baseline points="0,276 2964,276"/>
        <TextEquiv>
          <Unicode>தென்புலத்தார் தெய்வம் விருந்தொக்க றா நென்றாங் கைம்புலத்தா றோம்பறலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=44; numeral=௪">
        <Coords points="0,283 2964,283 2964,322 0,322"/>
        <Baseline points="0,315 2964,315"/>
        <TextEquiv>
          <Unicode>பழியஞ்சிப் பாத்தூணு டைத்தாயி ல்வாழ்க்கை வழியெஞ்ச லெஞ்ஞான்றுமில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=45; numeral=௫">
        <Coords points="0,322 2964,322 2964,362 0,362"/>
        <Baseline points="0,355 2964,355"/>
        <TextEquiv>
          <Unicode>அன்பு மறநு முடைத்தாயி னில்வாழ்க்கை பண்பும் பயநுமது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=46; numeral=௬">
        <Coords points="0,362 2964,362 2964,402 0,402"/>
        <Baseline points="0,395 2964,395"/>
        <TextEquiv>
          <Unicode>அறத்தாற்றி னில்வாழ்க்கை யாற்றிற் புறத்தாற்றிற் போய்ப் பெறுவதெவன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=47; numeral=௭">
        <Coords points="0,402 2964,402 2964,442 0,442"/>
        <Baseline points="0,434 2964,434"/>
        <TextEquiv>
          <Unicode>இயல்பிநா னில்வாழ்க்கை வாழ்பவ நென்பான் முயல்வாருளெ ல்லாந்தலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=48; numeral=௮">
        <Coords points="0,442 2964,442 2964,481 0,481"/>
        <Baseline points="0,474 2964,474"/>
        <TextEquiv>
          <Unicode>ஆற்றி னொழுக்கி யறனிழுக்கா வில்வாழ்க்கை நோற்பாரி நோன்மை யுடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=49; numeral=௯">
        <Coords points="0,481 2964,481 2964,521 0,521"/>
        <Baseline points="0,514 2964,514"/>
        <TextEquiv>
          <Unicode>அறநெந்ப் பட்டதே யில்வாழ்க்கை யஃதும் பிறன்பழிப்ப தில்லாயிநன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=50; numeral=௰">
        <Coords points="0,521 2964,521 2964,561 0,561"/>
        <Baseline points="0,554 2964,554"/>
        <TextEquiv>
          <Unicode>வையத்து வாழ்வாங்கு வாழ்பவன் வானுறையுமந் தெய்வத்துள் வைக்கப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>இல்வாழ்வா நென்பா னியல்புடைய மூவர்க்கும் நல்லாற்றி னின்றதுணை
துறந்தார்க்குந் துவ்வா தவர்க்கு மிறந்தார்க்கும் யில்வாழ்வா னென்பான்றுணை
தென்புலத்தார் தெய்வம் விருந்தொக்க றா நென்றாங் கைம்புலத்தா றோம்பறலை
பழியஞ்சிப் பாத்தூணு டைத்தாயி ல்வாழ்க்கை வழியெஞ்ச லெஞ்ஞான்றுமில்
அன்பு மறநு முடைத்தாயி னில்வாழ்க்கை பண்பும் பயநுமது
அறத்தாற்றி னில்வாழ்க்கை யாற்றிற் புறத்தாற்றிற் போய்ப் பெறுவதெவன்
இயல்பிநா னில்வாழ்க்கை வாழ்பவ நென்பான் முயல்வாருளெ ல்லாந்தலை
ஆற்றி னொழுக்கி யறனிழுக்கா வில்வாழ்க்கை நோற்பாரி நோன்மை யுடைத்து
அறநெந்ப் பட்டதே யில்வாழ்க்கை யஃதும் பிறன்பழிப்ப தில்லாயிநன்று
வையத்து வாழ்வாங்கு வாழ்பவன் வானுறையுமந் தெய்வத்துள் வைக்கப் படும்</Unicode>
      </TextEquiv>
