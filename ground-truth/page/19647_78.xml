      <Coords points="0,60 2792,60 2792,455 0,455"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=754; numeral=௧">
        <Coords points="0,60 2792,60 2792,99 0,99"/>
        <Baseline points="0,92 2792,92"/>
        <TextEquiv>
          <Unicode>அறனீனும் யின்பமுமீ னுந் திறனறிந்து தீதின்றி வந்த பொருள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=755; numeral=௨">
        <Coords points="0,99 2792,99 2792,139 0,139"/>
        <Baseline points="0,131 2792,131"/>
        <TextEquiv>
          <Unicode>அருளொடும் அன்பொடும் வாராப் பொருளாக்கம் புல்லார் பொருள் விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=760; numeral=௩">
        <Coords points="0,139 2792,139 2792,178 0,178"/>
        <Baseline points="0,171 2792,171"/>
        <TextEquiv>
          <Unicode>ஒண்பொருள் காப்ப வியத்தியார்கெ ண்பொருளெ நை யிரண்டுமொ ருங்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=757; numeral=௪">
        <Coords points="0,178 2792,178 2792,218 0,218"/>
        <Baseline points="0,211 2792,211"/>
        <TextEquiv>
          <Unicode>அருளெந்நும ன்பீன் குழவி பொருளெந்நுஞ் செல்வச் செவிலியால் உண்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=758; numeral=௫">
        <Coords points="0,218 2792,218 2792,257 0,257"/>
        <Baseline points="0,250 2792,250"/>
        <TextEquiv>
          <Unicode>குன்றேறி யாநை போர் கண்டற்றாற் றங்கைத்தொன்று உண்டாகச் செய்வான் விநை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=759; numeral=௬">
        <Coords points="0,257 2792,257 2792,297 0,297"/>
        <Baseline points="0,290 2792,290"/>
        <TextEquiv>
          <Unicode>செய்க பொருளைச் செருனர் செருக்கறுக்குமெ ஃகதநிற் கூரிய தில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=753; numeral=௭">
        <Coords points="0,297 2792,297 2792,336 0,336"/>
        <Baseline points="0,329 2792,329"/>
        <TextEquiv>
          <Unicode>பொருளெந்நும் பொய்யா விளக்கம் யிருளறுக்குமெண்ணிய தேயத்திற சென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=751; numeral=௮">
        <Coords points="0,336 2792,336 2792,376 0,376"/>
        <Baseline points="0,369 2792,369"/>
        <TextEquiv>
          <Unicode>பொருளல் லவரைப் பொருளாகச் செய்யும் பொருளல்லதி ல்லை பொருள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=756; numeral=௯">
        <Coords points="0,376 2792,376 2792,415 0,415"/>
        <Baseline points="0,408 2792,408"/>
        <TextEquiv>
          <Unicode>உறுபொருளுமு ல்கு பொருளுந்தந் நொன்னார்த் தெறுபொருளும் வேந்தன் பொருள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=752; numeral=௰">
        <Coords points="0,415 2792,415 2792,455 0,455"/>
        <Baseline points="0,448 2792,448"/>
        <TextEquiv>
          <Unicode>இல்லாரை யெல்லாருமெ ள்ளுவர் செல்வரை யெல்லாருமஞ் செய்வர் சிறப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அறனீனும் யின்பமுமீ னுந் திறனறிந்து தீதின்றி வந்த பொருள்
அருளொடும் அன்பொடும் வாராப் பொருளாக்கம் புல்லார் பொருள் விடல்
ஒண்பொருள் காப்ப வியத்தியார்கெ ண்பொருளெ நை யிரண்டுமொ ருங்கு
அருளெந்நும ன்பீன் குழவி பொருளெந்நுஞ் செல்வச் செவிலியால் உண்டு
குன்றேறி யாநை போர் கண்டற்றாற் றங்கைத்தொன்று உண்டாகச் செய்வான் விநை
செய்க பொருளைச் செருனர் செருக்கறுக்குமெ ஃகதநிற் கூரிய தில்
பொருளெந்நும் பொய்யா விளக்கம் யிருளறுக்குமெண்ணிய தேயத்திற சென்று
பொருளல் லவரைப் பொருளாகச் செய்யும் பொருளல்லதி ல்லை பொருள்
உறுபொருளுமு ல்கு பொருளுந்தந் நொன்னார்த் தெறுபொருளும் வேந்தன் பொருள்
இல்லாரை யெல்லாருமெ ள்ளுவர் செல்வரை யெல்லாருமஞ் செய்வர் சிறப்பு</Unicode>
      </TextEquiv>
