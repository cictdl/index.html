      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=745; numeral=௧">
        <Coords points="0,88 2700,88 2700,124 0,124"/>
        <Baseline points="0,118 2700,118"/>
        <TextEquiv>
          <Unicode>கொளக்கரிதாய்க் கொண்டகூழ்த் தாகி யகத்தார் நிலைக்கெழிதாய் நீரத ரண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=742; numeral=௨">
        <Coords points="0,124 2700,124 2700,160 0,160"/>
        <Baseline points="0,154 2700,154"/>
        <TextEquiv>
          <Unicode>மணிநீரும் மண்ணும் மலையும் மணிநிழற் காடுமு டையத ரண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=743; numeral=௩">
        <Coords points="0,160 2700,160 2700,197 0,197"/>
        <Baseline points="0,190 2700,190"/>
        <TextEquiv>
          <Unicode>உயர்வகலந் திண்மை யருமையிந் நான்கின் நமைவுவரண் யென்றுரைக்கும் நூல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=746; numeral=௪">
        <Coords points="0,197 2700,197 2700,233 0,233"/>
        <Baseline points="0,227 2700,227"/>
        <TextEquiv>
          <Unicode>எல்லாப் பொருளுமு டைத்தாயி டத்துதவும் நல்லாளு டையத ரண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=744; numeral=௫">
        <Coords points="0,233 2700,233 2700,270 0,270"/>
        <Baseline points="0,263 2700,263"/>
        <TextEquiv>
          <Unicode>சிறுகாப்பிற் பேரிடத்த தாகி யுறுபடை யூக்கம் அழிப்பத ரண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=749; numeral=௬">
        <Coords points="0,270 2700,270 2700,306 0,306"/>
        <Baseline points="0,300 2700,300"/>
        <TextEquiv>
          <Unicode>முநைமுகத்து மாற்றவர் சாய விநைமுகத்து வீறெய்தி மாண்டத ரண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=748; numeral=௭">
        <Coords points="0,306 2700,306 2700,343 0,343"/>
        <Baseline points="0,336 2700,336"/>
        <TextEquiv>
          <Unicode>முற்றாற்றி முற்றி யவரையும் பற்றாற்றிப் பற்றியால் வெல்வத ரண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=741; numeral=௮">
        <Coords points="0,343 2700,343 2700,379 0,379"/>
        <Baseline points="0,372 2700,372"/>
        <TextEquiv>
          <Unicode>ஆற்று பவர்க்கும ரண்பொருள ஞ்சித்தம் போற்று பவர்க்கும் பொருள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=750; numeral=௯">
        <Coords points="0,379 2700,379 2700,415 0,415"/>
        <Baseline points="0,409 2700,409"/>
        <TextEquiv>
          <Unicode>எநைமாட்சித்தா கியக் கண்ணும் விநைமாக்ஷி யில்லார்கண் ணில்லத ரண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=747; numeral=௰">
        <Coords points="0,415 2700,415 2700,452 0,452"/>
        <Baseline points="0,445 2700,445"/>
        <TextEquiv>
          <Unicode>முற்றியு முற்றாதெ றிந்தும் மறைப்படுத்தும் பற்றற்க ரியத ரண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>கொளக்கரிதாய்க் கொண்டகூழ்த் தாகி யகத்தார் நிலைக்கெழிதாய் நீரத ரண்
மணிநீரும் மண்ணும் மலையும் மணிநிழற் காடுமு டையத ரண்
உயர்வகலந் திண்மை யருமையிந் நான்கின் நமைவுவரண் யென்றுரைக்கும் நூல்
எல்லாப் பொருளுமு டைத்தாயி டத்துதவும் நல்லாளு டையத ரண்
சிறுகாப்பிற் பேரிடத்த தாகி யுறுபடை யூக்கம் அழிப்பத ரண்
முநைமுகத்து மாற்றவர் சாய விநைமுகத்து வீறெய்தி மாண்டத ரண்
முற்றாற்றி முற்றி யவரையும் பற்றாற்றிப் பற்றியால் வெல்வத ரண்
ஆற்று பவர்க்கும ரண்பொருள ஞ்சித்தம் போற்று பவர்க்கும் பொருள்
எநைமாட்சித்தா கியக் கண்ணும் விநைமாக்ஷி யில்லார்கண் ணில்லத ரண்
முற்றியு முற்றாதெ றிந்தும் மறைப்படுத்தும் பற்றற்க ரியத ரண்</Unicode>
      </TextEquiv>
