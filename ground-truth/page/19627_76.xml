    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,67 2800,67 2800,445 0,445"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=737; numeral=௧">
        <Coords points="0,67 2800,67 2800,105 0,105"/>
        <Baseline points="0,98 2800,98"/>
        <TextEquiv>
          <Unicode>இருபுநலு வாய்ந்த மலையும் வருபுநலு வல்லரணும் நாட்டிற்கு றிப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=738; numeral=௨">
        <Coords points="0,105 2800,105 2800,142 0,142"/>
        <Baseline points="0,136 2800,136"/>
        <TextEquiv>
          <Unicode>பிணியின்மை செல்வம் விழைவின்பமெ மம் அணியென்ப நாட்டிற்கிவ் வைந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=731; numeral=௩">
        <Coords points="0,142 2800,142 2800,180 0,180"/>
        <Baseline points="0,173 2800,173"/>
        <TextEquiv>
          <Unicode>தள்ளா விழையுழுந் தக்காருந் தாழ்விலாச் செல்வருஞ் சேர்வது நாடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=739; numeral=௪">
        <Coords points="0,180 2800,180 2800,218 0,218"/>
        <Baseline points="0,211 2800,211"/>
        <TextEquiv>
          <Unicode>நாடென்ப நாடா வளந்தன நாடல்ல நாடா வளந்தரு நாடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=736; numeral=௫">
        <Coords points="0,218 2800,218 2800,256 0,256"/>
        <Baseline points="0,249 2800,249"/>
        <TextEquiv>
          <Unicode>கேடறியா கெட்ட விடத்தும் வளந்குன்றா நாடென்ப நாட்டிற் றலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=732; numeral=௬">
        <Coords points="0,256 2800,256 2800,294 0,294"/>
        <Baseline points="0,287 2800,287"/>
        <TextEquiv>
          <Unicode>பெரும்பொருளாற் பெட்டக்கத்தகத் தாகி யருங்கெட்டாநா ற்ற விளைவது நாடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=733; numeral=௭">
        <Coords points="0,294 2800,294 2800,332 0,332"/>
        <Baseline points="0,325 2800,325"/>
        <TextEquiv>
          <Unicode>பொறையொருங்கு மேல்வருங்காற் றாங்கி யிறைவர்க் கிறையொருங்கு நேர்வது நாடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=735; numeral=௮">
        <Coords points="0,332 2800,332 2800,370 0,370"/>
        <Baseline points="0,363 2800,363"/>
        <TextEquiv>
          <Unicode>பல்குளுவும் பாழ்செய்யுமு ட்பகையும் வேந்தலைக்கும் கொல்குறும்புமி ல்லது நாடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=734; numeral=௯">
        <Coords points="0,370 2800,370 2800,408 0,408"/>
        <Baseline points="0,401 2800,401"/>
        <TextEquiv>
          <Unicode>உறுபசியுமொ வ்வாப் பிணியுஞ் செறுபகையுஞ் சேராதி யல்பது நாடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=740; numeral=௰">
        <Coords points="0,408 2800,408 2800,445 0,445"/>
        <Baseline points="0,439 2800,439"/>
        <TextEquiv>
          <Unicode>ஆங்கமை யெய்தியக் கண்ணும் பயமின்றெ வேந்தமை யில்லாத நாடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>இருபுநலு வாய்ந்த மலையும் வருபுநலு வல்லரணும் நாட்டிற்கு றிப்பு
பிணியின்மை செல்வம் விழைவின்பமெ மம் அணியென்ப நாட்டிற்கிவ் வைந்து
தள்ளா விழையுழுந் தக்காருந் தாழ்விலாச் செல்வருஞ் சேர்வது நாடு
நாடென்ப நாடா வளந்தன நாடல்ல நாடா வளந்தரு நாடு
கேடறியா கெட்ட விடத்தும் வளந்குன்றா நாடென்ப நாட்டிற் றலை
பெரும்பொருளாற் பெட்டக்கத்தகத் தாகி யருங்கெட்டாநா ற்ற விளைவது நாடு
பொறையொருங்கு மேல்வருங்காற் றாங்கி யிறைவர்க் கிறையொருங்கு நேர்வது நாடு
பல்குளுவும் பாழ்செய்யுமு ட்பகையும் வேந்தலைக்கும் கொல்குறும்புமி ல்லது நாடு
உறுபசியுமொ வ்வாப் பிணியுஞ் செறுபகையுஞ் சேராதி யல்பது நாடு
ஆங்கமை யெய்தியக் கண்ணும் பயமின்றெ வேந்தமை யில்லாத நாடு</Unicode>
      </TextEquiv>
