      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=243; numeral=௧">
        <Coords points="0,139 2865,139 2865,178 0,178"/>
        <Baseline points="0,171 2865,171"/>
        <TextEquiv>
          <Unicode>அருள்சேர்ந்த நெஞ்சிநார்க் கில்லை யிருள்சேர்ந்த விந்நா வுலகம் புகல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=244; numeral=௨">
        <Coords points="0,178 2865,178 2865,216 0,216"/>
        <Baseline points="0,209 2865,209"/>
        <TextEquiv>
          <Unicode>மந்நுயி ரோம்பி யருளாள்வர் கில்லென்ப தந்நுயி ரஞ்சும் விநை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=242; numeral=௩">
        <Coords points="0,216 2865,216 2865,254 0,254"/>
        <Baseline points="0,247 2865,247"/>
        <TextEquiv>
          <Unicode>நல்லாற்றா நாடி யருளாள்கப் பல்லாற்றாற் றேறிநு மஃதே துணை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=245; numeral=௪">
        <Coords points="0,254 2865,254 2865,292 0,292"/>
        <Baseline points="0,285 2865,285"/>
        <TextEquiv>
          <Unicode>அல்லல் அருளாள்வார்க் கில்லை வளிவழங்கு மல்லன்மா ஞாலங் கரி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=246; numeral=௫">
        <Coords points="0,292 2865,292 2865,331 0,331"/>
        <Baseline points="0,324 2865,324"/>
        <TextEquiv>
          <Unicode>பொருணீங்கிப் பொய்ச்சாந்தா ரென்ப ரருணீங்கி யல்லவை செய்தொளுகு வார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=248; numeral=௬">
        <Coords points="0,331 2865,331 2865,369 0,369"/>
        <Baseline points="0,362 2865,362"/>
        <TextEquiv>
          <Unicode>பொருளற்றாற் பூப்ப ரொருகால் அருளற்றா ராற்றா மற் றாறற் லரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=241; numeral=௭">
        <Coords points="0,369 2865,369 2865,407 0,407"/>
        <Baseline points="0,400 2865,400"/>
        <TextEquiv>
          <Unicode>அருட்செல்வஞ் செல்வத்துட் செல்வம் பொருட்செல்வம் பூரியார் கண்ணு முள</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=250; numeral=௮">
        <Coords points="0,407 2865,407 2865,445 0,445"/>
        <Baseline points="0,438 2865,438"/>
        <TextEquiv>
          <Unicode>வலியார்முற் றந்நை நிநைக்கதான் றன்னின் மெலியார்மேற் செல்லு மிடத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=249; numeral=௯">
        <Coords points="0,445 2865,445 2865,484 0,484"/>
        <Baseline points="0,477 2865,477"/>
        <TextEquiv>
          <Unicode>தெருளாதான் மெய்ப்பொருள் கண்டற்றாற் றேறின் னருளாதான் செய்யு மறம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=247; numeral=௰">
        <Coords points="0,484 2865,484 2865,522 0,522"/>
        <Baseline points="0,515 2865,515"/>
        <TextEquiv>
          <Unicode>அருளிலார்க் கவ்வுலக மில்லை பொருளிலார்க் கிவ்வுலக மில்லாகி யாங்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அருள்சேர்ந்த நெஞ்சிநார்க் கில்லை யிருள்சேர்ந்த விந்நா வுலகம் புகல்
மந்நுயி ரோம்பி யருளாள்வர் கில்லென்ப தந்நுயி ரஞ்சும் விநை
நல்லாற்றா நாடி யருளாள்கப் பல்லாற்றாற் றேறிநு மஃதே துணை
அல்லல் அருளாள்வார்க் கில்லை வளிவழங்கு மல்லன்மா ஞாலங் கரி
பொருணீங்கிப் பொய்ச்சாந்தா ரென்ப ரருணீங்கி யல்லவை செய்தொளுகு வார்
பொருளற்றாற் பூப்ப ரொருகால் அருளற்றா ராற்றா மற் றாறற் லரிது
அருட்செல்வஞ் செல்வத்துட் செல்வம் பொருட்செல்வம் பூரியார் கண்ணு முள
வலியார்முற் றந்நை நிநைக்கதான் றன்னின் மெலியார்மேற் செல்லு மிடத்து
தெருளாதான் மெய்ப்பொருள் கண்டற்றாற் றேறின் னருளாதான் செய்யு மறம்
அருளிலார்க் கவ்வுலக மில்லை பொருளிலார்க் கிவ்வுலக மில்லாகி யாங்கு</Unicode>
      </TextEquiv>
