    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,87 2790,87 2790,397 0,397"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1251; numeral=௧">
        <Coords points="0,87 2790,87 2790,118 0,118"/>
        <Baseline points="0,112 2790,112"/>
        <TextEquiv>
          <Unicode>காமக் கணிச்சி யுடைக்கு மரிவெந்நும் நானுத்தாள  வீழ்த்த       கதவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1252; numeral=௨">
        <Coords points="0,118 2790,118 2790,149 0,149"/>
        <Baseline points="0,143 2790,143"/>
        <TextEquiv>
          <Unicode>காமமெ ந் வொன்றெ  கண்ணின் றெ நெஞ்சத்தை யாமத்தை மாளுந் தொழில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1253; numeral=௩">
        <Coords points="0,149 2790,149 2790,180 0,180"/>
        <Baseline points="0,174 2790,174"/>
        <TextEquiv>
          <Unicode>மறப்பென் றொ மத்தை யானொ  குறிப்பின்றித் தும்மல் போற்றேன்றிவிடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1254; numeral=௪">
        <Coords points="0,180 2790,180 2790,211 0,211"/>
        <Baseline points="0,205 2790,205"/>
        <TextEquiv>
          <Unicode>நிறையுடையெனென் பெனமன்னி யானொ வென்காமம் மறையிறந்து மன்று     படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1256; numeral=௫">
        <Coords points="0,211 2790,211 2790,242 0,242"/>
        <Baseline points="0,236 2790,236"/>
        <TextEquiv>
          <Unicode>செற்றவர் பின் சோல் வேண்டி யளித்தரொ வெற்றெ நநையுற்ற துயர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1255; numeral=௬">
        <Coords points="0,242 2790,242 2790,273 0,273"/>
        <Baseline points="0,267 2790,267"/>
        <TextEquiv>
          <Unicode>செற்றார்பின்  செல்லாப் பெருந்தகமை காமநோயுற்றாரறிவ தொன்றுண்டு றன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1260; numeral=௭">
        <Coords points="0,273 2790,273 2790,304 0,304"/>
        <Baseline points="0,299 2790,299"/>
        <TextEquiv>
          <Unicode>நிண்நதீயிலிட்டந்ந  நெஞ்சிநாற்குண்டொ புணர்ந்தூடி றெபொமெநல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1257; numeral=௮">
        <Coords points="0,304 2790,304 2790,335 0,335"/>
        <Baseline points="0,330 2790,330"/>
        <TextEquiv>
          <Unicode>நாணெந் வொன் றெவறியலங் காமத்தாற் பேணியார் பெட்பச்      செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1259; numeral=௯">
        <Coords points="0,335 2790,335 2790,366 0,366"/>
        <Baseline points="0,361 2790,361"/>
        <TextEquiv>
          <Unicode>புலப்ப லெநச்சென் றென்  புல்லி நெநெஞ்சங் கலக்க  லூறுவது      கண்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1258; numeral=௰">
        <Coords points="0,366 2790,366 2790,397 0,397"/>
        <Baseline points="0,392 2790,392"/>
        <TextEquiv>
          <Unicode>பன்மாயக் கள்வன் பநிமொழி யன்றெ நம் பெண்மை யுடைக்கும் படை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>காமக் கணிச்சி யுடைக்கு மரிவெந்நும் நானுத்தாள  வீழ்த்த       கதவு
காமமெ ந் வொன்றெ  கண்ணின் றெ நெஞ்சத்தை யாமத்தை மாளுந் தொழில்
மறப்பென் றொ மத்தை யானொ  குறிப்பின்றித் தும்மல் போற்றேன்றிவிடும்
நிறையுடையெனென் பெனமன்னி யானொ வென்காமம் மறையிறந்து மன்று     படும்
செற்றவர் பின் சோல் வேண்டி யளித்தரொ வெற்றெ நநையுற்ற துயர்
செற்றார்பின்  செல்லாப் பெருந்தகமை காமநோயுற்றாரறிவ தொன்றுண்டு றன்று
நிண்நதீயிலிட்டந்ந  நெஞ்சிநாற்குண்டொ புணர்ந்தூடி றெபொமெநல்
நாணெந் வொன் றெவறியலங் காமத்தாற் பேணியார் பெட்பச்      செயின்
புலப்ப லெநச்சென் றென்  புல்லி நெநெஞ்சங் கலக்க  லூறுவது      கண்டு
பன்மாயக் கள்வன் பநிமொழி யன்றெ நம் பெண்மை யுடைக்கும் படை</Unicode>
      </TextEquiv>
