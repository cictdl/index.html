    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,77 2687,77 2687,436 0,436"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=643; numeral=௧">
        <Coords points="0,77 2687,77 2687,113 0,113"/>
        <Baseline points="0,107 2687,107"/>
        <TextEquiv>
          <Unicode>கேட்டார் பிணிக்குந் தகையவாக கேழாரும் வேட்ப மொழிவதாஞ் சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=644; numeral=௨">
        <Coords points="0,113 2687,113 2687,149 0,149"/>
        <Baseline points="0,143 2687,143"/>
        <TextEquiv>
          <Unicode>திறனறிந்து சொல்லுக சொல்லை யறனும் பொருளும் தநிநூங்கில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=641; numeral=௩">
        <Coords points="0,149 2687,149 2687,185 0,185"/>
        <Baseline points="0,178 2687,178"/>
        <TextEquiv>
          <Unicode>நாநலமெ ந்நும் நலனுடமை யந்நலம் யாநலத்துள்ளது மன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=645; numeral=௪">
        <Coords points="0,185 2687,185 2687,221 0,221"/>
        <Baseline points="0,214 2687,214"/>
        <TextEquiv>
          <Unicode>சொல்லுக சொல்லைப் பிறிதோரா லச்சொல்லை வெல்லுஞ்சொல் வன்மை யறிந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=649; numeral=௫">
        <Coords points="0,221 2687,221 2687,257 0,257"/>
        <Baseline points="0,250 2687,250"/>
        <TextEquiv>
          <Unicode>பலசொல்லக் காமுறுவர் மன்றமா சற்ற சிலசொல்லல் றேற்றா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=650; numeral=௬">
        <Coords points="0,257 2687,257 2687,293 0,293"/>
        <Baseline points="0,286 2687,286"/>
        <TextEquiv>
          <Unicode>இணருழ்த்துநாறா மலரநையர் கற்றது ணர விரித்துரையா தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=648; numeral=௭">
        <Coords points="0,293 2687,293 2687,328 0,328"/>
        <Baseline points="0,322 2687,322"/>
        <TextEquiv>
          <Unicode>விரைந்து தொழில்கேட்கும் ஞாலம் நிரைந்திநிது சொல்லுதல் வல்லார்ப் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=647; numeral=௮">
        <Coords points="0,328 2687,328 2687,364 0,364"/>
        <Baseline points="0,358 2687,358"/>
        <TextEquiv>
          <Unicode>சொல்வல்லன்ஞ் சோர்விலன ஞ்சான் அவநை யிகல்வெல்ல யார்க்கும ரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=646; numeral=௯">
        <Coords points="0,364 2687,364 2687,400 0,400"/>
        <Baseline points="0,394 2687,394"/>
        <TextEquiv>
          <Unicode>வேட்பத்தான் சொல்லிப் பிறர்சொற் பயன்கோடல் மாக்ஷியின் மாசற்றார் கோள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=642; numeral=௰">
        <Coords points="0,400 2687,400 2687,436 0,436"/>
        <Baseline points="0,430 2687,430"/>
        <TextEquiv>
          <Unicode>ஆக்கமுங் கேடும தநால் வருதலாற் காத்தோம்பற் சொல்லின்கட் சோர்வு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>கேட்டார் பிணிக்குந் தகையவாக கேழாரும் வேட்ப மொழிவதாஞ் சொல்
திறனறிந்து சொல்லுக சொல்லை யறனும் பொருளும் தநிநூங்கில்
நாநலமெ ந்நும் நலனுடமை யந்நலம் யாநலத்துள்ளது மன்று
சொல்லுக சொல்லைப் பிறிதோரா லச்சொல்லை வெல்லுஞ்சொல் வன்மை யறிந்து
பலசொல்லக் காமுறுவர் மன்றமா சற்ற சிலசொல்லல் றேற்றா தவர்
இணருழ்த்துநாறா மலரநையர் கற்றது ணர விரித்துரையா தார்
விரைந்து தொழில்கேட்கும் ஞாலம் நிரைந்திநிது சொல்லுதல் வல்லார்ப் பெறின்
சொல்வல்லன்ஞ் சோர்விலன ஞ்சான் அவநை யிகல்வெல்ல யார்க்கும ரிது
வேட்பத்தான் சொல்லிப் பிறர்சொற் பயன்கோடல் மாக்ஷியின் மாசற்றார் கோள்
ஆக்கமுங் கேடும தநால் வருதலாற் காத்தோம்பற் சொல்லின்கட் சோர்வு</Unicode>
      </TextEquiv>
    </TextRegion>
