    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,46 2870,46 2870,367 0,367"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=11; numeral=௧">
        <Coords points="0,46 2870,46 2870,78 0,78"/>
        <Baseline points="0,73 2870,73"/>
        <TextEquiv>
          <Unicode>வானின்றுலகம் வழங்கி வருதலாற் றானமுர்த மென்று ணுரப் பாற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=12; numeral=௨">
        <Coords points="0,78 2870,78 2870,110 0,110"/>
        <Baseline points="0,105 2870,105"/>
        <TextEquiv>
          <Unicode>துப்பார்க்குத் துப்பாய துப்பாக்கித் துப்பார்க்குத் துப்பாய தூஉம் மழை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=13; numeral=௩">
        <Coords points="0,110 2870,110 2870,142 0,142"/>
        <Baseline points="0,137 2870,137"/>
        <TextEquiv>
          <Unicode>விண்ணின்று பொய்ப்பின் விரிநீர் வியநுலகத் துண்ணின் றுடற்றும்பசி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=14; numeral=௪">
        <Coords points="0,142 2870,142 2870,174 0,174"/>
        <Baseline points="0,169 2870,169"/>
        <TextEquiv>
          <Unicode>ஏரி னுழாஅ ருழவர் புயலெந்நும் வாரி வளங்குன்றியக்கால்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=15; numeral=௫">
        <Coords points="0,174 2870,174 2870,207 0,207"/>
        <Baseline points="0,201 2870,201"/>
        <TextEquiv>
          <Unicode>கெடுப்பதூஉங் கெட்டார்க்குச் சார்வாய்மற் றாங் கெப்பதூஉ மெல்லாமழை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=16; numeral=௬">
        <Coords points="0,207 2870,207 2870,239 0,239"/>
        <Baseline points="0,233 2870,233"/>
        <TextEquiv>
          <Unicode>விசும்பிற் றுளிவீழி னல்லான்மற் றாங்கே பசும்புற் றலைகாண்பரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=17; numeral=௭">
        <Coords points="0,239 2870,239 2870,271 0,271"/>
        <Baseline points="0,265 2870,265"/>
        <TextEquiv>
          <Unicode>நெடுங்கடலுந் தன்னீர்மை குன்றுந் தடிந்தெழிலி தானல்கா தாகி விடின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=18; numeral=௮">
        <Coords points="0,271 2870,271 2870,303 0,303"/>
        <Baseline points="0,297 2870,297"/>
        <TextEquiv>
          <Unicode>சிறப்பொடு பூசநை செல்லாது வாநம் வறக்குமேல் வானோர்க்கு மீண்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=19; numeral=௯">
        <Coords points="0,303 2870,303 2870,335 0,335"/>
        <Baseline points="0,329 2870,329"/>
        <TextEquiv>
          <Unicode>தாநம் தவமிரண்டுந் தங்கா வியநுலகம் வாநம் வழங்கா தெநின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=20; numeral=௰">
        <Coords points="0,335 2870,335 2870,367 0,367"/>
        <Baseline points="0,361 2870,361"/>
        <TextEquiv>
          <Unicode>நீரின் றமையா துலகெனின் யார்யார்க்கும் வாநின் றமையா தொளுக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>வானின்றுலகம் வழங்கி வருதலாற் றானமுர்த மென்று ணுரப் பாற்று
துப்பார்க்குத் துப்பாய துப்பாக்கித் துப்பார்க்குத் துப்பாய தூஉம் மழை
விண்ணின்று பொய்ப்பின் விரிநீர் வியநுலகத் துண்ணின் றுடற்றும்பசி
ஏரி னுழாஅ ருழவர் புயலெந்நும் வாரி வளங்குன்றியக்கால்
கெடுப்பதூஉங் கெட்டார்க்குச் சார்வாய்மற் றாங் கெப்பதூஉ மெல்லாமழை
விசும்பிற் றுளிவீழி னல்லான்மற் றாங்கே பசும்புற் றலைகாண்பரிது
நெடுங்கடலுந் தன்னீர்மை குன்றுந் தடிந்தெழிலி தானல்கா தாகி விடின்
சிறப்பொடு பூசநை செல்லாது வாநம் வறக்குமேல் வானோர்க்கு மீண்டு
தாநம் தவமிரண்டுந் தங்கா வியநுலகம் வாநம் வழங்கா தெநின்
நீரின் றமையா துலகெனின் யார்யார்க்கும் வாநின் றமையா தொளுக்கு</Unicode>
      </TextEquiv>
    </TextRegion>
