    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,83 2874,83 2874,465 0,465"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=791; numeral=௧">
        <Coords points="0,83 2874,83 2874,121 0,121"/>
        <Baseline points="0,114 2874,114"/>
        <TextEquiv>
          <Unicode>நாடாது நட் டலிற் கேடில்லை நட்டபின் வீடில்லை நட்பாள் பவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=792; numeral=௨">
        <Coords points="0,121 2874,121 2874,159 0,159"/>
        <Baseline points="0,152 2874,152"/>
        <TextEquiv>
          <Unicode>ஆய்ந்தாய்ந்து கொள்ளாதான் கேண்மை கடைமுறை தாஞ்சாந் துயரந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=793; numeral=௩">
        <Coords points="0,159 2874,159 2874,197 0,197"/>
        <Baseline points="0,191 2874,191"/>
        <TextEquiv>
          <Unicode>குணநுங் குடிமையுங் குற்றமுண்ங் குன்றா விணநும றிந்தியாக்க நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=794; numeral=௪">
        <Coords points="0,197 2874,197 2874,236 0,236"/>
        <Baseline points="0,229 2874,229"/>
        <TextEquiv>
          <Unicode>குடிப்பிறந்து தன்கண் பழிநாணு வாநைக் கொடுத்துங் கொளல்வேண்டும் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=795; numeral=௫">
        <Coords points="0,236 2874,236 2874,274 0,274"/>
        <Baseline points="0,267 2874,267"/>
        <TextEquiv>
          <Unicode>அழச்சொல்லி யல்லதி டித்து வழக்கறிய வல்லார்நடபா ய்ந்து கொளல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=796; numeral=௬">
        <Coords points="0,274 2874,274 2874,312 0,312"/>
        <Baseline points="0,305 2874,305"/>
        <TextEquiv>
          <Unicode>கேட்டிநுமு ண்டொ ரி றுதி கிளைஞ்ஞரை நீட்டி யளப்பதோர் கோல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=797; numeral=௭">
        <Coords points="0,312 2874,312 2874,350 0,350"/>
        <Baseline points="0,343 2874,343"/>
        <TextEquiv>
          <Unicode>ஊதியமெ ன்பதொ ருவற்குப் பேதையார் கேண்மை யொரீஇ விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=798; numeral=௮">
        <Coords points="0,350 2874,350 2874,388 0,388"/>
        <Baseline points="0,382 2874,382"/>
        <TextEquiv>
          <Unicode>உள்ளற்க உள்ளஞ் சிறுகுப கொள்ளற்க வல்லற்கணா ற்றறுப்பார் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=799; numeral=௯">
        <Coords points="0,388 2874,388 2874,427 0,427"/>
        <Baseline points="0,420 2874,420"/>
        <TextEquiv>
          <Unicode>கெடுங்காலை கைவிடுவார் கேண்மை யடுங்காலை யுள்ளிநுமு ள்ளிளஞ் சுடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=800; numeral=௰">
        <Coords points="0,427 2874,427 2874,465 0,465"/>
        <Baseline points="0,458 2874,458"/>
        <TextEquiv>
          <Unicode>மருவுக மாசற்றா கேண்மையொன் றீயந்துமொ ருவுக வொப்பிலார் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>நாடாது நட் டலிற் கேடில்லை நட்டபின் வீடில்லை நட்பாள் பவர்க்கு
ஆய்ந்தாய்ந்து கொள்ளாதான் கேண்மை கடைமுறை தாஞ்சாந் துயரந் தரும்
குணநுங் குடிமையுங் குற்றமுண்ங் குன்றா விணநும றிந்தியாக்க நட்பு
குடிப்பிறந்து தன்கண் பழிநாணு வாநைக் கொடுத்துங் கொளல்வேண்டும் நட்பு
அழச்சொல்லி யல்லதி டித்து வழக்கறிய வல்லார்நடபா ய்ந்து கொளல்
கேட்டிநுமு ண்டொ ரி றுதி கிளைஞ்ஞரை நீட்டி யளப்பதோர் கோல்
ஊதியமெ ன்பதொ ருவற்குப் பேதையார் கேண்மை யொரீஇ விடல்
உள்ளற்க உள்ளஞ் சிறுகுப கொள்ளற்க வல்லற்கணா ற்றறுப்பார் நட்பு
கெடுங்காலை கைவிடுவார் கேண்மை யடுங்காலை யுள்ளிநுமு ள்ளிளஞ் சுடும்
மருவுக மாசற்றா கேண்மையொன் றீயந்துமொ ருவுக வொப்பிலார் நட்பு</Unicode>
      </TextEquiv>
