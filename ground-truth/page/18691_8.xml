    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,84 2795,84 2795,458 0,458"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=51; numeral=௧">
        <Coords points="0,84 2795,84 2795,121 0,121"/>
        <Baseline points="0,115 2795,115"/>
        <TextEquiv>
          <Unicode>மநைத்தக்க மாண்புடைய ளாகித்தற் கொண்டான் வளத்தக்காள் வாழ்க்கைத்துணை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=52; numeral=௨">
        <Coords points="0,121 2795,121 2795,159 0,159"/>
        <Baseline points="0,152 2795,152"/>
        <TextEquiv>
          <Unicode>மநைமாக்ஷி யில்லாள் கண்ணில்லாயின் வாழ்க்கை யெநைமாக்ஷி த் தாயிநுமில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=53; numeral=௩">
        <Coords points="0,159 2795,159 2795,196 0,196"/>
        <Baseline points="0,189 2795,189"/>
        <TextEquiv>
          <Unicode>இல்லதெ னில்லவண் மாண்பானா லுள்ளதே னில்லவன் மாணாக்கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=54; numeral=௪">
        <Coords points="0,196 2795,196 2795,234 0,234"/>
        <Baseline points="0,227 2795,227"/>
        <TextEquiv>
          <Unicode>பெண்ணிற் பெருந்தக்க யாவுள கற்பெந்நுந் திண்மையுண் டாகப் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=55; numeral=௫">
        <Coords points="0,234 2795,234 2795,271 0,271"/>
        <Baseline points="0,264 2795,264"/>
        <TextEquiv>
          <Unicode>தெய்வந் தொழாஅள் கொழுநற் றொழுதெழுவாள் பெய்யெந்நப் பெய்யுமழை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=56; numeral=௬">
        <Coords points="0,271 2795,271 2795,308 0,308"/>
        <Baseline points="0,302 2795,302"/>
        <TextEquiv>
          <Unicode>தற்காத்துத் தற்கொண்டார் பேணித் தகைசான்ற சொற்காத்துச் சோர்விலாள்பெண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=57; numeral=௭">
        <Coords points="0,308 2795,308 2795,346 0,346"/>
        <Baseline points="0,339 2795,339"/>
        <TextEquiv>
          <Unicode>சிறைகாக்குங் காப்பெவன் செய்யு மகழீர் நிறைகாக்குங் காப்பேதலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=58; numeral=௮">
        <Coords points="0,346 2795,346 2795,383 0,383"/>
        <Baseline points="0,376 2795,376"/>
        <TextEquiv>
          <Unicode>பெற்றார்ப் பெறிற்பெறுவர் பெண்டீர் பெருஞ்சிறப்புப் புத்தேளீர் வாழுமுலகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=59; numeral=௯">
        <Coords points="0,383 2795,383 2795,421 0,421"/>
        <Baseline points="0,414 2795,414"/>
        <TextEquiv>
          <Unicode>புகள்புரிந் தில்லில்லோக் கில்லை யிகழ்வார்முன் னேறுபோற் பீடு நடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=60; numeral=௰">
        <Coords points="0,421 2795,421 2795,458 0,458"/>
        <Baseline points="0,451 2795,451"/>
        <TextEquiv>
          <Unicode>மங்கல மென்ப மனைமாக்ஷி மற்றதனன்கலம் நன்மக்கட்பேறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>மநைத்தக்க மாண்புடைய ளாகித்தற் கொண்டான் வளத்தக்காள் வாழ்க்கைத்துணை
மநைமாக்ஷி யில்லாள் கண்ணில்லாயின் வாழ்க்கை யெநைமாக்ஷி த் தாயிநுமில்
இல்லதெ னில்லவண் மாண்பானா லுள்ளதே னில்லவன் மாணாக்கடை
பெண்ணிற் பெருந்தக்க யாவுள கற்பெந்நுந் திண்மையுண் டாகப் பெறின்
தெய்வந் தொழாஅள் கொழுநற் றொழுதெழுவாள் பெய்யெந்நப் பெய்யுமழை
தற்காத்துத் தற்கொண்டார் பேணித் தகைசான்ற சொற்காத்துச் சோர்விலாள்பெண்
சிறைகாக்குங் காப்பெவன் செய்யு மகழீர் நிறைகாக்குங் காப்பேதலை
பெற்றார்ப் பெறிற்பெறுவர் பெண்டீர் பெருஞ்சிறப்புப் புத்தேளீர் வாழுமுலகு
புகள்புரிந் தில்லில்லோக் கில்லை யிகழ்வார்முன் னேறுபோற் பீடு நடை
மங்கல மென்ப மனைமாக்ஷி மற்றதனன்கலம் நன்மக்கட்பேறு</Unicode>
      </TextEquiv>
