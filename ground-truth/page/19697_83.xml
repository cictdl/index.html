    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,80 2896,80 2896,457 0,457"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=810; numeral=௧">
        <Coords points="0,80 2896,80 2896,118 0,118"/>
        <Baseline points="0,111 2896,111"/>
        <TextEquiv>
          <Unicode>விழையார் விழையப்படுபவா பழையார்கட் பண்பிற்றலையா தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=809; numeral=௨">
        <Coords points="0,118 2896,118 2896,155 0,155"/>
        <Baseline points="0,148 2896,148"/>
        <TextEquiv>
          <Unicode>கெடாஅ வழிவந்த கேண்மையார் கேண்மை விடார் விழையுமு லகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=802; numeral=௩">
        <Coords points="0,155 2896,155 2896,193 0,193"/>
        <Baseline points="0,186 2896,186"/>
        <TextEquiv>
          <Unicode>நட்பிற்கு றுப்புக் கெழுதகமை மற்றதற்குப்பாதல் சான்றோர்  கடன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=803; numeral=௪">
        <Coords points="0,193 2896,193 2896,231 0,231"/>
        <Baseline points="0,224 2896,224"/>
        <TextEquiv>
          <Unicode>பளகிய நட்பெவன் செய்யுங் கெழுதகைமை செய்யதாங்க மையாக் கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=804; numeral=௫">
        <Coords points="0,231 2896,231 2896,268 0,268"/>
        <Baseline points="0,262 2896,262"/>
        <TextEquiv>
          <Unicode>விழைதகையான் வேண்டி யிருப்பர் கெழுதகையாற் கேழாது நட்டார் செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=808; numeral=௬">
        <Coords points="0,268 2896,268 2896,306 0,306"/>
        <Baseline points="0,299 2896,299"/>
        <TextEquiv>
          <Unicode>கேழிளுக்கங் கேழாக் கெழுதகமை வல்லார்க்கு நாளிழுக்கம் நட்டார் செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=806; numeral=௭">
        <Coords points="0,306 2896,306 2896,344 0,344"/>
        <Baseline points="0,337 2896,337"/>
        <TextEquiv>
          <Unicode>எல்லைக்கண் ணின்றார் துறவார் தொலைவிடத்துத் தொல்லைக்கண் ணின்றார் துடர்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=805; numeral=௮">
        <Coords points="0,344 2896,344 2896,382 0,382"/>
        <Baseline points="0,375 2896,375"/>
        <TextEquiv>
          <Unicode>பேதமை யென்றொ  பெருங்கிழமை யென்றுணர் நோதக்க நட்டார் செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=807; numeral=௯">
        <Coords points="0,382 2896,382 2896,419 0,419"/>
        <Baseline points="0,413 2896,413"/>
        <TextEquiv>
          <Unicode>அழிவந்த செய்யிநு மன்பறாரன்பின் வழிவந்த கேண்மை யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=801; numeral=௰">
        <Coords points="0,419 2896,419 2896,457 0,457"/>
        <Baseline points="0,450 2896,450"/>
        <TextEquiv>
          <Unicode>பழைமை யெநப்படுவதி யாதெநின் யாதுங் கிழமையைக் கீழ்ந்திடா நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>விழையார் விழையப்படுபவா பழையார்கட் பண்பிற்றலையா தார்
கெடாஅ வழிவந்த கேண்மையார் கேண்மை விடார் விழையுமு லகு
நட்பிற்கு றுப்புக் கெழுதகமை மற்றதற்குப்பாதல் சான்றோர்  கடன்
பளகிய நட்பெவன் செய்யுங் கெழுதகைமை செய்யதாங்க மையாக் கடை
விழைதகையான் வேண்டி யிருப்பர் கெழுதகையாற் கேழாது நட்டார் செயின்
கேழிளுக்கங் கேழாக் கெழுதகமை வல்லார்க்கு நாளிழுக்கம் நட்டார் செயின்
எல்லைக்கண் ணின்றார் துறவார் தொலைவிடத்துத் தொல்லைக்கண் ணின்றார் துடர்பு
பேதமை யென்றொ  பெருங்கிழமை யென்றுணர் நோதக்க நட்டார் செயின்
அழிவந்த செய்யிநு மன்பறாரன்பின் வழிவந்த கேண்மை யவர்
பழைமை யெநப்படுவதி யாதெநின் யாதுங் கிழமையைக் கீழ்ந்திடா நட்பு</Unicode>
      </TextEquiv>
