    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,90 2762,90 2762,408 0,408"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1321; numeral=௧">
        <Coords points="0,90 2762,90 2762,122 0,122"/>
        <Baseline points="0,116 2762,116"/>
        <TextEquiv>
          <Unicode>இல்லைத் தவற் வாக்காயினு மூடுதல் வல்லது வாளிக்கு மாறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1322; numeral=௨">
        <Coords points="0,122 2762,122 2762,153 0,153"/>
        <Baseline points="0,148 2762,148"/>
        <TextEquiv>
          <Unicode>ஊடலிற் றோன்று ஞ்சிறுதுனி நல்லளி வாடினும் பாடு பெறும</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1323; numeral=௩">
        <Coords points="0,153 2762,153 2762,185 0,185"/>
        <Baseline points="0,180 2762,180"/>
        <TextEquiv>
          <Unicode>புலத்தலிற் பத்தேணுடுண்டோ நிலத்தொடு நீரியைந் தன்னூர்க த்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1324; numeral=௪">
        <Coords points="0,185 2762,185 2762,217 0,217"/>
        <Baseline points="0,211 2762,211"/>
        <TextEquiv>
          <Unicode>புல்லிவிடாப் புல்வி யுடடோன்றுமெனனுள்ளமுடைக்கும்படை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1325; numeral=௫">
        <Coords points="0,217 2762,217 2762,249 0,249"/>
        <Baseline points="0,243 2762,243"/>
        <TextEquiv>
          <Unicode>தவரிலநாயினுந்தா  மவீழவரா மென்றேள் கறலி னுங் கொன்றுடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1326; numeral=௬">
        <Coords points="0,249 2762,249 2762,281 0,281"/>
        <Baseline points="0,275 2762,275"/>
        <TextEquiv>
          <Unicode>உணலிசநுமுண்டதற்லினிது காமம் புணாதலினூட லிநிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1327; numeral=௭">
        <Coords points="0,281 2762,281 2762,312 0,312"/>
        <Baseline points="0,307 2762,307"/>
        <TextEquiv>
          <Unicode>உளடலிற் றேற்றுவ ரவென்றார்  துமநநுங் கூடலிற் காணப்படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1328; numeral=௮">
        <Coords points="0,312 2762,312 2762,344 0,344"/>
        <Baseline points="0,338 2762,338"/>
        <TextEquiv>
          <Unicode>உளடிப் பெருகுவுங் தொல்லொநு துல்வியாப்பக்  கடலிற றேனறிய      ஷப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1329; numeral=௯">
        <Coords points="0,344 2762,344 2762,376 0,376"/>
        <Baseline points="0,370 2762,370"/>
        <TextEquiv>
          <Unicode>உளடுக மந்நொ வொளியிழை யாமிரப்ப நீடுகு மன்னோ விரர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1330; numeral=௰">
        <Coords points="0,376 2762,376 2762,408 0,408"/>
        <Baseline points="0,402 2762,402"/>
        <TextEquiv>
          <Unicode>உளடுதுல காமத்திற் கின் பமதற் கின்பங் கூடிமுயங்கப்  பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>இல்லைத் தவற் வாக்காயினு மூடுதல் வல்லது வாளிக்கு மாறு
ஊடலிற் றோன்று ஞ்சிறுதுனி நல்லளி வாடினும் பாடு பெறும
புலத்தலிற் பத்தேணுடுண்டோ நிலத்தொடு நீரியைந் தன்னூர்க த்து
புல்லிவிடாப் புல்வி யுடடோன்றுமெனனுள்ளமுடைக்கும்படை
தவரிலநாயினுந்தா  மவீழவரா மென்றேள் கறலி னுங் கொன்றுடைத்து
உணலிசநுமுண்டதற்லினிது காமம் புணாதலினூட லிநிது
உளடலிற் றேற்றுவ ரவென்றார்  துமநநுங் கூடலிற் காணப்படும்
உளடிப் பெருகுவுங் தொல்லொநு துல்வியாப்பக்  கடலிற றேனறிய      ஷப்பு
உளடுக மந்நொ வொளியிழை யாமிரப்ப நீடுகு மன்னோ விரர்
உளடுதுல காமத்திற் கின் பமதற் கின்பங் கூடிமுயங்கப்  பெறின்</Unicode>
      </TextEquiv>
    </TextRegion>
