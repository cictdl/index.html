    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,83 2645,83 2645,437 0,437"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=539; numeral=௧">
        <Coords points="0,83 2645,83 2645,118 0,118"/>
        <Baseline points="0,112 2645,112"/>
        <TextEquiv>
          <Unicode>இகட்சியற் கெட்டாரை யுள்ளுக தாந்தம் மகிட்சியின் மைந்துறும் போழ்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=531; numeral=௨">
        <Coords points="0,118 2645,118 2645,154 0,154"/>
        <Baseline points="0,147 2645,147"/>
        <TextEquiv>
          <Unicode>இறந்த வெகுளியிற் தீதே சிறந்த வுவகை மகிட்சியிற் சோர்வு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=534; numeral=௩">
        <Coords points="0,154 2645,154 2645,189 0,189"/>
        <Baseline points="0,183 2645,183"/>
        <TextEquiv>
          <Unicode>அச்ச முடையார்க்க ரணில்லை யாங்கில்லை பொய்ச்சாப் புடையார்க்கு நன்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=535; numeral=௪">
        <Coords points="0,189 2645,189 2645,224 0,224"/>
        <Baseline points="0,218 2645,218"/>
        <TextEquiv>
          <Unicode>முந்நுறக் காவாதி ழுக்கியான் றன்பிழை பிந்நூறி ரங்கி விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=532; numeral=௫">
        <Coords points="0,224 2645,224 2645,260 0,260"/>
        <Baseline points="0,254 2645,254"/>
        <TextEquiv>
          <Unicode>பொய்ச்சாப்புக் கொல்லும் புகழை யறிவிநை நிச்ச நிரப்புக் கொன் டாங்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=538; numeral=௬">
        <Coords points="0,260 2645,260 2645,295 0,295"/>
        <Baseline points="0,289 2645,289"/>
        <TextEquiv>
          <Unicode>புகழ்ந்தவை போற்றிச் செயவேண்டுஞ் செய்யாதி கழ்ந்தார்க்கெ ழுமையுமில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=533; numeral=௭">
        <Coords points="0,295 2645,295 2645,331 0,331"/>
        <Baseline points="0,324 2645,324"/>
        <TextEquiv>
          <Unicode>பொச்சாப்பார்க்கி ல்லை புகழ்மை யதுவுலகத்தொ ப்பநூலோர்க்குந் துணிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=536; numeral=௮">
        <Coords points="0,331 2645,331 2645,366 0,366"/>
        <Baseline points="0,360 2645,360"/>
        <TextEquiv>
          <Unicode>இழுக்காமை யார்மாட்டுமெ ன்றும் வழுக்காமை வாயின ஃகுதொப் பதில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=540; numeral=௯">
        <Coords points="0,366 2645,366 2645,402 0,402"/>
        <Baseline points="0,395 2645,395"/>
        <TextEquiv>
          <Unicode>உள்ளியதெ ய்தலெ ழிதுமந மற்றுந்தாநு ள்ளியது ள்ளப் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=537; numeral=௰">
        <Coords points="0,402 2645,402 2645,437 0,437"/>
        <Baseline points="0,431 2645,431"/>
        <TextEquiv>
          <Unicode>அரியவென்றா காத்தி ல்லைபொச் சாவாக் கருவியாற் போற்றிச் செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>இகட்சியற் கெட்டாரை யுள்ளுக தாந்தம் மகிட்சியின் மைந்துறும் போழ்து
இறந்த வெகுளியிற் தீதே சிறந்த வுவகை மகிட்சியிற் சோர்வு
அச்ச முடையார்க்க ரணில்லை யாங்கில்லை பொய்ச்சாப் புடையார்க்கு நன்கு
முந்நுறக் காவாதி ழுக்கியான் றன்பிழை பிந்நூறி ரங்கி விடும்
பொய்ச்சாப்புக் கொல்லும் புகழை யறிவிநை நிச்ச நிரப்புக் கொன் டாங்கு
புகழ்ந்தவை போற்றிச் செயவேண்டுஞ் செய்யாதி கழ்ந்தார்க்கெ ழுமையுமில்
பொச்சாப்பார்க்கி ல்லை புகழ்மை யதுவுலகத்தொ ப்பநூலோர்க்குந் துணிவு
இழுக்காமை யார்மாட்டுமெ ன்றும் வழுக்காமை வாயின ஃகுதொப் பதில்
உள்ளியதெ ய்தலெ ழிதுமந மற்றுந்தாநு ள்ளியது ள்ளப் பெறின்
அரியவென்றா காத்தி ல்லைபொச் சாவாக் கருவியாற் போற்றிச் செயின்</Unicode>
      </TextEquiv>
    </TextRegion>
