    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,74 2806,74 2806,430 0,430"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=905; numeral=௧">
        <Coords points="0,74 2806,74 2806,109 0,109"/>
        <Baseline points="0,103 2806,103"/>
        <TextEquiv>
          <Unicode>இல்லாழை யஞ்சுவான் ஞசுமற் றெஞ்ஞான்றும் நல்லார்க்கு நல்ல செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=904; numeral=௨">
        <Coords points="0,109 2806,109 2806,145 0,145"/>
        <Baseline points="0,139 2806,139"/>
        <TextEquiv>
          <Unicode>மநையாழை யஞ்சும் மறுமையி லாளன் விநையாண்மை வீறெய்த லின்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=906; numeral=௩">
        <Coords points="0,145 2806,145 2806,181 0,181"/>
        <Baseline points="0,174 2806,174"/>
        <TextEquiv>
          <Unicode>இமையாரிந் வழிநும் பாடிலரெ யில்லாள மையார்தோள ஞ்சு பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=909; numeral=௪">
        <Coords points="0,181 2806,181 2806,216 0,216"/>
        <Baseline points="0,210 2806,210"/>
        <TextEquiv>
          <Unicode>அறவிநையுமாண்ட பொருளும் பிறவிநையும் பெணேவல் செய்வார்கணில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=907; numeral=௫">
        <Coords points="0,216 2806,216 2806,252 0,252"/>
        <Baseline points="0,245 2806,245"/>
        <TextEquiv>
          <Unicode>பெண்ணேவல் செய்தொழுகுமா ண்மையி நாணுடைப் பெண்ணெ பெருமை யுடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=901; numeral=௬">
        <Coords points="0,252 2806,252 2806,287 0,287"/>
        <Baseline points="0,281 2806,281"/>
        <TextEquiv>
          <Unicode>மநைவிழையார் மாண்பயமெ ய்தார் விநைவிழைவார் வேண்டாப் பொருளுமது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=902; numeral=௭">
        <Coords points="0,287 2806,287 2806,323 0,323"/>
        <Baseline points="0,316 2806,316"/>
        <TextEquiv>
          <Unicode>பேணாது பெண்விழைவாநாக்கம் பெரியதோர் நாணாக நாணுத் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=908; numeral=௮">
        <Coords points="0,323 2806,323 2806,358 0,358"/>
        <Baseline points="0,352 2806,352"/>
        <TextEquiv>
          <Unicode>நட்டார் குறைமுடியார் நன்றாற்றார் நந்நுதலார் பெட் டாங்கொழுகு பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=903; numeral=௯">
        <Coords points="0,358 2806,358 2806,394 0,394"/>
        <Baseline points="0,388 2806,388"/>
        <TextEquiv>
          <Unicode>இல்லாழ்கட்டா ழ்ந்த வியல்பின்மை யெஞ்ஞான்றும் நல்லாருண்ணாணுத் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=910; numeral=௰">
        <Coords points="0,394 2806,394 2806,430 0,430"/>
        <Baseline points="0,423 2806,423"/>
        <TextEquiv>
          <Unicode>எண்சேர்ந்த நெஞ்சத் திடநுடையாற் கெஞ்ஞான்றும் பெண்சேர்ந்தாம் பேதைமை யில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>இல்லாழை யஞ்சுவான் ஞசுமற் றெஞ்ஞான்றும் நல்லார்க்கு நல்ல செயல்
மநையாழை யஞ்சும் மறுமையி லாளன் விநையாண்மை வீறெய்த லின்று
இமையாரிந் வழிநும் பாடிலரெ யில்லாள மையார்தோள ஞ்சு பவர்
அறவிநையுமாண்ட பொருளும் பிறவிநையும் பெணேவல் செய்வார்கணில்
பெண்ணேவல் செய்தொழுகுமா ண்மையி நாணுடைப் பெண்ணெ பெருமை யுடைத்து
மநைவிழையார் மாண்பயமெ ய்தார் விநைவிழைவார் வேண்டாப் பொருளுமது
பேணாது பெண்விழைவாநாக்கம் பெரியதோர் நாணாக நாணுத் தரும்
நட்டார் குறைமுடியார் நன்றாற்றார் நந்நுதலார் பெட் டாங்கொழுகு பவர்
இல்லாழ்கட்டா ழ்ந்த வியல்பின்மை யெஞ்ஞான்றும் நல்லாருண்ணாணுத் தரும்
எண்சேர்ந்த நெஞ்சத் திடநுடையாற் கெஞ்ஞான்றும் பெண்சேர்ந்தாம் பேதைமை யில்</Unicode>
      </TextEquiv>
    </TextRegion>
