    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,91 2960,91 2960,454 0,454"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1202; numeral=௧">
        <Coords points="0,91 2960,91 2960,127 0,127"/>
        <Baseline points="0,120 2960,120"/>
        <TextEquiv>
          <Unicode>எநைத்தொன றிநிதெகாண் காமந்தாம் வீழ்வார் நிநைப்ப வருவதொன்றில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1203; numeral=௨">
        <Coords points="0,127 2960,127 2960,163 0,163"/>
        <Baseline points="0,157 2960,157"/>
        <TextEquiv>
          <Unicode>நிநைப்பது  பொன்று நிநையார் கொறும்மல் சிநைப்பது போன்று கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1208; numeral=௩">
        <Coords points="0,163 2960,163 2960,200 0,200"/>
        <Baseline points="0,193 2960,193"/>
        <TextEquiv>
          <Unicode>எநைத்து நிநைப்பினுங் காயாரநைத்தன்றொ  காதலர் செய்யுஞ் சிறப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1201; numeral=௪">
        <Coords points="0,200 2960,200 2960,236 0,236"/>
        <Baseline points="0,229 2960,229"/>
        <TextEquiv>
          <Unicode>உள்ளிநுந்தீராப் பெருமகிழ் செய்தலாற் கள்ளிநுங் காமம்   நிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1207; numeral=௫">
        <Coords points="0,236 2960,236 2960,272 0,272"/>
        <Baseline points="0,266 2960,266"/>
        <TextEquiv>
          <Unicode>மறப்பி நெவனாவன் மற்கொ மறப்பறியெ னுள்ளினு முள்ளஞ்சுடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1209; numeral=௬">
        <Coords points="0,272 2960,272 2960,308 0,308"/>
        <Baseline points="0,302 2960,302"/>
        <TextEquiv>
          <Unicode>விழியுமெநிந் நுயிர் வேறல்லவென்பா ரழியின்மை யாற்று நினர ந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1204; numeral=௭">
        <Coords points="0,308 2960,308 2960,345 0,345"/>
        <Baseline points="0,338 2960,338"/>
        <TextEquiv>
          <Unicode>யாமு முளொங்கொல்வர் நெஞ்சத் தெந்நெஞ்சத்தெ ஏவுள் ரெய வர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1205; numeral=௮">
        <Coords points="0,345 2960,345 2960,381 0,381"/>
        <Baseline points="0,374 2960,374"/>
        <TextEquiv>
          <Unicode>தந்நெஞ்சத் தெம்மைக் கடிகொண்டார் நாணார்கொல்லெந் நெஞ்சத்த தோவா வரல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1206; numeral=௯">
        <Coords points="0,381 2960,381 2960,417 0,417"/>
        <Baseline points="0,411 2960,411"/>
        <TextEquiv>
          <Unicode>மற்றியா நென்னுளென் மந்நொவ் வரோடி யான் னுற்றநாளுள்ள வுளேன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1210; numeral=௰">
        <Coords points="0,417 2960,417 2960,454 0,454"/>
        <Baseline points="0,447 2960,447"/>
        <TextEquiv>
          <Unicode>விடாது சென்றானாக் கண்ணினா காணப் படாதி வாழி மதி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>எநைத்தொன றிநிதெகாண் காமந்தாம் வீழ்வார் நிநைப்ப வருவதொன்றில்
நிநைப்பது  பொன்று நிநையார் கொறும்மல் சிநைப்பது போன்று கெடும்
எநைத்து நிநைப்பினுங் காயாரநைத்தன்றொ  காதலர் செய்யுஞ் சிறப்பு
உள்ளிநுந்தீராப் பெருமகிழ் செய்தலாற் கள்ளிநுங் காமம்   நிது
மறப்பி நெவனாவன் மற்கொ மறப்பறியெ னுள்ளினு முள்ளஞ்சுடும்
விழியுமெநிந் நுயிர் வேறல்லவென்பா ரழியின்மை யாற்று நினர ந்து
யாமு முளொங்கொல்வர் நெஞ்சத் தெந்நெஞ்சத்தெ ஏவுள் ரெய வர்
தந்நெஞ்சத் தெம்மைக் கடிகொண்டார் நாணார்கொல்லெந் நெஞ்சத்த தோவா வரல்
மற்றியா நென்னுளென் மந்நொவ் வரோடி யான் னுற்றநாளுள்ள வுளேன்
விடாது சென்றானாக் கண்ணினா காணப் படாதி வாழி மதி</Unicode>
      </TextEquiv>
