    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,103 2831,103 2831,432 0,432"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1141; numeral=௧">
        <Coords points="0,103 2831,103 2831,136 0,136"/>
        <Baseline points="0,130 2831,130"/>
        <TextEquiv>
          <Unicode>அலரெழ வாருயிர் நிற்கும தநைப் பலாறியார் பாக்கியத் தால்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1144; numeral=௨">
        <Coords points="0,136 2831,136 2831,169 0,169"/>
        <Baseline points="0,163 2831,163"/>
        <TextEquiv>
          <Unicode>கெள்வையாற் கவ்விது காமம துவின்றேற்ற வ்வெந்நுந் தண்மை யிழந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1143; numeral=௩">
        <Coords points="0,169 2831,169 2831,202 0,202"/>
        <Baseline points="0,196 2831,196"/>
        <TextEquiv>
          <Unicode>உறாதொ வூறிந்தக் கெளவை யதநைப் பெறாது பெற்றன்ன நீத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1142; numeral=௪">
        <Coords points="0,202 2831,202 2831,235 0,235"/>
        <Baseline points="0,229 2831,229"/>
        <TextEquiv>
          <Unicode>மலரந்ந கண்ணாள் ரிமை யறியார் அலரெமக்கியந்ததிவ் வூர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1145; numeral=௫">
        <Coords points="0,235 2831,235 2831,268 0,268"/>
        <Baseline points="0,262 2831,262"/>
        <TextEquiv>
          <Unicode>களித்தோறுங் கள்ளுண்டல் வேட்டத்தாற் காமம் வெளிப்படுந் தோறுமி ளிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1149; numeral=௬">
        <Coords points="0,268 2831,268 2831,301 0,301"/>
        <Baseline points="0,295 2831,295"/>
        <TextEquiv>
          <Unicode>அலர்நாண வெல்வதோர் வஞ்சலோம்பெ ன்றார் பலநாண நீத்தக் கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1146; numeral=௭">
        <Coords points="0,301 2831,301 2831,334 0,334"/>
        <Baseline points="0,328 2831,328"/>
        <TextEquiv>
          <Unicode>கண்டது மன்னுமொ ருநாள லமன்னுந் திங்கழைப் பாம்புகொண் டற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1150; numeral=௮">
        <Coords points="0,334 2831,334 2831,367 0,367"/>
        <Baseline points="0,361 2831,361"/>
        <TextEquiv>
          <Unicode>தாம்வேண்ட் நல்குவர் காதலர் யாம்வேண்டுங் கெளவை யெடுக்குமி வ் வூர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1147; numeral=௯">
        <Coords points="0,367 2831,367 2831,400 0,400"/>
        <Baseline points="0,394 2831,394"/>
        <TextEquiv>
          <Unicode>ஊரவர் கெளவை யெருவாக வந்நைசொல் நீராக நீளுமிந் நோய்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1148; numeral=௰">
        <Coords points="0,400 2831,400 2831,432 0,432"/>
        <Baseline points="0,426 2831,426"/>
        <TextEquiv>
          <Unicode>நெய்யாலெ ரிநுதுயப்பொமெ ன்றற்றாற் கெளவையாற்  காமந் துயப்பொமெ நல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அலரெழ வாருயிர் நிற்கும தநைப் பலாறியார் பாக்கியத் தால்
கெள்வையாற் கவ்விது காமம துவின்றேற்ற வ்வெந்நுந் தண்மை யிழந்து
உறாதொ வூறிந்தக் கெளவை யதநைப் பெறாது பெற்றன்ன நீத்து
மலரந்ந கண்ணாள் ரிமை யறியார் அலரெமக்கியந்ததிவ் வூர்
களித்தோறுங் கள்ளுண்டல் வேட்டத்தாற் காமம் வெளிப்படுந் தோறுமி ளிது
அலர்நாண வெல்வதோர் வஞ்சலோம்பெ ன்றார் பலநாண நீத்தக் கடை
கண்டது மன்னுமொ ருநாள லமன்னுந் திங்கழைப் பாம்புகொண் டற்று
தாம்வேண்ட் நல்குவர் காதலர் யாம்வேண்டுங் கெளவை யெடுக்குமி வ் வூர்
ஊரவர் கெளவை யெருவாக வந்நைசொல் நீராக நீளுமிந் நோய்
நெய்யாலெ ரிநுதுயப்பொமெ ன்றற்றாற் கெளவையாற்  காமந் துயப்பொமெ நல்</Unicode>
      </TextEquiv>
    </TextRegion>
