    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,95 2830,95 2830,484 0,484"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=423; numeral=௧">
        <Coords points="0,95 2830,95 2830,134 0,134"/>
        <Baseline points="0,127 2830,127"/>
        <TextEquiv>
          <Unicode>அறிவுடையார் வ தறிவார றிவிலார் ஃதறி கல்லா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=425; numeral=௨">
        <Coords points="0,134 2830,134 2830,173 0,173"/>
        <Baseline points="0,166 2830,166"/>
        <TextEquiv>
          <Unicode>உலகந் தழீஇ தொட்ப மலர்தலுங் கூம்பலுமி ல்லர் தறிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=426; numeral=௩">
        <Coords points="0,173 2830,173 2830,212 0,212"/>
        <Baseline points="0,205 2830,205"/>
        <TextEquiv>
          <Unicode>எவ்வ துறைவது லகமு லகத்தோட வ்வ துறைவ தறிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=424; numeral=௪">
        <Coords points="0,212 2830,212 2830,251 0,251"/>
        <Baseline points="0,244 2830,244"/>
        <TextEquiv>
          <Unicode>எண்பொருள வாகச் செலச்சொல்லித் தான்பிறர்வாய் நுண்பொருள் காண்ப தறிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=422; numeral=௫">
        <Coords points="0,251 2830,251 2830,290 0,290"/>
        <Baseline points="0,283 2830,283"/>
        <TextEquiv>
          <Unicode>எப்பொருள் யார்யார்வாய் கேட்பிநும ப்பொருள் மெய்ப்பொருள் காண்ப தறிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=421; numeral=௬">
        <Coords points="0,290 2830,290 2830,328 0,328"/>
        <Baseline points="0,321 2830,321"/>
        <TextEquiv>
          <Unicode>சென்ற விடத்தாற் சிலவிடா தீதொரீஇ நன்றின்பாலு யப்ப தறிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=428; numeral=௭">
        <Coords points="0,328 2830,328 2830,367 0,367"/>
        <Baseline points="0,360 2830,360"/>
        <TextEquiv>
          <Unicode>அஞ்சுவ தஞ்சாமை பேதமை யஞ்சுவத ஞ்சல் றிவார் தொழில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=429; numeral=௮">
        <Coords points="0,367 2830,367 2830,406 0,406"/>
        <Baseline points="0,399 2830,399"/>
        <TextEquiv>
          <Unicode>எதிரதாக் கார்க்கும் அறிவிநார்க் கில்லை யதிர வருவதோர் நோய்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=427; numeral=௯">
        <Coords points="0,406 2830,406 2830,445 0,445"/>
        <Baseline points="0,438 2830,438"/>
        <TextEquiv>
          <Unicode>அறிவற்றங் கார்க்குங் கருவி செறிவார்க்குமு ள்ளழிக்க லாகா வரன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=430; numeral=௰">
        <Coords points="0,445 2830,445 2830,484 0,484"/>
        <Baseline points="0,477 2830,477"/>
        <TextEquiv>
          <Unicode>அறிவுடையாரெ ல்லா முடையர் அறிவிலாரெ ந்நுடைய ரேநுமி லர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அறிவுடையார் வ தறிவார றிவிலார் ஃதறி கல்லா தவர்
உலகந் தழீஇ தொட்ப மலர்தலுங் கூம்பலுமி ல்லர் தறிவு
எவ்வ துறைவது லகமு லகத்தோட வ்வ துறைவ தறிவு
எண்பொருள வாகச் செலச்சொல்லித் தான்பிறர்வாய் நுண்பொருள் காண்ப தறிவு
எப்பொருள் யார்யார்வாய் கேட்பிநும ப்பொருள் மெய்ப்பொருள் காண்ப தறிவு
சென்ற விடத்தாற் சிலவிடா தீதொரீஇ நன்றின்பாலு யப்ப தறிவு
அஞ்சுவ தஞ்சாமை பேதமை யஞ்சுவத ஞ்சல் றிவார் தொழில்
எதிரதாக் கார்க்கும் அறிவிநார்க் கில்லை யதிர வருவதோர் நோய்
அறிவற்றங் கார்க்குங் கருவி செறிவார்க்குமு ள்ளழிக்க லாகா வரன்
அறிவுடையாரெ ல்லா முடையர் அறிவிலாரெ ந்நுடைய ரேநுமி லர்</Unicode>
      </TextEquiv>
