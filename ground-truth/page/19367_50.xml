    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,91 2785,91 2785,460 0,460"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=471; numeral=௧">
        <Coords points="0,91 2785,91 2785,128 0,128"/>
        <Baseline points="0,121 2785,121"/>
        <TextEquiv>
          <Unicode>மநவலியுந் தன்வலியு மாற்றான் வலியுந் துணைவலியுந் தூக்கிச் செயன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=473; numeral=௨">
        <Coords points="0,128 2785,128 2785,165 0,165"/>
        <Baseline points="0,158 2785,158"/>
        <TextEquiv>
          <Unicode>உடைத்தம் வலியறியார் ஊக்கத்தினூ க்கி யிடைக்கண் முறிந்தார் பலர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=476; numeral=௩">
        <Coords points="0,165 2785,165 2785,201 0,201"/>
        <Baseline points="0,195 2785,195"/>
        <TextEquiv>
          <Unicode>நுனிக்கொம்பரே றிநார் ஃதிரந் தூக்கினு யிர்க்கிறுதி யாகி விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=474; numeral=௪">
        <Coords points="0,201 2785,201 2785,238 0,238"/>
        <Baseline points="0,232 2785,232"/>
        <TextEquiv>
          <Unicode>அமைந்தாங் கொழுகான் னளவறியான றநநை வியந்தான் விரைந்து கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=475; numeral=௫">
        <Coords points="0,238 2785,238 2785,275 0,275"/>
        <Baseline points="0,269 2785,269"/>
        <TextEquiv>
          <Unicode>பீலிபெய் சாகாடும் ச்சிறும ப்பண்டஞ் சால மிகுத்துப் பெயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=477; numeral=௬">
        <Coords points="0,275 2785,275 2785,312 0,312"/>
        <Baseline points="0,306 2785,306"/>
        <TextEquiv>
          <Unicode>ஆற்றின் ளவறிந்தீ க வதுபொருள் போற்றி வளங்கு நெறி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=480; numeral=௭">
        <Coords points="0,312 2785,312 2785,349 0,349"/>
        <Baseline points="0,343 2785,343"/>
        <TextEquiv>
          <Unicode>உளவரைத் தூக்காத ஒப்புர வாண்மை வளவரை வல்லக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=478; numeral=௮">
        <Coords points="0,349 2785,349 2785,386 0,386"/>
        <Baseline points="0,380 2785,380"/>
        <TextEquiv>
          <Unicode>ஆகாற ளவிட்டித் தாயிநும் கேடில்லை போவாற கலாக் கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=479; numeral=௯">
        <Coords points="0,386 2785,386 2785,423 0,423"/>
        <Baseline points="0,416 2785,416"/>
        <TextEquiv>
          <Unicode>அளவறிந்து வாளாதான் வாடகை யுளபோல வில்லாகித் தோன்றாக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=472; numeral=௰">
        <Coords points="0,423 2785,423 2785,460 0,460"/>
        <Baseline points="0,453 2785,453"/>
        <TextEquiv>
          <Unicode>ஒல்வ தறிவத த்தன்கட்ட ங்கிச் செல்வார்க்குச் செல்லாததில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>மநவலியுந் தன்வலியு மாற்றான் வலியுந் துணைவலியுந் தூக்கிச் செயன்
உடைத்தம் வலியறியார் ஊக்கத்தினூ க்கி யிடைக்கண் முறிந்தார் பலர்
நுனிக்கொம்பரே றிநார் ஃதிரந் தூக்கினு யிர்க்கிறுதி யாகி விடும்
அமைந்தாங் கொழுகான் னளவறியான றநநை வியந்தான் விரைந்து கெடும்
பீலிபெய் சாகாடும் ச்சிறும ப்பண்டஞ் சால மிகுத்துப் பெயின்
ஆற்றின் ளவறிந்தீ க வதுபொருள் போற்றி வளங்கு நெறி
உளவரைத் தூக்காத ஒப்புர வாண்மை வளவரை வல்லக் கெடும்
ஆகாற ளவிட்டித் தாயிநும் கேடில்லை போவாற கலாக் கடை
அளவறிந்து வாளாதான் வாடகை யுளபோல வில்லாகித் தோன்றாக் கெடும்
ஒல்வ தறிவத த்தன்கட்ட ங்கிச் செல்வார்க்குச் செல்லாததில்</Unicode>
      </TextEquiv>
