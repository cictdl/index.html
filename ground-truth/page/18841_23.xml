    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,181 3006,181 3006,572 0,572"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=201; numeral=௧">
        <Coords points="0,181 3006,181 3006,220 0,220"/>
        <Baseline points="0,213 3006,213"/>
        <TextEquiv>
          <Unicode>தீவிநையா ரஞ்சார் விழுமியா ரஞ்சுவர் தீவிநை யெந்நுஞ் செருக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=203; numeral=௨">
        <Coords points="0,220 3006,220 3006,259 0,259"/>
        <Baseline points="0,252 3006,252"/>
        <TextEquiv>
          <Unicode>அறிவிநு ளெல்லாந் தலையென்ப தீய செறுவார்க்குஞ் செய்யா விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=210; numeral=௩">
        <Coords points="0,259 3006,259 3006,298 0,298"/>
        <Baseline points="0,291 3006,291"/>
        <TextEquiv>
          <Unicode>அருங்கேட னென்ப தறிக மருங்கோடித் தீவினநை செய்யா னெனில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=202; numeral=௪">
        <Coords points="0,298 3006,298 3006,337 0,337"/>
        <Baseline points="0,330 3006,330"/>
        <TextEquiv>
          <Unicode>தீயவை தீய பயத்தலாற் றீயவை தீயிநு மஞ்சப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=208; numeral=௫">
        <Coords points="0,337 3006,337 3006,376 0,376"/>
        <Baseline points="0,369 3006,369"/>
        <TextEquiv>
          <Unicode>தீயவை செய்தார் கெடுத னிழறந்நை வீயா தடியுறைந் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=207; numeral=௬">
        <Coords points="0,376 3006,376 3006,415 0,415"/>
        <Baseline points="0,408 3006,408"/>
        <TextEquiv>
          <Unicode>எநைப்பகை யுற்றாரு முய்வர் விநைப்பகை வீயாது பின்சென் றாடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=209; numeral=௭">
        <Coords points="0,415 3006,415 3006,455 0,455"/>
        <Baseline points="0,447 3006,447"/>
        <TextEquiv>
          <Unicode>தந்நைத்தான் காதல னாயின்னெனைத்தொன்றுந் துன்னற்க தீவிநைப் பால்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=206; numeral=௮">
        <Coords points="0,455 3006,455 3006,494 0,494"/>
        <Baseline points="0,487 3006,487"/>
        <TextEquiv>
          <Unicode>தீய்ப்பால தான்பிறர்கட் செய்யற்க நோய்ப்பால தந்நை யடல் வேண்டா தார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=205; numeral=௯">
        <Coords points="0,494 3006,494 3006,533 0,533"/>
        <Baseline points="0,526 3006,526"/>
        <TextEquiv>
          <Unicode>இலமென்றுந் தீயவை செய்யற்கச் செய்யின் னிலநாகு மற்றும் பெயர்த்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=204; numeral=௰">
        <Coords points="0,533 3006,533 3006,572 0,572"/>
        <Baseline points="0,565 3006,565"/>
        <TextEquiv>
          <Unicode>மறந்தும் பிறன்கேடு சூழற்கச் சூழின்அறஞ்சூழுஞ் சூழ்ந்தவன் கேடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>தீவிநையா ரஞ்சார் விழுமியா ரஞ்சுவர் தீவிநை யெந்நுஞ் செருக்கு
அறிவிநு ளெல்லாந் தலையென்ப தீய செறுவார்க்குஞ் செய்யா விடல்
அருங்கேட னென்ப தறிக மருங்கோடித் தீவினநை செய்யா னெனில்
தீயவை தீய பயத்தலாற் றீயவை தீயிநு மஞ்சப் படும்
தீயவை செய்தார் கெடுத னிழறந்நை வீயா தடியுறைந் தற்று
எநைப்பகை யுற்றாரு முய்வர் விநைப்பகை வீயாது பின்சென் றாடும்
தந்நைத்தான் காதல னாயின்னெனைத்தொன்றுந் துன்னற்க தீவிநைப் பால்
தீய்ப்பால தான்பிறர்கட் செய்யற்க நோய்ப்பால தந்நை யடல் வேண்டா தார்
இலமென்றுந் தீயவை செய்யற்கச் செய்யின் னிலநாகு மற்றும் பெயர்த்து
மறந்தும் பிறன்கேடு சூழற்கச் சூழின்அறஞ்சூழுஞ் சூழ்ந்தவன் கேடு</Unicode>
      </TextEquiv>
    </TextRegion>
