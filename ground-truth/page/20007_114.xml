    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,130 2801,130 2801,477 0,477"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1118; numeral=௧">
        <Coords points="0,130 2801,130 2801,164 0,164"/>
        <Baseline points="0,158 2801,158"/>
        <TextEquiv>
          <Unicode>மாதர் முகம்போலோ ளிவிட வல்லையேற் காதலை வாழி மதி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1119; numeral=௨">
        <Coords points="0,164 2801,164 2801,199 0,199"/>
        <Baseline points="0,193 2801,193"/>
        <TextEquiv>
          <Unicode>மலரந்ந கண்ணா முகமொத்தி யாயிற் பலர்காணத் தோன்றன் மதி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1117; numeral=௩">
        <Coords points="0,199 2801,199 2801,234 0,234"/>
        <Baseline points="0,227 2801,227"/>
        <TextEquiv>
          <Unicode>அறிவாய் நிறைந்த வவிர்மதிக்குப் போல மறுவுண்டொ மாதர் முகத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1116; numeral=௪">
        <Coords points="0,234 2801,234 2801,268 0,268"/>
        <Baseline points="0,262 2801,262"/>
        <TextEquiv>
          <Unicode>மதியும் மடந்தை முகமும றியாப் பதியிற் கலங்கிய மீன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1120; numeral=௫">
        <Coords points="0,268 2801,268 2801,303 0,303"/>
        <Baseline points="0,297 2801,297"/>
        <TextEquiv>
          <Unicode>அநிச்சமுமஅ ந்நத்தின் றூவியு மாதர டிக்கு நெரிஞ்சிப் பளம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1115; numeral=௬">
        <Coords points="0,303 2801,303 2801,338 0,338"/>
        <Baseline points="0,331 2801,331"/>
        <TextEquiv>
          <Unicode>அநிச்சப்பூக் கால்ளையாப் பெய்தால் நுகப்பிற்கு நல்ல படா பறை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1111; numeral=௭">
        <Coords points="0,338 2801,338 2801,372 0,372"/>
        <Baseline points="0,366 2801,366"/>
        <TextEquiv>
          <Unicode>நந்நீரை வாழி யநிச்சமெ நின்னிலும் மெந்நீரள் யாம்வீழ் பவள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1112; numeral=௮">
        <Coords points="0,372 2801,372 2801,407 0,407"/>
        <Baseline points="0,401 2801,401"/>
        <TextEquiv>
          <Unicode>மலர்கானின் மையாற்றி நெஞ்செ யிவள்கண் பலர்காணும் பூவொக்குடுமென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1114; numeral=௯">
        <Coords points="0,407 2801,407 2801,442 0,442"/>
        <Baseline points="0,436 2801,436"/>
        <TextEquiv>
          <Unicode>காணிற் குவளை கவிழ்ந்து நிலநொக்கும் மாணிழை கண்ணொவ்வொ மென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1113; numeral=௰">
        <Coords points="0,442 2801,442 2801,477 0,477"/>
        <Baseline points="0,470 2801,470"/>
        <TextEquiv>
          <Unicode>முறிமேநி முத்த முறுவல் வெறிநாத்தம் வேலுண்கண் வேய்த்தோ ழவாக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>மாதர் முகம்போலோ ளிவிட வல்லையேற் காதலை வாழி மதி
மலரந்ந கண்ணா முகமொத்தி யாயிற் பலர்காணத் தோன்றன் மதி
அறிவாய் நிறைந்த வவிர்மதிக்குப் போல மறுவுண்டொ மாதர் முகத்து
மதியும் மடந்தை முகமும றியாப் பதியிற் கலங்கிய மீன்
அநிச்சமுமஅ ந்நத்தின் றூவியு மாதர டிக்கு நெரிஞ்சிப் பளம்
அநிச்சப்பூக் கால்ளையாப் பெய்தால் நுகப்பிற்கு நல்ல படா பறை
நந்நீரை வாழி யநிச்சமெ நின்னிலும் மெந்நீரள் யாம்வீழ் பவள்
மலர்கானின் மையாற்றி நெஞ்செ யிவள்கண் பலர்காணும் பூவொக்குடுமென்று
காணிற் குவளை கவிழ்ந்து நிலநொக்கும் மாணிழை கண்ணொவ்வொ மென்று
முறிமேநி முத்த முறுவல் வெறிநாத்தம் வேலுண்கண் வேய்த்தோ ழவாக்கு</Unicode>
      </TextEquiv>
