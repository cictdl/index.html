    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,77 2693,77 2693,436 0,436"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=553; numeral=௧">
        <Coords points="0,77 2693,77 2693,113 0,113"/>
        <Baseline points="0,107 2693,107"/>
        <TextEquiv>
          <Unicode>நாடோறும் நாடி முறைசெய்யா மந்நவன் நாடோறும் நாடு கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=554; numeral=௨">
        <Coords points="0,113 2693,113 2693,149 0,149"/>
        <Baseline points="0,143 2693,143"/>
        <TextEquiv>
          <Unicode>கூழுங் குடியுமொ ருங்கிழக்குங் கோல்கோடி சூழாது செய்யும் அரசு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=556; numeral=௩">
        <Coords points="0,149 2693,149 2693,185 0,185"/>
        <Baseline points="0,178 2693,178"/>
        <TextEquiv>
          <Unicode>மந்நர்க்கு மந்நுதல் செங்கோன்மை யஃதின்றேல் மந்நாவாம் மந்நர்க் கொளி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=559; numeral=௪">
        <Coords points="0,185 2693,185 2693,221 0,221"/>
        <Baseline points="0,214 2693,214"/>
        <TextEquiv>
          <Unicode>முறைகோடி மந்நவன் செய்யினு றைகோடி யொல்லாது வாநம் பெயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=560; numeral=௫">
        <Coords points="0,221 2693,221 2693,257 0,257"/>
        <Baseline points="0,250 2693,250"/>
        <TextEquiv>
          <Unicode>ஆபயங் குன்றும் அறுதொழிலா நூன்மறப்பர் காவலன் காவானெ னின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=557; numeral=௬">
        <Coords points="0,257 2693,257 2693,293 0,293"/>
        <Baseline points="0,286 2693,286"/>
        <TextEquiv>
          <Unicode>துளியின்மை ஞாலத்திற்கே ற்றற்றெ வேந்தனிழி யின்மை வாளுமு யிர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=555; numeral=௭">
        <Coords points="0,293 2693,293 2693,329 0,329"/>
        <Baseline points="0,322 2693,322"/>
        <TextEquiv>
          <Unicode>அல்லற்பட்டா ற்றாத ழுதகண் ணீரன்றொ செல்வத்தைத் தேய்க்கும் படை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=552; numeral=௮">
        <Coords points="0,329 2693,329 2693,364 0,364"/>
        <Baseline points="0,358 2693,358"/>
        <TextEquiv>
          <Unicode>வேலொடு நின்றானி டுவென் றதுபோலுங் கோலொடு நின்றான் யிரவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=558; numeral=௯">
        <Coords points="0,364 2693,364 2693,400 0,400"/>
        <Baseline points="0,394 2693,394"/>
        <TextEquiv>
          <Unicode>இன்மையினி ன்னாது டமை முறைசெய்யா மந்நவன் கோல்க்கீழ்ப் படின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=551; numeral=௰">
        <Coords points="0,400 2693,400 2693,436 0,436"/>
        <Baseline points="0,430 2693,430"/>
        <TextEquiv>
          <Unicode>கொலைமேற்கொண் டாரிற் கொடிதெ யலைமேற்கொண்ட ல்லவை செய்தொழுகும் வேந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>நாடோறும் நாடி முறைசெய்யா மந்நவன் நாடோறும் நாடு கெடும்
கூழுங் குடியுமொ ருங்கிழக்குங் கோல்கோடி சூழாது செய்யும் அரசு
மந்நர்க்கு மந்நுதல் செங்கோன்மை யஃதின்றேல் மந்நாவாம் மந்நர்க் கொளி
முறைகோடி மந்நவன் செய்யினு றைகோடி யொல்லாது வாநம் பெயல்
ஆபயங் குன்றும் அறுதொழிலா நூன்மறப்பர் காவலன் காவானெ னின்
துளியின்மை ஞாலத்திற்கே ற்றற்றெ வேந்தனிழி யின்மை வாளுமு யிர்க்கு
அல்லற்பட்டா ற்றாத ழுதகண் ணீரன்றொ செல்வத்தைத் தேய்க்கும் படை
வேலொடு நின்றானி டுவென் றதுபோலுங் கோலொடு நின்றான் யிரவு
இன்மையினி ன்னாது டமை முறைசெய்யா மந்நவன் கோல்க்கீழ்ப் படின்
கொலைமேற்கொண் டாரிற் கொடிதெ யலைமேற்கொண்ட ல்லவை செய்தொழுகும் வேந்து</Unicode>
      </TextEquiv>
