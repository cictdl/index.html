    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,90 2900,90 2900,413 0,413"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1314; numeral=௧">
        <Coords points="0,90 2900,90 2900,122 0,122"/>
        <Baseline points="0,116 2900,116"/>
        <TextEquiv>
          <Unicode>யாரினுங் காதல மென்றெமா வூடிநாள் யாரிநு மாரிநு மென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1316; numeral=௨">
        <Coords points="0,122 2900,122 2900,155 0,155"/>
        <Baseline points="0,149 2900,149"/>
        <TextEquiv>
          <Unicode>உள்ளிநெ னென்றென்மற் றென்மறந்தீ ரென்றெம்மைப் புல்லாபுன் புலத்தக் கன்ன</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1315; numeral=௩">
        <Coords points="0,155 2900,155 2900,187 0,187"/>
        <Baseline points="0,181 2900,181"/>
        <TextEquiv>
          <Unicode>இம்மைப் பிறப்பொ பிரியல மென்றெமாக் கண்ணிறை நீர்கொண்    நள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1320; numeral=௪">
        <Coords points="0,187 2900,187 2900,219 0,219"/>
        <Baseline points="0,213 2900,213"/>
        <TextEquiv>
          <Unicode>நிநைத்திருந்து நோக்கிநுங் காயு மனத்து நீராருள் நோக்கிநீ ரென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1313; numeral=௫">
        <Coords points="0,219 2900,219 2900,252 0,252"/>
        <Baseline points="0,246 2900,246"/>
        <TextEquiv>
          <Unicode>கோட்டுப்புச் சூடினுங் காயு மொருத்தினயக் காட்டி மறைததிரொ வென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1317; numeral=௬">
        <Coords points="0,252 2900,252 2900,284 0,284"/>
        <Baseline points="0,278 2900,278"/>
        <TextEquiv>
          <Unicode>வழுந்திநாடும்மிநெ மாக வழித்தழுதான் யாருள்ளித் தும்மிநீ ரென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1318; numeral=௭">
        <Coords points="0,284 2900,284 2900,316 0,316"/>
        <Baseline points="0,311 2900,311"/>
        <TextEquiv>
          <Unicode>தும்முசு செருப்ப வழுதாளுமருண்மை யெம்மை மறத்திரொ வென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1312; numeral=௮">
        <Coords points="0,316 2900,316 2900,349 0,349"/>
        <Baseline points="0,343 2900,343"/>
        <TextEquiv>
          <Unicode>உளடியிருந் தெமாத்தும்மிநீராந்தமை நீடுவரளென் பாக் கறிந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1311; numeral=௯">
        <Coords points="0,349 2900,349 2900,381 0,381"/>
        <Baseline points="0,375 2900,375"/>
        <TextEquiv>
          <Unicode>பெண்ணி யலாரெல் லாருங் கண்ணிற் பொதுவுண்பா நண்ணென் பரத்தைநின மார்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1319; numeral=௰">
        <Coords points="0,381 2900,381 2900,413 0,413"/>
        <Baseline points="0,408 2900,408"/>
        <TextEquiv>
          <Unicode>தநநையுணர்த்தி நுங்காயும் பிறாக்க நீர் யீந்ந நீராகுதி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>யாரினுங் காதல மென்றெமா வூடிநாள் யாரிநு மாரிநு மென்று
உள்ளிநெ னென்றென்மற் றென்மறந்தீ ரென்றெம்மைப் புல்லாபுன் புலத்தக் கன்ன
இம்மைப் பிறப்பொ பிரியல மென்றெமாக் கண்ணிறை நீர்கொண்    நள்
நிநைத்திருந்து நோக்கிநுங் காயு மனத்து நீராருள் நோக்கிநீ ரென்று
கோட்டுப்புச் சூடினுங் காயு மொருத்தினயக் காட்டி மறைததிரொ வென்று
வழுந்திநாடும்மிநெ மாக வழித்தழுதான் யாருள்ளித் தும்மிநீ ரென்று
தும்முசு செருப்ப வழுதாளுமருண்மை யெம்மை மறத்திரொ வென்று
உளடியிருந் தெமாத்தும்மிநீராந்தமை நீடுவரளென் பாக் கறிந்து
பெண்ணி யலாரெல் லாருங் கண்ணிற் பொதுவுண்பா நண்ணென் பரத்தைநின மார்பு
தநநையுணர்த்தி நுங்காயும் பிறாக்க நீர் யீந்ந நீராகுதி</Unicode>
      </TextEquiv>
