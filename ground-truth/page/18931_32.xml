      <Coords points="0,74 2690,74 2690,445 0,445"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=291; numeral=௧">
        <Coords points="0,74 2690,74 2690,111 0,111"/>
        <Baseline points="0,104 2690,104"/>
        <TextEquiv>
          <Unicode>வாய்மை யெநப்படுவ தியாதெநின் யாதொன்றுந் தீயமை யிலாத சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=292; numeral=௨">
        <Coords points="0,111 2690,111 2690,148 0,148"/>
        <Baseline points="0,142 2690,142"/>
        <TextEquiv>
          <Unicode>பொய்ம்மையும் வாய்மை யிடத்த புரைதீர்ந்த நன்மை பயக்கு மெநின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=295; numeral=௩">
        <Coords points="0,148 2690,148 2690,185 0,185"/>
        <Baseline points="0,179 2690,179"/>
        <TextEquiv>
          <Unicode>மனத்தோடு வாய்மை மொழியிற் தவத்தொடு தாநஞ்செய் வாரிற் றலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=294; numeral=௪">
        <Coords points="0,185 2690,185 2690,222 0,222"/>
        <Baseline points="0,216 2690,216"/>
        <TextEquiv>
          <Unicode>உள்ளத்தாற் பொய்யா தொளுகின உலகத்தா ருள்ளத்து ளெல்லா முளன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=296; numeral=௫">
        <Coords points="0,222 2690,222 2690,259 0,259"/>
        <Baseline points="0,253 2690,253"/>
        <TextEquiv>
          <Unicode>பொய்யாமை யன்ன புகழில்லை பொய்யாமை யெல்லா வறமுந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=299; numeral=௬">
        <Coords points="0,259 2690,259 2690,296 0,296"/>
        <Baseline points="0,290 2690,290"/>
        <TextEquiv>
          <Unicode>எல்லா விளக்கும் விளக்கல்லச் சான்றோர்க்குப் பொய்யா விளக்கே விளக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=297; numeral=௭">
        <Coords points="0,296 2690,296 2690,333 0,333"/>
        <Baseline points="0,327 2690,327"/>
        <TextEquiv>
          <Unicode>பொய்யாமை பொய்யாமை யாற்றின் அறம்பிற செய்யாமை செய்யாமை நன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=298; numeral=௮">
        <Coords points="0,333 2690,333 2690,370 0,370"/>
        <Baseline points="0,364 2690,364"/>
        <TextEquiv>
          <Unicode>புறந்தூய்மை நீரா னமையும் மகந்தூய்மை வாய்மையாற் காணப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=293; numeral=௯">
        <Coords points="0,370 2690,370 2690,407 0,407"/>
        <Baseline points="0,401 2690,401"/>
        <TextEquiv>
          <Unicode>தந்நெஞ் சறிவது பொய்யற்கப் பொய்த்தபின் றந்நெஞ்சே தந்நைச் சுடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=300; numeral=௰">
        <Coords points="0,407 2690,407 2690,445 0,445"/>
        <Baseline points="0,438 2690,438"/>
        <TextEquiv>
          <Unicode>யாமெய்யாய்க் கண்டவற்று ளில்லை யெநைத்தோன்றும் வாய்மையி னல்ல பிற</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>வாய்மை யெநப்படுவ தியாதெநின் யாதொன்றுந் தீயமை யிலாத சொல்
பொய்ம்மையும் வாய்மை யிடத்த புரைதீர்ந்த நன்மை பயக்கு மெநின்
மனத்தோடு வாய்மை மொழியிற் தவத்தொடு தாநஞ்செய் வாரிற் றலை
உள்ளத்தாற் பொய்யா தொளுகின உலகத்தா ருள்ளத்து ளெல்லா முளன்
பொய்யாமை யன்ன புகழில்லை பொய்யாமை யெல்லா வறமுந் தரும்
எல்லா விளக்கும் விளக்கல்லச் சான்றோர்க்குப் பொய்யா விளக்கே விளக்கு
பொய்யாமை பொய்யாமை யாற்றின் அறம்பிற செய்யாமை செய்யாமை நன்று
புறந்தூய்மை நீரா னமையும் மகந்தூய்மை வாய்மையாற் காணப் படும்
தந்நெஞ் சறிவது பொய்யற்கப் பொய்த்தபின் றந்நெஞ்சே தந்நைச் சுடும்
யாமெய்யாய்க் கண்டவற்று ளில்லை யெநைத்தோன்றும் வாய்மையி னல்ல பிற</Unicode>
      </TextEquiv>
