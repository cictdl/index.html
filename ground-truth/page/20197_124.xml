    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,92 2830,92 2830,410 0,410"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1308; numeral=௧">
        <Coords points="0,92 2830,92 2830,124 0,124"/>
        <Baseline points="0,118 2830,118"/>
        <TextEquiv>
          <Unicode>நோத லெவன்மற்று நொந்தரரென்று ஃதறியுங் காதல ரில்லாவழி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1309; numeral=௨">
        <Coords points="0,124 2830,124 2830,155 0,155"/>
        <Baseline points="0,150 2830,150"/>
        <TextEquiv>
          <Unicode>நீரு மநிழலு மினிதெ புலவியிற்பும் வீழுநா கண்ணே யிருது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1310; numeral=௩">
        <Coords points="0,155 2830,155 2830,187 0,187"/>
        <Baseline points="0,182 2830,182"/>
        <TextEquiv>
          <Unicode>ஊடலுணங்க விடுவரோடெந் நெஞ்சுங் கூடுவொ மென்பதவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1304; numeral=௪">
        <Coords points="0,187 2830,187 2830,219 0,219"/>
        <Baseline points="0,213 2830,213"/>
        <TextEquiv>
          <Unicode>ஊடியவனா யுணராமை வாடிய வள்ளி முதலரிந் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1303; numeral=௫">
        <Coords points="0,219 2830,219 2830,251 0,251"/>
        <Baseline points="0,245 2830,245"/>
        <TextEquiv>
          <Unicode>அலந்தாரை யல்லல்நோய் செய்தற்றாற்றம்மைப் புலர்ந்தாரைப் புல்லாவிடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1307; numeral=௬">
        <Coords points="0,251 2830,251 2830,283 0,283"/>
        <Baseline points="0,277 2830,277"/>
        <TextEquiv>
          <Unicode>ஊடலினுண்டாங்கோர் துன்பம் புணர்வது நீடுவ தன்றுகொ லென்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1306; numeral=௭">
        <Coords points="0,283 2830,283 2830,315 0,315"/>
        <Baseline points="0,309 2830,309"/>
        <TextEquiv>
          <Unicode>துநியும் புலவியு மில்லாயிர் காமங் கநியுங் கருக்காயு மற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1302; numeral=௮">
        <Coords points="0,315 2830,315 2830,347 0,347"/>
        <Baseline points="0,341 2830,341"/>
        <TextEquiv>
          <Unicode>உப்பமைந் தற்றாற் புலவியது சிறிது மிக்கத்தா நீழ விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1301; numeral=௯">
        <Coords points="0,347 2830,347 2830,378 0,378"/>
        <Baseline points="0,373 2830,373"/>
        <TextEquiv>
          <Unicode>புல்லா திரவு புலத்தி யவருறும் அல்லல்யாங்காண்க ச்சிறிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1305; numeral=௰">
        <Coords points="0,378 2830,378 2830,410 0,410"/>
        <Baseline points="0,405 2830,405"/>
        <TextEquiv>
          <Unicode>நலத்தகை நல்லவற் கொ புலத்தகை பூவநந் கண்ணா ரகத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>நோத லெவன்மற்று நொந்தரரென்று ஃதறியுங் காதல ரில்லாவழி
நீரு மநிழலு மினிதெ புலவியிற்பும் வீழுநா கண்ணே யிருது
ஊடலுணங்க விடுவரோடெந் நெஞ்சுங் கூடுவொ மென்பதவர்
ஊடியவனா யுணராமை வாடிய வள்ளி முதலரிந் தற்று
அலந்தாரை யல்லல்நோய் செய்தற்றாற்றம்மைப் புலர்ந்தாரைப் புல்லாவிடல்
ஊடலினுண்டாங்கோர் துன்பம் புணர்வது நீடுவ தன்றுகொ லென்று
துநியும் புலவியு மில்லாயிர் காமங் கநியுங் கருக்காயு மற்று
உப்பமைந் தற்றாற் புலவியது சிறிது மிக்கத்தா நீழ விடல்
புல்லா திரவு புலத்தி யவருறும் அல்லல்யாங்காண்க ச்சிறிது
நலத்தகை நல்லவற் கொ புலத்தகை பூவநந் கண்ணா ரகத்து</Unicode>
      </TextEquiv>
