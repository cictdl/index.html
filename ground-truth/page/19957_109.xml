    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,59 2775,59 2775,446 0,446"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1061; numeral=௧">
        <Coords points="0,59 2775,59 2775,97 0,97"/>
        <Baseline points="0,90 2775,90"/>
        <TextEquiv>
          <Unicode>கரவாது வந்தியுங் கண்ணந்நார் கண்ணின் றிரவாமை கோடி யுறும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1064; numeral=௨">
        <Coords points="0,97 2775,97 2775,136 0,136"/>
        <Baseline points="0,129 2775,129"/>
        <TextEquiv>
          <Unicode>இடமெல்லாங் கொள்ளாத் தகைத்தெ கடனில்லாக் காலுமி ரவில்லாச் சாலபு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1065; numeral=௩">
        <Coords points="0,136 2775,136 2775,175 0,175"/>
        <Baseline points="0,168 2775,168"/>
        <TextEquiv>
          <Unicode>தண்ணீரொ டுபுற்கை யாயினுநுந் தாட்தந்தது உண்ணலின் ஊங்கியதில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1066; numeral=௪">
        <Coords points="0,175 2775,175 2775,214 0,214"/>
        <Baseline points="0,207 2775,207"/>
        <TextEquiv>
          <Unicode>ஆவிற்கு நீரென்றி ரப்பிநும் நாவிற்கி ரவின்னி ழிவந்ததில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1063; numeral=௫">
        <Coords points="0,214 2775,214 2775,252 0,252"/>
        <Baseline points="0,245 2775,245"/>
        <TextEquiv>
          <Unicode>இன்மை யிடும்பை யிரந்துதீர் வாமெந்நும் வன்மையில் வன்ப்பட்டதில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1070; numeral=௬">
        <Coords points="0,252 2775,252 2775,291 0,291"/>
        <Baseline points="0,284 2775,284"/>
        <TextEquiv>
          <Unicode>கரப்பவர்க்கி யாங்கொழிக்குங் கொல்லோ யிரப்பவர் சொல்லாடப் போகுமு யிர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1069; numeral=௭">
        <Coords points="0,291 2775,291 2775,330 0,330"/>
        <Baseline points="0,323 2775,323"/>
        <TextEquiv>
          <Unicode>இரவுள்ள முள்ளமு ருகுங் கரவுள்ள முள்ளதூம் யின்றிக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1068; numeral=௮">
        <Coords points="0,330 2775,330 2775,369 0,369"/>
        <Baseline points="0,362 2775,362"/>
        <TextEquiv>
          <Unicode>இரவெந்நுமே மாப்பி றோணி கரவெந்நும் பார்தாக்கப் பகப்கு விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1062; numeral=௯">
        <Coords points="0,369 2775,369 2775,407 0,407"/>
        <Baseline points="0,401 2775,401"/>
        <TextEquiv>
          <Unicode>இரந்துமு யிர்வாள்தல் வேண்டிப் பரந்து கெடுக வுலகியற்றி யான்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1067; numeral=௰">
        <Coords points="0,407 2775,407 2775,446 0,446"/>
        <Baseline points="0,439 2775,439"/>
        <TextEquiv>
          <Unicode>இரப்பனி ரப்பாரை யெல்லாம் யிரப்பிற் கரப்பாரி ரவன்மீனெ ன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>கரவாது வந்தியுங் கண்ணந்நார் கண்ணின் றிரவாமை கோடி யுறும்
இடமெல்லாங் கொள்ளாத் தகைத்தெ கடனில்லாக் காலுமி ரவில்லாச் சாலபு
தண்ணீரொ டுபுற்கை யாயினுநுந் தாட்தந்தது உண்ணலின் ஊங்கியதில்
ஆவிற்கு நீரென்றி ரப்பிநும் நாவிற்கி ரவின்னி ழிவந்ததில்
இன்மை யிடும்பை யிரந்துதீர் வாமெந்நும் வன்மையில் வன்ப்பட்டதில்
கரப்பவர்க்கி யாங்கொழிக்குங் கொல்லோ யிரப்பவர் சொல்லாடப் போகுமு யிர்
இரவுள்ள முள்ளமு ருகுங் கரவுள்ள முள்ளதூம் யின்றிக் கெடும்
இரவெந்நுமே மாப்பி றோணி கரவெந்நும் பார்தாக்கப் பகப்கு விடும்
இரந்துமு யிர்வாள்தல் வேண்டிப் பரந்து கெடுக வுலகியற்றி யான்
இரப்பனி ரப்பாரை யெல்லாம் யிரப்பிற் கரப்பாரி ரவன்மீனெ ன்று</Unicode>
      </TextEquiv>
