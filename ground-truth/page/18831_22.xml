    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,182 2863,182 2863,569 0,569"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=191; numeral=௧">
        <Coords points="0,182 2863,182 2863,221 0,221"/>
        <Baseline points="0,214 2863,214"/>
        <TextEquiv>
          <Unicode>பல்லார் முநியப் பயநில சொல்லுவா னெல்லாரு மெள்ளப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=193; numeral=௨">
        <Coords points="0,221 2863,221 2863,260 0,260"/>
        <Baseline points="0,253 2863,253"/>
        <TextEquiv>
          <Unicode>நயநில் னென்பது சொல்லும் பயநில பாரித் துரைக்கு முரை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=194; numeral=௩">
        <Coords points="0,260 2863,260 2863,298 0,298"/>
        <Baseline points="0,291 2863,291"/>
        <TextEquiv>
          <Unicode>நயஞ்சாரா நன்மையும் நீங்கும் பயன்சாராப் பண்பிற்சொற் பல்லா ரகத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=195; numeral=௪">
        <Coords points="0,298 2863,298 2863,337 0,337"/>
        <Baseline points="0,330 2863,330"/>
        <TextEquiv>
          <Unicode>சீர்மை சிறப்பொடு நீங்கும் பயநில் நீர்மை யுடையார் சொலின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=198; numeral=௫">
        <Coords points="0,337 2863,337 2863,376 0,376"/>
        <Baseline points="0,369 2863,369"/>
        <TextEquiv>
          <Unicode>அரும்பய னாயு மறிவிநார் சொல்லார் பெரும்பய நில்லாத சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=199; numeral=௬">
        <Coords points="0,376 2863,376 2863,414 0,414"/>
        <Baseline points="0,407 2863,407"/>
        <TextEquiv>
          <Unicode>பொருடீர்ந்த பொய்ச்சாந்துஞ் சொல்லார் மருடீர்ந்த மாசறு காக்ஷி யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=192; numeral=௭">
        <Coords points="0,414 2863,414 2863,453 0,453"/>
        <Baseline points="0,446 2863,446"/>
        <TextEquiv>
          <Unicode>பயநில பல்லார்முற் சொல்லல் நயநில நட்டார்கட் செய்தலிற் றீது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=200; numeral=௮">
        <Coords points="0,453 2863,453 2863,491 0,491"/>
        <Baseline points="0,484 2863,484"/>
        <TextEquiv>
          <Unicode>சொல்லுக சொல்லிற் பயனுடைய சொல்லற்கச் சொல்லிற் பயநிலாச் சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=197; numeral=௯">
        <Coords points="0,491 2863,491 2863,530 0,530"/>
        <Baseline points="0,523 2863,523"/>
        <TextEquiv>
          <Unicode>நயநில சொல்லிநுஞ் சொல்லுக சான்றோர் பயனில சொல்லாமை நன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=196; numeral=௰">
        <Coords points="0,530 2863,530 2863,569 0,569"/>
        <Baseline points="0,562 2863,562"/>
        <TextEquiv>
          <Unicode>பயநில்சொல் பாராட்டு வாநை மகநெனல் மக்கட் பதடி யெநல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>பல்லார் முநியப் பயநில சொல்லுவா னெல்லாரு மெள்ளப் படும்
நயநில் னென்பது சொல்லும் பயநில பாரித் துரைக்கு முரை
நயஞ்சாரா நன்மையும் நீங்கும் பயன்சாராப் பண்பிற்சொற் பல்லா ரகத்து
சீர்மை சிறப்பொடு நீங்கும் பயநில் நீர்மை யுடையார் சொலின்
அரும்பய னாயு மறிவிநார் சொல்லார் பெரும்பய நில்லாத சொல்
பொருடீர்ந்த பொய்ச்சாந்துஞ் சொல்லார் மருடீர்ந்த மாசறு காக்ஷி யவர்
பயநில பல்லார்முற் சொல்லல் நயநில நட்டார்கட் செய்தலிற் றீது
சொல்லுக சொல்லிற் பயனுடைய சொல்லற்கச் சொல்லிற் பயநிலாச் சொல்
நயநில சொல்லிநுஞ் சொல்லுக சான்றோர் பயனில சொல்லாமை நன்று
பயநில்சொல் பாராட்டு வாநை மகநெனல் மக்கட் பதடி யெநல்</Unicode>
      </TextEquiv>
    </TextRegion>
