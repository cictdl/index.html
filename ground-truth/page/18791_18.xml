    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,147 2883,147 2883,539 0,539"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=151; numeral=௧">
        <Coords points="0,147 2883,147 2883,187 0,187"/>
        <Baseline points="0,179 2883,179"/>
        <TextEquiv>
          <Unicode>அகழ்வாரைத் தாங்கும் நிலம்போலத் தம்மை யிகழ்வார் பொறுத்த றலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=152; numeral=௨">
        <Coords points="0,187 2883,187 2883,226 0,226"/>
        <Baseline points="0,219 2883,219"/>
        <TextEquiv>
          <Unicode>பொறுத்த லிறப்பிநை யென்று மதநை மறத்த லதநினும் நன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=153; numeral=௩">
        <Coords points="0,226 2883,226 2883,265 0,265"/>
        <Baseline points="0,258 2883,258"/>
        <TextEquiv>
          <Unicode>யின்மையு ளின்மை விருந்தோரால் வன்மையுள் வன்மை மடவார் பொறை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=154; numeral=௪">
        <Coords points="0,265 2883,265 2883,304 0,304"/>
        <Baseline points="0,297 2883,297"/>
        <TextEquiv>
          <Unicode>நிறையுடைமை நீங்காமை வேண்டிற் பொறையுடைமை போற்றி யொளுகப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=155; numeral=௫">
        <Coords points="0,304 2883,304 2883,343 0,343"/>
        <Baseline points="0,336 2883,336"/>
        <TextEquiv>
          <Unicode>ஒறுத்தாரை யொன்றாக வையாரெ வைப்பர் பொறுத்தாரைப் பொன்போற் பொதிந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=156; numeral=௬">
        <Coords points="0,343 2883,343 2883,382 0,382"/>
        <Baseline points="0,375 2883,375"/>
        <TextEquiv>
          <Unicode>ஒறுத்தார்க் கொருநாழை யின்பம் பொறுத்தார்க்குப் பொன்றுந் துணையும் புகழ்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=157; numeral=௭">
        <Coords points="0,382 2883,382 2883,422 0,422"/>
        <Baseline points="0,414 2883,414"/>
        <TextEquiv>
          <Unicode>திறநல்ல தற்பிறர் செய்யிநும் நோநோந் தாற்கறனல்ல செய்யாமை நன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=158; numeral=௮">
        <Coords points="0,422 2883,422 2883,461 0,461"/>
        <Baseline points="0,454 2883,454"/>
        <TextEquiv>
          <Unicode>மிகுதியான் மிக்கவை செய்தாரைத் தாந்தந் தகுதியான் வென்று விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=159; numeral=௯">
        <Coords points="0,461 2883,461 2883,500 0,500"/>
        <Baseline points="0,493 2883,493"/>
        <TextEquiv>
          <Unicode>துறந்தாரிற் றூய்மை யுடைய ரிறந்தார்வா யிந்நாச்சொல் நோ நோக்கிப் பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=160; numeral=௰">
        <Coords points="0,500 2883,500 2883,539 0,539"/>
        <Baseline points="0,532 2883,532"/>
        <TextEquiv>
          <Unicode>உன்னாது நோற்பார் பெரியர் பிறர்சொல்லு யிந்நாச்சொல்  நோற்பாரிற் பின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அகழ்வாரைத் தாங்கும் நிலம்போலத் தம்மை யிகழ்வார் பொறுத்த றலை
பொறுத்த லிறப்பிநை யென்று மதநை மறத்த லதநினும் நன்று
யின்மையு ளின்மை விருந்தோரால் வன்மையுள் வன்மை மடவார் பொறை
நிறையுடைமை நீங்காமை வேண்டிற் பொறையுடைமை போற்றி யொளுகப் படும்
ஒறுத்தாரை யொன்றாக வையாரெ வைப்பர் பொறுத்தாரைப் பொன்போற் பொதிந்து
ஒறுத்தார்க் கொருநாழை யின்பம் பொறுத்தார்க்குப் பொன்றுந் துணையும் புகழ்
திறநல்ல தற்பிறர் செய்யிநும் நோநோந் தாற்கறனல்ல செய்யாமை நன்று
மிகுதியான் மிக்கவை செய்தாரைத் தாந்தந் தகுதியான் வென்று விடல்
துறந்தாரிற் றூய்மை யுடைய ரிறந்தார்வா யிந்நாச்சொல் நோ நோக்கிப் பவர்
உன்னாது நோற்பார் பெரியர் பிறர்சொல்லு யிந்நாச்சொல்  நோற்பாரிற் பின்</Unicode>
      </TextEquiv>
    </TextRegion>
