    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,85 2956,85 2956,480 0,480"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=61; numeral=௧">
        <Coords points="0,85 2956,85 2956,124 0,124"/>
        <Baseline points="0,117 2956,117"/>
        <TextEquiv>
          <Unicode>பெறுமவற்றுள் யாமறிவதில்லை யறிவறிந்த மக்கட்பே றல்லப்பிற</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=62; numeral=௨">
        <Coords points="0,124 2956,124 2956,164 0,164"/>
        <Baseline points="0,157 2956,157"/>
        <TextEquiv>
          <Unicode>எழுபிறப்புந் தீயவை தீண்டாப் பழிபிறங்காப் பண்புடை மக்கட் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=63; numeral=௩">
        <Coords points="0,164 2956,164 2956,204 0,204"/>
        <Baseline points="0,196 2956,196"/>
        <TextEquiv>
          <Unicode>தம்பொரு ளென்பாதம் மக்க ளவர்பொருட் டந்தம் விநையான் வரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=64; numeral=௪">
        <Coords points="0,204 2956,204 2956,243 0,243"/>
        <Baseline points="0,236 2956,236"/>
        <TextEquiv>
          <Unicode>அமிழ்திநு மாற்ற விநிதேதம் மக்கள் சிறுகை யழாவியகூழ்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=65; numeral=௫">
        <Coords points="0,243 2956,243 2956,283 0,283"/>
        <Baseline points="0,275 2956,275"/>
        <TextEquiv>
          <Unicode>மக்கண் மெய் தீண்ட லுடற்கின்ப மற்றவர் சொற்கேட்டலின்பம் செவிக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=66; numeral=௬">
        <Coords points="0,283 2956,283 2956,322 0,322"/>
        <Baseline points="0,315 2956,315"/>
        <TextEquiv>
          <Unicode>குழலிநிது யாழினி தென்பா்தம் மக்கண் மழலைச்சொற் கேளா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=67; numeral=௭">
        <Coords points="0,322 2956,322 2956,362 0,362"/>
        <Baseline points="0,354 2956,354"/>
        <TextEquiv>
          <Unicode>தந்தை மகற்காற்று முதவி யவையத்து முந்தி யிருப்பச் செயன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=68; numeral=௮">
        <Coords points="0,362 2956,362 2956,401 0,401"/>
        <Baseline points="0,394 2956,394"/>
        <TextEquiv>
          <Unicode>தம்மிற் தம்மக்க ளறிவுடைமை மாநிலத்து மந்நுயிர்க் கெல்லா மிநிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=69; numeral=௯">
        <Coords points="0,401 2956,401 2956,441 0,441"/>
        <Baseline points="0,434 2956,434"/>
        <TextEquiv>
          <Unicode>ஈன்ற பொழுதிற் பெரிதுவக்குந் தன்மகநைச் சான்றோ நெனக் கேட்டதாய்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=70; numeral=௰">
        <Coords points="0,441 2956,441 2956,480 0,480"/>
        <Baseline points="0,473 2956,473"/>
        <TextEquiv>
          <Unicode>மகன்றந்தைக் காற்று முதவி யிவன்றந்தை யெந்நோற்றான் கொலெந்நுஞ்சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>பெறுமவற்றுள் யாமறிவதில்லை யறிவறிந்த மக்கட்பே றல்லப்பிற
எழுபிறப்புந் தீயவை தீண்டாப் பழிபிறங்காப் பண்புடை மக்கட் பெறின்
தம்பொரு ளென்பாதம் மக்க ளவர்பொருட் டந்தம் விநையான் வரும்
அமிழ்திநு மாற்ற விநிதேதம் மக்கள் சிறுகை யழாவியகூழ்
மக்கண் மெய் தீண்ட லுடற்கின்ப மற்றவர் சொற்கேட்டலின்பம் செவிக்கு
குழலிநிது யாழினி தென்பா்தம் மக்கண் மழலைச்சொற் கேளா தவர்
தந்தை மகற்காற்று முதவி யவையத்து முந்தி யிருப்பச் செயன்
தம்மிற் தம்மக்க ளறிவுடைமை மாநிலத்து மந்நுயிர்க் கெல்லா மிநிது
ஈன்ற பொழுதிற் பெரிதுவக்குந் தன்மகநைச் சான்றோ நெனக் கேட்டதாய்
மகன்றந்தைக் காற்று முதவி யிவன்றந்தை யெந்நோற்றான் கொலெந்நுஞ்சொல்</Unicode>
      </TextEquiv>
