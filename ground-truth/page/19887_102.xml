    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,72 2836,72 2836,416 0,416"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=996; numeral=௧">
        <Coords points="0,72 2836,72 2836,106 0,106"/>
        <Baseline points="0,100 2836,100"/>
        <TextEquiv>
          <Unicode>பண்புடையார் பட்டுண்டு லகம துவின்றெ மண்புக்ழு மாய்வது மன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=992; numeral=௨">
        <Coords points="0,106 2836,106 2836,140 0,140"/>
        <Baseline points="0,134 2836,134"/>
        <TextEquiv>
          <Unicode>அன்புடைமை யான்ற குடிப்பிறத்தலி வ்விரண்டும் பண்புடைமை யெந்நும் வழக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=995; numeral=௩">
        <Coords points="0,140 2836,140 2836,175 0,175"/>
        <Baseline points="0,169 2836,169"/>
        <TextEquiv>
          <Unicode>நகையுள்ளுமி ந்நாதி கட்சிப் பகையுள்ளும் பண்புள்ள பாடறிவார் மாட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=998; numeral=௪">
        <Coords points="0,175 2836,175 2836,209 0,209"/>
        <Baseline points="0,203 2836,203"/>
        <TextEquiv>
          <Unicode>நண்பாற்றாரா கி நயநில செய்வார்க்குப் பண்பற்றாரா தல் கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1000; numeral=௫">
        <Coords points="0,209 2836,209 2836,244 0,244"/>
        <Baseline points="0,238 2836,238"/>
        <TextEquiv>
          <Unicode>பண்பிலான் பெற்ற பெருஞ்செல்வம் நண்பால் கலந்தீமை யாற்றிரிந் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=997; numeral=௬">
        <Coords points="0,244 2836,244 2836,278 0,278"/>
        <Baseline points="0,272 2836,272"/>
        <TextEquiv>
          <Unicode>அரம்போலுங் கூர்மைய ரேநும் மரம்போல்வர் மக்கட்பண்பி ல்லா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=993; numeral=௭">
        <Coords points="0,278 2836,278 2836,313 0,313"/>
        <Baseline points="0,307 2836,307"/>
        <TextEquiv>
          <Unicode>உறுப்பொத்த மக்களொப்பெ ன்றால் வெறுத்தக்கப் பண்பொத்தலொ ப்பதாமொ ப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=999; numeral=௮">
        <Coords points="0,313 2836,313 2836,347 0,347"/>
        <Baseline points="0,341 2836,341"/>
        <TextEquiv>
          <Unicode>நகல்வல்லர ல்லார்க்கு மாயிரு ஞாலம் பகலும்பாற் பட்டன்றி ருள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=991; numeral=௯">
        <Coords points="0,347 2836,347 2836,382 0,382"/>
        <Baseline points="0,376 2836,376"/>
        <TextEquiv>
          <Unicode>எண்பதத்தாலெ ய்தலெழிது மந்நியார்மாட்டும் பண்புடைமை யெந்நும் வழக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=994; numeral=௰">
        <Coords points="0,382 2836,382 2836,416 0,416"/>
        <Baseline points="0,410 2836,410"/>
        <TextEquiv>
          <Unicode>நயநொடு நன்றிபுரிந்தப் பினுடையார் பண்புபா ராட்டுமு லகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>பண்புடையார் பட்டுண்டு லகம துவின்றெ மண்புக்ழு மாய்வது மன்
அன்புடைமை யான்ற குடிப்பிறத்தலி வ்விரண்டும் பண்புடைமை யெந்நும் வழக்கு
நகையுள்ளுமி ந்நாதி கட்சிப் பகையுள்ளும் பண்புள்ள பாடறிவார் மாட்டு
நண்பாற்றாரா கி நயநில செய்வார்க்குப் பண்பற்றாரா தல் கடை
பண்பிலான் பெற்ற பெருஞ்செல்வம் நண்பால் கலந்தீமை யாற்றிரிந் தற்று
அரம்போலுங் கூர்மைய ரேநும் மரம்போல்வர் மக்கட்பண்பி ல்லா தவர்
உறுப்பொத்த மக்களொப்பெ ன்றால் வெறுத்தக்கப் பண்பொத்தலொ ப்பதாமொ ப்பு
நகல்வல்லர ல்லார்க்கு மாயிரு ஞாலம் பகலும்பாற் பட்டன்றி ருள்
எண்பதத்தாலெ ய்தலெழிது மந்நியார்மாட்டும் பண்புடைமை யெந்நும் வழக்கு
நயநொடு நன்றிபுரிந்தப் பினுடையார் பண்புபா ராட்டுமு லகு</Unicode>
      </TextEquiv>
    </TextRegion>
