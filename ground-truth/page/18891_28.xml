    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,94 2773,94 2773,469 0,469"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=259; numeral=௧">
        <Coords points="0,94 2773,94 2773,131 0,131"/>
        <Baseline points="0,124 2773,124"/>
        <TextEquiv>
          <Unicode>அவிசொரிந் தாயிரம் வேட்டலி நொன்றின் னுயிர்செகுத் துண்ணாமை நன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=260; numeral=௨">
        <Coords points="0,131 2773,131 2773,169 0,169"/>
        <Baseline points="0,162 2773,162"/>
        <TextEquiv>
          <Unicode>கொல்லான் புலாலை மறுத்தாநை கைகூப்பி யெல்லா வுயிருந் தொளும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=254; numeral=௩">
        <Coords points="0,169 2773,169 2773,206 0,206"/>
        <Baseline points="0,199 2773,199"/>
        <TextEquiv>
          <Unicode>அருளல்ல தியாதெநிற் கொல்லாமை கோறல் பொருளல்ல தவ்வூன் றிநல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=252; numeral=௪">
        <Coords points="0,206 2773,206 2773,244 0,244"/>
        <Baseline points="0,237 2773,237"/>
        <TextEquiv>
          <Unicode>பொருளாக்ஷி போற்றாதார்க் கில்லை யருளாக்ஷி யாங்கில்லை யூன்றின் பவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=251; numeral=௫">
        <Coords points="0,244 2773,244 2773,281 0,281"/>
        <Baseline points="0,274 2773,274"/>
        <TextEquiv>
          <Unicode>தந்நூன் பெருக்கற்குத் தான்பிறி துனூணுன்பான் எங்ஙந மாளு மருள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=258; numeral=௬">
        <Coords points="0,281 2773,281 2773,319 0,319"/>
        <Baseline points="0,312 2773,312"/>
        <TextEquiv>
          <Unicode>செயிரிற் றலைப்பிரிந்த காக்ஷிய ருண்ணா ருயிரிற் றலை பிரிந்த வூன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=255; numeral=௭">
        <Coords points="0,319 2773,319 2773,356 0,356"/>
        <Baseline points="0,350 2773,350"/>
        <TextEquiv>
          <Unicode>உண்ணாமை யுந்ந துயிர்நிலை யூநுண்ண வண்ணாத்தல் செய்யா தளறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=253; numeral=௮">
        <Coords points="0,356 2773,356 2773,394 0,394"/>
        <Baseline points="0,387 2773,387"/>
        <TextEquiv>
          <Unicode>படை கொண்டார் நெஞ்சம்போல நன்றூக்கா தோன்றின் னுடல்சுவை யுண்டார் மநம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=257; numeral=௯">
        <Coords points="0,394 2773,394 2773,431 0,431"/>
        <Baseline points="0,424 2773,424"/>
        <TextEquiv>
          <Unicode>உண்ணாமை வேண்டும் புலாலைப் பிறிதொன்றின் புண்ண துணர்வார்ப் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=256; numeral=௰">
        <Coords points="0,431 2773,431 2773,469 0,469"/>
        <Baseline points="0,462 2773,462"/>
        <TextEquiv>
          <Unicode>தினல்ப் பொருட்டாற் கொல்லா துலகெநின் யாரும் விலைப்பொருட்டா லூன்றருவா ரில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அவிசொரிந் தாயிரம் வேட்டலி நொன்றின் னுயிர்செகுத் துண்ணாமை நன்று
கொல்லான் புலாலை மறுத்தாநை கைகூப்பி யெல்லா வுயிருந் தொளும்
அருளல்ல தியாதெநிற் கொல்லாமை கோறல் பொருளல்ல தவ்வூன் றிநல்
பொருளாக்ஷி போற்றாதார்க் கில்லை யருளாக்ஷி யாங்கில்லை யூன்றின் பவர்க்கு
தந்நூன் பெருக்கற்குத் தான்பிறி துனூணுன்பான் எங்ஙந மாளு மருள்
செயிரிற் றலைப்பிரிந்த காக்ஷிய ருண்ணா ருயிரிற் றலை பிரிந்த வூன்
உண்ணாமை யுந்ந துயிர்நிலை யூநுண்ண வண்ணாத்தல் செய்யா தளறு
படை கொண்டார் நெஞ்சம்போல நன்றூக்கா தோன்றின் னுடல்சுவை யுண்டார் மநம்
உண்ணாமை வேண்டும் புலாலைப் பிறிதொன்றின் புண்ண துணர்வார்ப் பெறின்
தினல்ப் பொருட்டாற் கொல்லா துலகெநின் யாரும் விலைப்பொருட்டா லூன்றருவா ரில்</Unicode>
      </TextEquiv>
