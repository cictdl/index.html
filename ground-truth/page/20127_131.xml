      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1233; numeral=௧">
        <Coords points="0,132 2816,132 2816,169 0,169"/>
        <Baseline points="0,162 2816,162"/>
        <TextEquiv>
          <Unicode>தணாந்தமை சால அறிவிப்ப போலும் மணாந்த நாள் வீங்கியதோள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1235; numeral=௨">
        <Coords points="0,169 2816,169 2816,206 0,206"/>
        <Baseline points="0,199 2816,199"/>
        <TextEquiv>
          <Unicode>கொடியார் கொடுமை யுரைக்குந் தொயிடியிடை தொல்கவின்வாடியதோள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1232; numeral=௩">
        <Coords points="0,206 2816,206 2816,242 0,242"/>
        <Baseline points="0,236 2816,236"/>
        <TextEquiv>
          <Unicode>நயந்தவர் நல்காமை சொல்லுவ போலும் பசந்து பநிவாருங்கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1236; numeral=௪">
        <Coords points="0,242 2816,242 2816,279 0,279"/>
        <Baseline points="0,272 2816,272"/>
        <TextEquiv>
          <Unicode>தொடியொடு தோ ணெகிழ நோவலவரைக் கொடிய ரெநக்கூறநொந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1234; numeral=௫">
        <Coords points="0,279 2816,279 2816,315 0,315"/>
        <Baseline points="0,309 2816,309"/>
        <TextEquiv>
          <Unicode>பணைநீங்கிப் பைந்தொடி சேருந்துணை நீங் ததொல்கவின் வாடியதோள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1231; numeral=௬">
        <Coords points="0,315 2816,315 2816,352 0,352"/>
        <Baseline points="0,345 2816,345"/>
        <TextEquiv>
          <Unicode>சிறுமை நமக்கொழியச் சேட்சென்றா ருள்ளின் நறுமலர் நாணிந்கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1240; numeral=௭">
        <Coords points="0,352 2816,352 2816,388 0,388"/>
        <Baseline points="0,382 2816,382"/>
        <TextEquiv>
          <Unicode>கண்ணின் பசப்பொ பருவர லெய்தின்றே லொண்ணு தல் செய்யமைகண்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1237; numeral=௮">
        <Coords points="0,388 2816,388 2816,425 0,425"/>
        <Baseline points="0,418 2816,418"/>
        <TextEquiv>
          <Unicode>பாடு பெறுதியொ நெஞ்செ கொடியார்க்கென் வாடுதோட் பூசலுரைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1239; numeral=௯">
        <Coords points="0,425 2816,425 2816,462 0,462"/>
        <Baseline points="0,455 2816,455"/>
        <TextEquiv>
          <Unicode>முயக்கிடை தன்வழி போழப் பசப்புற்ற பேதை பெருமழைக்கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1238; numeral=௰">
        <Coords points="0,462 2816,462 2816,498 0,498"/>
        <Baseline points="0,492 2816,492"/>
        <TextEquiv>
          <Unicode>முயங்கிய கைகளை யூக்கப் பசந்தது பைந்தொடிப் பேதைநுதல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>தணாந்தமை சால அறிவிப்ப போலும் மணாந்த நாள் வீங்கியதோள்
கொடியார் கொடுமை யுரைக்குந் தொயிடியிடை தொல்கவின்வாடியதோள்
நயந்தவர் நல்காமை சொல்லுவ போலும் பசந்து பநிவாருங்கண்
தொடியொடு தோ ணெகிழ நோவலவரைக் கொடிய ரெநக்கூறநொந்து
பணைநீங்கிப் பைந்தொடி சேருந்துணை நீங் ததொல்கவின் வாடியதோள்
சிறுமை நமக்கொழியச் சேட்சென்றா ருள்ளின் நறுமலர் நாணிந்கண்
கண்ணின் பசப்பொ பருவர லெய்தின்றே லொண்ணு தல் செய்யமைகண்டு
பாடு பெறுதியொ நெஞ்செ கொடியார்க்கென் வாடுதோட் பூசலுரைத்து
முயக்கிடை தன்வழி போழப் பசப்புற்ற பேதை பெருமழைக்கண்
முயங்கிய கைகளை யூக்கப் பசந்தது பைந்தொடிப் பேதைநுதல்</Unicode>
      </TextEquiv>
