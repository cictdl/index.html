    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,85 2725,85 2725,458 0,458"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=652; numeral=௧">
        <Coords points="0,85 2725,85 2725,122 0,122"/>
        <Baseline points="0,116 2725,116"/>
        <TextEquiv>
          <Unicode>என்றுமொ ருவுதல் வேண்டும் புகளேடு நன்றி பயவா விநை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=653; numeral=௨">
        <Coords points="0,122 2725,122 2725,160 0,160"/>
        <Baseline points="0,153 2725,153"/>
        <TextEquiv>
          <Unicode>ஒஓத்தல் வேண்டுமொ ழிமாள்குமஞ் செய்விநை யாதுமெ ன்னு மவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=654; numeral=௩">
        <Coords points="0,160 2725,160 2725,197 0,197"/>
        <Baseline points="0,190 2725,190"/>
        <TextEquiv>
          <Unicode>இடுக்கப் படிநுமி ழிவந்த செய்யார் நடுக்கற்ற காக்ஷி யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=656; numeral=௪">
        <Coords points="0,197 2725,197 2725,234 0,234"/>
        <Baseline points="0,228 2725,228"/>
        <TextEquiv>
          <Unicode>ஈன்றாள் பசிகாண்பாநா யினுஞ் செய்யற் க சான்றோர் பழிக்கும் விநை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=659; numeral=௫">
        <Coords points="0,234 2725,234 2725,272 0,272"/>
        <Baseline points="0,265 2725,265"/>
        <TextEquiv>
          <Unicode>அழக் கொண்ட தெல்லாம ழப்போம் யிழப்பிநும் பிற்பயக்கும் நற்பா லவை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=660; numeral=௬">
        <Coords points="0,272 2725,272 2725,309 0,309"/>
        <Baseline points="0,302 2725,302"/>
        <TextEquiv>
          <Unicode>சலத்தால்ப் பொருள்செய்தே மார்த்தல் பசுமட் கலத்துணீர் பெய்திரி யற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=658; numeral=௭">
        <Coords points="0,309 2725,309 2725,346 0,346"/>
        <Baseline points="0,340 2725,340"/>
        <TextEquiv>
          <Unicode>கடிந்த கடிந்தோரார் செய்தார்க்கு கவைதான் முடிந்தாலும் பூழை தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=655; numeral=௮">
        <Coords points="0,346 2725,346 2725,384 0,384"/>
        <Baseline points="0,377 2725,377"/>
        <TextEquiv>
          <Unicode>எற்றென்றி ரங்குவ செய்யற்கச் செய்வானேன் மற்றந்ந செய்யாமை நன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=651; numeral=௯">
        <Coords points="0,384 2725,384 2725,421 0,421"/>
        <Baseline points="0,414 2725,414"/>
        <TextEquiv>
          <Unicode>துணைநலமா க்கம் தருஉம் விநைநலம் வேண்டிய தெல்லாந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=657; numeral=௰">
        <Coords points="0,421 2725,421 2725,458 0,458"/>
        <Baseline points="0,452 2725,452"/>
        <TextEquiv>
          <Unicode>பழிமலைந்தெ ய்திய வாக்கத்துச் சான்றோர் கழிநல் குரவெ தலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>என்றுமொ ருவுதல் வேண்டும் புகளேடு நன்றி பயவா விநை
ஒஓத்தல் வேண்டுமொ ழிமாள்குமஞ் செய்விநை யாதுமெ ன்னு மவர்
இடுக்கப் படிநுமி ழிவந்த செய்யார் நடுக்கற்ற காக்ஷி யவர்
ஈன்றாள் பசிகாண்பாநா யினுஞ் செய்யற் க சான்றோர் பழிக்கும் விநை
அழக் கொண்ட தெல்லாம ழப்போம் யிழப்பிநும் பிற்பயக்கும் நற்பா லவை
சலத்தால்ப் பொருள்செய்தே மார்த்தல் பசுமட் கலத்துணீர் பெய்திரி யற்று
கடிந்த கடிந்தோரார் செய்தார்க்கு கவைதான் முடிந்தாலும் பூழை தரும்
எற்றென்றி ரங்குவ செய்யற்கச் செய்வானேன் மற்றந்ந செய்யாமை நன்று
துணைநலமா க்கம் தருஉம் விநைநலம் வேண்டிய தெல்லாந் தரும்
பழிமலைந்தெ ய்திய வாக்கத்துச் சான்றோர் கழிநல் குரவெ தலை</Unicode>
      </TextEquiv>
