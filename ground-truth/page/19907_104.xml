    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,72 2674,72 2674,431 0,431"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1012; numeral=௧">
        <Coords points="0,72 2674,72 2674,108 0,108"/>
        <Baseline points="0,102 2674,102"/>
        <TextEquiv>
          <Unicode>ஊணுடை யெச்சமு யிர்க்கெல்லாம் வேறல்ல நாணுடமை மாந்தர் சிறப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1013; numeral=௨">
        <Coords points="0,108 2674,108 2674,144 0,144"/>
        <Baseline points="0,138 2674,138"/>
        <TextEquiv>
          <Unicode>ஊநைக் குறித்த வுயிரெல்லாம் நாண்நெநும் நன்மை மகுரித்தது சார்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1014; numeral=௩">
        <Coords points="0,144 2674,144 2674,180 0,180"/>
        <Baseline points="0,173 2674,173"/>
        <TextEquiv>
          <Unicode>அணியன்றொ நாணுடமை சான்றோர்க்க ஃதின்றெற் பிணியன்றோ பீடு நடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1020; numeral=௪">
        <Coords points="0,180 2674,180 2674,216 0,216"/>
        <Baseline points="0,209 2674,209"/>
        <TextEquiv>
          <Unicode>நாணகத் தில்லாரி யக்க மரப்பாவை நாணால் விழிமருட்டி யற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1015; numeral=௫">
        <Coords points="0,216 2674,216 2674,252 0,252"/>
        <Baseline points="0,245 2674,245"/>
        <TextEquiv>
          <Unicode>பிறர்பழியுந் தன்பழியும் நாணுவார் நாணுக்கு றைபதி யெந்நுமு லகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1019; numeral=௬">
        <Coords points="0,252 2674,252 2674,287 0,287"/>
        <Baseline points="0,281 2674,281"/>
        <TextEquiv>
          <Unicode>குலஞ்சுடுங் கொள்கை பிழைக்கும் நலஞ்சுடும் நாணின்மை நின்றக் கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1017; numeral=௭">
        <Coords points="0,287 2674,287 2674,323 0,323"/>
        <Baseline points="0,317 2674,317"/>
        <TextEquiv>
          <Unicode>நாணாலு யிரைத் துறப்பரு யிர்ப்பொருட்டால் நாண்டுறவார் நாணாள் பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1011; numeral=௮">
        <Coords points="0,323 2674,323 2674,359 0,359"/>
        <Baseline points="0,353 2674,353"/>
        <TextEquiv>
          <Unicode>கருமத்தால் நாணுக்  நாணுத் திருநுதல் லலவர் நாணுப் பெற</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1018; numeral=௯">
        <Coords points="0,359 2674,359 2674,395 0,395"/>
        <Baseline points="0,389 2674,389"/>
        <TextEquiv>
          <Unicode>பிறர்நாணத் தக்கது தாநாணா னாயின் அறநாணத் தக்கது டைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1016; numeral=௰">
        <Coords points="0,395 2674,395 2674,431 0,431"/>
        <Baseline points="0,425 2674,425"/>
        <TextEquiv>
          <Unicode>நாண்வெலி கொள்ளாத மந்நொ வியன்ஞாலம் பேணலர் மேலா யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>ஊணுடை யெச்சமு யிர்க்கெல்லாம் வேறல்ல நாணுடமை மாந்தர் சிறப்பு
ஊநைக் குறித்த வுயிரெல்லாம் நாண்நெநும் நன்மை மகுரித்தது சார்பு
அணியன்றொ நாணுடமை சான்றோர்க்க ஃதின்றெற் பிணியன்றோ பீடு நடை
நாணகத் தில்லாரி யக்க மரப்பாவை நாணால் விழிமருட்டி யற்று
பிறர்பழியுந் தன்பழியும் நாணுவார் நாணுக்கு றைபதி யெந்நுமு லகு
குலஞ்சுடுங் கொள்கை பிழைக்கும் நலஞ்சுடும் நாணின்மை நின்றக் கடை
நாணாலு யிரைத் துறப்பரு யிர்ப்பொருட்டால் நாண்டுறவார் நாணாள் பவர்
கருமத்தால் நாணுக்  நாணுத் திருநுதல் லலவர் நாணுப் பெற
பிறர்நாணத் தக்கது தாநாணா னாயின் அறநாணத் தக்கது டைத்து
நாண்வெலி கொள்ளாத மந்நொ வியன்ஞாலம் பேணலர் மேலா யவர்</Unicode>
      </TextEquiv>
    </TextRegion>
