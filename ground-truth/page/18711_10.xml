    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,140 2889,140 2889,526 0,526"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=71; numeral=௧">
        <Coords points="0,140 2889,140 2889,179 0,179"/>
        <Baseline points="0,172 2889,172"/>
        <TextEquiv>
          <Unicode>அன்பிற்கு முண்டோ வடைக்குந்தா ளார்வலர் புன்கணீர் பூசறரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=72; numeral=௨">
        <Coords points="0,179 2889,179 2889,217 0,217"/>
        <Baseline points="0,211 2889,211"/>
        <TextEquiv>
          <Unicode>அன்பிலா ரெல்லாந் தமக்குரிய ரன்புடைய ரென்பு முரியர் பிறர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=73; numeral=௩">
        <Coords points="0,217 2889,217 2889,256 0,256"/>
        <Baseline points="0,249 2889,249"/>
        <TextEquiv>
          <Unicode>அன்போ டியைந்த வழக்கென்ப வாருயிர்க் கென்போ டியைந்த தொடர்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=74; numeral=௪">
        <Coords points="0,256 2889,256 2889,294 0,294"/>
        <Baseline points="0,288 2889,288"/>
        <TextEquiv>
          <Unicode>அன்பீனு மார்வ முடைமை யதுவீநும் நண்பெந்நும் நாடாச் சிறப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=75; numeral=௫">
        <Coords points="0,294 2889,294 2889,333 0,333"/>
        <Baseline points="0,326 2889,326"/>
        <TextEquiv>
          <Unicode>அன்புற் றமர்ந்த வழக்கென்ப வையகத் தின்புற்றா ரெய்தும் சிறப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=76; numeral=௬">
        <Coords points="0,333 2889,333 2889,372 0,372"/>
        <Baseline points="0,365 2889,365"/>
        <TextEquiv>
          <Unicode>அறத்திற்கே யன்புசார் பென்ப வறியார் மறத்திற்கு மஃதேதுணை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=77; numeral=௭">
        <Coords points="0,372 2889,372 2889,410 0,410"/>
        <Baseline points="0,403 2889,403"/>
        <TextEquiv>
          <Unicode>என்பி லதநை வெயில்ப்போலக் காயுமே அன்பி லதநையறம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=78; numeral=௮">
        <Coords points="0,410 2889,410 2889,449 0,449"/>
        <Baseline points="0,442 2889,442"/>
        <TextEquiv>
          <Unicode>அன்பகத் தில்லா வுயிர்வாழ்க்கை வன்பார்க்கண் வற்றிந் மரந்தழிர்த்தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=79; numeral=௯">
        <Coords points="0,449 2889,449 2889,487 0,487"/>
        <Baseline points="0,480 2889,480"/>
        <TextEquiv>
          <Unicode>புறத்துருப்பெல்லா மெவன் செய்யும் யாக்கை யகத்துறருப் பன்பி லவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=80; numeral=௰">
        <Coords points="0,487 2889,487 2889,526 0,526"/>
        <Baseline points="0,519 2889,519"/>
        <TextEquiv>
          <Unicode>அன்பின் வழிய துயிர்நிலை யஃதிலார்க் கென்புதோல்ப் போர்த்த வுடம்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அன்பிற்கு முண்டோ வடைக்குந்தா ளார்வலர் புன்கணீர் பூசறரும்
அன்பிலா ரெல்லாந் தமக்குரிய ரன்புடைய ரென்பு முரியர் பிறர்க்கு
அன்போ டியைந்த வழக்கென்ப வாருயிர்க் கென்போ டியைந்த தொடர்பு
அன்பீனு மார்வ முடைமை யதுவீநும் நண்பெந்நும் நாடாச் சிறப்பு
அன்புற் றமர்ந்த வழக்கென்ப வையகத் தின்புற்றா ரெய்தும் சிறப்பு
அறத்திற்கே யன்புசார் பென்ப வறியார் மறத்திற்கு மஃதேதுணை
என்பி லதநை வெயில்ப்போலக் காயுமே அன்பி லதநையறம்
அன்பகத் தில்லா வுயிர்வாழ்க்கை வன்பார்க்கண் வற்றிந் மரந்தழிர்த்தற்று
புறத்துருப்பெல்லா மெவன் செய்யும் யாக்கை யகத்துறருப் பன்பி லவர்க்கு
அன்பின் வழிய துயிர்நிலை யஃதிலார்க் கென்புதோல்ப் போர்த்த வுடம்பு</Unicode>
      </TextEquiv>
