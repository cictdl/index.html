    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,101 2817,101 2817,436 0,436"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1101; numeral=௧">
        <Coords points="0,101 2817,101 2817,135 0,135"/>
        <Baseline points="0,129 2817,129"/>
        <TextEquiv>
          <Unicode>கண்டுகேட்டு ண்டுயித்து யத்தறியுமை ம்புலநுமொ ண்டொடி கண்ணே யுள</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1107; numeral=௨">
        <Coords points="0,135 2817,135 2817,168 0,168"/>
        <Baseline points="0,162 2817,162"/>
        <TextEquiv>
          <Unicode>தம்மிலி ருந்து தமதுபாற்று ண்டற்றாலெ ம்மா வரிவை முயக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1104; numeral=௩">
        <Coords points="0,168 2817,168 2817,202 0,202"/>
        <Baseline points="0,196 2817,196"/>
        <TextEquiv>
          <Unicode>நீங்கிற் றெறூஉம் குறுங்காற் றண்ணெந்நுந் தீயாண்டு பெற்றாள் யிவள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1102; numeral=௪">
        <Coords points="0,202 2817,202 2817,235 0,235"/>
        <Baseline points="0,229 2817,229"/>
        <TextEquiv>
          <Unicode>பிணிக்கு மருந்து பிறபனனியிழை தந்நோய்க்குத் தாநெ மருந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1106; numeral=௫">
        <Coords points="0,235 2817,235 2817,268 0,268"/>
        <Baseline points="0,262 2817,262"/>
        <TextEquiv>
          <Unicode>உறுதோறு யிர்ளிப்ப தீண்டலாற் பேதைக்க மிழ்தினி யன்றன தோள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1105; numeral=௬">
        <Coords points="0,268 2817,268 2817,302 0,302"/>
        <Baseline points="0,296 2817,296"/>
        <TextEquiv>
          <Unicode>வேட்ட போழதின வையவை போலுமே தோட்டார் துகப்பிநா டோள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1108; numeral=௭">
        <Coords points="0,302 2817,302 2817,335 0,335"/>
        <Baseline points="0,329 2817,329"/>
        <TextEquiv>
          <Unicode>வீழுமி ருவர்க்கி நிதே வழியிடை போழப் படா முயக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1103; numeral=௮">
        <Coords points="0,335 2817,335 2817,369 0,369"/>
        <Baseline points="0,363 2817,363"/>
        <TextEquiv>
          <Unicode>தாம்வீழ்வார் மென்றோ டுயிலினி னிதுகோ றாமரைக் கண்ணானு லகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1109; numeral=௯">
        <Coords points="0,369 2817,369 2817,402 0,402"/>
        <Baseline points="0,396 2817,396"/>
        <TextEquiv>
          <Unicode>ஊடலு ணர்தல் புணர்தலி வைகாமங் கூடியாற் பெற்ற பயன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1110; numeral=௰">
        <Coords points="0,402 2817,402 2817,436 0,436"/>
        <Baseline points="0,430 2817,430"/>
        <TextEquiv>
          <Unicode>அறிதோர றியாமை கண்டற்றாற் காமஞ் செறிதோறுஞ் சேயிழை மாட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>கண்டுகேட்டு ண்டுயித்து யத்தறியுமை ம்புலநுமொ ண்டொடி கண்ணே யுள
தம்மிலி ருந்து தமதுபாற்று ண்டற்றாலெ ம்மா வரிவை முயக்கு
நீங்கிற் றெறூஉம் குறுங்காற் றண்ணெந்நுந் தீயாண்டு பெற்றாள் யிவள்
பிணிக்கு மருந்து பிறபனனியிழை தந்நோய்க்குத் தாநெ மருந்து
உறுதோறு யிர்ளிப்ப தீண்டலாற் பேதைக்க மிழ்தினி யன்றன தோள்
வேட்ட போழதின வையவை போலுமே தோட்டார் துகப்பிநா டோள்
வீழுமி ருவர்க்கி நிதே வழியிடை போழப் படா முயக்கு
தாம்வீழ்வார் மென்றோ டுயிலினி னிதுகோ றாமரைக் கண்ணானு லகு
ஊடலு ணர்தல் புணர்தலி வைகாமங் கூடியாற் பெற்ற பயன்
அறிதோர றியாமை கண்டற்றாற் காமஞ் செறிதோறுஞ் சேயிழை மாட்டு</Unicode>
      </TextEquiv>
