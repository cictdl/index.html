    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,89 2845,89 2845,460 0,460"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=511; numeral=௧">
        <Coords points="0,89 2845,89 2845,126 0,126"/>
        <Baseline points="0,120 2845,120"/>
        <TextEquiv>
          <Unicode>நன்மையுந் தீமையும் நாடி நலஞசிறந்த தன்மையானா ளப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=513; numeral=௨">
        <Coords points="0,126 2845,126 2845,163 0,163"/>
        <Baseline points="0,157 2845,157"/>
        <TextEquiv>
          <Unicode>அன்பறிவு தேற்றம வாவின்மை யிந்நான்கும் நன்குடையான் கட்டெ தெளிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=512; numeral=௩">
        <Coords points="0,163 2845,163 2845,200 0,200"/>
        <Baseline points="0,194 2845,194"/>
        <TextEquiv>
          <Unicode>வாரி பெருக்கி வளம்படுத்து ற்றவை யாராய்வான் செய்க விநை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=518; numeral=௪">
        <Coords points="0,200 2845,200 2845,238 0,238"/>
        <Baseline points="0,231 2845,231"/>
        <TextEquiv>
          <Unicode>விநைக் குரிய நாடிய பின்றை யவநை யதர்க்குரிய நாகச் செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=517; numeral=௫">
        <Coords points="0,238 2845,238 2845,275 0,275"/>
        <Baseline points="0,268 2845,268"/>
        <TextEquiv>
          <Unicode>யிதநை யிதநாலி வன்முடிக்குமெ ன்றாய்ந்த தநை யவன்கண் விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=516; numeral=௬">
        <Coords points="0,275 2845,275 2845,312 0,312"/>
        <Baseline points="0,305 2845,305"/>
        <TextEquiv>
          <Unicode>செய்வாநை நாடி விநைநாடிக் காலத்தோடெய்த வுணர்ந்து செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=519; numeral=௭">
        <Coords points="0,312 2845,312 2845,349 0,349"/>
        <Baseline points="0,342 2845,342"/>
        <TextEquiv>
          <Unicode>விநைக்கண் விநையுடையான் கேண்மைவே றாக நினைப்பாநை நீங்குந் திரு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=515; numeral=௮">
        <Coords points="0,349 2845,349 2845,386 0,386"/>
        <Baseline points="0,379 2845,379"/>
        <TextEquiv>
          <Unicode>அறிந்தாற்றிச் செய்கற்பாற்க ல்லால் விநைதான் சிறந்தானென்றே வற்பாற் றன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=514; numeral=௯">
        <Coords points="0,386 2845,386 2845,423 0,423"/>
        <Baseline points="0,416 2845,416"/>
        <TextEquiv>
          <Unicode>எநைவகையாற் றேறிய கண்ணும் விநைவகையான் வேறாகும் மாந்தர் பலர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=520; numeral=௰">
        <Coords points="0,423 2845,423 2845,460 0,460"/>
        <Baseline points="0,453 2845,453"/>
        <TextEquiv>
          <Unicode>நாடோ றும் நாடுக மந்நன் விநைசெய்வான் கோடாமை கோடா துலகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>நன்மையுந் தீமையும் நாடி நலஞசிறந்த தன்மையானா ளப் படும்
அன்பறிவு தேற்றம வாவின்மை யிந்நான்கும் நன்குடையான் கட்டெ தெளிவு
வாரி பெருக்கி வளம்படுத்து ற்றவை யாராய்வான் செய்க விநை
விநைக் குரிய நாடிய பின்றை யவநை யதர்க்குரிய நாகச் செயல்
யிதநை யிதநாலி வன்முடிக்குமெ ன்றாய்ந்த தநை யவன்கண் விடல்
செய்வாநை நாடி விநைநாடிக் காலத்தோடெய்த வுணர்ந்து செயல்
விநைக்கண் விநையுடையான் கேண்மைவே றாக நினைப்பாநை நீங்குந் திரு
அறிந்தாற்றிச் செய்கற்பாற்க ல்லால் விநைதான் சிறந்தானென்றே வற்பாற் றன்று
எநைவகையாற் றேறிய கண்ணும் விநைவகையான் வேறாகும் மாந்தர் பலர்
நாடோ றும் நாடுக மந்நன் விநைசெய்வான் கோடாமை கோடா துலகு</Unicode>
      </TextEquiv>
    </TextRegion>
