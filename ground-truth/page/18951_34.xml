    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,85 2722,85 2722,465 0,465"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=316; numeral=௧">
        <Coords points="0,85 2722,85 2722,123 0,123"/>
        <Baseline points="0,116 2722,116"/>
        <TextEquiv>
          <Unicode>யிந்நா வெனத்தான் னுணர்ந்தவை துந்நாமை வேண்டும் பிறன்கட் செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=318; numeral=௨">
        <Coords points="0,123 2722,123 2722,161 0,161"/>
        <Baseline points="0,154 2722,154"/>
        <TextEquiv>
          <Unicode>தந்நுயிர்க் கிந்நாமை தானறிவா னென்கொலோ மந்நுயிர்க் கிந்நா செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=319; numeral=௩">
        <Coords points="0,161 2722,161 2722,199 0,199"/>
        <Baseline points="0,192 2722,192"/>
        <TextEquiv>
          <Unicode>பிறர்க்கிந்நா முற்பகல் செய்யிற் தமக்கிந்நா பிற்பகல்த் தாநெ வரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=320; numeral=௪">
        <Coords points="0,199 2722,199 2722,237 0,237"/>
        <Baseline points="0,230 2722,230"/>
        <TextEquiv>
          <Unicode>நோயெல்லா நோய் செய்தார் மேலவாம் நோய் செய்யார் நோயின்மை வேண்டு பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=313; numeral=௫">
        <Coords points="0,237 2722,237 2722,275 0,275"/>
        <Baseline points="0,268 2722,268"/>
        <TextEquiv>
          <Unicode>செய்யாமை செற்றார்க்கு மின்னாத செய்தபின் னுய்யா விழுமந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=312; numeral=௬">
        <Coords points="0,275 2722,275 2722,313 0,313"/>
        <Baseline points="0,306 2722,306"/>
        <TextEquiv>
          <Unicode>கறுத்திந்நா செய்தவக் கண்ணும் மறுத்திந்நா செய்யாமை மாசற்றுர் கோள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=311; numeral=௭">
        <Coords points="0,313 2722,313 2722,351 0,351"/>
        <Baseline points="0,344 2722,344"/>
        <TextEquiv>
          <Unicode>சிறப்பிநுஞ் செல்வம் பெறினும் பிறர்க்கிந்நா செய்யாமை மாசற்றார் கோள்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=317; numeral=௮">
        <Coords points="0,351 2722,351 2722,389 0,389"/>
        <Baseline points="0,382 2722,382"/>
        <TextEquiv>
          <Unicode>எநைத்தாநு மெஞ்ஞான்றும் யார்க்கு மனத்தானா மாணா செய் யாமை தலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=314; numeral=௯">
        <Coords points="0,389 2722,389 2722,427 0,427"/>
        <Baseline points="0,420 2722,420"/>
        <TextEquiv>
          <Unicode>யிந்நாசெய் யாரை யொறுத்தல் லவர்நாண நன்மையெ செய்து விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=315; numeral=௰">
        <Coords points="0,427 2722,427 2722,465 0,465"/>
        <Baseline points="0,458 2722,458"/>
        <TextEquiv>
          <Unicode>அறிவினா னாகுவ துண்டோ பிரிதிநோய் தந்நோய்போற் போற்றாக் கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>யிந்நா வெனத்தான் னுணர்ந்தவை துந்நாமை வேண்டும் பிறன்கட் செயல்
தந்நுயிர்க் கிந்நாமை தானறிவா னென்கொலோ மந்நுயிர்க் கிந்நா செயல்
பிறர்க்கிந்நா முற்பகல் செய்யிற் தமக்கிந்நா பிற்பகல்த் தாநெ வரும்
நோயெல்லா நோய் செய்தார் மேலவாம் நோய் செய்யார் நோயின்மை வேண்டு பவர்
செய்யாமை செற்றார்க்கு மின்னாத செய்தபின் னுய்யா விழுமந் தரும்
கறுத்திந்நா செய்தவக் கண்ணும் மறுத்திந்நா செய்யாமை மாசற்றுர் கோள்
சிறப்பிநுஞ் செல்வம் பெறினும் பிறர்க்கிந்நா செய்யாமை மாசற்றார் கோள்
எநைத்தாநு மெஞ்ஞான்றும் யார்க்கு மனத்தானா மாணா செய் யாமை தலை
யிந்நாசெய் யாரை யொறுத்தல் லவர்நாண நன்மையெ செய்து விடல்
அறிவினா னாகுவ துண்டோ பிரிதிநோய் தந்நோய்போற் போற்றாக் கடை</Unicode>
      </TextEquiv>
