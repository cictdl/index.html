    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,73 2652,73 2652,425 0,425"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=591; numeral=௧">
        <Coords points="0,73 2652,73 2652,108 0,108"/>
        <Baseline points="0,102 2652,102"/>
        <TextEquiv>
          <Unicode>உடையரெ நப்படுவதூ க்கம ஃ திலாரு டையது டையரொ மற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=592; numeral=௨">
        <Coords points="0,108 2652,108 2652,143 0,143"/>
        <Baseline points="0,137 2652,137"/>
        <TextEquiv>
          <Unicode>உளக்கமு டைமை யுடைமை பொருளுடைமை நில்லாது நீங்கி விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=594; numeral=௩">
        <Coords points="0,143 2652,143 2652,179 0,179"/>
        <Baseline points="0,172 2652,172"/>
        <TextEquiv>
          <Unicode>ஆக்கம தர்வினாற் செல்லும் மசைவிலா வூக்க முடையா னுழை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=593; numeral=௪">
        <Coords points="0,179 2652,179 2652,214 0,214"/>
        <Baseline points="0,207 2652,207"/>
        <TextEquiv>
          <Unicode>ஆக்கமி ழந்தோமென்ற ல்லாவாரூ க்கமொ ருவந்தங் கைத்துடை யார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=598; numeral=௫">
        <Coords points="0,214 2652,214 2652,249 0,249"/>
        <Baseline points="0,243 2652,243"/>
        <TextEquiv>
          <Unicode>உள்ளமில் லாதவரெ ய்தாரு லகத்து வள்ளியமெ ந்நுஞ் செருக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=595; numeral=௬">
        <Coords points="0,249 2652,249 2652,284 0,284"/>
        <Baseline points="0,278 2652,278"/>
        <TextEquiv>
          <Unicode>வெள்ளத் தநைய மலர்நீட்டமா ந்தர்தமு ள்ளத் தநையதுணர்வு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=600; numeral=௭">
        <Coords points="0,284 2652,284 2652,319 0,319"/>
        <Baseline points="0,313 2652,313"/>
        <TextEquiv>
          <Unicode>உரமொருவர்க்கு ள்ள வெறுக்கையஃ தில்லார் மரமக்க ளாதலே வேறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=596; numeral=௮">
        <Coords points="0,319 2652,319 2652,354 0,354"/>
        <Baseline points="0,348 2652,348"/>
        <TextEquiv>
          <Unicode>உள்ளுவ தெல்லாமு யர்வுள்ளல் மற்றது தள்ளிநுந் தாளாண்மை நீத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=599; numeral=௯">
        <Coords points="0,354 2652,354 2652,390 0,390"/>
        <Baseline points="0,383 2652,383"/>
        <TextEquiv>
          <Unicode>பரியதுங் கூர்ங்கோட்டதா யிநுமி யாநை வெருஉளம் புலிதாக் குறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=597; numeral=௰">
        <Coords points="0,390 2652,390 2652,425 0,425"/>
        <Baseline points="0,418 2652,418"/>
        <TextEquiv>
          <Unicode>சிதைவிடத்தொ ல்காரு ரவோர் புதையம்பிற் பட்டுப்பா டூன்றுங் களிறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>உடையரெ நப்படுவதூ க்கம ஃ திலாரு டையது டையரொ மற்று
