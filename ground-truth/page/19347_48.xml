    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,79 2754,79 2754,451 0,451"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=460; numeral=௧">
        <Coords points="0,79 2754,79 2754,116 0,116"/>
        <Baseline points="0,110 2754,110"/>
        <TextEquiv>
          <Unicode>நல்லினத்தி னூங்குந் துணையில்லைத் தீயினத்தின ல்லற் படுப்பதூஉமில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=452; numeral=௨">
        <Coords points="0,116 2754,116 2754,153 0,153"/>
        <Baseline points="0,147 2754,147"/>
        <TextEquiv>
          <Unicode>நிலத்தியல்வாம் நீர்திரிந் தவற்றாகு மாந்தர்க்கி னத்தியல்ப தாகும றிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=454; numeral=௩">
        <Coords points="0,153 2754,153 2754,191 0,191"/>
        <Baseline points="0,184 2754,184"/>
        <TextEquiv>
          <Unicode>மநத்து ள்ளதுபோலக் காட்டு மொருவர்க் கினத்துள்ள தாகும றிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=456; numeral=௪">
        <Coords points="0,191 2754,191 2754,228 0,228"/>
        <Baseline points="0,221 2754,221"/>
        <TextEquiv>
          <Unicode>மனந்தூயார்க் கெச்சம்நன் றாகும் யிநந்தூயார்க்கி ல்லைநன் றாகா விநை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=458; numeral=௫">
        <Coords points="0,228 2754,228 2754,265 0,265"/>
        <Baseline points="0,258 2754,258"/>
        <TextEquiv>
          <Unicode>மநநலம் நன்குடைய ராயினுஞ் சான்றோர்க்கி ந்நலமே மாப் புடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=455; numeral=௬">
        <Coords points="0,265 2754,265 2754,302 0,302"/>
        <Baseline points="0,295 2754,295"/>
        <TextEquiv>
          <Unicode>மந்நதூய்மை செய்விநை தூய்மை யிரண்டும் யினந்தூய்மை துவா வரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=453; numeral=௭">
        <Coords points="0,302 2754,302 2754,339 0,339"/>
        <Baseline points="0,333 2754,333"/>
        <TextEquiv>
          <Unicode>மனத்தானா மாந்தர்க் குணர்ச்சி யினத்தானாமி ந்நா நெந்ப்படுஞ் சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=457; numeral=௮">
        <Coords points="0,339 2754,339 2754,376 0,376"/>
        <Baseline points="0,370 2754,370"/>
        <TextEquiv>
          <Unicode>மநநலம் மந்நுயிர்க் காக்கம் யிந்நல மெல்லாப் புகழுந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=459; numeral=௯">
        <Coords points="0,376 2754,376 2754,414 0,414"/>
        <Baseline points="0,407 2754,407"/>
        <TextEquiv>
          <Unicode>மநநலத்தினா கு மறுமைமற் றஃதும் யிந்நலத்தினே மாப் புடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=451; numeral=௰">
        <Coords points="0,414 2754,414 2754,451 0,451"/>
        <Baseline points="0,444 2754,444"/>
        <TextEquiv>
          <Unicode>சிற்றிநம ஞ்சும் பெருமை சிறுமைதான் சுற்றமாய்ச் சூழ்ந்து விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>நல்லினத்தி னூங்குந் துணையில்லைத் தீயினத்தின ல்லற் படுப்பதூஉமில்
நிலத்தியல்வாம் நீர்திரிந் தவற்றாகு மாந்தர்க்கி னத்தியல்ப தாகும றிவு
மநத்து ள்ளதுபோலக் காட்டு மொருவர்க் கினத்துள்ள தாகும றிவு
மனந்தூயார்க் கெச்சம்நன் றாகும் யிநந்தூயார்க்கி ல்லைநன் றாகா விநை
மநநலம் நன்குடைய ராயினுஞ் சான்றோர்க்கி ந்நலமே மாப் புடைத்து
மந்நதூய்மை செய்விநை தூய்மை யிரண்டும் யினந்தூய்மை துவா வரும்
மனத்தானா மாந்தர்க் குணர்ச்சி யினத்தானாமி ந்நா நெந்ப்படுஞ் சொல்
மநநலம் மந்நுயிர்க் காக்கம் யிந்நல மெல்லாப் புகழுந் தரும்
மநநலத்தினா கு மறுமைமற் றஃதும் யிந்நலத்தினே மாப் புடைத்து
சிற்றிநம ஞ்சும் பெருமை சிறுமைதான் சுற்றமாய்ச் சூழ்ந்து விடும்</Unicode>
      </TextEquiv>
