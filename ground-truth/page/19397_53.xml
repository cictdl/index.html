        <Baseline points="0,111 2896,111"/>
        <TextEquiv>
          <Unicode>அறம்பொருளி ன்பம் உயிரச்சம் நான்கின் றிறந்தெரிந்து தேறப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
