    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,72 2885,72 2885,459 0,459"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=781; numeral=௧">
        <Coords points="0,72 2885,72 2885,111 0,111"/>
        <Baseline points="0,104 2885,104"/>
        <TextEquiv>
          <Unicode>செயற்கு ரிய யாவுள நட்பின் துபோல் விநைக்கரிய யாவுள காப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=782; numeral=௨">
        <Coords points="0,111 2885,111 2885,150 0,150"/>
        <Baseline points="0,143 2885,143"/>
        <TextEquiv>
          <Unicode>நிறைமதி நீரவர் கேண்மை பிறைமதிப் பிந்நீரமை பேதையார் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=783; numeral=௩">
        <Coords points="0,150 2885,150 2885,188 0,188"/>
        <Baseline points="0,181 2885,181"/>
        <TextEquiv>
          <Unicode>நவிறேறும் நூநயம் போலும் பயிறேறும் பண்புடை யாழர் தொடர்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=784; numeral=௪">
        <Coords points="0,188 2885,188 2885,227 0,227"/>
        <Baseline points="0,220 2885,220"/>
        <TextEquiv>
          <Unicode>நகுதற் பொருட்டன்று நட்டந் மிகுதிக்கண் மேற்செனறி டித்தற் பொருட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=785; numeral=௫">
        <Coords points="0,227 2885,227 2885,266 0,266"/>
        <Baseline points="0,259 2885,259"/>
        <TextEquiv>
          <Unicode>புணர்ச்சி பளகுதல் வேண்டா வுணர்ச்சிதான் ட்பாங் கிளமை தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=786; numeral=௬">
        <Coords points="0,266 2885,266 2885,304 0,304"/>
        <Baseline points="0,297 2885,297"/>
        <TextEquiv>
          <Unicode>முகநக நட்பது நட்பன்று நெஞ்சத்த கநக நட்பதெ நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=787; numeral=௭">
        <Coords points="0,304 2885,304 2885,343 0,343"/>
        <Baseline points="0,336 2885,336"/>
        <TextEquiv>
          <Unicode>அழிவி னவைநீக்கி ஆறுய்த்து அழிவின்கண் அல்லல் உழப்பதாம் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=788; numeral=௮">
        <Coords points="0,343 2885,343 2885,382 0,382"/>
        <Baseline points="0,375 2885,375"/>
        <TextEquiv>
          <Unicode>உடுக்கை யிழந்தவன் கைபோல வாங்கெ யிடுக்கண் கழைவதாம் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=789; numeral=௯">
        <Coords points="0,382 2885,382 2885,420 0,420"/>
        <Baseline points="0,413 2885,413"/>
        <TextEquiv>
          <Unicode>நட்பிற்கு வைத்திருக்கை யாதெநிற் கொட்பின்றி யொல்லும்வாயூ ன்று நிலை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=790; numeral=௰">
        <Coords points="0,420 2885,420 2885,459 0,459"/>
        <Baseline points="0,452 2885,452"/>
        <TextEquiv>
          <Unicode>இநையரி வரெந்மக்கி ந்நம்யாமெ ன்று புநையிநும் புல்லெந்நும் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>செயற்கு ரிய யாவுள நட்பின் துபோல் விநைக்கரிய யாவுள காப்பு
நிறைமதி நீரவர் கேண்மை பிறைமதிப் பிந்நீரமை பேதையார் நட்பு
நவிறேறும் நூநயம் போலும் பயிறேறும் பண்புடை யாழர் தொடர்பு
நகுதற் பொருட்டன்று நட்டந் மிகுதிக்கண் மேற்செனறி டித்தற் பொருட்டு
புணர்ச்சி பளகுதல் வேண்டா வுணர்ச்சிதான் ட்பாங் கிளமை தரும்
முகநக நட்பது நட்பன்று நெஞ்சத்த கநக நட்பதெ நட்பு
அழிவி னவைநீக்கி ஆறுய்த்து அழிவின்கண் அல்லல் உழப்பதாம் நட்பு
உடுக்கை யிழந்தவன் கைபோல வாங்கெ யிடுக்கண் கழைவதாம் நட்பு
நட்பிற்கு வைத்திருக்கை யாதெநிற் கொட்பின்றி யொல்லும்வாயூ ன்று நிலை
இநையரி வரெந்மக்கி ந்நம்யாமெ ன்று புநையிநும் புல்லெந்நும் நட்பு</Unicode>
      </TextEquiv>
