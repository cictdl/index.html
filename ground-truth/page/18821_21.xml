    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,126 2966,126 2966,527 0,527"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=181; numeral=௧">
        <Coords points="0,126 2966,126 2966,166 0,166"/>
        <Baseline points="0,159 2966,159"/>
        <TextEquiv>
          <Unicode>அறங்கூறா னல்ல செயிநும் மொருவன் புறங்கூறா நென்ற லினிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=182; numeral=௨">
        <Coords points="0,166 2966,166 2966,206 0,206"/>
        <Baseline points="0,199 2966,199"/>
        <TextEquiv>
          <Unicode>அறநழி யல்லவை செய்தலிற் றீதெ புறநழீஇப் பொய்த்து நகை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=183; numeral=௩">
        <Coords points="0,206 2966,206 2966,246 0,246"/>
        <Baseline points="0,239 2966,239"/>
        <TextEquiv>
          <Unicode>புறங்கூறிப் பொய்த்துயிர் வாழ்தலிற் சாதல் அறங்கூறு மாக்கந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=184; numeral=௪">
        <Coords points="0,246 2966,246 2966,286 0,286"/>
        <Baseline points="0,279 2966,279"/>
        <TextEquiv>
          <Unicode>கண்ணின்று கண்ணறகச் சொல்லிநுஞ் சொல்லற்க முந்நின்று பின்னோக்காச் சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=185; numeral=௫">
        <Coords points="0,286 2966,286 2966,326 0,326"/>
        <Baseline points="0,319 2966,319"/>
        <TextEquiv>
          <Unicode>அறஞ்சொல்லும் நெஞ்சத்தா நன்மை புறஞ்சொல்லும் புன்மையாற் காணப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=186; numeral=௬">
        <Coords points="0,326 2966,326 2966,366 0,366"/>
        <Baseline points="0,359 2966,359"/>
        <TextEquiv>
          <Unicode>பிறன்பழி கூறுவான் றன்பழி யுள்ளுந் திறந் தெரிந்து தேறப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=187; numeral=௭">
        <Coords points="0,366 2966,366 2966,406 0,406"/>
        <Baseline points="0,399 2966,399"/>
        <TextEquiv>
          <Unicode>பகைச்சொல்லிக் கேழீர்ப் பிரிப்பர் நகைச்சொல்லி நட்பாறா றேற்றா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=188; numeral=௮">
        <Coords points="0,406 2966,406 2966,447 0,447"/>
        <Baseline points="0,439 2966,439"/>
        <TextEquiv>
          <Unicode>துந்நியார் குற்றமுந் தூற்று மரபிநா ரெந்நைகொல் லேதிலார் மாட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=189; numeral=௯">
        <Coords points="0,447 2966,447 2966,487 0,487"/>
        <Baseline points="0,479 2966,479"/>
        <TextEquiv>
          <Unicode>அறனோக்கி யாற்றுங்கொல் வையம் புறநோக்கிப் புன்சொல் லுரைப்பான் பொறை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=190; numeral=௰">
        <Coords points="0,487 2966,487 2966,527 0,527"/>
        <Baseline points="0,519 2966,519"/>
        <TextEquiv>
          <Unicode>எதிலார் குற்றம் போற் றங்குற்றங் காண்கிற்பிற் றீதுண்டொ மந்நு முயிர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அறங்கூறா னல்ல செயிநும் மொருவன் புறங்கூறா நென்ற லினிது
அறநழி யல்லவை செய்தலிற் றீதெ புறநழீஇப் பொய்த்து நகை
புறங்கூறிப் பொய்த்துயிர் வாழ்தலிற் சாதல் அறங்கூறு மாக்கந் தரும்
கண்ணின்று கண்ணறகச் சொல்லிநுஞ் சொல்லற்க முந்நின்று பின்னோக்காச் சொல்
அறஞ்சொல்லும் நெஞ்சத்தா நன்மை புறஞ்சொல்லும் புன்மையாற் காணப் படும்
பிறன்பழி கூறுவான் றன்பழி யுள்ளுந் திறந் தெரிந்து தேறப் படும்
பகைச்சொல்லிக் கேழீர்ப் பிரிப்பர் நகைச்சொல்லி நட்பாறா றேற்றா தவர்
துந்நியார் குற்றமுந் தூற்று மரபிநா ரெந்நைகொல் லேதிலார் மாட்டு
அறனோக்கி யாற்றுங்கொல் வையம் புறநோக்கிப் புன்சொல் லுரைப்பான் பொறை
எதிலார் குற்றம் போற் றங்குற்றங் காண்கிற்பிற் றீதுண்டொ மந்நு முயிர்க்கு</Unicode>
      </TextEquiv>
