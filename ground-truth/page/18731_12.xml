    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,144 2877,144 2877,538 0,538"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=91; numeral=௧">
        <Coords points="0,144 2877,144 2877,183 0,183"/>
        <Baseline points="0,176 2877,176"/>
        <TextEquiv>
          <Unicode>யின்சொலா வீர மழை ப் படிறிலவாஞ் செம்பொருள் கண்டார்வாய்ச் சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=92; numeral=௨">
        <Coords points="0,183 2877,183 2877,222 0,222"/>
        <Baseline points="0,215 2877,215"/>
        <TextEquiv>
          <Unicode>அகனமர்ந் தீதலி னன்றே முகனமர்ந் தின்சொலனாகப் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=93; numeral=௩">
        <Coords points="0,222 2877,222 2877,262 0,262"/>
        <Baseline points="0,255 2877,255"/>
        <TextEquiv>
          <Unicode>முகத்தான மர்ந்திநிது நோக்கி யகத்தானா மின்சொ லினஃதே யறம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=94; numeral=௪">
        <Coords points="0,262 2877,262 2877,301 0,301"/>
        <Baseline points="0,294 2877,294"/>
        <TextEquiv>
          <Unicode>துன்புறுந்துவ்வாமை யில்லாகும் யார்மாட்டு மின்புறூ மின்சொ லவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=95; numeral=௫">
        <Coords points="0,301 2877,301 2877,341 0,341"/>
        <Baseline points="0,334 2877,334"/>
        <TextEquiv>
          <Unicode>பணிவுடையா னின்சொல னாத லொருவர்க் கணியல்ல மற்றுப் பிற</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=96; numeral=௬">
        <Coords points="0,341 2877,341 2877,380 0,380"/>
        <Baseline points="0,373 2877,373"/>
        <TextEquiv>
          <Unicode>அல்லவை தேயு மறம் பெருகும் நல்லவை நாடி யிநிய சொலில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=97; numeral=௭">
        <Coords points="0,380 2877,380 2877,420 0,420"/>
        <Baseline points="0,413 2877,413"/>
        <TextEquiv>
          <Unicode>நயனீன்று நன்றி பயக்கும் பயனீன்று பண்பிற் றலைப்பிரியாச் சொல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=98; numeral=௮">
        <Coords points="0,420 2877,420 2877,459 0,459"/>
        <Baseline points="0,452 2877,452"/>
        <TextEquiv>
          <Unicode>சிறுமையிநீங்கிய வின்சொல் மருமையும் மின்மையு மின்பந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=99; numeral=௯">
        <Coords points="0,459 2877,459 2877,499 0,499"/>
        <Baseline points="0,492 2877,492"/>
        <TextEquiv>
          <Unicode>யின்சொல் லிநிதீன்றல் காண்பா னெவன்கொலோ வன்சொல் வளங்கு மது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=100; numeral=௰">
        <Coords points="0,499 2877,499 2877,538 0,538"/>
        <Baseline points="0,531 2877,531"/>
        <TextEquiv>
          <Unicode>யிநிய வுளவாக யின்னாத கூறல் கநியிருப்பக் காய்கவர்ந் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>யின்சொலா வீர மழை ப் படிறிலவாஞ் செம்பொருள் கண்டார்வாய்ச் சொல்
அகனமர்ந் தீதலி னன்றே முகனமர்ந் தின்சொலனாகப் பெறின்
முகத்தான மர்ந்திநிது நோக்கி யகத்தானா மின்சொ லினஃதே யறம்
துன்புறுந்துவ்வாமை யில்லாகும் யார்மாட்டு மின்புறூ மின்சொ லவர்க்கு
பணிவுடையா னின்சொல னாத லொருவர்க் கணியல்ல மற்றுப் பிற
அல்லவை தேயு மறம் பெருகும் நல்லவை நாடி யிநிய சொலில்
நயனீன்று நன்றி பயக்கும் பயனீன்று பண்பிற் றலைப்பிரியாச் சொல்
சிறுமையிநீங்கிய வின்சொல் மருமையும் மின்மையு மின்பந் தரும்
யின்சொல் லிநிதீன்றல் காண்பா னெவன்கொலோ வன்சொல் வளங்கு மது
யிநிய வுளவாக யின்னாத கூறல் கநியிருப்பக் காய்கவர்ந் தற்று</Unicode>
      </TextEquiv>
    </TextRegion>
