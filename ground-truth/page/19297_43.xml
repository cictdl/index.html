    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,88 2810,88 2810,469 0,469"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=401; numeral=௧">
        <Coords points="0,88 2810,88 2810,126 0,126"/>
        <Baseline points="0,119 2810,119"/>
        <TextEquiv>
          <Unicode>அரங்கின்றி வட்டாடி யற்றே நிரப்பிய நூலின்றிக் கோட்டி கொளல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=402; numeral=௨">
        <Coords points="0,126 2810,126 2810,164 0,164"/>
        <Baseline points="0,157 2810,157"/>
        <TextEquiv>
          <Unicode>கல்லாதான் சொற்கா முறுதல் முலையிரண்டும் மில்லாதாள் பெண்காமுற் றற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=403; numeral=௩">
        <Coords points="0,164 2810,164 2810,202 0,202"/>
        <Baseline points="0,195 2810,195"/>
        <TextEquiv>
          <Unicode>கல்லாதானொ ட்பம் கழியநன் றாயிநுங் கொள்ளார றிவுடை யார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=404; numeral=௪">
        <Coords points="0,202 2810,202 2810,240 0,240"/>
        <Baseline points="0,233 2810,233"/>
        <TextEquiv>
          <Unicode>கல்லா தவரும் நநிநல்லோரெ கற்றர்முற் சொல்லா திருக்கப் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=405; numeral=௫">
        <Coords points="0,240 2810,240 2810,279 0,279"/>
        <Baseline points="0,272 2810,272"/>
        <TextEquiv>
          <Unicode>கல்லா நொருவன் றகைமை தலைப்பெய்து சொல்லாடச் சோர்வு படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=406; numeral=௬">
        <Coords points="0,279 2810,279 2810,317 0,317"/>
        <Baseline points="0,310 2810,310"/>
        <TextEquiv>
          <Unicode>உளரெனரினு மாத்திரையர ல்லால் பயவாக் களரநையர் கல்லா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=408; numeral=௭">
        <Coords points="0,317 2810,317 2810,355 0,355"/>
        <Baseline points="0,348 2810,348"/>
        <TextEquiv>
          <Unicode>நல்லார்கட்பட்ட வறுமையும் நிந்நாதெ கல்லார்கட் பட்ட திரு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=407; numeral=௮">
        <Coords points="0,355 2810,355 2810,393 0,393"/>
        <Baseline points="0,386 2810,386"/>
        <TextEquiv>
          <Unicode>நுண்மா நுளைபுலனி ல்லானெ ழில்நலம் மண்மான் புநைபாவை யற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=409; numeral=௯">
        <Coords points="0,393 2810,393 2810,431 0,431"/>
        <Baseline points="0,424 2810,424"/>
        <TextEquiv>
          <Unicode>மேற்பிறந்தா ராயிநுங் கல்லாதார் கீழ்ப்பிறந்துங் கற்றார் நைத்திலர் பாடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=410; numeral=௰">
        <Coords points="0,431 2810,431 2810,469 0,469"/>
        <Baseline points="0,463 2810,463"/>
        <TextEquiv>
          <Unicode>விலங்கொடு மக்கள நையர் யிலங்குநூல் கற்றாரோடே நை யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அரங்கின்றி வட்டாடி யற்றே நிரப்பிய நூலின்றிக் கோட்டி கொளல்
கல்லாதான் சொற்கா முறுதல் முலையிரண்டும் மில்லாதாள் பெண்காமுற் றற்று
கல்லாதானொ ட்பம் கழியநன் றாயிநுங் கொள்ளார றிவுடை யார்
கல்லா தவரும் நநிநல்லோரெ கற்றர்முற் சொல்லா திருக்கப் பெறின்
கல்லா நொருவன் றகைமை தலைப்பெய்து சொல்லாடச் சோர்வு படும்
உளரெனரினு மாத்திரையர ல்லால் பயவாக் களரநையர் கல்லா தவர்
நல்லார்கட்பட்ட வறுமையும் நிந்நாதெ கல்லார்கட் பட்ட திரு
நுண்மா நுளைபுலனி ல்லானெ ழில்நலம் மண்மான் புநைபாவை யற்று
மேற்பிறந்தா ராயிநுங் கல்லாதார் கீழ்ப்பிறந்துங் கற்றார் நைத்திலர் பாடு
விலங்கொடு மக்கள நையர் யிலங்குநூல் கற்றாரோடே நை யவர்</Unicode>
      </TextEquiv>
