    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,240 2868,240 2868,571 0,571"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1081; numeral=௧">
        <Coords points="0,240 2868,240 2868,273 0,273"/>
        <Baseline points="0,267 2868,267"/>
        <TextEquiv>
          <Unicode>அணங்குகொல்லாமயில் கொல்லொ கனங்குழை மாதர்கொல் மாலுமென் நெஞ்சு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1082; numeral=௨">
        <Coords points="0,273 2868,273 2868,306 0,306"/>
        <Baseline points="0,300 2868,300"/>
        <TextEquiv>
          <Unicode>நோக்கிநாள் நோக்கெதிர் நோக்கு தார்க்கணங்கு தாநைக்கண்டந்ந துடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1089; numeral=௩">
        <Coords points="0,306 2868,306 2868,339 0,339"/>
        <Baseline points="0,333 2868,333"/>
        <TextEquiv>
          <Unicode>பிணையெர் மடநோக்கம் நாணுமுடையார்க் கணியெவனொ வேதில தந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1086; numeral=௪">
        <Coords points="0,339 2868,339 2868,372 0,372"/>
        <Baseline points="0,366 2868,366"/>
        <TextEquiv>
          <Unicode>கொடும்புருவங் கோடா மறப்பின் அடுங்ஙயர் செய்யல மநிவள் கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1088; numeral=௫">
        <Coords points="0,372 2868,372 2868,405 0,405"/>
        <Baseline points="0,399 2868,399"/>
        <TextEquiv>
          <Unicode>ஒண்ணுதற் கொ வுடைந்ததெஞாட்பிநுள் நண்ணாருமு ட்குமென் பீடு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1087; numeral=௬">
        <Coords points="0,405 2868,405 2868,439 0,439"/>
        <Baseline points="0,433 2868,433"/>
        <TextEquiv>
          <Unicode>கடாஅக் களிற்றின்மேற் கட்படா மாதர் படா முலைமேற் துகில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1083; numeral=௭">
        <Coords points="0,439 2868,439 2868,472 0,472"/>
        <Baseline points="0,466 2868,466"/>
        <TextEquiv>
          <Unicode>பண்டறியேன் கூற்றென் பதநை யிநியறிந்தேன் பெண்டகையாற் பேரமர்க் கட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1090; numeral=௮">
        <Coords points="0,472 2868,472 2868,505 0,505"/>
        <Baseline points="0,499 2868,499"/>
        <TextEquiv>
          <Unicode>உண்டார்கண் ணல்லத டுநறாக் காமம்போற் கண்டார் மகிழ்செய்தலி ன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1084; numeral=௯">
        <Coords points="0,505 2868,505 2868,538 0,538"/>
        <Baseline points="0,532 2868,532"/>
        <TextEquiv>
          <Unicode>கண்டாரு யிருண்ணுந் தோற்றத்தாற் பெண்டகைப் பேதைக்க மர்ந்தந கண்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1085; numeral=௰">
        <Coords points="0,538 2868,538 2868,571 0,571"/>
        <Baseline points="0,565 2868,565"/>
        <TextEquiv>
          <Unicode>கூற்றமொ கண்ணொ பிணையொ மடவர நோக்கமிம் மூன்றும் உடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அணங்குகொல்லாமயில் கொல்லொ கனங்குழை மாதர்கொல் மாலுமென் நெஞ்சு
நோக்கிநாள் நோக்கெதிர் நோக்கு தார்க்கணங்கு தாநைக்கண்டந்ந துடைத்து
பிணையெர் மடநோக்கம் நாணுமுடையார்க் கணியெவனொ வேதில தந்து
கொடும்புருவங் கோடா மறப்பின் அடுங்ஙயர் செய்யல மநிவள் கண்
ஒண்ணுதற் கொ வுடைந்ததெஞாட்பிநுள் நண்ணாருமு ட்குமென் பீடு
கடாஅக் களிற்றின்மேற் கட்படா மாதர் படா முலைமேற் துகில்
பண்டறியேன் கூற்றென் பதநை யிநியறிந்தேன் பெண்டகையாற் பேரமர்க் கட்டு
உண்டார்கண் ணல்லத டுநறாக் காமம்போற் கண்டார் மகிழ்செய்தலி ன்று
கண்டாரு யிருண்ணுந் தோற்றத்தாற் பெண்டகைப் பேதைக்க மர்ந்தந கண்
கூற்றமொ கண்ணொ பிணையொ மடவர நோக்கமிம் மூன்றும் உடைத்து</Unicode>
      </TextEquiv>
