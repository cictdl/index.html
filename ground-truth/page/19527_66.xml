    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,112 2708,112 2708,491 0,491"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=631; numeral=௧">
        <Coords points="0,112 2708,112 2708,150 0,150"/>
        <Baseline points="0,143 2708,143"/>
        <TextEquiv>
          <Unicode>கருவியுங் காலமுஞ் செய்கையுஞ் செய்யும ருவிநையும மாண்டத மைச்சு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=632; numeral=௨">
        <Coords points="0,150 2708,150 2708,188 0,188"/>
        <Baseline points="0,181 2708,181"/>
        <TextEquiv>
          <Unicode>வன்கண் குடிகாத்தல் கற்றறிதலா ள்விநையோடை ந்துட னாண்டத மைச்சு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=636; numeral=௩">
        <Coords points="0,188 2708,188 2708,226 0,226"/>
        <Baseline points="0,219 2708,219"/>
        <TextEquiv>
          <Unicode>மதிநுட்பம் நூலோடு டையார்  கதிநுட்பம் யாவுள முந்நிற் பவை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=635; numeral=௪">
        <Coords points="0,226 2708,226 2708,264 0,264"/>
        <Baseline points="0,257 2708,257"/>
        <TextEquiv>
          <Unicode>அறனறிந்தா ன்றமைந்த சொல்லானெஞ் ஞான்றுந் திறனறிந்தான் றேர்ச்சித் துணை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=634; numeral=௫">
        <Coords points="0,264 2708,264 2708,302 0,302"/>
        <Baseline points="0,295 2708,295"/>
        <TextEquiv>
          <Unicode>தெரிதலுந் தேர்ந்து செயலும் ஒருதலையாய்ச் சொல்லலும் வல்லத மைச்சு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=633; numeral=௬">
        <Coords points="0,302 2708,302 2708,340 0,340"/>
        <Baseline points="0,333 2708,333"/>
        <TextEquiv>
          <Unicode>பிரித்தலும் பேணிக் கொளலும் பிரிந்தாற் பொருத்தலும் வல்ல தமைச்சு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=637; numeral=௭">
        <Coords points="0,340 2708,340 2708,378 0,378"/>
        <Baseline points="0,371 2708,371"/>
        <TextEquiv>
          <Unicode>செயற்கை யறிந்தவி டத்துமு லகத்தி யற்கை யறிந்து செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=640; numeral=௮">
        <Coords points="0,378 2708,378 2708,416 0,416"/>
        <Baseline points="0,409 2708,409"/>
        <TextEquiv>
          <Unicode>முறைப்படச் சூழ்ந்து முடிவிலவே செய்வர் திறப்பாடி லா தவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=639; numeral=௯">
        <Coords points="0,416 2708,416 2708,454 0,454"/>
        <Baseline points="0,447 2708,447"/>
        <TextEquiv>
          <Unicode>பழுதெண்ணு மந்திரியிற் பக்கததுட் டெவ்வர் எழுபது கோடி யுறும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=638; numeral=௰">
        <Coords points="0,454 2708,454 2708,491 0,491"/>
        <Baseline points="0,485 2708,485"/>
        <TextEquiv>
          <Unicode>அறிகொன்ற றியாநெனினும் உறுதி யுழையிருந்தான் கூறல் கடன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>கருவியுங் காலமுஞ் செய்கையுஞ் செய்யும ருவிநையும மாண்டத மைச்சு
வன்கண் குடிகாத்தல் கற்றறிதலா ள்விநையோடை ந்துட னாண்டத மைச்சு
மதிநுட்பம் நூலோடு டையார்  கதிநுட்பம் யாவுள முந்நிற் பவை
அறனறிந்தா ன்றமைந்த சொல்லானெஞ் ஞான்றுந் திறனறிந்தான் றேர்ச்சித் துணை
தெரிதலுந் தேர்ந்து செயலும் ஒருதலையாய்ச் சொல்லலும் வல்லத மைச்சு
பிரித்தலும் பேணிக் கொளலும் பிரிந்தாற் பொருத்தலும் வல்ல தமைச்சு
செயற்கை யறிந்தவி டத்துமு லகத்தி யற்கை யறிந்து செயல்
முறைப்படச் சூழ்ந்து முடிவிலவே செய்வர் திறப்பாடி லா தவர்
பழுதெண்ணு மந்திரியிற் பக்கததுட் டெவ்வர் எழுபது கோடி யுறும்
அறிகொன்ற றியாநெனினும் உறுதி யுழையிருந்தான் கூறல் கடன்</Unicode>
      </TextEquiv>
