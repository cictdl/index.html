    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,86 2763,86 2763,393 0,393"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1276; numeral=௧">
        <Coords points="0,86 2763,86 2763,116 0,116"/>
        <Baseline points="0,111 2763,111"/>
        <TextEquiv>
          <Unicode>பெரிதாற்றிப் பெட்பக் கலத்தல் அரிதாற்றி யனபின்மை சூழ்வ தொன்றுண்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1277; numeral=௨">
        <Coords points="0,116 2763,116 2763,147 0,147"/>
        <Baseline points="0,142 2763,142"/>
        <TextEquiv>
          <Unicode>தண்ணந் துறை வன்று ரந்தவை நம்மிநும் முந்ந முணர்ந்த   வழை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1278; numeral=௩">
        <Coords points="0,147 2763,147 2763,178 0,178"/>
        <Baseline points="0,172 2763,172"/>
        <TextEquiv>
          <Unicode>நெருநற்றுச் சென்றாரெங் காதலர் யாமு மெழுநாளெம் பேணிப் பசந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1273; numeral=௪">
        <Coords points="0,178 2763,178 2763,209 0,209"/>
        <Baseline points="0,203 2763,203"/>
        <TextEquiv>
          <Unicode>மணியிற்றிகள் தரு நூல்போல் மடந்தை யணியிற்றி கழ்வதொன்றுண்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1274; numeral=௫">
        <Coords points="0,209 2763,209 2763,240 0,240"/>
        <Baseline points="0,234 2763,234"/>
        <TextEquiv>
          <Unicode>முகைமொக்குள்ளுள்ளது நாற்றம்போற் பேதை நகைமொக்குளுள்ள தொன்றுண்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1271; numeral=௬">
        <Coords points="0,240 2763,240 2763,270 0,270"/>
        <Baseline points="0,265 2763,265"/>
        <TextEquiv>
          <Unicode>கரப்பினுங் கையிகழந் தொவ்வாநிந் நுண்கண்ணு ரைக்க லுறுவ தொன்றன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1279; numeral=௭">
        <Coords points="0,270 2763,270 2763,301 0,301"/>
        <Baseline points="0,296 2763,296"/>
        <TextEquiv>
          <Unicode>தொடிநோக்கி மென்றோளும் நோக்கி யடிநோக்கி யஃதாண்டவள்செய்தது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1275; numeral=௮">
        <Coords points="0,301 2763,301 2763,332 0,332"/>
        <Baseline points="0,326 2763,326"/>
        <TextEquiv>
          <Unicode>செறிதொடி செய்திறந்த கள்ள முறுதுயர் தீர்க்கும் மருந்தொன்றுடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1272; numeral=௯">
        <Coords points="0,332 2763,332 2763,363 0,363"/>
        <Baseline points="0,357 2763,357"/>
        <TextEquiv>
          <Unicode>கண்ணிறைந்த காரிகை காம்பேர்தோட் பேதைக்குப் பெண்ணிறைந்த நீர்மை பெரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1280; numeral=௰">
        <Coords points="0,363 2763,363 2763,393 0,393"/>
        <Baseline points="0,388 2763,388"/>
        <TextEquiv>
          <Unicode>பெண்ணீனாற் பெண்மை யுடைத்தென்பா  கண்ணிநாற் காமநோய் சொல்லி  யிரவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>பெரிதாற்றிப் பெட்பக் கலத்தல் அரிதாற்றி யனபின்மை சூழ்வ தொன்றுண்டு
தண்ணந் துறை வன்று ரந்தவை நம்மிநும் முந்ந முணர்ந்த   வழை
நெருநற்றுச் சென்றாரெங் காதலர் யாமு மெழுநாளெம் பேணிப் பசந்து
மணியிற்றிகள் தரு நூல்போல் மடந்தை யணியிற்றி கழ்வதொன்றுண்டு
முகைமொக்குள்ளுள்ளது நாற்றம்போற் பேதை நகைமொக்குளுள்ள தொன்றுண்டு
கரப்பினுங் கையிகழந் தொவ்வாநிந் நுண்கண்ணு ரைக்க லுறுவ தொன்றன்று
தொடிநோக்கி மென்றோளும் நோக்கி யடிநோக்கி யஃதாண்டவள்செய்தது
செறிதொடி செய்திறந்த கள்ள முறுதுயர் தீர்க்கும் மருந்தொன்றுடைத்து
கண்ணிறைந்த காரிகை காம்பேர்தோட் பேதைக்குப் பெண்ணிறைந்த நீர்மை பெரிது
பெண்ணீனாற் பெண்மை யுடைத்தென்பா  கண்ணிநாற் காமநோய் சொல்லி  யிரவு</Unicode>
      </TextEquiv>
    </TextRegion>
