        <Baseline points="0,347 2891,347"/>
        <TextEquiv>
          <Unicode>செருவந்த போழ்திற் சிறைசெய்யா வேந்தன் வெருவந்து வெய்து கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
