        <Baseline points="0,424 2891,424"/>
        <TextEquiv>
          <Unicode>கடிதோச்சி மெல்ல வெறிக நெடிதாக்கம் நீங்காமை வேண்டு பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=570; numeral=௰">
