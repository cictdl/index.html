      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=565; numeral=௩">
        <Coords points="0,161 2891,161 2891,199 0,199"/>
        <Baseline points="0,192 2891,192"/>
        <TextEquiv>
          <Unicode>அருஞ்செவ்வி யிந்நா முகத்தான் பெருஞ்செல்வம் பேய்கண் டந்நது டைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=563; numeral=௪">
        <Coords points="0,199 2891,199 2891,238 0,238"/>
        <Baseline points="0,231 2891,231"/>
        <TextEquiv>
          <Unicode>வெருவந்த செய்தொழுகும் வெங்கோல னாயினொ ருவந்துமொ ல்லைக் கெடும்</Unicode>
