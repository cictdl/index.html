    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,84 2792,84 2792,458 0,458"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=271; numeral=௧">
        <Coords points="0,84 2792,84 2792,121 0,121"/>
        <Baseline points="0,115 2792,115"/>
        <TextEquiv>
          <Unicode>வஞ்ச மநத்தான் படிற்றொளுக்கம் பூதங்களைந்தும் மகத்தெ நகும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=272; numeral=௨">
        <Coords points="0,121 2792,121 2792,159 0,159"/>
        <Baseline points="0,152 2792,152"/>
        <TextEquiv>
          <Unicode>வாநுயர் தோற்ற மெவன் செய்யுந் தந்நெஞ்சந் தானறி குற்ற படி</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=276; numeral=௩">
        <Coords points="0,159 2792,159 2792,196 0,196"/>
        <Baseline points="0,189 2792,189"/>
        <TextEquiv>
          <Unicode>நெஞ்சிற் றுறவார் துறந்தார்போல் வஞ்சித்து வாழ்வாரில வன்கணா ரில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=274; numeral=௪">
        <Coords points="0,196 2792,196 2792,234 0,234"/>
        <Baseline points="0,227 2792,227"/>
        <TextEquiv>
          <Unicode>தவமறந் தல்லவை செய்தல் புதன் மறைந்து வேட்டுவன் புட்செகுத் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=273; numeral=௫">
        <Coords points="0,234 2792,234 2792,271 0,271"/>
        <Baseline points="0,264 2792,264"/>
        <TextEquiv>
          <Unicode>வலியி னிலமையான் வல்லுருவம் பெற்றம் புலியின் றோற் போர்த்து மேய்ந் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=275; numeral=௬">
        <Coords points="0,271 2792,271 2792,308 0,308"/>
        <Baseline points="0,302 2792,302"/>
        <TextEquiv>
          <Unicode>பற்றற்றே மென்பார் படிற்றொளுக்க மெற்றெற்றென் றேதம் பலவுந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=277; numeral=௭">
        <Coords points="0,308 2792,308 2792,346 0,346"/>
        <Baseline points="0,339 2792,339"/>
        <TextEquiv>
          <Unicode>புறங்குன்றி கண்டநைய ரேநும் மகங்குன்றி மூக்கிற் கரியா ருடைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=279; numeral=௮">
        <Coords points="0,346 2792,346 2792,383 0,383"/>
        <Baseline points="0,376 2792,376"/>
        <TextEquiv>
          <Unicode>கநைகொடுதி யாழ்கோடு செப்பதாங் கந்ந வினைபடு பாலாற் கொளல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=280; numeral=௯">
        <Coords points="0,383 2792,383 2792,421 0,421"/>
        <Baseline points="0,414 2792,414"/>
        <TextEquiv>
          <Unicode>வழித்தலும் நீட்டலும் வேண்டா துலகம் பழித்த தொழித்து விடின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=278; numeral=௰">
        <Coords points="0,421 2792,421 2792,458 0,458"/>
        <Baseline points="0,451 2792,451"/>
        <TextEquiv>
          <Unicode>மனத்துத்கண் மாசாக மாண்டார்நீ ராடி மறைநத்தொழுகு மாந்தர் பலர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>வஞ்ச மநத்தான் படிற்றொளுக்கம் பூதங்களைந்தும் மகத்தெ நகும்
வாநுயர் தோற்ற மெவன் செய்யுந் தந்நெஞ்சந் தானறி குற்ற படி
நெஞ்சிற் றுறவார் துறந்தார்போல் வஞ்சித்து வாழ்வாரில வன்கணா ரில்
தவமறந் தல்லவை செய்தல் புதன் மறைந்து வேட்டுவன் புட்செகுத் தற்று
வலியி னிலமையான் வல்லுருவம் பெற்றம் புலியின் றோற் போர்த்து மேய்ந் தற்று
பற்றற்றே மென்பார் படிற்றொளுக்க மெற்றெற்றென் றேதம் பலவுந் தரும்
புறங்குன்றி கண்டநைய ரேநும் மகங்குன்றி மூக்கிற் கரியா ருடைத்து
கநைகொடுதி யாழ்கோடு செப்பதாங் கந்ந வினைபடு பாலாற் கொளல்
வழித்தலும் நீட்டலும் வேண்டா துலகம் பழித்த தொழித்து விடின்
மனத்துத்கண் மாசாக மாண்டார்நீ ராடி மறைநத்தொழுகு மாந்தர் பலர்</Unicode>
      </TextEquiv>
    </TextRegion>
