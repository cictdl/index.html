    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,79 2869,79 2869,460 0,460"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=841; numeral=௧">
        <Coords points="0,79 2869,79 2869,117 0,117"/>
        <Baseline points="0,110 2869,110"/>
        <TextEquiv>
          <Unicode>அறிவின்மை யின்மையுளி ன்மை பிறிதின்மை யின்மையா வையாதுலகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=843; numeral=௨">
        <Coords points="0,117 2869,117 2869,155 0,155"/>
        <Baseline points="0,148 2869,148"/>
        <TextEquiv>
          <Unicode>அறிவிலார் தாந்தம்மை பீழிக்கும் பீழை செறுவார்க்கஞ் செய்தல ரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=847; numeral=௩">
        <Coords points="0,155 2869,155 2869,193 0,193"/>
        <Baseline points="0,186 2869,186"/>
        <TextEquiv>
          <Unicode>அருமறை சோரும றிவிலான் செய்யும் பெருமிறை தாநெ தநக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=844; numeral=௪">
        <Coords points="0,193 2869,193 2869,231 0,231"/>
        <Baseline points="0,225 2869,225"/>
        <TextEquiv>
          <Unicode>வெண்மை யெநப்படுவதி யாதெநின் நொண்மை யுடமை யாமெ ந்நுஞ்செருக்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=845; numeral=௫">
        <Coords points="0,231 2869,231 2869,269 0,269"/>
        <Baseline points="0,263 2869,263"/>
        <TextEquiv>
          <Unicode>கல்லாது மேற்கொண்டொ ழுகல் கசடற வல்லதூமை யந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=849; numeral=௬">
        <Coords points="0,269 2869,269 2869,308 0,308"/>
        <Baseline points="0,301 2869,301"/>
        <TextEquiv>
          <Unicode>காணாதான் காட்டுவான் றான்காணான் காணாதான் கண்டாநாந் தான்கண்ட வாறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=846; numeral=௭">
        <Coords points="0,308 2869,308 2869,346 0,346"/>
        <Baseline points="0,339 2869,339"/>
        <TextEquiv>
          <Unicode>அற்றம் மறைத்தலொ புல்லறிவு தம்வயிற் குற்ற மறையாக் கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=848; numeral=௮">
        <Coords points="0,346 2869,346 2869,384 0,384"/>
        <Baseline points="0,377 2869,377"/>
        <TextEquiv>
          <Unicode>எவவுஞ் செய்கலான் றான்றோறான் ஒவ்வுயிர் போஒம ழவுமோர் நோய்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=842; numeral=௯">
        <Coords points="0,384 2869,384 2869,422 0,422"/>
        <Baseline points="0,415 2869,415"/>
        <TextEquiv>
          <Unicode>அறிவிலான் நெஞ்சுவந்தீ தல் பிறிதியாதுமில்லைப் பெறுவான்றவம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=850; numeral=௰">
        <Coords points="0,422 2869,422 2869,460 0,460"/>
        <Baseline points="0,453 2869,453"/>
        <TextEquiv>
          <Unicode>உலகத்தாரு ண்டென்பதி ல்லென்பான் வையத்த லகையாய் வைக்கப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அறிவின்மை யின்மையுளி ன்மை பிறிதின்மை யின்மையா வையாதுலகு
அறிவிலார் தாந்தம்மை பீழிக்கும் பீழை செறுவார்க்கஞ் செய்தல ரிது
அருமறை சோரும றிவிலான் செய்யும் பெருமிறை தாநெ தநக்கு
வெண்மை யெநப்படுவதி யாதெநின் நொண்மை யுடமை யாமெ ந்நுஞ்செருக்கு
கல்லாது மேற்கொண்டொ ழுகல் கசடற வல்லதூமை யந் தரும்
காணாதான் காட்டுவான் றான்காணான் காணாதான் கண்டாநாந் தான்கண்ட வாறு
அற்றம் மறைத்தலொ புல்லறிவு தம்வயிற் குற்ற மறையாக் கடை
எவவுஞ் செய்கலான் றான்றோறான் ஒவ்வுயிர் போஒம ழவுமோர் நோய்
அறிவிலான் நெஞ்சுவந்தீ தல் பிறிதியாதுமில்லைப் பெறுவான்றவம்
உலகத்தாரு ண்டென்பதி ல்லென்பான் வையத்த லகையாய் வைக்கப் படும்</Unicode>
      </TextEquiv>
    </TextRegion>
