    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,70 2663,70 2663,443 0,443"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=696; numeral=௧">
        <Coords points="0,70 2663,70 2663,107 0,107"/>
        <Baseline points="0,101 2663,101"/>
        <TextEquiv>
          <Unicode>குறிப்பறிந்து காலங் கருதி வெறுப்பில வேட்பச் சொலல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=697; numeral=௨">
        <Coords points="0,107 2663,107 2663,145 0,145"/>
        <Baseline points="0,138 2663,138"/>
        <TextEquiv>
          <Unicode>வேட்பந சொல்லி விநையில வெஞ்ஞான்றுங் கேட்பினுஞ் சொல்லா விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=699; numeral=௩">
        <Coords points="0,145 2663,145 2663,182 0,182"/>
        <Baseline points="0,175 2663,175"/>
        <TextEquiv>
          <Unicode>கொளப்பட்டொமெ ன்றெண்ணிக் கொள்ளாத செய்யார் நடு கற்ற காக்ஷி யவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=700; numeral=௪">
        <Coords points="0,182 2663,182 2663,219 0,219"/>
        <Baseline points="0,212 2663,212"/>
        <TextEquiv>
          <Unicode>பழையமெ நக்கருதி பண்பல்ல செய்யுங் கெழுதகமை கேடு தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=698; numeral=௫">
        <Coords points="0,219 2663,219 2663,256 0,256"/>
        <Baseline points="0,250 2663,250"/>
        <TextEquiv>
          <Unicode>இழையரி னமுறையரெ ன்றிகளர் நின்ற வொளியோடொழுகப்படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=695; numeral=௬">
        <Coords points="0,256 2663,256 2663,294 0,294"/>
        <Baseline points="0,287 2663,287"/>
        <TextEquiv>
          <Unicode>எப்பொருளுமோ ரார் துடராமற்றப்பொருள விட்டக்காற் கேட்கமறை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=691; numeral=௭">
        <Coords points="0,294 2663,294 2663,331 0,331"/>
        <Baseline points="0,324 2663,324"/>
        <TextEquiv>
          <Unicode>அகலாத ணுகாதீ  யக்காவார் போல் விகல்வேந்தை சேர்ந்தொழுகு வார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=694; numeral=௮">
        <Coords points="0,331 2663,331 2663,368 0,368"/>
        <Baseline points="0,362 2663,362"/>
        <TextEquiv>
          <Unicode>செவிச்சொல்லுஞ் சேர்ந்த நகையும வித்தொழுகலான்ற பெரியார கத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=693; numeral=௯">
        <Coords points="0,368 2663,368 2663,406 0,406"/>
        <Baseline points="0,399 2663,399"/>
        <TextEquiv>
          <Unicode>போற்றின ரியவை போற்றல் கடுத்தபின் றேற்றுதலா ர்க்கும் அரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=692; numeral=௰">
        <Coords points="0,406 2663,406 2663,443 0,443"/>
        <Baseline points="0,436 2663,436"/>
        <TextEquiv>
          <Unicode>மந்நார் விழைப விழையாமை மந்நார்ன் மந்நிய வாக்கந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>குறிப்பறிந்து காலங் கருதி வெறுப்பில வேட்பச் சொலல்
வேட்பந சொல்லி விநையில வெஞ்ஞான்றுங் கேட்பினுஞ் சொல்லா விடல்
கொளப்பட்டொமெ ன்றெண்ணிக் கொள்ளாத செய்யார் நடு கற்ற காக்ஷி யவர்
பழையமெ நக்கருதி பண்பல்ல செய்யுங் கெழுதகமை கேடு தரும்
இழையரி னமுறையரெ ன்றிகளர் நின்ற வொளியோடொழுகப்படும்
எப்பொருளுமோ ரார் துடராமற்றப்பொருள விட்டக்காற் கேட்கமறை
அகலாத ணுகாதீ  யக்காவார் போல் விகல்வேந்தை சேர்ந்தொழுகு வார்
செவிச்சொல்லுஞ் சேர்ந்த நகையும வித்தொழுகலான்ற பெரியார கத்து
போற்றின ரியவை போற்றல் கடுத்தபின் றேற்றுதலா ர்க்கும் அரிது
மந்நார் விழைப விழையாமை மந்நார்ன் மந்நிய வாக்கந் தரும்</Unicode>
      </TextEquiv>
    </TextRegion>
