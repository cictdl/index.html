    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,112 2840,112 2840,455 0,455"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1151; numeral=௧">
        <Coords points="0,112 2840,112 2840,147 0,147"/>
        <Baseline points="0,141 2840,141"/>
        <TextEquiv>
          <Unicode>செல்லாமை யுண்டேலெ மக்குரை மற்றுநின் வல்வரவு வாழ்வார்க் குரை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1156; numeral=௨">
        <Coords points="0,147 2840,147 2840,181 0,181"/>
        <Baseline points="0,175 2840,175"/>
        <TextEquiv>
          <Unicode>பிரிவுரைக்கும் வன்கண்ணரா யின் னரிதவர் நல்குவரெ ந்நும் நசை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1154; numeral=௩">
        <Coords points="0,181 2840,181 2840,215 0,215"/>
        <Baseline points="0,209 2840,209"/>
        <TextEquiv>
          <Unicode>அளித்தஞ்சலெ ன்றவர் நீப்பிற் தெளித்தசொல் தேறியார்க்கு ண்டொ தவறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1152; numeral=௪">
        <Coords points="0,215 2840,215 2840,250 0,250"/>
        <Baseline points="0,243 2840,243"/>
        <TextEquiv>
          <Unicode>இன்கணுடைத்தவார் பார்வல் பிரிவெந்நும் புன்கணு டைத்தார் புணர்வு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1157; numeral=௫">
        <Coords points="0,250 2840,250 2840,284 0,284"/>
        <Baseline points="0,278 2840,278"/>
        <TextEquiv>
          <Unicode>துறைவன் றுறந்தமை தோற்றாகொல் முன்கை யிறையிறவா நின்ற வளை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1158; numeral=௬">
        <Coords points="0,284 2840,284 2840,318 0,318"/>
        <Baseline points="0,312 2840,312"/>
        <TextEquiv>
          <Unicode>இந்நா திநிந்ல்லூர் வாழ்தல தநிநும் யிந்நாதி நியார்ப் பிரிவு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1159; numeral=௭">
        <Coords points="0,318 2840,318 2840,352 0,352"/>
        <Baseline points="0,346 2840,346"/>
        <TextEquiv>
          <Unicode>தொடிற்சுடும ல்லது காமநோய் போல விடிற்சுடலா ற்றுமொ தீய</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1160; numeral=௮">
        <Coords points="0,352 2840,352 2840,386 0,386"/>
        <Baseline points="0,380 2840,380"/>
        <TextEquiv>
          <Unicode>அரிதாற்றி யல்லல்நோய் நீக்கிப் பெரிதாற்றிப் பிந்நிருந்து வாழ்வார் பலர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1155; numeral=௯">
        <Coords points="0,386 2840,386 2840,421 0,421"/>
        <Baseline points="0,415 2840,415"/>
        <TextEquiv>
          <Unicode>ஓம்பின மைந்தார் பிரிவோம்பல் மற்றவர் நீங்கின ரிதாற் புணர்வு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1153; numeral=௰">
        <Coords points="0,421 2840,421 2840,455 0,455"/>
        <Baseline points="0,449 2840,449"/>
        <TextEquiv>
          <Unicode>அரிதரொ தேற்றம் அறிவுடையார் கண்ணும் பிரிவோ ரிடத்துண்மை யால்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>செல்லாமை யுண்டேலெ மக்குரை மற்றுநின் வல்வரவு வாழ்வார்க் குரை
பிரிவுரைக்கும் வன்கண்ணரா யின் னரிதவர் நல்குவரெ ந்நும் நசை
அளித்தஞ்சலெ ன்றவர் நீப்பிற் தெளித்தசொல் தேறியார்க்கு ண்டொ தவறு
இன்கணுடைத்தவார் பார்வல் பிரிவெந்நும் புன்கணு டைத்தார் புணர்வு
துறைவன் றுறந்தமை தோற்றாகொல் முன்கை யிறையிறவா நின்ற வளை
இந்நா திநிந்ல்லூர் வாழ்தல தநிநும் யிந்நாதி நியார்ப் பிரிவு
தொடிற்சுடும ல்லது காமநோய் போல விடிற்சுடலா ற்றுமொ தீய
அரிதாற்றி யல்லல்நோய் நீக்கிப் பெரிதாற்றிப் பிந்நிருந்து வாழ்வார் பலர்
ஓம்பின மைந்தார் பிரிவோம்பல் மற்றவர் நீங்கின ரிதாற் புணர்வு
அரிதரொ தேற்றம் அறிவுடையார் கண்ணும் பிரிவோ ரிடத்துண்மை யால்</Unicode>
      </TextEquiv>
