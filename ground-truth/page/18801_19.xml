    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,185 2965,185 2965,577 0,577"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=161; numeral=௧">
        <Coords points="0,185 2965,185 2965,224 0,224"/>
        <Baseline points="0,217 2965,217"/>
        <TextEquiv>
          <Unicode>ஒழுக்காறாக் கொள்க வொருவன்றன் நெஞ்சத் தளுக்காறி ல்லாத வியல்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=162; numeral=௨">
        <Coords points="0,224 2965,224 2965,263 0,263"/>
        <Baseline points="0,256 2965,256"/>
        <TextEquiv>
          <Unicode>விழுப்பேற்றி னஃதொப்ப தில்லையார் மாட்டு மளுக்காற்றி னன்மை பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=163; numeral=௩">
        <Coords points="0,263 2965,263 2965,303 0,303"/>
        <Baseline points="0,296 2965,296"/>
        <TextEquiv>
          <Unicode>அறனாக்கம் வேண்டாதா னென்பான் பிறனாக்கம் பேணா தழுக்கறுப் பான்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=164; numeral=௪">
        <Coords points="0,303 2965,303 2965,342 0,342"/>
        <Baseline points="0,335 2965,335"/>
        <TextEquiv>
          <Unicode>அழுக்காற்றி னல்லவை செய்யா ரிழுக்காற்றி நேதம் படும்பாக் கறிந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=165; numeral=௫">
        <Coords points="0,342 2965,342 2965,381 0,381"/>
        <Baseline points="0,374 2965,374"/>
        <TextEquiv>
          <Unicode>அழுக்கா றுடையாற் கதுசாலு மொந்நார் வழுக்கியுங் கேடீன் பது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=166; numeral=௬">
        <Coords points="0,381 2965,381 2965,420 0,420"/>
        <Baseline points="0,413 2965,413"/>
        <TextEquiv>
          <Unicode>கெடுப்ப தழுக்கறுப்பான் சுற்றம் உடுப்பதூம் உண்பதூம் யின்றிக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=167; numeral=௭">
        <Coords points="0,420 2965,420 2965,459 0,459"/>
        <Baseline points="0,452 2965,452"/>
        <TextEquiv>
          <Unicode>அவ்வித் தழுக்காறு டையாநைச் செய்யவ டவ்வையைக் காட்டி விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=168; numeral=௮">
        <Coords points="0,459 2965,459 2965,499 0,499"/>
        <Baseline points="0,492 2965,492"/>
        <TextEquiv>
          <Unicode>அழுக்கா றெநவொரு பாவி திருச்செற்றுத் தீயுழி யுய்த்து விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=169; numeral=௯">
        <Coords points="0,499 2965,499 2965,538 0,538"/>
        <Baseline points="0,531 2965,531"/>
        <TextEquiv>
          <Unicode>அவ்விய நெஞ்சத்தா னாக்கமுஞ் செவ்வியான்  நினைக்கப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=170; numeral=௰">
        <Coords points="0,538 2965,538 2965,577 0,577"/>
        <Baseline points="0,570 2965,570"/>
        <TextEquiv>
          <Unicode>அழுக்காற் றகன்றாரு மில்லையஃ திலார் பெருக்கத்திற் தீர்ந்தாரு மில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>ஒழுக்காறாக் கொள்க வொருவன்றன் நெஞ்சத் தளுக்காறி ல்லாத வியல்பு
விழுப்பேற்றி னஃதொப்ப தில்லையார் மாட்டு மளுக்காற்றி னன்மை பெறின்
அறனாக்கம் வேண்டாதா னென்பான் பிறனாக்கம் பேணா தழுக்கறுப் பான்
அழுக்காற்றி னல்லவை செய்யா ரிழுக்காற்றி நேதம் படும்பாக் கறிந்து
அழுக்கா றுடையாற் கதுசாலு மொந்நார் வழுக்கியுங் கேடீன் பது
கெடுப்ப தழுக்கறுப்பான் சுற்றம் உடுப்பதூம் உண்பதூம் யின்றிக் கெடும்
அவ்வித் தழுக்காறு டையாநைச் செய்யவ டவ்வையைக் காட்டி விடும்
அழுக்கா றெநவொரு பாவி திருச்செற்றுத் தீயுழி யுய்த்து விடும்
அவ்விய நெஞ்சத்தா னாக்கமுஞ் செவ்வியான்  நினைக்கப் படும்
அழுக்காற் றகன்றாரு மில்லையஃ திலார் பெருக்கத்திற் தீர்ந்தாரு மில்</Unicode>
      </TextEquiv>
