    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,174 3021,174 3021,579 0,579"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=81; numeral=௧">
        <Coords points="0,174 3021,174 3021,215 0,215"/>
        <Baseline points="0,207 3021,207"/>
        <TextEquiv>
          <Unicode>யிருந்தோம்பி யில்வாழ்வ தெல்லாம் விருந்தோம்பி வேளாண்மை செய்தற் பொருட்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=82; numeral=௨">
        <Coords points="0,215 3021,215 3021,255 0,255"/>
        <Baseline points="0,248 3021,248"/>
        <TextEquiv>
          <Unicode>விருந்து புறத்ததாற்றா னுண்டல் சாவா மருந்தெநினும் வேண்டற்பாற் றன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=83; numeral=௩">
        <Coords points="0,255 3021,255 3021,296 0,296"/>
        <Baseline points="0,288 3021,288"/>
        <TextEquiv>
          <Unicode>வருவிருந்து வைகலு மோம்புவான் வாழ்க்கை பருவந்து பாழ்படுத லின்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=84; numeral=௪">
        <Coords points="0,296 3021,296 3021,336 0,336"/>
        <Baseline points="0,329 3021,329"/>
        <TextEquiv>
          <Unicode>அகனமர்ந்து செய்யா ளுறையு முகனமர்ந்து நல்விருந் தோம்புவாநில்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=85; numeral=௫">
        <Coords points="0,336 3021,336 3021,377 0,377"/>
        <Baseline points="0,369 3021,369"/>
        <TextEquiv>
          <Unicode>வித்து மிட வேண்டுங் கொல்லோ விருந்தோம்பி மிச்சின் மிசைவான்புலம்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=86; numeral=௬">
        <Coords points="0,377 3021,377 3021,417 0,417"/>
        <Baseline points="0,410 3021,410"/>
        <TextEquiv>
          <Unicode>செல்விருந் தோம்பி வருவிருந்து பார்த்திருப்பான் நல்விருந்து வானத் தவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=87; numeral=௭">
        <Coords points="0,417 3021,417 3021,458 0,458"/>
        <Baseline points="0,451 3021,451"/>
        <TextEquiv>
          <Unicode>இநைத்துணைத் தென்ப தொன் றில்லை விருந்தின் திநைத்துணை வேழ்விப் பயன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=88; numeral=௮">
        <Coords points="0,458 3021,458 3021,498 0,498"/>
        <Baseline points="0,491 3021,491"/>
        <TextEquiv>
          <Unicode>பரிந்தோம்பிப் பற்றற்றோ மென்பர் விருந்தோம்பி வேழ்வித் தலைப்படாதார்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=89; numeral=௯">
        <Coords points="0,498 3021,498 3021,539 0,539"/>
        <Baseline points="0,532 3021,532"/>
        <TextEquiv>
          <Unicode>உடைமையு ளின்மை விருந்தோம்ப லோம்பா மடமை மடவார்க ணுண்டு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=90; numeral=௰">
        <Coords points="0,539 3021,539 3021,579 0,579"/>
        <Baseline points="0,572 3021,572"/>
        <TextEquiv>
          <Unicode>மோப்பக் குழையு மநிச்ச முகந்திரிந்து நோக்கக் குழையும் விருந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>யிருந்தோம்பி யில்வாழ்வ தெல்லாம் விருந்தோம்பி வேளாண்மை செய்தற் பொருட்டு
விருந்து புறத்ததாற்றா னுண்டல் சாவா மருந்தெநினும் வேண்டற்பாற் றன்று
வருவிருந்து வைகலு மோம்புவான் வாழ்க்கை பருவந்து பாழ்படுத லின்று
அகனமர்ந்து செய்யா ளுறையு முகனமர்ந்து நல்விருந் தோம்புவாநில்
வித்து மிட வேண்டுங் கொல்லோ விருந்தோம்பி மிச்சின் மிசைவான்புலம்
செல்விருந் தோம்பி வருவிருந்து பார்த்திருப்பான் நல்விருந்து வானத் தவர்க்கு
இநைத்துணைத் தென்ப தொன் றில்லை விருந்தின் திநைத்துணை வேழ்விப் பயன்
பரிந்தோம்பிப் பற்றற்றோ மென்பர் விருந்தோம்பி வேழ்வித் தலைப்படாதார்
உடைமையு ளின்மை விருந்தோம்ப லோம்பா மடமை மடவார்க ணுண்டு
மோப்பக் குழையு மநிச்ச முகந்திரிந்து நோக்கக் குழையும் விருந்து</Unicode>
      </TextEquiv>
    </TextRegion>
