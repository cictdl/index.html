    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,81 2911,81 2911,468 0,468"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=943; numeral=௧">
        <Coords points="0,81 2911,81 2911,119 0,119"/>
        <Baseline points="0,112 2911,112"/>
        <TextEquiv>
          <Unicode>அற்றால் ளவறிந்து ண்க வஃதுடம்பு பெற்றா நெடிதுய்க்குமாறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=942; numeral=௨">
        <Coords points="0,119 2911,119 2911,158 0,158"/>
        <Baseline points="0,151 2911,151"/>
        <TextEquiv>
          <Unicode>மருந்தெந வேண்டாவாமாக்கைக் கருந்தியதற்றமை போற்றி யுணின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=947; numeral=௩">
        <Coords points="0,158 2911,158 2911,197 0,197"/>
        <Baseline points="0,190 2911,190"/>
        <TextEquiv>
          <Unicode>தீயள வின்றித் தெரியான் பெரிதுண்ணின் நோயள வன்றிப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=946; numeral=௪">
        <Coords points="0,197 2911,197 2911,236 0,236"/>
        <Baseline points="0,229 2911,229"/>
        <TextEquiv>
          <Unicode>இழிவறிந்து ண்பான்கண் ணின்பம்போல் நிற்குங் களிபேரி றையான்கண் ணோய்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=941; numeral=௫">
        <Coords points="0,236 2911,236 2911,274 0,274"/>
        <Baseline points="0,267 2911,267"/>
        <TextEquiv>
          <Unicode>மிகுநுங் குறையிநும் நோய்செய்யும் நூலோர் வழிமுதலா யெண்ணிய முன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=949; numeral=௬">
        <Coords points="0,274 2911,274 2911,313 0,313"/>
        <Baseline points="0,306 2911,306"/>
        <TextEquiv>
          <Unicode>உற்றான் ழவும் பிணியழவுங் காலமுங் கற்றான் கருதிச் செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=948; numeral=௭">
        <Coords points="0,313 2911,313 2911,352 0,352"/>
        <Baseline points="0,345 2911,345"/>
        <TextEquiv>
          <Unicode>நோய்நாடி நோய்முதல் நாடி யதுதணிக்கும் வாய்நாடி வாய்ப்பச் செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=945; numeral=௮">
        <Coords points="0,352 2911,352 2911,391 0,391"/>
        <Baseline points="0,384 2911,384"/>
        <TextEquiv>
          <Unicode>மாறுபாடி ல்லாத வுண்டி மறுத்துண்ணி னூறுபாடில்லை யுயிர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=950; numeral=௯">
        <Coords points="0,391 2911,391 2911,430 0,430"/>
        <Baseline points="0,423 2911,423"/>
        <TextEquiv>
          <Unicode>உற்றவன் றீர்ப்பான் மருந்துழைச் செல்வாநென்நடபா நாற் கூற்றெ மருந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=944; numeral=௰">
        <Coords points="0,430 2911,430 2911,468 0,468"/>
        <Baseline points="0,461 2911,461"/>
        <TextEquiv>
          <Unicode>அற்றத றிந்து கடைப்பிடித்து மாரல்ல துய்க்க துவரப் பசித்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>அற்றால் ளவறிந்து ண்க வஃதுடம்பு பெற்றா நெடிதுய்க்குமாறு
மருந்தெந வேண்டாவாமாக்கைக் கருந்தியதற்றமை போற்றி யுணின்
தீயள வின்றித் தெரியான் பெரிதுண்ணின் நோயள வன்றிப் படும்
இழிவறிந்து ண்பான்கண் ணின்பம்போல் நிற்குங் களிபேரி றையான்கண் ணோய்
மிகுநுங் குறையிநும் நோய்செய்யும் நூலோர் வழிமுதலா யெண்ணிய முன்று
உற்றான் ழவும் பிணியழவுங் காலமுங் கற்றான் கருதிச் செயல்
நோய்நாடி நோய்முதல் நாடி யதுதணிக்கும் வாய்நாடி வாய்ப்பச் செயல்
மாறுபாடி ல்லாத வுண்டி மறுத்துண்ணி னூறுபாடில்லை யுயிர்க்கு
உற்றவன் றீர்ப்பான் மருந்துழைச் செல்வாநென்நடபா நாற் கூற்றெ மருந்து
அற்றத றிந்து கடைப்பிடித்து மாரல்ல துய்க்க துவரப் பசித்து</Unicode>
      </TextEquiv>
    </TextRegion>
