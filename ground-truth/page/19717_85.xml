    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,79 2861,79 2861,458 0,458"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=821; numeral=௧">
        <Coords points="0,79 2861,79 2861,117 0,117"/>
        <Baseline points="0,110 2861,110"/>
        <TextEquiv>
          <Unicode>சீரிடங் காணினெ றிதற்குப் பட்டடை நேரா நிரந்தவர் நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=828; numeral=௨">
        <Coords points="0,117 2861,117 2861,155 0,155"/>
        <Baseline points="0,148 2861,148"/>
        <TextEquiv>
          <Unicode>தொழுதகை யுள்ளும் படையொடுங்குமொ ந்நார ழுதகண் ணீருமநைத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=822; numeral=௩">
        <Coords points="0,155 2861,155 2861,193 0,193"/>
        <Baseline points="0,186 2861,186"/>
        <TextEquiv>
          <Unicode>இநம்பொன்றி நமல்லார் கேண்மை மகழீர் மநம்போல வேறு படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=823; numeral=௪">
        <Coords points="0,193 2861,193 2861,231 0,231"/>
        <Baseline points="0,224 2861,224"/>
        <TextEquiv>
          <Unicode>பலநல்ல கற்றக் கடைத்தும் மநநல்லரா குதல் மாணார்க்க ரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=824; numeral=௫">
        <Coords points="0,231 2861,231 2861,268 0,268"/>
        <Baseline points="0,262 2861,262"/>
        <TextEquiv>
          <Unicode>முகத்தினி னிய வகாவ கத்திந்நர்  வஞ்சரை யஞ்சப்படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=825; numeral=௬">
        <Coords points="0,268 2861,268 2861,306 0,306"/>
        <Baseline points="0,299 2861,299"/>
        <TextEquiv>
          <Unicode>மநத்தின மையா தவரை யெநைத்தொன்றுஞ் சொல்லிநாற் றேறற்றபாற் றன்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=827; numeral=௭">
        <Coords points="0,306 2861,306 2861,344 0,344"/>
        <Baseline points="0,337 2861,337"/>
        <TextEquiv>
          <Unicode>சொல்வணக்கமொ ந்நார்கட் கொள்ளற்க வில்வணக்கந் தீங்கு குறித்தன்மை யான்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=826; numeral=௮">
        <Coords points="0,344 2861,344 2861,382 0,382"/>
        <Baseline points="0,375 2861,375"/>
        <TextEquiv>
          <Unicode>நட்டார்போல் நல்லவை சொல்லிநும் ஒட்டார்சொல்லொல்லை யுணரப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=830; numeral=௯">
        <Coords points="0,382 2861,382 2861,420 0,420"/>
        <Baseline points="0,413 2861,413"/>
        <TextEquiv>
          <Unicode>பகைநட்பாங் காலம் வருங்கான் முக நட்ட கநட்போ்ரிஇ விடல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=829; numeral=௰">
        <Coords points="0,420 2861,420 2861,458 0,458"/>
        <Baseline points="0,451 2861,451"/>
        <TextEquiv>
          <Unicode>மிகச்செய்து தம்மெள்ளு வாரை நகச்செய்து நட்பினுட் சாப்புல்லற் பாற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>சீரிடங் காணினெ றிதற்குப் பட்டடை நேரா நிரந்தவர் நட்பு
தொழுதகை யுள்ளும் படையொடுங்குமொ ந்நார ழுதகண் ணீருமநைத்து
இநம்பொன்றி நமல்லார் கேண்மை மகழீர் மநம்போல வேறு படும்
பலநல்ல கற்றக் கடைத்தும் மநநல்லரா குதல் மாணார்க்க ரிது
முகத்தினி னிய வகாவ கத்திந்நர்  வஞ்சரை யஞ்சப்படும்
மநத்தின மையா தவரை யெநைத்தொன்றுஞ் சொல்லிநாற் றேறற்றபாற் றன்று
சொல்வணக்கமொ ந்நார்கட் கொள்ளற்க வில்வணக்கந் தீங்கு குறித்தன்மை யான்
நட்டார்போல் நல்லவை சொல்லிநும் ஒட்டார்சொல்லொல்லை யுணரப் படும்
பகைநட்பாங் காலம் வருங்கான் முக நட்ட கநட்போ்ரிஇ விடல்
மிகச்செய்து தம்மெள்ளு வாரை நகச்செய்து நட்பினுட் சாப்புல்லற் பாற்று</Unicode>
      </TextEquiv>
    </TextRegion>
