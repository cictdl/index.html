    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,98 2721,98 2721,465 0,465"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=331; numeral=௧">
        <Coords points="0,98 2721,98 2721,135 0,135"/>
        <Baseline points="0,129 2721,129"/>
        <TextEquiv>
          <Unicode>நில்லா தவத்தை நிலையெந வென்றுணரும் புல்லறி வாண்மை கடை</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=337; numeral=௨">
        <Coords points="0,135 2721,135 2721,172 0,172"/>
        <Baseline points="0,165 2721,165"/>
        <TextEquiv>
          <Unicode>ஒருபொளுது வாழ்வதறியாரு வகத்துக் கருதுவ கோடியு மல்ல பல</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=336; numeral=௩">
        <Coords points="0,172 2721,172 2721,209 0,209"/>
        <Baseline points="0,202 2721,202"/>
        <TextEquiv>
          <Unicode>நெருநலுளநொருவ னின்றில்லை யெந்நும் பெருமை யுடைத்திவ் வுலகு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=334; numeral=௪">
        <Coords points="0,209 2721,209 2721,245 0,245"/>
        <Baseline points="0,239 2721,239"/>
        <TextEquiv>
          <Unicode>நாளெந வொன்றுபோற் காட்டி யுயிரீரும் வாள துணர்வார்ப் பெறின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=339; numeral=௫">
        <Coords points="0,245 2721,245 2721,282 0,282"/>
        <Baseline points="0,275 2721,275"/>
        <TextEquiv>
          <Unicode>உறங்கு வதுபோலுஞ் சாக்கா டுறங்கி விழிப்பது போலும் பிறப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=338; numeral=௬">
        <Coords points="0,282 2721,282 2721,319 0,319"/>
        <Baseline points="0,312 2721,312"/>
        <TextEquiv>
          <Unicode>குடம்பை தநித்தொழியப் புட்பறந் தற்றெ உடம்போ டுயிரிடை நட்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=340; numeral=௭">
        <Coords points="0,319 2721,319 2721,355 0,355"/>
        <Baseline points="0,349 2721,349"/>
        <TextEquiv>
          <Unicode>புக்கிலமைந்தின்று கொல்லோ உடம்பினுட் டுச்சி லிருந்த வுயிர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=335; numeral=௮">
        <Coords points="0,355 2721,355 2721,392 0,392"/>
        <Baseline points="0,385 2721,385"/>
        <TextEquiv>
          <Unicode>நாச்செற்று விக்கன்மேல் வாராமுந்நல்விநை மேற்சென்று செய்யப் படும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=333; numeral=௯">
        <Coords points="0,392 2721,392 2721,429 0,429"/>
        <Baseline points="0,422 2721,422"/>
        <TextEquiv>
          <Unicode>அற்கா வியல்பிற்றுச் செல்வ மது பெற்றா லற்குப் வாங்கெ செயல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=332; numeral=௰">
        <Coords points="0,429 2721,429 2721,465 0,465"/>
        <Baseline points="0,459 2721,459"/>
        <TextEquiv>
          <Unicode>கூத்தாட் டவைக்குழாத் தற்றெ பெருஞ்செல்வம் போக்கு மதுவிழிந் தற்று</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>நில்லா தவத்தை நிலையெந வென்றுணரும் புல்லறி வாண்மை கடை
ஒருபொளுது வாழ்வதறியாரு வகத்துக் கருதுவ கோடியு மல்ல பல
நெருநலுளநொருவ னின்றில்லை யெந்நும் பெருமை யுடைத்திவ் வுலகு
நாளெந வொன்றுபோற் காட்டி யுயிரீரும் வாள துணர்வார்ப் பெறின்
உறங்கு வதுபோலுஞ் சாக்கா டுறங்கி விழிப்பது போலும் பிறப்பு
குடம்பை தநித்தொழியப் புட்பறந் தற்றெ உடம்போ டுயிரிடை நட்பு
புக்கிலமைந்தின்று கொல்லோ உடம்பினுட் டுச்சி லிருந்த வுயிர்க்கு
நாச்செற்று விக்கன்மேல் வாராமுந்நல்விநை மேற்சென்று செய்யப் படும்
அற்கா வியல்பிற்றுச் செல்வ மது பெற்றா லற்குப் வாங்கெ செயல்
கூத்தாட் டவைக்குழாத் தற்றெ பெருஞ்செல்வம் போக்கு மதுவிழிந் தற்று</Unicode>
      </TextEquiv>
    </TextRegion>
