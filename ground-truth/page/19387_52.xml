    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,74 2816,74 2816,453 0,453"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=498; numeral=௧">
        <Coords points="0,74 2816,74 2816,112 0,112"/>
        <Baseline points="0,105 2816,105"/>
        <TextEquiv>
          <Unicode>சிறுபடையான் செல்லிடஞ் சேரின் உறுபடையானூக்கம ழிந்து விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=492; numeral=௨">
        <Coords points="0,112 2816,112 2816,150 0,150"/>
        <Baseline points="0,143 2816,143"/>
        <TextEquiv>
          <Unicode>முரண்சேர்ந்த மொய்ம்பி னவர்க்கும அரண்சேர்ந்தாமா க்கம் பலவுந் தரும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=499; numeral=௩">
        <Coords points="0,150 2816,150 2816,188 0,188"/>
        <Baseline points="0,181 2816,181"/>
        <TextEquiv>
          <Unicode>சிறைநலனுஞ் சீருமி லரெநினும் மாந்தரு றைநிலத்தோடொ ட்டல ரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=495; numeral=௪">
        <Coords points="0,188 2816,188 2816,225 0,225"/>
        <Baseline points="0,219 2816,219"/>
        <TextEquiv>
          <Unicode>நெடும்புனலுள் வெல்லு முதலை யடும்புநலை நீங்கின தநைப் பிற</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=500; numeral=௫">
        <Coords points="0,225 2816,225 2816,263 0,263"/>
        <Baseline points="0,257 2816,257"/>
        <TextEquiv>
          <Unicode>காலாழ் களரின் னரியடுங் கண்ணஞ்சா வேலாண் முகத்த களிறு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=496; numeral=௬">
        <Coords points="0,263 2816,263 2816,301 0,301"/>
        <Baseline points="0,294 2816,294"/>
        <TextEquiv>
          <Unicode>கடலோடா காவல் நெடுந்தேர் கடலோடு நாவாயுமோ டா நிலத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=497; numeral=௭">
        <Coords points="0,301 2816,301 2816,339 0,339"/>
        <Baseline points="0,332 2816,332"/>
        <TextEquiv>
          <Unicode>அஞ்சாமை யல்லாற் றுணைவேண்டா வெஞ்சாமை யெண்ணி யிடத்தாற் செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=494; numeral=௮">
        <Coords points="0,339 2816,339 2816,377 0,377"/>
        <Baseline points="0,370 2816,370"/>
        <TextEquiv>
          <Unicode>எண்ணியாரெ ண்ணமி ழப்பரி டனறிந்து துந்நியார் துந்நிச் செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=493; numeral=௯">
        <Coords points="0,377 2816,377 2816,415 0,415"/>
        <Baseline points="0,408 2816,408"/>
        <TextEquiv>
          <Unicode>ஆற்றாருமா ற்றி யடுப விடனறிந்து போற்றார்கட் போற்றிச் செயின்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=491; numeral=௰">
        <Coords points="0,415 2816,415 2816,453 0,453"/>
        <Baseline points="0,446 2816,446"/>
        <TextEquiv>
          <Unicode>துடங்கற்க வெவ்விநையுமெ ள்ளற்க முற்றுமி டங்கண்ட பின்னல் லது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>சிறுபடையான் செல்லிடஞ் சேரின் உறுபடையானூக்கம ழிந்து விடும்
முரண்சேர்ந்த மொய்ம்பி னவர்க்கும அரண்சேர்ந்தாமா க்கம் பலவுந் தரும்
சிறைநலனுஞ் சீருமி லரெநினும் மாந்தரு றைநிலத்தோடொ ட்டல ரிது
நெடும்புனலுள் வெல்லு முதலை யடும்புநலை நீங்கின தநைப் பிற
காலாழ் களரின் னரியடுங் கண்ணஞ்சா வேலாண் முகத்த களிறு
கடலோடா காவல் நெடுந்தேர் கடலோடு நாவாயுமோ டா நிலத்து
அஞ்சாமை யல்லாற் றுணைவேண்டா வெஞ்சாமை யெண்ணி யிடத்தாற் செயின்
எண்ணியாரெ ண்ணமி ழப்பரி டனறிந்து துந்நியார் துந்நிச் செயின்
ஆற்றாருமா ற்றி யடுப விடனறிந்து போற்றார்கட் போற்றிச் செயின்
துடங்கற்க வெவ்விநையுமெ ள்ளற்க முற்றுமி டங்கண்ட பின்னல் லது</Unicode>
      </TextEquiv>
    </TextRegion>
