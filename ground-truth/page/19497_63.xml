    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,63 2635,63 2635,422 0,422"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=610; numeral=௧">
        <Coords points="0,63 2635,63 2635,99 0,99"/>
        <Baseline points="0,92 2635,92"/>
        <TextEquiv>
          <Unicode>மடியிலா மந்நவனெ ய்தும் அடியளந்தான் றாய தெநலாமொ ருங்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=609; numeral=௨">
        <Coords points="0,99 2635,99 2635,135 0,135"/>
        <Baseline points="0,128 2635,128"/>
        <TextEquiv>
          <Unicode>குடியாண்மை யுள்வந்த குற்றமொ ருவன் மடியாண்மை மாற்றக் கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=602; numeral=௩">
        <Coords points="0,135 2635,135 2635,171 0,171"/>
        <Baseline points="0,164 2635,164"/>
        <TextEquiv>
          <Unicode>மடியை மடியா லொளுகல் குடியைக் குடியாக வேண்டு பவர்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=601; numeral=௪">
        <Coords points="0,171 2635,171 2635,207 0,207"/>
        <Baseline points="0,200 2635,200"/>
        <TextEquiv>
          <Unicode>குடியெந்நுங் குன்றா விளக்கம் மடியெந்நு மாசூர மாய்ந்து கெடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=604; numeral=௫">
        <Coords points="0,207 2635,207 2635,243 0,243"/>
        <Baseline points="0,236 2635,236"/>
        <TextEquiv>
          <Unicode>குடிமடிந்து குற்றம் பெருகும் மடிமடிந்து மாண்ட வுஞற்றி லவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=603; numeral=௬">
        <Coords points="0,243 2635,243 2635,279 0,279"/>
        <Baseline points="0,272 2635,272"/>
        <TextEquiv>
          <Unicode>குடிமடிக் கொண்டொளுகும் பேதை பிறந்த குடிமடியுமந் தந்நிநும முந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=608; numeral=௭">
        <Coords points="0,279 2635,279 2635,314 0,314"/>
        <Baseline points="0,308 2635,308"/>
        <TextEquiv>
          <Unicode>மடிமை குடிமைக்கட் டங்கிற்றம் மொந்நார்க்க டிமை புகுத்தி விடும்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=607; numeral=௮">
        <Coords points="0,314 2635,314 2635,350 0,350"/>
        <Baseline points="0,344 2635,344"/>
        <TextEquiv>
          <Unicode>இடிபுரிந்தெ ள்ளுஞ் சொல் கேட்பர் மடிபுரிந்து மாண்ட உஞற்றி லவர்க்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=606; numeral=௯">
        <Coords points="0,350 2635,350 2635,386 0,386"/>
        <Baseline points="0,380 2635,380"/>
        <TextEquiv>
          <Unicode>படியுடையார் பற்றமைந்தக் கண்ணும் மடியுடையாரன் மாண்பயமெ ய்தல ரிது</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=605; numeral=௰">
        <Coords points="0,386 2635,386 2635,422 0,422"/>
        <Baseline points="0,416 2635,416"/>
        <TextEquiv>
          <Unicode>நெடுநீர் மறவி மடிதுயின் னான்கும்  கெடுநீராக் காமக் கலன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>மடியிலா மந்நவனெ ய்தும் அடியளந்தான் றாய தெநலாமொ ருங்கு
குடியாண்மை யுள்வந்த குற்றமொ ருவன் மடியாண்மை மாற்றக் கெடும்
மடியை மடியா லொளுகல் குடியைக் குடியாக வேண்டு பவர்
குடியெந்நுங் குன்றா விளக்கம் மடியெந்நு மாசூர மாய்ந்து கெடும்
குடிமடிந்து குற்றம் பெருகும் மடிமடிந்து மாண்ட வுஞற்றி லவர்க்கு
குடிமடிக் கொண்டொளுகும் பேதை பிறந்த குடிமடியுமந் தந்நிநும முந்து
மடிமை குடிமைக்கட் டங்கிற்றம் மொந்நார்க்க டிமை புகுத்தி விடும்
இடிபுரிந்தெ ள்ளுஞ் சொல் கேட்பர் மடிபுரிந்து மாண்ட உஞற்றி லவர்க்கு
படியுடையார் பற்றமைந்தக் கண்ணும் மடியுடையாரன் மாண்பயமெ ய்தல ரிது
நெடுநீர் மறவி மடிதுயின் னான்கும்  கெடுநீராக் காமக் கலன்</Unicode>
      </TextEquiv>
    </TextRegion>
