    <TextRegion id="r_main" type="paragraph" custom="readingOrder {index:0;}">
      <Coords points="0,120 2835,120 2835,432 0,432"/>
      <TextLine id="r_main_l1" custom="readingOrder {index:0;}" comments="kural=1266; numeral=௧">
        <Coords points="0,120 2835,120 2835,151 0,151"/>
        <Baseline points="0,146 2835,146"/>
        <TextEquiv>
          <Unicode>பருகமநற் கொண்கநை யொருநாட ருநாழ் பருவால பைதல்நோ யெல்லாங்கெட</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l2" custom="readingOrder {index:1;}" comments="kural=1265; numeral=௨">
        <Coords points="0,151 2835,151 2835,183 0,183"/>
        <Baseline points="0,177 2835,177"/>
        <TextEquiv>
          <Unicode>காண்கமநற் கொண்கநைக் கண்ணாரக் கண்டபின் நீங்கு துமெனறேட பசப்பு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l3" custom="readingOrder {index:2;}" comments="kural=1268; numeral=௩">
        <Coords points="0,183 2835,183 2835,214 0,214"/>
        <Baseline points="0,208 2835,208"/>
        <TextEquiv>
          <Unicode>விநைகலந்து வென்றீக வெந்தன்  மநைகலந்து மாலையை யாகம் விருந்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l4" custom="readingOrder {index:3;}" comments="kural=1267; numeral=௪">
        <Coords points="0,214 2835,214 2835,245 0,245"/>
        <Baseline points="0,239 2835,239"/>
        <TextEquiv>
          <Unicode>புலப்பென்கொல் புல்லுவென்கொல்லோ கலப்பென்கொல் கணைந்ந கேழீர் விரன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l5" custom="readingOrder {index:4;}" comments="kural=1262; numeral=௫">
        <Coords points="0,245 2835,245 2835,276 0,276"/>
        <Baseline points="0,271 2835,271"/>
        <TextEquiv>
          <Unicode>இலங்கிழாயென்று மறப்பிநென்றேண்மேற் கலங்கழியுங் காரிகை நீத்து</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l6" custom="readingOrder {index:5;}" comments="kural=1264; numeral=௬">
        <Coords points="0,276 2835,276 2835,307 0,307"/>
        <Baseline points="0,302 2835,302"/>
        <TextEquiv>
          <Unicode>கூடிய காமம் பிரிந்தார் வரவுள்ளிக் கோடுகொடேறுமெந் நெஞ்சு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l7" custom="readingOrder {index:6;}" comments="kural=1263; numeral=௭">
        <Coords points="0,307 2835,307 2835,339 0,339"/>
        <Baseline points="0,333 2835,333"/>
        <TextEquiv>
          <Unicode>உரந்சையுள்ளந் துணையாகச் சென்றார் பிறாந் சைபிபின்னு முளெனன்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l8" custom="readingOrder {index:7;}" comments="kural=1269; numeral=௮">
        <Coords points="0,339 2835,339 2835,370 0,370"/>
        <Baseline points="0,364 2835,364"/>
        <TextEquiv>
          <Unicode>ஒருநாளெளு நாழ்போற்  செல்லுஞ்சேந் செந்றார் வருநாழ்வைத்தேங்குபவற்கு</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l9" custom="readingOrder {index:8;}" comments="kural=1261; numeral=௯">
        <Coords points="0,370 2835,370 2835,401 0,401"/>
        <Baseline points="0,395 2835,395"/>
        <TextEquiv>
          <Unicode>பாளற்றுப் புற்கென்ற கண்ணும் அவர்பிரிந்த  நாளொற்றித் தேய்ந்த விரல்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r_main_l10" custom="readingOrder {index:9;}" comments="kural=1270; numeral=௰">
        <Coords points="0,401 2835,401 2835,432 0,432"/>
        <Baseline points="0,427 2835,427"/>
        <TextEquiv>
          <Unicode>பெறிலெந்நாம் பெற்றக்காலெந்நாம் உறிலெந்நாமுள்ள முடைந்துக்ககால்</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>பருகமநற் கொண்கநை யொருநாட ருநாழ் பருவால பைதல்நோ யெல்லாங்கெட
காண்கமநற் கொண்கநைக் கண்ணாரக் கண்டபின் நீங்கு துமெனறேட பசப்பு
விநைகலந்து வென்றீக வெந்தன்  மநைகலந்து மாலையை யாகம் விருந்து
புலப்பென்கொல் புல்லுவென்கொல்லோ கலப்பென்கொல் கணைந்ந கேழீர் விரன்
இலங்கிழாயென்று மறப்பிநென்றேண்மேற் கலங்கழியுங் காரிகை நீத்து
கூடிய காமம் பிரிந்தார் வரவுள்ளிக் கோடுகொடேறுமெந் நெஞ்சு
உரந்சையுள்ளந் துணையாகச் சென்றார் பிறாந் சைபிபின்னு முளெனன்
ஒருநாளெளு நாழ்போற்  செல்லுஞ்சேந் செந்றார் வருநாழ்வைத்தேங்குபவற்கு
பாளற்றுப் புற்கென்ற கண்ணும் அவர்பிரிந்த  நாளொற்றித் தேய்ந்த விரல்
பெறிலெந்நாம் பெற்றக்காலெந்நாம் உறிலெந்நாமுள்ள முடைந்துக்ககால்</Unicode>
      </TextEquiv>
    </TextRegion>
