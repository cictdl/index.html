[{"n":391,"ch":40,"l1":"கற்க கசடறக் கற்பவை கற்றபின்","l2":"நிற்க அதற்குத் தக.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கல்வி கற்க நல்ல நூல்களைக் குற்றமறக் கற்க வேண்டும், அவ்வாறு கற்ற பிறகு, கற்ற கல்விக்கு தக்கவாறு நெறியில் நிற்க வேண்டும்.","en":"Let a man learn thoroughly whatever he may learn, and let his conduct be worthy of his learning","lines":[{"t":"கற்க கசடறக் கற்பவை கற்றபின்","err":null,"seers":[{"w":"கற்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கற்"},{"k":"N","s":"க"}]},{"w":"கசடறக்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கச"},{"k":"I","s":"டறக்"}]},{"w":"கற்பவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கற்"},{"k":"I","s":"பவை"}]},{"w":"கற்றபின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கற்"},{"k":"I","s":"றபின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நிற்க அதற்குத் தக.","err":null,"seers":[{"w":"நிற்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நிற்"},{"k":"N","s":"க"}]},{"w":"அதற்குத்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அதற்"},{"k":"N","s":"குத்"}]},{"w":"தக.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தக"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":392,"ch":40,"l1":"எண்ணென்ப ஏனை எழுத்தென்ப இவ்விரண்டும்","l2":"கண்ணென்ப வாழும் உயிர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"எண் என்று சொல்லப்படுவன எழுத்து என்று சொல்லப்படுவன ஆகிய இரு வகைக் கலைகளையும் வாழும் மக்களுக்குக் கண்கள் என்று கூறுவர்.","en":"Letters and numbers are the two eyes of man","lines":[{"t":"எண்ணென்ப ஏனை எழுத்தென்ப இவ்விரண்டும்","err":null,"seers":[{"w":"எண்ணென்ப","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எண்"},{"k":"N","s":"ணென்"},{"k":"N","s":"ப"}]},{"w":"ஏனை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"னை"}]},{"w":"எழுத்தென்ப","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எழுத்"},{"k":"N","s":"தென்"},{"k":"N","s":"ப"}]},{"w":"இவ்விரண்டும்","name":"கூவிளங்காய்","cls":"கா