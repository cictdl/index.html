[{"n":1031,"ch":104,"l1":"சுழன்றும்ஏர்ப் பின்னது உலகம் அதனால்","l2":"உழந்தும் உழவே தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"உலகம் பல தொழில் செய்து சுழன்றாலும் ஏர்த் தொழிலின் பின் நிற்கின்றது, அதனால் எவ்வளவு துன்புற்றாலும் உழவுத் தொழிலே சிறந்தது.","en":"Agriculture, though laborious, is the most excellent (form of labour); for people, though they go about (in search of various employments), have at last to resort to the farmer","lines":[{"t":"சுழன்றும்ஏர்ப் பின்னது உலகம் அதனால்","err":null,"seers":[{"w":"சுழன்றும்ஏர்ப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சுழன்"},{"k":"N","s":"றும்"},{"k":"N","s":"ஏர்ப்"}]},{"w":"பின்னது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பின்"},{"k":"I","s":"னது"}]},{"w":"உலகம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உல"},{"k":"N","s":"கம்"}]},{"w":"அதனால்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னால்"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"உழந்தும் உழவே தலை.","err":null,"seers":[{"w":"உழந்தும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உழந்"},{"k":"N","s":"தும்"}]},{"w":"உழவே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உழ"},{"k":"N","s":"வே"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1032,"ch":104,"l1":"உழுவார் உலகத்தார்க்கு ஆணிஅஃ தாற்றாது","l2":"எழுவாரை எல்லாம் பொறுத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["கலித்தளை"],"mv":"உழவு செய்ய முடியாமல் உயிர் வாழ்கின்றவர், எல்லாரையும் தாங்குவதால், உழவு செய்கின்றவர் உலகத்தாற்கு அச்சாணி போன்றவர்.","en":"Agriculturists are (as it were) the linch-pin of the world for they support all other workers who cannot till the soil","lines":[{"t":"உழுவார் உலகத்தார்க்கு ஆணிஅஃ தாற்றாது","err":null,"seers":[{"w":"உழுவார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உழு"},{"k":"N","s":"வார்"}]},{"w":"உலகத்தார்க்கு","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"உல"},{"k":"N","s":"கத்"},{"k":"N","s":"தார்க்"},{"k":"N","s":"கு"}]},{"w":"ஆணிஅஃ","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"ணிஅஃ"}]},{"w":"தாற்றாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தாற்"},{"k":"N","s":"றா"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை",null,"இயற்சீர் வெண்டளை"]},{"t":"எழுவாரை எல்லாம் பொறுத்து.","err":null,"seers":[{"w":"எழுவாரை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எழு"},{"k":"N","s":"வா"},{"k":"N","s":"ரை"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"பொறுத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொறுத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1033,"ch":104,"l1":"உழுதுண்டு வாழ்வாரே வாழ்வார்மற் றெல்லாம்","l2":"தொழுதுண்டு பின்செல் பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"உழவு செய்து அதனால் கிடைத்ததைக் கொண்டு வாழ்கின்றவரே உரிமையோடு வாழ்கின்றவர், மற்றவர் எல்லோரும் பிறரைத் தொழுது உண்டு பின் செல்கின்றவரே.","en":"They alone live who live by agriculture; all others lead a cringing, dependent life","lines":[{"t":"உழுதுண்டு வாழ்வாரே வாழ்வார்மற் றெல்லாம்","err":null,"seers":[{"w":"உழுதுண்டு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உழு"},{"k":"N","s":"துண்"},{"k":"N","s":"டு"}]},{"w":"வாழ்வாரே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"வா"},{"k":"N","s":"ரே"}]},{"w":"வாழ்வார்மற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"வார்"},{"k":"N","s":"மற்"}]},{"w":"றெல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றெல்"},{"k":"N","s":"லாம்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தொழுதுண்டு பின்செல் பவர்.","err":null,"seers":[{"w":"தொழுதுண்டு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தொழு"},{"k":"N","s":"துண்"},{"k":"N","s":"டு"}]},{"w":"பின்செல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பின்"},{"k":"N","s":"செல்"}]},{