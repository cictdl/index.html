[{"n":451,"ch":46,"l1":"சிற்றினம் அஞ்சும் பெருமை சிறுமைதான்","l2":"சுற்றமாச் சூழ்ந்து விடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பெரியோரின் இயல்பு சிற்றினத்தை அஞ்சி ஒதுக்கும், சிறியோரின் இயல்பு அதையே சுற்றமாக எண்ணித் தழுவிக் கொள்ளும்.","en":"(True) greatness fears the society of the base; it is only the low - minded who will regard them as friends","lines":[{"t":"சிற்றினம் அஞ்சும் பெருமை சிறுமைதான்","err":null,"seers":[{"w":"சிற்றினம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சிற்"},{"k":"I","s":"றினம்"}]},{"w":"அஞ்சும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சும்"}]},{"w":"பெருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"மை"}]},{"w":"சிறுமைதான்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறு"},{"k":"N","s":"மை"},{"k":"N","s":"தான்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சுற்றமாச் சூழ்ந்து விடும்.","err":null,"seers":[{"w":"சுற்றமாச்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சுற்"},{"k":"I","s":"றமாச்"}]},{"w":"சூழ்ந்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சூழ்ந்"},{"k":"N","s":"து"}]},{"w":"விடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":452,"ch":46,"l1":"நிலத்தியல்பால் நீர்திரிந் தற்றாகும் மாந்தர்க்கு","l2":"இனத்தியல்ப தாகும் அறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["கலித்தளை"],"mv":"சேர்ந்த நிலத்தின் இயல்பால் அந்த நீர் வேறுபட்டு அந் நிலத்தின் தன்மையுடையதாகும், அதுபோல் மக்களுடைய அறிவு இனத்தின் இயல்பினை உடையதாகும்.","en":"As water changes (its nature), from the nature of the soil (in which it flows), so will the character of men resemble that of their associates","lines":[{"t":"நிலத்தியல்பால் நீர்திரிந் தற்றாகும் மாந்தர்க்கு","err":null,"seers":[{"w":"நிலத்தியல்பால்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நிலத்"},{"k":"I","s":"தியல்"},{"k":"N","s":"பால்"}]},{"w":"நீர்திரிந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீர்"},{"k":"I","s":"திரிந்"}]},{"w":"தற்றாகும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தற்"},{"k":"N","s":"றா"},{"k":"N","s":"கும்"}]},{"w":"மாந்தர்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மாந்"},{"k":"N","s":"தர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இனத்தியல்ப தாகும் அறிவு.","err":null,"seers":[{"w":"இனத்தியல்ப","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இனத்"},{"k":"I","s":"தியல்"},{"k":"N","s":"ப"}]},{"w":"தாகும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"கும்"}]},{"w":"அறிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":453,"ch":46,"l1":"மனத்தானாம் மாந்தர்க் குணர்ச்சி இனத்தானாம்","l2":"இன்னான் எனப்படுஞ் சொல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மக்களுக்கு இயற்கையறிவு மனத்தால் ஏற்படும், இப்படிப் பட்டவன் என்று உலகத்தாரால் மதிக்கப்படும் சொல், சேர்ந்த இனத்தால் ஏற்படும்.","en":"The power of knowing is from the mind; (but) his character is from that of his associates","lines":[{"t":"மனத்தானாம் மாந்தர்க் குணர்ச்சி இனத்தானாம்","err":null,"seers":[{"w":"மனத்தானாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மனத்"},{"k":"N","s":"தா"},{"k":"N","s":"னாம்"}]},{"w":"மாந்தர்க்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாந்"},{"k":"N","s":"தர்க்"}]},{"w":"குணர்ச்சி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குணர்ச்"},{"k":"N","s":"சி"}]},{"w":"இனத்தானாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இனத்"},{"k":"N","s":"தா"},{"k":"N","s":"னாம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இன்னான் எனப்படுஞ் சொல்.","err":null,"seers":[{"w":"இன்னான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னான்"}]},{"w":"எனப்படுஞ்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"எனப்"},{"k":"I","s":"படுஞ்"}]},{"w":"சொல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"சொல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":454,"ch":46,"l1":"மனத்து ளதுபோலக் காட்டி ஒருவற்கு","l2":"இனத்துள தாகும் அறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["கலித்தளை"],"mv":"ஒருவனுக்கு சிறப்பறிவு மனத்தில் உள்ளது போலக் காட்டி (உண்மையாக நோக்கும் போது) அவன் சேர்ந்த இனத்தில் உள்ளதாகும்.","en":"Wisdom appears to rest in the mind, but it really exists to a man in his companions","lines":[{"t":"மனத்து ளதுபோலக் காட்டி ஒருவற்கு","err":null,"seers":[{"w":"மனத்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மனத்"},{"k":"N","s":"து"}]},{"w":"ளதுபோலக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ளது"},{"k":"N","s":"போ"},{"k":"N","s":"லக்"}]},{"w":"காட்டி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காட்"},{"k":"N","s":"டி"}]},{"w":"ஒருவற்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வற்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இனத்துள தாகும் அறிவு.","err":null,"seers":[{"w":"இனத்துள","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இனத்"},{"k":"I","s":"துள"}]},{"w":"தாகும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"கும்"}]},{"w":"அறிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":455,"ch":46,"l1":"மனந்தூய்மை செய்வினை தூய்மை இரண்டும்","l2":"இனந்தூய்மை தூவா வரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மனத்தின் தூய்மை செய்யும் செயலின் தூய்மை ஆகிய இவ்விரண்டும் சேர்ந்த இனத்தின் தூய்மையைப் பொறுத்தே ஏற்ப்படும்.","en":"Chaste company is the staff on which come, these two things, viz, purity of mind and purity of conduct","lines":[{"t":"மனந்தூய்மை செய்வினை தூய்மை இரண்டும்","err":null,"seers":[{"w":"மனந்தூய்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மனந்"},{"k":"N","s":"தூய்"},{"k":"N","s":"மை"}]},{"w":"செய்வினை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"வினை"}]},{"w":"தூய்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தூய்"},{"k":"N","s":"மை"}]},{"w":"இரண்டும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இரண்"},{"k":"N","s":"டும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இனந்தூய்மை தூவா வரும்.","err":null,"seers":[{"w":"இனந்தூய்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இனந்"},{"k":"N","s":"தூய்"},{"k":"N","s":"மை"}]},{"w":"தூவா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தூ"},{"k":"N","s":"வா"}]},{"w":"வரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":456,"ch":46,"l1":"மனந்தூயார்க் கெச்சம்நன் றாகும் இனந்தூயார்க்கு","l2":"இல்லைநன் றாகா வினை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":[null],"mv":"மனம் தூய்மையாகப் பெற்றவர்க்கு , அவர்க்குப் பின் எஞ்சி நிற்கும் புகழ் முதலியவை நன்மையாகும், இனம் தூய்மையாக உள்ளவர்க்கு நன்மையாகாத செயல் இல்லை.","en":"To the pure-minded there will be a good posterity By those whose associates are pure, no deeds will be done that are not good","lines":[{"t":"மனந்தூயார்க் கெச்சம்நன் றாகும் இனந்தூயார்க்கு","err":null,"seers":[{"w":"மனந்தூயார்க்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மனந்"},{"k":"N","s":"தூ"},{"k":"N","s":"யார்க்"}]},{"w":"கெச்சம்நன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கெச்"},{"k":"N","s":"சம்"},{"k":"N","s":"நன்"}]},{"w":"றாகும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றா"},{"k":"N","s":"கும்"}]},{"w":"இனந்தூயார்க்கு","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"இனந்"},{"k":"N","s":"தூ"},{"k":"N","s":"யார்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இல்லைநன் றாகா வினை.","err":null,"seers":[{"w":"இல்லைநன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"},{"k":"N","s":"நன்"}]},{"w":"றாகா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றா"},{"k":"N","s":"கா"}]},{"w":"வினை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வினை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":457,"ch":46,"l1":"மனநலம் மன்னுயிர்க் காக்கம் இனநலம்","l2":"எல்லாப் புகழும் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மனதின் நன்மை உயிர்க்கு ஆக்கமாகும், இனத்தின் தன்மை (அவ்வளவோடு நிற்காமல்) எல்லாப் புகழையும் கொடுக்கும்.","en":"Goodness of mind will give wealth, and good society will bring with it all praise, to men","lines":[{"t":"மனநலம் மன்னுயிர்க் காக்கம் இனநலம்","err":null,"seers":[{"w":"மனநலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மன"},{"k":"I","s":"நலம்"}]},{"w":"மன்னுயிர்க்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னுயிர்க்"}]},{"w":"காக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காக்"},{"k":"N","s":"கம்"}]},{"w":"இனநலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இன"},{"k":"I","s":"நலம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எல்லாப் புகழும் தரும்.","err":null,"seers":[{"w":"எல்லாப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாப்"}]},{"w":"புகழும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புக"},{"k":"N","s":"ழும்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":458,"ch":46,"l1":"மனநலம் நன்குடைய ராயினும் சான்றோர்க்கு","l2":"இனநலம் ஏமாப் புடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["கலித்தளை"],"mv":"மனதின் நன்மையை உறுதியாக உடையவராயினும் சான்றோர்க்கு இனத்தின் நன்மை மேலும் நல்ல காவலாக அமையும்.","en":"Yet good companionship is confirmation strong","lines":[{"t":"மனநலம் நன்குடைய ராயினும் சான்றோர்க்கு","err":null,"seers":[{"w":"மனநலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மன"},{"k":"I","s":"நலம்"}]},{"w":"நன்குடைய","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"I","s":"குடை"},{"k":"N","s":"ய"}]},{"w":"ராயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":