[{"n":71,"ch":8,"l1":"அன்பிற்கும் உண்டோ அடைக்குந்தாழ் ஆர்வலர்","l2":"புன்கணீர் பூசல் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அன்புக்கும் அடைத்து வைக்கும் தாழ் உண்டோ? அன்புடையவரின் சிறு கண்ணீரே ( உள்ளே இருக்கும் அன்பைப் ) பலரும் அறிய வெளிப்படுத்திவிடும்","en":"Is there any fastening that can shut in love ? Tears of the affectionate will publish the love that is within","lines":[{"t":"அன்பிற்கும் உண்டோ அடைக்குந்தாழ் ஆர்வலர்","err":null,"seers":[{"w":"அன்பிற்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அன்"},{"k":"N","s":"பிற்"},{"k":"N","s":"கும்"}]},{"w":"உண்டோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டோ"}]},{"w":"அடைக்குந்தாழ்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அடைக்"},{"k":"N","s":"குந்"},{"k":"N","s":"தாழ்"}]},{"w":"ஆர்வலர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆர்"},{"k":"I","s":"வலர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"புன்கணீர் பூசல் தரும்.","err":null,"seers":[{"w":"புன்கணீர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"புன்"},{"k":"I","s":"கணீர்"}]},{"w":"பூசல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பூ"},{"k":"N","s":"சல்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":72,"ch":8,"l1":"அன்பிலார் எல்லாம் தமக்குரியர் அன்புடையார்","l2":"என்பும் உரியர் பிறர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அன்பு இல்லாதவர் எல்லாப்பொருள்களையும் தமக்கே உரிமையாகக் கொண்டு வாழ்வார்: அன்பு உடையவர் தம் உடமையும் பிறர்க்கு உரிமையாக்கி வாழ்வர்","en":"Those who are destitute of love appropriate all they have to themselves; but those who possess love consider even their bones to belong to others","lines":[{"t":"அன்பிலார் எல்லாம் தமக்குரியர் அன்புடையார்","err":null,"seers":[{"w":"அன்பிலார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அன்"},{"k":"I","s":"பிலார்"}]},{"w":"எல்லாம்","name"