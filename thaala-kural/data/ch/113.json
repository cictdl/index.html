[{"n":1121,"ch":113,"l1":"பாலொடு தேன்கலந் தற்றே பணிமொழி","l2":"வாலெயிறு ஊறிய நீர்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மென்மையான மொழிகளைப் பேசு கின்ற இவளுடைய தூய பற்களில் ஊறிய நீர் பாலுடன் தேனைக் கலந்தாற் போன்றதாகும்.","en":"The water which oozes from the white teeth of this soft speeched damsel is like a mixture of milk and honey","lines":[{"t":"பாலொடு தேன்கலந் தற்றே பணிமொழி","err":null,"seers":[{"w":"பாலொடு","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பா"},{"k":"I","s":"லொடு"}]},{"w":"தேன்கலந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தேன்"},{"k":"I","s":"கலந்"}]},{"w":"தற்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"றே"}]},{"w":"பணிமொழி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பணி"},{"k":"I","s":"மொழி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வாலெயிறு ஊறிய நீர்.","err":null,"seers":[{"w":"வாலெயிறு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"I","s":"லெயி"},{"k":"N","s":"று"}]},{"w":"ஊறிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"றிய"}]},{"w":"நீர்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"நீர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1122,"ch":113,"l1":"உடம்பொடு உயிரிடை என்னமற் றன்ன","l2":"மடந்தையொடு எம்மிடை நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"இம் மடந்தையோடு எம்மிடையே உள்ள நட்பு முறைகள், உடம்போடு உயிர்க்கு உள்ள தொடர்புகள், எத்தன்மையானவையோ அத்தன்மையானவை.","en":"The love between me and this damsel is like the union of body and soul","lines":[{"t":"உடம்பொடு உயிரிடை என்னமற் றன்ன","err":null,"seers":[{"w":"உடம்பொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உடம்"},{"k":"I","s":"பொடு"}]},{"w":"உயிரிடை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உயி"},{"k":"I","s":"ரிடை"}]},{"w":"என்னமற்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"னமற்"}]},{"w":"றன்ன","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றன்"},{"k":"N","s":"ன"}]}],"thalai":["நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மடந்தையொடு எம்மிடை நட்பு.","err":null,"seers":[{"w":"மடந்தையொடு","name":"புளிமாங்கனி","cls":"கனி","a":[{"k":"I","s":"மடந்"},{"k":"N","s":"தை"},{"k":"I","s":"யொடு"}]},{"w":"எம்மிடை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எம்"},{"k":"I","s":"மிடை"}]},{"w":"நட்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பு"}]}],"thalai":["ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":1123,"ch":113,"l1":"கருமணியிற் பாவாய்நீ போதாயாம் வீழும்","l2":"திருநுதற்கு இல்லை இடம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"என் கண்ணின் கருமணியில் உள்ள பாவையே நீ போய் விடு, யாம் விரும்புகின்ற இவளுக்கு என் கண்ணில் இருக்க இடம் இல்லையே.","en":"O you image in the pupil (of my eye)! depart; there is no room for (my) fair-browed beloved","lines":[{"t":"கருமணியிற் பாவாய்நீ போதாயாம் வீழும்","err":null,"seers":[{"w":"கருமணியிற்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கரு"},{"k":"I","s":"மணி"},{"k":"N","s":"யிற்"}]},{"w":"பாவாய்நீ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பா"},{"k":"N","s":"வாய்"},{"k":"N","s":"நீ"}]},{"w":"போதாயாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"போ"},{"k":"N","s":"தா"},{"k":"N","s":"யாம்"}]},{"w":"வீழும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வீ"},{"k":"N","s":"ழும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"திருநுதற்கு இல்லை இடம்.","err":null,"seers":[{"w":"திருநுதற்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"திரு"},{"k":"I","s":"நுதற்"},{"k":"N","s":"கு"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"இடம்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"இடம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1124,"ch":113,"l1":"வாழ்தல் உயிர்க்கன்னள் ஆயிழை சாதல்","l2":"அதற்கன்னள் நீங்கும் இடத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஆராய்ந்து அணிகலன்களை அணிந்த இவள் கூடும் போது உயிர்க்கு வாழ்வு போன்றவள், பிரியும் போது உயிர்க்கு சாவு போன்றவள்.","en":"My fair-jewelled one resembles the living soul (when she is in union with me), the dying soul when she leaves me","lines":[{"t":"வாழ்தல் உயிர்க்கன்னள் ஆயிழை சாதல்","err":null,"seers":[{"w":"வாழ்தல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"தல்"}]},{"w":"உயிர்க்கன்னள்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உயிர்க்"},{"k":"N","s":"கன்"},{"k":"N","s":"னள்"}]},{"w":"ஆயிழை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"யிழை"}]},{"w":"சாதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சா"},{"k":"N","s":"தல்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அதற்கன்னள் நீங்கும் இடத்து.","err":null,"seers":[{"w":"அதற்கன்னள்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அதற்"},{"k":"N","s":"கன்"},{"k":"N","s":"னள்"}]},{"w":"நீங்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீங்"},{"k":"N","s":"கும்"}]},{"w":"இடத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1125,"ch":113,"l1":"உள்ளுவன் மன்யான் மறப்பின் மறப்பறியேன்","l2":"ஒள்ளமர்க் கண்ணாள் குணம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"போர் செய்யும் பண்புகளை உடைய இவளுடைய பண்புகளை யான் மறந்தால் பிறகு நினைக்க முடியும் ஆனால் ஒரு போதும் மறந்ததில்லையே.","en":"If I had forgotten her who has bright battling eyes, I would have remembered (thee); but I never forget her (Thus says he to her maid)","lines":[{"t":"உள்ளுவன் மன்யான் மறப்பின் மறப்பறியேன்","err":null,"seers":[{"w":"உள்ளுவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளுவன்"}]},{"w":"மன்யான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மன்"},{"k":"N","s":"யான்"}]},{"w":"மறப்பின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மறப்"},{"k":"N","s":"பின்"}]},{"w":"மறப்பறிய