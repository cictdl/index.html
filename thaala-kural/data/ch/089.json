[{"n":881,"ch":89,"l1":"நிழல்நீரும் இன்னாத இன்னா தமர்நீரும்","l2":"இன்னாவாம் இன்னா செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இன்பம் தரும் நிழலும் நீரும் நோய் செய்வனவாக இருந்தால் தீயனவே ஆகும், அதுபோலவே சுற்றத்தாறின் தன்மைகளும் துன்பம் தருவானால் தீயனவே ஆகும்.","en":"Shade and water are not pleasant, (if) they cause disease; so are the qualities of (one's) relations not agreeable, (if) they cause pain","lines":[{"t":"நிழல்நீரும் இன்னாத இன்னா தமர்நீரும்","err":null,"seers":[{"w":"நிழல்நீரும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நிழல்"},{"k":"N","s":"நீ"},{"k":"N","s":"ரும்"}]},{"w":"இன்னாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"N","s":"த"}]},{"w":"இன்னா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"}]},{"w":"தமர்நீரும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தமர்"},{"k":"N","s":"நீ"},{"k":"N","s":"ரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இன்னாவாம் இன்னா செயின்.","err":null,"seers":[{"w":"இன்னாவாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"N","s":"வாம்"}]},{"w":"இன்னா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"}]},{"w":"செயின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":882,"ch":89,"l1":"வாள்போல பகைவரை அஞ்சற்க அஞ்சுக","l2":"கேள்போல் பகைவர் தொடர்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"வாளைப்போல் வெளிப்படையான பகைவர்க்கு அஞ்ச வேண்டியதில்லை, ஆனால் உறவினரைப் போல் இருந்து உட்பகை கொண்டவரின் தொடர்புக்கு அஞ்ச வேண்டும்.","en":"Fear not foes (who say they would cut) like a sword; (but) fear the friendship of foes (who seemingly","lines":[{"t":"வாள்போல பகைவரை அஞ்சற்க அஞ்சுக","err":null,"seers":[{"w":"வாள்போல","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாள்"},{"k":"N","s":"போ"},{"k":"N","s":"ல"}]},{"w":"பகைவரை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பகை"},{"k":"I","s":"வரை"}]},{"w":"அஞ்சற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சற்"},{"k":"N","s":"க"}]},{"w":"அஞ்சுக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஞ்"},{"k":"I","s":"சுக"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கேள்போல் பகைவர் தொடர்பு.","err":null,"seers":[{"w":"கேள்போல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேள்"},{"k":"N","s":"போல்"}]},{"w":"பகைவர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பகை"},{"k":"N","s":"வர்"}]},{"w":"தொடர்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தொடர்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":883,"ch":89,"l1":"உட்பகை அஞ்சித்தற் காக்க உலைவிடத்து","l2":"மட்பகையின் மாணத் தெறும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உட்பகைக்கு அஞ்சி ஒருவன் தன்னைக் காத்துக்கொள்ள வேண்டும், தளர்ச்சி வந்த போது மட்கலத்தை அறுக்கும் கருவி போல் அந்த உட்பகை தவறாமல் அழிவு செய்யும்.","en":"Fear internal enmity and guard yourself; (if not) it will destroy (you) in an evil hour, as surely as the tool which cuts the potter's clay","lines":[{"t":"உட்பகை அஞ்சித்தற் காக்க உலைவிடத்து","err":null,"seers":[{"w":"உட்பகை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உட்"},{"k":"I","s":"பகை"}]},{"w":"அஞ்சித்தற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சித்"},{"k":"N","s":"தற்"}]},{"w":"காக்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காக்"},{"k":"N","s":"க"}]},{"w":"உலைவிடத்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உலை"},{"k":"I","s":"விடத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மட்பகையின் மாணத் தெறும்.","err":null,"seers":[{"w":"மட்பகையின்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மட்"},{"k":"I","s":"பகை"},{"k":"N","s":"யின்"}]},{"w":"மாணத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மா"},{"k":"N","s":"ணத்"}]},{"w":"தெறும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தெறும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":884,"ch":89,"l1":"மனமாணா உட்பகை தோன்றின் இனமாணா","l2":"ஏதம் பலவும் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மனம் திறந்தாத உட்பகை ஒருவனுக்கு உண்டாகுமானால், அது அவனுக்குச் சுற்றம் சிர்படாமைக்கு காரணமான குற்றம் பலவற்றைத் தரும்.","en":"The secret enmity of a person whose mind in unreformed will lead to many evils causing disaffection among (one's) relations","lines":[{"t":"மனமாணா உட்பகை தோன்றின் இனமாணா","err":null,"seers":[{"w":"மனமாணா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மன"},{"k":"N","s":"மா"},{"k":"N","s":"ணா"}]},{"w":"உட்பகை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உட்"},{"k":"I","s":"பகை"}]},{"w":"தோன்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோன்"},{"k":"N","s":"றின்"}]},{"w":"இனமாணா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இன"},{"k":"N","s":"மா"},{"k":"N","s":"ணா"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஏதம் பலவும் தரும்.","err":null,"seers":[{"w":"ஏதம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"தம்"}]},{"w":"பலவும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பல"},{"k":"N","s":"வும்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":885,"ch":89,"l1":"உறல்முறையான் உட்பகை தோன்றின் இறல்முறையான்","l2":"ஏதம் பலவும் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உறவுமுறையோடு உட்பகை உண்டாகுமானால், அது ஒருவனுக்கு இறக்கும் வகையான துன்பம் பலவற்றையும் கொடுக்கும்.","en":"If there appears internal hatred in a (king's) family; it will lead to many a fatal crime","lines":[{"t":"உறல்முறையான் உட்பகை தோன்றின் இறல்முறையான்","err":null,"seers":[{"w":"உறல்முறையான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உறல்"},{"k":"I","s":"முறை"},{"k":"N","s":"யான்"}]},{"w":"உட்பகை","name":"கூ