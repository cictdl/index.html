வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":887,"ch":89,"l1":"செப்பின் புணர்ச்சிபோல் கூடினும் கூடாதே","l2":"உட்பகை உற்ற குடி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"செப்பின் இணைப்பைப் போல புறத்தே பொருந்தி இருந்தாலும், உட்பகை உண்டான குடியில் உள்ளவர் அகத்தே பொருந்தி இருக்கமாட்டார்.","en":"Never indeed will a family subject to internal hatred unite (really) though it may present an apparent union like that of a casket and its lid","lines":[{"t":"செப்பின் புணர்ச்சிபோல் கூடினும் கூடாதே","err":null,"seers":[{"w":"செப்பின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செப்"},{"k":"N","s":"பின்"}]},{"w":"புணர்ச்சிபோல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"புணர்ச்"},{"k":"I","s":"சிபோல்"}]},{"w":"கூடினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கூ"},{"k":"I","s":"டினும்"}]},{"w":"கூடாதே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கூ"},{"k":"N","s":"டா"},{"k":"N","s":"தே"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உட்பகை உற்ற குடி.","err":null,"seers":[{"w":"உட்பகை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உட்"},{"k":"I","s":"பகை"}]},{"w":"உற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உற்"},{"k":"N","s":"ற"}]},{"w":"குடி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"குடி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":888,"ch":89,"l1":"அரம்பொருத பொன்போலத் தேயும் உரம்பொருது","l2":"உட்பகை உற்ற குடி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உட்பகை உண்டான குடி அரத்தினால் தேய்க்கப் பட்ட இரும்பு போல் வலிமை குறைக்கப் பட்டு தேய்ந்து போகும்.","en":"A family subject to internal hatred will wear out and lose its strength like iron that has been filed away","lines":[{"t":"அரம்பொருத பொன்போலத் தேயும் உரம்பொருது","err":null,"seers":[{"w":"அரம்பொருத","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அரம்"},{"k":"I","s":"பொரு"},{"k":"N","s":"த"}]},{"w":"பொன்போலத்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொன்"},{"