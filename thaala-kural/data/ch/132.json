்"},{"k":"N","s":"நீ"},{"k":"N","s":"ரர்"}]},{"w":"ஆகுதிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"குதிர்"}]},{"w":"என்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1320,"ch":132,"l1":"நினைத்திருந்து நோக்கினும் காயும் அனைத்துநீர்","l2":"யாருள்ளி நோக்கினீர் என்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அவளுடைய அழகை நி‌னைத்து அமைதியாக இருந்து நோக்கினாலும், நீர் யாரை நினைத்து ஒப்புமையாக எல்லாம் பார்க்கின்றீர்? என்று சினம் கொள்வாள்.","en":"Even when I look on her contemplating (her beauty), she is displeased and says, \"With whose thought have you (thus) looked on my person?\"","lines":[{"t":"நினைத்திருந்து நோக்கினும் காயும் அனைத்துநீர்","err":null,"seers":[{"w":"நினைத்திருந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நினைத்"},{"k":"I","s":"திருந்"},{"k":"N","s":"து"}]},{"w":"நோக்கினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நோக்"},{"k":"I","s":"கினும்"}]},{"w":"காயும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"யும்"}]},{"w":"அனைத்துநீர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அனைத்"},{"k":"I","s":"துநீர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"யாருள்ளி நோக்கினீர் என்று.","err":null,"seers":[{"w":"யாருள்ளி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"N","s":"ருள்"},{"k":"N","s":"ளி"}]},{"w":"நோக்கினீர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நோக்"},{"k":"I","s":"கினீர்"}]},{"w":"என்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]