[{"n":591,"ch":60,"l1":"உடையர் எனப்படுவது ஊக்கம் அஃதில்லார்","l2":"உடையது உடையரோ மற்று.","ok":true,"reseg":true,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவர் பெற்றிருக்கின்றார் என்று சொல்லத்தக்க சிறப்புடையது ஊக்கமாகும், ஊக்கம் இல்லாதவர் வேறு எதைப் பெற்றிருந்தாலும் அதை உடையவர் ஆவரோ.","en":"Energy makes out the man of property; as for those who are destitute of it, do they (really) possess what they possess ?","lines":[{"t":"உடையர் எனப்படுவது ஊக்கம் அஃதில்லார்","err":null,"seers":[{"w":"உடையர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"யர்"}]},{"w":"எனப்படுவ","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"எனப்"},{"k":"I","s":"படு"},{"k":"N","s":"வ"}]},{"w":"தூக்கம்அஃ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தூக்"},{"k":"N","s":"கம்"},{"k":"N","s":"அஃ"}]},{"w":"தில்லார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தில்"},{"k":"N","s":"லார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"உடையது உடையரோ மற்று.","err":null,"seers":[{"w":"உடைய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"ய"}]},{"w":"துடையரோ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"துடை"},{"k":"I","s":"யரோ"}]},{"w":"மற்று","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":592,"ch":60,"l1":"உள்ளம் உடைமை உடைமை பொருளுடைமை","l2":"நில்லாது நீங்கி விடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவர்க்கு ஊக்கமுடைமையே நிலையான உடைமையாகும், மற்றப் பொருளுடைமையானது நிலைபேறு இல்லாமல் நீங்கிவிடுவதாகும்.","en":"The possession of (energy of) mind is true property; the possession of wealth passes away and abides not","lines":[{"t":"உள்ளம் உடைமை உடைமை பொருளுடைமை","err":null,"seers":[{"w":"உள்ளம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளம்"}]},{"w":"உடைமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"மை"}]},{"w":"உடைமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"மை"}]},{"w":"பொருளுடைமை","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"I","s":"ளுடை"},{"k":"N","s":"மை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நில்லாது நீங்கி விடும்.","err":null,"seers":[{"w":"நில்லாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நில்"},{"k":"N","s":"லா"},{"k":"N","s":"து"}]},{"w":"நீங்கி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீங்"},{"k":"N","s":"கி"}]},{"w":"விடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":593,"ch":60,"l1":"ஆக்கம் இழந்தேமென்று அல்லாவார் ஊக்கம்","l2":"ஒருவந்தம் கைத்துடை யார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஊக்கத்தை உறுதியாகத் தம்கைப் பொருளாக உடையவர், ஆக்கம்( இழந்து விட்டக்காலத்திலும்) இழந்து விட்டோம் என்று கலங்க மாட்டார்.","en":"They who are possessed of enduring energy will not trouble themselves, saying, \"we have lost our property.\"","lines":[{"t":"ஆக்கம் இழந்தேமென்று அல்லாவார் ஊக்கம்","err":null,"seers":[{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"இழந்தேமென்று","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"இழந்"},{"k":"N","s":"தே"},{"k":"N","s":"மென்"},{"k":"N","s":"று"}]},{"w":"அல்லாவார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அல்"},{"k":"N","s":"லா"},{"k":"N","s":"வார்"}]},{"w":"ஊக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊக்"},{"k":"N","s":"கம்"}]}],"thalai":["இயற்சீர் வெண்டளை",null,"வெண்சீர் வெண்டளை"]},{"t":"ஒருவந்தம் கைத்துடை யார்.","err":null,"seers":[{"w":"ஒருவந்தம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வந்"},{"k":"N","s":"தம்"}]},{"w":"கைத்துடை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கைத்"},{"k":"I","s":"துடை"}]},{"w":"யார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"யார்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":594,"ch":60,"l1":"ஆக்கம் அதர்வினாய்ச் செல்லும் அசைவிலா","l2":"ஊக்க முடையா னுழை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"சோர்வு இல்லாத ஊக்கம் உடையவனிடத்தில் ஆக்கமானது தானே அவன் உள்ள இடத்திற்கு வழிக் கேட்டுக்கொண்டு போய்ச் சேரும்.","en":"Wealth will find its own way to the man of unfailing energy","lines":[{"t":"ஆக்கம் அதர்வினாய்ச் செல்லும் அசைவிலா","err":null,"seers":[{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"அதர்வினாய்ச்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அதர்"},{"k":"I","s":"வினாய்ச்"}]},{"w":"செல்லும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"லும்"}]},{"w":"அசைவிலா","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அசை"},{"k":"I","s":"விலா"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஊக்க முடையா னுழை.","err":null,"seers":[{"w":"ஊக்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊக்"},{"k":"N","s":"க"}]},{"w":"முடையா","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முடை"},{"k":"N","s":"யா"}]},{"w":"னுழை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"னுழை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":595,"ch":60,"l1":"வெள்ளத் தனைய மலர்நீட்டம் மாந்தர்தம்","l2":"உள்ளத் தனையது உயர்வு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"நீர்ப்பூக்களின் தாளின் நீளம் அவை நின்ற நீரின் அளவினவாகும், மக்களின் ஊக்கத்தை அளவினதாகும் வாழ்க்கையின் உயர்வு.","en":"The stalks of water-flowers are proportionate to the depth of water; so is men's greatness proportionate to their minds","lines":[{"t":"வெள்ளத் தனைய மலர்நீட்டம் மாந்தர்தம்","err":null,"seers":[{"w":"வெள்ளத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெள்"},{"k":"N","s":"ளத்"}]},{"w":"தனைய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தனை"},{"k":"N","s":"ய"}]},{"w":"மலர்நீட்டம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மலர்"},{"k":"N","s":"நீட்"},{"k":"N","s":"டம்"}]},{"w":"மாந்தர்தம்","name":"தேமாங்காய்","cls":"காய்","a":[{"