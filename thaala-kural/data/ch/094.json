[{"n":931,"ch":94,"l1":"வேண்டற்க வென்றிடினும் சூதினை வென்றதூஉம்","l2":"தூண்டிற்பொன் மீன்விழுங்கி அற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"வெற்றியே பெறுவதாலும் சூதாட்டத்தை விரும்பக்கூடாது, வென்ற வெற்றியும் தூண்டில் இரும்பை இரை என்று மயங்கி மீன் விழுகினாற் போன்றது.","en":"Though able to win, let not one desire gambling; (for) even what is won is like a fish swallowing the iron in fish-hook","lines":[{"t":"வேண்டற்க வென்றிடினும் சூதினை வென்றதூஉம்","err":null,"seers":[{"w":"வேண்டற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டற்"},{"k":"N","s":"க"}]},{"w":"வென்றிடினும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வென்"},{"k":"I","s":"றிடி"},{"k":"N","s":"னும்"}]},{"w":"சூதினை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சூ"},{"k":"I","s":"தினை"}]},{"w":"வென்றதூஉம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வென்"},{"k":"I","s":"றதூ"},{"k":"N","s":"உம்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தூண்டிற்பொன் மீன்விழுங்கி அற்று.","err":null,"seers":[{"w":"தூண்டிற்பொன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தூண்"},{"k":"N","s":"டிற்"},{"k":"N","s":"பொன்"}]},{"w":"மீன்விழுங்கி","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மீன்"},{"k":"I","s":"விழுங்"},{"k":"N","s":"கி"}]},{"w":"அற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அற்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":932,"ch":94,"l1":"ஒன்றெய்தி நூறிழக்கும் சூதர்க்கும் உண்டாங்கொல்","l2":"நன்றெய்தி வாழ்வதோர் ஆறு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒரு பொருள் பெற்று நூறு மடங்கு பொருளை இழந்து விடும் சூதாடிகளுக்கும், நன்மை பெற்று வாழும் ஒரு வழி உண்டோ.","en":"That they may good obtain, and see a prosperous day? Is there indeed a means of livelihood that can bestow happiness on gamblers who gain one and lose a hundred?","lines":[{"t":"ஒன்றெய்தி நூறிழக்கும் சூதர்க்கும் உண்டாங்கொல்","err":nu