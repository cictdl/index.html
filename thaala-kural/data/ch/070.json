[{"n":691,"ch":70,"l1":"அகலாது அணுகாது தீக்காய்வார் போல்க","l2":"இகல்வேந்தர்ச் சேர்ந்தொழுகு வார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அரசரைச் சார்ந்து வாழ்கின்றவர், அவரை மிக நீங்காமலும், மிக அணுகாமலும் நெருப்பில் குளிர் காய்கின்றவர் போல இருக்க வேண்டும்.","en":"Thus let them act who dwell beneath of warlike kings the palace-roof","lines":[{"t":"அகலாது அணுகாது தீக்காய்வார் போல்க","err":null,"seers":[{"w":"அகலாது","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அக"},{"k":"N","s":"லா"},{"k":"N","s":"து"}]},{"w":"அணுகாது","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அணு"},{"k":"N","s":"கா"},{"k":"N","s":"து"}]},{"w":"தீக்காய்வார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தீக்"},{"k":"N","s":"காய்"},{"k":"N","s":"வார்"}]},{"w":"போல்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போல்"},{"k":"N","s":"க"}]}],"thalai":["கலித்தளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இகல்வேந்தர்ச் சேர்ந்தொழுகு வார்.","err":null,"seers":[{"w":"இகல்வேந்தர்ச்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இகல்"},{"k":"N","s":"வேந்"},{"k":"N","s":"தர்ச்"}]},{"w":"சேர்ந்தொழுகு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"சேர்ந்"},{"k":"I","s":"தொழு"},{"k":"N","s":"கு"}]},{"w":"வார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"வார்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":692,"ch":70,"l1":"மன்னர் விழைப விழையாமை மன்னரால்","l2":"மன்னிய ஆக்கந் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அரசர் விரும்புகின்றவர்களைத் தாம் விரும்பாமலிருத்தல் (அரசரைச் சார்ந்திருப்பவர்க்கு) அரசரால் நிலையான ஆக்கத்தைப் பெற்றுத் தரும்.","en":"For ministers not to cover the things desired by their kings will through the kings themselves yield them everlasting wealth","lines":[{"t":"மன்னர் விழைப விழையாமை மன்னரால்","err":null,"seers":[{"w":"மன்னர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மன்"},{"k":"N","s":"னர்"}]},{"w":"விழைப","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விழை"},{"k":"N","s":"ப"}]},{"w":"விழையாமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விழை"},{"k":"N","s":"யா"},{"k":"N","s":"மை"}]},{"w":"மன்னரால்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னரால்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"மன்னிய ஆக்கந் தரும்.","err":null,"seers":[{"w":"மன்னிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னிய"}]},{"w":"ஆக்கந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கந்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":693,"ch":70,"l1":"போற்றின் அரியவை போற்றல் கடுத்தபின்","l2":"தேற்றுதல் யார்க்கும் அரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":".( அரசரைச் சார்ந்தவர்) தம்மைக் காத்துக் கொள்ள விரும்பினால் அரியத் தவறுகள் நேராமல் காத்துக்கொள்ள வேண்டும், ஐயுற்றபின் அரசரைத் தெளிவித்தல் எவர்க்கும் முடியாது.","en":"Ministers who would save themselves should avoid (the commission of) serious errors for if the king's suspicion is once roused, no one can remove it","lines":[{"t":"போற்றின் அரியவை போற்றல் கடுத்தபின்","err":null,"seers":[{"w":"போற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றின்"}]},{"w":"அரியவை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அரி"},{"k":"I","s":"யவை"}]},{"w":"போற்றல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றல்"}]},{"w":"கடுத்தபின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கடுத்"},{"k":"I","s":"தபின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தேற்றுதல் யார்க்கும் அரிது.","err":null,"seers":[{"w":"தேற்றுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தேற்"},{"k":"I","s":"றுதல்"}]},{"w":"யார்க்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யார்க்"},{"k":"N","s":"கும்"}]},{"w":"அரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":694,"ch":70,"l1":"செவிச்சொல்லும் சேர்ந்த நகையும் அவித்தொழுகல்","l2":"ஆன்ற பெரியா ரகத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"வல்லமை அமைந்த பெரியாரிடத்தில் (மற்றொருவன்) செவியை நெருங்கிச் சொல்லுதல் உடன் சேர்ந்து நகைத்தலும் செய்யாமல் ஒழுகவேண்டும்.","en":"While in the presence of the sovereign, ministers should neither whisper to nor smile at others","lines":[{"t":"செவிச்சொல்லும் சேர்ந்த நகையும் அவித்தொழுகல்","err":null,"seers":[{"w":"செவிச்சொல்லும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செவிச்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லும்"}]},{"w":"சேர்ந்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சேர்ந்"},{"k":"N","s":"த"}]},{"w":"நகையும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நகை"},{"k":"N","s":"யும்"}]},{"w":"அவித்தொழுகல்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அவித்"},{"k":"I","s":"தொழு"},{"k":"N","s":"கல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆன்ற பெரியா ரகத்து.","err":null,"seers":[{"w":"ஆன்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆன்"},{"k":"N","s":"ற"}]},{"w":"பெரியா","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"யா"}]},{"w":"ரகத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ரகத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":695,"ch":70,"l1":"எப்பொருளும் ஓரார் தொடரார்மற் றப்பொருளை","l2":"விட்டக்கால் கேட்க மறை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"(அரசர் மறைபொருள் பேசும் போது) எப்பொருளையும் உற்றுக் கேட்காமல் தொடர்ந்து வினவாமல் அப்பொருளை அவரே விட்டுச் சொன்னபோது கேட்டறிய வேண்டும்.","en":"(When the king is engaged) in secret counsel (with others), ministers should neither over-hear anything whatever nor pry into it with inquisitive questions, but (wait to) listen when it is divulged (by","lines":[{"t":"எப்பொருளும் ஓரார் தொடரார்மற் றப்பொருளை","err":null,"seers":[{"w":"எப்பொருளும்","