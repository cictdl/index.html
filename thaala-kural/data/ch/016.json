[{"n":151,"ch":16,"l1":"அகழ்வாரைத் தாங்கும் நிலம்போலத் தம்மை","l2":"இகழ்வார்ப் பொறுத்தல் தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தன்னை வெட்டுவோரையும் விழாமல் தாங்குகின்ற நிலம் போல், தம்மை இகழ்வாரையும் பொறுப்பதே தலையான பண்பாகும்","en":"To bear with those who revile us, just as the earth bears up those who dig it, is the first of virtues","lines":[{"t":"அகழ்வாரைத் தாங்கும் நிலம்போலத் தம்மை","err":null,"seers":[{"w":"அகழ்வாரைத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அகழ்"},{"k":"N","s":"வா"},{"k":"N","s":"ரைத்"}]},{"w":"தாங்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தாங்"},{"k":"N","s":"கும்"}]},{"w":"நிலம்போலத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நிலம்"},{"k":"N","s":"போ"},{"k":"N","s":"லத்"}]},{"w":"தம்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தம்"},{"k":"N","s":"மை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இகழ்வார்ப் பொறுத்தல் தலை.","err":null,"seers":[{"w":"இகழ்வார்ப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இகழ்"},{"k":"N","s":"வார்ப்"}]},{"w":"பொறுத்தல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொறுத்"},{"k":"N","s":"தல்"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":152,"ch":16,"l1":"பொறுத்தல் இறப்பினை என்றும் அதனை","l2":"மறத்தல் அதனினும் நன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"வரம்பு கடந்து பிறர் செய்யும் தீங்கை எப்போதும் பொறுக்க வேண்டும்; அத் தீங்கை நினைவிலும் கொள்ளாமல் மறந்து விடுதல் பொறுத்தலை விட நல்லது.","en":"Bear with reproach even when you can retaliate; but to forget it will be still better than that","lines":[{"t":"பொறுத்தல் இறப்பினை என்றும் அதனை","err":null,"seers":[{"w":"பொறுத்தல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொறுத்"},{"k":"N","s":"தல்"}]},{"w":"இறப்பினை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இறப்"},{"k":"I","s":"பினை"}]},{"w":"என்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"றும்"}]},{"w":"அதனை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மறத்தல் அதனினும் நன்று.","err":null,"seers":[{"w":"மறத்தல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மறத்"},{"k":"N","s":"தல்"}]},{"w":"அதனினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அத"},{"k":"I","s":"னினும்"}]},{"w":"நன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":153,"ch":16,"l1":"இன்மையுள் இன்மை விருந்தொரால் வன்மையுள்","l2":"வன்மை மடவார்ப் பொறை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வறுமையுள் வறுமை, விருந்தினரைப் போற்றாமல் நீக்குதல்; வல்லமையுள் வல்லமை என்பது அறிவிலார் தீங்கு செய்தலைப் பொறுத்தலாகும்.","en":"To neglect hospitality is poverty of poverty To bear with the ignorant is might of might","lines":[{"t":"இன்மையுள் இன்மை விருந்தொரால் வன்மையுள்","err":null,"seers":[{"w":"இன்மையுள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"},{"k":"N","s":"யுள்"}]},{"w":"இன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"}]},{"w":"விருந்தொரால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விருந்"},{"k":"I","s":"தொரால்"}]},{"w":"வன்மையுள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வன்"},{"k":"N","s":"மை"},{"k":"N","s":"யுள்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வன்மை மடவார்ப் பொறை.","err":null,"seers":[{"w":"வன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வன்"},{"k":"N","s":"மை"}]},{"w":"மடவார்ப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மட"},{"k":"N","s":"வார்ப்"}]},{"w":"பொறை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பொறை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":154,"ch":16,"l1":"நிறையுடைமை நீங்காமை வேண்டின் பொற்யுடைமை","l2":"போற்றி யொழுகப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நிறை உடையவனாக இருக்கும் தன்மை தன்னை விட்டு நீங்காமல் இருக்க வேண்டினால், பொறுமையைப் போற்றி ஒழுக வேண்டும்.","en":"If you desire that greatness should never leave, you preserve in your conduct the exercise of patience","lines":[{"t":"நிறையுடைமை நீங்காமை வேண்டின் பொற்யுடைமை","err":null,"seers":[{"w":"நிறையுடைமை","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நிறை"},{"k":"I","s":"யுடை"},{"k":"N","s":"மை"}]},{"w":"நீங்காமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நீங்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"வேண்டின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டின்"}]},{"w":"பொற்யுடைமை","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பொற்"},{"k":"I","s":"யுடை"},{"k":"N","s":"மை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","நேரொன்றிய ஆசிரியத்தளை"]},{"t":"போற்றி யொழுகப் படும்.","err":null,"seers":[{"w":"போற்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றி"}]},{"w":"யொழுகப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"யொழு"},{"k":"N","s":"கப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":155,"ch":16,"l1":"ஒறுத்தாரை ஒன்றாக வையாரே வைப்பர்","l2":"பொறுத்தாரைப் பொன்போற் பொதிந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"( தீங்கு செய்தவரைப்) பொறுக்காமல் வருத்தினவரை உலகத்தார் ஒரு பொருளாக மதியார்; ஆனால், பொறுத்தவரைப் பொன்போல் மனத்துள் வைத்து மதிப்பர்.","en":"(The wise) will not at all esteem the resentful They will esteem the patient just as the gold which they lay up with care","lines":[{"t":"ஒறுத்தாரை ஒன்றாக வையாரே வைப்பர்","err":null,"seers":[{"w":"ஒறுத்தாரை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒறுத்"},{"k":"N","s":"தா"},{"k":"N","s":"ரை"}]},{"w":"ஒன்றாக","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒன்"},{"k":"N","s":"றா"},{"k":"N","s":"க"}]},{"w":"வையாரே","name":"தேமாங்காய்","cls":"காய்",