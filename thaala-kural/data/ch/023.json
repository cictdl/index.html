[{"n":221,"ch":23,"l1":"வறியார்க்கொன்று ஈவதே ஈகைமற் றெல்லாம்","l2":"குறியெதிர்ப்பை நீர துடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"வறியவர்க்கு ஒரு பொருளைக் கொடுப்பதே ஈகை எனப்படுவது, மற்றவர்க்குக் கொடுப்பதெல்லாம் பயன் எதிர்பார்த்து கொடுக்கும் தன்மை உடையது.","en":"To give to the destitute is true charity All other gifts have the nature of (what is done for) a measured return","lines":[{"t":"வறியார்க்கொன்று ஈவதே ஈகைமற் றெல்லாம்","err":null,"seers":[{"w":"வறியார்க்கொன்று","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"வறி"},{"k":"N","s":"யார்க்"},{"k":"N","s":"கொன்"},{"k":"N","s":"று"}]},{"w":"ஈவதே","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஈ"},{"k":"I","s":"வதே"}]},{"w":"ஈகைமற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"கை"},{"k":"N","s":"மற்"}]},{"w":"றெல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றெல்"},{"k":"N","s":"லாம்"}]}],"thalai":[null,"இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"குறியெதிர்ப்பை நீர துடைத்து.","err":null,"seers":[{"w":"குறியெதிர்ப்பை","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குறி"},{"k":"I","s":"யெதிர்ப்"},{"k":"N","s":"பை"}]},{"w":"நீர","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீ"},{"k":"N","s":"ர"}]},{"w":"துடைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துடைத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":222,"ch":23,"l1":"நல்லாறு எனினும் கொளல்தீது மேலுலகம்","l2":"இல்லெனினும் ஈதலே நன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பிறரிடம் பொருள் பெற்றுக் கொள்ளுதல் நல்ல நெறி என்றாலும் கொள்ளல் தீமையானது, மேலுலகம் இல்லை என்றாலும் பிறக்குக் கொடுப்பதே சிறந்தது.","en":"To beg is evil, even though it were said that it is a good path (to heaven) To give is good, even though it were said that those who do so cannot obtain heaven","lines":[{"t":"நல்லாறு எனினும் கொளல்தீது மேலுலகம்","err":null,"seers":[{"w":"நல்லாறு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"N","s":"லா"},{"k":"N","s":"று"}]},{"w":"எனினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"எனி"},{"k":"N","s":"னும்"}]},{"w":"கொளல்தீது","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கொளல்"},{"k":"N","s":"தீ"},{"k":"N","s":"து"}]},{"w":"மேலுலகம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மே"},{"k":"I","s":"லுல"},{"k":"N","s":"கம்"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இல்லெனினும் ஈதலே நன்று.","err":null,"seers":[{"w":"இல்லெனினும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"I","s":"லெனி"},{"k":"N","s":"னும்"}]},{"w":"ஈதலே","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஈ"},{"k":"I","s":"தலே"}]},{"w":"நன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":223,"ch":23,"l1":"இலனென்னும் எவ்வம் உரையாமை ஈதல்","l2":"குலனுடையான் கண்ணே யுள.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"யான் வறியவன் என்னும் துன்பச் சொல்லை ஒருவன் உரைப்பதற்கு முன் அவனுக்கு கொடுக்கும் தன்மை, நல்ல குடி பிறப்பு உடையவனிடம் உண்டு.","en":"(Even in a low state) not to adopt the mean expedient of saying \"I have nothing,\" but to give, is the characteristic of the mad of noble birth","lines":[{"t":"இலனென்னும் எவ்வம் உரையாமை ஈதல்","err":null,"seers":[{"w":"இலனென்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இல"},{"k":"N","s":"னென்"},{"k":"N","s":"னும்"}]},{"w":"எவ்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எவ்"},{"k":"N","s":"வம்"}]},{"w":"உரையாமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உரை"},{"k":"N","s":"யா"},{"k":"N","s":"மை"}]},{"w":"ஈதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"தல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"குலனுடையான் கண்ணே யுள.","err":null,"seers":[{"w":"குலனுடையான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குல"},{"k":"I","s":"னுடை"},{"k":"N","s":"யான்"}]},{"w":"கண்ணே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணே"}]},{"w":"யுள.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"யுள"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":224,"ch":23,"l1":"இன்னாது இரக்கப் படுதல் இரந்தவர்","l2":"இன்முகங் காணும் அளவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொருள் வேண்டும் என்ற இரந்தவரின் மகிழ்ந்த முகத்தைக் காணும் வரைக்கும் (இரத்தலைப் போலவே ) இரந்து கேட்கப்படுவதும் துன்பமானது.","en":"To see men begging from us in disagreeable, until we see their pleasant countenance","lines":[{"t":"இன்னாது இரக்கப் படுதல் இரந்தவர்","err":null,"seers":[{"w":"இன்னாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"N","s":"து"}]},{"w":"இரக்கப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இரக்"},{"k":"N","s":"கப்"}]},{"w":"படுதல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"படு"},{"k":"N","s":"தல்"}]},{"w":"இரந்தவர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இரந்"},{"k":"I","s":"தவர்"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இன்முகங் காணும் அளவு.","err":null,"seers":[{"w":"இன்முகங்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இன்"},{"k":"I","s":"முகங்"}]},{"w":"காணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணும்"}]},{"w":"அளவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அள"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":225,"ch":23,"l1":"ஆற்றுவார் ஆற்றல் பசிஆற்றல் அப்பசியை","l2":"மாற்றுவார் ஆற்றலின் பின்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தவ வலிமை உடையவரின் வலிமை பசியை பொறுத்துக் கொள்ளலாகும், அதுவும் அப் பசியை உணவு கொடுத்து மாற்றுகின்றவரின் ஆற்றலுக்குப் பிற்பட்டதாகும்.","en":"The power of those who perform penance is the power of enduring hunger It is inferior to the power of those who remove the hunger (of others)","lines":[{"t":"ஆற்றுவார் ஆற்றல் பசிஆற்றல் அப்பசியை","err":null,"seers":[{"w":"ஆற்றுவார்