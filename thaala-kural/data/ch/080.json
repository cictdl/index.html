[{"n":791,"ch":80,"l1":"நாடாது நட்டலிற் கேடில்லை நட்டபின்","l2":"வீடில்லை நட்பாள் பவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நட்புச் செய்தபிறகு நட்பை உடையவர்க்கு அதிலிருந்து விடுதலை இல்லை, ஆகையால் ஆராயாமல் நட்புச் செய்வது போல் கெடுதியானது வேறு இல்லை.","en":"As those who are of a friendly nature will not forsake (a friend) after once loving (him), there is no evil so great as contracting a friendship without due inquiry","lines":[{"t":"நாடாது நட்டலிற் கேடில்லை நட்டபின்","err":null,"seers":[{"w":"நாடாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"டா"},{"k":"N","s":"து"}]},{"w":"நட்டலிற்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நட்"},{"k":"I","s":"டலிற்"}]},{"w":"கேடில்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கே"},{"k":"N","s":"டில்"},{"k":"N","s":"லை"}]},{"w":"நட்டபின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நட்"},{"k":"I","s":"டபின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வீடில்லை நட்பாள் பவர்க்கு.","err":null,"seers":[{"w":"வீடில்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வீ"},{"k":"N","s":"டில்"},{"k":"N","s":"லை"}]},{"w":"நட்பாள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பாள்"}]},{"w":"பவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":792,"ch":80,"l1":"ஆய்ந்தாய்ந்து கொள்ளாதான் கேண்மை கடைமுறை","l2":"தான்சாம் துயரம் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஆராய்ந்து ஆராய்ந்து நட்புக் கொள்ளாதவனுடைய நட்பு, இறுதியில் தான் சாவதற்க்குக் காரணமானத் துயரத்தை உண்டாக்கிவிடும்.","en":"The friendship contracted by him who has not made repeated inquiry will in the end grieve (him) to death","lines":[{"t":"ஆய்ந்தாய்ந்து கொள்ளாதான் கேண்மை கடைமுறை","err":null,"seers":[{"w":"ஆய்ந்தாய்ந்து","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆய்ந்"},{"k":"N","s":"தாய்ந்"},{"k":"N","s":"து"}]},{"w":"கொள்ளாதான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"ளா"},{"k":"N","s":"தான்"}]},{"w":"கேண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேண்"},{"k":"N","s":"மை"}]},{"w":"கடைமுறை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கடை"},{"k":"I","s":"முறை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தான்சாம் துயரம் தரும்.","err":null,"seers":[{"w":"தான்சாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தான்"},{"k":"N","s":"சாம்"}]},{"w":"துயரம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துய"},{"k":"N","s":"ரம்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":793,"ch":80,"l1":"குணமும் குடிமையும் குற்றமும் குன்றா","l2":"இனனும் அறிந்தியாக்க நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவனுடைய குணத்தையும், குடிப்பிறப்பையும் குற்றத்தையும் குறையாத இனத்தாரின் இயல்பையும் அறிந்து அவனேடு நட்புக் கொள்ள வேண்டும்.","en":"Make friendship (with one) after ascertaining (his) character, birth, defects and the whole of one's relations","lines":[{"t":"குணமும் குடிமையும் குற்றமும் குன்றா","err":null,"seers":[{"w":"குணமும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குண"},{"k":"N","s":"மும்"}]},{"w":"குடிமையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குடி"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"குற்றமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"குற்"},{"k":"I","s":"றமும்"}]},{"w":"குன்றா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குன்"},{"k":"N","s":"றா"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இனனும் அறிந்தியாக்க நட்பு.","err":null,"seers":[{"w":"இனனும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இன"},{"k":"N","s":"னும்"}]},{"w":"அறிந்தியாக்க","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறிந்"},{"k":"I","s":"தியாக்"},{"k":"N","s":"க"}]},{"w":"நட்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":794,"ch":80,"l1":"குடிப்பிறந்து தன்கண் பழிநாணு வானைக்","l2":"கொடுத்தும் கொளல்வேண்டும் நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"உயர்ந்த குடியில் பிறந்து, தன்னிடத்தில் வருகின்றப் பழிக்கு நாணுகின்றவனைப் பொருள் கொடுத்தாவது நட்பு கொள்ளவேண்டும்.","en":"The friendship of one who belongs to a (good) family and is afraid of (being charged with) guilt, is worth even purchasing","lines":[{"t":"குடிப்பிறந்து தன்கண் பழிநாணு வானைக்","err":null,"seers":[{"w":"குடிப்பிறந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குடிப்"},{"k":"I","s":"பிறந்"},{"k":"N","s":"து"}]},{"w":"தன்கண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தன்"},{"k":"N","s":"கண்"}]},{"w":"பழிநாணு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பழி"},{"k":"N","s":"நா"},{"k":"N","s":"ணு"}]},{"w":"வானைக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"னைக்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கொடுத்தும் கொளல்வேண்டும் நட்பு.","err":null,"seers":[{"w":"கொடுத்தும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கொடுத்"},{"k":"N","s":"தும்"}]},{"w":"கொளல்வேண்டும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கொளல்"},{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"நட்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":795,"ch":80,"l1":"அழச்சொல்லி அல்லது இடித்து வழக்கறிய","l2":"வல்லார்நடபு ஆய்ந்து கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நன்மை இல்லாதச் சொற்களைக் கண்டபோது வருந்தும்படியாக இடிந்துச் சொல்லி, உலகநடையை அறிய வல்லவரின் நட்பை ஆராய்ப்து கொள்ள வேண்டும்.","en":"You should examine and secure the friendship of those who can speak so as to make you weep over a crime (before its commission) or rebuke you severely (after you have done it) and are able to teach","lines":[{"t":"அழச்சொல்லி அல்லது இடித்து வழக்கறிய","err":null,"seers":[{"w":"அழச்சொல்லி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அழச்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லி"}]},{"w":"அல்லது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அல்"},{"k":"I","s":"லது"}]},{"w":"இடித்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடித்"},{"k":"N","s":"து"}]},{"w":"வழக்கறிய","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வழக்"},{"k":"I","s":"கறி"},{"k":"N","s":"ய"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"வல்லார்நடபு ஆய்ந்து கொளல்.","err":null,"seers":[{"w":"வல்லார்நடபு","name":"தேமாநறும்பூ","cls":"நான்கசை","a":[{"k":"N","s":"வல்"},{"k":"N","s":"லார்"},{"k":"I","s":"நட"},{"k":"N","s":"பு"}]},{"w":"ஆய்ந்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆய்ந்"},{"k":"N","s":"து"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":[null,"இயற்சீர் வெண்டளை"]}]},{"n":796,"ch":80,"l1":"கேட்டினும் உண்டோர் உறுதி கிளைஞரை","l2":"நீட்டி அளப்பதோர் கோல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கேடு வந்த போதும் ஒருவகை நன்மை உண்டு, அக் கேடு ஒருவனுடைய நண்பரின் இயல்புகளை நீட்டிஅளந்து பார்ப்பதொரு கோலாகும்.","en":"Even in ruin there is some good; (for) it is a rod by which one may measure fully (the affection of one's) relations","lines":[{"t":"கேட்டினும் உண்டோர் உறுதி கிளைஞரை","err":null,"seers":[{"w":"கேட்டினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கேட்"},{"k":"I","s":"டினும்"}]},{"w":"உண்டோர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டோர்"}]},{"w":"உறுதி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உறு"},{"k":"N","s":"தி"}]},{"w":"கிளைஞரை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கிளை"},{"k":"I","s":"ஞரை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நீட்டி அளப்பதோர் கோல்.","err":null,"seers":[{"w":"நீட்டி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீட்"},{"k":"N","s":"டி"}]},{"w":"அளப்பதோர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அளப்"},{"k":"I","s":"பதோர்"}]},{"w":"கோல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கோல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":797,"ch":80,"l1":"ஊதியம் என்பது ஒருவற்குப் பேதையார்","l2":"கேண்மை ஒரீஇ விடல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவனுக்கு ஊதியம் என்று சொல்லப்படுவது, அறிவில்லாதவறுடன் செய்து கொண்ட நட்பிலிருந்து நீங்கி அவரைக் கைவிடுதலாகும்.","en":"It is indead a gain for one to renounce the friendship of fools","lines":[{"t":"ஊதியம் என்பது ஒருவற்குப் பேதையார்","err":null,"seers":[{"w":"ஊதியம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"தியம்"}]},{"w":"என்பது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பது"}]},{"w":"ஒருவற்குப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வற்"},{"k":"N","s":"குப்"}]},{"w":"பேதையார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"யார்"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","வெண்சீர் வெண்டளை"]},{"t":"கேண்மை ஒரீஇ விடல்.","err":null,"seers":[{"w":"கேண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேண்"},{"k":"N","s":"மை"}]},{"w":"ஒரீஇ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒரீ"},{"k":"N","s":"இ"}]},{"w":"விடல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":798,"ch":80,"l1":"உள்ளற்க உள்ளம் சிறுகுவ கொள்ளற்க","l2":"அல்லற்கண் ஆற்றறுப்பார் நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஊக்கம் குறைவதற்குக் காரணமான செயல்களை எண்ணாமலிருக்க வேண்டும், அதுபோல் துன்பம் வந்த போது கைவிடுகின்றவரின் நட்பைக் கொள்ளாதிருக்க வேண்டும்.","en":"Do not think of things that discourage your mind, nor contract friendship with those who would forsake you in adversity","lines":[{"t":"உள்ளற்க உள்ளம் சிறுகுவ கொள்ளற்க","err":null,"seers":[{"w":"உள்ளற்க","nam