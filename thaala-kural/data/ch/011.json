[{"n":101,"ch":11,"l1":"செய்யாமல் செய்த உதவிக்கு வையகமும்","l2":"வானகமும் ஆற்றல் அரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"தான் ஓர் உதவியும் முன் செய்யாதிருக்கப் பிறன் தனக்கு செய்த உதவிக்கு மண்ணுலகத்தையும் விண்ணுலகத்தையும் கைமாறாகக் கொடுத்தாலும் ஈடு ஆக முடியாது.","en":"(The gift of) heaven and earth is not an equivalent for a benefit which is conferred where none had been received","lines":[{"t":"செய்யாமல் செய்த உதவிக்கு வையகமும்","err":null,"seers":[{"w":"செய்யாமல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யா"},{"k":"N","s":"மல்"}]},{"w":"செய்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"த"}]},{"w":"உதவிக்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உத"},{"k":"N","s":"விக்"},{"k":"N","s":"கு"}]},{"w":"வையகமும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வை"},{"k":"I","s":"யக"},{"k":"N","s":"மும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வானகமும் ஆற்றல் அரிது.","err":null,"seers":[{"w":"வானகமும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"I","s":"னக"},{"k":"N","s":"மும்"}]},{"w":"ஆற்றல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றல்"}]},{"w":"அரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":102,"ch":11,"l1":"காலத்தி னாற்செய்த நன்றி சிறிதெனினும்","l2":"ஞாலத்தின் மாணப் பெரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"உற்ற காலத்தில் ஒருவன் செய்த உதவி சிறிதளவாக இருந்தாலும், அதன் தன்மையை அறிந்தால் உலகைவிட மிகப் பெரிதாகும்.","en":"A favour conferred in the time of need, though it be small (in itself), is (in value) much larger than the world","lines":[{"t":"காலத்தி னாற்செய்த நன்றி சிறிதெனினும்","err":null,"seers":[{"w":"காலத்தி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"லத்"},{"k":"N","s":"தி"}]},{"w":"னாற்செய்த","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"னாற்"},{"k":"N","s":"செய்"},{"k":"N","s":"த"}]},{"w":"நன்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றி"}]},{"w":"சிறிதெனினும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறி"},{"k":"I","s":"தெனி"},{"k":"N","s":"னும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஞாலத்தின் மாணப் பெரிது.","err":null,"seers":[{"w":"ஞாலத்தின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஞா"},{"k":"N","s":"லத்"},{"k":"N","s":"தின்"}]},{"w":"மாணப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மா"},{"k":"N","s":"ணப்"}]},{"w":"பெரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":103,"ch":11,"l1":"பயன்தூக்கார் செய்த உதவி நயன்தூக்கின்","l2":"நன்மை கடலின் பெரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"இன்ன பயன் கிடைக்கும் என்றுஆராயாமல் ஒருவன் செய்த உதவியின் அன்புடைமையை ஆராய்ந்தால் அதன் நன்மை கடலைவிட பெரியதாகும் .","en":"If we weigh the excellence of a benefit which is conferred without weighing the return, it is larger than the sea","lines":[{"t":"பயன்தூக்கார் செய்த உதவி நயன்தூக்கின்","err":null,"seers":[{"w":"பயன்தூக்கார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பயன்"},{"k":"N","s":"தூக்"},{"k":"N","s":"கார்"}]},{"w":"செய்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"த"}]},{"w":"உதவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உத"},{"k":"N","s":"வி"}]},{"w":"நயன்தூக்கின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நயன்"},{"k":"N","s":"தூக்"},{"k":"N","s":"கின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நன்மை கடலின் பெரிது.","err":null,"seers":[{"w":"நன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"மை"}]},{"w":"கடலின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கட"},{"k":"N","s":"லின்"}]},{"w":"பெரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":104,"ch":11,"l1":"தினைத்துணை நன்றி செயினும் பனைத்துணையாக்","l2":"கொள்வர் பயன்தெரி வார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவன் தினையளவாகிய உதவியைச் செய்த போதிலும் அதன் பயனை ஆராய்கின்றவர், அதனையே பனையளவாகக் கொண்டு போற்றுவர்.","en":"Though the benefit conferred be as small as a millet seed, those who know its advantage will consider it as large as a palmyra fruit","lines":[{"t":"தினைத்துணை நன்றி செயினும் பனைத்துணையாக்","err":null,"seers":[{"w":"தினைத்துணை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தினைத்"},{"k":"I","s":"துணை"}]},{"w":"நன்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றி"}]},{"w":"செயினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செயி"},{"k":"N","s":"னும்"}]},{"w":"பனைத்துணையாக்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பனைத்"},{"k":"I","s":"துணை"},{"k":"N","s":"யாக்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கொள்வர் பயன்தெரி வார்.","err":null,"seers":[{"w":"கொள்வர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"வர்"}]},{"w":"பயன்தெரி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பயன்"},{"k":"I","s":"தெரி"}]},{"w":"வார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"வார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":105,"ch":11,"l1":"உதவி வரைத்தன்று உதவி உதவி","l2":"செயப்பட்டார் சால்பின் வரைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"கைமாறாகச் செய்யும் உதவி முன் செய்த உதவியின் அளவை உடையது அன்று, உதவி செய்யப்பட்டவற்றின் பண்புக்கு ஏற்ற அளவை உடையதாகும்.","en":"The benefit itself is not the measure of the benefit; the worth of those who have received it is its measure","lines":[{"t":"உதவி வரைத்தன்று உதவி உதவி","err":null,"seers":[{"w":"உதவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உத"},{"k":"N","s":"வி"}]},{"w":"வரைத்தன்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வரைத்"},{"k":"N","s":"தன்"},{"k":"N","s":"று"}]},{"w":"உதவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உத"},{"k":"N","s":"வி"}]},{"w":"உதவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உத"},{"k":"N","s":"வி"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"செயப்பட்டார் சால்பின் வரைத்து.","err":null,"seers":[{"w":"செயப்பட்டார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செயப்"},{"k":"N","s":"பட்"},{"k":"N","s":"டார்"}]},{"w":"சால்பின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சால்"},{"k":"N","s":"பின்"}]},{"w":"வரைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வரைத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":106,"ch":11,"l1":"மறவற்க மாசற்றார் கேண்மை துறவற்க","l2":"துன்பத்துள் துப்பாயார் நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"குற்றமற்றவரின் உறவை எப்போதும் மறக்கலாகாது: துன்பம் வந்த காலத்தில் உறுதுணையாய் உதவியவர்களின் நட்பை எப்போதும் விடாலாகாது .","en":"Forsake not the friendship of those who have been your staff in adversity Forget not be benevolence of the blameless","lines":[{"t":"மறவற்க மாசற்றார் கேண்மை துறவற்க","err":null,"seers":[{"w":"மறவற்க","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மற"},{"k":"N","s":"வற்"},{"k":"N","s":"க"}]},{"w":"மாசற்றார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"N","s":"சற்"},{"k":"N","s":"றார்"}]},{"w":"கேண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேண்"},{"k":"N","s":"மை"}]},{"w":"துறவற்க","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துற"},{"k":"N","s":"வற்"},{"k":"N","s":"க"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"துன்பத்துள் துப்பாயார் நட்பு.","err":null,"seers":[{"w":"துன்பத்துள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"துன்"},{"k":"N","s":"பத்"},{"k":"N","s":"துள்"}]},{"w":"துப்பாயார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"துப்"},{"k":"N","s":"பா"},{"k":"N","s":"யார்"}]},{"w":"நட்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":107,"ch":11,"l1":"எழுமை எழுபிறப்பும் உள்ளுவர் தங்கண்","l2":"விழுமந் துடைத்தவர் நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தம்முடைய துன்பத்தைப் போக்கி உதவியவரின் நட்பைப் பல்வேறு வகையான பிறவியிலும் மறவாமல் போற்றுவர் பெரியோர்.","en":"(The wise) will remember throughout their seven-fold births the love of those who have wiped away their affliction","lines":[{"t":"எழுமை எழுபிறப்பும் உள்ளுவர் தங்கண்","err":null,"seers":[{"w":"எழுமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"எழு"},{"k":"N","s":"மை"}]},{"w":"எழுபிறப்பும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"எழு"},{"k":"I","s":"பிறப்"},{"k":"N","s":"பும்"}]},{"w":"உள்ளுவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளுவர்"}]},{"w":"தங்கண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தங்"},{"k":"N","s":"கண்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"விழுமந் துடைத்தவர் நட்பு.","err":null,"seers":[{"w":"விழுமந்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விழு"},{"k":"N","s":"மந்"}]},{"w":"துடைத்தவர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"துடைத்"},{"k":"I","s":"தவர்"}]},{"w":"நட்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":108,"ch":11,"l1":"நன்றி மறப்பது நன்றன்று நன்றல்லது","l2":"அன்றே மறப்பது நன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["ஒன்றிய வஞ்சித்தளை"],"mv":"ஒருவரர்முன்செய்த நன்மையை மறப்பது அறம் அன்று; அவர் செய்த தீமையைச் செய்த அப்‌பொழுதே மறந்து விடுவது அறம்.","en":"It is not good to forget a benefit; it is good to forget an injury even in the very moment (in which it is inflicted)","lines":[{"t":"நன்றி மறப்பது நன்றன்று நன்றல்லது","err":null,"seers":[{"w":"நன்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றி"}]},{"w":"மறப்பது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மறப்"},{"k":"I","s":"பது"}]},{"w":"நன்றன்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றன்"},{"k":"N","s":"று"}]},{"w":"நன்றல்லது","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றல்"},{"k":"I","s":"லது"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அன்றே மறப்பது நன்று.","err":null,"seers":[{"w":"அன்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"றே"}]},{"w":"மறப்பது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மறப்"},{"k":"I","s":"பது"}]},{"w":"நன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":109,"ch":11,"l1":"கொன்றன்ன இன்னா செயினும் அவர்செய்த","l2":"ஒன்றுநன்று உள்ளக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"முன் உதவி செய்தவர் பின்பு ‌கொன்றார் போன்ற துன்பத்தைச் செய்தாரானாலும், அவர் முன் செய்த ஒரு நன்மையை நினைத்தாலும் அந்தத் துன்பம் கெடும்.","en":"Though one inflict an injury great as murder, it will perish before the thought of one benefit (formerly) conferred","lines":[{"t":"கொன்றன்ன இன்னா செயினும் அவர்செய்த","err":null,"seers":[{"w":"கொன்றன்ன","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொன்"},{"k":"N","s":"றன்"},{"k":"N","s":"ன"}]},{"w":"இன்னா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"}]},{"w":"செயினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செயி"},{"k":"N","s":"னும்"}]},{"w":"அவர்செய்த","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவர்"},{"k":"N","s":"செய்"},{"k":"N","s":"த"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஒன்றுநன்று உள்ளக் கெடும்.","err":null,"seers":[{"w":"ஒன்றுநன்று","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒன்"},{"k":"I","s":"றுநன்"},{"k":"N","s":"று"}]},{"w":"உள்ளக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளக்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":110,"ch":11,"l1":"எந்நன்றி கொன்றார்க்கும் உய்வுண்டாம் உய்வில்லை","l2":"செய்ந்நன்றி கொன்ற மகற்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"எந்த அறத்தை அழித்தவர்க்கும் தப்பிப் பிழைக்க வழி உண்டாகும்; ஒருவர் செய்த உதவியை மறந்து அழித்தவனுக்கு உய்வு இல்லை.","en":"He who has killed every virtue may yet escape; there is no escape for him who has killed a benefit","lines":[{"t":"எந்நன்றி கொன்றார்க்கும் உய்வுண்டாம் உய்வில்லை","err":null,"seers":[{"w":"எந்நன்றி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எந்"},{"k":"N","s":"நன்"},{"k":"N","s":"றி"}]},{"w":"கொன்றார்க்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொன்"},{"k":"N","s":"றார்க்"},{"k":"N","s":"கும்"}]},{"w":"உய்வுண்டாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உய்"},{"k":"N","s":"வுண்"},{"k":"N","s":"டாம்"}]},{"w":"உய்வில்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உய்"},{"k":"N","s":"வில்"},{"k":"N","s":"லை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"செய்ந்நன்றி கொன்ற மகற்கு.","err":null,"seers":[{"w":"செய்ந்நன்றி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்ந்"},{"k":"N","s":"நன்"},{"k":"N","s":"றி"}]},{"w":"கொன்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொன்"},{"k":"N","s":"ற"}]},{"w":"மகற்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மகற்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]