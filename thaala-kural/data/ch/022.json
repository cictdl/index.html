[{"n":211,"ch":22,"l1":"கைம்மாறு வேண்டா கடப்பாடு மாரிமாட்டு","l2":"என் ஆற்றுங் கொல்லோ உலகு.","ok":true,"reseg":true,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"இந்த உலகத்தார் மழைக்கு என்ன கைமாறு செய்கின்றனர்;, மழை போன்றவர் செய்யும் உதவிகளும் கைமாறு வேண்டாதவை.","en":"Benevolence seeks not a return. What does the world give back to the clouds ?","lines":[{"t":"கைம்மாறு வேண்டா கடப்பாடு மாரிமாட்டு","err":null,"seers":[{"w":"கைம்மாறு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கைம்"},{"k":"N","s":"மா"},{"k":"N","s":"று"}]},{"w":"வேண்டா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டா"}]},{"w":"கடப்பாடு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கடப்"},{"k":"N","s":"பா"},{"k":"N","s":"டு"}]},{"w":"மாரிமாட்டு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"I","s":"ரிமாட்"},{"k":"N","s":"டு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"என் ஆற்றுங் கொல்லோ உலகு.","err":null,"seers":[{"w":"என்ஆற்றுங்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"N","s":"ஆற்"},{"k":"N","s":"றுங்"}]},{"w":"கொல்லோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லோ"}]},{"w":"உலகு","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உல"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":212,"ch":22,"l1":"தாளாற்றித் தந்த பொருளெல்லாம் தக்கார்க்கு","l2":"வேளாண்மை செய்தற் பொருட்டு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒப்புரவாளன் தன்னால் இயன்ற முயற்சி செய்து சேர்த்த பொருள் எல்லாம் தக்கவர்க்கு உதவி செய்வதற்கே ஆகும்.","en":"All the wealth acquired with perseverance by the worthy is for the exercise of benevolence","lines":[{"t":"தாளாற்றித் தந்த பொருளெல்லாம் தக்கார்க்கு","err":null,"seers":[{"w":"தாளாற்றித்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தா"},{"k":"N","s":"ளாற்"},{"k":"N","s":"றித்"}]},{"w":"தந்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தந்"},{"k":"N","s":"த"}]},{"w":"பொருளெல்லாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளெல்"},{"k":"N","s":"லாம்"}]},{"w":"தக்கார்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தக்"},{"k":"N","s":"கார்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வேளாண்மை செய்தற் பொருட்டு.","err":null,"seers":[{"w":"வேளாண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"ளாண்"},{"k":"N","s":"மை"}]},{"w":"செய்தற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தற்"}]},{"w":"பொருட்டு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொருட்"},{"k":"N","s":"டு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":213,"ch":22,"l1":"புத்தே ளுலகத்தும் ஈண்டும் பெறலரிதே","l2":"ஒப்புரவின் நல்ல பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பிறர்க்கு உதவி செய்து வாழும் ஒப்புரவைப் போல நல்லனவாகிய வேறு அறப்பகுதிகளைத் தேவருலகத்திலும் இவ்வுலகத்திலும் பெறுதல் இயலாது.","en":"It is difficult to obtain another good equal to benevolence either in this world or in that of the gods","lines":[{"t":"புத்தே ளுலகத்தும் ஈண்டும் பெறலரிதே","err":null,"seers":[{"w":"புத்தே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"புத்"},{"k":"N","s":"தே"}]},{"w":"ளுலகத்தும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ளுல"},{"k":"N","s":"கத்"},{"k":"N","s":"தும்"}]},{"w":"ஈண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈண்"},{"k":"N","s":"டும்"}]},{"w":"பெறலரிதே","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பெற"},{"k":"I","s":"லரி"},{"k":"N","s":"தே"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஒப்புரவின் நல்ல பிற.","err":null,"seers":[{"w":"ஒப்புரவின்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒப்"},{"k":"I","s":"புர"},{"k":"N","s":"வின்"}]},{"w":"நல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நல்"},{"k":"N","s":"ல"}]},{"w":"பிற.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பிற"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":214,"ch":22,"l1":"ஒத்த தறவோன் உயிர்வாழ்வான் மற்றையான்","l2":"செத்தாருள் வைக்கப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒப்புரவை அறிந்து போற்றிப் பிறர்க்கு உதவியாக வாழ்கின்றவன் உயிர்வாழ்கின்றவன் ஆவான், மற்றவன் செத்தவருள் சேர்த்துக் கருதப்படுவான்.","en":"He truly lives who knows (and discharges) the proper duties (of benevolence) He who knows them not will be reckoned among the dead","lines":[{"t":"ஒத்த தறவோன் உயிர்வாழ்வான் மற்றையான்","err":null,"seers":[{"w":"ஒத்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒத்"},{"k":"N","s":"த"}]},{"w":"தறவோன்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தற"},{"k":"N","s":"வோன்"}]},{"w":"உயிர்வாழ்வான்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உயிர்"},{"k":"N","s":"வாழ்"},{"k":"N","s":"வான்"}]},{"w":"மற்றையான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றை"},{"k":"N","s":"யான்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"செத்தாருள் வைக்கப் படும்.","err":null,"seers":[{"w":"செத்தாருள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செத்"},{"k":"N","s":"தா"},{"k":"N","s":"ருள்"}]},{"w":"வைக்கப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வைக்"},{"k":"N","s":"கப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":215,"ch":22,"l1":"ஊருணி நீர்நிறைந் தற்றே உலகவாம்","l2":"பேரறி வாளன் திரு.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒப்புரவினால் உலகம் வாழுமாறு விரும்பும் பேரறிவாளியின் செல்வம், ஊரார் நீருண்ணும் குளம் நீரால் நிறைந்தாற் போன்றது.","en":"The wealth of that man of eminent knowledge who desires to exercise the benevolence approved of by the world, is like the full waters of a city-tank","lines":[{"t":"ஊருணி நீர்நிறைந் தற்றே உலகவாம்","err":null,"seers":[{"w":"ஊருணி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"ருணி"}]},{"w":"நீர்நிறைந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீர்"},{"k":"I","s":"நிறைந்"}]},{"w":"தற்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"றே"}]},{"w":"உலகவாம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உல"},{"k":"I","s":"கவாம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பேரறி வாளன் திரு.","err":null,"seers":[{"w":"பேரறி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பே"},{"k":"I","s":"ரறி"}]},{"w":"வாளன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ளன்"}]},{"w":"திரு.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"திரு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":216,"ch":22,"l1":"பயன்மரம் உள்ளூர்ப் பழுத்தற்றால் செல்வம்","l2":"நயனுடை யான்கண் படின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒப்புராவாகிய நற்பண்பு உடையவனிடம் செல்வம் சேர்ந்தால் அஃது ஊரின் நடுவே உள்ள பயன் மிகுந்த மரம் பழங்கள் பழுத்தாற் போன்றது.","en":"The wealth of a man (possessed of the virtue) of benevolence is like the ripening of a fruitful tree in the midst of a town","lines":[{"t":"பயன்மரம் உள்ளூர்ப் பழுத்தற்றால் செல்வம்","err":null,"seers":[{"w":"பயன்மரம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பயன்"},{"k":"I","s":"மரம்"}]},{"w":"உள்ளூர்ப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளூர்ப்"}]},{"w":"பழுத்தற்றால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பழுத்"},{"k":"N","s":"தற்"},{"k":"N","s":"றால்"}]},{"w":"செல்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நயனுடை யான்கண் படின்.","err":null,"seers":[{"w":"நயனுடை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நய"},{"k":"I","s":"னுடை"}]},{"w":"யான்கண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யான்"},{"k":"N","s":"கண்"}]},{"w":"படின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":217,"ch":22,"l1":"மருந்தாகித் தப்பா மரத்தற்றால் செல்வம்","l2":"பெருந்தகை யான்கண் படின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒப்புரவாகிய பெருந்தகைமை உடையவனிடத்து செல்வம் சேர்ந்தால் அஃது எல்லா உறுப்புகளுக்கும் மருந்தாகிப் பயன்படத் தவறாத மரம் போன்றது.","en":"If wealth be in the possession of a man who has the great excellence (of benevolence), it is like a tree which as a medicine is an infallible cure for disease","lines":[{"t":"மருந்தாகித் தப்பா மரத்தற்றால் செல்வம்","err":null,"seers":[{"w":"மருந்தாகித்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மருந்"},{"k":"N","s":"தா"},{"k":"N","s":"கித்"}]},{"w":"தப்பா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தப்"},{"k":"N","s":"பா"}]},{"w":"மரத்தற்றால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மரத்"},{"k":"N","s":"தற்"},{"k":"N","s":"றால்"}]},{"w":"செல்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பெருந்தகை யான்கண் படின்.","err":null,"seers":[{"w":"பெருந்தகை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பெருந்"},{"k":"I","s":"தகை"}]},{"w":"யான்கண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யான்"},{"k":"N","s":"கண்"}]},{"w":"படின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":218,"ch":22,"l1":"இடனில் பருவத்தும் ஒப்புரவிற்கு ஒல்கார்","l2":"கடனறி காட்சி யவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒப்புரவு அறிந்து ஒழுதலாகியத் தன் கடமை அறிந்த அறிவை உடையவர், செல்வ வளம் இல்லாத காலத்திலும் ஒப்புரவுக்குத் தளர மாட்டார்.","en":"The wise who know what is duty will not scant their benevolence even when they are without wealth","lines":[{"t":"இடனில் பருவத்தும் ஒப்புரவிற்கு ஒல்கார்","err":null,"seers":[{"w":"இடனில்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இட"},{"k":"N","s":"னில்"}]},{"w":"பருவத்தும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":