்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"துய்ப்"},{"k":"I","s":"பதூ"},{"k":"N","s":"உம்"}]},{"w":"இல்லார்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லார்க்"},{"k":"N","s":"கு"}]},{"w":"அடுக்கிய","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அடுக்"},{"k":"I","s":"கிய"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","கலித்தளை"]},{"t":"கோடியுண் டாயினும் இல்.","err":null,"seers":[{"w":"கோடியுண்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கோ"},{"k":"I","s":"டியுண்"}]},{"w":"டாயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"டா"},{"k":"I","s":"யினும்"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1006,"ch":101,"l1":"ஏதம் பெருஞ்செல்வம் தான்துவ்வான் தக்கார்க்கொன்று","l2":"ஈதல் இயல்பிலா தான்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":[null],"mv":"தானும் நுகராமல் தக்கவற்க்கு ஒன்று கொடுத்து உதவும் இயல்பும் இல்லாமல் வாழ்கின்றவன், தன்னிடமுள்ள பெருஞ் செல்வத்திற்கு ஒரு நோய் ஆவான்.","en":"He who enjoys not (his riches) nor relieves the wants of the worthy is a disease to his wealth","lines":[{"t":"ஏதம் பெருஞ்செல்வம் தான்துவ்வான் தக்கார்க்கொன்று","err":null,"seers":[{"w":"ஏதம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"தம்"}]},{"w":"பெருஞ்செல்வம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெருஞ்"},{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"தான்துவ்வான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தான்"},{"k":"N","s":"துவ்"},{"k":"N","s":"வான்"}]},{"w":"தக்கார்க்கொன்று","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"தக்"},{"k":"N","s":"கார்க்"},{"k":"N","s":"கொன்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஈதல் இயல்பிலா தான்.","err":null,"seers":[{"w":"ஈதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"தல்"}]},{"w":"இயல்பிலா","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இயல்"},{"k":"I","s":"பிலா"}]},{"w":"தான்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தான்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1007,"ch":101,"l1":"அற்றார்க்கொன்று ஆற்றாதான் செல்வம் மிகநலம்","l2":"பெற்றாள் தமியள்மூத் தற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொருள் இல்லாத வறியவர்க்கு ஒரு பொருள் கொடுத்து உதவாதவனுடையச் செல்வம், மிக்க அழகு பெற்றவள் தனியாக வாழ்ந்து முதுமையுற்றாற் போன்றது.","en":"The wealth of him who never bestows anything on the destitute is like a woman of beauty growing old without a husband","lines":[{"t":"அற்றார்க்கொன்று ஆற்றாதான் செல்வம் மிகநலம்","err":null,"seers":[{"w":"அற்றார்க்கொன்று","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"அற்"},{"k":"N","s":"றார்க்"},{"k":"N","s":"கொன்"},{"k":"N","s":"று"}]},{"w":"ஆற்றாதான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றா"},{"k":"N","s":"தான்"}]},{"w":"செல்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"மிகநலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மிக"},{"k":"I","s":"நலம்"}]}],"thalai":[null,"வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பெற்றாள் தமியள்மூத் தற்று.","err":null,"seers":[{"w":"பெற்றாள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பெற்"},{"k":"N","s":"றாள்"}]},{"w":"தமியள்மூத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தமி"},{"k":"N","s":"யள்"},{"k":"N","s":"மூத்"}]},{"w":"தற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1008,"ch":101,"l1":"நச்சப் படாதவன் செல்வம் நடுவூருள்","l2":"நச்சு மரம்பழுத் தற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பிறர்க்கு உதவாத காரணத்தால் ஒருவராலும் விரும்பப்படாதவனுடைய செல்வம், ஊர் நடுவில் நச்சு மரம் பழுத்தாற் போன்றது.","en":"The wealth of him who is disliked (by all) is like the fruit-bearing of the etty tree in the midst of a town","lines":[{"t":"நச்சப் படாதவன் செல்வம் நடுவூருள்","err":nul