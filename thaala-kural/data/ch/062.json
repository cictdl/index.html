:"I","s":"விடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":617,"ch":62,"l1":"மடியுளாள் மாமுகடி என்ப மடியிலான்","l2":"தாளுளான் தாமரையி னாள்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவனுடைய சோம்பலில் கரிய மூதேவி வாழ்கின்றாள், சோம்பல் இல்லாதவனுடைய முயற்சியிலே திருமகள் வாழ்கின்றாள்.","en":"They say that the black Mudevi (the goddess of adversity) dwells with laziness, and the Latchmi (the goddess of prosperity) dwells with the labour of the industrious","lines":[{"t":"மடியுளாள் மாமுகடி என்ப மடியிலான்","err":null,"seers":[{"w":"மடியுளாள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மடி"},{"k":"I","s":"யுளாள்"}]},{"w":"மாமுகடி","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"I","s":"முக"},{"k":"N","s":"டி"}]},{"w":"என்ப","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"ப"}]},{"w":"மடியிலான்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மடி"},{"k":"I","s":"யிலான்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தாளுளான் தாமரையி னாள்.","err":null,"seers":[{"w":"தாளுளான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தா"},{"k":"I","s":"ளுளான்"}]},{"w":"தாமரையி","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தா"},{"k":"I","s":"மரை"},{"k":"N","s":"யி"}]},{"w":"னாள்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"னாள்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":618,"ch":62,"l1":"பொறியின்மை யார்க்கும் பழியன்று அறிவறிந்து","l2":"ஆள்வினை இன்மை பழி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நன்மை விளைவிக்கும் ஊழ் இல்லாதிருத்தல் யார்க்கும் பழி அன்று, அறிய வேண்டியவற்றை அறிந்து முயற்சி செய்யாதிருத்தலே பழி.","en":"Adverse fate is no disgrace to any one; to be without exertion and without knowing what should be known, is disgrace","lines":[{"t":"பொறியின்மை யார்க்கும் பழியன்று அறிவறிந்து","err":null,"seers":[{"w":"பொறியின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொறி"},{"k":"N","s":"யின்"},{"k":"N","s":"மை"}]},{"w":"யார்க்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யார்க்"},{"k":"N","s":"கும்"}]},{"w":"பழியன்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பழி"},{"k":"N","s":"யன்"},{"k":"N","s":"று"}]},{"w":"அறிவறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வறிந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","கலித்தளை"]},{"t":"ஆள்வினை இன்மை பழி.","err":null,"seers":[{"w":"ஆள்வினை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆள்"},{"k":"I","s":"வினை"}]},{"w":"இன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"}]},{"w":"பழி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பழி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":619,"ch":62,"l1":"தெய்வத்தான் ஆகா தெனினும் முயற்சிதன்","l2":"மெய்வருத்தக் கூலி தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஊழியின் காரணத்தால் ஒரு செயல் செய்ய முடியாமல் போகுமாயினும், முயற்சி தன் உடம்பு வருந்திய வருத்தத்தின் கூலியையாவது கொடுக்கும்.","en":"Although it be said that, through fate, it cannot be attained, yet labour, with bodily exertion, will yield its reward","lines":[{"t":"தெய்வத்தான் ஆகா தெனினும் முயற்சிதன்","err":null,"seers":[{"w":"தெய்வத்தான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தெய்"},{"k":"N","s":"வத்"},{"k":"N","s":"தான்"}]},{"w":"ஆகா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கா"}]},{"w":"தெனினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தெனி"},{"k":"N","s":"னும்"}]},{"w":"முயற்சிதன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"முயற்"},{"k":"I","s":"சிதன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மெய்வருத்தக் கூலி தரும்.","err":null,"seers":[{"w":"மெய்வருத்தக்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மெய்"},{"k":"I","s":"வருத்"},{"k":"N","s":"தக்"}]},{"w":"கூலி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கூ"},{"k":"N","s":"லி"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":620,"ch":62,"l1":"ஊழையும் உப்பக்கம் காண்பர் உலைவின்றித்","l2":"தாழாது உஞற்று பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"சோர்வு இல்லாமல் முயற்சியில் குறைவு இல்லாமல் முயல்கின்றவர்,(செயலுக்கு இடையூறாக வரும்)ஊழையும் ஒரு காலத்தில் தோல்வியுறச் செய்யும்.","en":"They who labour on, without fear and without fainting will see even fate (put) behind their back","lines":[{"t":"ஊழையும் உப்பக்கம் காண்பர் உலைவின்றித்","err":null,"seers":[{"w":"ஊழையும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"ழை"},{"k":"N","s":"யும்"}]},{"w":"உப்பக்கம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உப்"},{"k":"N","s":"பக்"},{"k":"N","s":"கம்"}]},{"w":"காண்பர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காண்"},{"k":"N","s":"பர்"}]},{"w":"உலைவின்றித்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உலை"},{"k":"N","s":"வின்"},{"k":"N","s":"றித்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தாழாது உஞற்று பவர்.","err":null,"seers":[{"w":"தாழாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தா"},{"k":"N","s":"ழா"},{"k":"N","s":"து"}]},{"w":"உஞற்று","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உஞற்"},{"k":"N","s":"று"}]},{"w":"பவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]}]