[{"n":611,"ch":62,"l1":"அருமை உடைத்தென்று அசாவாமை வேண்டும்","l2":"பெருமை முயற்சி தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இது செய்வதற்கு அருமையாகாது என்று சோர்வுறாமல் இருக்க வேண்டும், அதைச் செய்வதற்க்குத் தக்க பெருமையை முயற்சி உண்டாக்கும்,","en":"Yield not to the feebleness which says, \"this is too difficult to be done\"; labour will give the greatness (of mind) which is necessary (to do it)","lines":[{"t":"அருமை உடைத்தென்று அசாவாமை வேண்டும்","err":null,"seers":[{"w":"அருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரு"},{"k":"N","s":"மை"}]},{"w":"உடைத்தென்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உடைத்"},{"k":"N","s":"தென்"},{"k":"N","s":"று"}]},{"w":"அசாவாமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அசா"},{"k":"N","s":"வா"},{"k":"N","s":"மை"}]},{"w":"வேண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","வெண்சீர் வெண்டளை"]},{"t":"பெருமை முயற்சி தரும்.","err":null,"seers":[{"w":"பெருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"மை"}]},{"w":"முயற்சி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முயற்"},{"k":"N","s":"சி"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":612,"ch":62,"l1":"வினைக்கண் வினைகெடல் ஓம்பல் வினைக்குறை","l2":"தீர்ந்தாரின் தீர்ந்தன்று உலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தொழிலாகிய குறையைச் செய்யாமல் கைவிட்டவரை உலகம் கைவிடும், ஆகையால் தொழில் முயற்சி இல்லாதிருத்தலை ஒழிக்க வேண்டும்.","en":"Take care not to give up exertion in the midst of a work; the world will abandon those who abandon their unfinished work","lines":[{"t":"வினைக்கண் வினைகெடல் ஓம்பல் வினைக்குறை","err":null,"seers":[{"w":"வினைக்கண்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வினைக்"},{"k":"N","s":"கண்"}]},{"w":"வினைகெடல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வினை"},{"k":"I","s":"கெடல்"}]},{"w":"ஓம்பல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓம்"},{"k":"N","s":"பல்"}]},{"w":"வினைக்குறை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வினைக்"},{"k":"I","s":"குறை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தீர்ந்தாரின் தீர்ந்தன்று உலகு.","err":null,"seers":[{"w":"தீர்ந்தாரின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தீர்ந்"},{"k":"N","s":"தா"},{"k":"N","s":"ரின்"}]},{"w":"தீர்ந்தன்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தீர்ந்"},{"k":"N","s":"தன்"},{"k":"N","s":"று"}]},{"w":"உலகு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உல"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","கலித்தளை"]}]},{"n":613,"ch":62,"l1":"தாளாண்மை என்னும் தகைமைக்கண் தங்கிற்றே","l2":"வேளாண்மை என்னுஞ் செருக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பிறர்க்கு உதவிசெய்தல் என்னும் மேம்பட்ட நிலைமை முயற்சி என்று சொல்லப்படுகின்ற உயர்ந்த பண்பில் நிலைத்திருக்கின்றது.","en":"The lustre of munificence will dwell only with the dignity of laboriousness or efforts","lines":[{"t":"தாளாண்மை என்னும் தகைமைக்கண் தங்கிற்றே","err":null,"seers":[{"w":"தாளாண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தா"},{"k":"N","s":"ளாண்"},{"k":"N","s":"மை"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"தகைமைக்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தகை"},{"k":"N","s":"மைக்"},{"k":"N","s":"கண்"}]},{"w":"தங்கிற்றே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தங்"},{"k":"N","s":"கிற்"},{"k":"N","s":"றே"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வேளாண்மை என்னுஞ் செருக்கு.","err":null,"seers":[{"w":"வேளாண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"ளாண்"},{"k":"N","s":"மை"}]},{"w":"என்னுஞ்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னுஞ்"}]},{"w":"செருக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செருக்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":614,"ch":62,"l1":"தாளாண்மை இல்லாதான் வேளாண்மை பேடிகை","l2":"வாளாண்மை போலக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"முயற்சி இல்லாதவன் உதவிசெய்பவனாக இருத்தல், பேடி தன் கையில் வாளை எடுத்தும் ஆளும் தன்மைபோல் நிறைவேறாமல் போகும்.","en":"The liberality of him, who does not labour, will fail, like the manliness of a hermaphrodite, who has a sword in its hand","lines":[{"t":"தாளாண்மை இல்லாதான் வேளாண்மை பேடிகை","err":null,"seers":[{"w":"தாளாண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தா"},{"k":"N","s":"ளாண்"},{"k":"N","s":"மை"}]},{"w":"இல்லாதான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"தான்"}]},{"w":"வேளாண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"ளாண்"},{"k":"N","s":"மை"}]},{"w":"பேடிகை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பே"},{"k":"I","s":"டிகை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வாளாண்மை போலக் கெடும்.","err":null,"seers":[{"w":"வாளாண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"N","s":"ளாண்"},{"k":"N","s":"மை"}]},{"w":"போலக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"லக்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":615,"ch":62,"l1":"இன்பம் விழையான் வினைவிழைவான் தன்கேளிர்","l2":"துன்பம் துடைத்தூன்றும் தூண்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தன் இன்பத்தை விரும்பாதவனாய் மேற்க்கொண்டச் செயலை முடிக்க விரும்புகிறவன், தன் சுற்றத்தாரின் துன்பத்தைப் போக்கித் தாங்குகின்ற தூண் ஆவான்.","en":"He who desires not pleasure, but desires labour, will be a pillar to sustain his relations, wiping away their sorrows","lines":[{"t":"இன்பம் விழையான் வினைவிழைவான் தன்கேளிர்","err":null,"seers":[{"w":"இன்பம்","name":"தேமா","cls":"மா","a":