[{"n":831,"ch":84,"l1":"பேதைமை என்பதொன்று யாதெனின் ஏதங்கொண்டு","l2":"ஊதியம் போக விடல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":[null],"mv":"பேதைமை என்று சொல்லப்படுவது யாது என்றால், தனக்கு கெடுதியானதைக் கைக் கொண்டு ஊதியமானதை கைவிடுதலாகும்.","en":"Folly is one (of the chief defects); it is that which (makes one) incur loss and forego gain","lines":[{"t":"பேதைமை என்பதொன்று யாதெனின் ஏதங்கொண்டு","err":null,"seers":[{"w":"பேதைமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"மை"}]},{"w":"என்பதொன்று","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பதொன்"},{"k":"N","s":"று"}]},{"w":"யாதெனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தெனின்"}]},{"w":"ஏதங்கொண்டு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"தங்"},{"k":"N","s":"கொண்"},{"k":"N","s":"டு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஊதியம் போக விடல்.","err":null,"seers":[{"w":"ஊதியம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"தியம்"}]},{"w":"போக","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"க"}]},{"w":"விடல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":832,"ch":84,"l1":"பேதைமையுள் எல்லாம் பேதைமை காதன்மை","l2":"கையல்ல தன்கட் செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவனுக்கு பேதைமை எல்லாவற்றிலும் மிக்க பேதைமை, தன் ஒழுக்கத்திற்குப் பொருந்தாததில் தன் விருப்பத்தை செலுத்துதல் ஆகும்.","en":"The greatest folly is that which leads one to take delight in doing what is forbidden","lines":[{"t":"பேதைமையுள் எல்லாம் பேதைமை காதன்மை","err":null,"seers":[{"w":"பேதைமையுள்","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"மை"},{"k":"N","s":"யுள்"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"பேதைமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"மை"}]},{"w":"காதன்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"தன்"},{"k":"N","s":"மை"}]}],"thalai":[null,"நேரொன்றிய ஆசிரியத்தளை","வெண்சீர் வெண்டளை"]},{"t":"கையல்ல தன்கட் செயல்.","err":null,"seers":[{"w":"கையல்ல","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கை"},{"k":"N","s":"யல்"},{"k":"N","s":"ல"}]},{"w":"தன்கட்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தன்"},{"k":"N","s":"கட்"}]},{"w":"செயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":833,"ch":84,"l1":"நாணாமை நாடாமை நாரின்மை யாதொன்றும்","l2":"பேணாமை பேதை தொழில்","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தகாதவற்றிற்கு நாணாமலிருத்தல், தக்கவற்றை நாடாமலிருத்தல், அன்பு இல்லாமை, நன்மை ஒன்றையும் விரும்பாமை ஆகியவை பேதையின் தொழில்கள்.","en":"Shamelessness indifference (to what must be sought after), harshness, and aversion for everything (that ought to be desired) are the qualities of the fool","lines":[{"t":"நாணாமை நாடாமை நாரின்மை யாதொன்றும்","err":null,"seers":[{"w":"நாணாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணா"},{"k":"N","s":"மை"}]},{"w":"நாடாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"டா"},{"k":"N","s":"மை"}]},{"w":"நாரின்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"ரின்"},{"k":"N","s":"மை"}]},{"w":"யாதொன்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"N","s":"தொன்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பேணாமை பேதை தொழில்","err":null,"seers":[{"w":"பேணாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"ணா"},{"k":"N","s":"மை"}]},{"w":"பேதை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"}]},{"w":"தொழில்","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தொழில்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":834,"ch":84,"l1":"ஓதி உணர்ந்தும் பிறர்க்குரைத்தும் தானடங்காப்","l2":"பேதையின் பேதையார் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நூல்களை ஓதியும், அவற்றின் பொருளை உணர்ந்தும், பிறர்க்கு எடுத்துச் சொல்லியும் தான் அவற்றின் நெறியில் அடங்கி ஒழுகாதப் பேதைப் போல் வேறு பேதையர் இல்லை.","en":"There are no greater fools than he who, though he has read and understood (a great deal) and even taught it to others, does not walk according to his own teaching","lines":[{"t":"ஓதி உணர்ந்தும் பிறர்க்குரைத்தும் தானடங்காப்","err":null,"seers":[{"w":"ஓதி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓ"},{"k":"N","s":"தி"}]},{"w":"உணர்ந்தும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உணர்ந்"},{"k":"N","s":"தும்"}]},{"w":"பிறர்க்குரைத்தும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறர்க்"},{"k":"I","s":"குரைத்"},{"k":"N","s":"தும்"}]},{"w":"தானடங்காப்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தா"},{"k":"I","s":"னடங்"},{"k":"N","s":"காப்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பேதையின் பேதையார் இல்.","err":null,"seers":[{"w":"பேதையின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"யின்"}]},{"w":"பேதையார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"யார்"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":835,"ch":84,"l1":"ஒருமைச் செயலாற்றும் பேதை எழுமையும்","l2":"தான்புக் கழுந்தும் அளறு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"எழுப்பிறப்பிலும் தான் புகுந்து அழுந்துவதற்கு உரிய நரகத் துன்பத்தைப் பேதைத் தன் ஒருபிறவியில் செய்து கொள்ள வல்லவனாவான்.","en":"A fool can procure in a single birth a hell into which he may enter and suffer through all the seven births","lines":[{"t":"ஒருமைச் செயலாற்றும் பேதை எழுமையும்","err":null,"seers":[{"w":"ஒருமைச்","