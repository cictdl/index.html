[{"n":1261,"ch":127,"l1":"வாளற்றுப் புற்கென்ற கண்ணும் அவர்சென்ற","l2":"நாளொற்றித் தேய்ந்த விரல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"என் கண்களும் அவர் வரும் வழியைப் பார்த்துப் பார்த்து ஒளி இழந்து அழகு கெட்டன; விரல்களும் அவர் சென்ற நாட்களைக் குறித்துத் தொட்டுத் தொட்டுத் தேய்ந்தன.","en":"My finger has worn away by marking (on the wall) the days he has been absent while my eyes have lost their lustre and begin to fail","lines":[{"t":"வாளற்றுப் புற்கென்ற கண்ணும் அவர்சென்ற","err":null,"seers":[{"w":"வாளற்றுப்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"N","s":"ளற்"},{"k":"N","s":"றுப்"}]},{"w":"புற்கென்ற","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"புற்"},{"k":"N","s":"கென்"},{"k":"N","s":"ற"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"அவர்சென்ற","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவர்"},{"k":"N","s":"சென்"},{"k":"N","s":"ற"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நாளொற்றித் தேய்ந்த விரல்.","err":null,"seers":[{"w":"நாளொற்றித்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"ளொற்"},{"k":"N","s":"றித்"}]},{"w":"தேய்ந்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தேய்ந்"},{"k":"N","s":"த"}]},{"w":"விரல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விரல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1262,"ch":127,"l1":"இலங்கிழாய் இன்று மறப்பின்என் தோள்மேல்","l2":"கலங்கழியும் காரிகை நீத்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தோழி! காதலரின் பிரிவால்துன்புற்று வருந்துகின்ற இன்றும் அவரை மறந்து விட்டால், அழகு கெட்டு என் தோள் மேல் அணிந்துள்ள அணிகள் கழலுமாறு நேரும்.","en":"O you bright-jewelled maid, if I forget (him) today, my shoulders will lose their beauty even in the other life and make my bracelets loose","lines":[{"t":"இலங்கிழாய் இன்று மறப்பின்என் தோள்மேல்","err":null,"seers":[{"w":"இலங்கிழாய்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இலங்"},{"k":"I","s":"கிழாய்"}]},{"w":"இன்று","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"று"}]},{"w":"மறப்பின்என்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மறப்"},{"k":"N","s":"பின்"},{"k":"N","s":"என்"}]},{"w":"தோள்மேல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோள்"},{"k":"N","s":"மேல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கலங்கழியும் காரிகை நீத்து.","err":null,"seers":[{"w":"கலங்கழியும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கலங்"},{"k":"I","s":"கழி"},{"k":"N","s":"யும்"}]},{"w":"காரிகை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கா"},{"k":"I","s":"ரிகை"}]},{"w":"நீத்து.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1263,"ch":127,"l1":"உரன்நசைஇ உள்ளம் துணையாகச் சென்றார்","l2":"வரல்நசைஇ இன்னும் உளேன்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"வெற்றியை விரும்பி ஊக்கமே துணையாகக் கொண்டு வெளிநாட்டுக்குச் சென்ற காதலர், திரும்பி வருதலைக் காண விரும்பியே இன்னும் யான் உயிரோடு இருக்கின்றேன்.","en":"I still live by longing for the arrival of him who has gone out of love for victory and with valour as his guide","lines":[{"t":"உரன்நசைஇ உள்ளம் துணையாகச் சென்றார்","err":null,"seers":[{"w":"உரன்நசைஇ","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உரன்"},{"k":"I","s":"நசை"},{"k":"N","s":"இ"}]},{"w":"உள்ளம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளம்"}]},{"w":"துணையாகச்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துணை"},{"k":"N","s":"யா"},{"k":"N","s":"கச்"}]},{"w":"சென்றார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சென்"},{"k":"N","s":"றார்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வரல்நசைஇ இன்னும் உளேன்.","err":null,"seers":[{"w":"வரல்நசைஇ","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வரல்"},{"k":"I","s":"நசை"},{"k":"N","s":"இ"}]},{"