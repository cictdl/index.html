[{"n":301,"ch":31,"l1":"செல்லிடத்துக் காப்பான் சினங்காப்பான் அல்லிடத்துக்","l2":"காக்கின்என் காவாக்கால் என்?","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பலிக்கும் இடத்தில் சினம் வராமல் காப்பவனே சினம் காப்பவன், பலிக்காத இடத்தில் காத்தால் என்ன, காக்கா விட்டால் என்ன?","en":"He restrains his anger who restrains it when it can injure; when it cannot injure, what does it matter whether he restrain it, or not ?","lines":[{"t":"செல்லிடத்துக் காப்பான் சினங்காப்பான் அல்லிடத்துக்","err":null,"seers":[{"w":"செல்லிடத்துக்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"I","s":"லிடத்"},{"k":"N","s":"துக்"}]},{"w":"காப்பான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காப்"},{"k":"N","s":"பான்"}]},{"w":"சினங்காப்பான்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சினங்"},{"k":"N","s":"காப்"},{"k":"N","s":"பான்"}]},{"w":"அல்லிடத்துக்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"அல்"},{"k":"I","s":"லிடத்"},{"k":"N","s":"துக்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"காக்கின்என் காவாக்கால் என்?","err":null,"seers":[{"w":"காக்கின்என்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"காக்"},{"k":"N","s":"கின்"},{"k":"N","s":"என்"}]},{"w":"காவாக்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"வாக்"},{"k":"N","s":"கால்"}]},{"w":"என்?","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"என்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":302,"ch":31,"l1":"செல்லா இடத்துச் சினந்தீது செல்லிடத்தும்","l2":"இல்அதனின் தீய பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பலிக்காத இடத்தில் (தன்னை விட வலியவரிடத்தில்) சினம் கொள்வது தீங்கு. பலிக்கும் இடத்திலும் (மெலியவரித்திலும்) சினத்தைவிடத் தீயவை வேறு இல்லை.","en":"Anger is bad, even when it cannot injure; when it can injure; there is no greater evil","lines":[{"t":"செல்லா இடத்துச் சினந்தீது செல்லிடத்தும்","err":null,"seers":[{"w":"செல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"லா"}]},{"w":"இடத்துச்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடத்"},{"k":"N","s":"துச்"}]},{"w":"சினந்தீது","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சினந்"},{"k":"N","s":"தீ"},{"k":"N","s":"து"}]},{"w":"செல்லிடத்தும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"I","s":"லிடத்"},{"k":"N","s":"தும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இல்அதனின் தீய பிற.","err":null,"seers":[{"w":"இல்அதனின்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"I","s":"அத"},{"k":"N","s":"னின்"}]},{"w":"தீய","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"ய"}]},{"w":"பிற.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பிற"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":303,"ch":31,"l1":"மறத்தல் வெகுளியை யார்மாட்டும் தீய","l2":"பிறத்தல் அதனான் வரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"யாரிடத்திலும் சினம் கொள்ளாமல் அதை மறந்து விட வேண்டும், தீமையான விளைவுகள் அச் சினத்தாலேயே ஏற்படும்.","en":"Forget anger towards every one, as fountains of evil spring from it","lines":[{"t":"மறத்தல் வெகுளியை யார்மாட்டும் தீய","err":null,"seers":[{"w":"மறத்தல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மறத்"},{"k":"N","s":"தல்"}]},{"w":"வெகுளியை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வெகு"},{"k":"I","s":"ளியை"}]},{"w":"யார்மாட்டும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யார்"},{"k":"N","s":"மாட்"},{"k":"N","s":"டும்"}]},{"w":"தீய","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"ய"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பிறத்தல் அதனான் வரும்.","err":null,"seers":[{"w":"பிறத்தல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிறத்"},{"k":"N","s":"தல்"}]},{"w":"அதனான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னான்"}]},{"w":"வரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":304,"ch":31,"l1":"நகையும் உவகையும் கொல்லும் சினத்தின்","l2":"பகையும் உளவோ பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"முகமலர்ச்சியும் அகமலர்ச்சியும் கொல்லுகின்ற சினத்தை விட ஒருவனுக்கு பகையானவை வேறு உள்ளனவோ?","en":"What other foe to man works such annoy?","lines":[{"t":"நகையும் உவகையும் கொல்லும் சினத்தின்","err":null,"seers":[{"w":"நகையும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நகை"},{"k":"N","s":"யும்"}]},{"w":"உவகையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உவ"},{"k":"N","s":"கை"},{"k":"N","s":"யும்"}]},{"w":"கொல்லும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லும்"}]},{"w":"சினத்தின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சினத்"},{"k":"N","s":"தின்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பகையும் உளவோ பிற.","err":null,"seers":[{"w":"பகையும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பகை"},{"k":"N","s":"யும்"}]},{"w":"உளவோ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உள"},{"k":"N","s":"வோ"}]},{"w":"பிற.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பிற"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":305,"ch":31,"l1":"தன்னைத்தான் காக்கின் சினங்காக்க காவாக்கால்","l2":"தன்னையே கொல்லுஞ் சினம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவன் தன்னைத்தான் காத்துக் கொள்வதானால் சினம் வராமல் காத்துக் கொள்ள வேண்டும், காக்கா விட்டால் சினம் தன்னையே அழித்து விடும்.","en":"If a man would guard himself, let him guard against anger; if he do not guard it, anger will kill him","lines":[{"t":"தன்னைத்தான் காக்கின் சினங்காக்க காவாக்கால்","err":null,"seers":[{"w":"தன்னைத்தான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தன்"},{"k":"N","s":"னைத்"},{"k":"N","s":"தான்"}]},{"w":"காக்கின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காக்"},{"k":"N","s":"கின்"}]},{"w":"சினங்காக்க","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சினங்"},{"k":"N","s":"கா