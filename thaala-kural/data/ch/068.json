்","err":null,"seers":[{"w":"பொருள்கருவி","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருள்"},{"k":"I","s":"கரு"},{"k":"N","s":"வி"}]},{"w":"காலம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"லம்"}]},{"w":"வினையிடனொடு","name":"கருவிளங்கனி","cls":"கனி","a":[{"k":"I","s":"வினை"},{"k":"I","s":"யிட"},{"k":"I","s":"னொடு"}]},{"w":"ஐந்தும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஐந்"},{"k":"N","s":"தும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை"]},{"t":"இருள்தீர எண்ணிச் செயல்.","err":null,"seers":[{"w":"இருள்தீர","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இருள்"},{"k":"N","s":"தீ"},{"k":"N","s":"ர"}]},{"w":"எண்ணிச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எண்"},{"k":"N","s":"ணிச்"}]},{"w":"செயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":676,"ch":68,"l1":"முடிவும் இடையூறும் முற்றியாங்கு எய்தும்","l2":"படுபயனும் பார்த்துச் செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"செயலை முடிக்கும் வகையும், வரக்கூடிய இடையூறும், முடிந்த போது கிடைக்கும் பெரும்பயனும் ஆகியவற்றை ஆராய்ந்து செய்ய வேண்டும்.","en":"An act is to be performed after considering the exertion required, the obstacles to be encountered, and the great profit to be gained (on its completion)","lines":[{"t":"முடிவும் இடையூறும் முற்றியாங்கு எய்தும்","err":null,"seers":[{"w":"முடிவும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முடி"},{"k":"N","s":"வும்"}]},{"w":"இடையூறும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இடை"},{"k":"N","s":"யூ"},{"k":"N","s":"றும்"}]},{"w":"முற்றியாங்கு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"முற்"},{"k":"I","s":"றியாங்"},{"k":"N","s":"கு"}]},{"w":"எய்தும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எய்"},{"k":"N","s":"தும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"படுபயனும் பார்த்துச் செயல்.","err":null,"seers":[{"w":"படுபயனும்","name":"கருவ