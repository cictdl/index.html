[{"n":671,"ch":68,"l1":"சூழ்ச்சி முடிவு துணிவெய்தல் அத்துணிவு","l2":"தாழ்ச்சியுள் தங்குதல் தீது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஆராய்ந்து எண்ணுவதற்கு எல்லை துணிவு கொள்வதே ஆகும், அவ்வாறு கொண்ட துணிவு காலந் தாழ்த்து நிற்பது குற்றமாகும்.","en":"Consultation ends in forming a resolution (to act); (but) delay in the execution of that resolve is an evil","lines":[{"t":"சூழ்ச்சி முடிவு துணிவெய்தல் அத்துணிவு","err":null,"seers":[{"w":"சூழ்ச்சி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சூழ்ச்"},{"k":"N","s":"சி"}]},{"w":"முடிவு","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முடி"},{"k":"N","s":"வு"}]},{"w":"துணிவெய்தல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துணி"},{"k":"N","s":"வெய்"},{"k":"N","s":"தல்"}]},{"w":"அத்துணிவு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"அத்"},{"k":"I","s":"துணி"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தாழ்ச்சியுள் தங்குதல் தீது.","err":null,"seers":[{"w":"தாழ்ச்சியுள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தாழ்ச்"},{"k":"I","s":"சியுள்"}]},{"w":"தங்குதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தங்"},{"k":"I","s":"குதல்"}]},{"w":"தீது.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":672,"ch":68,"l1":"தூங்குக தூங்கிச் செயற்பால தூங்கற்க","l2":"தூங்காது செய்யும் வினை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"காலந்தாழ்த்தி செய்யத் தக்கவற்றைக் காலந்தாழ்ந்தே செய்ய வேண்டும், காலந்தாழ்த்தாமல் விரைந்து செய்யவேண்டிய செயல்களைச் செய்ய காலந்தாழ்த்தக் கூடாது.","en":"Sleep over such (actions) as may be slept over; (but) never over such as may not be slept over","lines":[{"t":"தூங்குக தூங்கிச் செயற்பால தூங்கற்க","err":null,"seers":[{"w":"தூங்குக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தூங்"},{"k":"I","s":"குக"}]},{"w":"தூங்கிச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தூங்"},{"k":"N","s":"கிச்"}]},{"w":"செயற்பால","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செயற்"},{"k":"N","s":"பா"},{"k":"N","s":"ல"}]},{"w":"தூங்கற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தூங்"},{"k":"N","s":"கற்"},{"k":"N","s":"க"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தூங்காது செய்யும் வினை.","err":null,"seers":[{"w":"தூங்காது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தூங்"},{"k":"N","s":"கா"},{"k":"N","s":"து"}]},{"w":"செய்யும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யும்"}]},{"w":"வினை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வினை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":673,"ch":68,"l1":"ஒல்லும்வா யெல்லாம் வினைநன்றே ஒல்லாக்கால்","l2":"செல்லும்வாய் நோக்கிச் செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இயலுமிடத்தில் எல்லாம் செயலைச் செய்து முடித்தல் நல்லது, இயலாவில்லையானால் பயன்படும் இடம் நோக்கியாவது செய்ய வேண்டும்.","en":"Whenever it is possible (to overcome your enemy) the act (of fighting) is certainly good; if not, endeavour to employ some more successful method","lines":[{"t":"ஒல்லும்வா யெல்லாம் வினைநன்றே ஒல்லாக்கால்","err":null,"seers":[{"w":"ஒல்லும்வா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒல்"},{"k":"N","s":"லும்"},{"k":"N","s":"வா"}]},{"w":"யெல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யெல்"},{"k":"N","s":"லாம்"}]},{"w":"வினைநன்றே","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வினை"},{"k":"N","s":"நன்"},{"k":"N","s":"றே"}]},{"w":"ஒல்லாக்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒல்"},{"k":"N","s":"லாக்"},{"k":"N","s":"கால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"செல்லும்வாய் நோக்கிச் செயல்.","err":null,"seers":[{"w":"செல்லும்வாய்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"லும்"},{"k":"N","s":"வாய்"}]},{"w":"நோக்கிச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோக்"},{"k":"N","s":"