[{"n":651,"ch":66,"l1":"துணைநலம் ஆக்கம் த்ருஉம் வினைநலம்","l2":"வேண்டிய எல்லாந் தரும்.","ok":false,"reseg":false,"eetru":"மலர்","boundary":[null],"mv":"ஒருவனுக்கு வாய்த்த துணையின் நன்மை ஆக்கத்தைக் கொடுக்கும், செய்யும் வினையின் நன்மை அவன் விரும்பிய எல்லாவற்றையும் கொடுக்கும்.","en":"The efficacy of support will yield (only) wealth; (but) the efficacy of action will yield all that is desired","lines":[{"t":"துணைநலம் ஆக்கம் த்ருஉம் வினைநலம்","err":"த்ருஉம்","seers":[{"w":"துணைநலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"துணை"},{"k":"I","s":"நலம்"}]},{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]}],"thalai":[]},{"t":"வேண்டிய எல்லாந் தரும்.","err":null,"seers":[{"w":"வேண்டிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வேண்"},{"k":"I","s":"டிய"}]},{"w":"எல்லாந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாந்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":652,"ch":66,"l1":"என்றும் ஒருவுதல் வேண்டும் புகழொடு","l2":"நன்றி பயவா வினை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"புகழையும் அறத்தையும் தாராத (தூய்மை அற்ற) செயல்களை எக்காலத்திலும் ஒருவன் செய்யாமல் விட்டொழிக்க வேண்டும்.","en":"Ministers should at all times avoid acts which, in addition to fame, yield no benefit (for the future)","lines":[{"t":"என்றும் ஒருவுதல் வேண்டும் புகழொடு","err":null,"seers":[{"w":"என்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"றும்"}]},{"w":"ஒருவுதல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"ஒரு"},{"k":"I","s":"வுதல்"}]},{"w":"வேண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"புகழொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"புக"},{"k":"I","s":"ழொடு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நன்றி பயவா வினை.","err":null,"seers":[{"w":"நன்றி","name":"தேமா","cls":"மா","a":[{"k":"N","