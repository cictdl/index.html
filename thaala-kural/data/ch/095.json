[{"n":941,"ch":95,"l1":"மிகினும் குறையினும் நோய்செய்யும் நூலோர்","l2":"வளிமுதலா எண்ணிய மூன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"மருத்துவ நூலோர் வாதம் பித்தம் சிலேத்துமம் என எண்ணிய மூன்று அளவுக்கு மிகுந்தாலும் குறைந்தாலும் நோய் உண்டாகும்.","en":"If (food and work are either) excessive or deficient, the three things enumerated by (medical) writers, flatulence, biliousness, and phlegm, will cause (one) disease","lines":[{"t":"மிகினும் குறையினும் நோய்செய்யும் நூலோர்","err":null,"seers":[{"w":"மிகினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மிகி"},{"k":"N","s":"னும்"}]},{"w":"குறையினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"குறை"},{"k":"I","s":"யினும்"}]},{"w":"நோய்செய்யும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோய்"},{"k":"N","s":"செய்"},{"k":"N","s":"யும்"}]},{"w":"நூலோர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நூ"},{"k":"N","s":"லோர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வளிமுதலா எண்ணிய மூன்று.","err":null,"seers":[{"w":"வளிமுதலா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வளி"},{"k":"I","s":"முத"},{"k":"N","s":"லா"}]},{"w":"எண்ணிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எண்"},{"k":"I","s":"ணிய"}]},{"w":"மூன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மூன்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":942,"ch":95,"l1":"மருந்தென வேண்டாவாம் யாக்கைக்கு அருந்தியது","l2":"அற்றது போற்றி உணின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"முன் உண்ட உணவு செரித்த தன்மை ஆராய்ந்து போற்றியப் பிறகு தக்க அளவு உண்டால், உடம்பிற்கு மருந்து என ஒன்று வேண்டியதில்லை.","en":"No medicine is necessary for him who eats after assuring (himself) that what he has (already) eaten has been digested","lines":[{"t":"மருந்தென வேண்டாவாம் யாக்கைக்கு அருந்தியது","err":null,"seers":[{"w":"மருந்தென","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மருந்"},{"k":"I","s":"தென"}]},{"w":"வேண்டாவாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டா"},{"k":"N","s":"வாம்"}]},{"w":"யாக்கைக்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யாக்"},{"k":"N","s":"கைக்"},{"k":"N","s":"கு"}]},{"w":"அருந்தியது","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அருந்"},{"k":"I","s":"திய"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","கலித்தளை"]},{"t":"அற்றது போற்றி உணின்.","err":null,"seers":[{"w":"அற்றது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அற்"},{"k":"I","s":"றது"}]},{"w":"போற்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றி"}]},{"w":"உணின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"உணின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":943,"ch":95,"l1":"அற்றால் அறவறிந்து உண்க அஃதுடம்பு","l2":"பெற்றான் நெடிதுய்க்கும் ஆறு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"முன் உண்ட உணவு செரித்துவிட்டால், பின் வேண்டிய அளவு அறிந்து உண்ணவேண்டும், அதுவே உடம்பு பெற்றவன் அதை நெடுங்காலம் செலுத்தும் வழியாகும்.","en":"If (one's food has been) digested let one eat with moderation; (for) that is the way to prolong the life of an embodied soul","lines":[{"t":"அற்றால் அறவறிந்து உண்க அஃதுடம்பு","err":null,"seers":[{"w":"அற்றால்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அற்"},{"k":"N","s":"றால்"}]},{"w":"அறவறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அற"},{"k":"I","s":"வறிந்"},{"k":"N","s":"து"}]},{"w":"உண்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"க"}]},{"w":"அஃதுடம்பு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"அஃ"},{"k":"I","s":"துடம்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","நேரொன்றிய ஆசிரியத்தளை"]},{"t":"பெற்றான் நெடிதுய்க்கும் ஆறு.","err":null,"seers":[{"w":"பெற்றான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பெற்"},{"k":"N","s":"றான்"}]},{"w":"நெடிதுய்க்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நெடி"},{"k":"N","s":"துய்க்