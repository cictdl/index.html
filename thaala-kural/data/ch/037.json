[{"n":361,"ch":37,"l1":"அவாஎன்ப எல்லா உயிர்க்கும் எஞ்ஞான்றும்","l2":"தவாஅப் பிறப்பீனும் வித்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":["கலித்தளை"],"mv":"எல்லா உயிர்களுக்கும் எக்காலத்திலும் ஒழியாமல் வருகின்ற பிறவித்துன்பத்தை உண்டாக்கும் வித்து அவா என்றுக் கூறுவர்.","en":"(The wise) say that the seed, which produces unceasing births, at all times, to all creatures, is desire","lines":[{"t":"அவாஎன்ப எல்லா உயிர்க்கும் எஞ்ஞான்றும்","err":null,"seers":[{"w":"அவாஎன்ப","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவா"},{"k":"N","s":"என்"},{"k":"N","s":"ப"}]},{"w":"எல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லா"}]},{"w":"உயிர்க்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயிர்க்"},{"k":"N","s":"கும்"}]},{"w":"எஞ்ஞான்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எஞ்"},{"k":"N","s":"ஞான்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","நேரொன்றிய ஆசிரியத்தளை"]},{"t":"தவாஅப் பிறப்பீனும் வித்து.","err":null,"seers":[{"w":"தவாஅப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவா"},{"k":"N","s":"அப்"}]},{"w":"பிறப்பீனும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறப்"},{"k":"N","s":"பீ"},{"k":"N","s":"னும்"}]},{"w":"வித்து.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வித்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":362,"ch":37,"l1":"வேண்டுங்கால் வேண்டும் பிறவாமை மற்றது","l2":"வேண்டாமை வேண்ட வரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் ஒன்றை விரும்புவதனால் பிறவா நிலைமையை விரும்ப வேண்டும், அது அவா அற்ற நிலையை விரும்பினால் உண்டாகும்.","en":"If anything be desired, freedom from births should be desired; that (freedom from births) will be attained by desiring to be without desire","lines":[{"t":"வேண்டுங்கால் வேண்டும் பிறவாமை மற்றது","err":null,"seers":[{"w":"வேண்டுங்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டுங்"},{"k":"N","s":"கால்"}]},{"w":"வேண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"பிறவாமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிற"},{"k":"N","s":"வா"},{"k":"N","s":"மை"}]},{"w":"மற்றது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மற்"},{"k":"I","s":"றது"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வேண்டாமை வேண்ட வரும்.","err":null,"seers":[{"w":"வேண்டாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டா"},{"k":"N","s":"மை"}]},{"w":"வேண்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"ட"}]},{"w":"வரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":363,"ch":37,"l1":"வேண்டாமை அன்ன விழுச்செல்வம் ஈண்டில்லை","l2":"ஆண்டும் அஃதொப்பது இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அவா அற்ற நிலைமை போன்ற சிறந்த செல்வம் இவ்வுலகில் இல்லை, வேறு எங்கும் அதற்க்கு நிகரான ஒன்று இல்லை.","en":"There is in this world no excellence equal to freedom from desire; and even in that world, there is nothing like it","lines":[{"t":"வேண்டாமை அன்ன விழுச்செல்வம் ஈண்டில்லை","err":null,"seers":[{"w":"வேண்டாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டா"},{"k":"N","s":"மை"}]},{"w":"அன்ன","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"ன"}]},{"w":"விழுச்செல்வம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விழுச்"},{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"ஈண்டில்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஈண்"},{"k":"N","s":"டில்"},{"k":"N","s":"லை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஆண்டும் அஃதொப்பது இல்.","err":null,"seers":[{"w":"ஆண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆண்"},{"k":"N","s":"டும்"}]},{"w":"அஃதொப்பது","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"தொப்"},{"k":"I","s":"பது"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["நேரொன்றிய ஆசிரியத்தளை","ஒன்றிய வஞ்சித்தளை"]}]},{"n":364,"ch":37,"l1":"தூஉய்மை என்பது அவாவின்மை மற்றது","l2":"வாஅய்மை வேண்ட வரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தூயநிலை என்றுக் கூறப்படுவது அவா இல்லா திருத்தலே யாகும், அவா அற்ற அத்தன்மை மெய்ப்பொருளை விரும்புவதால் உண்டாகும்.","en":"Purity (of mind) consists in freedom from desire; and that (freedom from desire) is the fruit of the love of truth","lines":[{"t":"தூஉய்மை என்பது அவாவின்மை மற்றது","err":null,"seers":[{"w":"தூஉய்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தூ"},{"k":"N","s":"உய்"},{"k":"N","s":"மை"}]},{"w":"என்பது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பது"}]},{"w":"அவாவின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவா"},{"k":"N","s":"வின்"},{"k":"N","s":"மை"}]},{"w":"மற்றது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மற்"},{"k":"I","s":"றது"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","வெண்சீர் வெண்டளை"]},{"t":"வாஅய்மை வேண்ட வரும்.","err":null,"seers":[{"w":"வாஅய்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"N","s":"அய்"},{"k":"N","s":"மை"}]},{"w":"வேண்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"ட"}]},{"w":"வரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":365,"ch":37,"l1":"அற்றவர் என்பார் அவாஅற்றார் மற்றையார்","l2":"அற்றாக அற்றது இலர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பற்றற்றவர் என்றுக் கூறப்படுவோர் அவா அற்றவரே, அவா அறாத மற்றவர் அவ்வளவாகப் பற்று அற்றவர் அல்லர்.","en":"They are said to be free (from future birth) who are freed from desire; all others (who, whatever else they may be free from, are not freed from desire) are not thus free","lines":[{"t":"அற்றவர் என்பார் அவாஅற்றார் மற்றையார்","err":null,"seers":[{"w":"அற்றவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அற்"},{"k":"I","s":"றவர்"}]},{"w":"என்பார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"பார்"}]},{"w":"அவாஅற்றார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவா"},{"k":"N","s":"அற்"},{"k":"N","s":"றார்"}]},{"w":"மற்றையார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றை"},{"k":"N","s":"யார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அற்றாக அற்றது இலர்.","err":null,"seers":[{"w":"அற்றாக","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அற்"},{"k":"N","s":"றா"},{"k":"N","s":"க"}]},{"w":"அற்றது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அற்"},{"k":"I","s":"றது"}]},{"w":"இலர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"இலர்"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":366,"ch":37,"l1":"அஞ்சுவ தோரும் அறனே ஒருவனை","l2":"வஞ்சிப்ப தோரும் அவா.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் அவாவிற்கு அஞ்சி வாழ்வதே அறம், ஏன் எனில் ஒருவனைச் சோர்வு கண்டுகொடுத்து வஞ்சிப்பது அவாவே.","en":"It is the chief duty of (an ascetic) to watch against desire with (jealous) fear; for it has power to deceive (and destroy) him","lines":[{"t":"அஞ்சுவ தோரும் அறனே ஒருவனை","err":null,"seers":[{"w":"அஞ்சுவ","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஞ்"},{"k":"I","s":"சுவ"}]},{"w":"தோரும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோ"},{"k":"N","s":"ரும்"}]},{"w":"அறனே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அற"},{"k":"N","s":"னே"}]},{"w":"ஒருவனை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"ஒரு"},{"k":"I","s":"வனை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வஞ்சிப்ப தோரும் அவா.","err":null,"seers":[{"w":"வஞ்சிப்ப","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வஞ்"},{"k":"N","s":"சிப்"},{"k":"N","s":"ப"}]},{"w":"தோரும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோ"},{"k":"N","s":"ரும்"}]},{"w":"அவா.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அவா"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":367,"ch":37,"l1":"அவாவினை ஆற்ற அறுப்பின் தவாவினை","l2":"தான்வேண்டு மாற்றான் வரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் ஆசையை முழுதும் ஒழித்தால், அவன் கெடாமல் வாழ்வதற்கு உரிய நல்ல செயல் அவன் விரும்புமாறு வாய்க்கும்.","en":"If a man thoroughly cut off all desire, the deeds, which confer immortality, will come to him, in the path in which he seeks them","lines":[{"t":"அவாவினை ஆற்ற அறுப்பின் தவாவினை","err":null,"seers":[{"w":"அவாவினை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அவா"},{"k":"I","s":"வினை"}]},{"w":"ஆற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"ற"}]},{"w":"அறுப்பின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறுப்"},{"k":"N","s":"பின்"}]},{"w":"தவாவினை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தவா"},{"k":"I","s":"வினை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தான்வேண்டு மாற்றான் வரும்.","err":null,"seers":[{"w":"தான்வேண்டு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தான்"},{"k":"N","s":"வேண்"},{"k":"N","s":"டு"}]},{"w":"மாற்றான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாற்"},{"k":"N","s":"றான்"}]},{"w":"வரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":368,"ch":37,"l1":"அவாஇல்லார்க் கில்லாகுந் துன்பம் அஃதுண்டேல்","l2":"தவாஅது மேன்மேல் வரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["கலித்தளை"],"mv":"அவா இல்லாதவர்க்குத் துன்பம் இல்லையாகும், அவா இருந்தால் எல்லாத் துன்பங்களும் மேலும் மேலும் ஒழியாமல் வரும்.","en":"There is no sorrow to those who are without desire; but where that is, (sorrow) will incessantly come, more and more","lines":[{"t":"அவாஇல்லார்க் கில்லாகுந் துன்பம் அஃதுண்டேல்","err":null,"seers":[{"w":"அவாஇல்லார்க்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவா"},{"k":"N","s":"இல்"},{"k":"N","s":"லார்க்"}]},{"w":"கில்லாகுந்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கில்"},{"k":"N","s":"லா"},{"k":"N","s":"குந்"}]},{"w":"துன்பம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"துன்"},{"k":"N","s":"பம்"}]},{"w":"அஃதுண்டேல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"துண்"},{"k":"N","s":"டேல்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","நேரொன்றிய ஆசிரியத்தளை"]},{"t":"தவாஅது மேன்மேல் வரும்.","err":null,"seers":[{"w":"தவாஅது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தவா"},{"k":"I","s":"அது"}]},{"w":"மேன்மேல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மேன்"},{"k":"N","s":"மேல்"}]},{"w":"வரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":369,"ch":37,"l1":"இன்பம் இடையறா தீண்டும் அவாவென்னும்","l2":"துன்பத்துள் துன்பங் கெடின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அவா என்று சொல்லப்படுகின்ற துன்பங்களுள் பொல்லாதத் துன்பம் கெடுமானால் இவ் வுலகில் இன்பம் இடையறாமல் வாய்க்கும்.","en":"Even while in this body, joy will never depart (from the mind, in which) desire, that sorrow of sorrows, has been destroyed","lines":[{"t":"இன்பம் இடையறா தீண்டும் அவாவென்னும்","err":null,"seers":[{"w":"இன்பம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"பம்"}]},{"w":"இடையறா","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இடை"},{"k":"I","s":"யறா"}]},{"w":"தீண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீண்"},{"k":"N","s":"டும்"}]},{"w":"அவாவென்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவா"},{"k":"N","s":"வென்"},{"k":"N","s":"னும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"துன்பத்துள் துன்பங் கெடின்.","err":null,"seers":[{"w":"துன்பத்துள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"துன்"},{"k":"N","s":"பத்"},{"k":"N","s":"துள்"}]},{"w":"துன்பங்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"துன்"},{"k":"N","s":"பங்"}]},{"w":"கெடின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":370,"ch":37,"l1":"ஆரா இயற்கை அவாநீப்பின் அந்நிலையே","l2":"பேரா இயற்கை தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருபோதும் நிரம்பாத தன்மை உடைய அவாவை ஒழித்தால் ஒழித்த அந்நிலையே எப்போதும் மாறாதிருக்கும் இன்ப வாழ்வைத் தரும்.","en":"The removal of desire, whose nature it is never to be satisfied, will immediately confer a nature that can never be changed","lines":[{"t":"ஆரா இயற்கை அவாநீப்பின் அந்நிலையே","err":null,"seers":[{"w":"ஆரா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"ரா"}]},{"w":"இயற்கை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இயற்"},{"k":"N","s":"கை"}]},{"w":"அவாநீப்பின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவா"},{"k":"N","s":"நீப்"},{"k":"N","s":"பின்"}]},{"w":"அந்நிலையே","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"அந்"},{"k":"I","s":"நிலை"},{"k":"N","s":"யே"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பேரா இயற்கை தரும்.","err":null,"seers":[{"w":"பேரா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பே"},{"k":"N","s":"ரா"}]},{"w":"இயற்கை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இயற்"},{"k":"N","s":"கை"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]