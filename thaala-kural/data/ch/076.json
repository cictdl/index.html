[{"n":751,"ch":76,"l1":"பொருளல் லவரைப் பொருளாகச் செய்யும்","l2":"பொருளல்லது இல்லை பொருள்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒரு பொருளாக மதிக்கத் தகாதவரையும், மதிப்புடையவராகச் செய்வதாகிய பொருள் அல்லாமல் சிறப்புடைய பொருள் வேறு இல்லை.","en":"Besides wealth there is nothing that can change people of no importance into those of (some) importance","lines":[{"t":"பொருளல் லவரைப் பொருளாகச் செய்யும்","err":null,"seers":[{"w":"பொருளல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளல்"}]},{"w":"லவரைப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"லவ"},{"k":"N","s":"ரைப்"}]},{"w":"பொருளாகச்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளா"},{"k":"N","s":"கச்"}]},{"w":"செய்யும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பொருளல்லது இல்லை பொருள்.","err":null,"seers":[{"w":"பொருளல்லது","name":"புளிமாங்கனி","cls":"கனி","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளல்"},{"k":"I","s":"லது"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"பொருள்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பொருள்"}]}],"thalai":["ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":752,"ch":76,"l1":"இல்லாரை எல்லாரும் எள்ளுவர் செல்வரை","l2":"எல்லாரும் செய்வர் சிறப்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொருள் இல்லாதவரை (வேறு நன்மை உடையவராக இருந்தாலும்) எல்லாரும் இகழ்வார், செல்வரை (வேறு நன்மை இல்லாவிட்டாலும்) எல்லாரும் சிறப்பு செய்வர்.","en":"All despise the poor; (but) all praise the rich","lines":[{"t":"இல்லாரை எல்லாரும் எள்ளுவர் செல்வரை","err":null,"seers":[{"w":"இல்லாரை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"ரை"}]},{"w":"எல்லாரும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லா"},{"k":"N","s":"ரும்"}]},{"w":"எள்ளுவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எள்"},{"k":"I","s":"ளுவர்"}]},{"w":"செல்வரை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செல்"},{"k":"I","s":"வரை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எல்லாரும் செய்வர் சிறப்பு.","err":null,"seers":[{"w":"எல்லாரும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லா"},{"k":"N","s":"ரும்"}]},{"w":"செய்வர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"வர்"}]},{"w":"சிறப்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சிறப்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":753,"ch":76,"l1":"பொருளென்னும் பொய்யா விளக்கம் இருளறுக்கும்","l2":"எண்ணிய தேயத்துச் சென்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பொருள் என்று சொல்லப்படுகின்ற நந்தா விளக்கு, நினைத்த இடத்திற்குச் சென்று உள்ள இடையூற்றைக் கெடுக்கும்","en":"The imperishable light of wealth goes into regions desired (by its owner) and destroys the darkness (of enmity therein)","lines":[{"t":"பொருளென்னும் பொய்யா விளக்கம் இருளறுக்கும்","err":null,"seers":[{"w":"பொருளென்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளென்"},{"k":"N","s":"னும்"}]},{"w":"பொய்யா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பொய்"},{"k":"N","s":"யா"}]},{"w":"விளக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விளக்"},{"k":"N","s":"கம்"}]},{"w":"இருளறுக்கும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இரு"},{"k":"I","s":"ளறுக்"},{"k":"N","s":"கும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எண்ணிய தேயத்துச் சென்று.","err":null,"seers":[{"w":"எண்ணிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எண்"},{"k":"I","s":"ணிய"}]},{"w":"தேயத்துச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தே"},{"k":"N","s":"யத்"},{"k":"N","s":"துச்"}]},{"w":"சென்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சென்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":754,"ch":76,"l1":"அறன்ஈனும் இன்பமும் ஈனும் திறனறிந்து","l2":"தீதின்றி வந்த பொருள்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"சேர்க்கும் திறம் அறிந்து தீமை ஒன்றும் இல்லாமல், சேர்க்கப் பட்டுவந்த பொருள் ஒருவனுக்கு அறத்தையும் கொடுக்கும் இன்பத்தையும் கொடுக்கும்.","en":"The wealth acquired with a knowledge of the proper means and without foul practices will yield virtue and happiness","lines":[{"t":"அறன்ஈனும் இன்பமும் ஈனும் திறனறிந்து","err":null,"seers":[{"w":"அறன்ஈனும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறன்"},{"k":"N","s":"ஈ"},{"k":"N","s":"னும்"}]},{"w":"இன்பமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இன்"},{"k":"I","s":"பமும்"}]},{"w":"ஈனும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"னும்"}]},{"w":"திறனறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"திற"},{"k":"I","s":"னறிந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தீதின்றி வந்த பொருள்.","err":null,"seers":[{"w":"தீதின்றி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தீ"},{"k":"N","s":"தின்"},{"k":"N","s":"றி"}]},{"w":"வந்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வந்"},{"k":"N","s":"த"}]},{"w":"பொருள்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பொருள்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":755,"ch":76,"l1":"அருளொடும் அன்பொடும் வாராப் பொருளாக்கம்","l2":"புல்லார் புரள விடல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அருளோடும், அன்போடும் பொருந்தாத வழிகளில் வந்த செல்வத்தின் ஆக்கத்தைப் பெற்று மகிழாமல் அதைத் தீமையானது என்று நீக்கிவிட வேண்டும்.","en":"(Kings) should rather avoid than seek the accumulation of wealth which does not flow in with mercy and love","lines":[{"t":"அருளொடும் அன்பொடும் வாராப் பொருளாக்கம்","err":null,"seers":[{"w":"அருளொடும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அரு"},{"k":"I","s":"ளொடும்"}]},{"w":"அன்பொடும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அன்"},{"k":"I","s":"பொடும்"}]},{"w":"வாராப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ராப்"}]},{"w":"பொருளாக்கம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளாக்"},{"k":"N","s":"கம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"புல்லார் புரள விடல்.","err":null,"seers":[{"w":"புல்லார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"புல்"},{"k":"N","s":"லார்"}]},{"w":"புரள","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புர"},{"k":"N","s":"ள"}]},{"w":"விடல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":756,"ch":76,"l1":"உறுபொருளும் உல்கு பொருளும்தன் ஒன்னார்த்","l2":"தெறுபொருளும் வேந்தன் பொருள்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இறையாக வந்து சேரும் பொருளும், சுங்கமாகக் கொள்ளும் பொருளும், தன் பகைவரை வென்று திறமையாகக் கொள்ளும் பொருளும் அரசனுடைய பொருள்களாகும்.","en":"The spoils of slaughtered foes; these are the royal revenues","lines":[{"t":"உறுபொருளும் உல்கு பொருளும்தன் ஒன்னார்த்","err":null,"seers":[{"w":"உறுபொருளும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உறு"},{"k":"I","s":"பொரு"},{"k":"N","s":"ளும்"}]},{"w":"உல்கு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உல்"},{"k":"N","s":"கு"}]},{"w":"பொருளும்தன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளும்"},{"k":"N","s":"தன்"}]},{"w":"ஒன்னார்த்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒன்"},{"k":"N","s":"னார்த்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தெறுபொருளும் வேந்தன் பொருள்.","err":null,"seers":[{"w":"தெறுபொருளும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தெறு"},{"k":"I","s":"பொரு"},{"k":"N","s":"ளும்"}]},{"w":"வேந்தன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"தன்"}]},{"w":"பொருள்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பொருள்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"