{"k":"N","s":"காண்"}]},{"w":"காமம்தாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"மம்"},{"k":"N","s":"தாம்"}]},{"w":"வீழ்வார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வீழ்"},{"k":"N","s":"வார்"}]}],"thalai":["கலித்தளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நினைப்ப வருவதொன்று ஏல்.","err":null,"seers":[{"w":"நினைப்ப","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நினைப்"},{"k":"N","s":"ப"}]},{"w":"வருவதொன்று","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வரு"},{"k":"I","s":"வதொன்"},{"k":"N","s":"று"}]},{"w":"ஏல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"ஏல்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1203,"ch":121,"l1":"நினைப்பவர் போன்று நினையார்கொல் தும்மல்","l2":"சினைப்பது போன்று கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தும்மல் வருவது போலிருந்து வாராமல் அடங்குகின்றதே! என் காதலர் என்னை நினைப்பவர் போலிருந்து நினையாமல் விடுகின்றாரோ?","en":"I feel as if I am going to sneeze but do not, and (therefore) my beloved is about to think (of me) but does not","lines":[{"t":"நினைப்பவர் போன்று நினையார்கொல் தும்மல்","err":null,"seers":[{"w":"நினைப்பவர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நினைப்"},{"k":"I","s":"பவர்"}]},{"w":"போன்று","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போன்"},{"k":"N","s":"று"}]},{"w":"நினையார்கொல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நினை"},{"k":"N","s":"யார்"},{"k":"N","s":"கொல்"}]},{"w":"தும்மல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தும்"},{"k":"N","s":"மல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"சினைப்பது போன்று கெடும்.","err":null,"seers":[{"w":"சினைப்பது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"சினைப்"},{"k":"I","s":"பது"}]},{"w":"போன்று","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போன்"},{"k":"N","s":"று"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1204,"ch":121,"l1":"யாமும் உளேங்கொல் அவர்நெஞ்சத்து எந்நெஞ்சத்து","l2":"ஓஒ உளரே அவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":[null],"mv":"எம்முடைய நெஞ்சில் காதலராகிய அவர் இருக்கின்றாரே! ( அது போலவே) யாமும் அவருடைய நெஞ்சத்தில் நீங்காமல் இருக்கின்றோ‌மோ?","en":"He continues to abide in my soul, do I likewise abide in his ?","lines":[{"t":"யாமும் உளேங்கொல் அவர்நெஞ்சத்து எந்நெஞ்சத்து","err":null,"seers":[{"w":"யாமும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"மும்"}]},{"w":"உளேங்கொல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உளேங்"},{"k":"N","s":"கொல்"}]},{"w":"அவர்நெஞ்சத்து","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"அவர்"},{"k":"N","s":"நெஞ்"},{"k":"N","s":"சத்"},{"k":"N","s":"து"}]},{"w":"எந்நெஞ்சத்து","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"எந்"},{"k":"N","s":"நெஞ்"},{"k":"N","s":"சத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை",null]},{"t":"ஓஒ உளரே அவர்.","err":null,"seers":[{"w":"ஓஒ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓ"},{"k":"N","s":"ஒ"}]},{"w":"உளரே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உள"},{"k":"N","s":"ரே"}]},{"w":"அவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அவர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1205,"ch":121,"l1":"தம்நெஞ்சத்து எம்மைக் கடிகொண்டார் நாணார்கொல்","l2":"எம்நெஞ்சத்து ஓவா வரல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தம்முடைய நெஞ்சில் எம்மை வரவிடாது காவல் கொண்ட காதலர், எம்முடைய நெஞ்சில் தாம் ஓயாமல் வரவதைப் பற்றி நாணமாட்டாரோ?","en":"He who has imprisoned me in his soul, is he ashamed to enter incessantly into mine","lines":[{"t":"தம்நெஞ்சத்து எம்மைக் கடிகொண்டார் நாணார்கொல்","err":null,"seers":[{"w":"தம்நெஞ்சத்து","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"தம்"},{"k":"N","s":"நெஞ்"},{"k":"N","s":"சத்"},{"k":"N","s":"து"}]},{"w":"எம்மைக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எம்"},{"k":"N","s":"மைக்"}]},{"w":"கடிகொண்டார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கடி"},{"k":"N","s":"கொண்"},{"k":"N","s":"டார்"}]},{"w":"நாணார்கொல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணார்"},{"k":"N","s":"கொல்"}]}],"thalai":[null,"இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"எம்நெஞ்சத்து ஓவா வரல்.","err":null,"seers":[{"w":"எம்நெஞ்சத்து","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"எம்"},{"k":"N","s":"நெஞ்"},{"k":"N","s":"சத்"},{"k":"N","s":"து"}]},{"w":"ஓவா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓ"},{"k":"N","s":"வா"}]},{"w":"வரல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரல்"}]}],"thalai":[null,"இயற்சீர் வெண்டளை"]}]},{"n":1206,"ch":121,"l1":"மற்றியான் என்னுளேன் மன்னோ அவரொடியான்","l2":"உற்றநாள் உள்ள உளேன்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"காதலராகிய அவரோடு யான் பொருந்தியிருந்த நாட்களை நினைத்துக் கொள்வதால்தான் உயிரோடு இருக்கின்றேன்; வேறு எதனால் உயிர் வாழ்கின்றேன்?","en":"I live by remembering my (former) intercourse with him; if it were not so, how could I live ?","lines":[{"t":"மற்றியான் என்னுளேன் மன்னோ அவரொடியான்","err":null,"seers":[{"w":"மற்றியான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மற்"},{"k":"I","s":"றியான்"}]},{"w":"என்னுளேன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"னுளேன்"}]},{"w":"மன்னோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மன்"},{"k":"N","s":"னோ"}]},{"w":"அவரொடியான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அவ"},{"k":"I","s":"ரொடி"},{"k":"N","s":"யான்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உற்றநாள் உள்ள உளேன்.","err":null,"seers":[{"w":"உற்றநாள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உற்"},{"k":"I","s":"றநாள்"}]},{"w":"உள்ள","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ள"}]},{"w":"உளேன்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"உளேன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1207,"ch":121,"l1":"மறப்பின் எவனாவன் மற்கொல் மறப்பறியேன்","l2":"உள்ளினும் உள்ளம் சுடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"( காதலரை ) மறந்தறியாமல் நினைத்தாலும் உள்ளத்தைப் பிரிவுத் துன்பம் சுடுகின்றதே! நினைக்காமல் மறந்து விட்டால் என்ன ஆவேனோ?","en":"I have never forgotten (the pleasure); even to think of it burns my soul; could I live, if I should ever forget it ?","lines":[{"t":"மறப்பின் எவனாவன் மற்கொல் மறப்பறியேன்","err":null,"seers":[{"w":"மறப்பின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மறப்"},{"k":"N","s":"பின்"}]},{"w":"எவனாவன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எவ"},{"k":"N","s":"னா"},{"k":"N","s":"வன்"}]},{"w":"மற்கொல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மற்"},{"k":"N","s":"கொல்"}]},{"w":"மறப்பறியேன்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"மறப்"},{"k":"I","s":"பறி"},{"k":"N","s":"யேன்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உள்ளினும் உள்ளம் சுடும்.","err":null,"seers":[{"w":"உள்ளினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளினும்"}]},{"w":"உள்ளம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளம்"}]},{"w":"சுடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"சுடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1208,"ch":121,"l1":"எனைத்து நினைப்பினும் காயார் அனைத்தன்றோ","l2":"காதலர் செய்யும் சிறப்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"காதலரை எவ்வளவு மிகுதியாக நினைத்தாலும் அவர் என்மேல் சினங்கொள்ளார்; காதலர் செய்யும் சிறந்த உதவி அத்தன்மையானது அன்றோ!","en":"He will not be angry however much I may think of him; is it not so much the delight my beloved","lines":[{"t":"எனைத்து நினைப்பினும் காயார் அனைத்தன்றோ","err":null,"seers":[{"w":"எனைத்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"எனைத்"},{"k":"N","s":"து"}]},{"w":"நினைப்பினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நினைப்"},{"k":"I","s":"பினும்"}]},{"w":"காயார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"யார்"}]},{"w":"அனைத்தன்றோ","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அனைத்"},{"k":"N","s":"தன்"},{"k":"N","s":"றோ"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"காதலர் செய்யும் சிறப்பு.","err":null,"seers":[{"w":"காதலர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கா"},{"k":"I","s":"தலர்"}]},{"w":"செய்யும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யும்"}]},{"w":"சிறப்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சிறப்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1209,"ch":121,"l1":"விளியுமென் இன்னுயிர் வேறல்லம் என்பார்","l2":"அளியின்மை ஆற்ற நினைந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நாம் இருவரும் வேறு அல்லேம் என்று அடிக்கடி சொல்லும் அவர் இப்போது அன்பு இல்லாதிருத்தலை மிக நினைத்து என் இனிய உயிர் அழிகின்றது.","en":"My precious life is wasting away by thinking too much on the cruelty of him who said we were not different","lines":[{"t":"விளியுமென் இன்னுயிர் வேறல்லம் என்பார்","err":null,"seers":[{"w":"விளியுமென்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விளி"},{"k":"I","s":"யுமென்"}]},{"w":"இன்னுயிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இன்"},{"k":"I","s":"னுயிர்"}]},{"w":"வேறல்லம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"றல்"},{"k":"N","s":"லம்"}]},{"w":"என்பார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"பார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அளியின்மை ஆற்ற நினைந்து.","err":null,"seers":[{"w":"அளியின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அளி"},{"k":"N","s":"யின்"},{"k":"N","s":"மை"}]},{"w":"ஆற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"ற"}]},{"w":"நினைந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நினைந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1210,"ch":121,"l1":"விடாஅது சென்றாரைக் கண்ணினால் காணப்","l2":"படாஅதி வாழி மதி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தி்ங்களே! பிரியாமல் இருந்து இறுதியில் பிரிந்து சென்ற காதலரை என் கண்ணால் தேடிக் காணும்படியாக நீ மறைந்து விடாமல் இருப்பாயாக!","en":"May you live, O Moon! Do not set, that I mine see him who has departed without quitting my soul","lines":[{"t":"விடாஅது சென்றாரைக் கண்ணினால் காணப்","err":null,"seers":[{"w":"விடாஅது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விடா"},{"k":"I","s":"அது"}]},{"w":"சென்றாரைக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சென்"},{"k":"N","s":"றா"},{"k":"N","s":"ரைக்"}]},{"w":"கண்ணினால்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கண்"},{"k":"I","s":"ணினால்"}]},{"w":"காணப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணப்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"படாஅதி வாழி மதி.","err":null,"seers":[{"w":"படாஅதி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"படா"},{"k":"I","s":"அதி"}]},{"w":"வாழி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ழி"}]},{"w":"மதி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"மதி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]