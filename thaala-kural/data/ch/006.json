[{"n":51,"ch":6,"l1":"மனைக்தக்க மாண்புடையள் ஆகித்தற் கொண்டான்","l2":"வளத்தக்காள் வாழ்க்கைத் துணை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இல்வாழ்க்கைக்கு ஏற்ற நற்பண்பு உடையவளாகித் தன்கணவனுடைய பொருள் வளத்துக்குத் தக்க வாழ்க்கை நடத்துகிறவளே வாழ்க்கைத்துணை ஆவாள்.","en":"She who has the excellence of home virtues, and can expend within the means of her husband, is a help in the domestic state","lines":[{"t":"மனைக்தக்க மாண்புடையள் ஆகித்தற் கொண்டான்","err":null,"seers":[{"w":"மனைக்தக்க","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மனைக்"},{"k":"N","s":"தக்"},{"k":"N","s":"க"}]},{"w":"மாண்புடையள்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மாண்"},{"k":"I","s":"புடை"},{"k":"N","s":"யள்"}]},{"w":"ஆகித்தற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கித்"},{"k":"N","s":"தற்"}]},{"w":"கொண்டான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொண்"},{"k":"N","s":"டான்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வளத்தக்காள் வாழ்க்கைத் துணை.","err":null,"seers":[{"w":"வளத்தக்காள்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வளத்"},{"k":"N","s":"தக்"},{"k":"N","s":"காள்"}]},{"w":"வாழ்க்கைத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்க்"},{"k":"N","s":"கைத்"}]},{"w":"துணை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"துணை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":52,"ch":6,"l1":"மனைமாட்சி இல்லாள்கண் இல்லாயின் வாழ்க்கை","l2":"எனைமாட்சித் தாயினும் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இல்வாழ்க்கைக்கு தக்க நற்பண்பு மனைவியிடம் இல்லையானால், ஒருவனுடைய வாழ்க்கை வேறு எவ்வளவு சிறப்புடையதானாலும் பயன் இல்லை.","en":"If the wife be devoid of domestic excellence, whatever (other) greatness be possessed, the conjugal state, is nothing","lines":[{"t":"மனைமாட்சி இல்லாள்கண் இல்லாயின் வாழ்க்கை","err":null,"seers":[{"w":"மனைமாட்சி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மனை"},{"k":"N","s":"மாட்"},{"k":"N","s":"சி"}]},{"w":"இல்லாள்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லாள்"},{"k":"N","s":"கண்"}]},{"w":"இல்லாயின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"யின்"}]},{"w":"வாழ்க்கை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்க்"},{"k":"N","s":"கை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"எனைமாட்சித் தாயினும் இல்.","err":null,"seers":[{"w":"எனைமாட்சித்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எனை"},{"k":"N","s":"மாட்"},{"k":"N","s":"சித்"}]},{"w":"தாயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தா"},{"k":"I","s":"யினும்"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":53,"ch":6,"l1":"இல்லதென் இல்லவள் மாண்பானால் உள்ளதென்","l2":"இல்லவள் மாணாக் கடை?","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மனைவி நற்பண்பு உடையவளானால் வாழ்க்கையில் இல்லாதது என்ன? அவள் நற்பண்பு இல்லாதவளானால் வாழ்க்கையில் இருப்பது என்ன?","en":"If his wife be eminent (in virtue), what does (that man) not possess ? If she be without excellence, what does (he) possess ?","lines":[{"t":"இல்லதென் இல்லவள் மாண்பானால் உள்ளதென்","err":null,"seers":[{"w":"இல்லதென்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இல்"},{"k":"I","s":"லதென்"}]},{"w":"இல்லவள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இல்"},{"k":"I","s":"லவள்"}]},{"w":"மாண்பானால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மாண்"},{"k":"N","s":"பா"},{"k":"N","s":"னால்"}]},{"w":"உள்ளதென்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளதென்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இல்லவள் மாணாக் கடை?","err":null,"seers":[{"w":"இல்லவள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இல்"},{"k":"I","s":"லவள்"}]},{"w":"மாணாக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மா"},{"k":"N","s":"ணாக்"}]},{"w":"கடை?","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கடை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":54,"ch":6,"l1":"பெண்ணின் பெருந்தக்க யாவுள கற்பென்னும்","l2":"திண்மைஉண் டாகப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இல்வாழ்க்கையில் கற்பு என்னும் உறுதிநிலை இருக்கப் பெற்றால், பெண்ணைவிட பெருமையுடையவை வேறு என்ன இருக்கின்றன?","en":"What is more excellent than a wife, if she possess the stability of chastity ?","lines":[{"t":"பெண்ணின் பெருந்தக்க யாவுள கற்பென்னும்","err":null,"seers":[{"w":"பெண்ணின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பெண்"},{"k":"N","s":"ணின்"}]},{"w":"பெருந்தக்க","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெருந்"},{"k":"N","s":"தக்"},{"k":"N","s":"க"}]},{"w":"யாவுள","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"வுள"}]},{"w":"கற்பென்னும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"N","s":"பென்"},{"k":"N","s":"னும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"திண்மைஉண் டாகப் பெறின்.","err":null,"seers":[{"w":"திண்மைஉண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"திண்"},{"k":"N","s":"மை"},{"k":"N","s":"உண்"}]},{"w":"டாகப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டா"},{"k":"N","s":"கப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":55,"ch":6,"l1":"தெய்வம் தொழாஅள் கொழுநன் தொழுதெழுவாள்","l2":"பெய்யெனப் பெய்யும் மழை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வேறு தெய்வம் தொழாதவளாய்த் தன் கணவனையே தெய்வமாகக் கொண்டு தொழுது துயிலெழுகின்றவள் பெய் என்றால் மழை பெய்யும்.","en":"If she, who does not worship God, but who rising worships her husband, say, \"let it rain,\" it will rain","lines":[{"t":"தெய்வம் தொழாஅள் கொழுநன் தொழுதெழுவாள்","err":null,"seers":[{"w":"தெய்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தெய்"},{"k":"N","s":"வம்"}]},{"w":"தொழாஅள்","name":"புளிமா",