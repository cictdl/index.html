[{"n":321,"ch":33,"l1":"அறவினை யாதெனின் கொல்லாமை கோறல்","l2":"பிறவினை எல்லாந் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறமாகிய செயல் எது என்றால் ஒரு உயிரையும் கொல்லாமையாகும், கொல்லுதல் அறமல்லாத செயல்கள் எல்லாவற்றையும் விளைக்கும்.","en":"Never to destroy life is the sum of all virtuous conduct The destruction of life leads to every evil","lines":[{"t":"அறவினை யாதெனின் கொல்லாமை கோறல்","err":null,"seers":[{"w":"அறவினை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அற"},{"k":"I","s":"வினை"}]},{"w":"யாதெனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தெனின்"}]},{"w":"கொல்லாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லா"},{"k":"N","s":"மை"}]},{"w":"கோறல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கோ"},{"k":"N","s":"றல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பிறவினை எல்லாந் தரும்.","err":null,"seers":[{"w":"பிறவினை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பிற"},{"k":"I","s":"வினை"}]},{"w":"எல்லாந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாந்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":322,"ch":33,"l1":"பகுத்துண்டு பல்லுயிர் ஓம்புதல் நூலோர்","l2":"தொகுத்தவற்றுள் எல்லாந் தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கிடைத்ததைப் பகுந்து கொடுத்துத் தானும் உண்டு பல உயிர்களையும் காப்பாற்றுதல் அறநூலார் தொகுத்த அறங்கள் எல்லாவற்றிலும் தலையான அறமாகும்.","en":"The chief of all (the virtues) which authors have summed up, is the partaking of food that has been shared with others, and the preservation of the mainfold life of other creatures","lines":[{"t":"பகுத்துண்டு பல்லுயிர் ஓம்புதல் நூலோர்","err":null,"seers":[{"w":"பகுத்துண்டு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பகுத்"},{"k":"N","s":"துண்"},{"k":"N","s":"டு"}]},{"w":"பல்லுயிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பல்"},{"k":"I","s":"லுயிர்"}]},{"w":"ஓம்புதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஓம்"},{"k":"I","s":"புதல்"}]},{"w":"நூலோர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நூ"},{"k":"N","s":"லோர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தொகுத்தவற்றுள் எல்லாந் தலை.","err":null,"seers":[{"w":"தொகுத்தவற்றுள்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தொகுத்"},{"k":"I","s":"தவற்"},{"k":"N","s":"றுள்"}]},{"w":"எல்லாந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாந்"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":323,"ch":33,"l1":"ஒன்றாக நல்லது கொல்லாமை மற்றதன்","l2":"பின்சாரப் பொய்யாமை நன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"இணையில்லாத ஓர் அறமாகக் கொல்லாமை நல்லது, அதற்கு அடுத்த நிலையில் கூறத்தக்கதாகப் பொய்யாமை நல்லது.","en":"Not to destroy life is an incomparably (great) good next to it in goodness ranks freedom from falsehood","lines":[{"t":"ஒன்றாக நல்லது கொல்லாமை மற்றதன்","err":null,"seers":[{"w":"ஒன்றாக","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒன்"},{"k":"N","s":"றா"},{"k":"N","s":"க"}]},{"w":"நல்லது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"லது"}]},{"w":"கொல்லாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லா"},{"k":"N","s":"மை"}]},{"w":"மற்றதன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மற்"},{"k":"I","s":"றதன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பின்சாரப் பொய்யாமை நன்று.","err":null,"seers":[{"w":"பின்சாரப்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பின்"},{"k":"N","s":"சா"},{"k":"N","s":"ரப்"}]},{"w":"பொய்யாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொய்"},{"k":"N","s":"யா"},{"k":"N","s":"மை"}]},{"w":"நன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":324,"ch":33,"l1":"நல்லாறு எனப்படுவது யாதெனின் யாதொன்றும்","l2":"கொல்லாமை சூழும் நெறி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நல்ல வழி என்று அறநூல்களால் சொல்லப்படுவது எது என்றால், எந்த உயிரையும் கொல்லாத அறத்தைப் போற்றும் நெறியாகும்.","en":"Good path is that which considers how it may avoid killing any creature","lines":[{"t":"நல்லாறு எனப்படுவது யாதெனின் யாதொன்றும்","err":null,"seers":[{"w":"நல்லாறு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"N","s":"லா"},{"k":"N","s":"று"}]},{"w":"எனப்படுவது","name":"கருவிளங்கனி","cls":"கனி","a":[{"k":"I","s":"எனப்"},{"k":"I","s":"படு"},{"k":"I","s":"வது"}]},{"w":"யாதெனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தெனின்"}]},{"w":"யாதொன்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"N","s":"தொன்"},{"k":"N","s":"றும்"}]}],"thalai":["கலித்தளை","ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]},{"t":"கொல்லாமை சூழும் நெறி.","err":null,"seers":[{"w":"கொல்லாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லா"},{"k":"N","s":"மை"}]},{"w":"சூழும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சூ"},{"k":"N","s":"ழும்"}]},{"w":"நெறி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"நெறி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":325,"ch":33,"l1":"நிலைஅஞ்சி நீத்தாருள் எல்லாம் கொலைஅஞ்சிக்","l2":"கொல்லாமை சூழ்வான் தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வாழ்க்கையின் தன்மையைக்கண்டு அஞ்சித் துறந்தவர்கள் எல்லாரிலும், கொலைசெய்வதற்க்கு அஞ்சிக் கொல்லாத அறத்தைப் போற்றுகின்றவன் உயர்ந்தவன்.","en":"Of all those who, fearing the permanence of earthly births, have abandoned desire, he is the chief who, fearing (the guilt of) murder, considers how he may avoid the destruction of life","lines":[{"t":"நிலைஅஞ்சி நீத்தாருள் எல்லாம் கொலைஅஞ்சிக்","err":null,"seers":[{"w":"நிலைஅஞ்சி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நிலை"},{"k":"N","s":"அஞ்"},{"k":"N","s":"சி"}]},{"w":"நீத்தாருள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நீத்"},{"k":"N","s":"தா"},{"k":"N","s":"ருள்"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"கொலைஅஞ்சிக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கொலை"},{"k":"N","s":"அஞ்"},{"k":"N","s":"சிக்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கொல்லாமை சூழ்வான் தலை.","err":null,"seers":[{"w":"கொல்லாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லா"},{"k":"N","s":"மை"}]},{"w":"சூழ்வான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சூழ்"},{"k":"N","s":"வான்"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":326,"ch":33,"l1":"கொல்லாமை மேற்கொண் டொழுகுவான் வாழ்நாள்மேல்","l2":"செல்லாது உயிருண்ணுங் கூற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"கொல்லாத அறத்தை மேற்கொண்டு நடக்கின்றவனுடைய வாழ்நாளின் மேல், உயிரைக்கொண்டு செல்லும் கூற்றுவனும் செல்லமாட்டான்.","en":"Yama, the destroyer of life, will not attack the life of him, who acts under the determination of never destroying life","lines":[{"t":"கொல்லாமை மேற்கொண் டொழுகுவான் வாழ்நாள்மேல்","err":null,"seers":[{"w":"கொல்லாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லா"},{"k":"N","s":"மை"}]},{"w":"மேற்கொண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மேற்"},{"k":"N","s":"கொண்"}]},{"w":"டொழுகுவான்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"டொழு"},{"k":"I","s":"குவான்"}]},{"w":"வாழ்நாள்மேல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"நாள்"},{"k":"N","s":"மேல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செல்லாது உயிருண்ணுங் கூற்று.","err":null,"seers":[{"w":"செல்லாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"லா"},{"k":"N","s":"து"}]},{"w":"உயிருண்ணுங்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உயி"},{"k":"N","s":"ருண்"},{"k":"N","s":"ணுங்"}]},{"w":"கூற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கூற்"},{"k":"N","s":"று"}]}],"thalai":["கலித்தளை","வெண்சீர் வெண்டளை"]}]},{"n":327,"ch":33,"l1":"தன்னுயிர் நீப்பினும் செய்யற்க தான்பிறிது","l2":"இன்னுயிர் நீக்கும் வினை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தன் உயிர் உடம்பிலிருந்து நீங்கிச் செல்வதாக இருந்தாலும், அதைத் தடுப்பதற்காகத் தான் வேறோர் உயிரை நீக்கும் செயலைச் செய்யக்கூடாது.","en":"Let no one do that which would destroy the life of another, although he should by so doing, lose his own life","lines":[{"t":"தன்னுயிர் நீப்பினும் செய்யற்க தான்பிறிது","err":null,"seers":[{"w":"தன்னுயிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தன்"},{"k":"I","s":"னுயிர்"}]},{"w":"நீப்பினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீப்"},{"k":"I","s":"பினும்"}]},{"w":"செய்யற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யற்"},{"k":"N","s":"க"}]},{"w":"தான்பிறிது","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தான்"},{"k":"I","s":"பிறி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இன்னுயிர் நீக்கும் வினை.","err":null,"seers":[{"w":"இன்னுயிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இன்"},{"k":"I","s":"னுயிர்"}]},{"w":"நீக்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீக்"},{"k":"N","s":"கும்"}]},{"w":"வினை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வினை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":328,"ch":33,"l1":"நன்றாகும் ஆக்கம் பெரிதெனினும் சான்றோர்க்குக்","l2":"கொன்றாகும் ஆக்கங் கடை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கொலையால் நன்மையாக விளையும் ஆக்கம் பெரிதாக இருந்தாலும், சான்றோர்க்குக் கொலையால் வரும் ஆக்கம் மிக இழிவானதாகும்.","en":"The advantage which might flow from destroying life in sacrifice, is dishonourable to the wise (who renounced