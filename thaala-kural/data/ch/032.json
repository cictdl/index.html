[{"w":"பிற்பகல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பிற்"},{"k":"I","s":"பகல்"}]},{"w":"தாமே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"மே"}]},{"w":"வரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":320,"ch":32,"l1":"நோயெல்லாம் நோய்செய்தார் மேலவாம் நோய்செய்யார்","l2":"நோயின்மை வேண்டு பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"துன்பம் எல்லாம் துன்பம் செய்தவரையேச் சார்வன, ஆகையால் துன்பம் இல்லாமல் வாழ்தலை விரும்புகின்றவர் பிறர்க்கு துன்பம் செய்யார்.","en":"Sorrow will come upon those who cause pain to others; therfore those, who desire to be free from sorrow, give no pain to others","lines":[{"t":"நோயெல்லாம் நோய்செய்தார் மேலவாம் நோய்செய்யார்","err":null,"seers":[{"w":"நோயெல்லாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோ"},{"k":"N","s":"யெல்"},{"k":"N","s":"லாம்"}]},{"w":"நோய்செய்தார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோய்"},{"k":"N","s":"செய்"},{"k":"N","s":"தார்"}]},{"w":"மேலவாம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மே"},{"k":"I","s":"லவாம்"}]},{"w":"நோய்செய்யார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோய்"},{"k":"N","s":"செய்"},{"k":"N","s":"யார்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நோயின்மை வேண்டு பவர்.","err":null,"seers":[{"w":"நோயின்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோ"},{"k":"N","s":"யின்"},{"k":"N","s":"மை"}]},{"w":"வேண்டு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டு"}]},{"w":"பவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]