[{"n":311,"ch":32,"l1":"சிறப்பீனும் செல்வம் பெறினும் பிறர்க்குஇன்னா","l2":"செய்யாமை மாசற்றார் கோள்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"சிறப்பைத்தருகின்ற பெருஞ் செல்வத்தைப் பெறுவதாக இருந்தாலும், பிறர்க்குத் துன்பம் செய்யாதிருத்தலே மாசற்றவரின் கொள்கையாம்.","en":"It is the determination of the spotless not to cause sorrow to others, although they could (by so causing) obtain the wealth which confers greatness","lines":[{"t":"சிறப்பீனும் செல்வம் பெறினும் பிறர்க்குஇன்னா","err":null,"seers":[{"w":"சிறப்பீனும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறப்"},{"k":"N","s":"பீ"},{"k":"N","s":"னும்"}]},{"w":"செல்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"பெறினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெறி"},{"k":"N","s":"னும்"}]},{"w":"பிறர்க்குஇன்னா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறர்க்"},{"k":"I","s":"குஇன்"},{"k":"N","s":"னா"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செய்யாமை மாசற்றார் கோள்.","err":null,"seers":[{"w":"செய்யாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யா"},{"k":"N","s":"மை"}]},{"w":"மாசற்றார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"N","s":"சற்"},{"k":"N","s":"றார்"}]},{"w":"கோள்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கோள்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":312,"ch":32,"l1":"கறுத்துஇன்னா செய்தவக் கண்ணும் மறுத்தின்னா","l2":"செய்யாமை மாசற்றார் கோள்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவன் கறுவுகொண்டு துன்பம் செய்த போதிலும் அவனுக்கு திரும்ப துன்பம் செய்யாதிருத்தலே மாசற்றவரின் கொள்கையாகும்.","en":"It is the determination of the spotless not to do evil, even in return, to those who have cherished enmity and done them evil","lines":[{"t":"கறுத்துஇன்னா செய்தவக் கண்ணும் மறுத்தின்னா","err":null,"seers":[{"w":"கறுத்துஇன்னா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கறுத்"},{"k":"I","s":"துஇன்"},{"k":"N","s":"னா"}]},{"w":"செய்தவக்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"தவக்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"மறுத்தின்னா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மறுத்"},{"k":"N","s":"தின்"},{"k":"N","s":"னா"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செய்யாமை மாசற்றார் கோள்.","err":null,"seers":[{"w":"செய்யாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யா"},{"k":"N","s":"மை"}]},{"w":"மாசற்றார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"N","s":"சற்"},{"k":"N","s":"றார்"}]},{"w":"கோள்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கோள்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":313,"ch":32,"l1":"செய்யாமல் செற்றார்க்கும் இன்னாத செய்தபின்","l2":"உய்யா விழுமந் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தான் ஒன்றும் செய்யாதிருக்கத் தனக்குத் தீங்கு செய்தவர்க்கும் துன்பமானாவற்றைச் செய்தால் செய்தபிறகு தப்பமுடியாத துன்பத்தையே கொடுக்கும்.","en":"In an ascetic inflict suffering even on those who hate him, when he has not done them any evil, it will afterwards give him irretrievable sorrow","lines":[{"t":"செய்யாமல் செற்றார்க்கும் இன்னாத செய்தபின்","err":null,"seers":[{"w":"செய்யாமல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யா"},{"k":"N","s":"மல்"}]},{"w":"செற்றார்க்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செற்"},{"k":"N","s":"றார்க்"},{"k":"N","s":"கும்"}]},{"w":"இன்னாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"N","s":"த"}]},{"w":"செய்தபின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"தபின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"உய்யா விழுமந் தரும்.","err":null,"seers":[{"w":"உய்யா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உய்"},{"k":"N","s":"யா"}]},{"w":"விழுமந்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விழு"},{"k":"N","s":"மந்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":314,"ch":32,"l1":"இன்னாசெய் தாரை ஒறுத்தல் அவர்நாண","l2":"நன்னயஞ் செய்து விடல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இன்னா செய்தவரைத் தண்டித்தல் அவரே நாணும் படியாக அவருக்கு நல்லுதவி செய்து அவருடைய தீமையையும் நன்மையையும் மறந்து விடுதலாகும்.","en":"The (proper) punishment to those who have done evil (to you), is to put them to shame by showing them kindness, in return and to forget both the evil and the good done on both sides","lines":[{"t":"இன்னாசெய் தாரை ஒறுத்தல் அவர்நாண","err":null,"seers":[{"w":"இன்னாசெய்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"N","s":"செய்"}]},{"w":"தாரை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"ரை"}]},{"w":"ஒறுத்தல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒறுத்"},{"k":"N","s":"தல்"}]},{"w":"அவர்நாண","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவர்"},{"k":"N","s":"நா"},{"k":"N","s":"ண"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நன்னயஞ் செய்து விடல்.","err":null,"seers":[{"w":"நன்னயஞ்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நன்"},{"k":"I","s":"னயஞ்"}]},{"w":"செய்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"து"}]},{"w":"விடல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":315,"ch":32,"l1":"அறிவினான் ஆகுவ துண்டோ பிறிதின்நோய்","l2":"தந்நோய்போல் போற்றாக் கடை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மற்ற உயிரின் துன்பத்தை தன் துன்பம் போல் கருதிக் காப்பாற்றா விட்டால் பெற்றுள்ள அறிவினால் ஆகும் பயன் உண்டோ.","en":"What benefit has he derived from his knowledge, who does not endeavour to keep off pain from another as much as from himself ?","lines":[{"t":"அறிவினான் ஆகுவ துண்டோ பிறிதின்நோய்","err":null,"seers":[{"w":"அறிவினான்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வினான்"}]},{"w":"ஆகுவ","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"குவ"}]},{"w":"துண்டோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"துண்"},{"k":"N","s":"டோ"}]},{"w":"பிறிதின்நோய்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறி"},{"k":"N","s":"தின்"},{"k":"N","s":"நோய்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தந்நோய்போல் போற்றாக் கடை.","err":null,"seers":[{"w":"தந்நோய்போல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தந்"},{"k":"N","s":"நோய்"},{"k":"N","s":"போல்"}]},{"w":"போற்றாக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றாக்"}]},{"w":"கடை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கடை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":316,"ch":32,"l1":"இன்னா எனத்தான் உணர்ந்தவை துன்னாமை","l2":"வேண்டும் பிறன்கண் செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவன் துன்பமானவை என்று தன் வாழ்க்கையில் கண்டு உணர்ந்தவைகளை மற்றவனிடத்தில் செய்யாமல் தவிர்க்க வேண்டும்.","en":"Let not a man consent to do those things to another which, he knows, will cause sorrow","lines":[{"t":"இன்னா எனத்தான் உணர்ந்தவை துன்னாமை","err":null,"seers":[{"w":"இன்னா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"}]},{"w":"எனத்தான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"எனத்"},{"k":"N","s":"தான்"}]},{"w":"உணர்ந்தவை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உணர்ந்"},{"k":"I","s":"தவை"}]},{"w":"துன்னாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"துன்"},{"k":"N","s":"னா"},{"k":"N","s":"மை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேண்டும் பிறன்கண் செயல்.","err":null,"seers":[{"w":"வேண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"பிறன்க