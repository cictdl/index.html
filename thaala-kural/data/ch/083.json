[{"n":821,"ch":83,"l1":"சீரிடம் காணின் எறிதற்குப் பட்டடை","l2":"நேரா நிரந்தவர் நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அகத்தே பொருந்தாமல் புறத்தே பொருந்தி நடப்பவரின் நட்பு, தக்க இடம் கண்டபோது எறிவதற்கு உரிய பட்டையாகும்.","en":"The friendship of those who behave like friends without inward affection is a weapon that may be thrown when a favourable opportunity presents itself","lines":[{"t":"சீரிடம் காணின் எறிதற்குப் பட்டடை","err":null,"seers":[{"w":"சீரிடம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சீ"},{"k":"I","s":"ரிடம்"}]},{"w":"காணின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணின்"}]},{"w":"எறிதற்குப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எறி"},{"k":"N","s":"தற்"},{"k":"N","s":"குப்"}]},{"w":"பட்டடை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பட்"},{"k":"I","s":"டடை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நேரா நிரந்தவர் நட்பு.","err":null,"seers":[{"w":"நேரா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நே"},{"k":"N","s":"ரா"}]},{"w":"நிரந்தவர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நிரந்"},{"k":"I","s":"தவர்"}]},{"w":"நட்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":822,"ch":83,"l1":"இனம்போன்று இனமல்லார் கேண்மை மகளிர்","l2":"மனம்போல வேறு படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இனம் போலவே இருந்து உண்மையில் இனம் அல்லாதவரின் நட்பு, பொதுமகளிரின் மனம் போல உள்ளொன்று புறமொன்றாக வேறுபட்டு நிற்கும்.","en":"The friendship of those who seem to be friends while they are not, will change like the love of women","lines":[{"t":"இனம்போன்று இனமல்லார் கேண்மை மகளிர்","err":null,"seers":[{"w":"இனம்போன்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இனம்"},{"k":"N","s":"போன்"},{"k":"N","s":"று"}]},{"w":"இனமல்லார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இன"},{"k":"N","s":"மல்"},