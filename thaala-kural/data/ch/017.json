[{"n":161,"ch":17,"l1":"ஒழுக்காறாக் கொள்க ஒருவன்தன் நெஞ்சத்து","l2":"அழுக்காறு இலாத இயல்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["கலித்தளை"],"mv":"ஒருவன் தன் நெஞ்சில் பொறாமை இல்லாமல் வாழும் இயல்பைத் தனக்கு உரிய ஒழுக்க நெறியாகக் கொண்டு போற்ற வேண்டும்.","en":"Let a man esteem that disposition which is free from envy in the same manner as propriety of conduct","lines":[{"t":"ஒழுக்காறாக் கொள்க ஒருவன்தன் நெஞ்சத்து","err":null,"seers":[{"w":"ஒழுக்காறாக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒழுக்"},{"k":"N","s":"கா"},{"k":"N","s":"றாக்"}]},{"w":"கொள்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"க"}]},{"w":"ஒருவன்தன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வன்"},{"k":"N","s":"தன்"}]},{"w":"நெஞ்சத்து","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அழுக்காறு இலாத இயல்பு.","err":null,"seers":[{"w":"அழுக்காறு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அழுக்"},{"k":"N","s":"கா"},{"k":"N","s":"று"}]},{"w":"இலாத","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இலா"},{"k":"N","s":"த"}]},{"w":"இயல்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இயல்"},{"k":"N","s":"பு"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":162,"ch":17,"l1":"விழுப்பேற்றின் அஃதொப்பது இல்லையார் மாட்டும்","l2":"அழுக்காற்றின் அன்மை பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"யாரிடத்திலும் பொறாமை இல்லாதிருக்கப் பெற்றால், ஒருவன் பெறத்தக்க மேம்பாடான பேறுகளில் அதற்கு ஒப்பானது வேறொன்றும் இல்லை.","en":"Amongst all attainable excellences there is none equal to that of being free from envy towords others","lines":[{"t":"விழுப்பேற்றின் அஃதொப்பது இல்லையார் மாட்டும்","err":null,"seers":[{"w":"விழுப்பேற்றின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விழுப்"},{"k":"N","s":"பேற்"},{"k":"N","s":"றின்"}]},{"w":"அஃதொப்பது","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"தொப்"},{"k":"I","s":"பது"}]},{"w":"இல்லையார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"},{"k":"N","s":"யார்"}]},{"w":"மாட்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாட்"},{"k":"N","s":"டும்"}]}],"thalai":["வெண்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை","வெண்சீர் வெண்டளை"]},{"t":"அழுக்காற்றின் அன்மை பெறின்.","err":null,"seers":[{"w":"அழுக்காற்றின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அழுக்"},{"k":"N","s":"காற்"},{"k":"N","s":"றின்"}]},{"w":"அன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"மை"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":163,"ch":17,"l1":"அறன்ஆக்கம் வேண்டாதான் என்பான் பிறனாக்கம்","l2":"பேணாது அழுக்கறுப் பான்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தனக்கு அறமும் ஆக்கமும் விரும்பாதவன் என்று கருதத் தக்கவனே, பிறனுடைய ஆக்கத்தைக் கண்டு மகிழாமல் அதற்காகப் பொறாமைப்படுவான்.","en":"Of him who instead of rejoicing in the wealth of others, envies it, it will be said \"he neither desires virtue not wealth.\"","lines":[{"t":"அறன்ஆக்கம் வேண்டாதான் என்பான் பிறனாக்கம்","err":null,"seers":[{"w":"அறன்ஆக்கம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறன்"},{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"வேண்டாதான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டா"},{"k":"N","s":"தான்"}]},{"w":"என்பான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"பான்"}]},{"w":"பிறனாக்கம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிற"},{"k":"N","s":"னாக்"},{"k":"N","s":"கம்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பேணாது அழுக்கறுப் பான்.","err":null,"seers":[{"w":"பேணாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"ணா"},{"k":"N","s":"து"}]},{"w":"அழுக்கறுப்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அழுக்"},{"k":"I","s":"கறுப்"}]},{"w":"பான்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"பான்"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":164,"ch":17,"l1":"அழுக்காற்றின் அல்லவை செய்யார் இழுக்காற்றின்","l2":"ஏதம் படுபாக்கு அறிந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பொறாமைப்படுதலாகிய தவறான நெறியில் துன்பம் ஏற்படுத‌ை அறிந்து, பொறாமை காரணமாக அறமல்லாதவைகளைச் செய்யார் அறிவுடையோர்.","en":"(The wise) knowing the misery that comes from transgression will not through envy commit unrighteous deeds","lines":[{"t":"அழுக்காற்றின் அல்லவை செய்யார் இழுக்காற்றின்","err":null,"seers":[{"w":"அழுக்காற்றின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அழுக்"},{"k":"N","s":"காற்"},{"k":"N","s":"றின்"}]},{"w":"அல்லவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அல்"},{"k":"I","s":"லவை"}]},{"w":"செய்யார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யார்"}]},{"w":"இழுக்காற்றின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"காற்"},{"k":"N","s":"றின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஏதம் படுபாக்கு அறிந்து.","err":null,"seers":[{"w":"ஏதம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"தம்"}]},{"w":"படுபாக்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"படு"},{"k":"N","s":"பாக்"},{"k":"N","s":"கு"}]},{"w":"அறிந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறிந்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை"]}]},{"n":165,"ch":17,"l1":"அழுக்காறு உடையார்க்கு அதுசாலும் ஒன்னார்","l2":"வழுக்காயும் கேடீன் பது.","ok":true,"reseg":true,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொறாமை உடை‌யவர்க்கு வேறு பகை வேண்டா. அஃது ஒன்றே போதும், பகைவர் தீங்கு செய்யத் தவறினாலும் தவறாது கேட்டைத் தருவது அது.","en":"To those who cherish envy that is enough Though free from enemies that (envy) will bring destruction","lines":[{"t":"அழுக்காறு உடையார்க்கு அதுசாலும் ஒன்னார்","err":n