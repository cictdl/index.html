[{"n":411,"ch":42,"l1":"செல்வத்துட் செல்வஞ் செவிச்செல்வம் அச்செல்வம்","l2":"செல்வத்து ளெல்லாந் தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"செவியால் கேட்டறியும் செல்வம், செல்வங்களுள் ஒன்றாகப் போற்றப்படும் செல்வமாகும், அச் செல்வம் செல்வங்கள் எல்லாவற்றிலும் தலையானதாகும்.","en":"Wealth (gained) by the ear is wealth of wealth; that wealth is the chief of all wealth","lines":[{"t":"செல்வத்துட் செல்வஞ் செவிச்செல்வம் அச்செல்வம்","err":null,"seers":[{"w":"செல்வத்துட்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வத்"},{"k":"N","s":"துட்"}]},{"w":"செல்வஞ்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வஞ்"}]},{"w":"செவிச்செல்வம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செவிச்"},{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"அச்செல்வம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அச்"},{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"செல்வத்து ளெல்லாந் தலை.","err":null,"seers":[{"w":"செல்வத்து","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வத்"},{"k":"N","s":"து"}]},{"w":"ளெல்லாந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ளெல்"},{"k":"N","s":"லாந்"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":412,"ch":42,"l1":"செவுக்குண வில்லாத போழ்து சிறிது","l2":"வயிற்றுக்கும் ஈயப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"செவிக்கு கேள்வியாகிய உணவு இல்லாத போது (அதற்க்கு துணையாக உடலை ஒப்புமாறு) வயிற்றுக்கும் சிறிது உணவு தரப்படும்.","en":"When there is no food for the ear, give a little also to the stomach","lines":[{"t":"செவுக்குண வில்லாத போழ்து சிறிது","err":null,"seers":[{"w":"செவுக்குண","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"செவுக்"},{"k":"I","s":"குண"}]},{"w":"வில்லாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வில்"},{"k":"N","s":"லா"},{"k":"N","s":"த"}]},{"w":"போழ்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போழ்"},{"k":"N","s":"து"}]},{"w":"சிறிது","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சிறி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வயிற்றுக்கும் ஈயப் படும்.","err":null,"seers":[{"w":"வயிற்றுக்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வயிற்"},{"k":"N","s":"றுக்"},{"k":"N","s":"கும்"}]},{"w":"ஈயப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"யப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":413,"ch":42,"l1":"செவியுணவிற் கேள்வி யுடையார் அவியுணவின்","l2":"ஆன்றாரோ டொப்பர் நிலத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"செவியுணவாகிய கேள்வி உடையவர் நிலத்தில் வாழ்கின்றவரே ஆயினும் அவி உணவைக் கொள்ளும் தேவரோடு ஒப்பாவார்.","en":"Those who in this world enjoy instruction which is the food of the ear, are equal to the Gods, who enjoy the food of the sacrifices","lines":[{"t":"செவியுணவிற் கேள்வி யுடையார் அவியுணவின்","err":null,"seers":[{"w":"செவியுணவிற்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"செவி"},{"k":"I","s":"யுண"},{"k":"N","s":"விற்"}]},{"w":"கேள்வி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேள்"},{"k":"N","s":"வி"}]},{"w":"யுடையார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"யுடை"},{"k":"N","s":"யார்"}]},{"w":"அவியுணவின்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அவி"},{"k":"I","s":"யுண"},{"k":"N","s":"வின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆன்றாரோ டொப்பர் நிலத்து.","err":null,"seers":[{"w":"ஆன்றாரோ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆன்"},{"k":"N","s":"றா"},{"k":"N","s":"ரோ"}]},{"w":"டொப்பர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டொப்"},{"k":"N","s":"பர்"}]},{"w":"நிலத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நிலத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":414,"ch":42,"l1":"கற்றில னாயினுங் கேட்க அஃதொருவற்கு","l2":"ஒற்கத்தின் ஊற்றாந் துணை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":[null],"mv":"நூல்களைக் கற்றவில்லையாயினும், கற்றறிந்தவர்களிடம் கேட்டறிய வேண்டும், அது ஒருவனுக்கு வாழ்க்கையில் தளர்ச்சி வந்த போது ஊன்றுகோல் போல் துணையாகும்.","en":"Although a man be without learning, let him listen (to the teaching of the learned); that will be to him a staff in adversity","lines":[{"t":"கற்றில னாயினுங் கேட்க அஃதொருவற்கு","err":null,"seers":[{"w":"கற்றில","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கற்"},{"k":"I","s":"றில"}]},{"w":"னாயினுங்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"னா"},{"k":"I","s":"யினுங்"}]},{"w":"கேட்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேட்"},{"k":"N","s":"க"}]},{"w":"அஃதொருவற்கு","name":"கூவிளந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"அஃ"},{"k":"I","s":"தொரு"},{"k":"N","s":"வற்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","நேரொன்றிய ஆசிரியத்தளை"]},{"t":"ஒற்கத்தின் ஊற்றாந் துணை.","err":null,"seers":[{"w":"ஒற்கத்தின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒற்"},{"k":"N","s":"கத்"},{"k":"N","s":"தின்"}]},{"w":"ஊற்றாந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊற்"},{"k":"N","s":"றாந்"}]},{"w":"துணை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"துணை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":415,"ch":42,"l1":"இழுக்கல் உடையுழி ஊற்றுக்கோல் அற்றே","l2":"ஒழுக்க முடையார்வாய்ச் சொல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒழுக்கமுடைய சான்றோரின் வாய்ச் சொற்கள், வழுக்கல் உடைய சேற்று நிலத்தில் ஊன்றுகோல் போல் வாழ்க்கையில் உதவும்.","en":"The words of the good are like a staff in a slippery place","lines":[{"t":"இழுக்கல் உடையுழி ஊற்றுக்கோல் அற்றே","err":null,"seers":[{"w":"இழுக்கல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"கல்"}]},{"w":"உடையுழி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உடை"},{"k":"I","s":"யுழி"}]},{"w":