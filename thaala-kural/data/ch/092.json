[{"n":911,"ch":92,"l1":"அன்பின் விழையார் பொருள்விழையும் ஆய்தொடியார்","l2":"இன்சொல் இழுக்குத் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அன் பினால் விரும்பாமல் பொருள் காரணமாக விரும்புகின்ற பொது மகளிர் பேசுகின்ற இனிய சொல், ஒருவனுக்கு துன்பத்தைக் கொடுக்கும்.","en":"The sweet words of elegant braceleted (prostitutes) who desire (a man) not from affection but from avarice, will cause sorrow","lines":[{"t":"அன்பின் விழையார் பொருள்விழையும் ஆய்தொடியார்","err":null,"seers":[{"w":"அன்பின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"பின்"}]},{"w":"விழையார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விழை"},{"k":"N","s":"யார்"}]},{"w":"பொருள்விழையும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருள்"},{"k":"I","s":"விழை"},{"k":"N","s":"யும்"}]},{"w":"ஆய்தொடியார்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆய்"},{"k":"I","s":"தொடி"},{"k":"N","s":"யார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இன்சொல் இழுக்குத் தரும்.","err":null,"seers":[{"w":"இன்சொல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"சொல்"}]},{"w":"இழுக்குத்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"குத்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":912,"ch":92,"l1":"பயன்தூக்கிப் பண்புரைக்கும் பண்பின் மகளிர்","l2":"நயன்தூக்கி நள்ளா விடல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கிடைக்க கூடிய பயனை அளந்து பார்த்து, அதற்கு ஏற்றவாறு இனிய சொல் கூறுகின்ற பண்பற்ற பொது மகளிரின் இன்பத்தை ஆராய்ந்து பொருந்தாமல் விட வேண்டும்.","en":"One must ascertain the character of the ill-natured women who after ascertaining the wealth (of a man) speak (as if they were) good natured-ones, and avoid intercourse (with them)","lines":[{"t":"பயன்தூக்கிப் பண்புரைக்கும் பண்பின் மகளிர்","err":null,"seers":[{"w":"பயன்தூக்கிப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பயன்"},{"k":"N","s":"தூக்"},{"k":"N","s":"கிப்"}]},{"w":"பண்புரைக்கும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பண்"},{"k":"I","s":"புரைக்"},{"k":"N","s":"கும்"}]},{"w":"பண்பின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பண்"},{"k":"N","s":"பின்"}]},{"w":"மகளிர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மக"},{"k":"N","s":"ளிர்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நயன்தூக்கி நள்ளா விடல்.","err":null,"seers":[{"w":"நயன்தூக்கி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நயன்"},{"k":"N","s":"தூக்"},{"k":"N","s":"கி"}]},{"w":"நள்ளா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நள்"},{"k":"N","s":"ளா"}]},{"w":"விடல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":913,"ch":92,"l1":"பொருட்பெண்டிர் பொய்ம்மை முயக்கம் இருட்டறையில்","l2":"ஏதில் பிணந்தழீஇ அற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பொருளையே விரும்பும் பொது மகளிரின் பொய்யானத் தழுவல், இருட்டறையில் தொடர்பில்லாத ஒரு பிணத்தைத் தழுவினாற் போன்றது.","en":"The false embraces of wealth-loving women are like (hired men) embracing a strange corpse in a dark room","lines":[{"t":"பொருட்பெண்டிர் பொய்ம்மை முயக்கம் இருட்டறையில்","err":null,"seers":[{"w":"பொருட்பெண்டிர்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருட்"},{"k":"N","s":"பெண்"},{"k":"N","s":"டிர்"}]},{"w":"பொய்ம்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பொய்ம்"},{"k":"N","s":"மை"}]},{"w":"முயக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முயக்"},{"k":"N","s":"கம்"}]},{"w":"இருட்டறையில்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இருட்"},{"k":"I","s":"டறை"},{"k":"N","s":"யில்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஏதில் பிணந்தழீஇ அற்று.","err":null,"seers":[{"w":"ஏதில்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"தில்"}]},{"w":"பிணந்தழீஇ","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிணந்"},{"k":"I","s":"தழீ"},{"k":"N","s":"இ"}]},{"w":"அற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":914,"ch":92,"l1":"பொருட்பொருளார் புன்னலந் தோயார் அருட்பொருள்","l2":"ஆயும் அறிவி னவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொருள் ஒன்றையே பொருளாகக் கொண்ட பொது மகளிரின் புன்மையான இன்பத்தை, அருளாகிய சிறந்த பொருளை ஆராயும் அறிவுடையோர் பொருந்த மாட்டார்.","en":"The wise who seek the wealth of grace will not desire the base favours of those who regard wealth (and not pleasure) as (their) riches","lines":[{"t":"பொருட்பொருளார் புன்னலந் தோயார் அருட்பொருள்","err":null,"seers":[{"w":"பொருட்பொருளார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருட்"},{"k":"I","s":"பொரு"},{"k":"N","s":"ளார்"}]},{"w":"புன்னலந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"புன்"},{"k":"I","s":"னலந்"}]},{"w":"தோயார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோ"},{"k":"N","s":"யார்"}]},{"w":"அருட்பொருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அருட்"},{"k":"I","s":"பொருள்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆயும் அறிவி னவர்.","err":null,"seers":[{"w":"ஆயும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"யும்"}]},{"w":"அறிவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வி"}]},{"w":"னவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"னவர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":915,"ch":92,"l1":"பொதுநலத்தார் புன்னலம் தோயார் மதிநலத்தின்","l2":"மாண்ட அறிவி னவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இயற்கை யறிவின் நன்மையால் சிறப்புற்ற அறிவுடையோர், பொருள் தருவார் எல்லார்க்கும் பொதுவாக இன்பம் தரும் மகளிரின் புன்மையான நலத்தைப் பொருந்தார்.","en":"Those whose knowledge is made excellent by their (natural) sense will not covet the trffling delights","lines":[{"t":"பொதுநலத்தார் புன்னலம் தோயார் மதிநலத்தின்","err":null,"seers":[{"w":"பொதுநலத்தார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பொது"},{"k":"I","s":"நலத்"},{"k":"N","s":"தார்"}]},{"w":"புன்னலம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"புன்"},{"k":"I","s":"னலம்"}]},{"w":"தோயார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோ"},{"k":"N","s":"யார்"}]},{"w":"மதிநலத்தின்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"மதி"},{"k":"I","s":"நலத்"},{"k":"N","s":"தின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாண்ட அறிவி னவர்.","err":null,"seers":[{"w":"மாண்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாண்"},{"k":"N","s":"ட"}]},{"w":"அறிவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வி"}]},{"w":"னவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"னவர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":916,"ch":92,"l1":"தந்நலம் பாரிப்பார் தோயார் தகைசெருக்கிப்","l2":"புன்னலம் பாரிப்பார் தோள்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அழகு முதலியவற்றால் செருக்கு கொண்டு தம் புன்மையான நலத்தை விற்கும் பொது மகளிரின் தோளை, தம் நல்லோழுக்கத்தைப் போற்றும் சான்றோர் பொருந்தார்.","en":"Those who would spread (the fame of) their own goodness will not desire the shoulders of those,who rejoice in their accomplishments and bestow their despicable favours (on all who pay)","lines":[{"t":"தந்நலம் பாரிப்பார் தோயார் தகைசெருக்கிப்","err":null,"seers":[{"w":"தந்நலம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தந்"},{"k":"I","s":"நலம்"}]},{"w":"பாரிப்பார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பா"},{"k":"N","s":"ரிப்"},{"k":"N","s":"பார்"}]},{"w":"தோயார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோ"},{"k":"N","s":"யார்"}]},{"w":"தகைசெருக்கிப்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தகை"},{"k":"I","s":"செருக்"},{"k":"N","s":"கிப்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"புன்னலம் பாரிப்பார் தோள்.","err":null,"seers":[{