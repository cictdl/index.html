[{"n":1281,"ch":129,"l1":"உள்ளக் களித்தலும் காண மகிழ்தலும்","l2":"கள்ளுக்கில் காமத்திற் குண்டு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நினைத்த அளவிலே களிப்படைதலும் கண்ட அளவிலே மகிழ்ச்சி அடைதலும் ஆகிய இந்த இருவகை தன்மையும் கள்ளுக்கு இல்‌லை; காமத்திற்கு உண்டு","en":"To please by thought and cheer by sight is peculiar, not to liquor but lust","lines":[{"t":"உள்ளக் களித்தலும் காண மகிழ்தலும்","err":null,"seers":[{"w":"உள்ளக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளக்"}]},{"w":"களித்தலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"களித்"},{"k":"I","s":"தலும்"}]},{"w":"காண","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ண"}]},{"w":"மகிழ்தலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மகிழ்"},{"k":"I","s":"தலும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கள்ளுக்கில் காமத்திற் குண்டு.","err":null,"seers":[{"w":"கள்ளுக்கில்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளுக்"},{"k":"N","s":"கில்"}]},{"w":"காமத்திற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"மத்"},{"k":"N","s":"திற்"}]},{"w":"குண்டு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குண்"},{"k":"N","s":"டு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1282,"ch":129,"l1":"தினைத்துணையும் ஊடாமை வேண்டும் பனைத்துணையும்","l2":"காமம் நிறைய வரின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"காமம் பனையளவாக நிறைய வரும்போது காதலரோடு தினையளவாகச் சிறிதேனும் ஊடல் கொள்ளாமல் இருக்க வேண்டும்.","en":"If women have a lust that exceeds even the measure of the palmyra fruit, they will not desire (to feign) dislike even as much as the millet","lines":[{"t":"தினைத்துணையும் ஊடாமை வேண்டும் பனைத்துணையும்","err":null,"seers":[{"w":"தினைத்துணையும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தினைத்"},{"k":"I","s":"துணை"},{"k":"N","s":"யும்"}]},{"w":"ஊடாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"டா"},{"k":"N","s":"மை"}]},{"w":"வேண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"பனைத்துணையும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பனைத்"},{"k":"I","s":"துணை"},{"k":"N","s":"யும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"காமம் நிறைய வரின்.","err":null,"seers":[{"w":"காமம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"மம்"}]},{"w":"நிறைய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நிறை"},{"k":"N","s":"ய"}]},{"w":"வரின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1283,"ch":129,"l1":"பேணாது பெட்பவே செய்யினும் கொண்கனைக்","l2":"காணா தமையல கண்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"என்னை விரும்பாமல் புறக்கணித்துத் தனக்கு விருப்பமானவற்றையே செய்து ஒழுகினாலும், என்னுடைய கண்கள் காதலனைக் காணாமல் பொருந்தவில்லை.","en":"Though my eyes disregard me and do what is pleasing to my husband, still will they not be satisfied unless they see him","lines":[{"t":"பேணாது பெட்பவே செய்யினும் கொண்கனைக்","err":null,"seers":[{"w":"பேணாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"ணா"},{"k":"N","s":"து"}]},{"w":"பெட்பவே","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பெட்"},{"k":"I","s":"பவே"}]},{"w":"செய்யினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"யினும்"}]},{"w":"கொண்கனைக்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கொண்"},{"k":"I","s":"கனைக்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"காணா தமையல கண்.","err":null,"seers":[{"w":"காணா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணா"}]},{"w":"தமையல","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தமை"},{"k":"I","s":"யல"}]},{"w":"கண்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கண்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1284,"ch":129,"l1":"ஊடற்கண் சென்றேன்மன் தோழி அதுமறந்து","l2":"கூடற்கண் சென்றது என் னெஞ்சு.","ok":true,"reseg":true,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"தோழி! யான் அவரோடு ஊடுவதற்காகச் சென்றேன்; ஆனால், என்னுடைய நெஞ்சம் அந்த நோக்கத்தை மறந்து அவரோடு கூடுவதற்காகச் சென்றது.","en":"My heart, forgetting all, could not its love restrain","lines":[{"t":"ஊடற்கண் சென்றேன்மன் தோழி அதுமறந்து","err":null,"seers":[{"w":"ஊடற்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"டற்"},{"k":"N","s":"கண்"}]},{"w":"சென்றேன்மன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சென்"},{"k":"N","s":"றேன்"},{"k":"N","s":"மன்"}]},{"w":"தோழி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோ"},{"k":"N","s":"ழி"}]},{"w":"அதுமறந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அது"},{"k":"I","s":"மறந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கூடற்கண் சென்றது என் னெஞ்சு.","err":null,"seers":[{"w":"கூடற்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கூ"},{"k":"N","s":"டற்"},{"k":"N","s":"கண்"}]},{"w":"சென்றதென்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சென்"},{"k":"I","s":"றதென்"}]},{"w":"னெஞ்சு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"னெஞ்"},{"k":"N","s":"சு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1285,"ch":129,"l1":"எழுதுங்கால் கோல்காணாக் கண்ணேபோல் கொண்கன்","l2":"பழிகாணேன் கண்ட இடத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"மை தீட்டும் நேரத்தில் தீட்டு் கோலைக் காணாத கண்களைப் போல், காதலனைக் கண்டபோது மட்டும் அவனுடைய குற்றத்தை நினைக்காமல் மறந்து விடுகின்றேன்.","en":"Like the eyes which see not the pencil that paints it, I cannot see my husband's fault (just) when I meet him","lines":[{"t":"எழுதுங்கால் கோல்காணாக் கண்ணேபோல் கொண்கன்","err":null,"seers":[{"w":"எழுதுங்கால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எழு"},{"k":"N","s":"துங்"},{"k":"N","s":"கால்"}]},{"w":"கோல்காணாக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கோல்"},{"k":"N","s":"கா"},{"k":"N","s":"ணாக்"}]},{"w":"கண்ணேபோல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணே"},{"k":"N","s":"போல்"}]},{"w":"கொண்கன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொண்"},{"k":"N","s":"கன்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பழிகாணேன் கண்ட இடத்து.","err":null,"seers":[{"w":"பழிகாணேன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பழி"},{"k":"N","s":"கா"},{"k":"N","s":"ணேன்"}]},{"w":"கண்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ட"}]},{"w":"இடத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1286,"ch":129,"l1":"காணுங்கால் காணேன் தவறாய காணாக்கால்","l2":"காணேன் தவறல் லவை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"காதலரைக் யான் காணும்போது ( அவருடைய செயல்களில்) தவறானவற்றைக் காண்பதில்லை; அவரைக் காணாதபோது தவறு அல்லாத நன்மைகளைக் காண்பதில்லை.","en":"When I see my husband, I do not see any faults; but when I do not see him, I do not see anything but faults","lines":[{"t":"காணுங்கால் காணேன் தவறாய காணாக்கால்","err":null,"seers":[{"w":"காணுங்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணுங்"},{"k":"N","s":"கால்"}]},{"w":"காணேன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணேன்"}]},{"w":"தவறாய","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தவ"},{"k":"N","s":"றா"},{"k":"N","s":"ய"}]},{"w":"காணாக்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணாக்"},{"k":"N","s":"கால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"காணேன் தவறல் லவை.","err":null,"seers":[{"w":"காணேன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணேன்"}]},{"w":"தவறல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவ"},{"k":"N","s":"றல்"}]},{"w":"லவை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"லவை"}]}],"