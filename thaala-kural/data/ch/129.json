":"N","s":"வார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1290,"ch":129,"l1":"கண்ணின் துனித்தே கலங்கினாள் புல்லுதல்","l2":"என்னினும் தான்விதுப் புற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"கண் பார்வையின் அளவில் பிணங்கி, என்னை விடத் தான் விரைந்து தழுவுதலை விரும்பி, ( பிணங்கிய நிலையையும் மறந்து) கலந்து விட்டாள்.","en":"She once feigned dislike in her eyes, but the warmth of her embrace exceeded my own","lines":[{"t":"கண்ணின் துனித்தே கலங்கினாள் புல்லுதல்","err":null,"seers":[{"w":"கண்ணின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணின்"}]},{"w":"துனித்தே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துனித்"},{"k":"N","s":"தே"}]},{"w":"கலங்கினாள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கலங்"},{"k":"I","s":"கினாள்"}]},{"w":"புல்லுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"புல்"},{"k":"I","s":"லுதல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"என்னினும் தான்விதுப் புற்று.","err":null,"seers":[{"w":"என்னினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"னினும்"}]},{"w":"தான்விதுப்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தான்"},{"k":"I","s":"விதுப்"}]},{"w":"புற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"புற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]