[{"n":61,"ch":7,"l1":"பெறுமவற்றுள் யாமறிவது இல்லை அறிவறிந்த","l2":"மக்கட்பேறு அல்ல பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பெறத்தகுந்த பேறுகளில் அறிய வேண்டியவைகளை அறியும் நன்மக்களைப் பெறுவதைத் தவிர, மற்றப்பேறுகளை யாம் மதிப்பதில்லை.","en":"Among all the benefits that may be acquired, we know no greater benefit than the acquisition of intelligent children","lines":[{"t":"பெறுமவற்றுள் யாமறிவது இல்லை அறிவறிந்த","err":null,"seers":[{"w":"பெறுமவற்றுள்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பெறு"},{"k":"I","s":"மவற்"},{"k":"N","s":"றுள்"}]},{"w":"யாமறிவது","name":"கூவிளங்கனி","cls":"கனி","a":[{"k":"N","s":"யா"},{"k":"I","s":"மறி"},{"k":"I","s":"வது"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"அறிவறிந்த","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வறிந்"},{"k":"N","s":"த"}]}],"thalai":["வெண்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]},{"t":"மக்கட்பேறு அல்ல பிற.","err":null,"seers":[{"w":"மக்கட்பேறு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"மக்"},{"k":"N","s":"கட்"},{"k":"N","s":"பே"},{"k":"N","s":"று"}]},{"w":"அல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அல்"},{"k":"N","s":"ல"}]},{"w":"பிற.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பிற"}]}],"thalai":[null,"இயற்சீர் வெண்டளை"]}]},{"n":62,"ch":7,"l1":"எழுபிறப்பும் தீயவை தீண்டா பழிபிறங்காப்","l2":"பண்புடை மக்கட் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பழி இல்லாத நல்ல பண்பு உடைய மக்களைப்பெற்றால் ஒருவனுக்கு ஏழு பிறவியிலும் தீவினைப் பயனாகிய துன்பங்கள் சென்று சேரா.","en":"The evils of the seven births shall not touch those who abtain children of a good disposition, free from vice","lines":[{"t":"எழுபிறப்பும் தீயவை தீண்டா பழிபிறங்காப்","err":null,"seers":[{"w":"எழுபிறப்பும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"எழு"},{"k":"I","s":"பிறப்"},{"k":"N","s":"பும்"}]},{"w":"தீயவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"யவை"}]},{"w":"தீண்டா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீண்"},{"k":"N","s":"டா"}]},{"w":"பழிபிறங்காப்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பழி"},{"k":"I","s":"பிறங்"},{"k":"N","s":"காப்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பண்புடை மக்கட் பெறின்.","err":null,"seers":[{"w":"பண்புடை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பண்"},{"k":"I","s":"புடை"}]},{"w":"மக்கட்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மக்"},{"k":"N","s":"கட்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":63,"ch":7,"l1":"தம்பொருள் என்பதம் மக்கள் அவர்பொருள்","l2":"தம்தம் வினையான் வரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தம்மக்களே தம்முடைய பொருள்கள் என்று அறிஞர் கூறுவர். மக்களாகிய அவர்தம் பொருள்கள் அவரவருடைய வினையின் பயனால் வந்து சேரும்.","en":"Men will call their sons their wealth, because it flows to them through the deeds which they (sons) perform on their behalf","lines":[{"t":"தம்பொருள் என்பதம் மக்கள் அவர்பொருள்","err":null,"seers":[{"w":"தம்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தம்"},{"k":"I","s":"பொருள்"}]},{"w":"என்பதம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பதம்"}]},{"w":"மக்கள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மக்"},{"k":"N","s":"கள்"}]},{"w":"அவர்பொருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அவர்"},{"k":"I","s":"பொருள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தம்தம் வினையான் வரும்.","err":null,"seers":[{"w":"தம்தம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தம்"},{"k":"N","s":"தம்"}]},{"w":"வினையான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வினை"},{"k":"N","s":"யான்"}]},{"w":"வரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":64,"ch":7,"l1":"அமிழ்தினும் ஆற்ற இனிதேதம் மக்கள்","l2":"சிறுகை அளாவிய கூழ்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தம்முடைய மக்களின் சிறு கைகளால் அளாவப்பெற்ற உணவு, பெற்றோர்க்கு அமிழ்தத்தை விட மிக்க இனிமை உடையதாகும்.","en":"The rice in which the little hand of their children has dabbled will be far sweeter (to the parent) than ambrosia","lines":[{"t":"அமிழ்தினும் ஆற்ற இனிதேதம் மக்கள்","err":null,"seers":[{"w":"அமிழ்தினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அமிழ்"},{"k":"I","s":"தினும்"}]},{"w":"ஆற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"ற"}]},{"w":"இனிதேதம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இனி"},{"k":"N","s":"தே"},{"k":"N","s":"தம்"}]},{"w":"மக்கள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மக்"},{"k":"N","s":"கள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"சிறுகை அளாவிய கூழ்.","err":null,"seers":[{"w":"சிறுகை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சிறு"},{"k":"N","s":"கை"}]},{"w":"அளாவிய","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அளா"},{"k":"I","s":"விய"}]},{"w":"கூழ்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கூழ்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":65,"ch":7,"l1":"மக்கள்மெய் தீண்டல் உடற்கின்பம் மற்றுஅவர்","l2":"சொற்கேட்டல் இன்பம் செவிக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மக்களின் உடம்பைத் தொடுதல் உடம்பிற்கு இன்பம் தருவதாகும்: அம் மக்களின் மழலைச் சொற்களைக் கேட்டால் செவிக்கு இன்பம் தருவதாகும்.","en":"The touch of children gives pleasure to the body, and the hearing of their words, pleasure to the ear","lines":[{"t":"மக்கள்மெய் தீண்டல் உடற்கின்பம் மற்றுஅவர்","err":null,"seers":[{"w":"மக்கள்மெய்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மக்"},{"k":"N","s":"கள்"},{"k":"N","s":"மெய்"}]},{"w":"தீண்டல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீண்"},{"k":"N","s":"டல்"}]},{"w":"உடற்கின்பம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":