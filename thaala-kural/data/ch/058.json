[{"n":571,"ch":58,"l1":"கண்ணோட்டம் என்னும் கழிபெருங் காரிகை","l2":"உண்மையான் உண்டிவ் வுலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"கண்ணோட்டம் என்று சொல்லப்படுகின்ற மிகச் சிறந்த அழகு இருக்கும் காரணத்தால் தான், இந்த உலகம் அழியாமல் இருக்கின்றது.","en":"The world exists through that greatest ornament (of princes), a gracious demeanour","lines":[{"t":"கண்ணோட்டம் என்னும் கழிபெருங் காரிகை","err":null,"seers":[{"w":"கண்ணோட்டம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணோட்"},{"k":"N","s":"டம்"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"கழிபெருங்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கழி"},{"k":"I","s":"பெருங்"}]},{"w":"காரிகை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கா"},{"k":"I","s":"ரிகை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உண்மையான் உண்டிவ் வுலகு.","err":null,"seers":[{"w":"உண்மையான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உண்"},{"k":"N","s":"மை"},{"k":"N","s":"யான்"}]},{"w":"உண்டிவ்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டிவ்"}]},{"w":"வுலகு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வுல"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":572,"ch":58,"l1":"கண்ணோட்டத் துள்ளது உலகியல் அஃதிலார்","l2":"உண்மை நிலக்குப் பொறை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கண்ணோட்டத்தினால் உலகியல் நடைபெறுகின்றது, கண்ணோட்டம் இல்லாதவர் உயிரோடு இருத்தல் நிலத்திற்குச் சுமையே தவிர வேறு பயனில்லை.","en":"The prosperity of the world springs from the kindliness, the existence of those who have no (kindliness) is a burden to the earth","lines":[{"t":"கண்ணோட்டத் துள்ளது உலகியல் அஃதிலார்","err":null,"seers":[{"w":"கண்ணோட்டத்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணோட்"},{"k":"N","s":"டத்"}]},{"w":"துள்ளது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"துள்"},{"k":"I","s":"ளது"}]},{"w":"உலகியல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உல"},{"k":"I","s":"கியல்"}]},{"w":"அஃதிலார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஃ"},{"k":"I","s":"திலார்"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"உண்மை நிலக்குப் பொறை.","err":null,"seers":[{"w":"உண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"மை"}]},{"w":"நிலக்குப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நிலக்"},{"k":"N","s":"குப்"}]},{"w":"பொறை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பொறை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":573,"ch":58,"l1":"பண்என்னாம் பாடற்கு இயைபின்றேல் கண்என்னாம்","l2":"கண்ணோட்டம் இல்லாத கண்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பாடலோடு பொருந்துதல் இல்லையானால் இசை என்ன பயனுடையதாகும், அதுபோல் கண்ணோட்டம் இல்லாவிட்டால் கண் என்ன பயனுடையதாகும்.","en":"Of what avail is a song if it be inconsistent with harmony ? what is the use of eyes which possess no kindliness","lines":[{"t":"பண்என்னாம் பாடற்கு இயைபின்றேல் கண்என்னாம்","err":null,"seers":[{"w":"பண்என்னாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பண்"},{"k":"N","s":"என்"},{"k":"N","s":"னாம்"}]},{"w":"பாடற்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பா"},{"k":"N","s":"டற்"},{"k":"N","s":"கு"}]},{"w":"இயைபின்றேல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இயை"},{"k":"N","s":"பின்"},{"k":"N","s":"றேல்"}]},{"w":"கண்என்னாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"என்"},{"k":"N","s":"னாம்"}]}],"thalai":["வெண்சீர் வெண்டளை","கலித்தளை","வெண்சீர் வெண்டளை"]},{"t":"கண்ணோட்டம் இல்லாத கண்.","err":null,"seers":[{"w":"கண்ணோட்டம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணோட்"},{"k":"N","s":"டம்"}]},{"w":"இல்லாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"த"}]},{"w":"கண்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கண்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":574,"ch":58,"l1":"உளபோல் முகத்தெவன் செய்யும் அளவினால்","l2":"கண்ணோட்டம் இல்லாத கண்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தக்க அளவிற்குக் கண்ணோட்டம் இல்லாத கண்கள் முகத்தில் உள்ளவை போல் தோன்றுதல் அல்லாமல் வேறு என்ன பயன் செய்யும்.","en":"Beyond appearing to be in the face, what good do they do, those eyes in which is no well-regulated kindness ?","lines":[{"t":"உளபோல் முகத்தெவன் செய்யும் அளவினால்","err":null,"seers":[{"w":"உளபோல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உள"},{"k":"N","s":"போல்"}]},{"w":"முகத்தெவன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"முகத்"},{"k":"I","s":"தெவன்"}]},{"w":"செய்யும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யும்"}]},{"w":"அளவினால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அள"},{"k":"I","s":"வினால்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கண்ணோட்டம் இல்லாத கண்.","err":null,"seers":[{"w":"கண்ணோட்டம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணோட்"},{"k":"N","s":"டம்"}]},{"w":"இல்லாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"த"}]},{"w":"கண்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கண்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":575,"ch":58,"l1":"கண்ணிற்கு அணிகலம் கண்ணோட்டம் அஃதின்றேல்","l2":"புண்ணென்று உணரப் படும்","ok":true,"reseg":true,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவனுடைய கண்ணுக்கு அணிகலமாவது கண்ணோட்டம் என்னும் பண்பே, அஃது இல்லையானால் புண் என்று உணரப்படும்.","en":"Kind looks are the ornaments of the eyes; without these they will be considered (by the wise) to be merely two sores","lines":[{"t":"கண்ணிற்கு அணிகலம் கண்ணோட்டம் அஃதின்றேல்","err":null,"seers":[{"w":"கண்ணிற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணிற்"}]},{"w":"கணிகலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கணி"},{"k":