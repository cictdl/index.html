[{"n":1231,"ch":124,"l1":"சிறுமை நமக்கொழியச் சேட்சென்றார் உள்ளி","l2":"நறுமலர் நாணின கண்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இத்துன்பத்தை நமக்கு விட்டு விட்டுத் தொலைவில் உள்ள நாட்டுக்குச் சென்ற காதலரை நினைந்து அழுதமையால் கண்கள் அழகு இழந்து நறுமலர்களுக்கு நாணி விட்டன.","en":"While we endure the unbearable sorrow, your eyes weep for him who is gone afar, and shun (the sight of) fragrant flowers","lines":[{"t":"சிறுமை நமக்கொழியச் சேட்சென்றார் உள்ளி","err":null,"seers":[{"w":"சிறுமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சிறு"},{"k":"N","s":"மை"}]},{"w":"நமக்கொழியச்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நமக்"},{"k":"I","s":"கொழி"},{"k":"N","s":"யச்"}]},{"w":"சேட்சென்றார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சேட்"},{"k":"N","s":"சென்"},{"k":"N","s":"றார்"}]},{"w":"உள்ளி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளி"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நறுமலர் நாணின கண்.","err":null,"seers":[{"w":"நறுமலர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நறு"},{"k":"I","s":"மலர்"}]},{"w":"நாணின","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நா"},{"k":"I","s":"ணின"}]},{"w":"கண்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கண்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1232,"ch":124,"l1":"நயந்தவர் நல்காமை சொல்லுவ போலும்","l2":"பசந்து பனிவாரும் கண்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பசலை நிறம் அடைந்து நீர் சொரியும் கண்கள், நாம் விரும்பிய காதலர் நமக்கு அன்பு செய்யாத தன்மையைப் ( பிறர்க்குச்) சொல்வன போல் உள்ளன.","en":"The discoloured eyes that shed tears profusely seem to betray the unkindness of our beloved","lines":[{"t":"நயந்தவர் நல்காமை சொல்லுவ போலும்","err":null,"seers":[{"w":"நயந்தவர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நயந்"},{"k":"I","s":"தவர்"}]},{"w":"நல்காமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"சொல்லுவ","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லுவ"}]},{"w":"போலும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"லும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பசந்து பனிவாரும் கண்.","err":null,"seers":[{"w":"பசந்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பசந்"},{"k":"N","s":"து"}]},{"w":"பனிவாரும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பனி"},{"k":"N","s":"வா"},{"k":"N","s":"ரும்"}]},{"w":"கண்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கண்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1233,"ch":124,"l1":"தணந்தமை சால அறிவிப்ப போலும்","l2":"மணந்தநாள் வீங்கிய தோள்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கூடியிருந்த காலத்தில் மகிழ்ந்து பூரித்திருந்த தோள்கள், ( இப்போது மெலிந்தும்) காதலருடைய பிரிவை நன்றாக அறிவிப்பவை போல் உள்ளன.","en":"The shoulders that swelled on the day of our union (now) seem to announce our separation clearly (to the public)","lines":[{"t":"தணந்தமை சால அறிவிப்ப போலும்","err":null,"seers":[{"w":"தணந்தமை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தணந்"},{"k":"I","s":"தமை"}]},{"w":"சால","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சா"},{"k":"N","s":"ல"}]},{"w":"அறிவிப்ப","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"N","s":"விப்"},{"k":"N","s":"ப"}]},{"w":"போலும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"லும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"மணந்தநாள் வீங்கிய தோள்.","err":null,"seers":[{"w":"மணந்தநாள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மணந்"},{"k":"I","s":"தநாள்"}]},{"w":"வீங்கிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வீங்"},{"k":"I","s":"கிய"}]},{"w":"தோள்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தோள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1234,"ch":124,"l1":"பணைநீங்கிப் பைந்தொடி சோரும் துணைநீங்கித்","l2":"தொல்கவின் வாடிய தோள்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"துணைவர் விட்டு நீங்கியதால் பழைய அழகு கெட்டு வாடிய தோள்கள், பருத்த தன்மை கெட்டு மெலிந்து வளையல்களும் கழலச் செய்கின்றன.","en":"In the absence of your consort, your shoulders having lost their former beauty and fulness, your bracelets of pure gold have become loose","lines":[{"t":"பணைநீங்கிப் பைந்தொடி சோரும் துணைநீங்கித்","err":null,"seers":[{"w":"பணைநீங்கிப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பணை"},{"k":"N","s":"நீங்"},{"k":"N","s":"கிப்"}]},{"w":"பைந்தொடி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பைந்"},{"k":"I","s":"தொடி"}]},{"w":"சோரும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சோ"},{"k":"N","s":"ரும்"}]},{"w":"துணைநீங்கித்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துணை"},{"k":"N","s":"நீங்"},{"k":"N","s":"கித்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தொல்கவின் வாடிய தோள்.","err":null,"seers":[{"w":"தொல்கவின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தொல்"},{"k":"I","s":"கவின்"}]},{"w":"வாடிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வா"},{"k":"I","s":"டிய"}]},{"w":"தோள்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தோள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1235,"ch":124,"l1":"கொடியார் கொடுமை உரைக்கும் தொடியொடு","l2":"தொல்கவின் வாடிய தோள்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"வளையல்களும் கழன்று பழைய அழகும் கெட்டு, வாடிய தோள்கள் (என் துன்பம் உணராத) கொடியவரி்ன கொடுமையைப் பிறர் அறியச் சொல்கின்றன.","en":"The (loosened) bracelets, and the shoulders from which the old beauty has faded, relate the cruelty of the pitiless one","lines":[{"t":"கொடியார் கொடுமை உரைக்கும் தொடியொடு","err":null,"seers":[{"w":"கொடியார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கொடி"},{"k":"N","s":"யார்"}]},{"w":"கொடுமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கொடு"},{"k":"N","s":"மை"}]},{"w":"உரைக்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உரைக்"},{"k":"N","s":"கும்"}]},{"w":"தொடியொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தொடி"},{"k":"I","s":"யொடு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தொல்கவின் வாடிய தோள்.","err":null,"seers":[{"w":"தொல்கவின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தொல்"},{"k":"I","s":"கவின்"}]},{"w":"வாடிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வா"},{"k":"I","s":"டிய"}]},{"w":"தோள்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தோள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1236,"ch":124,"l1":"தொடியொடு தோள்நெகிழ நோவல் அவரைக்","l2":"கொடியர் எனக்கூறல் நொந்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"வளையல்கள் கழன்று தோள்களும் மெலிவடைவதால் (அவற்றைக் காண்போர்) காதலரைக் கொடியவர் என்று கூறுவதைக் கேட்டு வருந்துகின்றேன்.","en":"I am greatly pained to hear you call him a cruel man, just because your shoulders are reduced and your bracelets loosened","lines":[{"t":"தொடியொடு தோள்நெகிழ நோவல் அவரைக்","err":null,"seers":[{"w":"தொடியொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தொடி"},{"k":"I","s":"யொடு"}]},{"w":"தோள்நெகிழ","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தோள்"},{"k":"I","s":"நெகி"},{"k":"N","s":"ழ"}]},{"w":"நோவல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோ"},{"k":"N","s":"வல்"}]},{"w":"அவரைக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அவ"},{"k":"N","s":"ரைக்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கொடியர் எனக்கூறல் நொந்து.","err":null,"seers":[{"w":"கொடியர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கொடி"},{"k":"N","s":"யர்"}]},{"w":"எனக்கூறல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எனக்"},{"k":"N","s":"கூ"},{"k":"N","s":"றல்"}]},{"w":"நொந்து.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நொந்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1237,"ch":124,"l1":"பாடு பெறுதியோ நெஞ்சே கொடியார்க்கென்"