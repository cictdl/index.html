[{"n":431,"ch":44,"l1":"செருக்குஞ் சினமும் சிறுமையும் இல்லார்","l2":"பெருக்கம் பெருமித நீர்த்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"செருக்கும் சினமும் காமமும் ஆகிய இந்தக் குற்றங்கள் இல்லாதவனுடைய வாழ்வில் காணும் பெருக்கம் மேம்பாடு உடையதாகும்.","en":"Truly great is the excellence of those (kings) who are free from pride, anger, and lust","lines":[{"t":"செருக்குஞ் சினமும் சிறுமையும் இல்லார்","err":null,"seers":[{"w":"செருக்குஞ்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செருக்"},{"k":"N","s":"குஞ்"}]},{"w":"சினமும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சின"},{"k":"N","s":"மும்"}]},{"w":"சிறுமையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறு"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"இல்லார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பெருக்கம் பெருமித நீர்த்து.","err":null,"seers":[{"w":"பெருக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெருக்"},{"k":"N","s":"கம்"}]},{"w":"பெருமித","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பெரு"},{"k":"I","s":"மித"}]},{"w":"நீர்த்து.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீர்த்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":432,"ch":44,"l1":"இவறலும் மாண்பிறந்த மானமும் மாணா","l2":"உவகையும் ஏதம் இறைக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொருள் கொடாத தன்மையும் மாட்சியில்லாத மானமும், தகுதியற்ற மகிழ்ச்சியும் தலைவனாக இருப்பனுக்கு குற்றங்களாகும்.","en":"Avarice, undignified pride, and low pleasures are faults in a king","lines":[{"t":"இவறலும் மாண்பிறந்த மானமும் மாணா","err":null,"seers":[{"w":"இவறலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இவ"},{"k":"I","s":"றலும்"}]},{"w":"மாண்பிறந்த","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மாண்"},{"k":"I","s":"பிறந்"},{"k":"N","s":"த"}]},{"w":"மானமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மா"},{"k":"I","s":"னமும்"}]},{"w":"மாணா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மா"},{"k":"N","s":"ணா"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உவகையும் ஏதம் இறைக்கு.","err":null,"seers":[{"w":"உவகையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உவ"},{"k":"N","s":"கை"},{"k":"N","s":"யும்"}]},{"w":"ஏதம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"தம்"}]},{"w":"இறைக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இறைக்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":433,"ch":44,"l1":"தினைத்துணையாங் குற்றம் வரினும் பனைத்துணையாக்","l2":"கொள்வர் பழிநாணு வார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பழி நாணுகின்ற பெருமக்கள் தினையளவாகிய சிறு குற்றம் நேர்ந்தாலும் அதை பனையளவாகக் கருதிக் (குற்றம் செய்யாமல்) காத்துக் கொள்வர்.","en":"Those who fear guilt, if they commit a fault small as a millet seed, will consider it to be as large as a palmyra tree","lines":[{"t":"தினைத்துணையாங் குற்றம் வரினும் பனைத்துணையாக்","err":null,"seers":[{"w":"தினைத்துணையாங்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தினைத்"},{"k":"I","s":"துணை"},{"k":"N","s":"யாங்"}]},{"w":"குற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குற்"},{"k":"N","s":"றம்"}]},{"w":"வரினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வரி"},{"k":"N","s":"னும்"}]},{"w":"பனைத்துணையாக்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பனைத்"},{"k":"I","s":"துணை"},{"k":"N","s":"யாக்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கொள்வர் பழிநாணு வார்.","err":null,"seers":[{"w":"கொள்வர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"வர்"}]},{"w":"பழிநாணு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பழி"},{"k":"N","s":"நா"},{"k":"N","s":"ணு"}]},{"w":"வார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"வார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":434,"ch":44,"l1":"குற்றமே காக்க பொருளாகக் குற்றமே","l2":"அற்றந் த்ரூஉம் பகை.","ok":false,"reseg":false,"eetru":null,"boundary":[null],"mv":"குற்றமே ஒருவனுக்கு அழிவை உண்டாக்கும் பகையாகும், ஆகையால் குற்றம் செய்யாமல் இருப்பதே நோக்கமாகக் கொண்டு காத்துக் கொள்ள வேண்டும்.","en":"Guard against faults as a matter (of great consequence; for) faults are a deadly enemy","lines":[{"t":"குற்றமே காக்க பொருளாகக் குற்றமே","err":null,"seers":[{"w":"குற்றமே","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"குற்"},{"k":"I","s":"றமே"}]},{"w":"காக்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காக்"},{"k":"N","s":"க"}]},{"w":"பொருளாகக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளா"},{"k":"N","s":"கக்"}]},{"w":"குற்றமே","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"குற்"},{"k":"I","s":"றமே"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அற்றந் த்ரூஉம் பகை.","err":"த்ரூஉம்","seers":[{"w":"அற்றந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அற்"},{"k":"N","s":"றந்"}]}],"thalai":[]}]},{"n":435,"ch":44,"l1":"வருமுன்னர்க் காவாதான் வாழ்க்கை எரிமுன்னர்","l2":"வைத்தூறு போலக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"குற்றம் நேர்வதற்கு முன்னமே வராமல் காத்துக் கொள்ளாதவனுடைய வாழ்க்கை, நெருப்பின் முன் நின்ற வைக்கோல் போர் போல் அழிந்துவிடும்.","en":"The prosperity of him who does not timely guard against faults, will perish like straw before fire","lines":[{"t":"வருமுன்னர்க் காவாதான் வாழ்க்கை எரிமுன்னர்","err":null,"seers":[{"w":"வருமுன்னர்க்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வரு"},{"k":"N","s":"முன்"},{"k":"N","s":"னர்க்"}]},{"w":"காவாதான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"வா"},{"k":"N","s":"தான்"}]},{"w":"வாழ்க்கை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்க்"},{"k":"N","s":"கை"}]},{"w":"எரிமுன்னர்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எரி"},{"k":"N","s":"முன்"},{"k":"N","s":"னர்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வைத்தூறு போலக் கெடும்.","err":null,"seers":[{"w":"வைத்தூறு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வைத்"},{"k":"N","s":"தூ"},{"k":"N","s":"று"}]},{"w":"போலக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"லக்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":436,"ch":44,"l1":"தன்குற்றம் நீக்கிப் பிறர்குற்றங் காண்கிற்பின்","l2":"என்குற்ற மாகும் இறைக்கு?","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"முன்னே தன் குற்றத்தைக் கண்டு நீக்கி பிறகு பிறருடையக் குற்றத்தை ஆராயவல்லவனானால், தலைவனுக்கு என்ன குற்றமாகும்.","en":"What fault will remain in the king who has put away his own evils, and looks after the evils of others","lines":[{"t":"தன்குற்றம் நீக்கிப் பிறர்குற்றங் காண்கிற்பின்","err":null,"seers":[{"w":"தன்குற்றம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தன்"},{"k":"N","s":"குற்"},{"k":"N","s":"றம்"}]},{"w":"நீக்கிப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீக்"},{"k":"N","s":"கிப்"}]},{"w":"பிறர்குற்றங்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறர்"},{"k":"N","s":"குற்"},{"k":"N","s":"றங்"}]},{"w":"காண்கிற்பின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"காண்"},{"k":"N","s":"கிற்"},{"k":"N","s":"பின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"என்குற்ற மாகும் இறைக்கு?","err":null,"seers":[{"w":"என்குற்ற","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"N","s":"குற்"},{"k":"N","s":"ற"}]},{"w":"மாகும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மா"},{"k":"N","s":"கும்"}]},{"w":"இறைக்கு?","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இறைக்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":437,"ch":44,"l1":"செயற்பால செய்யா திவறியான் செல்வம்","l2":"உயற்பால தன்றிக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"செய்யத்தக்க நன்மைகளைச் செய்யாமல் பொருளை