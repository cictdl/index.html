[{"n":1291,"ch":130,"l1":"அவர்நெஞ்சு அவர்க்காதல் கண்டும் எவன்நெஞ்சே","l2":"நீஎமக்கு ஆகா தது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"நெஞ்சே! அவருடைய நெஞ்சம் ( நம்மை நினையாமல் நம்மிடம் வராமல்) அவர்க்குத் துணையாதலைக் கண்டும் நீ எமக்குத் துணையாகாதது ஏன்?","en":"O my soul! although you have seen how his soul stands by him, how is it you do not stand by me?","lines":[{"t":"அவர்நெஞ்சு அவர்க்காதல் கண்டும் எவன்நெஞ்சே","err":null,"seers":[{"w":"அவர்நெஞ்சு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவர்"},{"k":"N","s":"நெஞ்"},{"k":"N","s":"சு"}]},{"w":"அவர்க்காதல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவர்க்"},{"k":"N","s":"கா"},{"k":"N","s":"தல்"}]},{"w":"கண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"டும்"}]},{"w":"எவன்நெஞ்சே","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எவன்"},{"k":"N","s":"நெஞ்"},{"k":"N","s":"சே"}]}],"thalai":["கலித்தளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நீஎமக்கு ஆகா தது.","err":null,"seers":[{"w":"நீஎமக்கு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நீ"},{"k":"I","s":"எமக்"},{"k":"N","s":"கு"}]},{"w":"ஆகா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கா"}]},{"w":"தது.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தது"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1292,"ch":130,"l1":"உறாஅ தவர்க்கண்ட கண்ணும் அவரைச்","l2":"செறாஅரெனச் சேறியென் நெஞ்சு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"என் நெஞசே! நம்மேல் அன்பு கொள்ளாத காதலரைக் கண்டபோதும், அவர் வெறுக்கமாட்டார் என்று எண்ணி அவரிடம் செல்கின்றாயே!","en":"O my soul! although you have known him who does not love me, still do you go to him, saying \"he will not be displeased.\"","lines":[{"t":"உறாஅ தவர்க்கண்ட கண்ணும் அவரைச்","err":null,"seers":[{"w":"உறாஅ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உறா"},{"k":"N","s":"அ"}]},{"w":"தவர்க்கண்ட","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தவர்க்"},{"k":"N","s":"கண்"},{"k":"N","s":"ட"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"அவரைச்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அவ"},{"k":"N","s":"ரைச்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செறாஅரெனச் சேறியென் நெஞ்சு.","err":null,"seers":[{"w":"செறாஅரெனச்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"செறா"},{"k":"I","s":"அரெ"},{"k":"N","s":"னச்"}]},{"w":"சேறியென்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சே"},{"k":"I","s":"றியென்"}]},{"w":"நெஞ்சு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1293,"ch":130,"l1":"கெட்டார்க்கு நட்டார்இல் என்பதோ நெஞ்சேநீ","l2":"பெட்டாங்கு அவர்பின் செலல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நெஞ்சே! நீ உன் விருப்பத்தின்படியே அவர் பின் செல்வதற்குக் காரணம், துன்பத்தால் அழிந்தவர்‌க்கு நண்பர் இல்லை என்னும் எண்ண‌மோ?","en":"O my soul! do you follow him at pleasure under the belief that the ruined have no friends?","lines":[{"t":"கெட்டார்க்கு நட்டார்இல் என்பதோ நெஞ்சேநீ","err":null,"seers":[{"w":"கெட்டார்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கெட்"},{"k":"N","s":"டார்க்"},{"k":"N","s":"கு"}]},{"w":"நட்டார்இல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நட்"},{"k":"N","s":"டார்"},{"k":"N","s":"இல்"}]},{"w":"என்பதோ","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பதோ"}]},{"w":"நெஞ்சேநீ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சே"},{"k":"N","s":"நீ"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பெட்டாங்கு அவர்பின் செலல்.","err":null,"seers":[{"w":"பெட்டாங்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பெட்"},{"k":"N","s":"டாங்"},{"k":"N","s":"கு"}]},{"w":"அவர்பின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அவர்"},{"k":"N","s":"பின்"}]},{"w":"செலல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செலல்"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":1294,"ch":130,"l1":"இனிஅன்ன நின்னொடு சூழ்வார்யார் நெஞ்சே","l2":"துனிசெய்து துவ்வாய்காண் மற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நெஞ்‌சே! நீ ஊடலைச் செய்து அதன் பயனை நுகர மாட்டாய்; இனிமேல் அத்தகையவற்றைப் பற்றி உன்னோடு கலந்து எண்ணப் போகின்றவர் யார்?","en":"O my soul! you would not first seem sulky and then enjoy (him); who then would in future consult you about such things?","lines":[{"t":"இனிஅன்ன நின்னொடு சூழ்வார்யார் நெஞ்சே","err":null,"seers":[{"w":"இனிஅன்ன","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இனி"},{"k":"N","s":"அன்"},{"k":"N","s":"ன"}]},{"w":"நின்னொடு","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நின்"},{"k":"I","s":"னொடு"}]},{"w":"சூழ்வார்யார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சூழ்"},{"k":"N","s":"வார்"},{"k":"N","s":"யார்"}]},{"w":"நெஞ்சே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சே"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"துனிசெய்து துவ்வாய்காண் மற்று.","err":null,"seers":[{"w":"துனிசெய்து","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துனி"},{"k":"N","s":"செய்"},{"k":"N","s":"து"}]},{"w":"துவ்வாய்காண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"துவ்"},{"k":"N","s":"வாய்"},{"k":"N","s":"காண்"}]},{"w":"மற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மற்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1295,"ch":130,"l1":"பெறாஅமை அஞ்சும் பெறின்பிரிவு அஞ்சும்","l2":"அறாஅ இடும்பைத்தென் நெஞ்சு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"( காதலரைப் பெறாதபோது) பெறாமைக்கு அஞ்சும்; பெற்றால் பிரிவை நினைத்து அஞ்சும்; ( இவ்வாறாக) என் நெஞ்சம் தீராத துன்பம் உடையதாகின்றது.","en":"My soul fears when it is without him; it also fears when it is with him; it is subject to incessant sorrow","lines":[{"t":"பெறாஅமை அஞ்சும் பெறின்பிரிவு அஞ்சும்","err":null,"seers":[{"w":"பெறாஅமை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பெறா"},{"k":"I","s":"அமை"}]},{"w":"அஞ்சும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சும்"}]},{"w":"பெறின்பிரிவு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பெறின்"},{"k":"I","s":"பிரி"},{"k":"N","s":"வு"}]},{"w":"அஞ்சும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அறாஅ இடும்பைத்தென் நெஞ்சு.","err":null,"seers":[{"w":"அறாஅ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறா"},{"k":"N","s":"அ"}]},{"w":"இடும்பைத்தென்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இடும்"},{"k":"N","s":"பைத்"},{"k":"N","s":"தென்"}]},{"w":"நெஞ்சு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1296,"ch":130,"l1":"தனியே இருந்து நினைத்தக்கால் என்னைத்","l2":"தினிய இருந்ததென் நெஞ்சு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"காதலரைப் பிரிந்து தனியே இருந்து அவருடைய தவறுகளை நினைத்தபோது என் நெஞ்சம் என்னைத் தின்பது போல் துன்பம் செய்வதாக இருந்தது.","en":"My mind has been (here) in order to eat me up (as it were) whenever I think of him in my solitude","lines":[{"t":"தனியே இருந்து நினைத்தக்கால் என்னைத்","err":null,"seers":[{"w":"தனியே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தனி"},{"k":"N","s":"யே"}]},{"w":"இருந்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இருந்"},{"k":"N","s":"து"}]},{"w":"நினைத்தக்கால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நினைத்"},{"k":"N","s":"தக்"},{"k":"N","s":"கால்"}]},{"w":"என்னைத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னைத்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தினிய இருந்ததென் நெஞ்சு.","err":null,"seers":[{"w":"தினிய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தினி"},{"k":"N","s":"ய"}]},{"w":"இருந்ததென்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இருந்"},{"k":