[{"n":1101,"ch":111,"l1":"கண்டுகேட்டு உண்டுயிர்த்து உற்றறியும் ஐம்புலனும்","l2":"ஒண்தொடி கண்ணே உள.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கண்டும் கேட்டும் உண்டும் முகர்ந்தும் உற்றும் அறிகின்ற ஐந்து புலன்களாகிய இன்பங்களும் ஒளி பொருந்திய வளையல் அணிந்த இவளிடத்தில் உள்ளன.","en":"The (simultaneous) enjoyment of the five senses of sight, hearing, taste, smell and touch can only be found with bright braceleted (women)","lines":[{"t":"கண்டுகேட்டு உண்டுயிர்த்து உற்றறியும் ஐம்புலனும்","err":null,"seers":[{"w":"கண்டுகேட்டு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"I","s":"டுகேட்"},{"k":"N","s":"டு"}]},{"w":"உண்டுயிர்த்து","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"உண்"},{"k":"I","s":"டுயிர்த்"},{"k":"N","s":"து"}]},{"w":"உற்றறியும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"உற்"},{"k":"I","s":"றறி"},{"k":"N","s":"யும்"}]},{"w":"ஐம்புலனும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஐம்"},{"k":"I","s":"புல"},{"k":"N","s":"னும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஒண்தொடி கண்ணே உள.","err":null,"seers":[{"w":"ஒண்தொடி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஒண்"},{"k":"I","s":"தொடி"}]},{"w":"கண்ணே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணே"}]},{"w":"உள.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"உள"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1102,"ch":111,"l1":"பிணிக்கு மருந்து பிறமன் அணியிழை","l2":"தன்நோய்க்குத் தானே மருந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நோய்களுக்கு மருந்து வேறு பொருள்களாக இருக்கின்றன, ஆனால் அணிகலன் அணிந்த இவளால் வளர்ந்த நோய்க்கு இவளே மருந்தாக இருக்கின்றாள்.","en":"The remedy for a disease is always something different (from it); but for the disease caused by this jewelled maid, she is herself the cure","lines":[{"t":"பிணிக்கு மருந்து பிறமன் அணியிழை","err":null,"seers":[{"w":"பிணிக்கு","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிணிக்"},{"k":"N","s":"கு"}]},{"w":"மருந்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மருந்"},{"k":"N","s":"து"}]},{"w":"பிறமன்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிற"},{"k":"N","s":"மன்"}]},{"w":"அணியிழை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அணி"},{"k":"I","s":"யிழை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தன்நோய்க்குத் தானே மருந்து.","err":null,"seers":[{"w":"தன்நோய்க்குத்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தன்"},{"k":"N","s":"நோய்க்"},{"k":"N","s":"குத்"}]},{"w":"தானே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"னே"}]},{"w":"மருந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மருந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1103,"ch":111,"l1":"தாம்வீழ்வார் மென்றோள் துயிலின் இனிதுகொல்","l2":"தாமரைக் கண்ணான் உலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தாமரைக் கண்ணனுடைய உலகம், தாம் விரும்பும் காதலியரின் மெல்லிய தோள்களில் துயிலும் துயில் போல் இனிமை உடையதோ.","en":"Can the lotus-eyed Vishnu's heaven be indeed as sweet to those who delight to sleep in the delicate arms of their beloved ?","lines":[{"t":"தாம்வீழ்வார் மென்றோள் துயிலின் இனிதுகொல்","err":null,"seers":[{"w":"தாம்வீழ்வார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தாம்"},{"k":"N","s":"வீழ்"},{"k":"N","s":"வார்"}]},{"w":"மென்றோள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மென்"},{"k":"N","s":"றோள்"}]},{"w":"துயிலின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துயி"},{"k":"N","s":"லின்"}]},{"w":"இனிதுகொல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இனி"},{"k":"I","s":"துகொல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தாமரைக் கண்ணான் உலகு.","err":null,"seers":[{"w":"தாமரைக்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தா"},{"k":"I","s":"மரைக்"}]},{"w":"கண்ணான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணான்"}]},{"w":"உலகு.","n