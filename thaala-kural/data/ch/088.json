[{"n":871,"ch":88,"l1":"பகைஎன்னும் பண்பி லதனை ஒருவன்","l2":"நகையேயும் வேண்டற்பாற்று அன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பகை என்று சொல்லப்படும் பண்பு இல்லாத தீமையை ஒருவன் சிறிதும் பொழுது போக்கும் விளையாட்டாகவும் விரும்புதலாகாது.","en":"The evil of hatred is not of a nature to be desired by one even in sport","lines":[{"t":"பகைஎன்னும் பண்பி லதனை ஒருவன்","err":null,"seers":[{"w":"பகைஎன்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பகை"},{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"பண்பி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பண்"},{"k":"N","s":"பி"}]},{"w":"லதனை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"லத"},{"k":"N","s":"னை"}]},{"w":"ஒருவன்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நகையேயும் வேண்டற்பாற்று அன்று.","err":null,"seers":[{"w":"நகையேயும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நகை"},{"k":"N","s":"யே"},{"k":"N","s":"யும்"}]},{"w":"வேண்டற்பாற்று","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டற்"},{"k":"N","s":"பாற்"},{"k":"N","s":"று"}]},{"w":"அன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை",null]}]},{"n":872,"ch":88,"l1":"வில்லேர் உழவர் பகைகொளினும் கொள்ளற்க","l2":"சொல்லேர் உழவர் பகை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வில்லை ஏராக உடைய உழவராகிய வீரருடன் பகை கொண்ட போதிலும், சொல்லை ஏராக உடைய உழவராகிய அறிஞருடன் பகை கொள்ளக் கூடாது.","en":"Though you may incur the hatred of warriors whose ploughs are bows, incur not that of ministers whose ploughs are words","lines":[{"t":"வில்லேர் உழவர் பகைகொளினும் கொள்ளற்க","err":null,"seers":[{"w":"வில்லேர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வில்"},{"k":"N","s":"லேர்"}]},{"w":"உழவர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உழ"},{"k":"N","s":"வர்"}]},{"w":"பகைகொளினும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பகை"},{"k":"I","s":"கொளி"},{"k":"N","s":"னும்"}]},{"w":"கொள்ளற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"ளற்"},{"k":"N","s":"க"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"சொல்லேர் உழவர் பகை.","err":null,"seers":[{"w":"சொல்லேர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லேர்"}]},{"w":"உழவர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உழ"},{"k":"N","s":"வர்"}]},{"w":"பகை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பகை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":873,"ch":88,"l1":"ஏமுற் றவரினும் ஏழை தமியனாய்ப்","l2":"பல்லார் பகைகொள் பவன்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தான் தனியாக இருந்து பலருடைய பகையைத் தேடிக் கொள்பவன், பித்துப் பிடித்தாரை விட அறிவில்லாதவனாகக் கருதப்படுவான்.","en":"He who being alone, incurs the hatred of many is more infatuated than even mad men","lines":[{"t":"ஏமுற் றவரினும் ஏழை தமியனாய்ப்","err":null,"seers":[{"w":"ஏமுற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"முற்"}]},{"w":"றவரினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"றவ"},{"k":"I","s":"ரினும்"}]},{"w":"ஏழை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"ழை"}]},{"w":"தமியனாய்ப்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தமி"},{"k":"I","s":"யனாய்ப்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பல்லார் பகைகொள் பவன்.","err":null,"seers":[{"w":"பல்லார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பல்"},{"k":"N","s":"லார்"}]},{"w":"பகைகொள்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பகை"},{"k":"N","s":"கொள்"}]},{"w":"பவன்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":874,"ch":88,"l1":"பகைநட்பாக் கொண்டொழுகும் பண்புடை யாளன்","l2":"தகைமைக்கண் தங்கிற்று உலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"