[{"n":491,"ch":50,"l1":"தொடங்கற்க எவ்வினையும் எள்ளற்க முற்றும்","l2":"இடங்கண்ட பின்அல் லது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"முற்றுகை செய்வதற்கு ஏற்ற இடத்தைக் கண்டபின் அல்லாமல் எச் செயலையும் தொடங்கக்கூடாது, பகைவரை இகழவும் கூடாது.","en":"Let not (a king) despise (an enemy), nor undertake any thing (against him), until he has obtained (a suitable) place for besieging him","lines":[{"t":"தொடங்கற்க எவ்வினையும் எள்ளற்க முற்றும்","err":null,"seers":[{"w":"தொடங்கற்க","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தொடங்"},{"k":"N","s":"கற்"},{"k":"N","s":"க"}]},{"w":"எவ்வினையும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"எவ்"},{"k":"I","s":"வினை"},{"k":"N","s":"யும்"}]},{"w":"எள்ளற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எள்"},{"k":"N","s":"ளற்"},{"k":"N","s":"க"}]},{"w":"முற்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"முற்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இடங்கண்ட பின்அல் லது.","err":null,"seers":[{"w":"இடங்கண்ட","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இடங்"},{"k":"N","s":"கண்"},{"k":"N","s":"ட"}]},{"w":"பின்அல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பின்"},{"k":"N","s":"அல்"}]},{"w":"லது.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"லது"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":492,"ch":50,"l1":"முரண்சேர்ந்த மொய்ம்பி னவர்க்கும் அரண்சேர்ந்தாம்","l2":"ஆக்கம் பலவுந் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மாறுபாடு பொருந்திய வலிமை உடையவர்க்கும் அரணோடு பொருந்தி ஏற்படுகின்ற வெற்றியானது பல வகைப் பயன்களையும் கொடுக்கும்.","en":"Even to those who are men of power and expedients, an attack in connection with a fortification will yield many advantages","lines":[{"t":"முரண்சேர்ந்த மொய்ம்பி னவர்க்கும் அரண்சேர்ந்தாம்","err":null,"seers":[{"w":"முரண்சேர்ந்த","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முரண்"},{"k":"N","s":"சேர்ந்"},{"k":"N","s":"த"}]},{"w":"மொய்ம்பி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மொய்ம்"},{"k":"N","s":"பி"}]},{"w":"னவர்க்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"னவர்க்"},{"k":"N","s":"கும்"}]},{"w":"அரண்சேர்ந்தாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அரண்"},{"k":"N","s":"சேர்ந்"},{"k":"N","s":"தாம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆக்கம் பலவுந் தரும்.","err":null,"seers":[{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"பலவுந்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பல"},{"k":"N","s":"வுந்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":493,"ch":50,"l1":"ஆற்றாரும் ஆற்றி அடுப இடனறிந்து","l2":"போற்றார்கண் போற்றிச் செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தக்க இடத்தை அறிந்து தம்மைக் காத்துக் கொண்டு பகைவரிடத்திற் சென்று தம் செயலைச் செய்தால், வலிமை இல்லாதவறும் வலிமை உடையவராக வெல்வர்,","en":"Even the powerless will become powerful and conquer, if they select a proper field (of action), and guard themselves, while they make war on their enemies","lines":[{"t":"ஆற்றாரும் ஆற்றி அடுப இடனறிந்து","err":null,"seers":[{"w":"ஆற்றாரும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றா"},{"k":"N","s":"ரும்"}]},{"w":"ஆற்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றி"}]},{"w":"அடுப","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அடு"},{"k":"N","s":"ப"}]},{"w":"இடனறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இட"},{"k":"I","s":"னறிந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"போற்றார்கண் போற்றிச் செயின்.","err":null,"seers":[{"w":"போற்றார்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றார்"},{"k":"N","s":"கண்"}]},{"w":"போற்றிச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றி