[{"n":1081,"ch":109,"l1":"அணங்குகொல் ஆய்மயில் கொல்லோ கனங்குழை","l2":"மாதர்கொல் மாலும் என் நெஞ்சு.","ok":true,"reseg":true,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தெய்வப் பெண்ணோ! மயிலோ, கனமான குழை அணிந்த மனிதப் பெண்ணோ, என் நெஞ்சம் மயங்குகின்றதே.","en":"Is this jewelled female a celestial, a choice peahen, or a human being ? My mind is perplexed","lines":[{"t":"அணங்குகொல் ஆய்மயில் கொல்லோ கனங்குழை","err":null,"seers":[{"w":"அணங்குகொல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அணங்"},{"k":"I","s":"குகொல்"}]},{"w":"ஆய்மயில்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆய்"},{"k":"I","s":"மயில்"}]},{"w":"கொல்லோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லோ"}]},{"w":"கனங்குழை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கனங்"},{"k":"I","s":"குழை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாதர்கொல் மாலும் என் நெஞ்சு.","err":null,"seers":[{"w":"மாதர்கொல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"N","s":"தர்"},{"k":"N","s":"கொல்"}]},{"w":"மாலும்என்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"N","s":"லும்"},{"k":"N","s":"என்"}]},{"w":"நெஞ்சு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1082,"ch":109,"l1":"நோக்கினாள் நோக்கெதிர் நோக்குதல் தாக்கணங்கு","l2":"தானைக்கொண் டன்ன துடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"நோக்கிய அவள் பார்வைக்கு எதிரே நோக்குதல் தானே தாக்கி வருத்தும் அணங்கு, ஒரு சேனையையும் கொண்டு வந்து தாக்கினாற் போன்றது.","en":"This female beauty returning my looks is like a celestial maiden coming with an army to contend against me","lines":[{"t":"நோக்கினாள் நோக்கெதிர் நோக்குதல் தாக்கணங்கு","err":null,"seers":[{"w":"நோக்கினாள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நோக்"},{"k":"I","s":"கினாள்"}]},{"w":"நோக்கெதிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நோக்"},{"k":"I","s":"கெதிர்"}]},{"w":"நோக்குதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நோக்"},{"k":"I","s":"குதல்"}]},{"w":"தாக்கணங்கு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தாக்"},{"k":"I","s":"கணங்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தானைக்கொண் டன்ன துடைத்து.","err":null,"seers":[{"w":"தானைக்கொண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தா"},{"k":"N","s":"னைக்"},{"k":"N","s":"கொண்"}]},{"w":"டன்ன","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டன்"},{"k":"N","s":"ன"}]},{"w":"துடைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துடைத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1083,"ch":109,"l1":"பண்டறியேன் கூற்றென் பதனை இனியறிந்தேன்","l2":"பெண்டகையால் பேரமர்க் கட்டு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"எமன் என்று சொல்லப்படுவதை முன்பு அறியேன், இப்பொழுது கண்டறிந்தேன், அது பெண் தனமையுடன் போர் செய்யும் பெரிய கண்களை உடையது","en":"I never knew before what is called Yama; I see it now; it is the eyes that carry on a great fight with (the help of) female qualities","lines":[{"t":"பண்டறியேன் கூற்றென் பதனை இனியறிந்தேன்","err":null,"seers":[{"w":"பண்டறியேன்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பண்"},{"k":"I","s":"டறி"},{"k":"N","s":"யேன்"}]},{"w":"கூற்றென்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கூற்"},{"k":"N","s":"றென்"}]},{"w":"பதனை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பத"},{"k":"N","s":"னை"}]},{"w":"இனியறிந்தேன்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இனி"},{"k":"I","s":"யறிந்"},{"k":"N","s":"தேன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பெண்டகையால் பேரமர்க் கட்டு.","err":null,"seers":[{"w":"பெண்டகையால்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பெண்"},{"k":"I","s":"டகை"},{"k":"N","s":"யால்"}]},{"w":"பேரமர்க்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பே"},{"k":"I","s":"ரமர்க்"}]},{"w":"கட்டு.","name":"தேமா","cls":"