[{"n":21,"ch":3,"l1":"ஒழுக்கத்து நீத்தார் பெருமை விழுப்பத்து","l2":"வேண்டும் பனுவல் துணிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒழுக்கத்தில் நிலைத்து நின்று பற்று விட்டவர்களின் பெருமையைச் சிறந்ததாக போற்றி கூறுவதே நூல்களின் துணிவாகும்.","en":"The end and aim of all treatise is to extol beyond all other excellence, the greatness of those who, while abiding in the rule of conduct peculiar to their state, have abandoned all desire","lines":[{"t":"ஒழுக்கத்து நீத்தார் பெருமை விழுப்பத்து","err":null,"seers":[{"w":"ஒழுக்கத்து","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒழுக்"},{"k":"N","s":"கத்"},{"k":"N","s":"து"}]},{"w":"நீத்தார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீத்"},{"k":"N","s":"தார்"}]},{"w":"பெருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"மை"}]},{"w":"விழுப்பத்து","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விழுப்"},{"k":"N","s":"பத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேண்டும் பனுவல் துணிவு.","err":null,"seers":[{"w":"வேண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"பனுவல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பனு"},{"k":"N","s":"வல்"}]},{"w":"துணிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துணி"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":22,"ch":3,"l1":"துறந்தார் பெருமை துணைக்கூறின் வையத்து","l2":"இறந்தாரை எண்ணிக்கொண் டற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["கலித்தளை"],"mv":"பற்றுக்களைத் துறந்தவர்களின் பெருமையை அளந்து கூறுதல், உலகத்தில் இதுவரை பிறந்து இறந்தவர்களை கணக்கிடுவதைப்போன்றது.","en":"To describe the measure of the greatness of those who have forsaken the two-fold desires, is like counting the dead","lines":[{"t":"துறந்தார் பெருமை துணைக்கூறின் வையத்து","err":null,"seers":[{"w":"துறந்தார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துறந்"},{"k":"N","s":"தார்"}]},{"w":"பெருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"மை"}]},{"w":"துணைக்கூறின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துணைக்"},{"k":"N","s":"கூ"},{"k":"N","s":"றின்"}]},{"w":"வையத்து","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வை"},{"k":"N","s":"யத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இறந்தாரை எண்ணிக்கொண் டற்று.","err":null,"seers":[{"w":"இறந்தாரை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இறந்"},{"k":"N","s":"தா"},{"k":"N","s":"ரை"}]},{"w":"எண்ணிக்கொண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எண்"},{"k":"N","s":"ணிக்"},{"k":"N","s":"கொண்"}]},{"w":"டற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டற்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":23,"ch":3,"l1":"இருமை வகைதெரிந்து ஈண்டுஅறம் பூண்டார்","l2":"பெருமை பிறங்கிற்று உலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பிறப்பு வீடு என்பன போல் இரண்டிரண்டாக உள்ளவைகளின் கூறுபாடுகளை ஆராய்ந்தறிந்து அறத்தை மேற்கொண்டவரின் பெருமையே உலகத்தில் உயர்ந்தது","en":"The greatness of those who have discovered the properties of both states of being, and renounced the world, shines forth on earth (beyond all others)","lines":[{"t":"இருமை வகைதெரிந்து ஈண்டுஅறம் பூண்டார்","err":null,"seers":[{"w":"இருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இரு"},{"k":"N","s":"மை"}]},{"w":"வகைதெரிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வகை"},{"k":"I","s":"தெரிந்"},{"k":"N","s":"து"}]},{"w":"ஈண்டுஅறம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஈண்"},{"k":"I","s":"டுஅ"},{"k":"N","s":"றம்"}]},{"w":"பூண்டார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பூண்"},{"k":"N","s":"டார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பெருமை பிறங்கிற்று உலகு.","err":null,"seers":[{"w":"பெருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"மை"}]},{"w":"பிறங்கிற்று","name":"புளிமா