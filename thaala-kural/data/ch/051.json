[{"n":501,"ch":51,"l1":"அறம்பொருள் இன்பம் உயிரச்சம் நான்கின்","l2":"திறந்தெரிந்து தேறப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறம், பொருள், இன்பம், உயிர்காக அஞ்சும் அச்சம் ஆகிய நான்கு வகையாலும் ஆராயப்பட்ட பிறகே ஒருவன் (ஒரு தொழிலுக்கு உரியவனாகத்) தெளியப்படுவான்.","en":"Let (a minister) be chosen, after he has been tried by means of these four things, viz,-his virtue, (love of) money, (love of) sexual pleasure, and tear of (losing) life","lines":[{"t":"அறம்பொருள் இன்பம் உயிரச்சம் நான்கின்","err":null,"seers":[{"w":"அறம்பொருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறம்"},{"k":"I","s":"பொருள்"}]},{"w":"இன்பம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"பம்"}]},{"w":"உயிரச்சம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உயி"},{"k":"N","s":"ரச்"},{"k":"N","s":"சம்"}]},{"w":"நான்கின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நான்"},{"k":"N","s":"கின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"திறந்தெரிந்து தேறப் படும்.","err":null,"seers":[{"w":"திறந்தெரிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"திறந்"},{"k":"I","s":"தெரிந்"},{"k":"N","s":"து"}]},{"w":"தேறப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தே"},{"k":"N","s":"றப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":502,"ch":51,"l1":"குடிப்பிறந்து குற்றத்தின் நீங்கி வடுப்பரியும்","l2":"நாணுடையான் சுட்டே தெளிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"நல்லகுடியில் பிறந்து குற்றங்களிலிருந்து நீங்கிப் பழியாச் செயல்களைச் செய்ய அஞ்சுகின்ற நாணம் உடையவனையே நம்பித் தெளிய வேண்டும்.","en":"(The king's) choice should (fall) on him, who is of good family, who is free from faults, and who has the modesty which fears the wounds (of sin)","lines":[{"t":"குடிப்பிறந்து குற்றத்தின் நீங்கி வடுப்பரியும்","err":null,"seers":[{"w":"குடிப்பிறந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குடிப்"},{"k":"I","s":"பிறந்"},{"k":"N","s":"து"}]},{"w":"குற்றத்தின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"குற்"},{"k":"N","s":"றத்"},{"k":"N","s":"தின்"}]},{"w":"நீங்கி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீங்"},{"k":"N","s":"கி"}]},{"w":"வடுப்பரியும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வடுப்"},{"k":"I","s":"பரி"},{"k":"N","s":"யும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நாணுடையான் சுட்டே தெளிவு.","err":null,"seers":[{"w":"நாணுடையான்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"I","s":"ணுடை"},{"k":"N","s":"யான்"}]},{"w":"சுட்டே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சுட்"},{"k":"N","s":"டே"}]},{"w":"தெளிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தெளி"},{"k":"N","s":"வு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":503,"ch":51,"l1":"அரியகற்று ஆசற்றார் கண்ணும் தெரியுங்கால்","l2":"இன்மை அரிதே வெளிறு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அரிய நூல்களைத் கற்றுத் தேர்ந்து குற்றம் அற்றவரிடத்திலும் ஆராய்ந்துப் பார்க்குமிடத்தில் அறியாமை இல்லாதிருப்பது அருமையாகும்.","en":"When even men, who have studied the most difficult works, and who are free from faults, are (carefully) examined, it is a rare thing to find them without ignorance","lines":[{"t":"அரியகற்று ஆசற்றார் கண்ணும் தெரியுங்கால்","err":null,"seers":[{"w":"அரியகற்று","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அரி"},{"k":"I","s":"யகற்"},{"k":"N","s":"று"}]},{"w":"ஆசற்றார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"சற்"},{"k":"N","s":"றார்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"தெரியுங்கால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தெரி"},{"k":"N","s":"யுங்"},{"k":"N","s":"கால்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இன்மை அரிதே வெளிறு.","err":null,"seers":[{"w":"இன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"}]},{"w":"அரிதே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"தே"}]},{"w":"வெளிறு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வெளி"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":504,"ch":51,"l1":"குணம்நாடிக் குற்றமும் நாடி அவற்றுள்","l2":"மிகைநாடி மிக்க கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவனுடைய குணங்களை ஆராய்ந்து, பிறகு குற்றங்களையும் ஆராய்ந்து, மிகுதியானவை எவையென ஆராய்ந்து, மிகுந்திப்பவற்றால் தெளிந்து கொள்ள வேண்டும்.","en":"Let (a king) consider (a man's) good qualities, as well as his faults, and then judge (of his character) by that which prevails","lines":[{"t":"குணம்நாடிக் குற்றமும் நாடி அவற்றுள்","err":null,"seers":[{"w":"குணம்நாடிக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குணம்"},{"k":"N","s":"நா"},{"k":"N","s":"டிக்"}]},{"w":"குற்றமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"குற்"},{"k":"I","s":"றமும்"}]},{"w":"நாடி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டி"}]},{"w":"அவற்றுள்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அவற்"},{"k":"N","s":"றுள்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மிகைநாடி மிக்க கொளல்.","err":null,"seers":[{"w":"மிகைநாடி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மிகை"},{"k":"N","s":"நா"},{"k":"N","s":"டி"}]},{"w":"மிக்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மிக்"},{"k":"N","s":"க"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":505,"ch":51,"l1":"பெருமைக்கும் ஏனைச் சிறுமைக்கும் தத்தம்","l2":"கருமமே கட்டளைக் கல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"(மக்களுடைய குணங்களாலாகிய) பெருமைக்கும் (குற்றங்களாலாகிய) சிறுமைக்கும் தேர்ந்தறியும் உரைக் கல்லாக இருப்பவை அவரவருடைய செயல்களே ஆகும்.","en":"A man's deeds are the touchstone of his greatness and littleness","lines":[{"t":"பெருமைக்கும் ஏனைச் சிறுமைக்கும் தத்தம்","err":null,"seers":[{"w":"பெருமைக்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"மைக்"},{"k":"N","s":"கும்"}]},{"w":"ஏனைச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"னைச்"}]},{"w":"சிறுமைக்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறு"},{"k":"N","s":"மைக்"},{"k":"N","s":"கும்"}]},{"w":"தத்தம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தத்"},{"k":"N","s":"தம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கருமமே கட்டளைக் கல்.","err":null,"seers":[{"w":"கருமமே","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரு"},{"k":"I","s":"மமே"}]},{"w":"கட்டளைக்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கட்"},{"k":"I","s":"டளைக்"}]},{"w":"கல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":506,"ch":51,"l1":"அற்றாரைத் தேறுதல் ஓம்புக மற்றவர்","l2":"பற்றிலர் நாணார் பழி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"சுற்றத்தாறின் தெடர்பு அற்றவரை நம்பித் தெளியக்கூடாது, அவர் உலகத்தில் பற்று இல்லாதவராகையால் பழிக்கு நாண மாட்டார்.","en":"Let (a king) avoid choosing men who have no relations; such men have no attachment, and thereforehave no fear of crime","lines":[{"t":"அற்றாரைத் தேறுதல் ஓம்புக மற்றவர்","err":null,"seers":[{"w":"அற்றாரைத்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அற்"},{"k":"N","s":"றா"},{"k":"N","s":"ரைத்"}]},{"w":"தேறுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தே"},{"k":"I","s":"றுதல்"}]},{"w":"ஓம்புக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஓம்"},{"k":"I","s":"புக"}]},{"w":"மற்றவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மற்"},{"k":"I","s":"றவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பற்றிலர் நாணார் பழி.","err":null,"seers":[{"w":"பற்றிலர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ப