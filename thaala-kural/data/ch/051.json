":"தேமா","cls":"மா","a":[{"k":"N","s":"தே"},{"k":"N","s":"ரான்"}]},{"w":"பிறனைத்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிற"},{"k":"N","s":"னைத்"}]},{"w":"தெளிந்தான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தெளிந்"},{"k":"N","s":"தான்"}]},{"w":"வழிமுறை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வழி"},{"k":"I","s":"முறை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தீரா இடும்பை தரும்.","err":null,"seers":[{"w":"தீரா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"ரா"}]},{"w":"இடும்பை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடும்"},{"k":"N","s":"பை"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":509,"ch":51,"l1":"தேறற்க யாரையும் தேராது தேர்ந்தபின்","l2":"தேறுக தேறும் பொருள்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"யாரையும் ஆராயாமல் தெளியக்கூடாது, நன்றாக ஆராய்ந்த பின்னர் அவரிடம் தெளிவாகக் கொள்ளத்தக்க பொருள்களைத் தெளிந்து நம்ப வேண்டும்.","en":"Let (a king) choose no one without previous consideration; after he has made his choice, let him unhesitatingly select for each such duties as are appropriate","lines":[{"t":"தேறற்க யாரையும் தேராது தேர்ந்தபின்","err":null,"seers":[{"w":"தேறற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தே"},{"k":"N","s":"றற்"},{"k":"N","s":"க"}]},{"w":"யாரையும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"N","s":"ரை"},{"k":"N","s":"யும்"}]},{"w":"தேராது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தே"},{"k":"N","s":"ரா"},{"k":"N","s":"து"}]},{"w":"தேர்ந்தபின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தேர்ந்"},{"k":"I","s":"தபின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தேறுக தேறும் பொருள்.","err":null,"seers":[{"w":"தேறுக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தே"},{"k":"I","s":"றுக"}]},{"w":"தேறும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தே"},{"k":