[{"n":1051,"ch":106,"l1":"இரக்க இரத்தக்கார்க் காணின் கரப்பின்","l2":"அவர்பழி தம்பழி அன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"இரந்து கேட்க தக்கவரைக் கண்டால் அவனிடம் இரக்க வேண்டும், அவர் இல்லை என்று ஒளிப்பாரானால் அது அவர்க்கு பழி, தமக்கு பழி அன்று.","en":"If you meet with those that may be begged of, you may beg; (but) if they withhold (their gift) it is their blame and not yours","lines":[{"t":"இரக்க இரத்தக்கார்க் காணின் கரப்பின்","err":null,"seers":[{"w":"இரக்க","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இரக்"},{"k":"N","s":"க"}]},{"w":"இரத்தக்கார்க்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இரத்"},{"k":"N","s":"தக்"},{"k":"N","s":"கார்க்"}]},{"w":"காணின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணின்"}]},{"w":"கரப்பின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரப்"},{"k":"N","s":"பின்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அவர்பழி தம்பழி அன்று.","err":null,"seers":[{"w":"அவர்பழி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அவர்"},{"k":"I","s":"பழி"}]},{"w":"தம்பழி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தம்"},{"k":"I","s":"பழி"}]},{"w":"அன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1052,"ch":106,"l1":"இன்பம் ஒருவற்கு இரத்தல் இரந்தவை","l2":"துன்பம் உறாஅ வரின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இரந்து கேட்ட பொருள் துன்பமுறாமல் கிடைக்குமானால், அவ்வாறு இரத்தலும் இன்பம் என்று சொல்லத் தக்கதாகும்.","en":"Even begging may be pleasant, if what is begged for is obtained without grief (to him that begs)","lines":[{"t":"இன்பம் ஒருவற்கு இரத்தல் இரந்தவை","err":null,"seers":[{"w":"இன்பம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"பம்"}]},{"w":"ஒருவற்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வற்"},{"k":"N","s":"கு"}]},{"w":"இரத்தல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இரத்"},{"k":"N","s":"தல்"}]},{"w":"இரந்தவை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இரந்"},{"k":"I","s":"தவை"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"துன்பம் உறாஅ வரின்.","err":null,"seers":[{"w":"துன்பம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"துன்"},{"k":"N","s":"பம்"}]},{"w":"உறாஅ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உறா"},{"k":"N","s":"அ"}]},{"w":"வரின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வரின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1053,"ch":106,"l1":"கரப்பிலா நெஞ்சின் கடனறிவார் முன்நின்று","l2":"இரப்புமோ ரேஎர் உடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["கலித்தளை"],"mv":"ஒளிப்பு இல்லாத நெஞ்சும், கடைமையுணர்ச்சியும், உள்ளவரின் முன்னே நின்று இரந்து பொருள் கேட்பதும் ஓர் அழகு உடையதாகும்.","en":"There is even a beauty in standing before and begging of those who are liberal in their gifts and understand their duty (to beggars)","lines":[{"t":"கரப்பிலா நெஞ்சின் கடனறிவார் முன்நின்று","err":null,"seers":[{"w":"கரப்பிலா","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரப்"},{"k":"I","s":"பிலா"}]},{"w":"நெஞ்சின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சின்"}]},{"w":"கடனறிவார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கட"},{"k":"I","s":"னறி"},{"k":"N","s":"வார்"}]},{"w":"முன்நின்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"முன்"},{"k":"N","s":"நின்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இரப்புமோ ரேஎர் உடைத்து.","err":null,"seers":[{"w":"இரப்புமோ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இரப்"},{"k":"I","s":"புமோ"}]},{"w":"ரேஎர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ரே"},{"k":"N","s":"எர்"}]},{"w":"உடைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடைத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1054,"ch":106,"l1":"இரத்தலும் ஈதலே போலும் கரத்தல்","l2":"கனவிலும் தேற்றாதார் மாட்டு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"உள்ளதை மறைத்துக் கூறும் தன்மையைக் கனவிலும் அறியாதவரிடத்தில் இரந்து கேட்பதும் பிறர்க்கு கொடுப்பதைப் போன்ற சிறப்புடையது.","en":"To beg of such as never think of withholding (their charity) even in their dreams, is in fact the same as giving (it oneself);","lines":[{"t":"இரத்தலும் ஈதலே போலும் கரத்தல்","err":null,"seers":[{"w":"இரத்தலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இரத்"},{"k":"I","s":"தலும்"}]},{"w":"ஈதலே","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஈ"},{"k":"I","s":"தலே"}]},{"w":"போலும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"லும்"}]},{"w":"கரத்தல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரத்"},{"k":"N","s":"தல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கனவிலும் தேற்றாதார் மாட்டு.","err":null,"seers":[{"w":"கனவிலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கன"},{"k":"I","s":"விலும்"}]},{"w":"தேற்றாதார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தேற்"},{"k":"N","s":"றா"},{"k":"N","s":"தார்"}]},{"w":"மாட்டு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாட்"},{"k":"N","s":"டு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1055,"ch":106,"l1":"கரப்பிலார் வையகத்து உண்மையால் கண்ணின்று","l2":"இரப்பவர் மேற்கொள் வது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["கலித்தளை"],"mv":"ஒருவர் முன் நின்று இரப்பவர் அந்த இரத்தலை மேற்கொள்வது, உள்ளதை இல்லை என்று ஒளித்துக்கூறாத நன்மைகள் உலகத்தில் இருப்பதால் தான்.","en":"As there are in the world those that give without refusing, there are (also) those that prefer to beg by simply standing before them","lines":[{"t":"கரப்பிலார் வையகத்து உண்மையால் கண்ணின்று","err":null,"seers":[{"w":"கரப்பிலார்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரப்"},{"k":"I","s":"பிலார்"}]},{"w":"வையகத்து","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வை"},{"k":"I","s":"யகத்"},{"k":"N","s":"து"}]},{"w":"உண்மையால்"