[{"n":511,"ch":52,"l1":"நன்மையும் தீமையும் நாடி நலம்புரிந்த","l2":"தன்மையான் ஆளப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நன்மையும் தீமையுமாகிய இரண்டையும் ஆராய்ந்து நன்மை தருகின்றவற்றையே விரும்புகின்ற இயல்புடையவன் (செயலுக்கு உரியவனாக) ஆளப்படுவான்.","en":"He should be employed (by a king), whose nature leads him to choose the good, after having weighed both the evil and the good in any undertaking","lines":[{"t":"நன்மையும் தீமையும் நாடி நலம்புரிந்த","err":null,"seers":[{"w":"நன்மையும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"தீமையும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தீ"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"நாடி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டி"}]},{"w":"நலம்புரிந்த","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நலம்"},{"k":"I","s":"புரிந்"},{"k":"N","s":"த"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தன்மையான் ஆளப் படும்.","err":null,"seers":[{"w":"தன்மையான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தன்"},{"k":"N","s":"மை"},{"k":"N","s":"யான்"}]},{"w":"ஆளப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"ளப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":512,"ch":52,"l1":"வாரி பெருக்கி வளம்படுத்து உற்றவை","l2":"ஆராய்வான் செய்க வினை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொருள் வரும் வழிகளைப் பெருக்கச் செய்து, அவற்றால் வளத்தை உண்டாக்கி, வரும் இடையூறுகளைஆராய்ந்து நீக்க வல்லவனே செயல் செய்ய வேண்டும்.","en":"Let him do (the king's) work who can enlarge the sources (of revenue), increase wealth and considerately prevent the accidents (which would destroy it)","lines":[{"t":"வாரி பெருக்கி வளம்படுத்து உற்றவை","err":null,"seers":[{"w":"வாரி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ரி"}]},{"w":"பெருக்கி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெருக்"},{"k":"N","s":"கி"}]},{"w":"வளம்படுத்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வளம்"},{"k":"I","s":"படுத்"},{"k":"N","s":"து"}]},{"w":"உற்றவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உற்"},{"k":"I","s":"றவை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஆராய்வான் செய்க வினை.","err":null,"seers":[{"w":"ஆராய்வான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"ராய்"},{"k":"N","s":"வான்"}]},{"w":"செய்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"க"}]},{"w":"வினை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வினை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":513,"ch":52,"l1":"அன்பறிவு தேற்றம் அவாவின்மை இந்நான்கும்","l2":"நன்குடையான் கட்டே தெளிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அன்பு, அறிவு, ஐயமில்லாமல் தெளியும் ஆற்றல், அவா இல்லாமை ஆகிய இந் நான்கு பண்புகளையும் நிலையாக உடையவனைத் தெளியலாம்.","en":"Let the choice (of a king) fall upon him who largely possesses these four things, love, knowledge, a clear mind and freedom from covetousness","lines":[{"t":"அன்பறிவு தேற்றம் அவாவின்மை இந்நான்கும்","err":null,"seers":[{"w":"அன்பறிவு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"அன்"},{"k":"I","s":"பறி"},{"k":"N","s":"வு"}]},{"w":"தேற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தேற்"},{"k":"N","s":"றம்"}]},{"w":"அவாவின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவா"},{"k":"N","s":"வின்"},{"k":"N","s":"மை"}]},{"w":"இந்நான்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இந்"},{"k":"N","s":"நான்"},{"k":"N","s":"கும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நன்குடையான் கட்டே தெளிவு.","err":null,"seers":[{"w":"நன்குடையான்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"I","s":"குடை"},{"k":"N","s":"யான்"}]},{"w":"கட்டே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கட்"},{"k":"N","s":"டே"}]},{"w":"தெளிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தெளி"},{"k":"N","s":"வு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":514,"ch":52,"l1":"எனைவகையான் தேறியக் கண்ணும் வினைவகையான்","l2":"வேறாகும் மாந்தர் பலர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"எவ்வகையால் ஆராய்ந்து தெளிந்த பிறகும்(செயலை மேற்க்கொண்டு செய்யும் போது) அச் செயல்வகையால் வேறுபடும் மக்கள் உலகத்தில் பலர் உண்டு.","en":"Even when (a king) has tried them in every possible way, there are many men who change, from the nature of the works (in which they may be employed)","lines":[{"t":"எனைவகையான் தேறியக் கண்ணும் வினைவகையான்","err":null,"seers":[{"w":"எனைவகையான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"எனை"},{"k":"I","s":"வகை"},{"k":"N","s":"யான்"}]},{"w":"தேறியக்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தே"},{"k":"I","s":"றியக்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"வினைவகையான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வினை"},{"k":"I","s":"வகை"},{"k":"N","s":"யான்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேறாகும் மாந்தர் பலர்.","err":null,"seers":[{"w":"வேறாகும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"றா"},{"k":"N","s":"கும்"}]},{"w":"மாந்தர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாந்"},{"k":"N","s":"தர்"}]},{"w":"பலர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பலர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":515,"ch":52,"l1":"அறிந்தாற்றிச் செய்கிற்பாற்கு அல்லால் வினைதான்","l2":"சிறந்தானென்று ஏவற்பாற் றன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"(செய்யும் வழிகளை) அறிந்து இடையூறுகளைத்தாங்கிச் செய்து முடிக்க வல்லவனை அல்லாமல், மற்றவனைச் சிறந்தவன் என்றுக் கருதி ஒருச் செயலைச் செய்யுமாறு ஏவக்கூடாது.","en":"(A king's) work can only be accomplished by a man of wisdom and patient endurance; 