[{"n":231,"ch":24,"l1":"ஈதல் இசைபட வாழ்தல் அதுவல்லது","l2":"ஊதியம் இல்லை உயிர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["ஒன்றிய வஞ்சித்தளை"],"mv":"வறியவர்க்கு ஈதல் வேண்டும் அதனால் புகழ் உண்டாக வாழ வேண்டும், அப் புகழ் அல்லாமல் உயிர்க்கு ஊதியமானது வேறொன்றும் இல்லை.","en":"Give to the poor and live with praise There is no greater profit to man than that","lines":[{"t":"ஈதல் இசைபட வாழ்தல் அதுவல்லது","err":null,"seers":[{"w":"ஈதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"தல்"}]},{"w":"இசைபட","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இசை"},{"k":"I","s":"பட"}]},{"w":"வாழ்தல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"தல்"}]},{"w":"அதுவல்லது","name":"புளிமாங்கனி","cls":"கனி","a":[{"k":"I","s":"அது"},{"k":"N","s":"வல்"},{"k":"I","s":"லது"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஊதியம் இல்லை உயிர்க்கு.","err":null,"seers":[{"w":"ஊதியம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"தியம்"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"உயிர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயிர்க்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":232,"ch":24,"l1":"உரைப்பார் உரைப்பவை எல்லாம் இரப்பார்க்கொன்று","l2":"ஈவார்மேல் நிற்கும் புகழ்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":[null],"mv":"புகழ்ந்து சொல்கின்றவர் சொல்பவை எல்லாம் வறுமையால் இரப்பவர்க்கு ஒரு பொருள் கொடுத்து உதவுகின்றவரின் மேல் நிற்கின்ற புகழேயாகும்.","en":"Whatsoever is spoken in the world will abide as praise upon that man who gives alms to the poor","lines":[{"t":"உரைப்பார் உரைப்பவை எல்லாம் இரப்பார்க்கொன்று","err":null,"seers":[{"w":"உரைப்பார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உரைப்"},{"k":"N","s":"பார்"}]},{"w":"உரைப்பவை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உரைப்"},{"k":"I","s":"பவை"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"இரப்பார்க்கொன்று","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"இரப்"},{"k":"N","s":"பார்க்"},{"k":"N","s":"கொன்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஈவார்மேல் நிற்கும் புகழ்.","err":null,"seers":[{"w":"ஈவார்மேல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"வார்"},{"k":"N","s":"மேல்"}]},{"w":"நிற்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நிற்"},{"k":"N","s":"கும்"}]},{"w":"புகழ்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"புகழ்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":233,"ch":24,"l1":"ஒன்றா உலகத்து உயர்ந்த புகழல்லால்","l2":"பொன்றாது நிற்பதொன் றில்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உயர்ந்த புகழ் அல்லாமல் உலகத்தில் ஒப்பற்ற ஒரு பொருளாக அழியாமல் நிலைநிற்க வல்லது வேறொன்றும் இல்லை.","en":"There is nothing that stands forth in the world imperishable, except fame, exalted in solitary greatness","lines":[{"t":"ஒன்றா உலகத்து உயர்ந்த புகழல்லால்","err":null,"seers":[{"w":"ஒன்றா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒன்"},{"k":"N","s":"றா"}]},{"w":"உலகத்து","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உல"},{"k":"N","s":"கத்"},{"k":"N","s":"து"}]},{"w":"உயர்ந்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயர்ந்"},{"k":"N","s":"த"}]},{"w":"புகழல்லால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"புக"},{"k":"N","s":"ழல்"},{"k":"N","s":"லால்"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"பொன்றாது நிற்பதொன் றில்.","err":null,"seers":[{"w":"பொன்றாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொன்"},{"k":"N","s":"றா"},{"k":"N","s":"து"}]},{"w":"நிற்பதொன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நிற்"},{"k":"I","s":"பதொன்"}]},{"w":"றில்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"றில்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":234,"ch":24,"l1":"நிலவரை நீள்புகழ் ஆற்றின் புலவரைப்","l2":"போற்றாது புத்தேள் உலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நிலவுலகின் எல்லையில் நெடுங்காலம் நிற்கவல்ல புகழைச் செய்தால், வானுலகம் (அவ்வாறு புகழ் செய்தாரைப் போற்றுமே அல்லாமல்) தேவரைப் போற்றாது..","en":"If one has acquired extensive fame within the limits of this earth, the world of the Gods will no longer praise those sages who have attained that world","lines":[{"t":"நிலவரை நீள்புகழ் ஆற்றின் புலவரைப்","err":null,"seers":[{"w":"நிலவரை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நில"},{"k":"I","s":"வரை"}]},{"w":"நீள்புகழ்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீள்"},{"k":"I","s":"புகழ்"}]},{"w":"ஆற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றின்"}]},{"w":"புலவரைப்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"புல"},{"k":"I","s":"வரைப்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"போற்றாது புத்தேள் உலகு.","err":null,"seers":[{"w":"போற்றாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றா"},{"k":"N","s":"து"}]},{"w":"புத்தேள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"புத்"},{"k":"N","s":"தேள்"}]},{"w":"உலகு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உல"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":235,"ch":24,"l1":"நத்தம்போல் கேடும் உளதாகும் சாக்காடும்","l2":"வித்தகர்க் கல்லால் அரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"புகழுடம்பு மேம்படுதலாகும் வாழ்வில் கேடும், புகழ் நிலை நிற்பதாகும் சாவும் அறிவில் சிறந்தவர்க்கு அல்லாமல் மற்றவர்க்கு இல்லை.","en":"Prosperity to the body of fame, resulting in poverty to the body of flesh and the stability to the former arising from the death of the latter, are achievable only by the wise","lines":[{"t":"நத்தம்போல் கேடும் உளதாகும் சாக்காடும்","err":null,"seers":[{"w":"நத்தம்போல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நத்"},{"k":"N","s":"தம்"},{"k":"N","s":"போல்"}]},{"w":"கேடும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கே"},{"k":"N","s":"டும்"}]},{"w":"உளதாகும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உள"},{"k":"N","s":"தா"},{"k":"N","s":"கும்"}]},{"w":"சாக்காடும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சாக்"},{"k":"N","s":"கா"},{"k":"N","s":"டும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வித்தகர்க் கல்லால் அரிது.","err":null,"seers":[{"w":"வித்தகர்க்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வித்"},{"k":"I","s":"தகர்க்"}]},{"w":"கல்லால்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லால்"}]},{"w":"அரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":236,"ch":24,"l1":"தோன்றின் புகழொடு தோன்றுக அஃதிலார்","l2":"தோன்றலின் தோன்றாமை நன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒரு துறையில் முற்பட்டுத் தோன்றுவதானால் புகழோடு தோன்ற வேண்டும், அத்தகைய சிறப்பு இல்லாதவர் அங்குத் தோன்றுவதைவிடத் தோன்றாமலிருப்பதே நல்லது.","en":"If you are born (in this world), be born with qualities conductive to fame From those who are destitute of them it will be better not to be born","lines":[{"t":"தோன்றின் புகழொடு தோன்றுக அஃதிலார்","err":null,"seers":[{"w":"தோன்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோன்"},{"k":"N","s":"றின்"}]},{"w":"புகழொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"புக"},{"k":"I","s":"ழொடு"}]},{"w":"தோன்றுக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தோன்"},{"k":"I","s":"றுக"}]},{"w":"அஃதிலார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஃ"},{"k":"I","s":"திலார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தோன்றலின் தோன்றாமை நன்று.","err":null,"seers":[{"w":"தோன்றலின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தோன்"},{"k":"I","s":"றலின்"}]},{"w":"தோன்றாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தோன்"},{"k":"N","s":"றா"},{"k":"N","s":"மை"}]},{"w":"நன்று.","n