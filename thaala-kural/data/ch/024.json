ை"]}]},{"n":240,"ch":24,"l1":"வசையொழிய வாழ்வாரே வாழ்வார் இசையொழிய","l2":"வாழ்வாரே வாழா தவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தாம் வாழும் வாழ்க்கையில் பழி உண்டாகாமல் வாழ்கின்றவரே உயிர் வாழ்கின்றவர், புகழ் உண்டாகாமல் வாழ்கின்றவரே உயிர் வாழாதவர்.","en":"Those live who live without disgrace Those who live without fame live not","lines":[{"t":"வசையொழிய வாழ்வாரே வாழ்வார் இசையொழிய","err":null,"seers":[{"w":"வசையொழிய","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வசை"},{"k":"I","s":"யொழி"},{"k":"N","s":"ய"}]},{"w":"வாழ்வாரே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"வா"},{"k":"N","s":"ரே"}]},{"w":"வாழ்வார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"வார்"}]},{"w":"இசையொழிய","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இசை"},{"k":"I","s":"யொழி"},{"k":"N","s":"ய"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வாழ்வாரே வாழா தவர்.","err":null,"seers":[{"w":"வாழ்வாரே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"வா"},{"k":"N","s":"ரே"}]},{"w":"வாழா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ழா"}]},{"w":"தவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]