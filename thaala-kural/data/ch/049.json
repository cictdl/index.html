[{"n":481,"ch":49,"l1":"பகல்வெல்லும் கூகையைக் காக்கை இகல்வெல்லும்","l2":"வேந்தர்க்கு வேண்டும் பொழுது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"காக்கை தன்னைவிட வலிய கோட்டானைப் பகலில் வென்றுவிடும், அதுபோல் பகையை வெல்லக்கருதும் அரசர்க்கும் அதற்கு ஏற்ற காலம் வேண்டும்.","en":"A crow will overcome an owl in the day time; so the king who would conquer his enemy must have (a suitable) time","lines":[{"t":"பகல்வெல்லும் கூகையைக் காக்கை இகல்வெல்லும்","err":null,"seers":[{"w":"பகல்வெல்லும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பகல்"},{"k":"N","s":"வெல்"},{"k":"N","s":"லும்"}]},{"w":"கூகையைக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கூ"},{"k":"N","s":"கை"},{"k":"N","s":"யைக்"}]},{"w":"காக்கை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காக்"},{"k":"N","s":"கை"}]},{"w":"இகல்வெல்லும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இகல்"},{"k":"N","s":"வெல்"},{"k":"N","s":"லும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேந்தர்க்கு வேண்டும் பொழுது.","err":null,"seers":[{"w":"வேந்தர்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"தர்க்"},{"k":"N","s":"கு"}]},{"w":"வேண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"பொழுது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொழு"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":482,"ch":49,"l1":"பருவத்தோடு ஒட்ட ஒழுகல் திருவினைத்","l2":"தீராமை ஆர்க்குங் கயிறு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"காலத்தோடுப் பொருந்துமாறு ஆராய்ந்து நடத்தல் ( நில்லாத இயல்பு உடைய) செல்வத்தை நீங்காமல் நிற்குமாறு கட்டும் கயிறாகும்.","en":"Acting at the right season, is a cord that will immoveably bind success (to a king)","lines":[{"t":"பருவத்தோடு ஒட்ட ஒழுகல் திருவினைத்","err":null,"seers":[{"w":"பருவத்தோடு","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"பரு"},{"k":"N","s":"வத்"},{"k":"N","s":"தோ"},{"k":"N","s":"டு"}]},{"w":"ஒட்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒட்"},{"k":"N","s":"ட"}]},{"w":"ஒழுகல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழு"},{"k":"N","s":"கல்"}]},{"w":"திருவினைத்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"திரு"},{"k":"I","s":"வினைத்"}]}],"thalai":[null,"இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தீராமை ஆர்க்குங் கயிறு.","err":null,"seers":[{"w":"தீராமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தீ"},{"k":"N","s":"ரா"},{"k":"N","s":"மை"}]},{"w":"ஆர்க்குங்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆர்க்"},{"k":"N","s":"குங்"}]},{"w":"கயிறு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கயி"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":483,"ch":49,"l1":"அருவினை யென்ப உளவோ கருவியான்","l2":"காலம் அறிந்து செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"(செய்யும் செயலை முடிப்பதற்கு வேண்டிய) கருவிகளுடன் ஏற்றக் காலத்தையும் அறிந்து செய்தால் அரிய செயல்கள் என்பது உண்டோ.","en":"Is there anything difficult for him to do, who acts, with (the right) instruments at the right time ?","lines":[{"t":"அருவினை யென்ப உளவோ கருவியான்","err":null,"seers":[{"w":"அருவினை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அரு"},{"k":"I","s":"வினை"}]},{"w":"யென்ப","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யென்"},{"k":"N","s":"ப"}]},{"w":"உளவோ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உள"},{"k":"N","s":"வோ"}]},{"w":"கருவியான்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரு"},{"k":"I","s":"வியான்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"காலம் அறிந்து செயின்.","err":null,"seers":[{"w":"காலம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"லம்"}]},{"w":"அறிந்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறிந்"},{"k":"N","s":"து"}]},{"w":"செயின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":484,"ch":49,"l1":"ஞாலம் கருதினுங் கைகூடுங் காலம்","l2":"கருதி இடத்தாற் செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"(செயலை முடிப்பதற்கு ஏற்ற) காலத்தை அறிந்து இடத்தோடு பொருந்துமாறு செய்தால், உலகமே வேண்டும் எனக் கருதினாலும் கைகூடும்.","en":"Though (a man) should meditate (the conquest of) the world, he may accomplish it if he acts in the right time, and at the right place","lines":[{"t":"ஞாலம் கருதினுங் கைகூடுங் காலம்","err":null,"seers":[{"w":"ஞாலம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஞா"},{"k":"N","s":"லம்"}]},{"w":"கருதினுங்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரு"},{"k":"I","s":"தினுங்"}]},{"w":"கைகூடுங்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கை"},{"k":"N","s":"கூ"},{"k":"N","s":"டுங்"}]},{"w":"காலம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"லம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கருதி இடத்தாற் செயின்.","err":null,"seers":[{"w":"கருதி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரு"},{"k":"N","s":"தி"}]},{"w":"இடத்தாற்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடத்"},{"k":"N","s":"தாற்"}]},{"w":"செயின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":485,"ch":49,"l1":"காலம் கருதி இருப்பர் கலங்காது","l2":"ஞாலம் கருது பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உலகத்தைக் கொள்ளக் கருதிகின்றவர் அதைப்பற்றி எண்ணிக் கலங்காமல் அதற்கு ஏற்ற காலத்தைக் கருதிக்கொண்டு பொறுத்திருப்பர்.","en":"They who thoughtfully consider and wait for the (right) time (for action), may successfully meditate (the conquest of) the world","lines":[{"t":"காலம் கருதி இருப்பர் கலங்காது","err":null,"seers":[{"w":"காலம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"லம்"}]},{"w":"கருதி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரு"},{"k":"N","s":"தி"}]},{"w":"இருப்பர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இருப்"},{"k":"N","s":"பர்"}]},{