[{"n":561,"ch":57,"l1":"தக்காங்கு நாடித் தலைச்செல்லா வண்ணத்தால்","l2":"ஒத்தாங்கு ஒறுப்பது வேந்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"செய்த குற்றத்தை தக்கவாறு ஆராய்ந்து மீண்டும் அக் குற்றம் செய்யாத படி குற்றத்திற்குப் பொருந்துமாறு தண்டிப்பவனே அரசன் ஆவான்.","en":"He is a king who having equitably examined (any injustice which has been brought to his notice), suitably punishes it, so that it may not be again committed","lines":[{"t":"தக்காங்கு நாடித் தலைச்செல்லா வண்ணத்தால்","err":null,"seers":[{"w":"தக்காங்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தக்"},{"k":"N","s":"காங்"},{"k":"N","s":"கு"}]},{"w":"நாடித்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டித்"}]},{"w":"தலைச்செல்லா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தலைச்"},{"k":"N","s":"செல்"},{"k":"N","s":"லா"}]},{"w":"வண்ணத்தால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வண்"},{"k":"N","s":"ணத்"},{"k":"N","s":"தால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஒத்தாங்கு ஒறுப்பது வேந்து.","err":null,"seers":[{"w":"ஒத்தாங்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒத்"},{"k":"N","s":"தாங்"},{"k":"N","s":"கு"}]},{"w":"ஒறுப்பது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"ஒறுப்"},{"k":"I","s":"பது"}]},{"w":"வேந்து.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"து"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":562,"ch":57,"l1":"கடிதோச்சி மெல்ல எறிக நெடிதாக்கம்","l2":"நீங்காமை வேண்டு பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஆக்கம் நெடுங்காலம் நீங்காமலிருக்க விரும்புகின்றவர் (தண்டிக்கத் தொடங்கும் போது) அளவு கடந்து செய்வது போல் காட்டி அளவு மீறாமல் முறை செய்ய வேண்டும்.","en":"Let the king, who desires that his prosperity may long remain, commence his preliminary enquires with strictness, and then punish with mildness","lines":[{"t":"கடிதோச்சி மெல்ல எறிக நெடிதாக்கம்","err":null,"seers":[{"w":"கடிதோச்சி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கடி"},{"k":"N","s":"தோச்"},{"k":"N","s":"சி"}]},{"w":"மெல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மெல்"},{"k":"N","s":"ல"}]},{"w":"எறிக","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"எறி"},{"k":"N","s":"க"}]},{"w":"நெடிதாக்கம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நெடி"},{"k":"N","s":"தாக்"},{"k":"N","s":"கம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நீங்காமை வேண்டு பவர்.","err":null,"seers":[{"w":"நீங்காமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நீங்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"வேண்டு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டு"}]},{"w":"பவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":563,"ch":57,"l1":"வெருவந்த செய்தொழுகும் வெங்கோல னாயின்","l2":"ஒருவந்தம் ஒல்லைக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"குடிகள் அஞ்சும் படியான கொடுமைகளைச் செய்து ஆளும் கொடுங்கோல் அரசனானால், அவன் திண்ணமாக விரைவில் கெடுவான்.","en":"The cruel-sceptred king, who acts so as to put his subjects in fear, will certainly and quickly come to ruin","lines":[{"t":"வெருவந்த செய்தொழுகும் வெங்கோல னாயின்","err":null,"seers":[{"w":"வெருவந்த","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வெரு"},{"k":"N","s":"வந்"},{"k":"N","s":"த"}]},{"w":"செய்தொழுகும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"தொழு"},{"k":"N","s":"கும்"}]},{"w":"வெங்கோல","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வெங்"},{"k":"N","s":"கோ"},{"k":"N","s":"ல"}]},{"w":"னாயின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"னா"},{"k":"N","s":"யின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஒருவந்தம் ஒல்லைக் கெடும்.","err":null,"seers":[{"w":"ஒருவந்தம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வந்"},{"k":"N","s":"தம்"}]},{"w":"ஒல்லைக்","name