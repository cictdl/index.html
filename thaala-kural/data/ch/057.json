்டளை"]},{"t":"நீடின்றி ஆங்கே கெடும்.","err":null,"seers":[{"w":"நீடின்றி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நீ"},{"k":"N","s":"டின்"},{"k":"N","s":"றி"}]},{"w":"ஆங்கே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆங்"},{"k":"N","s":"கே"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":567,"ch":57,"l1":"கடுமொழியும் கையிகந்த தண்டமும் வேந்தன்","l2":"அடுமுரண் தேய்க்கும் அரம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கடுமையான சொல்லும் முறைகடந்த தண்டனையும் அரசனுடைய வெற்றிக்கு காரணமான வலிமையைத் தேய்க்கும் அரம் ஆகும்.","en":"Severe words and excessive punishments will be a file to waste away a king's power for destroying (his enemies)","lines":[{"t":"கடுமொழியும் கையிகந்த தண்டமும் வேந்தன்","err":null,"seers":[{"w":"கடுமொழியும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கடு"},{"k":"I","s":"மொழி"},{"k":"N","s":"யும்"}]},{"w":"கையிகந்த","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கை"},{"k":"I","s":"யிகந்"},{"k":"N","s":"த"}]},{"w":"தண்டமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தண்"},{"k":"I","s":"டமும்"}]},{"w":"வேந்தன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"தன்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அடுமுரண் தேய்க்கும் அரம்.","err":null,"seers":[{"w":"அடுமுரண்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அடு"},{"k":"I","s":"முரண்"}]},{"w":"தேய்க்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தேய்க்"},{"k":"N","s":"கும்"}]},{"w":"அரம்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அரம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":568,"ch":57,"l1":"இனத்தாற்றி எண்ணாத வேந்தன் சினத்தாற்றிச்","l2":"சீறிற் சிறுகும் திரு.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அமைச்சர் முதலான தன் இனத்தாரிடம் கலந்து எண்ணாத அரசன், சினத்தின் வழியில் சென்று சீறி நிற்பானானால், அவனுடைய செல்வம் சுருங்கும்.