[{"n":761,"ch":77,"l1":"உறுப்பமைந்து ஊறஞ்சா வெல்படை வேந்தன்","l2":"வெறுக்கையுள் எல்லாம் தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"எல்லா உறுப்புக்களும் நிறைந்ததாய் இடையூறுகளுக்கு அஞ்சாததாய் உள்ள வெற்றி தரும் படை, அரசனுடைய செல்வங்கள் எல்லாவற்றிலும் சிறந்ததாகும்.","en":"The army which is complete in (its) parts and conquers without fear of wounds is the chief wealth of the king","lines":[{"t":"உறுப்பமைந்து ஊறஞ்சா வெல்படை வேந்தன்","err":null,"seers":[{"w":"உறுப்பமைந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உறுப்"},{"k":"I","s":"பமைந்"},{"k":"N","s":"து"}]},{"w":"ஊறஞ்சா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"றஞ்"},{"k":"N","s":"சா"}]},{"w":"வெல்படை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வெல்"},{"k":"I","s":"படை"}]},{"w":"வேந்தன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"தன்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வெறுக்கையுள் எல்லாம் தலை.","err":null,"seers":[{"w":"வெறுக்கையுள்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வெறுக்"},{"k":"N","s":"கை"},{"k":"N","s":"யுள்"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":762,"ch":77,"l1":"உலைவிடத்து ஊறஞ்சா வன்கண் தொலைவிடத்துத்","l2":"தொல்படைக் கல்லால் அரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"போரில் அழிவு வந்தவிடத்தில் வலிமைக் குன்றினாலும், இடையூறுகளுக்கு அஞ்சாத அஞ்சாமை தொன்றுதொட்டுப் பெருமை உடையபடைக்கு அல்லாமல் முடியாது.","en":"Ancient army can alone have the valour which makes it stand by its king at the time of defeat, fearless of wounds and unmindful of its reduced strength","lines":[{"t":"உலைவிடத்து ஊறஞ்சா வன்கண் தொலைவிடத்துத்","err":null,"seers":[{"w":"உலைவிடத்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உலை"},{"k":"I","s":"விடத்"},{"k":"N","s":"து"}]},{"w":"ஊறஞ்சா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"றஞ்"},{"k":"N","s":"சா"}]},{"w":"வன்கண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வன்"},{"k":"N","s":"கண்"}]},{"w":"தொலைவிடத்துத்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தொலை"},{"k":"I","s":"விடத்"},{"k":"N","s":"துத்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தொல்படைக் கல்லால் அரிது.","err":null,"seers":[{"w":"தொல்படைக்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தொல்"},{"k":"I","s":"படைக்"}]},{"w":"கல்லால்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லால்"}]},{"w":"அரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":763,"ch":77,"l1":"ஒலித்தக்கால் என்னாம் உவரி எலிப்பகை","l2":"நாகம் உயிர்ப்பக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"எலியாகிய பகைக்கூடி கடல் போல் ஒலித்தாலும் என்ன தீங்கு ஏற்ப்படும், பாம்பு மூச்சு விட்ட அளவில் அவைக் கெட்டழியும்.","en":"What if (a host of) hostile rats roar like the sea ? They will perish at the mere breath of the cobra","lines":[{"t":"ஒலித்தக்கால் என்னாம் உவரி எலிப்பகை","err":null,"seers":[{"w":"ஒலித்தக்கால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒலித்"},{"k":"N","s":"தக்"},{"k":"N","s":"கால்"}]},{"w":"என்னாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னாம்"}]},{"w":"உவரி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உவ"},{"k":"N","s":"ரி"}]},{"w":"எலிப்பகை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"எலிப்"},{"k":"I","s":"பகை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நாகம் உயிர்ப்பக் கெடும்.","err":null,"seers":[{"w":"நாகம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"கம்"}]},{"w":"உயிர்ப்பக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயிர்ப்"},{"k":"N","s":"பக்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":764,"ch":77,"l1":"அழிவின்றி அறைபோகா தாகி வழிவந்த","l2":"வன்க ணதுவே படை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"(போர் முனையில்) அழிவு இல்லாததாய்(பகைவருடைய) வஞ்சனைக்கு இரையாகாததாய், தொன்று தொட்டுவந்த அஞ்சாமை உடையதே படையாகும்.","en":"That indeed is an army which has stood firm of old without suffering destruction or deserting (to the enemy)","lines":[{"t":"அழிவின்றி அறைபோகா தாகி வழிவந்த","err":null,"seers":[{"w":"அழிவின்றி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அழி"},{"k":"N","s":"வின்"},{"k":"N","s":"றி"}]},{"w":"அறைபோகா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறை"},{"k":"N","s":"போ"},{"k":"N","s":"கா"}]},{"w":"தாகி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"கி"}]},{"w":"வழிவந்த","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வழி"},{"k":"N","s":"வந்"},{"k":"N","s":"த"}]}],"thalai":["கலித்தளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வன்க ணதுவே படை.","err":null,"seers":[{"w":"வன்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வன்"},{"k":"N","s":"க"}]},{"w":"ணதுவே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ணது"},{"k":"N","s":"வே"}]},{"w":"படை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":765,"ch":77,"l1":"கூற்றுடன்று மேல்வரினும் கூடி எதிர்நிற்கும்","l2":"ஆற்ற லதுவே படை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"எமனே சினங்கொண்டு தன் மேல் எதிர்த்து வந்தாலும் ஒன்றாகத் திரண்டு எதிர்த்து நிற்க்கும் ஆற்றல் உடையதே படையாகும்.","en":"That indeed is an army which is capable of offering a united resistance, even if Yama advances against it with fury","lines":[{"t":"கூற்றுடன்று மேல்வரினும் கூடி எதிர்நிற்கும்","err":null,"seers":[{"w":"கூற்றுடன்று","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கூற்"},{"k":"I","s":"றுடன்"},{"k":"N","s":"று"}]},{"w":"மேல்வரினும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மேல்"},{"k":"I","s":"வரி"},{"k":"N","s":"னும்"}]},{"w":"கூடி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கூ"},{"k":"N","s":"டி"}]},{"w":"எதிர்நிற்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எதிர்"},{"k":"N","s":"நிற்"},{"k":"N","s":"கும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆற்ற லதுவே படை.","err":null,"seers":[{"w":"ஆற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"ற"}]},{"w":"லதுவே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"லது"},{"k":"N","s":"வே"}]},{"w":"படை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":766,"ch":77,"l1":"மறமானம் மாண்ட வழிச்செலவு தேற்றம்","l2":"எனநான்கே ஏமம் படைக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"வீரம், மானம், சிறந்த வழியில் நடக்கும் நடக்கை, தலைவரால் நம்பித் தெளியப்படுதல் ஆகிய இந்த நான்கு பண்புகளும் படைக்கு சிறந்தவையாகும்.","en":"Valour, honour, following in the excellent-footsteps (of its predecessors) and trust-worthiness; these four alone constitute the safeguard of an army","lines":[{"t":"மறமானம் மாண்ட வழிச்செலவு தேற்றம்","err":null,"seers":[{"w":"மறமானம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மற"},{"k":"N","s":"மா"},{"k":"N","s":"னம்"}]},{"w":"மாண்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாண்"},{"k":"N","s":"ட"}]},{"w":"வழிச்செலவு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வழிச்"},{"k":"I","s":"செல"},{"k":"N","s":"வு"}]},{"w":"தேற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தேற்"},{"k":"N","s":"றம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"எனநான்கே ஏமம் படைக்கு.","err":null,"seers":[{"w":"எனநான்கே","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"என"},{"k":"N","s":"நான்"},{"k":"N","s":"கே"}]},{"w":"ஏமம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"மம்"}]},{"w":"படைக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"படைக்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":767,"ch":77,"l1":"தார்தாங்கிச் செல்வது தானை தலைவந்த","l2":"போர்தாங்கும் தன்மை அறிந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"தன் மேல் எதிர்த்து வந்த பகைவரின் போரைத்தாங்கி, வெல்லும் தன்மை அறிந்து அவனுடைய தூசிப்படையை எதிர்த்துச் செல்லவல்லதே படையாகும்.","en":"That is an army which knowing the art of warding off an impending struggle, can bear against the dust-van (of a hostile force)","lines":[{"t":"தார்தாங்கிச் செல்வது தானை தலைவந்த","err":null,"seers":[{"w":"தார்தாங்கிச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தார்"},{"k":"N","s":"தாங்"},{"k":"N","s":"கிச்"}]},{"w":"செல்வது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செல்"},{"k":"I","s":"வது"}]},{"w":"தானை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"னை"}]},{"w":"தலைவந்த","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தலை"},{"k":"N","s":"வந்"},{"k":"N","s":"த"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"போர்தாங்கும் தன்மை அறிந்து.","err":null,"seers":[{"w":"போர்தாங்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"போர்"},{"k":"N","s":"தாங்"},{"k":"N","s":"கும்"}]},{"w":"தன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தன்"},{"k":"N","s":"மை"}]},{"w":"அறிந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறிந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":768,"ch":77,"l1":"அடல்தகையும் ஆற்றலும் இல்லெனினும் தானை","l2":"படைத்தகையால் பாடு பெறும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"போர் செய்யும் வீரமும்( எதிர்ப்பைத் தாங்கும்) ஆற்றலுமும் இல்லையானால் படைத்தன்னுடைய அணிவகுப்பால் பெருமை பெறும்.","en":"Though destitute of courage to fight and strength (to endure), an army may yet gain renown by the splendour of its appearance","lines":[{"t":"அடல்தகையும் ஆற்றலும் இல்லெனினும் தானை","err":null,"seers":[{"w":"அடல்தகையும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அடல்"},{"k":"I","s":"தகை"},{"k":"N","s":"யும்"}]},{"w":"ஆற்றலும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆற்"},{"k":"I","s":"றலும்"}]},{"w":"இல்லெனினும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"I","s":"லெனி"},{"k":"N","s":"னும்"}]},{"w":"தானை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"னை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"படைத்தகையால் பாடு பெறும்.","err":null,"seers":[{"w":"படைத்தகையால்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"படைத்"},{"k":"I","s":"தகை"},{"k":"N","s":"யால்"}]},{"w":"பாடு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பா"},{"k":"N","s":"டு"}]},{"w":"பெறும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":769,"ch":77,"l1":"சிறுமையும் செல்லாத் துனியும் வறுமையும்","l2":"இல்லாயின் வெல்லும் படை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தன் அளவு சிறிதாகத் தேய்தலும், தலைவரிடம் நீங்காத வெறுப்பும் வறுமையும் இல்லாதிருக்குமானால் அத்தகைய படை வெற்றி பெறும்.","en":"An army can triumph (over its foes) if it is free from diminution; irremediable aversion and poverty","lines":[{"t":"சிறுமையும் செல்லாத் துனியும் வறுமையும்","err":null,"seers":[{"w":"சிறுமையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறு"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"செல்லாத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"லாத்"}]},{"w":"துனியும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துனி"},{"k":"N","s":"யும்"}]},{"w":"வறுமையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வறு"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இல்லாயின் வெல்லும் படை.","err":null,"seers":[{"w":"இல்லாயின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"யின்"}]},{"w":"வெல்லும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெல்"},{"k":"N","s":"லும்"}]},{"w":"படை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":770,"ch":77,"l1":"நிலைமக்கள் சால உடைத்தெனினும் தானை","l2":"தலைமக்கள் இல்வழி இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"நெடுங்காலமாக நிலைத்திருக்கும் வீரர் பலரை உடையதே ஆனாலும், தலைமைதாங்கும் தலைவர் இல்லாத போது படைக்குப் பெருமை இல்லையாகும்.","en":"Though an army may contain a large number of permanent soldiers, it cannot last if it has no generals","lines":[{"t":"நிலைமக்கள் சால உடைத்தெனினும் தானை","err":null,"seers":[{"w":"நிலைமக்கள்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நிலை"},{"k":"N","s":"மக்"},{"k":"N","s":"கள்"}]},{"w":"சால","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சா"},{"k":"N","s":"ல"}]},{"w":"உடைத்தெனினும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உடைத்"},{"k":"I","s":"தெனி"},{"k":"N","s":"னும்"}]},{"w":"தானை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"னை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தலைமக்கள் இல்வழி இல்.","err":null,"seers":[{"w":"தலைமக்கள்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தலை"},{"k":"N","s":"மக்"},{"k":"N","s":"கள்"}]},{"w":"இல்வழி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இல்"},{"k":"I","s":"வழி"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]