[{"n":251,"ch":26,"l1":"தன்னூன் பெருக்கற்குத் தான்பிறிது ஊனுண்பான்","l2":"எங்ஙனம் ஆளும் அருள்?","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தன் உடம்பைப் பெருக்கச் செய்வதற்காகத் தான் மற்றோர் உயிரின் உடம்பைத் தின்கின்றவன் எவ்வாறு அருளுடையவனாக இருக்க முடியும்.","en":"How can he be possessed of kindness, who to increase his own flesh, eats the flesh of other creatures","lines":[{"t":"தன்னூன் பெருக்கற்குத் தான்பிறிது ஊனுண்பான்","err":null,"seers":[{"w":"தன்னூன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தன்"},{"k":"N","s":"னூன்"}]},{"w":"பெருக்கற்குத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெருக்"},{"k":"N","s":"கற்"},{"k":"N","s":"குத்"}]},{"w":"தான்பிறிது","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தான்"},{"k":"I","s":"பிறி"},{"k":"N","s":"து"}]},{"w":"ஊனுண்பான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"னுண்"},{"k":"N","s":"பான்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"எங்ஙனம் ஆளும் அருள்?","err":null,"seers":[{"w":"எங்ஙனம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எங்"},{"k":"I","s":"ஙனம்"}]},{"w":"ஆளும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"ளும்"}]},{"w":"அருள்?","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அருள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":252,"ch":26,"l1":"பொருளாட்சி போற்றாதார்க்கு இல்லை அருளாட்சி","l2":"ஆங்கில்லை ஊன்தின் பவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பொருளுடையவராக இருக்கும் சிறப்பு அப்பொருளை வைத்துக் காப்பாற்றாதவர்க்கு இல்லை, அருளுடையவராக இருக்கும் சிறப்பு புலால் தின்பவர்க்கு இல்லை.","en":"As those possess no property who do not take care of it, so those possess no kindness who feed on flesh","lines":[{"t":"பொருளாட்சி போற்றாதார்க்கு இல்லை அருளாட்சி","err":null,"seers":[{"w":"பொருளாட்சி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளாட்"},{"k":"N","s":"சி"}]},{"w":"போற்றாதார்க்கு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றா"},{"k":"N","s":"தார்க்"},{"k":"N","s":"கு"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"அருளாட்சி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அரு"},{"k":"N","s":"ளாட்"},{"k":"N","s":"சி"}]}],"thalai":["வெண்சீர் வெண்டளை",null,"இயற்சீர் வெண்டளை"]},{"t":"ஆங்கில்லை ஊன்தின் பவர்க்கு.","err":null,"seers":[{"w":"ஆங்கில்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆங்"},{"k":"N","s":"கில்"},{"k":"N","s":"லை"}]},{"w":"ஊன்தின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊன்"},{"k":"N","s":"தின்"}]},{"w":"பவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":253,"ch":26,"l1":"படைகொண்டார் நெஞ்சம்போல் நன்னூக்காது ஒன்றன்","l2":"உடல்சுவை உண்டார் மனம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஓர் உயிரின் உடம்பைச் சுவையாக உண்டவரின் மனம் கொலைக்கருவியைக் கையில் கொண்டவரின் நெஞ்சம் போல் நன்மையாகி அருளைப் போற்றாது.","en":"Like the (murderous) mind of him who carries a weapon (in his hand), the mind of him who feasts with pleasure on the body of another (creature), has no regard for goodness","lines":[{"t":"படைகொண்டார் நெஞ்சம்போல் நன்னூக்காது ஒன்றன்","err":null,"seers":[{"w":"படைகொண்டார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"படை"},{"k":"N","s":"கொண்"},{"k":"N","s":"டார்"}]},{"w":"நெஞ்சம்போல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சம்"},{"k":"N","s":"போல்"}]},{"w":"நன்னூக்காது","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"நன்"},{"k":"N","s":"னூக்"},{"k":"N","s":"கா"},{"k":"N","s":"து"}]},{"w":"ஒன்றன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒன்"},{"k":"N","s":"றன்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை",null]},{"t":"உடல்சுவை உண்டார் மனம்.","err":null,"seers":[{"w":"உடல்சுவை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உடல்"},{"k":"I","s":"சுவை"}]},{"w":"உண்டார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டார்"}]},{"w":"மனம்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"மனம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":254,"ch":26,"l1":"அருளல்ல தியாதெனிற் கொல்லாமை கோறல்","l2":"பொருளல்லது அவ்வூன் தினல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அருள் எது என்றால் ஓர் உயிரையும் கொல்லாமலிருத்தல் அருளல்லாது எது என்றால் உயிர்களைக்கொள்ளுதல் அதன் உடம்பைத் தின்னுதல் அறம் அல்லாதது.","en":"If it be asked what is kindness and what its opposite, the answer would be preservation and destruction of life; and therefore it is not right to feed on the flesh (obtained by taking away life)","lines":[{"t":"அருளல்ல தியாதெனிற் கொல்லாமை கோறல்","err":null,"seers":[{"w":"அருளல்ல","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அரு"},{"k":"N","s":"ளல்"},{"k":"N","s":"ல"}]},{"w":"தியாதெனிற்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தியா"},{"k":"I","s":"தெனிற்"}]},{"w":"கொல்லாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லா"},{"k":"N","s":"மை"}]},{"w":"கோறல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கோ"},{"k":"N","s":"றல்"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பொருளல்லது அவ்வூன் தினல்.","err":null,"seers":[{"w":"பொருளல்லது","name":"புளிமாங்கனி","cls":"கனி","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளல்"},{"k":"I","s":"லது"}]},{"w":"அவ்வூன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அவ்"},{"k":"N","s":"வூன்"}]},{"w":"தினல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தினல்"}]}],"thalai":["ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":255,"ch":26,"l1":"உண்ணாமை உள்ளது உயிர்நிலை ஊனுண்ண","l2":"அண்ணாத்தல் செய்யாது அளறு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"உயிர்கள் உடம்பு பெற்று வாழும் நிலைமை, ஊன் உண்ணாதிருத்தலை அடிப்படையாகக் கொண்டது ஊன் உண்டால் நரகம் அவனை வெளிவிடாது.","en":"Not to eat flesh contributes to the continuance of life; therefore if a man eat flesh, hell will not open its mouth (to let him escape out, after he has once fallen in)","lines":[{"t":"உண்ணாமை உள்ளது உயிர்நிலை ஊனுண்ண","err":null,"seers":[{"w":"உண்ணாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உண்"},{"k":"N","s":"ணா"},{"k":"N","s":"மை"}]},{"w":"உள்ளது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளது"}]},{"w":"உயிர்நிலை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உயிர்"},{"k":"I","s":"நிலை"}]},{"w":"ஊனுண்ண","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"னுண்"},{"k":"N","s":"ண"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"அண்ணாத்தல் செய்யாது அளறு.","err":null,"seers":[{"w":"அண்ணாத்தல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அண்"},{"k":"N","s":"ணாத்"},{"k":"N","s":"தல்"}]},{"w":"செய்யாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யா"},{"k":"N","s":"து"}]},{"w":"அளறு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அள"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","கலித்தளை"]}]},{"n":256,"ch":26,"l1":"தினற்பொருட்டால் கொல்லாது உலகெனின் யாரும்","l2":"விலைப்பொருட்டால் ஊன்றருவா ரில்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"புலால் தின்னும் பொருட்டு உலகத்தார் உயிர்களைக் கொல்லா திருப்பாரானால், விலையின் பொருட்டு ஊன் விற்பவர் இல்லாமல் போவார்.","en":"If the world does not destroy life for the purpose of eating, then no one would sell flesh for the sake of money","lines":[{"t":"தினற்பொருட்டால் கொல்லாது உலகெனின் யாரும்","err":null,"seers":[{"w":"தினற்பொருட்டால்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தினற்"},{"k":"I","s":"பொருட்"},{"k":"N","s":"டால்"}]},{"w":"கொல்லாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லா"},{"k":"N","s":"து"}]},{"w":"உலகெனின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உல"},{"k":"I","s":"கெனின்"}]},{"w":"யாரும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"ரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"விலைப்பொருட்டால் ஊன்றருவா ரில்.","err":null,"seers":[{"w":"விலைப்பொருட்டால்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"விலைப்"},{"k":"I","s":"பொருட்"},{"k":"N","s":"டால்"}]},{"w":"ஊன்றருவா","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊன்"},{"k":"I","s":"றரு"},{"k":"N","s":"வா"}]},{"w":"ரில்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"ரில்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":257,"ch":26,"l1":"உண்ணாமை வேண்டும் புலாஅல் பிறிதொன்றன்","l2":"புண்ணது உணர்வார்ப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"புலால் உண்ணாமலிருக்க வேண்டும், ஆராய்ந்து அறிவாரைப் பெற்றால், அப் புலால் வேறோர் உயிரின் புண் என்பதை உணரலாம்.","en":"If men should come to know that flesh is nothing but the unclean ulcer of a body, let them abstain from eating it","lines":[{"t":"உண்ணாமை வேண்டும் புலாஅல் பிறிதொன்றன்","err":null,"seers":[{"w":"உண்ணாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உண்"},{"k":"N","s":"ணா"},{"k":"N","s":"மை"}]},{"w":"வேண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"புலாஅல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புலா"},{"k":"N","s":"அல்"}]},{"w":"பிறிதொன்றன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறி"},{"k":"N","s":"தொன்"},{"k":"N","s":"றன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"புண்ணது உணர்வார்ப் பெறின்.","err":null,"seers":[{"w":"புண்ணது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"புண்"},{"k":"I","s":"ணது"}]},{"w":"உணர்வார்ப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உணர்"},{"k":"N","s":"வார்ப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]}]},{"n":258,"ch":26,"l1":"செயிரின் தலைப்பிரிந்த காட்சியார் உண்ணார்","l2":"உயிரின் தலைப்பிரிந்த ஊன்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"குற்றத்திலிருந்து நீங்கிய அறிவை உடையவர், ஒர் உயிரினிடத்திலிருந்து பிரிந்து வந்த ஊனை உண்ணமாட்டார்.","en":"The wise, who have freed themselves from mental delusion, will not eat the flesh which has been severed from an animal","lines":[{"t":"செயிரின் தலைப்பிரிந்த காட்சியார் உண்ணார்","err":null,"seers":[{"w":"செயிரின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செயி"},{"k":"N","s":"ரின்"}]},{"w":"தலைப்பிரிந்த","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தலைப்"},{"k":"I","s":"பிரிந்"},{"k":"N","s":"த"}]},{"w":"காட்சியார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"காட்"},{"k":"I","s":"சியார்"}]},{"w":"உண்ணார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"ணார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உயிரின் தலைப்பிரிந்த ஊன்.","err":null,"seers":[{"w":"உயிரின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயி"},{"k":"N","s":"ரின்"}]},{"w":"தலைப்பிரிந்த","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தலைப்"},{"k":"I","s":"பிரிந்"},{"k":"N","s":"த"}]},{"w":"ஊன்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"ஊன்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":259,"ch":26,"l1":"அவிசொரிந் தாயிரம் வேட்டலின் ஒன்றன்","l2":"உயிர்செகுத் துண்ணாமை நன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நெய் முதலியப் பொருள்களைத் தீயில் சொரிந்து ஆயிரம் வேள்விகள் செய்தலை விட ஒன்றன் உயிரைக்கொன்று உடம்பைத் தின்னாதிருத்தல் நல்லது.","en":"Not to kill and eat (the flesh of) an animal, is better than the pouring forth of ghee etc, in a thousand sacrifices","lines":[{"t":"அவிசொரிந் தாயிரம் வேட்டலின் ஒன்றன்","err":null,"seers":[{"w":"அவிசொரிந்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அவி"},{"k":"I","s":"சொரிந்"}]},{"w":"தாயிரம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தா"},{"k":"I","s":"யிரம்"}]},{"w":"வேட்டலின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வேட்"},{"k":"I","s":"டலின்"}]},{"w":"ஒன்றன்","name":"தேமா",