[{"n":171,"ch":18,"l1":"நடுவின்றி நன்பொருள் வெஃகின் குடிபொன்றிக்","l2":"குற்றமும் ஆங்கே தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நடுவுநிலைமை இல்லாமல் பிறர்க்குரிய நல்ல பொருளை ஒருவன் கவர விரும்பினால் அவனுடைய குடியும் கெட்டுக் குற்றமும் அப்போழுதே வந்து சேரும்.","en":"If a man departing from equity covet the property (of others), at that very time will his family be destroyed and guilt be incurred","lines":[{"t":"நடுவின்றி நன்பொருள் வெஃகின் குடிபொன்றிக்","err":null,"seers":[{"w":"நடுவின்றி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நடு"},{"k":"N","s":"வின்"},{"k":"N","s":"றி"}]},{"w":"நன்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நன்"},{"k":"I","s":"பொருள்"}]},{"w":"வெஃகின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெஃ"},{"k":"N","s":"கின்"}]},{"w":"குடிபொன்றிக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குடி"},{"k":"N","s":"பொன்"},{"k":"N","s":"றிக்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"குற்றமும் ஆங்கே தரும்.","err":null,"seers":[{"w":"குற்றமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"குற்"},{"k":"I","s":"றமும்"}]},{"w":"ஆங்கே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆங்"},{"k":"N","s":"கே"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":172,"ch":18,"l1":"படுபயன் வெஃகிப் பழிப்படுவ செய்யார்","l2":"நடுவன்மை நாணு பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"நடுவுநிலைமை அல்லாதவற்றைக் கண்டு நாணி ஒதுங்குகின்றவர், பிறர் பொருளைக் கவர்வதால் வரும் பயனை விரும்பிப் பழியான செயல்களைச் செய்யார்.","en":"Those who blush at the want of equity will not commit disgraceful acts through desire of the profit that may be gained","lines":[{"t":"படுபயன் வெஃகிப் பழிப்படுவ செய்யார்","err":null,"seers":[{"w":"படுபயன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"படு"},{"k":"I","s":"பயன்"}]},{"w":"வெஃகிப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெஃ"},{"k":"N","s":"கிப்"}]},{"w":"பழிப்படுவ","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பழிப்"},{"k":"I","s":"படு"},{"k":"N","s":"வ"}]},{"w":"செய்யார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நடுவன்மை நாணு பவர்.","err":null,"seers":[{"w":"நடுவன்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நடு"},{"k":"N","s":"வன்"},{"k":"N","s":"மை"}]},{"w":"நாணு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணு"}]},{"w":"பவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":173,"ch":18,"l1":"சிற்றின்பம் வெஃகி அறனல்ல செய்யாரே","l2":"மற்றின்பம் வேண்டு பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அறநெறியால் பெறும் இன்பத்தை விரும்புகின்றவர், நிலையில்லாத சிறிய இன்பத்தை விரும்பி அறம் அல்லாதவற்றைச் செய்யார்.","en":"Those who desire the higher pleasures (of heaven) will not act unjustly through desire of the trifling joy. (in this life.)","lines":[{"t":"சிற்றின்பம் வெஃகி அறனல்ல செய்யாரே","err":null,"seers":[{"w":"சிற்றின்பம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சிற்"},{"k":"N","s":"றின்"},{"k":"N","s":"பம்"}]},{"w":"வெஃகி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெஃ"},{"k":"N","s":"கி"}]},{"w":"அறனல்ல","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அற"},{"k":"N","s":"னல்"},{"k":"N","s":"ல"}]},{"w":"செய்யாரே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யா"},{"k":"N","s":"ரே"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"மற்றின்பம் வேண்டு பவர்.","err":null,"seers":[{"w":"மற்றின்பம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றின்"},{"k":"N","s":"பம்"}]},{"w":"வேண்டு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டு"}]},{"w":"பவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":174,"ch":18,"l1":"இலமென்று வெஃகுதல் செய்யார் புலம்வென்ற","l2":"புன்மையில் காட்சி யவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஐம்புலன்களையும் வென்ற குற்றமில்லாத அறிவை உடையவர், யாம் வறுமை அடைந்தோம் என்று எண்ணியும் பிறர் பொருளை விரும்பார்‌.","en":"The wise who have conquered their senses and are free from crime, will not covet (the things of others), with the thought \"we are destitute.\"","lines":[{"t":"இலமென்று வெஃகுதல் செய்யார் புலம்வென்ற","err":null,"seers":[{"w":"இலமென்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இல"},{"k":"N","s":"மென்"},{"k":"N","s":"று"}]},{"w":"வெஃகுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வெஃ"},{"k":"I","s":"குதல்"}]},{"w":"செய்யார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யார்"}]},{"w":"புலம்வென்ற","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"புலம்"},{"k":"N","s":"வென்"},{"k":"N","s":"ற"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"புன்மையில் காட்சி யவர்.","err":null,"seers":[{"w":"புன்மையில்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"புன்"},{"k":"N","s":"மை"},{"k":"N","s":"யில்"}]},{"w":"காட்சி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காட்"},{"k":"N","s":"சி"}]},{"w":"யவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"யவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":175,"ch":18,"l1":"அஃகி அகன்ற அறிவென்னாம் யார்மாட்டும்","l2":"வெஃகி வெறிய செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"யாரிடத்திலும் பொருளைக் கவர விரும்பிப் பொருந்தாதவற்றைச் செய்தால், நுட்பமானதாய் விரிவுடையதாய் வளர்ந்த அறிவால் பயன் என்ன?","en":"What is the advantage of extensive and accurate knowledge if a man through covetousness act senselessly towards all ?","lines":[{"t":"அஃகி அகன்ற அறிவென்னாம் யார்மாட்டும்","err":null,"seers":[{"w":"அஃகி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"கி"}]},{"w":"அகன்ற","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அகன்"},{"k":"N","s":"ற"}]},{"w":"அறிவென்னாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வென்"},{"k":"N","s":"னாம்"}]},{"w":"யார்மாட்டும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யார்"},{"k":"N","s":"மாட்"},{"k":"N","s":"டும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வெஃகி வெறிய செயின்.","err":null,"seers":[{"w":"வெஃகி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெஃ"},{"k":"N","s":"கி"}]},{"w":"வெறிய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வெறி"},{"k":"N","s":"ய"}]},{"w":"செயின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":176,"ch":18,"l1":"அருள்வெஃகி ஆற்றின்கண் நின்றான் பொருள்வெஃகிப்","l2":"பொல்லாத சூழக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அருளை விரும்பி அறநெறியில் நின்றவன், பிறனுடைய பொருளை விரும்பிப் பொல்லாத குற்றங்களை எண்ணினால் கெடுவான்.","en":"If he, who through desire of the virtue of kindness abides in the domestic state ie, the path in which it may be obtained, covet (the property of others) and think of evil methods (to obtain it), he will perish","lines":[{"t":"அருள்வெஃகி ஆற்றின்கண் நின்றான் பொருள்வெஃகிப்","err":null,"seers":[{"w":"அருள்வெஃகி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அருள்"},{"k":"N","s":"வெஃ"},{"k":"N","s":"கி"}]},{"w":"ஆற்றின்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றின்"},{"k":"N","s":"கண்"}]},{"w":"நின்றான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நின்"},{"k":"N","s":"றான்"}]},{"w":"பொருள்வெஃகிப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருள்"},{"k":"N","s":"வெஃ"},{"k":"N","s":"கிப்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பொல்லாத சூழக் கெடும்.","err":null,"seers":[{"w":"பொல்லாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொல்"},{"k":"N","s":"லா"},{"k":"N","s":"த"}]},{"w":"சூழக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சூ"},{"k":"N","s":"ழக்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":177,"ch":18,"l1":"வேண்டற்க வெஃகியாம் ஆக்கம் விளைவயின்","l2":"மாண்டற் கரிதாம் பயன்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பிறர் பொருளைக் கவர விரும்புவதால் ஆகும் ஆக்கத்தை விரும்பாதிருக்க வேண்டும்; அது பயன் விளைவிக்கும்போது அப்பயன் நன்மையாவது அரிதாகும்.","en":"Desire not the gain of covetousness In the enjoyment of its fruits there is no glory","lines":[{"t":"வேண்டற்க வெஃகியாம் ஆக்கம் விளைவயின்","err":null,"seers":[{"w":"வேண்டற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டற்"},{"k":"N","s":"க"}]},{"w":"வெஃகியாம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வெஃ"},{"k":"I","s":"கியாம்"}]},{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"விளைவயின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விளை"},{"k":"I","s":"வயின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாண்டற் கரிதாம் பயன்.","err":null,"seers":[{"w":"மாண்டற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாண்"},{"k":"N","s":"டற்"}]},{"w":"கரிதாம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரி"},{"k":"N","s":"தாம்"}]},{"w":"பயன்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பயன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":178,"ch":18,"l1":"அஃகாமை செல்வத்திற்கு யாதெனின் வெஃகாமை","l2":"வேண்டும் பிறன்கைப் பொருள்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவனுடைய செல்வத்திற்குக் குறைவு நேராதிருக்க வழி எது என்றால், அவன் பிறனுடைய கைப்பொருளை விரும்பாதிருத்தலாகும்.","en":"If it is weighed, \"what is the indestructibility of wealth,\" it is freedom from covetousness","lines":[{"t":"அஃகாமை செல்வத்திற்கு யாதெனின் வெஃகாமை","err":null,"seers":[{"w":"அஃகாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"செல்வத்திற்கு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வத்"},{"k":"N","s":"திற்"},{"k":"N","s":"கு"}]},{"w":"யாதெனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தெனின்"}]},{"w":"வெஃகாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வெஃ"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]}],"thalai":["வெண்சீர் வெண்டளை",null,"இயற்சீர் வெண்டளை"]},{"t":"வேண்டும் பிறன்கைப் பொருள்.","err":null,"seers":[{"w":"வேண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"பிறன்கைப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிறன்"},{"k":"N","s":"கைப்"}]},{"w":"பொருள்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பொருள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":179,"ch":18,"l1":"அறனறிந்து வெஃகா அறிவுடையார்ச் சேரும்","l2":"திறன்அறிந் தாங்கே திரு.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறம் இஃது என்று அறிந்து பிறர் பொருளை விரும்பாத அறிவுடையாரைத் திருமகள் தான் சேரும் திறன் அறிந்து அதற்கு ஏற்றவாறு சேர்வாள்.","en":"Lakshmi, knowing the manner (in which she may approach) will immediately come to those wise men who, knowing that it is virtue, covet not the property of others","lines":[{"t":"அறனறிந்து வெஃகா அறிவுடையார்ச் சேரும்","err":null,"seers":[{"w":"அறனறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அற"},{"k":"I","s":"னறிந்"},{"k":"N","s":"து"}]},{"w":"வெஃகா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெஃ"},{"k":"N","s":"கா"}]},{"w":"அறிவுடையார்ச்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வுடை"},{"k":"N","s":"யார்ச்"}]},{"w":"சேரும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சே"},{"k":"N","s":"ரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"திறன்அறிந் தாங்கே திரு.","err":null,"seers":[{"w":"திறன்அறிந்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"திறன்"},{"k":"I","s":"அறிந்"}]},{"w":"தாங்கே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தாங்"},{"k":"N","s":"கே"}]},{"w":"திரு.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"திரு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":180,"ch":18,"l1":"இறலீனும் எண்ணாது வெஃகின் விறல்ஈனும்","l2":"வேண்டாமை என்னுஞ் செருக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"வி‌ளைவை எண்ணாமல் பிறர் பொருளை விரும்பினால் அஃது அழிவைத் தரும்; அப்பொருளை விரும்பாமல் வாழும் பெருமை வெற்றியைத் தரும்.","en":"To covet (the wealth of another) regardless of consequences will bring destruction That greatness (of mind) which covets not will give victory","lines":[{"t":"இறலீனும் எண்ணாது வெஃகின் விறல்ஈனும்","err":null,"seers":[{"w":"இறலீனும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இற"},{"k":"N","s":"லீ"},{"k":"N","s":"னும்"}]},{"w":"எண்ணாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எண்"},{"k":"N","s":"ணா"},{"k":"N","s":"து"}]},{"w":"வெஃகின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெஃ"},{"k":"N","s":"கின்"}]},{"w":"விறல்ஈனும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விறல்"},{"k":"N","s":"ஈ"},{"k":"N","s":"னும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேண்டாமை என்னுஞ் செருக்கு.","err":null,"seers":[{"w":"வேண்டாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டா"},{"k":"N","s":"மை"}]},{"w":"என்னுஞ்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னுஞ்"}]},{"w":"செருக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செருக்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]