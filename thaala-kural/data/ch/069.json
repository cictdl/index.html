err":null,"seers":[{"w":"வென்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வென்"},{"k":"N","s":"றி"}]},{"w":"வினையுரைப்பான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வினை"},{"k":"I","s":"யுரைப்"},{"k":"N","s":"பான்"}]},{"w":"பண்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பண்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":684,"ch":69,"l1":"அறிவுரு வாராய்ந்த கல்விஇம் மூன்றன்","l2":"செறிவுடையான் செல்க வினைக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"இயற்கை அறிவு, விரும்பத்தக்கத் தோற்றம், ஆராய்ச்சி உடையக் கல்வி ஆகிய இம் மூன்றின் பொருத்தம் உடையவன் தூது உரைக்கும் தொழிலுக்குச் செல்லலாம்.","en":"He may go on a mission (to foreign rulers) who has combined in him all these three viz, (natural) sense, an attractive bearing and well-tried learning","lines":[{"t":"அறிவுரு வாராய்ந்த கல்விஇம் மூன்றன்","err":null,"seers":[{"w":"அறிவுரு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வுரு"}]},{"w":"வாராய்ந்த","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"N","s":"ராய்ந்"},{"k":"N","s":"த"}]},{"w":"கல்விஇம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கல்"},{"k":"I","s":"விஇம்"}]},{"w":"மூன்றன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மூன்"},{"k":"N","s":"றன்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செறிவுடையான் செல்க வினைக்கு.","err":null,"seers":[{"w":"செறிவுடையான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"செறி"},{"k":"I","s":"வுடை"},{"k":"N","s":"யான்"}]},{"w":"செல்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"க"}]},{"w":"வினைக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வினைக்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":685,"ch":69,"l1":"தொகச்சொல்லித் தூவாத நீக்கி நகச்சொல்லி","l2":"நன்றி பயப்பதாந் தூது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பலவற்றைத் தொகுத்து சொல்லியும், அவற்றுள் பயனற்றவைகளை நீக்கியும், மகிழுமாறு சொல்லியும் தன் தலைவனுக்கு நன்மை உண்டாக்குகின்றவன் தூதன்.","en":"He is an ambassador who (in the presence of foreign rulers) speaks briefly, avoids harshness, talks so as to make them smile, and thus brings good (to his own sovereign)","lines":[{"t":"தொகச்சொல்லித் தூவாத நீக்கி நகச்சொல்லி","err":null,"seers":[{"w":"தொகச்சொல்லித்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தொகச்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லித்"}]},{"w":"தூவாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தூ"},{"k":"N","s":"வா"},{"k":"N","s":"த"}]},{"w":"நீக்கி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீக்"},{"k":"N","s":"கி"}]},{"w":"நகச்சொல்லி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நகச்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லி"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நன்றி பயப்பதாந் தூது.","err":null,"seers":[{"w":"நன்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றி"}]},{"w":"பயப்பதாந்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பயப்"},{"k":"I","s":"பதாந்"}]},{"w":"தூது.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தூ"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":686,"ch":69,"l1":"கற்றுக்கண் அஞ்சான் செலச்சொல்லிக் காலத்தால்","l2":"தக்கது அறிவதாம் தூது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"கற்பன கற்று, பிறருடைய பகையான பார்வைக்கு அஞ்சாமல் கேட்பவர் உள்ளத்தில் பதியுமாறு சொல்லி, காலத்திற்க்குப் பொருத்தமானதை அறிகின்றவனே தூதன்.","en":"He is an ambassador who having studied (politics) talks impressively, is not afraid of angry looks, and knows (to employ) the art suited to the time","lines":[{"t":"கற்றுக்கண் அஞ்சான் செலச்சொல்லிக் காலத்தால்","err":null,"seers":[{"w":"கற்றுக்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"N","s":"றுக்"},{"k":"N","s":"கண்"}]},{"w":"அஞ்சான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சான்"}]},{"w":"செலச்சொல்லிக்","name