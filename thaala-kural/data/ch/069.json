[{"n":681,"ch":69,"l1":"அன்புடைமை ஆன்ற குடிப்பிறத்தல் வேந்தவாம்","l2":"பண்புடைமை தூதுரைப்பான் பண்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அன்புடையவனாதல், தகுதியானக் குடிப்பிறப்பு உடையவனாதல் அரசர் விரும்பும் சிறந்த பண்பு உடையவனாதல், ஆகிய இவை தூது உரைப்பவனுடையத் தகுதிகள்.","en":"The qualification of an ambassador are affection (for his relations) a fitting birth, and the possession of attributes pleasing to royalty","lines":[{"t":"அன்புடைமை ஆன்ற குடிப்பிறத்தல் வேந்தவாம்","err":null,"seers":[{"w":"அன்புடைமை","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"அன்"},{"k":"I","s":"புடை"},{"k":"N","s":"மை"}]},{"w":"ஆன்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆன்"},{"k":"N","s":"ற"}]},{"w":"குடிப்பிறத்தல்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குடிப்"},{"k":"I","s":"பிறத்"},{"k":"N","s":"தல்"}]},{"w":"வேந்தவாம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வேந்"},{"k":"I","s":"தவாம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பண்புடைமை தூதுரைப்பான் பண்பு.","err":null,"seers":[{"w":"பண்புடைமை","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பண்"},{"k":"I","s":"புடை"},{"k":"N","s":"மை"}]},{"w":"தூதுரைப்பான்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தூ"},{"k":"I","s":"துரைப்"},{"k":"N","s":"பான்"}]},{"w":"பண்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பண்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":682,"ch":69,"l1":"அன்பறிவு ஆராய்ந்த சொல்வன்மை தூதுரைப்பார்க்கு","l2":"இன்றி யமையாத மூன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":[null],"mv":"அன்பு, அறிவு, ஆராய்ந்து சொல்கின்ற சொல் வன்மை ஆகிய இவை மூன்றும் தூது உரைப்பவர்க்கு இன்றியமையாத மூன்று பண்புகளாகும்.","en":"Love (to his sovereign), knowledge (of his affairs), and a discriminating power of speech (before other sovereigns) are the three sine qua non qualifications of an ambassador","lines":[{"t":"அன்பறிவு ஆராய்ந்த சொல்வன்மை தூதுரைப்பார்க்கு","err":null,"