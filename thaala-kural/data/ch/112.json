[{"n":1111,"ch":112,"l1":"நன்னீரை வாழி அனிச்சமே நின்னினும்","l2":"மென்னீரள் யாம்வீழ் பவள்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அனிச்சப்பூவே நல்ல மென்மை தன்மை பெற்றிறுக்கின்றாய், நீ வாழ்க, யாம் விரும்பும் காதலி உன்னை விட மெல்லியத் தன்மை கொண்டவள்.","en":"May you flourish, O Anicham! you have a delicate nature But my beloved is more delicate than you","lines":[{"t":"நன்னீரை வாழி அனிச்சமே நின்னினும்","err":null,"seers":[{"w":"நன்னீரை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"N","s":"னீ"},{"k":"N","s":"ரை"}]},{"w":"வாழி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ழி"}]},{"w":"அனிச்சமே","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அனிச்"},{"k":"I","s":"சமே"}]},{"w":"நின்னினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நின்"},{"k":"I","s":"னினும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மென்னீரள் யாம்வீழ் பவள்.","err":null,"seers":[{"w":"மென்னீரள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மென்"},{"k":"N","s":"னீ"},{"k":"N","s":"ரள்"}]},{"w":"யாம்வீழ்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யாம்"},{"k":"N","s":"வீழ்"}]},{"w":"பவள்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவள்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1112,"ch":112,"l1":"மலர்காணின் மையாத்தி நெஞ்சே இவள்கண்","l2":"பலர்காணும் பூவொக்கும் என்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நெஞ்சமே! இவளுடைய கண்கள் பலரும் காண்கின்ற மலர்களை ஒத்திருக்கின்றன, என்று நினைத்து ஒத்த மலர்களைக் கண்டால் நீ மயங்குகின்றாய்.","en":"O my soul, fancying that flowers which are seen by many can resemble her eyes, you become confused at the sight of them","lines":[{"t":"மலர்காணின் மையாத்தி நெஞ்சே இவள்கண்","err":null,"seers":[{"w":"மலர்காணின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மலர்"},{"k":"N","s":"கா"},{"k":"N","s":"ணின்"}]},{"w":"மையாத்தி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மை"},{"k":"N","s":"யாத்"},{"k":"N","s":"தி"}]},{"w":"நெஞ்சே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சே"}]},{"w":"இவள்கண்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இவள்"},{"k":"N","s":"கண்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பலர்காணும் பூவொக்கும் என்று.","err":null,"seers":[{"w":"பலர்காணும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பலர்"},{"k":"N","s":"கா"},{"k":"N","s":"ணும்"}]},{"w":"பூவொக்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பூ"},{"k":"N","s":"வொக்"},{"k":"N","s":"கும்"}]},{"w":"என்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1113,"ch":112,"l1":"முறிமேனி முத்தம் முறுவல் வெறிநாற்றம்","l2":"வேலுண்கண் வேய்த்தோ ளவட்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மூங்கில் போன்ற தோளை உடைய இவளுக்குத் தளிரே மேன், முத்தே பல், இயற்கை மணமே மணம், வேலே மை உண்ட கண்.","en":"The complexion of this bamboo-shouldered one is that of a shoot; her teeth, are pearls; her breath,","lines":[{"t":"முறிமேனி முத்தம் முறுவல் வெறிநாற்றம்","err":null,"seers":[{"w":"முறிமேனி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முறி"},{"k":"N","s":"மே"},{"k":"N","s":"னி"}]},{"w":"முத்தம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"முத்"},{"k":"N","s":"தம்"}]},{"w":"முறுவல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முறு"},{"k":"N","s":"வல்"}]},{"w":"வெறிநாற்றம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வெறி"},{"k":"N","s":"நாற்"},{"k":"N","s":"றம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேலுண்கண் வேய்த்தோ ளவட்கு.","err":null,"seers":[{"w":"வேலுண்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"லுண்"},{"k":"N","s":"கண்"}]},{"w":"வேய்த்தோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேய்த்"},{"k":"N","s":"தோ"}]},{"w":"ளவட்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ளவட்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1114,"ch":112,"l1":"காணின் குவளை கவிழ்ந்து நிலன்நோக்கும்","l2":"மாணிழை கண்ணொவ்வேம் என்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"குவளை மலர்கள் காணும் தன்மைப் பெற்றுக் கண்டால், இவளுடைய கண்களுக்கு தாம் ஒப்பாக வில்லையே என்று தலை கவிழ்ந்து நிலத்தை நோக்கும்.","en":"If the blue lotus could see, it would stoop and look at the ground saying, \"I can never resemble the eyes of this excellent jewelled one.\"","lines":[{"t":"காணின் குவளை கவிழ்ந்து நிலன்நோக்கும்","err":null,"seers":[{"w":"காணின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணின்"}]},{"w":"குவளை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குவ"},{"k":"N","s":"ளை"}]},{"w":"கவிழ்ந்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கவிழ்ந்"},{"k":"N","s":"து"}]},{"w":"நிலன்நோக்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நிலன்"},{"k":"N","s":"நோக்"},{"k":"N","s":"கும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாணிழை கண்ணொவ்வேம் என்று.","err":null,"seers":[{"w":"மாணிழை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மா"},{"k":"I","s":"ணிழை"}]},{"w":"கண்ணொவ்வேம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணொவ்"},{"k":"N","s":"வேம்"}]},{"w":"என்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1115,"ch":112,"l1":"அனிச்சப்பூக் கால்களையாள் பெய்தாள் நுகப்பிற்கு","l2":"நல்ல படாஅ பறை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அவள் தன் மென்மை அறியாமல் அனிச்ச மலர்களைக் காம்பு களையாமல் சூடினால், அவற்றால் நொந்து வருத்தும் அவளுடைய இடைக்குப் பறைகள் நல்லனவாய் ஒலியா.","en":"No merry drums will be beaten for the (tender) waist of her who has adorned herself with the anicham without having removed its stem","lines":[{"t":"அனிச்சப்பூக் கால்களையாள் பெய்தாள் நுகப்பிற்கு","err":null,"seers":[{"w":"அனிச்சப்பூக்","n