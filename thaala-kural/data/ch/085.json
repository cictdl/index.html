[{"n":841,"ch":85,"l1":"அறிவின்மை இன்மையுள் இன்மை பிறிதின்மை","l2":"இன்மையா வையா துலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அறியாமையே இல்லாமைப் பலவற்றுளளும் கொடிய இல்லாமையாகும், மற்ற இல்லாமைகளை உலகம் அத்தகைய இல்லாமையாகக் கருதாது.","en":"The want of wisdom is the greatest of all wants; but that of wealth the world will not regard as such","lines":[{"t":"அறிவின்மை இன்மையுள் இன்மை பிறிதின்மை","err":null,"seers":[{"w":"அறிவின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வின்"},{"k":"N","s":"மை"}]},{"w":"இன்மையுள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"},{"k":"N","s":"யுள்"}]},{"w":"இன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"}]},{"w":"பிறிதின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறி"},{"k":"N","s":"தின்"},{"k":"N","s":"மை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இன்மையா வையா துலகு.","err":null,"seers":[{"w":"இன்மையா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"},{"k":"N","s":"யா"}]},{"w":"வையா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வை"},{"k":"N","s":"யா"}]},{"w":"துலகு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துல"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":842,"ch":85,"l1":"அறிவிலான் நெஞ்சுவந்து ஈதல் பிறிதியாதும்","l2":"இல்லை பெறுவான் தவம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அறிவில்லாதவவன் மனம் மகிழ்ந்து ஒரு பொருளைக் கொடுத்தலுக்கு காரணம், வேறொன்றும் இல்லை, அப் பொருளைப் பெறுகின்றவனுடைய நல்வினையே ஆகும்.","en":"(The cause of) a fool cheerfully giving (something) is nothing else but the receiver's merit (in a former birth)","lines":[{"t":"அறிவிலான் நெஞ்சுவந்து ஈதல் பிறிதியாதும்","err":null,"seers":[{"w":"அறிவிலான்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"விலான்"}]},{"w":"நெஞ்சுவந்து","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நெஞ்"},{"k":"I","s":"சுவந்"},{"k":"N","s":"து"}]},{"w":"ஈதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"தல்"}]},{"w":"பிறிதியாதும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறி"},{"k":"I","s":"தியா"},{"k":"N","s":"தும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இல்லை பெறுவான் தவம்.","err":null,"seers":[{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"பெறுவான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெறு"},{"k":"N","s":"வான்"}]},{"w":"தவம்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தவம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":843,"ch":85,"l1":"அறிவிலார் தாந்தம்மைப் பீழிக்கும் பீழை","l2":"செறுவார்க்கும் செய்தல் அரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறிவில்லாதவர் தம்மைத்தாமே துன்புறுத்தும் துன்பம் அவருடைய பகைவர்க்கும் செய்யமுடியாத அளவினதாகும்.","en":"The suffering that fools inflict upon themselves is hardly possible even to foes","lines":[{"t":"அறிவிலார் தாந்தம்மைப் பீழிக்கும் பீழை","err":null,"seers":[{"w":"அறிவிலார்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"விலார்"}]},{"w":"தாந்தம்மைப்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தாந்"},{"k":"N","s":"தம்"},{"k":"N","s":"மைப்"}]},{"w":"பீழிக்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பீ"},{"k":"N","s":"ழிக்"},{"k":"N","s":"கும்"}]},{"w":"பீழை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பீ"},{"k":"N","s":"ழை"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"செறுவார்க்கும் செய்தல் அரிது.","err":null,"seers":[{"w":"செறுவார்க்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செறு"},{"k":"N","s":"வார்க்"},{"k":"N","s":"கும்"}]},{"w":"செய்தல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தல்"}]},{"w":"அரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":844,"ch":85,"l1":"வெண்மை எனப்படுவ தியாதெனின் ஒண்மை","l2":"உடையம்யாம் என்னும் செருக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"புல்லறிவு என்று சொல்லப்படுவது யாது என்றால் யாம் அறிவுடையேம் என்று ஒருவன் தன்னைத்தான் மதித்துகொள்ளும் செருக்காகும்.","en":"What is called want of wisdom is the vanity which says, \"We are wise\"","lines":[{"t":"வெண்மை எனப்படுவ தியாதெனின் ஒண்மை","err":null,"seers":[{"w":"வெண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெண்"},{"k":"N","s":"மை"}]},{"w":"எனப்படுவ","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"எனப்"},{"k":"I","s":"படு"},{"k":"N","s":"வ"}]},{"w":"தியாதெனின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தியா"},{"k":"I","s":"தெனின்"}]},{"w":"ஒண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒண்"},{"k":"N","s":"மை"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"உடையம்யாம் என்னும் செருக்கு.","err":null,"seers":[{"w":"உடையம்யாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உடை"},{"k":"N","s":"யம்"},{"k":"N","s":"யாம்"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"செருக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செருக்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":845,"ch":85,"l1":"கல்லாத மேற்கொண் டொழுகல் கசடற","l2":"வல்லதூஉம் ஐயம் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறிவில்லாதவர் தாம் கற்காத நூல்களை கற்றவர் போல் மேற்கொண்டு நடத்தல், அவர் குற்றமறக் கற்றுவல்ல பொருளைப் பற்றியும் மற்றவர்க்கு ஐயம் உண்டாகும்.","en":"Fools pretending to know what has not been read (by them) will rouse suspicion even as to what they have thoroughly mastered","lines":[{"t":"கல்லாத மேற்கொண் டொழுகல் கசடற","err":null,"seers":[{"w":"கல்லாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லா"},{"k":"N","s":"த"}]},{"w":"மேற்கொண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மேற்"},{"k":"N","s":"கொண்"}]},{"w":"டொழுகல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"டொழு"},{"k":"N","s":"கல்"}]},{"w":"கசடற","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கச"},{"k":"I","s":"டற"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வல்லதூஉம் ஐயம் தரும்.","err":null,"seers":[{"w":"வல்லதூஉம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வல்"},{"k":"I","s":"லதூ"},{"k":"N","s":"உம்"}]},{"w":"ஐயம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஐ"},{"k":"N","s":"யம்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":846,"ch":85,"l1":"அற்றம் மறைத்தலோ புல்லறிவு தம்வயின்","l2":"குற்றம் மறையா வழி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தம்மிடத்தில் உள்ளக் குற்றத்தை அறிந்து நீக்காத போது , உடம்பில் மறைப்பதற்குரிய பகுதியை மட்டும், ஆடையால் மறைத்தல் புல்லறிவாகும்.","en":"Even to cover one's nakedness would be folly, if (one's) faults were not covered (by forsaking them)","lines":[{"t":"அற்றம் மறைத்தலோ புல்லறிவு தம்வயின்","err":null,"seers":[{"w":"அற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அற்"},{"k":"N","s":"றம்"}]},{"w":"மறைத்தலோ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மறைத்"},{"k":"I","s":"தலோ"}]},{"w":"புல்லறிவு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"புல்"},{"k":"I","s":"லறி"},{"k":"N","s":"வு"}]},{"w":"தம்வயின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தம்"},{"k":"I","s":"வயின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"குற்றம் மறையா வழி.","err":null,"seers":[{"w":"குற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குற்"},{"k":"N","s":"றம்"}]},{"w":"மறையா","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மறை"},{"k":"N","s":"யா"}]},{"w":"வழி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வழி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":847,"ch":85,"l1":"அருமறை சோரும் அறிவிலான் செய்யும்","l2":"பெருமிறை தானே த