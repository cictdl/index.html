[{"n":461,"ch":47,"l1":"அழிவதூஉம் ஆவதூஉம் ஆகி வழிபயக்கும்","l2":"ஊதியமும் சூழ்ந்து செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"(ஒரு செயலைத் தொடங்குமுன்) அதனால் அழிவதையும் அழிந்த பின் ஆவதையும், பின்பு உண்டாகும் ஊதியத்தையும் ஆராய்ந்து செய்ய வேண்டும்.","en":"Let a man reflect on what will be lost, what will be acquired and (from these) what will be his ultimate gain, and (then, let him) act","lines":[{"t":"அழிவதூஉம் ஆவதூஉம் ஆகி வழிபயக்கும்","err":null,"seers":[{"w":"அழிவதூஉம்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அழி"},{"k":"I","s":"வதூ"},{"k":"N","s":"உம்"}]},{"w":"ஆவதூஉம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"வதூ"},{"k":"N","s":"உம்"}]},{"w":"ஆகி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கி"}]},{"w":"வழிபயக்கும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வழி"},{"k":"I","s":"பயக்"},{"k":"N","s":"கும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஊதியமும் சூழ்ந்து செயல்.","err":null,"seers":[{"w":"ஊதியமும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"திய"},{"k":"N","s":"மும்"}]},{"w":"சூழ்ந்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சூழ்ந்"},{"k":"N","s":"து"}]},{"w":"செயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":462,"ch":47,"l1":"தெரிந்த இனத்தொடு தேர்ந்தெண்ணிச் செய்வார்க்கு","l2":"அரும்பொருள் யாதொன்றும் இல்","ok":true,"reseg":false,"eetru":"நாள்","boundary":["கலித்தளை"],"mv":"ஆராய்ந்து சேர்ந்த இனத்துடன் (செயலைப்பற்றி) நன்றாகத் தேர்ந்து, தாமும் எண்ணிப்பார்த்துச் செய்கின்றவர்க்கு அறிய பொருள் ஒன்றும் இல்லை.","en":"There is nothing too difficult to (be attained by) those who, before they act, reflect well themselves, and thoroughly consider (the matter) with chosen friends","lines":[{"t":"தெரிந்த இனத்தொடு தேர்ந்தெண்ணிச் செய்வார்க்கு","err":null,"seers":[{"w":"தெரிந்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தெரிந்"},{"k":"N","s":"த"}]},{"w":"இனத்தொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இனத்"},{"k":"I","s":"தொடு"}]},{"w":"தேர்ந்தெண்ணிச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தேர்ந்"},{"k":"N","s":"தெண்"},{"k":"N","s":"ணிச்"}]},{"w":"செய்வார்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"வார்க்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அரும்பொருள் யாதொன்றும் இல்","err":null,"seers":[{"w":"அரும்பொருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அரும்"},{"k":"I","s":"பொருள்"}]},{"w":"யாதொன்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"N","s":"தொன்"},{"k":"N","s":"றும்"}]},{"w":"இல்","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":463,"ch":47,"l1":"ஆக்கம் கருதி முதலிழக்கும் செய்வினை","l2":"ஊக்கார் அறிவுடை யார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பின் விளையும் ஊதியத்தைக் கருதி இப்போது கையில் உள்ள முதலை இழந்து விடக் காரணமாச் செயலை அறிவுடையோர் மேற்க்கொள்ள மாட்டார்.","en":"Wise men will not, in the hopes of profit, undertake works that will consume their principal","lines":[{"t":"ஆக்கம் கருதி முதலிழக்கும் செய்வினை","err":null,"seers":[{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"கருதி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரு"},{"k":"N","s":"தி"}]},{"w":"முதலிழக்கும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"முத"},{"k":"I","s":"லிழக்"},{"k":"N","s":"கும்"}]},{"w":"செய்வினை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"வினை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஊக்கார் அறிவுடை யார்.","err":null,"seers":[{"w":"ஊக்கார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊக்"},{"k":"N","s":"கார்"}]},{"w":"அறிவுடை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வுடை"}]},{"w":"யார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"யார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":464,"ch":47,"l1":"தெளிவி லதனைத் தொடங்கார் இளிவென்னும்","l2":"ஏதப்பாடு அஞ்சு பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இழிவு தருவதாகியக் குற்றத்திற்கு அஞ்சுகின்றவர் (இன்ன ஊதியம் பயிக்கும் என்னும்) தெளிவு இல்லாத செயலைத் தொடங்கமாட்டார்.","en":"Those who fear reproach will not commence anything which has not been (thoroughly considered) and made clear to them","lines":[{"t":"தெளிவி லதனைத் தொடங்கார் இளிவென்னும்","err":null,"seers":[{"w":"தெளிவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தெளி"},{"k":"N","s":"வி"}]},{"w":"லதனைத்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"லத"},{"k":"N","s":"னைத்"}]},{"w":"தொடங்கார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தொடங்"},{"k":"N","s":"கார்"}]},{"w":"இளிவென்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இளி"},{"k":"N","s":"வென்"},{"k":"N","s":"னும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஏதப்பாடு அஞ்சு பவர்.","err":null,"seers":[{"w":"ஏதப்பாடு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"தப்"},{"k":"N","s":"பா"},{"k":"N","s":"டு"}]},{"w":"அஞ்சு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சு"}]},{"w":"பவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":[null,"இயற்சீர் வெண்டளை"]}]},{"n":465,"ch":47,"l1":"வகையறச் சூழா தெழுதல் பகைவரைப்","l2":"பாத்திப் படுப்பதோ ராறு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"செயலின் வகைகளை எல்லாம் முற்ற எண்ணாமல் செய்யத்தொடங்குதல், பகைவரை வளரும் பாத்தியில் நிலைபெறச் செய்வதொரு வழியாகும்.","en":"One way to promote the prosperity of an enemy, is (for a king) to set out (to war) without having thoroughly weighed his ability (to cope with its chances)","lines":[{"t":"வகையறச் சூழா தெழுதல் பகைவரைப்","err":null,"seers":[{"w":"வகையறச்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வகை"},{"k":"I","s":"யறச்"}]},{"w":"சூழா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சூ"},{"k":"N","s":"ழா"}]},{"w":"தெழுதல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தெழு"},{"k":"N","s":"தல்"}]},{"w":"பகைவரைப்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பகை"},{"k":"I","s":"வரைப்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பாத்திப் படுப்பதோ ராறு.","err":null,"seers":[{"w":"பாத்திப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பாத்"},{"k":"N","s":"திப்"}]},{"w":"படுப்பதோ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"படுப்"},{"k":"I","s":"பதோ"}]},{"w":"ராறு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ரா"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":466,"ch":47,"l1":"செய்தக்க அல்ல செயக்கெடும் செய்தக்க","l2":"செய்யாமை யானுங் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவன் செய்யத்தகாத செயல்களைச் செய்வதனால் கெடுவான், செய்யத்தக்க செயல்களை செய்யாமல் விடுவதனாலும் கெடுவான்.","en":"He will perish who does not what is not fit to do; and he also will perish who does not do what it is fit to","lines":[{"t":"செய்தக்க அல்ல செயக்கெடும் செய்தக்க","err":null,"seers":[{"w":"செய்தக்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தக்"},{"k":"N","s":"க"}]},{"w":"அல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அல்"},{"k":"N","s":"ல"}]},{"w":"செயக்கெடும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"செயக்"},{"k":"I","s":"கெடும்"}]},{"w":"செய்தக்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தக்"},{"k":"N","s":"க"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செய்யாமை யானுங் கெடும்.","err":null,"seers":[{"w":"செய்யாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யா"},{"k":"N","s":"மை"}]},{"w":"யானுங்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"னுங்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":467,"ch":47,"l1":"எண்ணித் துணிக கருமம் துணிந்தபின்","l2":"எண்ணுவம் என்பது இழுக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"(செய்யத் தகுந்த) செயலையும் வழிகளை எண்ணிய பிறகே துணிந்து தொடங்க வேண்டும், துணிந்த பின் எண்ணிப் பார்க்கலாம் என்பது குற்றமாகும்.","en":"Consider, and then undertake a matter; after having undertaken it, to say \"We will consider,\" is folly","lines":[{"t":"எண்ணித் துணிக கருமம் துணிந்தபின்","err":null,"seers":[{"w":"எண்ணித்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எண்"},{"k":"N","s":"ணித்"}]},{"w":"துணிக","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துணி"},{"k":"N","s":"க"}]},{"w":"கருமம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரு"},{"k":"N","s":"மம்"}]},{"w":"துணிந்தபின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"துணிந்"},{"k":"I","s":"தபின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எண்ணுவம் என்பது இழுக்கு.","err":null,"seers":[{"w":"எண்ணுவம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எண்"},{"k":"I","s":"ணுவம்"}]},{"w":"என்பது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பது"}]},{"w":"இழுக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":468,"ch":47,"l1":"ஆற்றின் வருந்தா வருத்தம் பலர்நின்று","l2":"போற்றினும் பொத்துப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தக்கவழியில் செய்யப்படாத முயற்சி பலர் துணையாக நின்று(அதை முடிக்குமாறு) காத்த போதிலும் குறையாகிவிடும்.","en":"The work, which is not done by suitable methods, will fail though many stand to uphold it","lines":[{"t":"ஆற்றின் வருந்தா வருத்தம் பலர்நின்று","err":null,"seers":[{"w":"ஆற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றின்"}]},{"w":"வருந்தா","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வருந்"},{"k":"N","s":"தா"}]},{"w":"வருத