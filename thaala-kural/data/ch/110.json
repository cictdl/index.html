[{"n":1091,"ch":110,"l1":"இருநோக்கு இவளுண்கண் உள்ளது ஒருநோக்கு","l2":"நோய்நோக்கொன் றந்நோய் மருந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"இவளுடைய மை தீட்டிய கண்களில் உள்ளது இருவகைப்பட்ட நோக்கமாகும், அவற்றுள் ஒரு நோக்கம் நோய் செய்யும் நோக்கம், மற்றொன்று அந் நோய்க்கு மருந்தாகும்.","en":"There are two looks in the dyed eyes of this (fair one); one causes pain, and the other is the cure thereof","lines":[{"t":"இருநோக்கு இவளுண்கண் உள்ளது ஒருநோக்கு","err":null,"seers":[{"w":"இருநோக்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இரு"},{"k":"N","s":"நோக்"},{"k":"N","s":"கு"}]},{"w":"இவளுண்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இவ"},{"k":"N","s":"ளுண்"},{"k":"N","s":"கண்"}]},{"w":"உள்ளது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளது"}]},{"w":"ஒருநோக்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"நோக்"},{"k":"N","s":"கு"}]}],"thalai":["கலித்தளை","வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]},{"t":"நோய்நோக்கொன் றந்நோய் மருந்து.","err":null,"seers":[{"w":"நோய்நோக்கொன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோய்"},{"k":"N","s":"நோக்"},{"k":"N","s":"கொன்"}]},{"w":"றந்நோய்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றந்"},{"k":"N","s":"நோய்"}]},{"w":"மருந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மருந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1092,"ch":110,"l1":"கண்களவு கொள்ளும் சிறுநோக்கம் காமத்தில்","l2":"செம்பாகம் அன்று பெரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"கண்ணால் என்னை நோக்கிக் களவு கொள்கின்ற சுருங்கிய பார்வை காமத்தில் நேர்பாதி அன்று, அதைவிடப் பெரிய பகுதியாகும்.","en":"A single stolen glance of her eyes is more than half the pleasure (of sexual embrace)","lines":[{"t":"கண்களவு கொள்ளும் சிறுநோக்கம் காமத்தில்","err":null,"seers":[{"w":"கண்களவு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"I","s":"கள"},{"k":"N","s":"வு"}]},{"w":"கொள்ளும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"ளும்"}]},{"w":"சிறுநோக்கம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறு"},{"k":"N","s":"நோக்"},{"k":"N","s":"கம்"}]},{"w":"காமத்தில்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"மத்"},{"k":"N","s":"தில்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"செம்பாகம் அன்று பெரிது.","err":null,"seers":[{"w":"செம்பாகம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செம்"},{"k":"N","s":"பா"},{"k":"N","s":"கம்"}]},{"w":"அன்று","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"று"}]},{"w":"பெரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1093,"ch":110,"l1":"நோக்கினாள் நோக்கி இறைஞ்சினாள் அஃதவள்","l2":"யாப்பினுள் அட்டிய நீர்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"என்னை நோக்கினாள், யான் கண்டதும் நோக்கித் தலைகுனிந்தால், அது அவள் வளர்க்கும் அன்பினுள் வார்க்கின்ற நீராகும்.","en":"She has looked (at men) and stooped (her head); and that (sign) waters as it were (the corn of) our love","lines":[{"t":"நோக்கினாள் நோக்கி இறைஞ்சினாள் அஃதவள்","err":null,"seers":[{"w":"நோக்கினாள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நோக்"},{"k":"I","s":"கினாள்"}]},{"w":"நோக்கி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோக்"},{"k":"N","s":"கி"}]},{"w":"இறைஞ்சினாள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இறைஞ்"},{"k":"I","s":"சினாள்"}]},{"w":"அஃதவள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஃ"},{"k":"I","s":"தவள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"யாப்பினுள் அட்டிய நீர்.","err":null,"seers":[{"w":"யாப்பினுள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யாப்"},{"k":"I","s":"பினுள்"}]},{"w":"அட்டிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அட்"},{"k":"I","s":"டிய"}]},{"w":"நீர்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"நீர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1094,"ch":110,"l1":"யான்நோக்கும் காலை நிலன்நோக்கும் நோக்காக்கால்","l2":"தான்நோக்கி மெல்ல நகும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"யான் நோக்கும் போது அவள் நிலத்தை நோக்குவாள், யான் நோக்காத போது அவள் என்னை நோக்கி மெல்லத் தனக்குள் மகிழ்வாள்.","en":"When I look, she looks down; when I do not, she looks and smiles gently","lines":[{"t":"யான்நோக்கும் காலை நிலன்நோக்கும் நோக்காக்கால்","err":null,"seers":[{"w":"யான்நோக்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யான்"},{"k":"N","s":"நோக்"},{"k":"N","s":"கும்"}]},{"w":"காலை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"லை"}]},{"w":"நிலன்நோக்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நிலன்"},{"k":"N","s":"நோக்"},{"k":"N","s":"கும்"}]},{"w":"நோக்காக்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோக்"},{"k":"N","s":"காக்"},{"k":"N","s":"கால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தான்நோக்கி மெல்ல நகும்.","err":null,"seers":[{"w":"தான்நோக்கி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தான்"},{"k":"N","s":"நோக்"},{"k":"N","s":"கி"}]},{"w":"மெல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மெல்"},{"k":"N","s":"ல"}]},{"w":"நகும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"நகும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1095,"ch":110,"l1":"குறிக்கொண்டு நோக்காமை அல்லால் ஒருகண்","l2":"சிறக்கணித்தாள் போல நகும்","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"என்னை நேராகக் குறித்துப் பார்க்காத அத் தன்மையே அல்லாமல், ஒரு கண்ணைச் சுருக்கினவள் போல் என்னைப் பார்த்து தனக்குள் மகிழ்வாள்.","en":"She not only avoids a direct look at me, but looks as it were with a half-closed eye and smiles","lines":[{"t":"குறிக்கொண்டு நோக்காமை அல்லால் ஒருகண்","err":null,"seers":[{"w":"குறிக்கொண்டு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குறிக்"},{"k":"N","s":"கொண்"},{"k":"N","s":"டு"}]},{"w":"நோக்காமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோக்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"அல்லால்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அல்"},{"k":"N","s":"லால்"}]},{"w":"ஒருகண்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"கண்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சிறக்கணித்தாள் போல நகும்","err":null,"seers":[{"w":"சிறக்கணித்தாள்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறக்"},{"k":"I","s":"கணித்"},{"k":"N","s":"தாள்"}]},{"w":"போல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"ல"}]},{"w":"நகும்","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"நகும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1096,"ch":110,"l1":"உறாஅ தவர்போல் சொலினும் செறாஅர்சொல்","l2":"ஒல்லை உணரப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"புறத்தே அயலார் போல் அன்பில்லாத சொற்களைச் சொன்னாலும், அகத்தே பகையில்லாதவரின் சொல் என்பது விரைவில் அறியப்படும்.","en":"Though they may speak harshly as if they were strangers, the words of the friendly are soon understood","lines":[{"t":"உறாஅ தவர்போல் சொலினும் செறாஅர்சொல்","err":null,"seers":[{"w":"உறாஅ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உறா"},{"k":"N","s":"அ"}]},{"w":"தவர்போல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவர்"},{"k":"N","s":"போல்"}]},{"w":"சொலினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சொலி"},{"k":"N","s":"னும்"}]},{"w":"செறாஅர்சொல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செறா"},{"k":"N","s":"அர்"},{"k":"N","s":"சொல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஒல்லை உணரப் படும்.","err":null,"seers":[{"w":"ஒல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒல்"},{"k":"N","s":"லை"}]},{"w":"உணரப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உண"},{"k":"N","s":"ரப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["இயற்சீர் வ