[{"n":641,"ch":65,"l1":"நாநலம் என்னும் நலனுடைமை அந்நலம்","l2":"யாநலத்து உள்ளதூஉம் அன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நாவன்மையாகிய நலம் ஒருவகைச் செல்வம் ஆகும், அந்த நாநலம் தனிச்சிறப்புடையது, ஆகையால் மற்ற எந்த நலங்களிலும் அடங்குவது அன்று.","en":"The possession of that goodness which is called the goodness of speech is (even to others) better than any other goodness","lines":[{"t":"நாநலம் என்னும் நலனுடைமை அந்நலம்","err":null,"seers":[{"w":"நாநலம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நா"},{"k":"I","s":"நலம்"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"நலனுடைமை","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நல"},{"k":"I","s":"னுடை"},{"k":"N","s":"மை"}]},{"w":"அந்நலம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அந்"},{"k":"I","s":"நலம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"யாநலத்து உள்ளதூஉம் அன்று.","err":null,"seers":[{"w":"யாநலத்து","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"I","s":"நலத்"},{"k":"N","s":"து"}]},{"w":"உள்ளதூஉம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளதூ"},{"k":"N","s":"உம்"}]},{"w":"அன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":642,"ch":65,"l1":"ஆக்கமுங் கேடும் அதனால் வருதலால்","l2":"காத்தோம்பல் சொல்லின்கட் சோர்வு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஆக்கமும் கேடும் சொல்லுகின்ற சொல்லால் வருவதால் ஒருவன் தன்னுடைய சொல்லிற்க்கு தவறு நேராமல் காத்துக்கொள்ள வேண்டும்","en":"Since (both) wealth and evil result from (their) speech, ministers should most carefully guard themselves against faultiness therein","lines":[{"t":"ஆக்கமுங் கேடும் அதனால் வருதலால்","err":null,"seers":[{"w":"ஆக்கமுங்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆக்"},{"k":"I","s":"கமுங்"}]},{"w":"கேடும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கே"},{"k":"N","s":"டும்"}]},{"w":"அதனால்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னால்"}]},{"w":"வருதலால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வரு"},{"k":"I","s":"தலால்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"காத்தோம்பல் சொல்லின்கட் சோர்வு.","err":null,"seers":[{"w":"காத்தோம்பல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"காத்"},{"k":"N","s":"தோம்"},{"k":"N","s":"பல்"}]},{"w":"சொல்லின்கட்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லின்"},{"k":"N","s":"கட்"}]},{"w":"சோர்வு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சோர்"},{"k":"N","s":"வு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":643,"ch":65,"l1":"கேட்டார்ப் பிணிக்கும் தகையவாய்க் கேளாரும்","l2":"வேட்ப மொழிவதாம் சொல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"சொல்லும் போது கேட்டவரைத் தன் வயப்படுத்தும் பண்புகளுடன், கேட்காதவரும் கேட்க விரும்புமாறு கூறப்படுவது சொல்வன்மையாகும்.","en":"The (minister's) speech is that which seeks (to express) elements as bind his friends (to himself) and is so delivered as to make even his enemies desire (his friendship)","lines":[{"t":"கேட்டார்ப் பிணிக்கும் தகையவாய்க் கேளாரும்","err":null,"seers":[{"w":"கேட்டார்ப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேட்"},{"k":"N","s":"டார்ப்"}]},{"w":"பிணிக்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிணிக்"},{"k":"N","s":"கும்"}]},{"w":"தகையவாய்க்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தகை"},{"k":"I","s":"யவாய்க்"}]},{"w":"கேளாரும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கே"},{"k":"N","s":"ளா"},{"k":"N","s":"ரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேட்ப மொழிவதாம் சொல்.","err":null,"seers":[{"w":"வேட்ப","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேட்"},{"k":"N","s":"ப"}]},{"w":"மொழிவதாம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மொழி"},{"k":"I","s":"வதாம்"}]},{"w":"சொல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"சொல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":644,"ch":65,"l1":"திறனறிந்து சொல்லுக சொல்லை அறனும்","l2":"பொருளும் அதனினூஉங்கு இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"சொல்லின் திறத்தை அறிந்து சொல்லை வழங்க வேண்டும், அத் தகைய சொல்வன்மையை விடச் சிறந்த அறமும் பொருளும் இல்லை.","en":"Understand the qualities (of your hearers) and (then) make your speech; for superior to it, there is neither virtue nor wealth","lines":[{"t":"திறனறிந்து சொல்லுக சொல்லை அறனும்","err":null,"seers":[{"w":"திறனறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"திற"},{"k":"I","s":"னறிந்"},{"k":"N","s":"து"}]},{"w":"சொல்லுக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லுக"}]},{"w":"சொல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லை"}]},{"w":"அறனும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அற"},{"k":"N","s":"னும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பொருளும் அதனினூஉங்கு இல்.","err":null,"seers":[{"w":"பொருளும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளும்"}]},{"w":"அதனினூஉங்கு","name":"கருவிளந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"அத"},{"k":"I","s":"னினூ"},{"k":"N","s":"உங்"},{"k":"N","s":"கு"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["இயற்சீர் வெண்டளை",null]}]},{"n":645,"ch":65,"l1":"சொல்லுக சொல்லைப் பிறிதோர்சொல் அச்சொல்லை","l2":"வெல்லுஞ்சொல் இன்மை அறிந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"வேறோரு சொல் அந்தச் சொல்லை வெல்லும் சொல்லாக இல்லாதிருந்தால் அறிந்த பிறகே சொல்லக்கருதியதைச் சொல்லவேண்டும்.","en":"Deliver your speech, after assuring yourself that no counter speech can defeat your own","lines":[{"t":"சொல்லுக சொல்லைப் பிறிதோர்சொல் அச்சொல்லை","err":null,"seers":[{"w":"சொல்லுக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லுக"}]},{"w":"சொல்லைப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லைப்"}]},{"w":"பிறிதோர்சொல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறி"},{"k":"N","s":"தோர்"},{"k":"N","s":"சொல்"}]},{"w":"அச்சொல்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அச்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வெல்லுஞ்சொல் இன்மை அறிந்து.","err":null,"seers":[{"w":"வெல்லுஞ்சொல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வெல்"},{"k":"N","s":"லுஞ்"},{"k":"N","s":"சொல்"}]},{"w":"இன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"}]},{"w":"அறிந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறிந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":646,"ch":65,"l1":"வேட்பத்தாஞ் சொல்லிப் பிறர்சொல் பயன்கோடல்","l2":"மாட்சியின் மாசற்றார் கோள்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பிறர் விரும்பும் படியாகத் தாம் சொல்லின் பிறர் சொல்லும் போது அச் சொல்லின் பயனை ஆராய்ந்து கொள்ளுதல் மாசற்ற சிறப்புடையவரின் கொள்கையாகும்.","en":"It is the opinion of those who are free from defects in diplomacy that the minister should speak so as to make his hearers desire (to hear more) and grasp the meaning of what he hears himself","lines":[{"t":"வேட்பத்தாஞ் சொல்லிப் பிறர்சொல் பயன்கோடல்","err":null,"seers":[{"w":"வேட்பத்தாஞ்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேட்"},{"k":"N","s":"பத்"},{"k":"N","s":"தாஞ்"}]},{"w":"சொல்லிப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லிப்"}]},{"w":"பிறர்சொல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிறர்"},{"k":"N","s":"சொல்"}]},{"w":"பயன்கோடல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பயன்"},{"k":"N","s":"கோ"},{"k":"N","s":"டல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாட்சியின் மாசற்றார் கோள்.","err":null,"seers":[{"w":"மாட்சியின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மாட்"},{"k":"I","s":"சியின்"}]},{"w":"மாசற்றார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"N","s":"சற்"},{"k":"N","s":"றார்"}]},{"w":"கோள்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கோள்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":647,"ch":65,"l1":"சொலல்வல்லன் சோர்விலன் அஞ்சான் அவனை","l2":"இகல்வெல்லல் யார்க்கும் அரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தான் கருதியவற்றை நன்கு சொல்ல வல்லவனாய் சொல்லும் போது சோர்வு இல்லாதவனாய், அஞ்சாதவனாய் உள்ளவனை மாறுபாட்டால் வெல்வது யார்க்கும் முடியாது.","en":"It is impossible for any one to conquer him by intrique who possesses power of speech, and is neither faulty nor timid","lines":[{"t":"சொலல்வல்லன் சோர்விலன் அஞ்சான் அவனை","err":null,"seers":[{"w":"சொலல்வல்லன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சொலல்"},{"k":"N","s":"வல்"},{"k":"N","s":"லன்"}]},{"w":"சோர்விலன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சோர்"},{"k":"I","s":"விலன்"}]},{"w":"அஞ்சான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சான்"}]},{"w":"அவனை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அவ"},{"k":"N","s":"னை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இகல்வெல்லல் யார்க்கும் அரிது.","err":null,"seers":[{"w":"இகல்வெல்லல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இகல்"},{"k":"N","s":"வெல்"},{"k":"N","s":"லல்"}]},{"w":"யார்க்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யார்க்"},{"k":"N","s":"கும்"}]},{"w":"அரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":648,"ch":65,"l1":"விரைந்து தொழில்கேட்கும் ஞாலம் நிரந்தினிது","l2":"சொல்லுதல் வல்லார்ப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கருத்துக்களை ஒழுங்காகக் கோர்த்து இனியாக சொல்ல வல்லவரைப் பெற்றால், உலகம் விரைந்து அவருடைய ஏவலைக் கேட்டு நடக்கும்.","en":"If there be those who can speak on various subjects in their proper order and in a pleasing manner, the world would readily accept them","lines":[{"t":"விரைந்து தொழில்கேட்கும் ஞாலம் நிரந்தினிது","err":null,"seers":[{"w":"விரைந்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விரைந்"},{"k":"N","s":"து"}]},{"w":"தொழில்கேட்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தொழில்"},{"k":"N","s":"கேட்"},{"k":"N","s":"கும்"}]},{"w":"ஞாலம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஞா"},{"k":"N","s":"லம்"}]},{"w":"நிரந்தினிது","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நிரந்"},{"k":"I","s":"தினி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சொல்லுதல் வல்லார்ப் பெறின்.","err":null,"seers":[{"w":"சொல்லுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லுதல்"}]},{"w":"வல்லார்ப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வல்"},{"k":"N","s":"லார்ப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":649,"ch":65,"l1":"பலசொல்லக் காமுறுவர் மன்றமா சற்ற","l2":"சிலசொல்லல் தேற்றா தவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"குற்றமற்றவையாகியச் சில சொற்களைச் சொல்லத் தெரியாதவர், உண்மையாகவே பலச் சொற்களைச் சொல்லிக்கொண்டிருக்க விரும்புவர்.","en":"They will desire to utter many words, who do not know how to speak a few faultless ones","lines":[{"t":"பலசொல்லக் காமுறுவர் மன்றமா சற்ற","err":null,"seers":[{"w":"பலசொல்லக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பல"},{"k":"N","s":"சொல்"},{"k":"N","s":"லக்"}]},{"w":"காமுறுவர்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"I","s":"முறு"},{"k":"N","s":"வர்"}]},{"w":"மன்றமா","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"றமா"}]},{"w":"சற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சற்"},{"k":"N","s":"ற"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சிலசொல்லல் தேற்றா தவர்.","err":null,"seers":[{"w":"சிலசொல்லல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சில"},{"k":"N","s":"சொல்"},{"k":"N","s":"லல்"}]},{"w":"தேற்றா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தேற்"},{"k":"N","s":"றா"}]},{"w":"தவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":650,"ch":65,"l1":"இணருழ்த்தும் நாறா மலரனையர் கற்றது","l2":"உணர விரித்துரையா தார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["நிரையொன்றிய ஆசிரியத்தளை"],"mv":"தாம் கற்ற நூற்ப் பொருளைப் பிறர் உணருமாறு விரிந்துரைக்க முடியாதவர், கொத்தாக மலர்ந்திருந்த போதிலும் மணம் கமழாத மலரைப் போன்றவர்.","en":"Those who are unable to set forth their acquirements (before others) are like flowers blossoming in a cluster and yet without fragrance","lines":[{"t":"இணருழ்த்தும் நாறா மலரனையர் கற்றது","err":null,"seers":[{"w":"இணருழ்த்தும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இண"},{"k":"N","s":"ருழ்த்"},{"k":"N","s":"தும்"}]},{"w":"நாறா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"றா"}]},{"w":"மலரனையர்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"மல"},{"k":"I","s":"ரனை"},{"k":"N","s":"யர்"}]},{"w":"கற்றது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கற்"},{"k":"I","s":"றது"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"உணர விரித்துரையா தார்.","err":null,"seers":[{"w":"உணர","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உண"},{"k":"N","s":"ர"}]},{"w":"விரித்துரையா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"விரித்"},{"k":"I","s":"துரை"},{"k":"N","s":"யா"}]},{"w":"தார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]}]