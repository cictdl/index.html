[{"n":1161,"ch":117,"l1":"மறைப்பேன்மன் யானிஃதோ நோயை இறைப்பவர்க்கு","l2":"ஊற்றுநீர் போல மிகும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இக் காமநோயைப் பிறர் அறியாமல் யான் மறைப்பேன், ஆனால் இது இறைப்பவர்க்கு ஊற்று நீர் மிகுவது போல் மிகுகின்றது.","en":"I would hide this pain from others; but it (only) swells like a spring to those who drain it","lines":[{"t":"மறைப்பேன்மன் யானிஃதோ நோயை இறைப்பவர்க்கு","err":null,"seers":[{"w":"மறைப்பேன்மன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மறைப்"},{"k":"N","s":"பேன்"},{"k":"N","s":"மன்"}]},{"w":"யானிஃதோ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"N","s":"னிஃ"},{"k":"N","s":"தோ"}]},{"w":"நோயை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோ"},{"k":"N","s":"யை"}]},{"w":"இறைப்பவர்க்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இறைப்"},{"k":"I","s":"பவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஊற்றுநீர் போல மிகும்.","err":null,"seers":[{"w":"ஊற்றுநீர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊற்"},{"k":"I","s":"றுநீர்"}]},{"w":"போல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"ல"}]},{"w":"மிகும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"மிகும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1162,"ch":117,"l1":"கரத்தலும் ஆற்றேன்இந் நோயைநோய் செய்தார்க்கு","l2":"உரைத்தலும் நாணுத் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["கலித்தளை"],"mv":"இக் காமநோயைப் பிறர் அறியாமல் முற்றிலும் மறைக்கவும் முடியவில்லை, நோய் செய்த காதலர்க்குச் சொல்வதும் நாணம் தருகின்றது.","en":"I cannot conceal this pain, nor can I relate it without shame to him who has caused it","lines":[{"t":"கரத்தலும் ஆற்றேன்இந் நோயைநோய் செய்தார்க்கு","err":null,"seers":[{"w":"கரத்தலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரத்"},{"k":"I","s":"தலும்"}]},{"w":"ஆற்றேன்இந்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றேன்"},{"k":"N","s":"இந்"}]},{"w":"நோயைநோய்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோ"},{"k":"N","s":"யை"},{"k":"N","s":"நோய்"}]},{"w":"செய்தார்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தார்க்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"உரைத்தலும் நாணுத் தரும்.","err":null,"seers":[{"w":"உரைத்தலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உரைத்"},{"k":"I","s":"தலும்"}]},{"w":"நாணுத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணுத்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1163,"ch":117,"l1":"காமமும் நாணும் உயிர்காவாத் தூங்கும்என்","l2":"நோனா உடம்பின் அகத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"துன்பத்தைப் பொருக்காமல் வருந்துகின்ற என் உடம்பினிடத்தில் உயிரே காவடித்தண்டாகக் கொண்டு காமநோயும் நாணமும் இருப்பக்கமாக தொங்குகின்றன.","en":"(Both) lust and shame, with my soul for their shoulder pole balance themselves on a body that cannot bear them","lines":[{"t":"காமமும் நாணும் உயிர்காவாத் தூங்கும்என்","err":null,"seers":[{"w":"காமமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கா"},{"k":"I","s":"மமும்"}]},{"w":"நாணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணும்"}]},{"w":"உயிர்காவாத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உயிர்"},{"k":"N","s":"கா"},{"k":"N","s":"வாத்"}]},{"w":"தூங்கும்என்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தூங்"},{"k":"N","s":"கும்"},{"k":"N","s":"என்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நோனா உடம்பின் அகத்து.","err":null,"seers":[{"w":"நோனா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோ"},{"k":"N","s":"னா"}]},{"w":"உடம்பின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடம்"},{"k":"N","s":"பின்"}]},{"w":"அகத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அகத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1164,"ch":117,"l1":"காமக் கடல்மன்னும் உண்டே அதுநீந்தும்","l2":"ஏமப் புணைமன்னும் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"காமநோயாகிய கடல் இருக்கின்றது. ஆனால் அதை நீந்திக்கடந்து செல்வதற்கு வேண்டிய காவலான ‌தோணியோ இல்லை.","en":"There is indeed a flood of lust; but there is no raft of safety to cross it with","lines":[{"t":"காமக் கடல்மன்னும் உண்டே அதுநீந்தும்","err":null,"seers":[{"w":"காமக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"மக்"}]},{"w":"கடல்மன்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கடல்"},{"k":"N","s":"மன்"},{"k":"N","s":"னும்"}]},{"w":"உண்டே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டே"}]},{"w":"அதுநீந்தும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அது"},{"k":"N","s":"நீந்"},{"k":"N","s":"தும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஏமப் புணைமன்னும் இல்.","err":null,"seers":[{"w":"ஏமப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"மப்"}]},{"w":"புணைமன்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"புணை"},{"k":"N","s":"மன்"},{"k":"N","s":"னும்"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1165,"ch":117,"l1":"துப்பின் எவனாவர் மன்கொல் துயர்வரவு","l2":"நட்பினுள் ஆற்று பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"( இன்பமான) நட்பிலேயே துயரத்தை வரச் செய்வதில் வல்லவர். ( துன்பம் தரும் பகையை வெல்லும்) வலிமை வேண்டும்போது என்ன ஆவாரோ?","en":"What will they prove when angry tempests lower?","lines":[{"t":"துப்பின் எவனாவர் மன்கொல் துயர்வரவு","err":null,"seers":[{"w":"துப்பின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"துப்"},{"k":"N","s":"பின்"}]},{"w":"எவனாவர்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எவ"},{"k":"N","s":"னா"},{"k":"N","s":"வர்"}]},{"w":"மன்கொல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மன்"},{"k":"