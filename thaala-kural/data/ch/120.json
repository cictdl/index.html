":"N","s":"கொண்"},{"k":"N","s":"டார்"}]},{"w":"நமக்கெவன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நமக்"},{"k":"I","s":"கெவன்"}]},{"w":"செய்பவோ","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"பவோ"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தாம்காதல் கொள்ளாக் கடை.","err":null,"seers":[{"w":"தாம்காதல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தாம்"},{"k":"N","s":"கா"},{"k":"N","s":"தல்"}]},{"w":"கொள்ளாக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"ளாக்"}]},{"w":"கடை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கடை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1196,"ch":120,"l1":"ஒருதலையான் இன்னாது காமம்காப் போல","l2":"இருதலை யானும் இனிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"காதல் ஒரு பக்கமாக இருத்தல் துன்பமானது; காவடியின் பாரம் போல் இருபக்கமாகவும் ஒத்திருப்பது இன்பமானதாகும்.","en":"Lust, like the weight of the KAVADI, pains if it lies in one end only but pleases if it is in both","lines":[{"t":"ஒருதலையான் இன்னாது காமம்காப் போல","err":null,"seers":[{"w":"ஒருதலையான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"I","s":"தலை"},{"k":"N","s":"யான்"}]},{"w":"இன்னாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"N","s":"து"}]},{"w":"காமம்காப்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"மம்"},{"k":"N","s":"காப்"}]},{"w":"போல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"ல"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இருதலை யானும் இனிது.","err":null,"seers":[{"w":"இருதலை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இரு"},{"k":"I","s":"தலை"}]},{"w":"யானும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"னும்"}]},{"w":"இனிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இனி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":