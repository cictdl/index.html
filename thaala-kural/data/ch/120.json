[{"n":1191,"ch":120,"l1":"தாம்வீழ்வார் தம்வீழப் பெற்றவர் பெற்றாரே","l2":"காமத்துக் காழில் கனி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தாம் விரும்பும் காதலர் தம்மை விரும்புகின்ற பேறு பெற்றவர், காதல் வாழ்க்கையின் பயனாகிய விதை இல்லாத பழத்தைப் பெற்றவரே ஆவார்.","en":"The women who are beloved by those whom they love, have they have not got the stone-less fruit of sexual delight ?","lines":[{"t":"தாம்வீழ்வார் தம்வீழப் பெற்றவர் பெற்றாரே","err":null,"seers":[{"w":"தாம்வீழ்வார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தாம்"},{"k":"N","s":"வீழ்"},{"k":"N","s":"வார்"}]},{"w":"தம்வீழப்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தம்"},{"k":"N","s":"வீ"},{"k":"N","s":"ழப்"}]},{"w":"பெற்றவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பெற்"},{"k":"I","s":"றவர்"}]},{"w":"பெற்றாரே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பெற்"},{"k":"N","s":"றா"},{"k":"N","s":"ரே"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"காமத்துக் காழில் கனி.","err":null,"seers":[{"w":"காமத்துக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"மத்"},{"k":"N","s":"துக்"}]},{"w":"காழில்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ழில்"}]},{"w":"கனி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கனி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1192,"ch":120,"l1":"வாழ்வார்க்கு வானம் பயந்தற்றால் வீழ்வார்க்கு","l2":"வீழ்வார் அளிக்கும் அளி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தம்மை விரும்புகின்றவர்க்குக் காதலர் அளிக்கும் அன்பு, உயிர் வாழ்கினறவர்க்கு மேகம் மழை பெய்து காப்பாற்றுதலைப் போன்றது.","en":"The bestowal of love by the beloved on those who love them is like the rain raining (at the proper season) on those who live by it","lines":[{"t":"வாழ்வார்க்கு வானம் பயந்தற்றால் வீழ்வார்க்கு","err":null,"seers":[{"w":"வாழ்வார்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"வார்க்"},