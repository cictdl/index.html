[{"n":581,"ch":59,"l1":"ஒற்றும் உரைசான்ற நூலும் இவையிரண்டும்","l2":"தெற்றென்க மன்னவன் கண்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒற்றரும் புகழ் அமைந்த நீதிநூலும் ஆகிய இவ்விருவகைக் கருவிகளையும் அரசன் தன்னுடைய கண்களாகத் தெளியவேணடும்.","en":"Let a king consider as his eyes these two things, a spy and a book (of laws) universally esteemed","lines":[{"t":"ஒற்றும் உரைசான்ற நூலும் இவையிரண்டும்","err":null,"seers":[{"w":"ஒற்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒற்"},{"k":"N","s":"றும்"}]},{"w":"உரைசான்ற","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உரை"},{"k":"N","s":"சான்"},{"k":"N","s":"ற"}]},{"w":"நூலும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நூ"},{"k":"N","s":"லும்"}]},{"w":"இவையிரண்டும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இவை"},{"k":"I","s":"யிரண்"},{"k":"N","s":"டும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தெற்றென்க மன்னவன் கண்.","err":null,"seers":[{"w":"தெற்றென்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தெற்"},{"k":"N","s":"றென்"},{"k":"N","s":"க"}]},{"w":"மன்னவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னவன்"}]},{"w":"கண்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கண்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":582,"ch":59,"l1":"எல்லார்க்கும் எல்லாம் நிகழ்பவை எஞ்ஞான்றும்","l2":"வல்லறிதல் வேந்தன் தொழில்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"எல்லாரிடத்திலும் நிகழ்கின்றவை எல்லாவற்றையும் எக்காலத்திலும் (ஒற்றரைக் கொண்டு) விரைந்து அறிதல் அரசனுக்குரிய தொழிலாகும்.","en":"'Tis duty of the king to learn with speed","lines":[{"t":"எல்லார்க்கும் எல்லாம் நிகழ்பவை எஞ்ஞான்றும்","err":null,"seers":[{"w":"எல்லார்க்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லார்க்"},{"k":"N","s":"கும்"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"நிகழ்பவை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நிகழ்"},{"k":"I","s":"பவை"}]},{"w":"எஞ்ஞான்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எஞ்"},{"k":"N","s":"ஞான்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வல்லறிதல் வேந்தன் தொழில்.","err":null,"seers":[{"w":"வல்லறிதல்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வல்"},{"k":"I","s":"லறி"},{"k":"N","s":"தல்"}]},{"w":"வேந்தன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"தன்"}]},{"w":"தொழில்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தொழில்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":583,"ch":59,"l1":"ஒற்றினான் ஒற்றிப் பொருள்தெரியா மன்னவன்","l2":"கொற்றங் கொளக்கிடந்தது இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒற்றரால் (நாட்டு நிகழ்ச்சிகளை) அறிந்து அவற்றின் பயனை ஆராய்ந்துணராத அரசன் வெற்றிபெறத்தக்க வழி வேறு இல்லை.","en":"There is no way for a king to obtain conquests, who knows not the advantage of discoveries made by a spy","lines":[{"t":"ஒற்றினான் ஒற்றிப் பொருள்தெரியா மன்னவன்","err":null,"seers":[{"w":"ஒற்றினான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஒற்"},{"k":"I","s":"றினான்"}]},{"w":"ஒற்றிப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒற்"},{"k":"N","s":"றிப்"}]},{"w":"பொருள்தெரியா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருள்"},{"k":"I","s":"தெரி"},{"k":"N","s":"யா"}]},{"w":"மன்னவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னவன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கொற்றங் கொளக்கிடந்தது இல்.","err":null,"seers":[{"w":"கொற்றங்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொற்"},{"k":"N","s":"றங்"}]},{"w":"கொளக்கிடந்தது","name":"கருவிளங்கனி","cls":"கனி","a":[{"k":"I","s":"கொளக்"},{"k":"I","s":"கிடந்"},{"k":"I","s":"தது"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["இயற்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை"]}]},{"n":584,"ch":59,"l1":"வினைசெய்வார் தம்சுற்றம் வேண்டாதார் என்றாங்கு","l2":"அனைவரையும் ஆராய்வது ஒற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["கலித்தளை"],"mv":"தம்முடைய தொழிலைச் செய்கின்றவர், தம் சுற்றத்தார், தம் பகைவர் என்றுக்கூறப்படும் எல்லாரையும் ஆராய்வதே ஒற்றரின் தொழிலாகும்.","en":"He is a spy who watches all men, to wit, those who are in the king's employment, his relatives, and his enemies","lines":[{"t":"வினைசெய்வார் தம்சுற்றம் வேண்டாதார் என்றாங்கு","err":null,"seers":[{"w":"வினைசெய்வார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வினை"},{"k":"N","s":"செய்"},{"k":"N","s":"வார்"}]},{"w":"தம்சுற்றம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தம்"},{"k":"N","s":"சுற்"},{"k":"N","s":"றம்"}]},{"w":"வேண்டாதார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டா"},{"k":"N","s":"தார்"}]},{"w":"என்றாங்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"N","s":"றாங்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அனைவரையும் ஆராய்வது ஒற்று.","err":null,"seers":[{"w":"அனைவரையும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அனை"},{"k":"I","s":"வரை"},{"k":"N","s":"யும்"}]},{"w":"ஆராய்வது","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"ராய்"},{"k":"I","s":"வது"}]},{"w":"ஒற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒற்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை"]}]},{"n":585,"ch":59,"l1":"கடாஅ உருவொடு கண்ணஞ்சாது யாண்டும்","l2":"உகாஅமை வல்லதே ஒற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஐயுற முடியாத உருவத்தோடு, பார்த்தவருடைய கண் பார்வைக்கு அஞ்சாமல் எவ்விடத்திலும் மனதிலுள்ளதை வெளிப்படுத்தாமல் இருக்க வல்லவனே ஒற்றன் ஆவன்.","en":"A spy is one who is able to assume an appearance which may create no suspicion (in the minds of others), who fears no man's face, and who never reveals (his purpose)","lines":[{"t":"கடாஅ உருவொடு கண்ணஞ்சாது யாண்டும்","err":null,"seers":[{"w":"கடாஅ","name":"புளிமா","cls":