[{"n":951,"ch":96,"l1":"இற்பிறந்தார் கண்அல்லது இல்லை இயல்பாகச்","l2":"செப்பமும் நாணும் ஒருங்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"நடுவு நிமையும் நாணமும் உயர்குடியில் பிறந்தவனிடத்தில் அல்லாமல் மற்றவரிடத்தில் இயல்பாக ஒருசேர அமைவதில்லை.","en":"Consistency (of thought, word and deed) and fear (of sin) are conjointly natural only to the high-born","lines":[{"t":"இற்பிறந்தார் கண்அல்லது இல்லை இயல்பாகச்","err":null,"seers":[{"w":"இற்பிறந்தார்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"இற்"},{"k":"I","s":"பிறந்"},{"k":"N","s":"தார்"}]},{"w":"கண்அல்லது","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"கண்"},{"k":"N","s":"அல்"},{"k":"I","s":"லது"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"இயல்பாகச்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இயல்"},{"k":"N","s":"பா"},{"k":"N","s":"கச்"}]}],"thalai":["வெண்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]},{"t":"செப்பமும் நாணும் ஒருங்கு.","err":null,"seers":[{"w":"செப்பமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செப்"},{"k":"I","s":"பமும்"}]},{"w":"நாணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணும்"}]},{"w":"ஒருங்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒருங்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":952,"ch":96,"l1":"ஒழுக்கமும் வாய்மையும் நாணும்இம் மூன்றும்","l2":"இழுக்கார் குடிப்பிறந் தார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"உயர் குடியில் பிறந்தவர் ஒழுக்கமும் வாய்மையும் நாணமும் ஆகிய இம் மூன்றிலிருந்தும் வழுவாமல் இயல்பாகவே நன்னெறியில் வாழ்வர்.","en":"The high-born will never deviate from these three; good manners, truthfulness and modesty","lines":[{"t":"ஒழுக்கமும் வாய்மையும் நாணும்இம் மூன்றும்","err":null,"seers":[{"w":"ஒழுக்கமும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"ஒழுக்"},{"k":"I","s":"கமும்"}]},{"w":"வாய்மையும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாய்"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"நாணும்இம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணும்"},{"k":"N","s":"இம்"}]},{"w":"மூன்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மூன்"},{"k":"N","s":"றும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இழுக்கார் குடிப்பிறந் தார்.","err":null,"seers":[{"w":"இழுக்கார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"கார்"}]},{"w":"குடிப்பிறந்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"குடிப்"},{"k":"I","s":"பிறந்"}]},{"w":"தார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":953,"ch":96,"l1":"நகைஈகை இன்சொல் இகழாமை நான்கும்","l2":"வகையென்ப வாய்மைக் குடிக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"உண்மையான உயர்குடியில் பிறந்தவர்க்கு முகமலர்ச்சி, ஈகை, இனிய சொல், பிறரை இகழ்ந்து கூறாமை ஆகிய நான்கும் நல்லப் பண்புகள் என்பர்.","en":"A cheerful countenance, liberality, pleasant words, and an unreviling disposition, these four are said to be the proper qualities of the truly high-born","lines":[{"t":"நகைஈகை இன்சொல் இகழாமை நான்கும்","err":null,"seers":[{"w":"நகைஈகை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நகை"},{"k":"N","s":"ஈ"},{"k":"N","s":"கை"}]},{"w":"இன்சொல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"சொல்"}]},{"w":"இகழாமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இக"},{"k":"N","s":"ழா"},{"k":"N","s":"மை"}]},{"w":"நான்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நான்"},{"k":"N","s":"கும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வகையென்ப வாய்மைக் குடிக்கு.","err":null,"seers":[{"w":"வகையென்ப","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வகை"},{"k":"N","s":"யென்"},{"k":"N","s":"ப"}]},{"w":"வாய்மைக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாய்"},{"k":"N","s":"மைக்"}]},{"w":"குடிக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குடிக்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":954,"ch":96,"l1":"அடுக்கிய கோடி பெறினும் குடிப்பிறந்தார்","l2":"குன்றுவ செய்தல் இலர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பல கோடிப் பொருளைப் பெறுவதாக இருந்தாலும் உயர்குடியில் பிறந்தவர் தம் குடியின் சிறப்புக் குன்றுவதற்கு காரணமான குற்றங்களைச் செய்வதில்லை.","en":"Though blessed with immense wealth, the noble will never do anything unbecoming","lines":[{"t":"அடுக்கிய கோடி பெறினும் குடிப்பிறந்தார்","err":null,"seers":[{"w":"அடுக்கிய","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அடுக்"},{"k":"I","s":"கிய"}]},{"w":"கோடி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கோ"},{"k":"N","s":"டி"}]},{"w":"பெறினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெறி"},{"k":"N","s":"னும்"}]},{"w":"குடிப்பிறந்தார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குடிப்"},{"k":"I","s":"பிறந்"},{"k":"N","s":"தார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"குன்றுவ செய்தல் இலர்.","err":null,"seers":[{"w":"குன்றுவ","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"குன்"},{"k":"I","s":"றுவ"}]},{"w":"செய்தல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தல்"}]},{"w":"இலர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"இலர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":955,"ch":96,"l1":"வழங்குவ துள்வீழ்ந்தக் கண்ணும் பழங்குடி","l2":"பண்பில் தலைப்பிரிதல் இன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தாம் பிறர்க்குக் கொடுத்துதவும் வன்மை வறுமையால் சுருங்கிய போதிலும், பழம் பெருமை உடைய குடியில் பிறந்தவர் தம் பண்பிலிருந்து நீங்குவதில்லை.","en":"Though their means fall off, those born in ancient families, will not lose their character (for liberality)","lines":[{"t":"வழங்குவ துள்வீழ்ந்தக் கண்ணும் பழங்குடி","err":null,"seers":[{"w":"வழங்குவ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வழங்"},{"k":"I","s":"குவ"}]},{"w":"துள்வீழ்ந்தக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"துள்"},{"k":"N","s":"வீழ்ந்"},{"k":"N","s":"தக்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"பழங்குடி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பழங்"},{"k":"I","s":"குடி"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பண்பில் தலைப்பிரிதல் இன்று.","err":null,"seers":[{"w":"பண்பில்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பண்"},{"k":"N","s":"பில்"}]},{"w":"தலைப்பிரிதல்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தலைப்"},{"k":"I","s":"பிரி"},{"k":"N","s":"தல்"}]},{"w":"இன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":956,"ch":96,"l1":"சலம்பற்றிச் சால்பில செய்யார்மா சற்ற","l2":"குலம்பற்றி வாழ்தும் என் பார்.","ok":true,"reseg":true,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மாசற்ற குடிப் பண்புடன் வாழ்வோம் என்று கருதி வாழ்வோர், வஞ்சனைக் கொண்டு தகுதியில்லாதவற்றைக் செய்யமாட்டார்.","en":"Those who seek to preserve the irreproachable honour of their families will not viciously do what is detrimental thereto","lines":[{"t":"சலம்பற்றிச் சால்பில செய்யார்மா சற்ற","err":null,"seers":[{"w":"சலம்பற்றிச்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சலம்"},{"k":"N","s":"பற்"},{"k":"N","s":"றிச்"}]},{"w":"சால்பில","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சால்"},{"k":"I","s":"பில"}]},{"w":"செய்யார்மா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யார்"},{"k":"N","s":"மா"}]},{"w":"சற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சற்"},{"k":"N","s":"ற"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"குலம்பற்றி வாழ்தும் என் பார்.","err":null,"seers":[{"w":"குலம்பற்றி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குலம்"},{"k":"N","s":"பற்"},{"k":"N","s":"றி"}]},{"w":"வாழ்தும்என்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"தும்"},{"k":"N","s":"என்"}]},{"w":"பார்","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"பார்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":957,"ch":96,"l1":"குடிப்பிறந்தார் கண்விளங்கும் குற்றம் விசும்பின்","l2":"மதிக்கண் மறுப்போல் உயர்ந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"உயர் குடியில் பிறந்தவரிடத்தில் உண்டாகும் குற்றம், ஆகாயத்தில் திங்களிடம் காணப்படும் களங்கம்போல் பலரறியத் தோன்றும்.","en":"As spots on her bright orb that walks sublime the evening sky","lines":[{"t":"குடிப்பிறந்தார் கண்விளங்கும் குற்றம் விசும்பின்","err":null,"seers":[{"w":"குடிப்பிறந்தார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குடிப்"},{"k":"I","s":"பிறந்"},{"k":"N","s":"தார்"}]},{"w":"கண்விளங்கும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"I","s":"விளங்"},{"k":"N","s":"கும்"}]},{"w":"குற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குற்"},{"k":"N","s":"றம்"}]},{"w":"விசும்பின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விசும்"},{"k":"N","s":"பின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மதிக்கண் மறுப்போல் உயர்ந்து.","err":null,"seers":[{"w":"மதிக்கண்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மதிக்"},{"k":"N","s":"கண்"}]},{"w":"மறுப்போல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மறுப்"},{"k":"N","s":"போல்"}]},{"w":"உயர்ந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயர்ந்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":958,"ch":96,"l1":"நலத்தின்கண் நாரின்மை தோன்றின் அவனைக்","l2":"குலத்தின்கண் ஐயப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவனுடைய நல்லப் பண்புகளுக்கிடையில் அன்பற்றத் தன்மைக் காணப்பட்டால், அவனை அவனுடைய குடிப் பிறப்பு பற்றி ஐயப்பட நேரும்.","en":"If one of a good family betrays want of affection, his descent from it will be called in question","lines":[{"t":"நலத்தின்கண் நாரின்மை தோன்றின் அவனைக்","err":null,"seers":[{"w":"நலத்தின்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நலத்"},{"k":"N","s":"தின்"},{"k":"N","s":"கண்"}]},{"w":"நாரின்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"ரின்"},{"k":"N","s":"மை"}]},{"w":"தோன்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோன்"},{"k":"N","s":"றின்"}]},{"w":"அவனைக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அவ"},{"k":"N","s":"னைக்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"குலத்தின்கண் ஐயப் படும்.","err":null,"seers":[{"w":"குலத்தின்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குலத்"},{"k":"N","s":"தின்"},{"k":"N","s":"கண்"}]},{"w":"ஐயப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஐ"},{"k":"N","s":"யப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":959,"ch":96,"l1":"நிலத்தில் கிடந்தமை கால்காட்டும் காட்டும்","l2":"குலத்தில் பிறந்தார்வாய்ச் சொல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இன்ன நிலத்தில் இருந்து முளைத்தது என்பதை முளை காட்டும், அதுபோல் குடியிற் பிறந்தவரின் வாய்ச் சொல் அவருடைய குடிப்பிறப்பைக் காட்டும்.","en":"As the sprout indicates the nature of the soil, (so) the speech of the noble indicates (that of one's birth)","lines":[{"t":"நிலத்தில் கிடந்தமை கால்காட்டும் காட்டும்","err":null,"seers":[{"w":"நிலத்தில்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நிலத்"},{"k":"N","s":"தில்"}]},{"w":"கிடந்தமை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கிடந்"},{"k":"I","s":"தமை"}]},{"w":"கால்காட்டும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கால்"},{"k":"N","s":"காட்"},{"k":"N","s":"டும்"}]},{"w":"காட்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காட்"},{"k":"N","s":"டும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"குலத்தில் பிறந்தார்வாய்ச் சொல்.","err":null,"seers":[{"w":"குலத்தில்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குலத்"},{"k":"N","s":"தில்"}]},{"w":"பிறந்தார்