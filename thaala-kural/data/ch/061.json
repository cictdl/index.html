[{"n":601,"ch":61,"l1":"குடியென்னும் குன்றா விளக்கம் மடியென்னும்","l2":"மாசூர மாய்ந்து கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவனுக்கு தன் குடியாகிய மங்காத விளக்கு, அவனுடைய சோம்பலாகிய மாசு படிய படிய ஒளி மங்கிக் கெட்டுவிடும்.","en":"By the darkness, of idleness, the indestructible lamp of family (rank) will be extinguished","lines":[{"t":"குடியென்னும் குன்றா விளக்கம் மடியென்னும்","err":null,"seers":[{"w":"குடியென்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குடி"},{"k":"N","s":"யென்"},{"k":"N","s":"னும்"}]},{"w":"குன்றா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குன்"},{"k":"N","s":"றா"}]},{"w":"விளக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விளக்"},{"k":"N","s":"கம்"}]},{"w":"மடியென்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மடி"},{"k":"N","s":"யென்"},{"k":"N","s":"னும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாசூர மாய்ந்து கெடும்.","err":null,"seers":[{"w":"மாசூர","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"N","s":"சூ"},{"k":"N","s":"ர"}]},{"w":"மாய்ந்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாய்ந்"},{"k":"N","s":"து"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":602,"ch":61,"l1":"மடியை மடியா ஒழுகல் குடியைக்","l2":"குடியாக வேண்டு பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தம் குடியைச் சிறப்புடைய குடியாக விளங்குமாறு செய்ய விரும்புகின்றவர் சோம்பலைச் சோம்பலாகக் கொண்டு முயற்சியுடையவராய் நடக்க வேண்டும்.","en":"Let those, who desire that their family may be illustrious, put away all idleness from their conduct","lines":[{"t":"மடியை மடியா ஒழுகல் குடியைக்","err":null,"seers":[{"w":"மடியை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மடி"},{"k":"N","s":"யை"}]},{"w":"மடியா","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மடி"},{"k":"N","s":"யா"}]},{"w":"ஒழுகல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழு"},{"k":"N","s":"கல்"}]},{"w":"குடியைக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குடி"},{"k":"N","s":"யைக்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"குடியாக வேண்டு பவர்.","err":null,"seers":[{"w":"குடியாக","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குடி"},{"k":"N","s":"யா"},{"k":"N","s":"க"}]},{"w":"வேண்டு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டு"}]},{"w":"பவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":603,"ch":61,"l1":"மடிமடிக் கொண்டொழுகும் பேதை பிறந்த","l2":"குடிமடியும் தன்னினும் முந்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அழிக்கும் இயல்புடைய சோம்பலைத் தன்னிடம் கொண்டு நடக்கும் அறிவவில்லாதவன் பிறந்த குடி அவனுக்கு முன் அழிந்துவிடும்.","en":"The (lustre of the) family of the ignorant man, who acts under the influence of destructive laziness will perish, even before he is dead","lines":[{"t":"மடிமடிக் கொண்டொழுகும் பேதை பிறந்த","err":null,"seers":[{"w":"மடிமடிக்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மடி"},{"k":"I","s":"மடிக்"}]},{"w":"கொண்டொழுகும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கொண்"},{"k":"I","s":"டொழு"},{"k":"N","s":"கும்"}]},{"w":"பேதை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"}]},{"w":"பிறந்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிறந்"},{"k":"N","s":"த"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"குடிமடியும் தன்னினும் முந்து.","err":null,"seers":[{"w":"குடிமடியும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குடி"},{"k":"I","s":"மடி"},{"k":"N","s":"யும்"}]},{"w":"தன்னினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தன்"},{"k":"I","s":"னினும்"}]},{"w":"முந்து.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"முந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":604,"ch":61,"l1":"குடிமடிந்து குற்றம் பெருகும் மடிமடிந்து","l2":"மாண்ட உஞற்றி லவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"சோம்பலில் அகப்பட்டு சிறந்த முயற்சி இல்லாதவராய் வாழ்கின்றவர்க்கு குடியின் பெருமை அழிந்து குற்றம் பெருகும்.","en":"Family (greatness) will be destroyed, and faults will increase, in those men who give way to laziness, and put forth no dignified exertions","lines":[{"t":"குடிமடிந்து குற்றம் பெருகும் மடிமடிந்து","err":null,"seers":[{"w":"குடிமடிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குடி"},{"k":"I","s":"மடிந்"},{"k":"N","s":"து"}]},{"w":"குற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குற்"},{"k":"N","s":"றம்"}]},{"w":"பெருகும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"கும்"}]},{"w":"மடிமடிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"மடி"},{"k":"I","s":"மடிந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாண்ட உஞற்றி லவர்க்கு.","err":null,"seers":[{"w":"மாண்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாண்"},{"k":"N","s":"ட"}]},{"w":"உஞற்றி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உஞற்"},{"k":"N","s":"றி"}]},{"w":"லவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"லவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":605,"ch":61,"l1":"நெடுநீர் மறவி மடிதுயில் நான்கும்","l2":"கெடுநீரார் காமக் கலன்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"காலம் நீட்டித்தல், சோம்பல், மறதி, அளவு மீறியத் தூக்கம் ஆகிய இந் நான்கும் கெடுகின்ற இயல்புடையவர் விரும்பி ஏறும் மரக்கலமாம்.","en":"Procrastination, forgetfulness, idleness, and sleep, these four things, form the vessel which is desired by those destined to destruction","lines":[{"t":"நெடுநீர் மறவி மடிதுயில் நான்கும்","err":null,"seers":[{"w":"நெடுநீர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நெடு"},{"k":"N","s":"நீர்"}]},{"w":"மறவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மற"},{"k":"N","s":"வி"}]},{"w":"ம