் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":607,"ch":61,"l1":"இடிபுரிந்து எள்ளுஞ்சொல் கேட்பர் மடிபுரிந்து","l2":"மாண்ட உஞற்றி லவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"சோம்பலை விரும்பி மேற்க் கொண்டு சிறந்த முயற்சி இல்லாதவராய் வாழ்கின்றவர் பிறர் இடித்துக் கூறி இகழ்கின்ற சொல்லைக் கேட்கும் நிலைமை அடைவர்.","en":"Those who through idleness, and do not engage themselves in dignified exertion, will subject","lines":[{"t":"இடிபுரிந்து எள்ளுஞ்சொல் கேட்பர் மடிபுரிந்து","err":null,"seers":[{"w":"இடிபுரிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இடி"},{"k":"I","s":"புரிந்"},{"k":"N","s":"து"}]},{"w":"எள்ளுஞ்சொல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எள்"},{"k":"N","s":"ளுஞ்"},{"k":"N","s":"சொல்"}]},{"w":"கேட்பர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேட்"},{"k":"N","s":"பர்"}]},{"w":"மடிபுரிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"மடி"},{"k":"I","s":"புரிந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாண்ட உஞற்றி லவர்.","err":null,"seers":[{"w":"மாண்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாண்"},{"k":"N","s":"ட"}]},{"w":"உஞற்றி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உஞற்"},{"k":"N","s":"றி"}]},{"w":"லவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"லவர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":608,"ch":61,"l1":"மடிமை குடிமைக்கண் தங்கின்தன் ஒன்னார்க்கு","l2":"அடிமை புகுத்தி விடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["கலித்தளை"],"mv":"சோம்பல் நல்ல குடியில் பிறந்தவனிடம் வந்து பொருந்தினால், அஃது அவனை அவனுடைய பகைவர்க்கு அடிமையாகுமாறு செய்துவிடும்.","en":"If idleness take up its abode in a king of high birth, it will make him a slave of his enemies","lines":[{"t":"மடிமை குடிமைக்கண் தங்கின்தன் ஒன்னார்க்கு","err":null,"seers":[{"w":"மடிமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மடி"},{"k":"N","s":"மை"}]},{"w":"குடிமைக்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"