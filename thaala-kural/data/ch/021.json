[{"n":201,"ch":21,"l1":"தீவினையார் அஞ்சார் விழுமியார் அஞ்சுவர்","l2":"தீவினை என்னும் செருக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தீயவை செய்தலாகிய செருக்கைத் தீவினை உடைய பாவிகள் அஞ்சார், தீவினை இல்லாத மேலோர் மட்டுமே அஞ்சுவர்.","en":"Those who have experience of evil deeds will not fear, but the excellent will fear the pride of sin","lines":[{"t":"தீவினையார் அஞ்சார் விழுமியார் அஞ்சுவர்","err":null,"seers":[{"w":"தீவினையார்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"வினை"},{"k":"N","s":"யார்"}]},{"w":"அஞ்சார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சார்"}]},{"w":"விழுமியார்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விழு"},{"k":"I","s":"மியார்"}]},{"w":"அஞ்சுவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஞ்"},{"k":"I","s":"சுவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தீவினை என்னும் செருக்கு.","err":null,"seers":[{"w":"தீவினை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"வினை"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"செருக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செருக்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":202,"ch":21,"l1":"தீயவை தீய பயத்தலால் தீயவை","l2":"தீயினும் அஞ்சப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தீயசெயல்கள் தீமையை விளைவிக்கும் தன்மை உடையனவாக இருத்தலால், அத் தீயச் செயல்கள் தீயைவிடக் கொடியனவாகக் கருதி அஞ்சப்படும்.","en":"Because evil produces evil, therefore should evil be feared more than fire","lines":[{"t":"தீயவை தீய பயத்தலால் தீயவை","err":null,"seers":[{"w":"தீயவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"யவை"}]},{"w":"தீய","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"ய"}]},{"w":"பயத்தலால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பயத்"},{"k":"I","s":"தலால்"}]},{"w":"தீயவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"யவை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தீயினும் அஞ்சப் படும்.","err":null,"seers":[{"w":"தீயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"யினும்"}]},{"w":"அஞ்சப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":203,"ch":21,"l1":"அறிவினுள் எல்லாந் தலையென்ப தீய","l2":"செறுவார்க்கும் செய்யா விடல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தம்மை வருத்துவோர்க்கும் தீய செயல்களைச் செய்யாமலிருத்தலை, அறிவு எல்லாவற்றிலும் தலையான அறிவு என்று கூறுவர்.","en":"So shalt thou wisdom's highest law, 'tis said, fulfil","lines":[{"t":"அறிவினுள் எல்லாந் தலையென்ப தீய","err":null,"seers":[{"w":"அறிவினுள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வினுள்"}]},{"w":"எல்லாந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாந்"}]},{"w":"தலையென்ப","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தலை"},{"k":"N","s":"யென்"},{"k":"N","s":"ப"}]},{"w":"தீய","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"ய"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"செறுவார்க்கும் செய்யா விடல்.","err":null,"seers":[{"w":"செறுவார்க்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செறு"},{"k":"N","s":"வார்க்"},{"k":"N","s":"கும்"}]},{"w":"செய்யா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யா"}]},{"w":"விடல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":204,"ch":21,"l1":"மறந்தும் பிறன்கேடு சூழற்க சூழின்","l2":"அறஞ்சூழம் சூழ்ந்தவன் கேடு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பிறனுக்கு கேட்டைத் தரும் தீய செயல்களை ஒருவன் மறந்தும் கூட எண்ணக்கூடாது, எண்ணினால் எண்ணியவனுக்கு கேடு விளையுமாறு அறம் எண்ணும்.","en":"Even though forgetfulness meditate not the ruin of another Virtue will meditate the ruin of him who thus meditates","lines":[{"t":"மறந்தும் பிறன்கேடு சூழற்க சூழின்","err":null,"seers":[{"w":"மறந்தும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மறந்"},{"k":"N","s":"தும்"}]},{"w":"பிறன்கேடு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறன்"},{"k":"N","s":"கே"},{"k":"N","s":"டு"}]},{"w":"சூழற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சூ"},{"k":"N","s":"ழற்"},{"k":"N","s":"க"}]},{"w":"சூழின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சூ"},{"k":"N","s":"ழின்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அறஞ்சூழம் சூழ்ந்தவன் கேடு.","err":null,"seers":[{"w":"அறஞ்சூழம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறஞ்"},{"k":"N","s":"சூ"},{"k":"N","s":"ழம்"}]},{"w":"சூழ்ந்தவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சூழ்ந்"},{"k":"I","s":"தவன்"}]},{"w":"கேடு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கே"},{"k":"N","s":"டு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":205,"ch":21,"l1":"இலன்என்று தீயவை செய்யற்க செய்யின்","l2":"இலனாகும் மற்றும் பெயர்த்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"யான் வறியவன் என்று நினைத்துத் தீய செயல்களைச் செய்யக்கூடாது, செய்தால் மீண்டும் வறியவன் ஆகி வருந்துவான்.","en":"Commit not evil, saying, \"I am poor\": if you do, you will become poorer still","lines":[{"t":"இலன்என்று தீயவை செய்யற்க செய்யின்","err":null,"seers":[{"w":"இலன்என்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இலன்"},{"k":"N","s":"என்"},{"k":"N","s":"று"}]},{"w":"தீயவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"யவை"}]},{"w":"செய்யற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யற்"},{"k":"N","s":"க"}]},{"w":"செய்யின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இலனாகும் மற்றும் பெயர்த்து.","err":null,"seers":[{"w":"இலனாகும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இல"},{"k":"N","s":"னா"},{"k":"N","s":"கும்"}]},{"w":"மற்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றும்"}]},{"w":"பெயர்த்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெயர்த்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":206,"ch":21,"l1":"தீப்பால தான்பிறர்கண் செய்யற்க நோய்ப்பால","l2":"தன்னை அடல்வேண்டா தான்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"துன்பம் செய்யும் தீவினைகள் தன்னை வருத்துதலை விரும்பாதவன், தீயசெயல்களைத் தான் பிறருக்குச் செய்யாமலிருக்க வேண்டும்.","en":"Let him not do evil to others who desires not that sorrows should pursue him","lines":[{"t":"தீப்பால தான்பிறர்கண் செய்யற்க நோய்ப்பால","err":null,"seers":[{"w":"தீப்பால","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தீப்"},{"k":"N","s":"பா"},{"k":"N","s":"ல"}]},{"w":"தான்பிறர்கண்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தான்"},{"k":"I","s":"பிறர்"},{"k":"N","s":"கண்"}]},{"w":"செய்யற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யற்"},{"k":"N","s":"க"}]},{"w":"நோய்ப்பால","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோய்ப்"},{"k":"N","s":"பா"},{"k":"N","s":"ல"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தன்னை அடல்வேண்டா தான்.","err":null,"seers":[{"w":"தன்னை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தன்"},{"k":"N","s":"னை"}]},{"w":"அடல்வேண்டா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அடல்"},{"k":"N","s":"வேண்"},{"k":"N","s":"டா"}]},{"w":"தான்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தான்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":207,"ch":21,"l1":"எனைப்பகை யுற்றாரும் உய்வர் வினைப்பகை","l2":"வீயாது பின்சென்று அடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"எவ்வளவ