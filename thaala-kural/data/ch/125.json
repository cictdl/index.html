[{"n":1241,"ch":125,"l1":"நினைத்தொன்று சொல்லாயோ நெஞ்சே எனைத்தொன்றும்","l2":"எவ்வநோய் தீர்க்கும் மருந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"நெஞ்சே! ( காதலால் வளர்ந்த) இத் துன்ப நோயைத் தீர்க்கும் மருந்து ஏதாவது ஒன்றை நீ நினைத்துப் பார்த்து எனக்குச் சொல்ல மாட்டாயோ?","en":"O my soul, will you not think and tell me some medicine be it what it may, that can cure this incurable malady?","lines":[{"t":"நினைத்தொன்று சொல்லாயோ நெஞ்சே எனைத்தொன்றும்","err":null,"seers":[{"w":"நினைத்தொன்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நினைத்"},{"k":"N","s":"தொன்"},{"k":"N","s":"று"}]},{"w":"சொல்லாயோ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லா"},{"k":"N","s":"யோ"}]},{"w":"நெஞ்சே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சே"}]},{"w":"எனைத்தொன்றும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எனைத்"},{"k":"N","s":"தொன்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எவ்வநோய் தீர்க்கும் மருந்து.","err":null,"seers":[{"w":"எவ்வநோய்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எவ்"},{"k":"I","s":"வநோய்"}]},{"w":"தீர்க்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீர்க்"},{"k":"N","s":"கும்"}]},{"w":"மருந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மருந்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1242,"ch":125,"l1":"காதல் அவரிலர் ஆகநீ நோவது","l2":"பேதைமை வாழியென் நெஞ்சு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"என் நெஞ்சே! வாழ்க! அவர் நம்மிடம் காதல் இல்லாதவராக இருக்க, நீ மட்டும் அவரை நினைந்து வருந்துவது உன் அறியாமையே!","en":"Is folly, fare thee well my heart!","lines":[{"t":"காதல் அவரிலர் ஆகநீ நோவது","err":null,"seers":[{"w":"காதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"தல்"}]},{"w":"அவரிலர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அவ"},{"k":"I","s":"ரிலர்"}]},{"w":"ஆகநீ","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"கநீ"}]},{"w":"நோவது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நோ"},{"k":"I","s":"வது"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பேதைமை வாழியென் நெஞ்சு.","err":null,"seers":[{"w":"பேதைமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"மை"}]},{"w":"வாழியென்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வா"},{"k":"I","s":"ழியென்"}]},{"w":"நெஞ்சு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1243,"ch":125,"l1":"இருந்துள்ளி என்பரிதல் நெஞ்சே பரிந்துள்ளல்","l2":"பைதல்நோய் செய்தார்கண் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நெஞ்சே (என்னுடன்) இருந்து அவரை நினைந்து வருந்துவது ஏன்? இந்தத் துன்பநோயை உண்டாக்கியவரிடம் இவ்வாறு அன்பு கொண்டு நினைக்கும் தன்மை இல்லையே!","en":"O my soul! why remain (here) and suffer thinking (of him)? There are no lewd thoughts (of you) in him who has caused you this disease of sorrow","lines":[{"t":"இருந்துள்ளி என்பரிதல் நெஞ்சே பரிந்துள்ளல்","err":null,"seers":[{"w":"இருந்துள்ளி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இருந்"},{"k":"N","s":"துள்"},{"k":"N","s":"ளி"}]},{"w":"என்பரிதல்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பரி"},{"k":"N","s":"தல்"}]},{"w":"நெஞ்சே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சே"}]},{"w":"பரிந்துள்ளல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பரிந்"},{"k":"N","s":"துள்"},{"k":"N","s":"ளல்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பைதல்நோய் செய்தார்கண் இல்.","err":null,"seers":[{"w":"பைதல்நோய்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பை"},{"k":"N","s":"தல்"},{"k":"N","s":"நோய்"}]},{"w":"செய்தார்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தார்"},{"k":"N","s":"கண்"}]},{"w":"இல்.","name":