[{"n":721,"ch":73,"l1":"வகையறிந்து வல்லவை வாய்சோரார் சொல்லின்","l2":"தொகையறிந்த தூய்மை யவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"சொற்களின் தூய்மை தொகுதி அறிந்த தூய்மை உடையவர், அவைக்களத்தின் வகையினை அறிந்து, வல்லவறின் அவையில் வாய்ச் சோர்ந்து பிழை சொல்லமாட்டார்.","en":"The pure who know the classification of words having first ascertained the nature (of the court) will not (through fear) falter in their speech before the powerful body","lines":[{"t":"வகையறிந்து வல்லவை வாய்சோரார் சொல்லின்","err":null,"seers":[{"w":"வகையறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வகை"},{"k":"I","s":"யறிந்"},{"k":"N","s":"து"}]},{"w":"வல்லவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வல்"},{"k":"I","s":"லவை"}]},{"w":"வாய்சோரார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாய்"},{"k":"N","s":"சோ"},{"k":"N","s":"ரார்"}]},{"w":"சொல்லின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தொகையறிந்த தூய்மை யவர்.","err":null,"seers":[{"w":"தொகையறிந்த","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தொகை"},{"k":"I","s":"யறிந்"},{"k":"N","s":"த"}]},{"w":"தூய்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தூய்"},{"k":"N","s":"மை"}]},{"w":"யவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"யவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":722,"ch":73,"l1":"கற்றாருள் கற்றார் எனப்படுவர் கற்றார்முன்","l2":"கற்ற செலச்சொல்லு வார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கற்றவரின் முன் தாம் கற்றவைகளைச் அவருடைய மனதில் பதியுமாறுச் சொல்லவல்லவர், கற்றவர் எல்லாரிலும் கற்றவராக மதித்துச் சொல்லப்படுவார்.","en":"Those who can agreeably set forth their acquirements before the learned will be regarded as the most learned among the learned","lines":[{"t":"கற்றாருள் கற்றார் எனப்படுவர் கற்றார்முன்","err":null,"seers":[{"w":"கற்றாருள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"N","s":"றா"},{"k":"N","s":"ருள்"}]},{"w":"கற்றார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கற்"},{"k":"N","s":"றார்"}]},{"w":"எனப்படுவர்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"எனப்"},{"k":"I","s":"படு"},{"k":"N","s":"வர்"}]},{"w":"கற்றார்முன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"N","s":"றார்"},{"k":"N","s":"முன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கற்ற செலச்சொல்லு வார்.","err":null,"seers":[{"w":"கற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கற்"},{"k":"N","s":"ற"}]},{"w":"செலச்சொல்லு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செலச்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லு"}]},{"w":"வார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"வார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":723,"ch":73,"l1":"பகையகத்துச் சாவார் எளியர் அரியர்","l2":"அவையகத்து அஞ்சா தவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பகைவர் உள்ள போர்க்களத்தில் (அஞ்சாமல் சென்று) சாகத் துணிந்தவர் உலகத்தில் பலர், கற்றவரின் அவைக்களத்தில் பேச வல்லவர் சிலரே.","en":"Many indeed may (fearlessly) die in the presence of (their) foes; (but) few are those who are fearless in the assembly (of the learned)","lines":[{"t":"பகையகத்துச் சாவார் எளியர் அரியர்","err":null,"seers":[{"w":"பகையகத்துச்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பகை"},{"k":"I","s":"யகத்"},{"k":"N","s":"துச்"}]},{"w":"சாவார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சா"},{"k":"N","s":"வார்"}]},{"w":"எளியர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"எளி"},{"k":"N","s":"யர்"}]},{"w":"அரியர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"யர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அவையகத்து அஞ்சா தவர்.","err":null,"seers":[{"w":"அவையகத்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அவை"},{"k":"I","s":"யகத்"},{"k":"N","s":"து"}]},{"w":"அஞ்சா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சா"}]},{"w":"தவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":724,"ch":73,"l1":"கற்றார்முன் கற்ற செலச்சொல்லித் தாம்கற்ற","l2":"மிக்காருள் மிக்க கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கற்றவரின் முன் தான் கற்றவைகளை அவருடைய மனதில் பதியுமாறு சொல்லி, மிகுதியாகக் கற்றவரிடம் அம்மிகுதியான கல்வியைக் அறிந்து கொள்ள வேண்டும்.","en":"(Ministers) should agreeably set forth their acquirements before the learned and acquire more (knowledge) from their superiors (in learning)","lines":[{"t":"கற்றார்முன் கற்ற செலச்சொல்லித் தாம்கற்ற","err":null,"seers":[{"w":"கற்றார்முன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"N","s":"றார்"},{"k":"N","s":"முன்"}]},{"w":"கற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கற்"},{"k":"N","s":"ற"}]},{"w":"செலச்சொல்லித்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செலச்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லித்"}]},{"w":"தாம்கற்ற","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தாம்"},{"k":"N","s":"கற்"},{"k":"N","s":"ற"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"மிக்காருள் மிக்க கொளல்.","err":null,"seers":[{"w":"மிக்காருள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மிக்"},{"k":"N","s":"கா"},{"k":"N","s":"ருள்"}]},{"w":"மிக்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மிக்"},{"k":"N","s":"க"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":725,"ch":73,"l1":"ஆற்றின் அளவறிந்து கற்க அவையஞ்சா","l2":"மாற்றங் கொடுத்தற் பொருட்டு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அவையில் (ஒன்றைக் கேட்டவர்க்கு) அஞ்சாது விடைகூறும் பொருட்டாக நூல்களைக் கற்க்கும் நெறியில் அளவை நூல் அறிந்து கற்க வேண்டும்.","en":"In order to reply fearlessly before a foreign court, (ministers) should learn logic according to the rules (of grammar)","l