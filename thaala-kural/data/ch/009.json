[{"n":81,"ch":9,"l1":"இருந்தோம்பி இல்வாழ்வ தெல்லாம் விருந்தோம்பி","l2":"வேளாண்மை செய்தற் பொருட்டு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"வீட்டில் இருந்து பொருள்களைக் காத்து இல்வாழ்க்கை நடத்துவதெல்லாம் விருந்தினரைப் போற்றி உதவி செய்யும் பொருட்டே ஆகும்","en":"The whole design of living in the domestic state and laying up (property) is (to be able) to exercise the benevolence of hospitality","lines":[{"t":"இருந்தோம்பி இல்வாழ்வ தெல்லாம் விருந்தோம்பி","err":null,"seers":[{"w":"இருந்தோம்பி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இருந்"},{"k":"N","s":"தோம்"},{"k":"N","s":"பி"}]},{"w":"இல்வாழ்வ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"வாழ்"},{"k":"N","s":"வ"}]},{"w":"தெல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தெல்"},{"k":"N","s":"லாம்"}]},{"w":"விருந்தோம்பி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விருந்"},{"k":"N","s":"தோம்"},{"k":"N","s":"பி"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேளாண்மை செய்தற் பொருட்டு.","err":null,"seers":[{"w":"வேளாண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"ளாண்"},{"k":"N","s":"மை"}]},{"w":"செய்தற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தற்"}]},{"w":"பொருட்டு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொருட்"},{"k":"N","s":"டு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":82,"ch":9,"l1":"விருந்து புறத்ததாத் தானுண்டல் சாவா","l2":"மருந்தெனினும் வேண் டற்பாற் றன்று.","ok":true,"reseg":true,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"விருந்தினராக வந்தவர் வீட்டின் புறத்தே இருக்கத் தான் மட்டும் உண்பது சாவாமருந்தாகிய அமிழ்தமே ஆனாலும் அது விரும்பத்தக்கது அன்று","en":"It is not fit that one should wish his guests to be outside (his house) even though he were eating the food of immortality","lines":[{"t":"விருந்து புறத்ததாத் தானுண்டல் சாவா","err":null,"seers":[{"w":"விருந்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விருந்"},{"k":"N","s":"து"}]},{"w":"புறத்ததாத்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"புறத்"},{"k":"I","s":"ததாத்"}]},{"w":"தானுண்டல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தா"},{"k":"N","s":"னுண்"},{"k":"N","s":"டல்"}]},{"w":"சாவா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சா"},{"k":"N","s":"வா"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"மருந்தெனினும் வேண் டற்பாற் றன்று.","err":null,"seers":[{"w":"மருந்தெனினும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"மருந்"},{"k":"I","s":"தெனி"},{"k":"N","s":"னும்"}]},{"w":"வேண்டற்பாற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டற்"},{"k":"N","s":"பாற்"}]},{"w":"றன்று","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றன்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":83,"ch":9,"l1":"வருவிருந்து வைகலும் ஓம்புவான் வாழ்க்கை","l2":"பருவந்து பாழ்படுதல் இன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தன்னை நோக்கி வரும் விருந்தினரை நாள் தோறும் போற்றுகின்றவனுடைய வாழ்க்கை, துன்பத்தால் வருந்திக் கெட்டுப் போவதில்லை.","en":"The domestic life of the man that daily entertains the guests who come to him shall not be laid waste by poverty","lines":[{"t":"வருவிருந்து வைகலும் ஓம்புவான் வாழ்க்கை","err":null,"seers":[{"w":"வருவிருந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வரு"},{"k":"I","s":"விருந்"},{"k":"N","s":"து"}]},{"w":"வைகலும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வை"},{"k":"I","s":"கலும்"}]},{"w":"ஓம்புவான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஓம்"},{"k":"I","s":"புவான்"}]},{"w":"வாழ்க்கை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்க்"},{"k":"N","s":"கை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பருவந்து பாழ்படுதல் இன்று.","err":null,"seers":[{"w":"பருவந்து","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பரு"},{"k":"N","s":"வந்"},{"k":"N","s":"து"}]},{"w":"பாழ்படுதல்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பாழ்"},{"k":"I","s":"படு"},{"k":"N","s":"தல்"}]},{"w":"இன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":84,"ch":9,"l1":"அகனமர்ந்து செய்யாள் உறையும் முகனமர்ந்து","l2":"நல்விருந்து ஓம்புவான் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நல்ல விருந்தினராய் வந்தவரை முகமலர்ச்சி கொண்டு போற்றுகின்றவனுடைய வீட்டில் மனமகிழ்ந்து திருமகள் வாழ்வாள்.","en":"Lakshmi with joyous mind shall dwell in the house of that man who, with cheerful countenance, entertains the good as guests","lines":[{"t":"அகனமர்ந்து செய்யாள் உறையும் முகனமர்ந்து","err":null,"seers":[{"w":"அகனமர்ந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அக"},{"k":"I","s":"னமர்ந்"},{"k":"N","s":"து"}]},{"w":"செய்யாள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யாள்"}]},{"w":"உறையும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உறை"},{"k":"N","s":"யும்"}]},{"w":"முகனமர்ந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"முக"},{"k":"I","s":"னமர்ந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நல்விருந்து ஓம்புவான் இல்.","err":null,"seers":[{"w":"நல்விருந்து","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"விருந்"},{"k":"N","s":"து"}]},{"w":"ஓம்புவான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஓம்"},{"k":"I","s":"புவான்"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":85,"ch":9,"l1":"வித்தும் இடல்வேண்டும் கொல்லோ விருந்தோம்பி","l2":"மிச்சில் மிசைவான் புலம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"விருந்தினரை முன்னே போற்றி உணவளித்து மிஞ்சிய உணவை உண்டு வாழ்கின்றவனுடைய நிலத்தில் விதையும் விதைக்க வேண்டுமோ?","en":"Is it necessary to sow the field of the man who, having feasted his guests, eats what may remain ?","lines":[{"t":"வித்தும் இடல்வேண்டும் கொல்லோ விருந்தோம்பி","err":null,"seers":[{"w":"வித்தும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வித்"},{"k":"N","s":"தும்"}]},{"w":"இடல்வேண்டும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இடல்"},{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"கொல்லோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லோ"}]},{"w":"விருந்தோம்பி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விருந்"},{"k":"N","s":"தோம்"},{"k":"N","s":"பி"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மிச்சில் மிசைவான் புலம்.","err":null,"seers":[{"w":"மிச்சில்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மிச்"},{"k":"N","s":"சில்"}]},{"w":"மிசைவான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மிசை"},{"k":"N","s":"வான்"}]},{"w":"புலம்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"புலம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":86,"ch":9,"l1":"செல்விருந்து ஓம்பி வருவிருந்து பார்த்திருப்பான்","l2":"நல்வருந்து வானத் தவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"வந்த விருந்தினரைப் போற்றி, இனிவரும் விருந்தினரை எதிர் பார்த்திருப்பவன், வானுலகத்தில் உள்ள தேவர்க்கும் நல்ல விருந்தினனாவான்","en":"He who, having entertained the guests that have come, looks out for others who may yet come, will be a welcome guest to the inhabitants of heaven","lines":[{"t":"செல்விருந்து ஓம்பி வருவிருந்து பார்த்திருப்பான்","err":null,"seers":[{"w":"செல்விருந்து","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"I","s":"விருந்"},{"k":"N","s":"து"}]},{"w":"ஓம்பி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓம்"},{"k":"N","s":"பி"}]},{"w":"வருவிருந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வரு"},{"k":"I","s":"விருந்"},{"k":"N","s":"து"}]},{"w":"பார்த்திருப்பான்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பார்த்"},{"k":"I","s":"திருப்"},{"k":"N","s":"பான்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நல்வருந்து வானத் தவர்க்கு.","err":null,"seers":[{"w":"நல்வருந்து","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"வருந்"},{"k":"N","s":"து"}]},{"w":"வானத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"னத்"}]},{"w":"தவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":87,"ch":9,"l1":"இனைத்துணைத் தென்பதொன் றில்லை விருந்தின்","l2":"துணைத்துணை வேள்விப் பயன்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"விருந்தோம்புதலாகிய வேள்வியின் பயன் இவ்வளவு என்று அளவு படுத்தி கூறத்தக்கது அன்று, விருந்தினரின் தகுதிக்கு ஏற்ற அளவினதாகும்","en":"The advantages of benevolence cannot be measured; the measure (of the virtue) of the guests (entertained) is the only measure","lines":[{"t":"இனைத்துணைத் தென்பதொன் றில்லை விருந்தின்","err":null,"seers":[{"w":"இனைத்துணைத்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இனைத்"},{"k":"I","s":"துணைத்"}]},{"w":"தென்பதொன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தென்"},{"k":"I","s":"பதொன்"}]},{"w":"றில்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றில்"},{"k":"N","s":"லை"}]},{"w":"விருந்தின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விருந்"},{"k":"N","s":"தின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"துணைத்துணை வேள்விப் பயன்.","err":null,"seers":[{"w":"துணைத்துணை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"துணைத்"},{"k":"I","s":"துணை"}]},{"w":"வேள்விப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேள்"},{"k":"N","s":"விப்"}]},{"w":"பயன்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பயன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":88,"ch":9,"l1":"பரிந்தோம்பிப் பற்றற்றேம் என்பர் விருந்தோம்பி","l2":"வேள்வி தலைப்படா தார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"விருந்தினரை ஓம்பி அந்த வேள்வியில் ஈடுபடாதவர் பொருள்களை வருந்திக்காத்துப் (பின்பு இழந்து) பற்றுக்கொ