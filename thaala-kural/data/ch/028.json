[{"n":271,"ch":28,"l1":"வஞ்ச மனத்தான் படிற்றொழுக்கம் பூதங்கள்","l2":"ஐந்தும் அகத்தே நகும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வஞ்சமனம் உடையவனது பொய்யொழுக்கத்தை அவனுடைய உடம்பில் கலந்து நிற்க்கும் ஐந்து பூதங்களும் கண்டு தம்முள் சிரிக்கும்.","en":"The five elements (of his body) will laugh within him at the feigned conduct of the deceitful minded man","lines":[{"t":"வஞ்ச மனத்தான் படிற்றொழுக்கம் பூதங்கள்","err":null,"seers":[{"w":"வஞ்ச","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வஞ்"},{"k":"N","s":"ச"}]},{"w":"மனத்தான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மனத்"},{"k":"N","s":"தான்"}]},{"w":"படிற்றொழுக்கம்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"படிற்"},{"k":"I","s":"றொழுக்"},{"k":"N","s":"கம்"}]},{"w":"பூதங்கள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பூ"},{"k":"N","s":"தங்"},{"k":"N","s":"கள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஐந்தும் அகத்தே நகும்.","err":null,"seers":[{"w":"ஐந்தும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஐந்"},{"k":"N","s":"தும்"}]},{"w":"அகத்தே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அகத்"},{"k":"N","s":"தே"}]},{"w":"நகும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"நகும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":272,"ch":28,"l1":"வானுயர் தோற்றம் எவன்செய்யும் தன்னெஞ்சம்","l2":"தான்அறி குற்றப் படின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தன் மனம் தான் அறிந்த குற்றத்தில் தங்குமானால் வானத்தைப் போல் உயர்ந்துள்ள தவக்கோலம் ஒருவனுக்கு என்ன பயன் செய்யும்.","en":"What avails an appearance (of sanctity) high as heaven, if his mind suffers (the indulgence) of conscious sin","lines":[{"t":"வானுயர் தோற்றம் எவன்செய்யும் தன்னெஞ்சம்","err":null,"seers":[{"w":"வானுயர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வா"},{"k":"I","s":"னுயர்"}]},{"w":"தோற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோற்"},{"k":"N","s":"றம்"}]},{"w":"எவன்செய்யும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எவன்"},{"k":"N","s":"செய்"},{"k":"N","s":"யும்"}]},{"w":"தன்னெஞ்சம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தன்"},{"k":"N","s":"னெஞ்"},{"k":"N","s":"சம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தான்அறி குற்றப் படின்.","err":null,"seers":[{"w":"தான்அறி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தான்"},{"k":"I","s":"அறி"}]},{"w":"குற்றப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குற்"},{"k":"N","s":"றப்"}]},{"w":"படின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":273,"ch":28,"l1":"வலியில் நிலைமையான் வல்லுருவம் பெற்றம்","l2":"புலியின்தோல் போர்த்துமேய்ந் தற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"மனத்தை அடக்கும் வல்லமை இல்லாதவன் மேற்கொண்ட வலிய தவக்கோலம், புலியின் தோலைப் போர்த்திக் கொண்டு பயிரை பசு மேய்ந்தாற் போன்றது.","en":"The assumed appearance of power, by a man who has no power (to restrain his senses and perform austerity), is like a cow feeding on grass covered with a tiger's skin","lines":[{"t":"வலியில் நிலைமையான் வல்லுருவம் பெற்றம்","err":null,"seers":[{"w":"வலியில்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வலி"},{"k":"N","s":"யில்"}]},{"w":"நிலைமையான்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நிலை"},{"k":"N","s":"மை"},{"k":"N","s":"யான்"}]},{"w":"வல்லுருவம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வல்"},{"k":"I","s":"லுரு"},{"k":"N","s":"வம்"}]},{"w":"பெற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பெற்"},{"k":"N","s":"றம்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"புலியின்தோல் போர்த்துமேய்ந் தற்று.","err":null,"seers":[{"w":"புலியின்தோல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"புலி"},{"k":"N","s":"யின்"},{"k":"N","s":"தோல்"}]},{"w":"போர்த்துமேய்ந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"போர்த்"},{"k":"I","s":"துமேய்ந்"}]},{"w":"தற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":274,"ch":28,"l1":"தவமறைந்து அல்லவை செய்தல் புதல்மறைந்து","l2":"வேட்டுவன் புள்சிமிழ்த் தற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"தவக்கோலத்தில் மறைந்து கொண்டு தவம் அல்லாத தீயச்செயல்களைச் செய்தல், புதரில் மறைந்து கொண்டு வேடன் பறவைகளை வலைவீசிப் பிடித்தலைப் போன்றது.","en":"He who hides himself under the mask of an ascetic and commits sins, like a sportsman who conceals himself in the thicket to catch birds","lines":[{"t":"தவமறைந்து அல்லவை செய்தல் புதல்மறைந்து","err":null,"seers":[{"w":"தவமறைந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தவ"},{"k":"I","s":"மறைந்"},{"k":"N","s":"து"}]},{"w":"அல்லவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அல்"},{"k":"I","s":"லவை"}]},{"w":"செய்தல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தல்"}]},{"w":"புதல்மறைந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"புதல்"},{"k":"I","s":"மறைந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேட்டுவன் புள்சிமிழ்த் தற்று.","err":null,"seers":[{"w":"வேட்டுவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வேட்"},{"k":"I","s":"டுவன்"}]},{"w":"புள்சிமிழ்த்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"புள்"},{"k":"I","s":"சிமிழ்த்"}]},{"w":"தற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":275,"ch":28,"l1":"பற்றற்றேம் என்பார் படிற்றொழுக்கம் எற்றெற்றென்று","l2":"ஏதம் பலவுந் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":[null],"mv":"பற்றுக்களைத் துறந்தோம் என்று சொல்கின்றவரின் பொய்யொழுக்கம் என்ன செய்தோம் என்ன செய்தோம் என்று வருந்தும் படியான துன்பம் பலவும் தரும்.","en":"The false conduct of those who say they have renounced all desire will one day bring them sorrows that will make them cry out, \"Oh! what have we done, what have we done.\"","lines":[{"t":"பற்றற்றேம் என்பார் படிற்றொழுக்கம் எற்றெற்றென்று","err":null,"seers":[{"w":"பற்றற்றேம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பற்"},{"k":"N","s":"றற்"},{"k":"N","s":"றேம்"}]},{"w":"என்பார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"பார்"}]},{"w":"படிற்றொழுக்கம்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"படிற்"},{"k":"I","s":"றொழுக்"},{"k":"N","s":"கம்"}]},{"w":"எற்றெற்றென்று","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"எற்"},{"k":"N","s":"றெற்"},{"k":"N","s":"றென்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஏதம் பலவுந் தரும்.","err":null,"seers":[{"w":"ஏதம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"தம்"}]},{"w":"பலவுந்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பல"},{"k":"N","s":"வுந்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":276,"ch":28,"l1":"நெஞ்சின் துறவார் துறந்தார்போல் வஞ்சித்து","l2":"வாழ்வாரின் வன்கணார் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மனத்தில் பற்றுக்களைத் துறக்காமல் துறந்தவரைப் போல் வஞ்சனைச் செய்து வாழ்கின்றவரைப் போல் இரக்கமற்றவர் எவரும் இல்லை.","en":"Amongst living men there are none so hard-hearted as those who without to saking (desire) in their heart, falsely take the appearance of those who have forsaken (it)","lines":[{"t":"நெஞ்சின் துறவார் துறந்தார்போல் வஞ்சித்து","err":null,"seers":[{"w":"நெஞ்சின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சின்"}]},{"w":"துறவார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துற"},{"k":"N","s":"வார்"}]},{"w":"துறந்தார்போல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துறந்"},{"k":"N","s":"தார்"},{"k":"N","s":"போல்"}]},{"w":"வஞ்சித்து","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வஞ்"},{"k":"N","s":"சித்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்ட