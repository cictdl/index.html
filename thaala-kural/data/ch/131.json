[{"n":1301,"ch":131,"l1":"புல்லா திராஅப் புலத்தை அவர்உறும்","l2":"அல்லல்நோய் காண்கம் சிறிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"( ஊடும்போது அவர் அடைகின்ற) துன்ப நோயைச் சிறிது காண்போம்; அதற்காக அவரைத் தழுவாமலிருந்து பிணங்குவாயாக.","en":"Let us witness awhile his keen suffering; just feign dislike and embrace him not","lines":[{"t":"புல்லா திராஅப் புலத்தை அவர்உறும்","err":null,"seers":[{"w":"புல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"புல்"},{"k":"N","s":"லா"}]},{"w":"திராஅப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"திரா"},{"k":"N","s":"அப்"}]},{"w":"புலத்தை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புலத்"},{"k":"N","s":"தை"}]},{"w":"அவர்உறும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அவர்"},{"k":"I","s":"உறும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அல்லல்நோய் காண்கம் சிறிது.","err":null,"seers":[{"w":"அல்லல்நோய்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அல்"},{"k":"N","s":"லல்"},{"k":"N","s":"நோய்"}]},{"w":"காண்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காண்"},{"k":"N","s":"கம்"}]},{"w":"சிறிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சிறி"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1302,"ch":131,"l1":"உப்பமைந் தற்றால் புலவி அதுசிறிது","l2":"மிக்கற்றால் நீள விடல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உப்பு, உணவில் அளவோடு அமைந்திருப்பதைப் போன்றது ஊடல்; ஊடலை அளவு கடந்து நீட்டித்தல், அந்த உப்பு சிறிதளவு மிகுதியாக இருப்பதைப் போன்றது.","en":"A little dislike is like salt in proportion; to prolong it a little is like salt a little too much","lines":[{"t":"உப்பமைந் தற்றால் புலவி அதுசிறிது","err":null,"seers":[{"w":"உப்பமைந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உப்"},{"k":"I","s":"பமைந்"}]},{"w":"தற்றால்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"றால்"}]},{"w":"புலவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புல"},{"k":"