[{"n":341,"ch":35,"l1":"யாதனின் யாதனின் நீங்கியான் நோதல்","l2":"அதனின் அதனின் இலன்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் எந்தப் பொருளிலிருந்து, எந்தப் பொருளிலிருந்து பற்று நீங்கியவனாக இருக்கின்றானோ, அந்தந்தப் பொருளால் அவன் துன்பம் அடைவதில்லை.","en":"Whatever thing, a man has renounced, by that thing; he cannot suffer pain","lines":[{"t":"யாதனின் யாதனின் நீங்கியான் நோதல்","err":null,"seers":[{"w":"யாதனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தனின்"}]},{"w":"யாதனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தனின்"}]},{"w":"நீங்கியான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீங்"},{"k":"I","s":"கியான்"}]},{"w":"நோதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோ"},{"k":"N","s":"தல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அதனின் அதனின் இலன்.","err":null,"seers":[{"w":"அதனின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னின்"}]},{"w":"அதனின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னின்"}]},{"w":"இலன்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"இலன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":342,"ch":35,"l1":"வேண்டின்உண் டாகத் துறக்க துறந்தபின்","l2":"ஈண்டுஇயற் பால பல.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"துன்பமில்லாத நிலைமை வேண்டுமானால் எல்லாப் பொருள்களும் உள்ள காலத்திலேயெ துறக்க வேண்டும்,துறந்த பின் இங்குப் பெறக்கூடும் இன்பங்கள் பல.","en":"After a man has renounced (all things), there will still be many things in this world (which he may enjoy); if he should desire them, let him, while it is time abandon (the world)","lines":[{"t":"வேண்டின்உண் டாகத் துறக்க துறந்தபின்","err":null,"seers":[{"w":"வேண்டின்உண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டின்"},{"k":"N","s":"உண்"}]},{"w":"டாகத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டா"},{"k":"N","s":"கத்"}]},{"w":"துறக்க","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துறக்"},{"k":"N","s":"க"}]},{"w":"துறந்தபின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"துறந்"},{"k":"I","s":"தபின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஈண்டுஇயற் பால பல.","err":null,"seers":[{"w":"ஈண்டுஇயற்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஈண்"},{"k":"I","s":"டுஇ"},{"k":"N","s":"யற்"}]},{"w":"பால","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பா"},{"k":"N","s":"ல"}]},{"w":"பல.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பல"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":343,"ch":35,"l1":"அடல்வேண்டும் ஐந்தன் புலத்தை விடல்வேண்டும்","l2":"வேண்டிய வெல்லாம் ஒருங்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஐம்பொறிகளுக்கும் உரிய ஐந்து புலன்களின் ஆசையையும் வெல்லுதல் வேண்டும், அவற்றிற்கு வேண்டிய பொருள்களை எல்லாம் ஒரு சேர விட வேண்டும்.","en":"Let the five senses be destroyed; and at the same time, let everything be abandoned that (the ascetic) has (formerly) desired","lines":[{"t":"அடல்வேண்டும் ஐந்தன் புலத்தை விடல்வேண்டும்","err":null,"seers":[{"w":"அடல்வேண்டும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அடல்"},{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]},{"w":"ஐந்தன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஐந்"},{"k":"N","s":"தன்"}]},{"w":"புலத்தை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புலத்"},{"k":"N","s":"தை"}]},{"w":"விடல்வேண்டும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விடல்"},{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேண்டிய வெல்லாம் ஒருங்கு.","err":null,"seers":[{"w":"வேண்டிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வேண்"},{"k":"I","s":"டிய"}]},{"w":"வெல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெல்"},{"k":"N","s":"லாம்"}]},{"w":"ஒருங்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒருங்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":344,"ch":35,"l1":"இயல்பாகும் நோன்பிற்கொன்று இன்மை உடைமை","l2":"மயலாகும் மற்றும் பெயர்த்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தவம் செய்தவற்கு ஒரு பற்றும் இல்லாதிருத்தல் இயல்பாகும், பற்று உடையவராக இருத்தல் மீண்டும் மயங்குவதற்கு வழியாகும்.","en":"To be altogether destitute is the proper condition of those who perform austerities; if they possess anything, it will change (their resolution) and bring them back to their confused state","lines":[{"t":"இயல்பாகும் நோன்பிற்கொன்று இன்மை உடைமை","err":null,"seers":[{"w":"இயல்பாகும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இயல்"},{"k":"N","s":"பா"},{"k":"N","s":"கும்"}]},{"w":"நோன்பிற்கொன்று","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"நோன்"},{"k":"N","s":"பிற்"},{"k":"N","s":"கொன்"},{"k":"N","s":"று"}]},{"w":"இன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"}]},{"w":"உடைமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"மை"}]}],"thalai":["வெண்சீர் வெண்டளை",null,"இயற்சீர் வெண்டளை"]},{"t":"மயலாகும் மற்றும் பெயர்த்து.","err":null,"seers":[{"w":"மயலாகும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மய"},{"k":"N","s":"லா"},{"k":"N","s":"கும்"}]},{"w":"மற்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றும்"}]},{"w":"பெயர்த்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெயர்த்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":345,"ch":35,"l1":"மற்றும் தொடர்ப்பாடு எவன்கொல் பிறப்பறுக்கல்","l2":"உற்றார்க்கு உடம்பும் மிகை.","ok":true,"reseg":true,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பிறவித் துன்பத்தைப் போக்க முயல்கின்றவர்க்கு உடம்பும் மிகையான பொருள் ஆகையால் அதற்கு மேல் வேறு தொடர்பு கொள்வது ஏனோ.","en":"What means the addition of other things those who are attempting to cut off (future) births, when even their body is too much (for them)","lines":[{"t":"மற்றும் தொடர்ப்பாடு எவன்கொல் பிறப்பறுக்கல்","err":null,"seers":[{"w":"மற்றும்","na