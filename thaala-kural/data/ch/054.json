[{"n":531,"ch":54,"l1":"இறந்த வெகுளியின் தீதே சிறந்த","l2":"உவகை மகிழ்ச்சியிற் சோர்வு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பெரிய உவகையால் மகிழ்ந்திருக்கும் போது மறதியால் வரும் சோர்வு, ஒருவனுக்கு வரம்பு கடந்த சினம் வருவதைவிடத் தீமையானதாகும்.","en":"More evil than excessive anger, is forgetfulness which springs from the intoxication of great joy","lines":[{"t":"இறந்த வெகுளியின் தீதே சிறந்த","err":null,"seers":[{"w":"இறந்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இறந்"},{"k":"N","s":"த"}]},{"w":"வெகுளியின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வெகு"},{"k":"I","s":"ளியின்"}]},{"w":"தீதே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"தே"}]},{"w":"சிறந்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சிறந்"},{"k":"N","s":"த"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உவகை மகிழ்ச்சியிற் சோர்வு.","err":null,"seers":[{"w":"உவகை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உவ"},{"k":"N","s":"கை"}]},{"w":"மகிழ்ச்சியிற்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மகிழ்ச்"},{"k":"I","s":"சியிற்"}]},{"w":"சோர்வு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சோர்"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":532,"ch":54,"l1":"பொச்சாப்புக் கொல்லும் புகழை அறிவினை","l2":"நிச்ச நிரப்புக் கொன் றாங்கு.","ok":true,"reseg":true,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நாள் தோறும் விடாமல் வரும் வறுமை அறிவைக் கொல்வது போல, ஒருவனுடைய புகழை அவனுடைய மறதிக் கொன்று விடும்.","en":"Forgetfulness will destroy fame, even as constant poverty destroys knowledge","lines":[{"t":"பொச்சாப்புக் கொல்லும் புகழை அறிவினை","err":null,"seers":[{"w":"பொச்சாப்புக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொச்"},{"k":"N","s":"சாப்"},{"k":"N","s":"புக்"}]},{"w":"கொல்லும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லும்"}]},{"w":"புகழை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புக"},{"k":"N","s":"ழை"}]},{"w":"அறிவினை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வினை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நிச்ச நிரப்புக் கொன் றாங்கு.","err":null,"seers":[{"w":"நிச்ச","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நிச்"},{"k":"N","s":"ச"}]},{"w":"நிரப்புக்கொன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நிரப்"},{"k":"N","s":"புக்"},{"k":"N","s":"கொன்"}]},{"w":"றாங்கு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றாங்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":533,"ch":54,"l1":"பொச்சாப்பார்க் கில்லை புகழ்மை அதுஉலகத்து","l2":"எப்பால்நூ லோர்க்கும் துணிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":[null],"mv":"மறதியால் சோர்ந்து நடப்பவர்க்குப் புகழுடன் வாழும் தன்மையில்லை, அஃது உலகத்தில் எப்படிப்பட்டநூலோர்க்கும் ஒப்ப முடிந்த முடிப்பாகும்.","en":"Thoughtlessness will never acquire fame; and this tenet is upheld by all treatises in the world","lines":[{"t":"பொச்சாப்பார்க் கில்லை புகழ்மை அதுஉலகத்து","err":null,"seers":[{"w":"பொச்சாப்பார்க்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொச்"},{"k":"N","s":"சாப்"},{"k":"N","s":"பார்க்"}]},{"w":"கில்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கில்"},{"k":"N","s":"லை"}]},{"w":"புகழ்மை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புகழ்"},{"k":"N","s":"மை"}]},{"w":"அதுஉலகத்து","name":"கருவிளந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"அது"},{"k":"I","s":"உல"},{"k":"N","s":"கத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எப்பால்நூ லோர்க்கும் துணிவு.","err":null,"seers":[{"w":"எப்பால்நூ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எப்"},{"k":"N","s":"பால்"},{"k":"N","s":"நூ"}]},{"w":"லோர்க்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"லோர்க்"},{"k":"N","s":"கும்"}]},{"w":"துணிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துணி"},{"k":"N","s":"வு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":534,"ch":54,"l1":"அச்ச முடையார்க்கு அரணில்லை ஆங்கில்லை","l2":"பொச்சாப் புடையார்க்கு நன்கு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"உள்ளத்தில் அச்சம் உடையவர்க்குப் புறத்திலே அரண் இருந்து பயன் இல்லை, அதுபோல் மறதி உடையவர்க்கு நல்ல நிலை வாய்த்தும் பயன் இல்லை.","en":"Just as the coward has no defence (by whatever fortifications ha may be surrounded), so the thoughtless has no good (whatever advantages he may possess)","lines":[{"t":"அச்ச முடையார்க்கு அரணில்லை ஆங்கில்லை","err":null,"seers":[{"w":"அச்ச","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அச்"},{"k":"N","s":"ச"}]},{"w":"முடையார்க்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முடை"},{"k":"N","s":"யார்க்"},{"k":"N","s":"கு"}]},{"w":"அரணில்லை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அர"},{"k":"N","s":"ணில்"},{"k":"N","s":"லை"}]},{"w":"ஆங்கில்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆங்"},{"k":"N","s":"கில்"},{"k":"N","s":"லை"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","வெண்சீர் வெண்டளை"]},{"t":"பொச்சாப் புடையார்க்கு நன்கு.","err":null,"seers":[{"w":"பொச்சாப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பொச்"},{"k":"N","s":"சாப்"}]},{"w":"புடையார்க்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"புடை"},{"k":"N","s":"யார்க்"},{"k":"N","s":"கு"}]},{"w":"நன்கு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":535,"ch":54,"l1":"முன்னுறக் காவாது இழுக்கியான் தன்பிழை","l2":"பின்னூறு இரங்கி விடும்.","ok":true,"reseg":true,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"வரும் இடையூறுகளை முன்னே அறிந்துக் காக்காமல் மறந்து சோர்ந்தவன், பின்பு அவை வந்துற்றபோது தன் பிழையை நினைத்து இரங்குவான்.","en":"The thoughtless man, who provides not against the calamities that may happen, will afterwards repent for his fault","lines":[{"t":"முன்னுறக் காவாது இழுக்கியான் தன்பிழை","err":null,"seers":[{"w":"முன்னுறக்கா","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"முன்"},{"k":"I","s":"னுறக்"},{"k":"N","s":"கா"}]},{"w":"வாது","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"து"}]},{"w":"இழுக்கியான்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இழுக்"},{"k":"I","s":"கியான்"}]},{"w":"தன்பிழை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தன்"},{"k":"I","s":"பிழை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பின்னூறு இரங்கி விடும்.","err":null,"seers":[{"w":"பின்னூ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பின்"},{"k":"N","s":"னூ"}]},{"w":"றிரங்கி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"றிரங்"},{"k":"N","s":"கி"}]},{"w":"விடும்","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":536,"ch":54,"l1":"இழுக்காமை யார்மாட்டும் என்றும் வழுக்காமை","l2":"வாயின் அதுவொப்பது இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"யாரிடத்திலும் எக்காலத்திலும் மறந்தும் சோர்ந்திருக்காதத் தன்மை தவறாமல் பொருந்தியிருக்குமானால், அதற்கு ஒப்பான நன்மை வேறொன்றும் இல்லை.","en":"There is nothing comparable with the possession of unfailing thoughtfulness at all times; and towards all persons","lines":[{"t":"இழுக்காமை யார்மாட்டும் என்றும் வழுக்காமை","err":null,"seers":[{"w":"இழுக்காமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"யார்மாட்டும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யார்"},{"k":"N","s":"மாட்"},{"k":"N","s":"டும்"}]},{"w":"என்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"றும்"}]},{"w":"வழுக்காமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வழுக்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வாயின் அதுவொப்பது இல்.","err":null,"seers":[{"w":"வாயின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"யின்"}]},{"w":"அதுவொப்பது","name":"புளிமாங்கனி","cls":"கனி","a":[{"k":"I","s":"அது"},{"k":"N","s":"வொப்"},{"k":"I","s":"பது"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["இயற்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை"]}]},{"n":537,"ch":54,"l1":"அரியஎன்று ஆகாத இல்லைபொச் சாவாக்","l2":"கருவியால் போற்றிச் செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மறவாமை என்னும் கருவிகொண்டு (கடமைகளைப்) போற்றிச் செய்தால், செய்வதற்கு அரியவை என்று ஒருவனால் முடியாத செயல்கள் இல்லை.","en":"There is nothing too difficult to be accomplished, if a man set about it carefully, with unflinching endeavour","lines":[{"t":"அரியஎன்று ஆகாத இல்லைபொச் சாவாக்","err":null,"seers":[{"w":"அரியஎன்று","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அரி"},{"k":"I","s":"யஎன்"},{"k":"N","s":"று"}]},{"w":"ஆகாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கா"},{"k":"N","s":"த"}]},{"w":"இல்லைபொச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"},{"k":"N","s":"பொச்"}]},{"w":"சாவாக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சா"},{"k":"N","s":"வாக்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கருவியால் போற்றிச் செயின்.","err":null,"seers":[{"w":"கருவியால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரு"},{"k":"I","s":"வியால்"}]},{"w":"போற்றிச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றிச்"}]},{"w":"செயின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":538,"ch":54,"l1":"புகழ்ந்தவை போற்றிச் செயல்வேண்டும் செய்யாது","l2":"இகழ்ந்தார்க்கு எழுமையும் இல்.","ok":true,"reseg":true,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"சான்றோர் புகழ்ந்து சொல்லியச் செயல்களைப் போற்றிச் செய்யவேண்டும், அவ்வாறு செய்யாமல் மறந்து சோர்ந்தவர்க்கு ஏழுப் பிறப்பிலும் நன்மை இல்லை.","en":"Let (a man) observe and do these things which have been praised (by the wise); if he neglects and fails to perform them, for him there will be no (happiness) throughout the seven births","lines":[{"t":"புகழ்ந்தவை போற்றிச் செயல்வேண்டும் செய்யாது","err":null,"seers":[{"w":"புகழ்ந்தவைபோற்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"புகழ்ந்"},{"k":"I","s":"தவை"},{"k":"N","s":"போற்"}]},{"w":"றிச்செயல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"றிச்"},{"k":"I","s":"செயல்"}]},{"w":"வேண்டும்செய்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டும்"},{"k":"N","s":"செய்"}]},{"w":"யாது","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இகழ்ந்தார்க்கு எழுமையும் இல்.","err":null,"seers":[{"w":"இகழ்ந்தார்க்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இகழ்ந்"},{"k":"N","s":"தார்க்"}]},{"w":"கெழுமையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கெழு"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"இல்","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":539,"ch":54,"l1":"இகழ்ச்சியின் கெட்டாரை உள்ளுக தாந்தம்","l2":"மகிழ்ச்சியின் மைந்துறும் போழ்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தாம் தம் மகிழ்ச்சியால் செருக்குக் கொண்டு கடமையை மறந்திருக்கும் போது, அவ்வாறு சோர்ந்திருந்த காரணத்தால் முற்காலத்தில் அழிந்தவரை நினைக்க வேண்டும்.","en":"Let (a king) think of those who have been ruined by neglect, when his mind is elated with joy","lines":[{"t":"இகழ்ச்சியின் கெட்டாரை உள்ளுக தாந்தம்","err":null,"seers":[{"w":"இகழ்ச்சியின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இகழ்ச்"},{"k":"I","s":"சியின்"}]},{"w":"கெட்டாரை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கெட்"},{"k":"N","s":"டா"},{"k":"N","s":"ரை"}]},{"w":"உள்ளுக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளுக"}]},{"w":"தாந்தம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தாந்"},{"k":"N","s":"தம்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மகிழ்ச்சியின் மைந்துறும் போழ்து.","err":null,"seers":[{"w":"மகிழ்ச்சியின்","name":"கருவிளம்",