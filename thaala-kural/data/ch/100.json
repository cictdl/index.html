்புக்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மண்"},{"k":"N","s":"புக்"},{"k":"N","s":"கு"}]},{"w":"மாய்வது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மாய்"},{"k":"I","s":"வது"}]},{"w":"மன்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"மன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":997,"ch":100,"l1":"அரம்போலும் கூர்மைய ரேனும் மரம்போல்வர்","l2":"மக்கட்பண்பு இல்லா தவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மக்களுக்கு உரிய பண்பு இல்லாதவர் அரம் போல் கூர்மையான அறிவுடையவரானாலும், ஓரறிவுயிராகிய மரத்தைப் போன்றவரே ஆவர்.","en":"He who is destitute of (true) human qualities (only) resembles a tree, though he may possess the sharpness of a file","lines":[{"t":"அரம்போலும் கூர்மைய ரேனும் மரம்போல்வர்","err":null,"seers":[{"w":"அரம்போலும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அரம்"},{"k":"N","s":"போ"},{"k":"N","s":"லும்"}]},{"w":"கூர்மைய","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கூர்"},{"k":"N","s":"மை"},{"k":"N","s":"ய"}]},{"w":"ரேனும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ரே"},{"k":"N","s":"னும்"}]},{"w":"மரம்போல்வர்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மரம்"},{"k":"N","s":"போல்"},{"k":"N","s":"வர்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மக்கட்பண்பு இல்லா தவர்.","err":null,"seers":[{"w":"மக்கட்பண்பு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"மக்"},{"k":"N","s":"கட்"},{"k":"N","s":"பண்"},{"k":"N","s":"பு"}]},{"w":"இல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"}]},{"w":"தவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தவர்"}]}],"thalai":[null,"இயற்சீர் வெண்டளை"]}]},{"n":998,"ch":100,"l1":"நண்பாற்றார் ஆகி நயமில செய்வார்க்கும்","l2":"பண்பாற்றார் ஆதல் கடை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நட்பு கொள்ள முடியாதவராய்த் தீயவைச் செய்கின்றவரிடத்திலும் பண்பு உடையவராய் நடக்க முடியாமை இழிவானதாகும்.","en":"It is wrong (for the wise