[{"n":91,"ch":10,"l1":"இன்சொலால் ஈரம் அளைஇப் படிறுஇலவாம்","l2":"செம்பொருள் கண்டார்வாய்ச் சொல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["ஒன்றிய வஞ்சித்தளை"],"mv":"அன்பு கலந்து வஞ்சம் அற்றவைகளாகிய சொற்கள், மெய்ப்பொருள் கண்டவர்களின் வாய்ச்சொற்கள் இன்சொற்களாகும்.","en":"Sweet words are those which imbued with love and free from deceit flow from the mouth of the virtuous","lines":[{"t":"இன்சொலால் ஈரம் அளைஇப் படிறுஇலவாம்","err":null,"seers":[{"w":"இன்சொலால்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இன்"},{"k":"I","s":"சொலால்"}]},{"w":"ஈரம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"ரம்"}]},{"w":"அளைஇப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அளை"},{"k":"N","s":"இப்"}]},{"w":"படிறுஇலவாம்","name":"கருவிளங்கனி","cls":"கனி","a":[{"k":"I","s":"படி"},{"k":"I","s":"றுஇ"},{"k":"I","s":"லவாம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செம்பொருள் கண்டார்வாய்ச் சொல்.","err":null,"seers":[{"w":"செம்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செம்"},{"k":"I","s":"பொருள்"}]},{"w":"கண்டார்வாய்ச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"டார்"},{"k":"N","s":"வாய்ச்"}]},{"w":"சொல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"சொல்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":92,"ch":10,"l1":"அகன்அமர்ந்து ஈதலின் நன்றே முகனமர்ந்து","l2":"இன்சொலன் ஆகப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"முகம் மலர்ந்து இன்சொல் உடையவனாக இருக்கப்பெற்றால், மனம் மகிழ்ந்து பொருள் கொடுக்கும் ஈகையைவிட நல்லதாகும்.","en":"Sweet speech, with a cheerful countenance is better than a gift made with a joyous mind","lines":[{"t":"அகன்அமர்ந்து ஈதலின் நன்றே முகனமர்ந்து","err":null,"seers":[{"w":"அகன்அமர்ந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அகன்"},{"k":"I","s":"அமர்ந்"},{"k":"N","s":"து"}]},{"w":"ஈதலின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஈ"},{"k":"I","s":"தலின்"}]},{"w":"நன்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றே"}]},{"w":"முகனமர்ந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"முக"},{"k":"I","s":"னமர்ந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இன்சொலன் ஆகப் பெறின்.","err":null,"seers":[{"w":"இன்சொலன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இன்"},{"k":"I","s":"சொலன்"}]},{"w":"ஆகப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":93,"ch":10,"l1":"முகத்தான் அமர்ந்து இனிதுநோக்கி அகத்தானாம்","l2":"இன்சொ லினதே அறம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"முகத்தால் விரும்பி- இனிமையுடன் நோக்கி- உள்ளம் கலந்து இன்சொற்களைக் கூறும் தன்மையில் உள்ளதே அறமாகும்.","en":"Sweet speech, flowing from the heart (uttered) with a cheerful countenance and a sweet look, is true virtue","lines":[{"t":"முகத்தான் அமர்ந்து இனிதுநோக்கி அகத்தானாம்","err":null,"seers":[{"w":"முகத்தான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முகத்"},{"k":"N","s":"தான்"}]},{"w":"அமர்ந்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அமர்ந்"},{"k":"N","s":"து"}]},{"w":"இனிதுநோக்கி","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இனி"},{"k":"I","s":"துநோக்"},{"k":"N","s":"கி"}]},{"w":"அகத்தானாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அகத்"},{"k":"N","s":"தா"},{"k":"N","s":"னாம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","கலித்தளை"]},{"t":"இன்சொ லினதே அறம்.","err":null,"seers":[{"w":"இன்சொ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"சொ"}]},{"w":"லினதே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"லின"},{"k":"N","s":"தே"}]},{"w":"அறம்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அறம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":94,"ch":10,"l1":"துன்புறூஉம் துவ்வாமை இல்லாகும் யார்மாட்டும்","l2":"இன்புறூஉம் இன்சொ லவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"யாரிடத்திலும் இன்புறத்தக்க இன்சொல் வழங்குவோர்க்குத் துன்பத்தை மிகுதிபடுத்தும் வறுமை என்பது இல்லையாகும்.","en":"Sorrow-increasing poverty shall not come upon those who use towards all, pleasure-increasing sweetness of speech","lines":[{"t":"துன்புறூஉம் துவ்வாமை இல்லாகும் யார்மாட்டும்","err":null,"seers":[{"w":"துன்புறூஉம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"துன்"},{"k":"I","s":"புறூ"},{"k":"N","s":"உம்"}]},{"w":"துவ்வாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"துவ்"},{"k":"N","s":"வா"},{"k":"N","s":"மை"}]},{"w":"இல்லாகும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"கும்"}]},{"w":"யார்மாட்டும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யார்"},{"k":"N","s":"மாட்"},{"k":"N","s":"டும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இன்புறூஉம் இன்சொ லவர்க்கு.","err":null,"seers":[{"w":"இன்புறூஉம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"I","s":"புறூ"},{"k":"N","s":"உம்"}]},{"w":"இன்சொ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"சொ"}]},{"w":"லவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"லவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":95,"ch":10,"l1":"பணிவுடையன் இன்சொலன் ஆதல் ஒருவற்கு","l2":"அணியல்ல மற்றுப் பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["கலித்தளை"],"mv":"வணக்கம் உடையவனாகவும் இன்சொல் வழங்குவோனாகவும் ஆதலே ஒருவனுக்கு அணிகலனாகும் மற்றவை அணிகள் அல்ல.","en":"Humility and sweetness of speech are the ornaments of man; all others are not (ornaments)","lines":[{"t":"பணிவுடையன் இன்சொலன் ஆதல் ஒருவற்கு","err":null,"seers":[{"w":"பணிவுடையன்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பணி"},{"k":"I","s":"வுடை"},{"k":"N","s":"யன்"}]},{"w":"இன்சொலன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இன்"},{"k":"I","s":"சொலன்"}]},{"w":"ஆதல்","name":"தேமா","cls":"மா","a"