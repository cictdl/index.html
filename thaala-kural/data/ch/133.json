[{"n":1321,"ch":133,"l1":"இல்லை தவறவர்க்கு ஆயினும் ஊடுதல்","l2":"வல்லது அவர்அளிக்கு மாறு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அவரிடம் தவறு ஒன்றும் இல்லையானலும், அவரோடு ஊடுதல், அவர் நம்மேல் மிகுதியாக அன்பு செலுத்துமாறு செய்ய வல்லது.","en":"Although my husband is free from defects, the way in which he embraces me is such as to make me feign dislike","lines":[{"t":"இல்லை தவறவர்க்கு ஆயினும் ஊடுதல்","err":null,"seers":[{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"தவறவர்க்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தவ"},{"k":"I","s":"றவர்க்"},{"k":"N","s":"கு"}]},{"w":"ஆயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"யினும்"}]},{"w":"ஊடுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"டுதல்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வல்லது அவர்அளிக்கு மாறு.","err":null,"seers":[{"w":"வல்லது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வல்"},{"k":"I","s":"லது"}]},{"w":"அவர்அளிக்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அவர்"},{"k":"I","s":"அளிக்"},{"k":"N","s":"கு"}]},{"w":"மாறு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மா"},{"k":"N","s":"று"}]}],"thalai":["நிரையொன்றிய ஆசிரியத்தளை","வெண்சீர் வெண்டளை"]}]},{"n":1322,"ch":133,"l1":"ஊடலின் தோன்றும் சிறுதுனி நல்லளி","l2":"வாடினும் பாடு பெறும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஊடுதலால் உண்டாகின்ற சிறிய துன்பம், காதலர் செய்கின்ற நல்ல அன்பு வாடிவிடக் காரணமாக இருந்தாலும் பெருமை பெறும்.","en":"His love will increase though it may (at first seem to) fade through the short-lived distress caused by (my) dislike","lines":[{"t":"ஊடலின் தோன்றும் சிறுதுனி நல்லளி","err":null,"seers":[{"w":"ஊடலின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"டலின்"}]},{"w":"தோன்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோன்"},{"k":"N","s":"றும்"}]},{"w":"சிறுதுனி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"சிறு"},{"k":"I","s":"துனி"}]},{"w":"நல்லளி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"லளி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வாடினும் பாடு பெறும்.","err":null,"seers":[{"w":"வாடினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வா"},{"k":"I","s":"டினும்"}]},{"w":"பாடு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பா"},{"k":"N","s":"டு"}]},{"w":"பெறும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1323,"ch":133,"l1":"புலத்தலின் புத்தேள்நாடு உண்டோ நிலத்தொடு","l2":"நீரியைந் தன்னார் அகத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நிலத்தோடு நீர் பொருந்தி கலந்தாற் போன்ற அன்புடைய காதலரிடத்தில் ஊடுவதை விட இன்பம் தருகின்ற தேவருலம் இருக்கின்றதோ.","en":"Is there a celestial land that can please like the feigned dislike of those whose union resembles that of earth and water?","lines":[{"t":"புலத்தலின் புத்தேள்நாடு உண்டோ நிலத்தொடு","err":null,"seers":[{"w":"புலத்தலின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"புலத்"},{"k":"I","s":"தலின்"}]},{"w":"புத்தேள்நாடு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"புத்"},{"k":"N","s":"தேள்"},{"k":"N","s":"நா"},{"k":"N","s":"டு"}]},{"w":"உண்டோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டோ"}]},{"w":"நிலத்தொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நிலத்"},{"k":"I","s":"தொடு"}]}],"thalai":["இயற்சீர் வெண்டளை",null,"இயற்சீர் வெண்டளை"]},{"t":"நீரியைந் தன்னார் அகத்து.","err":null,"seers":[{"w":"நீரியைந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீ"},{"k":"I","s":"ரியைந்"}]},{"w":"தன்னார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தன்"},{"k":"N","s":"னார்"}]},{"w":"அகத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அகத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1324,"ch":133,"l1":"புல்லி விடாஅப் புலவியுள் தோன்றுமென்","l2":"உள்ளம் உடைக்கும் படை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"காதலரைத் தழுவிக்கொண்டு விடாமலிருப்பதற்கு காரணமான ஊடலுள், என்னுடைய உள்ளத்தை உடைக்க வல்ல படை தோன்றுகிறது.","en":"In prolonged dislike after an embrace there is a weapon that can break my heart","lines":[{"t":"புல்லி விடாஅப் புலவியுள் தோன்றுமென்","err":null,"seers":[{"w":"புல்லி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"புல்"},{"k":"N","s":"லி"}]},{"w":"விடாஅப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விடா"},{"k":"N","s":"அப்"}]},{"w":"புலவியுள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"புல"},{"k":"I","s":"வியுள்"}]},{"w":"தோன்றுமென்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தோன்"},{"k":"I","s":"றுமென்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உள்ளம் உடைக்கும் படை.","err":null,"seers":[{"w":"உள்ளம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளம்"}]},{"w":"உடைக்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடைக்"},{"k":"N","s":"கும்"}]},{"w":"படை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1325,"ch":133,"l1":"தவறிலர் ஆயினும் தாம்வீழ்வார் மென்றோள்","l2":"அகறலின் ஆங்கொன் றுடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தவறு இல்லாத போதும் ஊடலுக்கு ஆளாகித் தாம் விரும்பும் மகளிரின் மெல்லிய தோள்களை நீங்கி இருக்கும் போது ஓர் இன்பம் உள்ளது.","en":"Though free from defects, men feel pleased when they cannot embrace the delicate shoulders of those whom they love","lines":[{"t":"தவறிலர் ஆயினும் தாம்வீழ்வார் மென்றோள்","err":null,"seers":[{"w":"தவறிலர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தவ"},{"k":"I","s":"றிலர்"}]},{"w":"ஆயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"யினும்"}]},{"w":"தாம்வீழ்வார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தாம்"},{"k":"N","s":"வீழ்"},{"k":"N","s":"வார்"}]},{"w":"மென்றோள்","name":