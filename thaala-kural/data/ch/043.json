ம் இல்லாதவரே ஆவர்.","en":"Those who possess wisdom, possess every thing; those who have not wisdom, whatever they may possess, have nothing","lines":[{"t":"அறிவுடையார் எல்லா முடையார் அறிவிலார்","err":null,"seers":[{"w":"அறிவுடையார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வுடை"},{"k":"N","s":"யார்"}]},{"w":"எல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லா"}]},{"w":"முடையார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முடை"},{"k":"N","s":"யார்"}]},{"w":"அறிவிலார்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"விலார்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"என்னுடைய ரேனும் இலர்.","err":null,"seers":[{"w":"என்னுடைய","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"I","s":"னுடை"},{"k":"N","s":"ய"}]},{"w":"ரேனும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ரே"},{"k":"N","s":"னும்"}]},{"w":"இலர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"இலர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]