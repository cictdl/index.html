[{"n":421,"ch":43,"l1":"அறிவற்றங் காக்குங் கருவி செறுவார்க்கும்","l2":"உள்ளழிக்க லாகா அரண்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அறிவு அழிவு வராமல் காக்கும் கருவியாகும், அன்றியும் பகைகொண்டு எதிர்ப்பவர்க்கும் அழிக்க முடியாத உள்ளரணும் ஆகும்.","en":"Wisdom is a weapon to ward off destruction; it is an inner fortress which enemies cannot destroy","lines":[{"t":"அறிவற்றங் காக்குங் கருவி செறுவார்க்கும்","err":null,"seers":[{"w":"அறிவற்றங்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வற்"},{"k":"N","s":"றங்"}]},{"w":"காக்குங்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காக்"},{"k":"N","s":"குங்"}]},{"w":"கருவி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரு"},{"k":"N","s":"வி"}]},{"w":"செறுவார்க்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செறு"},{"k":"N","s":"வார்க்"},{"k":"N","s":"கும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உள்ளழிக்க லாகா அரண்.","err":null,"seers":[{"w":"உள்ளழிக்க","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளழிக்"},{"k":"N","s":"க"}]},{"w":"லாகா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"லா"},{"k":"N","s":"கா"}]},{"w":"அரண்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அரண்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":422,"ch":43,"l1":"சென்ற இடத்தால் செலவிடா தீதொரீஇ","l2":"நன்றின்பால் உய்ப்ப தறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மனத்தை சென்ற இடத்தில் செல்லவிடாமல், தீமையானதிலிருந்து நீக்கிக் காத்து நன்மையானதில் செல்லவிடுவதே அறிவாகும்.","en":"Not to permit the mind to go where it lists, to keep it from evil, and to employ it in good, this is wisdom","lines":[{"t":"சென்ற இடத்தால் செலவிடா தீதொரீஇ","err":null,"seers":[{"w":"சென்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சென்"},{"k":"N","s":"ற"}]},{"w":"இடத்தால்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடத்"},{"k":"N","s":"தால்"}]},{"w":"செலவிடா","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"செல"},{"k":"I","s":"விடா"}]},{"w":"தீதொரீஇ","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"தொரீ"},{"k":"N","s":"இ"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நன்றின்பால் உய்ப்ப தறிவு.","err":null,"seers":[{"w":"நன்றின்பால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றின்"},{"k":"N","s":"பால்"}]},{"w":"உய்ப்ப","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உய்ப்"},{"k":"N","s":"ப"}]},{"w":"தறிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தறி"},{"k":"N","s":"வு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":423,"ch":43,"l1":"எப்பொருள் யார்யார்வாய்க் கேட்பினும் அப்பொருள்","l2":"மெய்ப்பொருள் காண்ப தறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"எப்பொருளை யார் யார் இடம் கேட்டாலும் (கேட்டவாறே கொள்ளாமல்) அப் பொருளின் மெய்யானப் பொருளைக் காண்பதே அறிவாகும்.","en":"To discern the truth in every thing, by whomsoever spoken, is wisdom","lines":[{"t":"எப்பொருள் யார்யார்வாய்க் கேட்பினும் அப்பொருள்","err":null,"seers":[{"w":"எப்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எப்"},{"k":"I","s":"பொருள்"}]},{"w":"யார்யார்வாய்க்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யார்"},{"k":"N","s":"யார்"},{"k":"N","s":"வாய்க்"}]},{"w":"கேட்பினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கேட்"},{"k":"I","s":"பினும்"}]},{"w":"அப்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அப்"},{"k":"I","s":"பொருள்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மெய்ப்பொருள் காண்ப தறிவு.","err":null,"seers":[{"w":"மெய்ப்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மெய்ப்"},{"k":"I","s":"பொருள்"}]},{"w":"காண்ப","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காண்"},{"k":"N","s":"ப"}]},{"w":"தறிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தறி"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":424,"ch":43,"l1":"எண்பொருள வாகச் செலச்சொல்லித் தான்பிறர்வாய்","l2":"நுண்பொருள் காண்ப தறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"தான் சொல்லுவன எளிய பொருளையுடையனவாகப் பதியுமாறு சொல்லி, தான் பிறரிடம் கேட்பவற்றின் நுட்பமானப் பொருளையும் ஆராய்ந்து காண்பது அறிவாகும்.","en":"To speak so as that the meaning may easily enter the mind of the hearer, and to discern the subtlest thought which may lie hidden in the words of others, this is wisdom","lines":[{"t":"எண்பொருள வாகச் செலச்சொல்லித் தான்பிறர்வாய்","err":null,"seers":[{"w":"எண்பொருள","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"எண்"},{"k":"I","s":"பொரு"},{"k":"N","s":"ள"}]},{"w":"வாகச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"கச்"}]},{"w":"செலச்சொல்லித்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"செலச்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லித்"}]},{"w":"தான்பிறர்வாய்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தான்"},{"k":"I","s":"பிறர்"},{"k":"N","s":"வாய்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நுண்பொருள் காண்ப தறிவு.","err":null,"seers":[{"w":"நுண்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நுண்"},{"k":"I","s":"பொருள்"}]},{"w":"காண்ப","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காண்"},{"k":"N","s":"ப"}]},{"w":"தறிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தறி"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":425,"ch":43,"l1":"உலகம் தழீஇய தொட்பம் மலர்தலும்","l2":"கூம்பலும் இல்ல தறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"உலகத்து உயர்ந்தவரை நட்பாக்கி கொள்வது சிறந்த அறிவு, முன்னே மகிழ்ந்து விரிதலும் பின்னே வருந்திக் குவிதலும் இல்லாத அறிவு.","en":"To secure the friendship of the great is true wisdom; it is (also) wisdom to keep (that friendship unchanged, and) not opening and closing (like the lotus flower)","lines":[{"t":"உலகம் தழீஇய தொட்பம் மலர்தலும்","err":null,"seers":[{"w":"உலகம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உல"},{"k":"N","s":"கம்"}]},{"w":"தழீஇய","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தழீ"},{"k":"I","s":"இய"}]},{"w":"தொட்பம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தொட்"},{"k":"N","s":"பம்"}]},{"w":"மலர்தலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மலர்"},{"k":"I","s":"தலும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கூம்பலும் இல்ல தறிவு.","err":null,"seers":[{"w":"கூம்பலும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கூம்"},{"k":"I","s":"பலும்"}]},{"w":"இல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"ல"}]},{"w":"தறிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தறி"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":426,"ch":43,"l1":"எவ்வ துறைவது உலகம் உலகத்தோடு","l2":"அவ்வ துறைவ தறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":[null],"mv":"உலகம் எவ்வாறு நடைபெறுகின்றதோ, உலகத்தோடு பொருந்திய வகையில் தானும் அவ்வாறு நடப்பதே அறிவாகும்.","en":"To live as the world lives, is wisdom","lines":[{"t":"எவ்வ துறைவது உலகம் உலகத்தோடு","err":null,"seers":[{"w":"எவ்வ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எவ்"},{"k":"N","s":"வ"}]},{"w":"துறைவது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"துறை"},{"k":"I","s":"வது"}]},{"w":"உலகம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உல"},{"k":"N","s":"கம்"}]},{"w":"உலகத்தோடு","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"உல"},{"k":"N","s":"கத்"},{"k":"N","s":"தோ"},{"k":"N","s":"டு"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"அவ்வ துறைவ தறிவு.","err":null,"seers":[{"w":"அவ்வ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அவ்"},{"k":"N","s":"வ"}]},{"w":"துறைவ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துறை"},{"k":"N","s":"வ"}]},{"w":"தறிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தறி"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":427,"ch":43,"l1":"அறிவுடையார் ஆவ தறிவார் அறிவிலார்","l2":"அஃதறி கல்லா தவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறிவுடையோர் எதிர்காலத்தில் நிகழப்போவதை முன்னே எண்ணி அறியவல்லார், அறிவில்லாதவர் அதனை அறிய முடியாதவர்.","en":"The wise are those who know beforehand what will happen; those who do not know this are the unwise","lines":[{"t":"அறிவுடையார் ஆவ தறிவார் அறிவிலார்","err":null,"seers":[{"w":"அறிவுடையார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வுடை"},{"k":"N","s":"யார்"}]},{"w":"ஆவ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"வ"}]},{"w":"தறிவார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தறி"},{"k":"N","s":"வார்"}]},{"w":"அறிவிலார்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"விலார்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அஃதறி கல்லா தவர்.","err":null,"seers":[{"w":"அஃதறி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஃ"},{"k":"I","s":"தறி"}]},{"w":"கல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லா"}]},{"w":"தவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தவர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":428,"ch":43,"l1":"அஞ்சுவ தஞ்சாமை பேதைமை அஞ்சுவது","l2":"அஞ்சல் அறிவார் தொழில்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அஞ்சத்தக்கதைக் கண்டு அஞ்சாதிருப்பது அறியாமையாகும், அஞ்சத் தக்கதைக் கண்டு அஞ்சுவதே அறிவுடையவரின் தொழிலாகும்.","en":"Not to fear what ought to be feared, is folly; it is the work of the wise to fear what should be feared","lines":[{"t":"அஞ்சுவ தஞ்சாமை பேதைமை அஞ்சுவது","err":null,"seers":[{"w":"அஞ்சுவ","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஞ்"},{"k":"I","s":"சுவ"}]},{"w":"தஞ்சாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தஞ்"},{"k":"N","s":"சா"},{"k":"N","s":"மை"}]},{"w":"பேதைமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"மை"}]},{"w":"அஞ்சுவது","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"