[{"n":1061,"ch":107,"l1":"கரவாது உவந்தீயும் கண்ணன்னார் கண்ணும்","l2":"இரவாமை கோடி உறும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"உள்ளதை மறைக்காமல் உள்ளம் மகிழ்ந்து கொடுக்கும் கண்போல் சிறந்தவரிடத்திலும் சென்று இரவாமலிருப்பதே கோடி மடங்கு நல்லதாகும்.","en":"Not to beg (at all) even from those excellent persons who cheerfully give without refusing, will do immense good","lines":[{"t":"கரவாது உவந்தீயும் கண்ணன்னார் கண்ணும்","err":null,"seers":[{"w":"கரவாது","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கர"},{"k":"N","s":"வா"},{"k":"N","s":"து"}]},{"w":"உவந்தீயும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உவந்"},{"k":"N","s":"தீ"},{"k":"N","s":"யும்"}]},{"w":"கண்ணன்னார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணன்"},{"k":"N","s":"னார்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]}],"thalai":["கலித்தளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இரவாமை கோடி உறும்.","err":null,"seers":[{"w":"இரவாமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இர"},{"k":"N","s":"வா"},{"k":"N","s":"மை"}]},{"w":"கோடி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கோ"},{"k":"N","s":"டி"}]},{"w":"உறும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"உறும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1062,"ch":107,"l1":"இரந்தும் உயிர்வாழ்தல் வேண்டின் பரந்து","l2":"கெடுக உலகியற்றி யான்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"உலகத்தை படைத்தவன் உலகில் சிலர் இரந்தும் உயிர்வாழுமாறு ஏற்படுத்தியிருந்தால், அவன் இரப்பவரைப் போல் எங்கும் அலைந்து கெடுவானாக.","en":"If the Creator of the world has decreed even begging as a means of livelihood, may he too go abegging and perish","lines":[{"t":"இரந்தும் உயிர்வாழ்தல் வேண்டின் பரந்து","err":null,"seers":[{"w":"இரந்தும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இரந்"},{"k":"N","s":"தும்"}]},{"w":"உயிர்வாழ்தல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உயிர்"},{"k":"N","s":"வாழ்"},{"k":"N","s":"தல்"}]},{"w":"வேண்டின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டின்"}]},{"w":"பரந்து","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பரந்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கெடுக உலகியற்றி யான்.","err":null,"seers":[{"w":"கெடுக","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கெடு"},{"k":"N","s":"க"}]},{"w":"உலகியற்றி","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உல"},{"k":"I","s":"கியற்"},{"k":"N","s":"றி"}]},{"w":"யான்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"யான்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1063,"ch":107,"l1":"இன்மை இடும்பை இரந்துதீர் வாமென்னும்","l2":"வன்மையின் வன்பாட்ட தில்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வறுமைத் துன்பத்தை இரப்பதன் வாயிலாகத் தீர்ப்போம், என்று கருதி முயற்சியைக் கைவிட்ட வன்மையைப் போல் வன்மையானது வேறு இல்லை.","en":"There is no greater folly than the boldness with which one seeks to remedy the evils of poverty by begging (rather than by working)","lines":[{"t":"இன்மை இடும்பை இரந்துதீர் வாமென்னும்","err":null,"seers":[{"w":"இன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"}]},{"w":"இடும்பை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடும்"},{"k":"N","s":"பை"}]},{"w":"இரந்துதீர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இரந்"},{"k":"I","s":"துதீர்"}]},{"w":"வாமென்னும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"N","s":"மென்"},{"k":"N","s":"னும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வன்மையின் வன்பாட்ட தில்.","err":null,"seers":[{"w":"வன்மையின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வன்"},{"k":"N","s":"மை"},{"k":"N","s":"யின்"}]},{"w":"வன்பாட்ட","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வன்"},{"k":"N","s":"பாட்"},{"k":"N","s":"ட"}]},{"w":"தில்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தில்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1064,"ch":107,"l1":"இடமெல்லாம் கொள்ளாத் தகைத்தே இடமில்லாக்","l2":"காலும் இரவொல்லாச் சால்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"வாழ வழி இல்லாத போதும் இரந்து கேட்க உடன்படாத சால்பு, உலகத்தில் இடமெல்லாம் கொள்ளாத அவ்வளவு பொருமையுடையதாகும்.","en":"Even the whole world cannot sufficiently praise the dignity that would not beg even in the midst of destitution","lines":[{"t":"இடமெல்லாம் கொள்ளாத் தகைத்தே இடமில்லாக்","err":null,"seers":[{"w":"இடமெல்லாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இட"},{"k":"N","s":"மெல்"},{"k":"N","s":"லாம்"}]},{"w":"கொள்ளாத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"ளாத்"}]},{"w":"தகைத்தே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தகைத்"},{"k":"N","s":"தே"}]},{"w":"இடமில்லாக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இட"},{"k":"N","s":"மில்"},{"k":"N","s":"லாக்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"காலும் இரவொல்லாச் சால்பு.","err":null,"seers":[{"w":"காலும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"லும்"}]},{"w":"இரவொல்லாச்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இர"},{"k":"N","s":"வொல்"},{"k":"N","s":"லாச்"}]},{"w":"சால்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சால்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1065,"ch":107,"l1":"தெண்ணீர் அடுபுற்கை ஆயினும் தாள்தந்தது","l2":"உண்ணலின் ஊங்கினிய தில்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["ஒன்றிய வஞ்சித்தளை"],"mv":"தெளிந்த நீர் போல் சமைத்த கூழே ஆனாலும், முயற்சியால் கிடைத்ததை உண்பதைவிட இனிமையானது வேறொன்றும் இல்லை.","en":"Even thin gruel is ambrosia to him who has obtained it by labour","lines":[{"t":"தெண்ணீர் அடுபுற்கை ஆயினும் தாள்தந்தது","err":null,"seers":[{"w":"தெண்ணீர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தெண்"},{"k":"N","s":"ணீர்"}]},{"w":"அடுபுற்கை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அடு"},{"k":"N","s":"புற்"},{"k":"N","s":"கை"}]},{"w":"ஆயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"யினும்"}]},{"w":"தாள்தந்தது","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"தாள்"},{"k":"N","s":"தந்"},{"k":"I","s":"தது"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உண்ணலின் ஊங்கினிய தில்.","err":null,"seers":[{"w":"உண்ணலின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உண்"},{"k":"I","s":"ணலின்"}]},{"w":"ஊங்கினிய","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊங்"},{"k":"I","s":"கினி"},{"k":"N","s":"ய"}]},{"w":"தில்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தில்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1066,"ch":107,"l1":"ஆவிற்கு நீரென்று இரப்பினும் நாவிற்கு","l2":"இரவின் இளிவந்த தில்.","ok":true,"reseg":true,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பசுவிற்கு நீர் வேண்டும் என்று அறம் நோக்கி இரந்து கேட்டாலும், இர த்தலை விட நாவிற்கு இழிவானது மற்றொன்று இல்லை.","en":"There is nothing more disgraceful to one's tongue than to use it in begging water even for a cow","lines":[{"t":"ஆவிற்கு நீரென்று இரப்பினும் நாவிற்கு","err":null,"seers":[{"w":"ஆவிற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"விற்"}]},{"w":"குநீரென்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குநீ"},{"k":"N","s":"ரென்"}]},{"w":"றிரப்பினும்நா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"றிரப்"},{"k":"I","s":"பினும்"},{"k":"N","s":"நா"}]},{"w":"விற்கு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"விற்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இரவின் இளிவந்த தில்.","err":null,"seers":[{"w":"இரவின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இர"},{"k":"N","s":"வின்"}]},{"w":"இளிவந்த","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இளி"},{"k":"N","s":"வந்"},{"k":"N","s":"த"}]},{"w":"தில்","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தில்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1067,"ch":107,"l1":"இரப்பன் இரப்பாரை எல்லாம் இரப்பின்","l2":"கரப்பார் இரவன்மின் என்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"இரந்து கேட்பதனால் உள்ளதை ஒளிப்பவரிடத்தில் சென்று இரக்க வேண்டுடாம் என்று இரப்பவர் எல்லோரையும் இரந்து வேண்டுகின்றேன்.","en":"I beseech all beggars and say, \"If you need to beg, never beg of those who give unwillingly.\"","lines":[{"t":"இரப்பன் இரப்பாரை எல்லாம் இரப்பின்","err":null,"seers":[{"w":"இரப்பன்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இரப்"},{"k":"N","s":"பன்"}]},{"w":"இரப்பாரை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இரப்"},{"k":"N","s":"பா"},{"k":"N","s":"ரை"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"இரப்பின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இரப்"},{"k":"N","s":"பின்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கரப்பார் இரவன்மின் என்று.","err":null,"seers":[{"w":"கரப்பார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரப்"},{"k":"N","s":"பார்"}]},{"w":"இரவன்மின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இர"},{"k":"N","s":"வன்"},{"k":"N","s":"மின்"}]},{"w":"என்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1068,"ch":107,"l1":"இரவென்னும் ஏமாப்பில் தோணி கரவென்னும்","l2":"பார்தாக்கப் பக்கு விடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இரத்தல் என்னும் காவல் இல்லாத மரக்கலம் உள்ளதை ஒளித்துவைக்கும் தன்மையாகிய வன்னிலம் தாக்கினால் உடைந்து விடும்.","en":"The unsafe raft of begging will split when it strikes on the rock of refusal","lines":[{"t":"இரவென்னும் ஏமாப்பில் தோணி கரவென்னும்","err":null,"seers":[{"w":"இரவென்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இர"},{"k":"N","s":"வென்"},{"k":"N","s":"னும்"}]},{"w":"ஏமாப்பில்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"மாப்"},{"k":"N","s":"பில்"}]},{"w":"தோணி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோ"},{"k":"N","s":"ணி"}]},{"w":"கரவென்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கர"},{"k":"N","s":"வென்"},{"k":"N","s":"னும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பார்தாக்கப் பக்கு விடும்.","err":null,"seers":[{"w":"பார்தாக்கப்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பார்"},{"k":"N","s":"தாக்"},{"k":"N","s":"கப்"}]},{"w":"பக்கு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பக்"},{"k":"N","s":"கு"}]},{"w":"விடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1069,"ch":107,"l1":"இரவுள்ள உள்ளம் உருகும் கரவுள்ள","l2":"உள்ளதூஉம் இன்றிக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இரத்தலின் கொடுமையை நினைத்தால் உள்ளம் கரைந்து உருகும், உள்ளதை ஒழிக்கும் கொடுமையை நினைத்தால் உருகுமளவும் இல்லாமல் அழியும்.","en":"To think of (the evil of) begging is enough to melt one's heart; but to think of refusal is enough to break it","lines":[{"t":"இரவுள்ள உள்ளம் உருகும் கரவுள்ள","err":null,"seers":[{"w":"இரவுள்ள","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இர"},{"k":"N","s":"வுள்"},{"k":"N","s":"ள"}]},{"w":"உள்ளம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளம்"}]},{"w":"உருகும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உரு"},{"k":"N","s":"கும்"}]},{"w":"கரவுள்ள","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கர"},{"k":"N","s":"வுள்"},{"k":"N","s":"ள"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உள்ளதூஉம் இன்றிக் கெடும்.","err":null,"seers":[{"w":"உள்ளதூஉம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளதூ"},{"k":"N","s":"உம்"}]},{"w":"இன்றிக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"றிக்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1070,"ch":107,"l1":"கரப்பவர்க்கு யாங்கொளிக்கும் கொல்லோ இரப்பவர்","l2":"சொல்லாடப் போஒம் உயிர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இரப்பவர் இல்லை என்று சொல்கின்ற அளவிலேயே உயிர் போகின்றதே, உள்ளதை இல்லை என்று ஒளிப்பவர்க்கு உயிர் எங்கு ஒளிந்திருக்குமோ.","en":"Saying \"No\" to a beggar takes away his life. (but as that very word will kill the refuser) where then would the latter's life hide itself ?","lines":[{"t":"கரப்பவர்க்கு யாங்கொளிக்கும் கொல்லோ இரப்பவர்","err":null,"seers":[{"w":"கரப்பவர்க்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கரப்"},{"k":"I","s":"பவர்க்"},{"k":"N","s":"கு"}]},{"w":"யாங்கொளிக்கும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"யாங்"},{"k":"I","s":"கொளிக்"},{"k":"N","s":"கும்"}]},{"w":"கொல்லோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லோ"}]},{"w":"இரப்பவர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இரப்"},{"k":"I","s":"பவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சொல்லாடப் போஒம் உயிர்.","err":null,"seers":[{"w":"சொல்லாடப்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லா"},{"k":"N","s":"டப்"}]},{"w":"போஒம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"ஒம்"}]},{"w":"உயிர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"உயிர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]