[{"n":181,"ch":19,"l1":"அறங்கூறான் அல்ல செயினும் ஒருவன்","l2":"புறங்கூறான் என்றல் இனிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் அறத்தைப் போற்றிக் கூறாதவனாய் அறமல்லாதவற்றைச் செய்தாலும், மற்றவனைப் பற்றிப் புறங்கூறாமல் இருக்கிறான் என்று சொல்லப்படுதல் நல்லது.","en":"Though one do not even speak of virtue and live in sin, it will be well if it be said of him \"he does not backbite.\"","lines":[{"t":"அறங்கூறான் அல்ல செயினும் ஒருவன்","err":null,"seers":[{"w":"அறங்கூறான்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறங்"},{"k":"N","s":"கூ"},{"k":"N","s":"றான்"}]},{"w":"அல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அல்"},{"k":"N","s":"ல"}]},{"w":"செயினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செயி"},{"k":"N","s":"னும்"}]},{"w":"ஒருவன்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"புறங்கூறான் என்றல் இனிது.","err":null,"seers":[{"w":"புறங்கூறான்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"புறங்"},{"k":"N","s":"கூ"},{"k":"N","s":"றான்"}]},{"w":"என்றல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"றல்"}]},{"w":"இனிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இனி"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":182,"ch":19,"l1":"அறனழீஇ அல்லவை செய்தலின் தீதே","l2":"புறனழீஇப் பொய்த்து நகை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறத்தை அழித்துப் பேசி அறமல்லாதவைகளைச் செய்வதை விட, ஒருவன் இல்லாதவிடத்தில் அவனைப் பழித்துப் பேசி நேரில் பொய்யாக முகமலர்ந்து பேசுதல் தீமையாகும்.","en":"To smile deceitfully (in another's presence) after having reviled him to his destruction (behind his back) is a greater evil than the commission of (every other) sin and the destruction of (every) virtue","lines":[{"t":"அறனழீஇ அல்லவை செய்தலின் தீதே","err":null,"seers":[{"w":"அறனழீஇ","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அற"},{"k":"I","s":"னழீ"},{"k":"N","s":"இ"}]},{"w":"அல்லவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அல்"},{"k":"I","s":"லவை"}]},{"w":"செய்தலின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"தலின்"}]},{"w":"தீதே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"தே"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"புறனழீஇப் பொய்த்து நகை.","err":null,"seers":[{"w":"புறனழீஇப்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"புற"},{"k":"I","s":"னழீ"},{"k":"N","s":"இப்"}]},{"w":"பொய்த்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பொய்த்"},{"k":"N","s":"து"}]},{"w":"நகை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"நகை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":183,"ch":19,"l1":"புறங்கூறிப் பொய்த்துயிர் வாழ்தலின் சாதல்","l2":"அறங்கூற்றும் ஆக்கத் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"புறங்கூறிப் பொய்யாக நடந்து உயிர் வாழ்தலை விட, அவ்வாறு செய்யாமல் வறுமையுற்று இறந்து விடுதல், அறநூல்கள் சொல்லும் ஆக்கத்தைத் தரும்‌‌.","en":"Death rather than life will confer upon the deceitful backbiter the profit which (the treatises on) virtue point out","lines":[{"t":"புறங்கூறிப் பொய்த்துயிர் வாழ்தலின் சாதல்","err":null,"seers":[{"w":"புறங்கூறிப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"புறங்"},{"k":"N","s":"கூ"},{"k":"N","s":"றிப்"}]},{"w":"பொய்த்துயிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பொய்த்"},{"k":"I","s":"துயிர்"}]},{"w":"வாழ்தலின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வாழ்"},{"k":"I","s":"தலின்"}]},{"w":"சாதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சா"},{"k":"N","s":"தல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அறங்கூற்றும் ஆக்கத் தரும்.","err":null,"seers":[{"w":"அறங்கூற்றும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறங்"},{"k":"N","s":"கூற்"},{"k":"N","s":"றும்"}]},{"w":"ஆக்கத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கத்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":184,"ch":19,"l1":"கண்ணின்று கண்ணறச் சொல்லினும் சொல்லற்க","l2":"முன்னின்று பின்நோக்காச் சொல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"எதிரே நின்று கண்ணோ‌ட்டம் இல்லாமல் கடுமையாகச் சொன்னாலும் சொல்லலாம்; நேரில் இல்லாதபோது பின் விளைவை ஆராயாத சொல்லைச் சொல்லக்கூடாது.","en":"Though you speak without kindness before another's face speak not in his absence words which regard not the evil subsequently resulting from it","lines":[{"t":"கண்ணின்று கண்ணறச் சொல்லினும் சொல்லற்க","err":null,"seers":[{"w":"கண்ணின்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணின்"},{"k":"N","s":"று"}]},{"w":"கண்ணறச்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கண்"},{"k":"I","s":"ணறச்"}]},{"w":"சொல்லினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லினும்"}]},{"w":"சொல்லற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லற்"},{"k":"N","s":"க"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"முன்னின்று பின்நோக்காச் சொல்.","err":null,"seers":[{"w":"முன்னின்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"முன்"},{"k":"N","s":"னின்"},{"k":"N","s":"று"}]},{"w":"பின்நோக்காச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பின்"},{"k":"N","s":"நோக்"},{"k":"N","s":"காச்"}]},{"w":"சொல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"சொல்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":185,"ch":19,"l1":"அறஞ்சொல்லும் நெஞ்சத்தான் அன்மை புறஞ்சொல்லும்","l2":"புன்மையாற் காணப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அறத்தை நல்லதென்று போற்றும் நெஞ்சம் இல்லாததன்மை, ஒருவன் மற்றவனைப் பற்றிப் புறங்கூறுகின்ற சிறுமையால் காணப்படும்.","en":"The emptiness of that man's mind who (merely) praises virtue will be seen from the meanness of reviling another behind his back","lines":[{"t":"அறஞ்சொல்லும் நெஞ்சத்தான் அன்மை புறஞ்சொல்லும்","err":null,"seers":[{"w":"அறஞ்சொல்லும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறஞ்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லும்"}]},{"w":"நெஞ்சத்தான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சத்"},{"k":"N","s":"தான்"}]},{"w":"அன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"மை"}]},{"w":"புறஞ்சொல்லும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"புறஞ்"},{"k":"N","s":"சொல்"},{"k":"N","s":"லும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"புன்மையாற் காணப் படும்.","err":null,"seers":[{"w":"புன்மையாற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"புன்"},{"k":"N","s":"மை"},{"k":"N","s":"யாற்"}]},{"w":"காணப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":186,"ch":19,"l1":"பிறன்பழி கூறுவான் தன்பழி யுள்ளும்","l2":"திறன்தெரிந்து கூறப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மற்றவனைப் பற்றிப் புறங்கூறுகின்றவன், அவனுடைய பழிகள் பலவற்றிலும் நோகத்தக்கவை ஆராய்ந்து கூறிப் பிறரால் பழிக்கப்படுவான்.","en":"The character of the faults of that man who publishes abroad the faults of others will be sought out and published","lines":[{"t":"பிறன்பழி கூறுவான் தன்பழி யுள்ளும்","err":null,"seers":[{"w":"பிறன்பழி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பிறன்"},{"k":"I","s":"பழி"}]},{"w":"கூறுவான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கூ"},{"k":"I","s":"றுவான்"}]},{"w":"தன்பழி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தன்"},{"k":"I","s":"பழி"}]},{"w":"யுள்ளும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யுள்"},{"k":"N","s":"ளும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"திறன்தெரிந்து கூறப் படும்.","err":null,"seers":[{"w":"திறன்த