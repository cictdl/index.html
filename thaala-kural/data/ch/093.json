[{"n":921,"ch":93,"l1":"உட்கப் படாஅர் ஒளியிழப்பர் எஞ்ஞான்றும்","l2":"கட்காதல் கொண்டொழுகு வார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கள்ளின் மேல் விருப்பம் கொண்டு நடப்பவர், எக்காலத்திலும் பகைவரால் அஞ்சப்படார், தமக்கு உள்ள புகழையும் இழந்து விடுவார்.","en":"Those who always thirst after drink will neither inspire fear (in others) nor retain the light (of their fame)","lines":[{"t":"உட்கப் படாஅர் ஒளியிழப்பர் எஞ்ஞான்றும்","err":null,"seers":[{"w":"உட்கப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உட்"},{"k":"N","s":"கப்"}]},{"w":"படாஅர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"படா"},{"k":"N","s":"அர்"}]},{"w":"ஒளியிழப்பர்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒளி"},{"k":"I","s":"யிழப்"},{"k":"N","s":"பர்"}]},{"w":"எஞ்ஞான்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எஞ்"},{"k":"N","s":"ஞான்"},{"k":"N","s":"றும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கட்காதல் கொண்டொழுகு வார்.","err":null,"seers":[{"w":"கட்காதல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கட்"},{"k":"N","s":"கா"},{"k":"N","s":"தல்"}]},{"w":"கொண்டொழுகு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கொண்"},{"k":"I","s":"டொழு"},{"k":"N","s":"கு"}]},{"w":"வார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"வார்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":922,"ch":93,"l1":"உண்ணற்க கள்ளை உணில்உண்க சான்றோரான்","l2":"எண்ணப் படவேண்டா தார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கள்ளை உண்ணக் கூடாது, சான்றோரால் நன்கு எண்ணப்படுவதை விரும்பாதவர் கள்ளை உண்ண வேண்டுமானால் உண்ணலாம்.","en":"Let no liquor be drunk; if it is desired, let it be drunk by those who care not for esteem of the great","lines":[{"t":"உண்ணற்க கள்ளை உணில்உண்க சான்றோரான்","err":null,"seers":[{"w":"உண்ணற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உண்"},{"k":"N","s":"ணற்"},{"k":"N","s":"க"}]},{"w":"கள்ளை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளை"}]},{"w":"உணில்உண்க","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உணில்"},{"k":"N","s":"உண்"},{"k":"N","s":"க"}]},{"w":"சான்றோரான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சான்"},{"k":"N","s":"றோ"},{"k":"N","s":"ரான்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"எண்ணப் படவேண்டா தார்.","err":null,"seers":[{"w":"எண்ணப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எண்"},{"k":"N","s":"ணப்"}]},{"w":"படவேண்டா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பட"},{"k":"N","s":"வேண்"},{"k":"N","s":"டா"}]},{"w":"தார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":923,"ch":93,"l1":"ஈன்றாள் முகத்தேயும் இன்னாதால் என்மற்றுச்","l2":"சான்றோர் முகத்துக் களி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பெற்றதாயின் முகத்திலும் கள்ளுண்டு மயங்குதல் துன்பம் தருவதாகும், அப்படியானால் குற்றம் கடியும் இயல்புடைய சான்றோரின் முகத்தில் அது எண்ணவாகும்.","en":"Intoxication is painful even in the presence of (one's) mother; what will it not then be in that of the wise ?","lines":[{"t":"ஈன்றாள் முகத்தேயும் இன்னாதால் என்மற்றுச்","err":null,"seers":[{"w":"ஈன்றாள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈன்"},{"k":"N","s":"றாள்"}]},{"w":"முகத்தேயும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முகத்"},{"k":"N","s":"தே"},{"k":"N","s":"யும்"}]},{"w":"இன்னாதால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"N","s":"தால்"}]},{"w":"என்மற்றுச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"N","s":"மற்"},{"k":"N","s":"றுச்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"சான்றோர் முகத்துக் களி.","err":null,"seers":[{"w":"சான்றோர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சான்"},{"k":"N","s":"றோர்"}]},{"w":"முகத்துக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முகத்"},{"k":"N","s":"துக்"}]},{"w":"களி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"களி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":924,"ch":93,"l1":"நாண்என்னும் நல்லாள் புறங்கொடுக்கும் கள்ளென்னும்","l2":"பேணாப் பெருங்குற்றத் தார்க்கு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"நாணம் என்று சொல்லப்படும் நல்லவள், கள் என்று சொல்லப்படும் விரும்பத்தக்காத பெருங்குற்றம் உடையவர்க்கு எதிரே நிற்காமல் செய்வாள்.","en":"The fair maid of modesty will turn her back on those who are guilty of the great and abominable crime of drunkenness","lines":[{"t":"நாண்என்னும் நல்லாள் புறங்கொடுக்கும் கள்ளென்னும்","err":null,"seers":[{"w":"நாண்என்னும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நாண்"},{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"நல்லாள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நல்"},{"k":"N","s":"லாள்"}]},{"w":"புறங்கொடுக்கும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"புறங்"},{"k":"I","s":"கொடுக்"},{"k":"N","s":"கும்"}]},{"w":"கள்ளென்னும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளென்"},{"k":"N","s":"னும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பேணாப் பெருங்குற்றத் தார்க்கு.","err":null,"seers":[{"w":"பேணாப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பே"},{"k":"N","s":"ணாப்"}]},{"w":"பெருங்குற்றத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெருங்"},{"k":"N","s":"குற்"},{"k":"N","s":"றத்"}]},{"w":"தார்க்கு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தார்க்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":925,"ch":93,"l1":"கையறி யாமை உடைத்தே பொருள்கொடுத்து","l2":"மெய்யறி யாமை கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"விளைப் பொருள் கொடுத்து கள்ளுண்டு தன் உடம்பைத் தான் அறியாத நிலையை மேற்கொள்ளுதல், செய்வது இன்னதென்று அறியாத அறியாமை உடையதாகும்.","en":"To give money and purchase unconsciousness is the result of one's ignorance of (one's own actions)","lines":[{"t":"கையறி யாமை உடைத்தே பொருள்கொடுத்து","err":null,"seers":[{"w":"கையறி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கை"},{"k":"I","s":"யறி"}]},{"w":"யாமை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"மை"}]},{"w":"உடைத்தே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடைத்"},{"k":"N","s":"தே"}]},{"w":"பொருள்கொடுத்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருள்"},{"k":"I","s":"கொடுத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மெய்யறி யாமை கொளல்.","err":null,"seers":[{"w":"மெய்யறி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மெய்"},{"k":"I","s":"யறி"}]},{"w":"யாமை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"மை"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":926,"ch":93,"l1":"துஞ்சினார் செத்தாரின் வேறல்லர் எஞ்ஞான்றும்","l2":"நஞ்சுண்பார் கள்ளுண் பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உறங்கினவர் இறந்தவரை விட வேறுபட்டவர் அல்லர், அவ்வாறே கள்ளுண்பவரும் அறிவுமயங்குதலால் நஞ்சு உண்பவரே ஆவர்.","en":"They that sleep resemble the deed; (likewise) they that drink are no other than poison-eaters","lines":[{"t":"துஞ்சினார் செத்தாரின் வேறல்லர் எஞ்ஞான்றும்","err":null,"seers":[{"w":"துஞ்சினார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"துஞ்"},{"k":"I","s":"சினார்"}]},{"w":"செத்தாரின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செத்"},{"k":"N","s":"தா"},{"k":"N","s":"ரின்"}]},{"w":"வேறல்லர்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"றல்"},{"k":"N","s":"லர்"}]},{"w":"எஞ்ஞான்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எஞ்"},{"k":"N","s":"ஞான்"},{"k":"N","s":"றும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நஞ்சுண்பார் கள்ளுண் பவர்.","err":null,"seers":[{"w":"நஞ்சுண்பார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நஞ்"},{"k":"N","s":"சுண்"},{"k":"N","s":"பார்"}]},{"w":"கள்ளுண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளுண்"}]},{"w":"பவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":927,"ch":93,"l1":"உள்ளொற்றி உள்ளூர் நகப்படுவர் எஞ்ஞான்றும்","l2":"கள்ளொற்றிக் கண்சாய் பவர்","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கள்ளை மறைந்திருந்து குடித்து அறிவு மயங்குபவர், உள்ளூரில் வாழ்கின்றவரால் உள்ளான செய்திகள் ஆராயப்பட்டு எந்நாளும் சிரிக்கப்படும்.","en":"Those who always intoxicate themselves by a private (indulgence in) drink; will have their secrets detected and laughed at by their fellow-townsmen","lines":[{"t":"உள்ளொற்றி உள்ளூர் நகப்படுவர் எஞ்ஞான்றும்","err":null,"seers":[{"w":"உள்ளொற்றி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளொற்"},{"k":"N","s":"றி"}]},{"w":"உள்ளூர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளூர்"}]},{"w":"நகப்படுவர்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நகப்"},{"k":"I","s":"படு"},{"k":"N","s":"வர்"}]},{"w":"எஞ்ஞான்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எஞ்"},{"k":"N","s":"ஞான்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கள்ளொற்றிக் கண்சாய் பவர்","err":null,"seers":[{"w":"கள்ளொற்றிக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளொற்"},{"k":"N","s":"றிக்"}]},{"w":"கண்சாய்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"சாய்"}]},{"w":"பவர்","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":928,"ch":93,"l1":"களித்தறியேன் என்பது கைவிடுக நெஞ்சத்து","l2":"ஒளித்ததூஉம் ஆங்கே மிகும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["கலித்தளை"],"mv":"கள்ளுண்பவன் யான் ஒருபோதும் கள்ளுண்டறியேன் என்று சொல்வதை விட வேண்டும், நெஞ்சில் ஒளிந்திருந்த குற்றமும் கள்ளுண்டபோதே வெளிப்படும்.","en":"Let (the drunkard) give up saying \"I have never drunk\"; (for) the moment (he drinks) he will simply betray his former attempt to conceal","lines":[{"t":"களித்தறியேன் என்பது கைவிடுக நெஞ்சத்து","err":null,"seers":[{"w":"களித்தறியேன்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"களித்"},{"k":"I","s":"தறி"},{"k":"N","s":"யேன்"}]},{"w":"என்பது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பது"}]},{"w":"கைவிடுக","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கை"},{"k":"I","s":"விடு"},{"k":"N","s":"க"}]},{"w":"நெஞ்சத்து","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஒளித்ததூஉம் ஆங்கே மிகும்.","err":null,"seers":[{"w":"ஒளித்ததூஉம்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒளித்"},{"k":"I","s":"ததூ"},{"k":"N","s":"உம்"}]},{"w":"ஆங்கே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆங்"},{"k":"N","s":"கே"}]},{"w":"மிகும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"மிகும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":929,"ch":93,"l1":"களித்தானைக் காரணம் காட்டுதல் கீழ்நீர்க்","l2":"குளித்தானைத் தீத்துரீஇ அற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"கள்ளுண்டு மயங்கினவனைக் காரணம் காட்டி தெளிவித்தல், நீரின் கீழ் மூழ்கின ஒருவனைத் தீவிளக்கு கொண்டு தேடினாற் போன்றது.","en":"Reasoning with a drunkard is like going under water with a torch in search of a drowned man","lines":[{"t":"களித்தானைக் காரணம் காட்டுதல் கீழ்நீர்க்","err":null,"seers":[{"w":"களித்தானைக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"களித்"},{"k":"N","s":"தா"},{"k":"N","s":"னைக்"}]},{"w":"காரணம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கா"},{"k":"I","s":"ரணம்"}]},{"w":"காட்டுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"காட்"},{"k":"I","s":"டுதல்"}]},{"w":"கீழ்நீர்க்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கீழ்"},{"k":"N","s":"நீர்க்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"குளித்தானைத் தீத்துரீஇ அற்று.","err":null,"seers":[{"w":"குளித்தானைத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குளித்"},{"k":"N","s":"தா"},{"k":"N","s":"னைத்"}]},{"w":"தீத்துரீஇ","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தீத்"},{"k":"I","s":"துரீ"},{"k":"N","s":"இ"}]},{"w":"அற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அற்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":930,"ch":93,"l1":"கள்ளுண்ணாப் போழ்திற் களித்தானைக் காணுங்கால்","l2":"உள்ளான்கொல் உண்டதன் சோர்வு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவன் தான் கள் உண்ணாத போது கள்ளுண்டு மயங்கினவளைக் காணுமிடத்தில் உண்டு மயங்குவதால் வரும் சோர்வை நினைக்கமாட்டானோ.","en":"When (a drunkard) who is sober sees one who is not, it looks as if he remembered not the evil effects of his (own) drink","lines":[{"t":"கள்ளுண்ணாப் போழ்திற் களித்தானைக் காணுங்கால்","err":null,"seers":[{"w":"கள்ளுண்ணாப்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளுண்"},{"k":"N","s":"ணாப்"}]},{"w":"போழ்திற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போழ்"},{"k":"N","s":"திற்"}]},{"w":"களித்தானைக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"களித்"},{"k":"N","s":"தா"},{"k":"N","s":"னைக்"}]},{"w":"காணுங்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணுங்"},{"k":"N","s":"கால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"உள்ளான்கொல் உண்டதன் சோர்வு.","err":null,"seers":[{"w":"உள்ளான்கொல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளான்"},{"k":"N","s":"கொல்"}]},{"w":"உண்டதன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உண்"},{"k":"I","s":"டதன்"}]},{"w":"சோர்வு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சோர்"},{"k":"N","s":"வு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]