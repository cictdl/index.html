[{"n":711,"ch":72,"l1":"அவையறிநது ஆராய்ந்து சொல்லுக சொல்லின்","l2":"தொகையறிந்த தூய்மை யவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"சொற்களின் தொகுதி அறிந்த தூய்மை உடையவர், அவைக்களத்தின் தன்மை அறிந்து ஏற்றச் சொற்களை ஆராய்ந்து சொல்ல வேண்டும்.","en":"Let the pure who know the arrangement of words speak with deliberation after ascertaining (the nature of) the court (then assembled)","lines":[{"t":"அவையறிநது ஆராய்ந்து சொல்லுக சொல்லின்","err":null,"seers":[{"w":"அவையறிநது","name":"கருவிளங்கனி","cls":"கனி","a":[{"k":"I","s":"அவை"},{"k":"I","s":"யறி"},{"k":"I","s":"நது"}]},{"w":"ஆராய்ந்து","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"ராய்ந்"},{"k":"N","s":"து"}]},{"w":"சொல்லுக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லுக"}]},{"w":"சொல்லின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லின்"}]}],"thalai":["ஒன்றிய வஞ்சித்தளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தொகையறிந்த தூய்மை யவர்.","err":null,"seers":[{"w":"தொகையறிந்த","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தொகை"},{"k":"I","s":"யறிந்"},{"k":"N","s":"த"}]},{"w":"தூய்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தூய்"},{"k":"N","s":"மை"}]},{"w":"யவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"யவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":712,"ch":72,"l1":"இடைதெரிந்து நன்குணர்ந்து சொல்லுக சொல்லின்","l2":"நடைதெரிந்த நன்மை யவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"சொற்களின் தன்மையை ஆராய்ந்த நன்மை உடையவர், அவையின் செவ்வியை ஆராய்ந்து நன்றாக உணர்ந்து சொல்ல வேண்டும்.","en":"Let the good who know the uses of words speak with a clear knowledge after ascertaining the time (suited to the court)","lines":[{"t":"இடைதெரிந்து நன்குணர்ந்து சொல்லுக சொல்லின்","err":null,"seers":[{"w":"இடைதெரிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இடை"},{"k":"I","s":"தெரிந்"},{"k":"N","s":"து"}]},{"w":"நன்குணர்ந்து","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"I","s":"குணர்ந்"},{"k":"N","s":"து"}]},{"w":"சொல்லுக","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லுக"}]},{"w":"சொல்லின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நடைதெரிந்த நன்மை யவர்.","err":null,"seers":[{"w":"நடைதெரிந்த","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நடை"},{"k":"I","s":"தெரிந்"},{"k":"N","s":"த"}]},{"w":"நன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"மை"}]},{"w":"யவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"யவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":713,"ch":72,"l1":"அவையறியார் சொல்லல்மேற் கொள்பவர் சொல்லின்","l2":"வகையறியார் வல்லதூஉம் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அவையின் தன்மை அறியாமல் சொல்லுதலை மேற்கொள்கின்றவர், சொற்களின் வகை அறியாதவரே, அவர் சொல்லவல்லதும் இல்லை.","en":"Those who undertake to speak without knowing the (nature of the) court are ignorant of the quality of words as well as devoid of the power (of learning)","lines":[{"t":"அவையறியார் சொல்லல்மேற் கொள்பவர் சொல்லின்","err":null,"seers":[{"w":"அவையறியார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அவை"},{"k":"I","s":"யறி"},{"k":"N","s":"யார்"}]},{"w":"சொல்லல்மேற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லல்"},{"k":"N","s":"மேற்"}]},{"w":"கொள்பவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கொள்"},{"k":"I","s":"பவர்"}]},{"w":"சொல்லின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வகையறியார் வல்லதூஉம் இல்.","err":null,"seers":[{"w":"வகையறியார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வகை"},{"k":"I","s":"யறி"},{"k":"N","s":"யார்"}]},{"w":"வல்லதூஉம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வல்"},{"k":"I","s":"லதூ"},{"k":"N","s":"உம்"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":714,"ch":72,"l1":"ஒளியார்முன் ஒள்ளிய ராதல் வெளியார்முன்","l2":"வான்சுதை வண்ணம் கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அறிவிற் சிறந்தவரின் முன் தானும் அறிவிற் சிறந்தவராக நடந்து கொள்ள வேண்டும், அறிவில்லாதவர் முன் தாமும் வெண் கண்ணம் போல் அறிவில்லாதவராய் இருக்க வேண்டும்.","en":"Ministers should be lights in the assembly of the enlightned, but assume the pure whiteness of mortar (ignorance) in that of fools","lines":[{"t":"ஒளியார்முன் ஒள்ளிய ராதல் வெளியார்முன்","err":null,"seers":[{"w":"ஒளியார்முன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒளி"},{"k":"N","s":"யார்"},{"k":"N","s":"முன்"}]},{"w":"ஒள்ளிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஒள்"},{"k":"I","s":"ளிய"}]},{"w":"ராதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ரா"},{"k":"N","s":"தல்"}]},{"w":"வெளியார்முன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வெளி"},{"k":"N","s":"யார்"},{"k":"N","s":"முன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வான்சுதை வண்ணம் கொளல்.","err":null,"seers":[{"w":"வான்சுதை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வான்"},{"k":"I","s":"சுதை"}]},{"w":"வண்ணம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வண்"},{"k":"N","s":"ணம்"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":715,"ch":72,"l1":"நன்றென்ற வற்றுள்ளும் நன்றே முதுவருள்","l2":"முந்து கிளவாச் செறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறிவு மிகுந்தவரிடையே முந்திச் சென்று பேசாத அடக்கம் ஒருவனுக்கு நன்மை என்று சொல்லப்பட்டவை எல்லாவற்றிலும நல்லது.","en":"The modesty by which one does not rush forward and speak in (an assembly of) superiors is the best among all (one's) good qualities","lines":[{"t":"நன்றென்ற வற்றுள்ளும் நன்றே முதுவருள்","err":null,"seers":[{"w":"நன்றென்ற","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றென்"},{"k":"N","s":"ற"}]},{"w":"வற்றுள்ளும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வற்"},{"k":"N","s":"றுள்"},{"k":"N","s":"ளும்"}]},{"w":"நன்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றே"}]},{"w":"முதுவருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"முது"},{"k":"I","s":"வருள்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"முந்து கிளவாச் செறிவு.","err":null,"seers":[{"w":"முந்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"முந்"},{"k":"N","s":"து"}]},{"w":"கிளவாச்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கிள"},{"k":"N","s":"வாச்"}]},{"w":"செறிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செறி"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":716,"ch":72,"l1":"ஆற்றின் நிலைதளர்ந் தற்றே வியன்புலம்","l2":"ஏற்றுணர்வார் முன்னர் இழுக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"விரிவான அறிவுத்துறைகளை அறிந்து உணர்கின்றவரின் முன்னே குற்றப்படுதல், ஒழுக்கநெறியிலிருந்து நிலைத் தளர்ந்து கெடுவதைப் போன்றதாகும்.","en":"(For a minister) to blunder in the presence of those who have acquired a vast store of learning and know (the value thereof) is like a good man stumbling (and falling away) from the path (of virtue)","lines":[{"t":"ஆற்றின் நிலைதளர்ந் தற்றே வியன்புலம்","err":null,"seers":[{"w":"ஆற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றின்"}]},{"w":"நிலைதளர்ந்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நிலை"},{"k":"I","s":"தளர்ந்"}]},{"w":"தற்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"றே"}]},{"w":"வியன்புலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வியன்"},{"k":"I","s":"புலம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஏற்றுணர்வார் முன்னர் இழுக்கு.","err":null,"seers":[{"w":"ஏற்றுணர்வார்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஏற்"},{"k":"I","s":"றுணர்"},{"k":"N","s":"வார்"}]},{"w":"முன்னர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"முன்"},{"k":"N","s":"னர்"}]},{"w":"இழுக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":717,"ch":72,"l1":"கற்றறிந்தார் கல்வி விளங்கும் கசடறச்","l2":"சொல்தெரிதல் வல்லார் அகத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"குற்றமறச்சொற்களை ஆராயவதில் வ ல்ல அறிஞர்களிடத்தில் பல நூல்களைக் கற்றறிந்தவரின் கல்வியானது நன்றாக விளங்கித் தொன்றும்.","en":"The learning of those who have read and understood (much) will shine in the assembly of those who faultlessly examine (the nature of) words","lines":[{"t":"கற்றறிந்தார் கல்வி விளங்கும் கசடறச்","err":null,"seers":[{"w":"கற்றறிந்தார்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"I","s":"றறிந்"},{"k":"N","s":"தார்"}]},{"w":"கல்வி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கல்"},{"k":"N","s":"வி"}]},{"w":"விளங்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விளங்"},{"k":"N","s":"கும்"}]},{"w":"கசடறச்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கச"},{"k":"I","s":"டறச்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சொல்தெரிதல் வல்லார் அகத்து.","err":null,"seers":[{"w":"சொல்தெரிதல்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"தெரி"},{"k":"N","s":"தல்"}]},{"w":"வல்லார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வல்"},{"k":"N","s":"லார்"}]},{"w":"அகத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அகத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":718,"ch":72,"l1":"உணர்வ துடையார்முன் சொல்லல் வளர்வதன்","l2":"பாத்தியுள் நீர்சொரிந் தற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தாமே உணர்கின்ற தன்மை உடையவரின் முன் கற்றவர் பேசுதல், தானே வளரும் பயிருள்ள பாத்தியில் நீரைச் சொரிந்தாற் போன்றது.","en":"Lecturing to those who have the ability to understand (for themselves) is like watering a bed of plants that are growing (of themselves)","lines":[{"t":"உணர்வ துடையார்முன் சொல்லல் வளர்வதன்","err":null,"seers":[{"w":"உணர்வ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உணர்"},{"k":"N","s":"வ"}]},{"w":"துடையார்முன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துடை"},{"k":"N","s":"யார்"},{"k":"N","s":"முன்"}]},{"w":"சொல்லல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லல்"}]},{"w":"வளர்வதன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வளர்"},{"k":"I","s":"வதன்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பாத்தியுள் நீர்சொரிந் தற்று.","err":null,"seers":[{"w":"பாத்தியுள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பாத்"},{"k":"I","s":"தியுள்"}]},{"w":"நீர்சொரிந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீர்"},{"k":"I","s":"சொரிந்"}]},{"w":"தற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":719,"ch":72,"l1":"புல்லவையுள் பொச்சாந்தும் சொல்லற்க நல்லவையுள்","l2":"நன்குசலச் சொல்லு வார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நல்ல அறிஞரின் அவையில் நல்ல பொருளைப் மனதில் பதியுமாறு சொல்லவல்லவர், அறிவில்லாதவரின் கூட்டத்தில் மறந்தும் பேசக் கூடாது.","en":"Those who are able to speak good things impressively in an assembly of the good should not even forgetfully speak them in that of the low","lines":[{"t":"புல்லவையுள் பொச்சாந்தும் சொல்லற்க நல்லவையுள்","err":null,"seers":[{"w":"புல்லவையுள்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"புல்"},{"k":"I","s":"லவை"},{"k":"N","s":"யுள்"}]},{"w":"பொச்சாந்தும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொச்"},{"k":"N","s":"சாந்"},{"k":"N","s":"தும்"}]},{"w":"சொல்லற்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லற்"},{"k":"N","s":"க"}]},{"w":"நல்லவையுள்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"லவை"},{"k":"N","s":"யுள்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நன்குசலச் சொல்லு வார்.","err":null,"seers":[{"w":"நன்குசலச்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"I","s":"குச"},{"k":"N","s":"லச்"}]},{"w":"சொல்லு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லு"}]},{"w":"வார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"வார்"}]}],"thalai":["வெண்சீர் வெண்டளை","நேரொன்றிய ஆசிரியத்தளை"]}]},{"n":720,"ch":72,"l1":"அங்கணத்துள் உக்க அமிழ்தற்றால் தங்கணத்தார்","l2":"அல்லார்முன் கோட்டி கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தன் இனத்தார் அல்லாதவரின் கூட்டத்தில் முன் ஒரு பொருளைப்பற்றி பேசுதல், தூய்மையில்லாத முற்றத்தில் சிந்திய அமிழ்தம் போன்றது.","en":"To utter (a good word) in the assembly of those who are of inferior rank is like dropping nectar on the ground","lines":[{"t":"அங்கணத்துள் உக்க அமிழ்தற்றால் தங்கணத்தார்","err":null,"seers":[{"w":"அங்கணத்துள்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"அங்"},{"k":"I","s":"கணத்"},{"k":"N","s":"துள்"}]},{"w":"உக்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உக்"},{"k":"N","s":"க"}]},{"w":"அமிழ்தற்றால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அமிழ்"},{"k":"N","s":"தற்"},{"k":"N","s":"றால்"}]},{"w":"தங்கணத்தார்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தங்"},{"k":"I","s":"கணத்"},{"k":"N","s":"தார்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அல்லார்முன் கோட்டி கொளல்.","err":null,"seers":[{"w":"அல்லார்முன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அல்"},{"k":"N","s":"லார்"},{"k":"N","s":"முன்"}]},{"w":"கோட்டி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கோட்"},{"k":"N","s":"டி"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]