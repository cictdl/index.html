[{"n":901,"ch":91,"l1":"மனைவிழைவார் மாண்பயன் எய்தார் வினைவிழையார்","l2":"வேண்டாப் பொருளும் அது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மனைவியை விரும்பி அவள் சொன்னபடி நடப்பவர், சிறந்த பயனை அடையமாட்டார், கடமையைச் செய்தலை விரும்புகின்றவர் வேண்டாத பொருளும் அதுவே.","en":"Those who lust after their wives will not attain the excellence of virtue; and it is just this that is not desired by those who are bent on acquiring wealth","lines":[{"t":"மனைவிழைவார் மாண்பயன் எய்தார் வினைவிழையார்","err":null,"seers":[{"w":"மனைவிழைவார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"மனை"},{"k":"I","s":"விழை"},{"k":"N","s":"வார்"}]},{"w":"மாண்பயன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மாண்"},{"k":"I","s":"பயன்"}]},{"w":"எய்தார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எய்"},{"k":"N","s":"தார்"}]},{"w":"வினைவிழையார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வினை"},{"k":"I","s":"விழை"},{"k":"N","s":"யார்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வேண்டாப் பொருளும் அது.","err":null,"seers":[{"w":"வேண்டாப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டாப்"}]},{"w":"பொருளும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளும்"}]},{"w":"அது.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அது"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":902,"ch":91,"l1":"பேணாது பெண்விழைவான் ஆக்கம் பெரியதோர்","l2":"நாணாக நாணுத் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கடமையை விரும்பாமல் மனைவியின் பெண்மையை விரும்புகின்றவனுடைய ஆக்கம், பெரியதொரு நாணத்தக்கச் செயலாக நாணத்தைக் கொடுக்கும்.","en":"The wealth of him who, regardless (of his manliness), devotes himself to his wife's feminine nature will cause great shame (to ali men) and to himself;","lines":[{"t":"பேணாது பெண்விழைவான் ஆக்கம் பெரியதோர்","err":null,"seers":[{"w":"பேணாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"ணா"},{"k":"N","s":"து"}]},{"w":"பெண்விழைவான்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பெண்"},{"k":"I","s":"விழை"},{"k":"N","s":"வான்"}]},{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"பெரியதோர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பெரி"},{"k":"I","s":"யதோர்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நாணாக நாணுத் தரும்.","err":null,"seers":[{"w":"நாணாக","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணா"},{"k":"N","s":"க"}]},{"w":"நாணுத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணுத்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":903,"ch":91,"l1":"இல்லாள்கண் தாழ்ந்த இயல்பின்மை எஞ்ஞான்றும்","l2":"நல்லாருள் நாணுத் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மனைவியிடத்தில் தாழ்ந்து நடக்கும் இழிந்த தன்மை ஒருவனுக்கு எப்போதும் நல்லவரிடையே இருக்கும் போது நாணத்தைச் தரும்.","en":"The frailty that stoops to a wife will always make (her husband) feel ashamed among the good","lines":[{"t":"இல்லாள்கண் தாழ்ந்த இயல்பின்மை எஞ்ஞான்றும்","err":null,"seers":[{"w":"இல்லாள்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லாள்"},{"k":"N","s":"கண்"}]},{"w":"தாழ்ந்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தாழ்ந்"},{"k":"N","s":"த"}]},{"w":"இயல்பின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இயல்"},{"k":"N","s":"பின்"},{"k":"N","s":"மை"}]},{"w":"எஞ்ஞான்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எஞ்"},{"k":"N","s":"ஞான்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நல்லாருள் நாணுத் தரும்.","err":null,"seers":[{"w":"நல்லாருள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"N","s":"லா"},{"k":"N","s":"ருள்"}]},{"w":"நாணுத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணுத்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":904,"ch":91,"l1":"மனையாளை அஞ்சும் மறுமையி லாளன்","l2":"வினையாண்மை வீறெய்த லின்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"மனைவிக்கு அஞ்சி நடக்கின்ற மறுமைப் பயன் இல்லாத ஒருவன், செயல் ஆற்றுந்தன்மை பெருமை பெற்று விளங்க முடிவதில்லை.","en":"The undertaking of one, who fears his wife and is therefore destitute of (bliss), will never be applauded","lines":[{"t":"மனையாளை அஞ்சும் மறுமையி லாளன்","err":null,"seers":[{"w":"மனையாளை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மனை"},{"k":"N","s":"யா"},{"k":"N","s":"ளை"}]},{"w":"அஞ்சும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சும்"}]},{"w":"மறுமையி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மறு"},{"k":"N","s":"மை"},{"k":"N","s":"யி"}]},{"w":"லாளன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"லா"},{"k":"N","s":"ளன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வினையாண்மை வீறெய்த லின்று.","err":null,"seers":[{"w":"வினையாண்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வினை"},{"k":"N","s":"யாண்"},{"k":"N","s":"மை"}]},{"w":"வீறெய்த","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வீ"},{"k":"N","s":"றெய்"},{"k":"N","s":"த"}]},{"w":"லின்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"லின்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":905,"ch":91,"l1":"இல்லாளை அஞ்சுவான் அஞ்சுமற் றெஞ்ஞான்றும்","l2":"நல்லார்க்கு நல்ல செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மனைவிக்கு அஞ்சி வாழ்கின்றவன் எப்போதும் நல்லவர்க்கு நன்மையான கடமையைச் செய்வதற்கு அஞ்சி நடப்பான்.","en":"He that fears his wife will always be afraid of doing good deeds (even) to the good","lines":[{"t":"இல்லாளை அஞ்சுவான் அஞ்சுமற் றெஞ்ஞான்றும்","err":null,"seers":[{"w":"இல்லாளை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"ளை"}]},{"w":"அஞ்சுவான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஞ்"},{"k":"I","s":"சுவான்"}]},{"w":"அஞ்சுமற்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஞ்"},{"k":"I","s":"சுமற்"}]},{"w":"றெஞ்ஞான்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"றெஞ்"},{"k":"N","s":"ஞான்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நல்லார்க்கு நல்ல செயல்.","err":null,"seers":[{"w":"நல்லார்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"N","s":"லார்க்"},{"k":"N","s":"கு"}]},{"w":"நல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நல்"},{"k":"N","s":"ல"}]},{"w":"செயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":906,"ch":91,"l1":"இமையாரின் வாழினும் பாடிலரே இல்லாள்","l2":"அமையார்தோள் அஞ்சு பவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மனைவியின் தோளுக்கு அஞ்சி வாழ்கின்றவர் தேவரைப் போல் இவ்வுலகில் சிறப்பான நிலையில் வாழ்ந்த போதிலும் பெருமை இல்லாதவரே ஆவர்.","en":"They that fear the bamboo-like shoulders of their wives will be destitute of manliness though they may flourish like the Gods","lines":[{"t":"இமையாரின் வாழினும் பாடிலரே இல்லாள்","err":null,"seers":[{"w":"இமையாரின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இமை"},{"k":"N","s":"யா"},{"k":"N","s":"ரின்"}]},{"w":"வாழினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வா"},{"k":"I","s":"ழினும்"}]},{"w":"பாடிலரே","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பா"},{"k":"I","s":"டில"},{"k":"N","s":"ரே"}]},{"w":"இல்லாள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லாள்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அமையார்தோள் அஞ்சு பவர்.","err":null,"seers":[{"w":"அமையார்தோள்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அமை"},{"k":"N","s":"யார்"},{"k":"N","s":"தோள்"}]},{"w":"அஞ்சு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சு"}]},{"w":"பவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":907,"ch":91,"l1":"பெண்ணேவல் செய்தொழுகும் ஆண்மையின் நாணுடைப்","l2":"பெண்ணே பெருமை உடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"மனைவியின் ஏவலைச் செய்து நடக்கின்றவனுடைய ஆண்மையைவிட, நாணத்தை தன் இயல்பாக உடையவளின் பெண்மையே பெருமை உடையது.","en":"Even shame faced womanhood is more to be esteemed than the shameless manhood that performs","lines":[{"t":"பெண்ணேவல் செய்தொழுகும் ஆண்மையின் நாணுடைப்","err":null,"seers":[{"w":"பெண்ணேவல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பெண்"},{"k":"N","s":"ணே"},{"k":"N","s":"வல்"}]},{"w":"செய்தொழுகும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"தொழு"},{"k":"N","s":"கும்"}]},{"w":"ஆண்மையின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆண்"},{"k":"N","s":"மை"},{"k":"N","s":"யின்"}]},{"w":"நாணுடைப்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நா"},{"k":"I","s":"ணுடைப்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பெண்ணே பெருமை உடைத்து.","err":null,"seers":[{"w":"பெண்ணே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பெண்"},{"k":"N","s":"ணே"}]},{"w":"பெருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"மை"}]},{"w":"உடைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடைத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":908,"ch":91,"l1":"நட்டார் குறைமுடியார் நன்றாற்றார் நன்னுதலாள்","l2":"பெட் டாங்கு ஒழுகு பவர்.","ok":true,"reseg":true,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மனைவி விரும்பியபடி செய்து நடப்பவர், தமது நண்பர்க்கு உற்ற குறையையும் செய்து முடிக்க மாட்டார், அறத்தையும் செய்ய மாட்டார்.","en":"Those who yield to the wishes of their wives will neither relieve the wants of (their) friends nor perform virtuous deeds","lines":[{"t":"நட்டார் குறைமுடியார் நன்றாற்றார் நன்னுதலாள்","err":null,"seer