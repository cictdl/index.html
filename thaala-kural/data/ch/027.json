[{"n":261,"ch":27,"l1":"உற்றநோய் நோன்றல் உயிர்க்குறுகண் செய்யாமை","l2":"அற்றே தவத்திற் குரு.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தனக்கு உற்ற துன்பத்தை பொறுத்தலும் மற்ற உயிர்க்குத் துன்பம் செய்யாதிருத்தலும் ஆகிய அவ்வளவே தவத்திற்கு வடிவமாகும்","en":"The nature of religious discipline consists, in the endurance (by the ascetic) of the sufferings which it brings on himself, and in abstaining from giving pain to others","lines":[{"t":"உற்றநோய் நோன்றல் உயிர்க்குறுகண் செய்யாமை","err":null,"seers":[{"w":"உற்றநோய்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உற்"},{"k":"I","s":"றநோய்"}]},{"w":"நோன்றல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோன்"},{"k":"N","s":"றல்"}]},{"w":"உயிர்க்குறுகண்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உயிர்க்"},{"k":"I","s":"குறு"},{"k":"N","s":"கண்"}]},{"w":"செய்யாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யா"},{"k":"N","s":"மை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அற்றே தவத்திற் குரு.","err":null,"seers":[{"w":"அற்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அற்"},{"k":"N","s":"றே"}]},{"w":"தவத்திற்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவத்"},{"k":"N","s":"திற்"}]},{"w":"குரு.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"குரு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":262,"ch":27,"l1":"தவமும் தவமுடையார்க்கு ஆகும் அதனை","l2":"அஃதிலார் மேற்கொள் வது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["நேரொன்றிய ஆசிரியத்தளை"],"mv":"தவக்கோலமும் தவஒழுக்கமும் உடையவர்க்கே பொருந்துவதாகும்; அக் கோலத்தை தவஒழுக்கம் இல்லாதவர் மேற்கொள்வது வீண்முயற்சியாகும்.","en":"Austerities can only be borne, and their benefits enjoyed, by those who have practised them (in a former birth); it will be useless for those who have not done so, to attempt to practise them (now)","lines":[{"t":"தவமும் தவமுடையார்க்கு ஆகும் அதனை","err":null,"seers":[{"w":"தவமும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவ"},{"k":"N","s":"மும்"}]},{"w":"தவமுடையார்க்கு","name":"கருவிளந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"தவ"},{"k":"I","s":"முடை"},{"k":"N","s":"யார்க்"},{"k":"N","s":"கு"}]},{"w":"ஆகும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கும்"}]},{"w":"அதனை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னை"}]}],"thalai":["இயற்சீர் வெண்டளை",null,"இயற்சீர் வெண்டளை"]},{"t":"அஃதிலார் மேற்கொள் வது.","err":null,"seers":[{"w":"அஃதிலார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அஃ"},{"k":"I","s":"திலார்"}]},{"w":"மேற்கொள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மேற்"},{"k":"N","s":"கொள்"}]},{"w":"வது.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வது"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":263,"ch":27,"l1":"துறந்தார்க்குத் துப்புரவு வேண்டி மறந்தார்கொல்","l2":"மற்றை யவர்கள் தவம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"துறந்தவர்க்கு உணவு முதலியனக் கொடுத்து உதவவேண்டும் என விரும்பி மற்றவர்கள் (இல்லறத்தினர்) தவம் செய்தலை மறந்தார்களோ","en":"It is to provide food etc, for the ascetics who have abandoned (the desire of earthly possessions) that other persons have forgotten (to practise) austerity ?","lines":[{"t":"துறந்தார்க்குத் துப்புரவு வேண்டி மறந்தார்கொல்","err":null,"seers":[{"w":"துறந்தார்க்குத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துறந்"},{"k":"N","s":"தார்க்"},{"k":"N","s":"குத்"}]},{"w":"துப்புரவு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"துப்"},{"k":"I","s":"புர"},{"k":"N","s":"வு"}]},{"w":"வேண்டி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டி"}]},{"w":"மறந்தார்கொல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மறந்"},{"k":"N","s":"தார்"},{"k":"N","s":"கொல்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மற்றை யவர்கள் தவம்.","err":null,"seers":[{"w":"மற்றை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றை"}]},{"w":"யவர்கள்","name":"புளிமா","cls":"மா","