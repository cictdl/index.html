[{"n":471,"ch":48,"l1":"வினைவலியும் தன்வலியும் மாற்றான் வலியும்","l2":"துணைவலியும் தூக்கிச் செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"செயலின் வலிமையும் தன் வலிமையும் பகைவனுடைய வலிமையும் ,இருவருக்கும் துணையானவரின் வலிமையும் ஆராய்ந்து செயல்பட வேண்டும்.","en":"Let (one) weigh well the strength of the deed (he purposes to do), his own strength, the strength of his enemy, and the strength of the allies (of both), and then let him act","lines":[{"t":"வினைவலியும் தன்வலியும் மாற்றான் வலியும்","err":null,"seers":[{"w":"வினைவலியும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வினை"},{"k":"I","s":"வலி"},{"k":"N","s":"யும்"}]},{"w":"தன்வலியும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தன்"},{"k":"I","s":"வலி"},{"k":"N","s":"யும்"}]},{"w":"மாற்றான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாற்"},{"k":"N","s":"றான்"}]},{"w":"வலியும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வலி"},{"k":"N","s":"யும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"துணைவலியும் தூக்கிச் செயல்.","err":null,"seers":[{"w":"துணைவலியும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"துணை"},{"k":"I","s":"வலி"},{"k":"N","s":"யும்"}]},{"w":"தூக்கிச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தூக்"},{"k":"N","s":"கிச்"}]},{"w":"செயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":472,"ch":48,"l1":"ஒல்வ தறிவது அறிந்ததன் கண்தங்கிச்","l2":"செல்வார்க்குச் செல்லாதது இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தனக்குப் பொருந்தும் செயலையும் அதற்காக அறிய வேண்டியதையும் அறிந்து அதனிடம் நிலைத்து முயல்கின்றவர்க்கு முடியாதது ஒன்றும் இல்லை.","en":"There is nothing which may not be accomplished by those who, before they attack (an enemy), make themselves acquainted with their own ability, and with whatever else is (needful) to be known, and","lines":[{"t":"ஒல்வ தறிவது அறிந்ததன் கண்தங்கிச்","err":null,"seers":[{"w":"ஒல்வ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒல்"},{"k":"N","s":"வ"}]},{"w":"தறிவது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தறி"},{"k":"I","s":"வது"}]},{"w":"அறிந்ததன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறிந்"},{"k":"I","s":"ததன்"}]},{"w":"கண்தங்கிச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"தங்"},{"k":"N","s":"கிச்"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"செல்வார்க்குச் செல்லாதது இல்.","err":null,"seers":[{"w":"செல்வார்க்குச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வார்க்"},{"k":"N","s":"குச்"}]},{"w":"செல்லாதது","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"செல்"},{"k":"N","s":"லா"},{"k":"I","s":"தது"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["வெண்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை"]}]},{"n":473,"ch":48,"l1":"உடைத்தம் வலியறியார் ஊக்கத்தின் ஊக்கி","l2":"இடைக்கண் முரிந்தார் பலர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தன்னுடைய வலிமை இவ்வளவு என அறியாமல் ஊக்கத்தால் முனைந்து தொடங்கி இடையில் அதை முடிக்க வகையில்லாமல் அழிந்தவர் பலர்.","en":"There are many who, ignorant of their (want of) power (to meet it), have haughtily set out to war, and broken down in the midst of it","lines":[{"t":"உடைத்தம் வலியறியார் ஊக்கத்தின் ஊக்கி","err":null,"seers":[{"w":"உடைத்தம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடைத்"},{"k":"N","s":"தம்"}]},{"w":"வலியறியார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வலி"},{"k":"I","s":"யறி"},{"k":"N","s":"யார்"}]},{"w":"ஊக்கத்தின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊக்"},{"k":"N","s":"கத்"},{"k":"N","s":"தின்"}]},{"w":"ஊக்கி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊக்"},{"k":"N","s":"கி"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இடைக்கண் முரிந்தார் பலர்.","err":null,"seers":[{"w":"இடைக்கண்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடைக்