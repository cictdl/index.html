name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கி"}]},{"w":"விடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":477,"ch":48,"l1":"ஆற்றின் அறவறிந்து ஈக அதுபொருள்","l2":"போற்றி வழங்கு நெறி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தக்க வழியில் பிறர்க்கு கொடுக்கும் அளவு அறிந்து வாழாதவனுடைய வாழ்க்கை (பல வளமும்) இருப்பது போல் தோன்றி இல்லாமல் மறைந்து விடும்.","en":"Let a man know the measure of his ability (to give), and let him give accordingly; such giving is the way to preserve his property","lines":[{"t":"ஆற்றின் அறவறிந்து ஈக அதுபொருள்","err":null,"seers":[{"w":"ஆற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றின்"}]},{"w":"அறவறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அற"},{"k":"I","s":"வறிந்"},{"k":"N","s":"து"}]},{"w":"ஈக","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"க"}]},{"w":"அதுபொருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அது"},{"k":"I","s":"பொருள்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"போற்றி வழங்கு நெறி.","err":null,"seers":[{"w":"போற்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போற்"},{"k":"N","s":"றி"}]},{"w":"வழங்கு","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வழங்"},{"k":"N","s":"கு"}]},{"w":"நெறி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"நெறி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":478,"ch":48,"l1":"ஆகாறு அளவிட்டி தாயினுங் கேடில்லை","l2":"போகாறு அகலாக் கடை.","ok":true,"reseg":true,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பொருள் வரும் வழி (வருவாய்) சிறிதாக இருந்தாலும், போகும் வழி (செலவு) விரிவுபடாவிட்டால் அதனால் தீங்கு இல்லை.","en":"Even though the income (of a king) be small, it will not cause his (ruin), if his outgoings be not larger than his income","lines":[{"t":"ஆகாறு அளவிட்டி தாயினுங் கேடில்லை","err":null,"seers":[{"w":"ஆகா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கா"}]},{"w":"றளவிட்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"றள"},{"k":"N","s":"விட்"}]},{"w":"டிதாயினுங்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"டிதா"},{"k":"I","s":"யினுங்"}]},{"w":"கேடில்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கே"},{"k":"N","s":"டில்"},{"k":"N","s":"லை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"போகாறு அகலாக் கடை.","err":null,"seers":[{"w":"போகா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"கா"}]},{"w":"றகலாக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"றக"},{"k":"N","s":"லாக்"}]},{"w":"கடை","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கடை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":479,"ch":48,"l1":"அளவறிந்து வாழாதான் வாழ்க்கை உளபோல","l2":"இல்லாகித் தோன்றாக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பொருளின் அளவு அறிந்து வாழாதவனுடைய வாழ்க்கை (பல வளமும்) இருப்பது போல் தோன்றி இல்லாமல் மறைந்து கெட்டு விடும்.","en":"The prosperity of him who lives without knowing the measure (of his property), will perish, even while it seems to continue","lines":[{"t":"அளவறிந்து வாழாதான் வாழ்க்கை உளபோல","err":null,"seers":[{"w":"அளவறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அள"},{"k":"I","s":"வறிந்"},{"k":"N","s":"து"}]},{"w":"வாழாதான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"N","s":"ழா"},{"k":"N","s":"தான்"}]},{"w":"வாழ்க்கை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்க்"},{"k":"N","s":"கை"}]},{"w":"உளபோல","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உள"},{"k":"N","s":"போ"},{"k":"N","s":"ல"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இல்லாகித் தோன்றாக் கெடும்.","err":null,"seers":[{"w":"இல்லாகித்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"கித்"}]},{"w":"தோன்றாக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோன்"},{"k":"N","s":"றாக்"}]},{"w":"கெடும்.","name":"