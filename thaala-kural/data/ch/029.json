[{"n":281,"ch":29,"l1":"எள்ளாமை வேண்டுவான் என்பான் எனைத்தொன்றும்","l2":"கள்ளாமை காக்கதன் நெஞ்சு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பிறரால் இகழப்படால் வாழ விரும்புகிறவன், எத்தன்மையானப் பொருளையும் பிறரிடமிருந்து வஞ்சித்துக்கொள்ள எண்ணாதபடி தன் நெஞ்சைக் காக்க வேண்டும்.","en":"Let him, who desires not to be despised, keep his mind from (the desire of) defrauding another of the smallest thing","lines":[{"t":"எள்ளாமை வேண்டுவான் என்பான் எனைத்தொன்றும்","err":null,"seers":[{"w":"எள்ளாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எள்"},{"k":"N","s":"ளா"},{"k":"N","s":"மை"}]},{"w":"வேண்டுவான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வேண்"},{"k":"I","s":"டுவான்"}]},{"w":"என்பான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"பான்"}]},{"w":"எனைத்தொன்றும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எனைத்"},{"k":"N","s":"தொன்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கள்ளாமை காக்கதன் நெஞ்சு.","err":null,"seers":[{"w":"கள்ளாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளா"},{"k":"N","s":"மை"}]},{"w":"காக்கதன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"காக்"},{"k":"I","s":"கதன்"}]},{"w":"நெஞ்சு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":282,"ch":29,"l1":"உள்ளத்தால் உள்ளலும் தீதே பிறன்பொருளைக்","l2":"கள்ளத்தால் கள்வேம் எனல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"குற்றமானதை உள்ளத்தால் எண்ணுவதும் குற்றமே, அதானால் பிறன் பொருளை அவன் அறியாதப் வகையால் வஞ்சித்துக்கொள்வோம் என்று எண்ணாதிருக்க வேண்டும்.","en":"Even the thought (of sin) is sin; think not then of crafiily stealing the property of another","lines":[{"t":"உள்ளத்தால் உள்ளலும் தீதே பிறன்பொருளைக்","err":null,"seers":[{"w":"உள்ளத்தால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளத்"},{"k":"N","s":"தால்"}]},{"w":"உள்ளலும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளலும்"}]},{"w":"தீதே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"தே"}]},{"w":"பிறன்பொருளைக்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறன்"},{"k":"I","s":"பொரு"},{"k":"N","s":"ளைக்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கள்ளத்தால் கள்வேம் எனல்.","err":null,"seers":[{"w":"கள்ளத்தால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளத்"},{"k":"N","s":"தால்"}]},{"w":"கள்வேம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கள்"},{"k":"N","s":"வேம்"}]},{"w":"எனல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"எனல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":283,"ch":29,"l1":"களவினால் ஆகிய ஆக்கம் அளவிறந்து","l2":"ஆவது போலக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"களவு செய்து பொருள் கொள்வதால் உண்டாகிய ஆக்கம் பெருகுவது போல் தோன்றி இயல்பாக இருக்க வேண்டிய அளவையும் கடந்து கெட்டு விடும்.","en":"The property, which is acquired by fraud, will entirely perish, even while it seems to increase","lines":[{"t":"களவினால் ஆகிய ஆக்கம் அளவிறந்து","err":null,"seers":[{"w":"களவினால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கள"},{"k":"I","s":"வினால்"}]},{"w":"ஆகிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"கிய"}]},{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"அளவிறந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அள"},{"k":"I","s":"விறந்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆவது போலக் கெடும்.","err":null,"seers":[{"w":"ஆவது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"வது"}]},{"w":"போலக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"லக்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":284,"ch":29,"l1":"களவின்கண் கன்றிய காதல் விளைவின்கண்","l2":"வீயா விழுமம் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"களவு செய்து பிறர் பொருள் கொள்ளுதலில் ஒருவனுக்கு உள்ள மிகுந்த விருப்பம், பயன் விளையும் போது தொலையாதத் துன்பத்தைத் தரும்.","en":"The eager desire of defrauding others will, when it brings forth its fruit, produce undying sorrow","lines":[{"t":"களவின்கண் கன்றிய காதல் விளைவின்கண்","err":null,"seers":[{"w":"களவின்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கள"},{"k":"N","s":"வின்"},{"k":"N","s":"கண்"}]},{"w":"கன்றிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கன்"},{"k":"I","s":"றிய"}]},{"w":"காதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"தல்"}]},{"w":"விளைவின்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விளை"},{"k":"N","s":"வின்"},{"k":"N","s":"கண்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வீயா விழுமம் தரும்.","err":null,"seers":[{"w":"வீயா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வீ"},{"k":"N","s":"யா"}]},{"w":"விழுமம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விழு"},{"k":"N","s":"மம்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":285,"ch":29,"l1":"அருள்கருதி அன்புடைய ராதல் பொருள்கருதிப்","l2":"பொச்சாப்புப் பார்ப்பார்கண் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அருளைப் பெரிதாகக்கருதி அன்பு உடையவராய் நடத்தல், பிறருடைய பொருளைக்கவர எண்ணி அவர் சோர்ந்திருக்கும் நிலையைப் பார்ப்பவரிடத்தில் இல்லை.","en":"The study of kindness and the exercise of benevolence is not with those who watch for another's forgetfulness, though desire of his property","lines":[{"t":"அருள்கருதி அன்புடைய ராதல் பொருள்கருதிப்","err":null,"seers":[{"w":"அருள்கருதி","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அருள்"},{"k":"I","s":"கரு"},{"k":"N","s":"தி"}]},{"w":"அன்புடைய","name":"கூவிளங்