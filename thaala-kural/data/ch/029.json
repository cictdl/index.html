ய்","cls":"காய்","a":[{"k":"I","s":"அள"},{"k":"I","s":"வறிந்"},{"k":"N","s":"தார்"}]},{"w":"நெஞ்சத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சத்"}]},{"w":"தறம்போல","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தறம்"},{"k":"N","s":"போ"},{"k":"N","s":"ல"}]},{"w":"நிற்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நிற்"},{"k":"N","s":"கும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"களவறிந்தார் நெஞ்சில் கரவு.","err":null,"seers":[{"w":"களவறிந்தார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கள"},{"k":"I","s":"வறிந்"},{"k":"N","s":"தார்"}]},{"w":"நெஞ்சில்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சில்"}]},{"w":"கரவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கர"},{"k":"N","s":"வு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":289,"ch":29,"l1":"அளவல்ல செய்தாங்கே வீவர் களவல்ல","l2":"மற்றைய தேற்றா தவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"களவு செய்தலைத் தவிர மற்ற நல்லவழிகளைத் நம்பித் தெளியாதவர் அளவு அல்லாத செயல்களைச் செய்து அப்போதே கெட்டழிவர்.","en":"Those, who are acquainted with nothing but fraud, will perish in the very commission of transgression","lines":[{"t":"அளவல்ல செய்தாங்கே வீவர் களவல்ல","err":null,"seers":[{"w":"அளவல்ல","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அள"},{"k":"N","s":"வல்"},{"k":"N","s":"ல"}]},{"w":"செய்தாங்கே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தாங்"},{"k":"N","s":"கே"}]},{"w":"வீவர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வீ"},{"k":"N","s":"வர்"}]},{"w":"களவல்ல","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கள"},{"k":"N","s":"வல்"},{"k":"N","s":"ல"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மற்றைய தேற்றா தவர்.","err":null,"seers":[{"w":"மற்றைய","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றை"},{"k":"N","s":"ய"}]},{"w":"தேற்றா","name":"தேமா","cls":"மா","a":[{"