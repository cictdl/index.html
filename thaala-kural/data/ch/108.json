[{"n":1071,"ch":108,"l1":"மக்களே போல்வர் கயவர் அவரன்ன","l2":"ஒப்பாரி யாங்கண்ட தில்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மக்களே போல் இருப்பார் கயவர், அவர் மக்களை ஒத்திருப்பது போன்ற ஒப்புமை வேறு எந்த இருவகைப் பொருள்களிடத்திலும் யாம் கண்டதில்லை.","en":"The base resemble men perfectly (as regards form); and we have not seen such (exact) resemblance (among any other species)","lines":[{"t":"மக்களே போல்வர் கயவர் அவரன்ன","err":null,"seers":[{"w":"மக்களே","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மக்"},{"k":"I","s":"களே"}]},{"w":"போல்வர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போல்"},{"k":"N","s":"வர்"}]},{"w":"கயவர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கய"},{"k":"N","s":"வர்"}]},{"w":"அவரன்ன","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவ"},{"k":"N","s":"ரன்"},{"k":"N","s":"ன"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஒப்பாரி யாங்கண்ட தில்.","err":null,"seers":[{"w":"ஒப்பாரி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒப்"},{"k":"N","s":"பா"},{"k":"N","s":"ரி"}]},{"w":"யாங்கண்ட","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யாங்"},{"k":"N","s":"கண்"},{"k":"N","s":"ட"}]},{"w":"தில்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தில்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1072,"ch":108,"l1":"நன்றறி வாரிற் கயவர் திருவுடையர்","l2":"நெஞ்சத்து அவலம் இலர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நன்மை அறிந்தவரை விடக் கயவரே நல்ல பேறு உடையவர், ஏன் என்றால், கயவர் தம் நெஞ்சில் எதைப் பற்றியும் கவலை இல்லாதவர்.","en":"The low enjoy more felicity than those who know what is good; for the former are not troubled with anxiety (as to the good)","lines":[{"t":"நன்றறி வாரிற் கயவர் திருவுடையர்","err":null,"seers":[{"w":"நன்றறி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நன்"},{"k":"I","s":"றறி"}]},{"w":"வாரிற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ரிற்"}]},{"w":"கயவர்","name"