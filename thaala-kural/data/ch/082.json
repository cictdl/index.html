[{"n":811,"ch":82,"l1":"பருகுவார் போலினும் பண்பிலார் கேண்மை","l2":"பெருகலிற் குன்றல் இனிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அன்பு மிகுதியால் பருகுவார் போல் தோன்றினாலும் நற்பண்பு இல்லாதவரின் நட்பு, வளர்ந்து பெருகுவதை விடத் தேய்ந்து குறைவது நல்லது.","en":"The decrease of friendship with those who look as if they would eat you up (through excess of love) while they are really destitute of goodness is far better than its increase","lines":[{"t":"பருகுவார் போலினும் பண்பிலார் கேண்மை","err":null,"seers":[{"w":"பருகுவார்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பரு"},{"k":"I","s":"குவார்"}]},{"w":"போலினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"போ"},{"k":"I","s":"லினும்"}]},{"w":"பண்பிலார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பண்"},{"k":"I","s":"பிலார்"}]},{"w":"கேண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேண்"},{"k":"N","s":"மை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பெருகலிற் குன்றல் இனிது.","err":null,"seers":[{"w":"பெருகலிற்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பெரு"},{"k":"I","s":"கலிற்"}]},{"w":"குன்றல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குன்"},{"k":"N","s":"றல்"}]},{"w":"இனிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இனி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":812,"ch":82,"l1":"உறின்நட்டு அறினொருஉம் ஒப்பிலார் கேண்மை","l2":"பெறினும் இழப்பினும் என்?","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தமக்கு பயன் உள்ள போது நட்பு செய்து பயன் இல்லாத போது நீங்கிவிடும் தகுதியில்லாதவரின் நட்பைப் பெற்றாலும் என்ன பயன், இழந்தாலும் என்ன பயன்.","en":"Of what avail is it to get or lose the friendship of those who love when there is gain and leave when there is none ?","lines":[{"t":"உறின்நட்டு அறினொருஉம் ஒப்பிலார் கேண்மை","err":null,"seers":[{"w":"உறின்நட்டு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உறின்"},{"k":"N","s":"நட்"},{"k":"N","s":"டு"}]},{"w":"அறினொருஉம்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"னொரு"},{"k":"N","s":"உம்"}]},{"w":"ஒப்பிலார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஒப்"},{"k":"I","s":"பிலார்"}]},{"w":"கேண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேண்"},{"k":"N","s":"மை"}]}],"thalai":["கலித்தளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பெறினும் இழப்பினும் என்?","err":null,"seers":[{"w":"பெறினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெறி"},{"k":"N","s":"னும்"}]},{"w":"இழப்பினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இழப்"},{"k":"I","s":"பினும்"}]},{"w":"என்?","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"என்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":813,"ch":82,"l1":"உறுவது சீர்தூக்கும் நட்பும் பெறுவது","l2":"கொள்வாரும் கள்வரும் நேர்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கிடைக்கும் பயனை அளந்து பார்க்கும் நண்பரும், அன்பைக் கொள்ளாமல் பெறுகின்ற பொருளைக் கொள்ளும் விலை மகளிரும், கள்வரும் ஒரு நிகரானவர்.","en":"Friendship who calculate the profits (of their friendship), prostitutes who are bent on obtaining their gains, and thieves are (all) of the same character","lines":[{"t":"உறுவது சீர்தூக்கும் நட்பும் பெறுவது","err":null,"seers":[{"w":"உறுவது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உறு"},{"k":"I","s":"வது"}]},{"w":"சீர்தூக்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சீர்"},{"k":"N","s":"தூக்"},{"k":"N","s":"கும்"}]},{"w":"நட்பும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பும்"}]},{"w":"பெறுவது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பெறு"},{"k":"I","s":"வது"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கொள்வாரும் கள்வரும் நேர்.","err":null,"seers":[{"w":"கொள்வாரும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"வா"},{"k":"N","s":"ரும்"}]},{"w":"கள்வரும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கள்"},{"k":"I","s":"வரும்"}]},{"w":"நேர்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"நேர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":814,"ch":82,"l1":"அமரகத்து ஆற்றறுக்கும் கல்லாமா அன்னார்","l2":"தமரின் தனிமை தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"போர் வந்த போது களத்தில் தள்ளிவிட்டு ஓடும் அறிவில்லாத குதிரை போன்றவரின் உறவை விட, ஒரு நட்பும் இல்லாமல் தனித்திருத்தலே சிறந்தது.","en":"Solitude is more to be desired than the society of those who resemble the untrained horses which throw down (their riders) in the fields of battle","lines":[{"t":"அமரகத்து ஆற்றறுக்கும் கல்லாமா அன்னார்","err":null,"seers":[{"w":"அமரகத்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அம"},{"k":"I","s":"ரகத்"},{"k":"N","s":"து"}]},{"w":"ஆற்றறுக்கும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆற்"},{"k":"I","s":"றறுக்"},{"k":"N","s":"கும்"}]},{"w":"கல்லாமா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லா"},{"k":"N","s":"மா"}]},{"w":"அன்னார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"னார்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தமரின் தனிமை தலை.","err":null,"seers":[{"w":"தமரின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தம"},{"k":"N","s":"ரின்"}]},{"w":"தனிமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தனி"},{"k":"N","s":"மை"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":815,"ch":82,"l1":"செய்தேமஞ் சாராச் சிறியவர் புன்கேண்மை","l2":"எய்தலின் எய்தாமை நன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"காவல் செய்து வைத்தாலும் காவல் ஆகாத கீழ்மக்களின் தீய நட்பு, ஒருவனுக்கு ஏற்படுவதை விட ஏற்படாமலிருப்பதே நன்மையாகும்.","en":"It is far better to avoid that to contract the evil friendship of the base who cannot protect (their friends) even when appointed to do so","lines":[{"t":"செய்தேமஞ் சாராச் சிறியவர் புன்கேண்மை","err":null,"see