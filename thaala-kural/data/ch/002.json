[{"n":11,"ch":2,"l1":"வான்நின்று உலகம் வழங்கி வருதலால்","l2":"தான்அமிழ்தம் என்றுணரற் பாற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"மழை பெய்ய உலகம் வாழ்ந்து வருவதால், மழையானது உலகத்து வாழும் உயிர்களுக்கு அமிழ்தம் என்று உணரத்தக்கதாகும்","en":"By the continuance of rain the world is preserved in existence; it is therefore worthy to be called ambrosia","lines":[{"t":"வான்நின்று உலகம் வழங்கி வருதலால்","err":null,"seers":[{"w":"வான்நின்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வான்"},{"k":"N","s":"நின்"},{"k":"N","s":"று"}]},{"w":"உலகம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உல"},{"k":"N","s":"கம்"}]},{"w":"வழங்கி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வழங்"},{"k":"N","s":"கி"}]},{"w":"வருதலால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வரு"},{"k":"I","s":"தலால்"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தான்அமிழ்தம் என்றுணரற் பாற்று.","err":null,"seers":[{"w":"தான்அமிழ்தம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தான்"},{"k":"I","s":"அமிழ்"},{"k":"N","s":"தம்"}]},{"w":"என்றுணரற்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"I","s":"றுண"},{"k":"N","s":"ரற்"}]},{"w":"பாற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பாற்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":12,"ch":2,"l1":"துப்பார்க்குத் துப்பாய துப்பாக்கித் துப்பார்க்குத்","l2":"துப்பாய தூஉம் மழை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உண்பவர்க்குத் தக்க உணவுப் பொருள்களை விளைவித்துத் தருவதோடு, பருகுவோர்க்குத் தானும் ஓர் உணவாக இருப்பது மழையாகும்","en":"Rain produces good food, and is itself food","lines":[{"t":"துப்பார்க்குத் துப்பாய துப்பாக்கித் துப்பார்க்குத்","err":null,"seers":[{"w":"துப்பார்க்குத்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"துப்"},{"k":"N","s":"பார்க்"},{"k":"N","s":"குத்"}]},{"w":"துப்பாய","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"துப்"},{"k":"N","s":"பா"},{