[{"n":981,"ch":99,"l1":"கடன்என்ப நல்லவை எல்லாம் கடன்அறிந்து","l2":"சான்றாண்மை மேற்கொள் பவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"கடமை இவை என்று அறிந்து சான்றான்மை மேற்கொண்டு நடப்பவர்க்கு நல்லவை எல்லாம் இயல்பான கடமை என்று கூறுவர்.","en":"It is said that those who are conscious of their duty and behave with a perfect goodness will regard as natural all that is good","lines":[{"t":"கடன்என்ப நல்லவை எல்லாம் கடன்அறிந்து","err":null,"seers":[{"w":"கடன்என்ப","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கடன்"},{"k":"N","s":"என்"},{"k":"N","s":"ப"}]},{"w":"நல்லவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"லவை"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"கடன்அறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கடன்"},{"k":"I","s":"அறிந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சான்றாண்மை மேற்கொள் பவர்க்கு.","err":null,"seers":[{"w":"சான்றாண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சான்"},{"k":"N","s":"றாண்"},{"k":"N","s":"மை"}]},{"w":"மேற்கொள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மேற்"},{"k":"N","s":"கொள்"}]},{"w":"பவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":982,"ch":99,"l1":"குணநலம் சான்றோர் நலனே பிறநலம்","l2":"எந்நலத்து உள்ளதூஉம் அன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"சான்றோரின் நலம் என்று கூறப்படுவது அவறுடைய பண்புகளின் நலமே, மற்ற நலம் வேறு எந்த நலத்திலும் சேர்ந்துள்ளதும் அன்று.","en":"The only delight of the perfect is that of their goodness; all other (sensual) delights are not to be included among any (true) delights","lines":[{"t":"குணநலம் சான்றோர் நலனே பிறநலம்","err":null,"seers":[{"w":"குணநலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"குண"},{"k":"I","s":"நலம்"}]},{"w":"சான்றோர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சான்"},{"k":"N","s":"றோர்"}]},{"w":"நலனே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நல"},{"k":"N","s":"னே"}]},{"w":"பிறநலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பிற"},{"k":"I","s":"நலம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எந்நலத்து உள்ளதூஉம் அன்று.","err":null,"seers":[{"w":"எந்நலத்து","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"எந்"},{"k":"I","s":"நலத்"},{"k":"N","s":"து"}]},{"w":"உள்ளதூஉம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளதூ"},{"k":"N","s":"உம்"}]},{"w":"அன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":983,"ch":99,"l1":"அன்புநாண் ஒப்புரவு கண்ணோட்டம் வாய்மையொடு","l2":"ஐந்துசால் ஊன்றிய தூண்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["ஒன்றிய வஞ்சித்தளை"],"mv":"அன்பு, நாணம்,ஒப்புரவு, கண்ணோட்டம், வாய்மை, என்னும் ஐந்து பண்புகளும், சால்பு என்பதைத் தாங்கியுள்ள தூண்களாகும்.","en":"Affection, fear (of sin), benevolence, favour and truthfulness; these are the five pillars on which perfect goodness rests","lines":[{"t":"அன்புநாண் ஒப்புரவு கண்ணோட்டம் வாய்மையொடு","err":null,"seers":[{"w":"அன்புநாண்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அன்"},{"k":"I","s":"புநாண்"}]},{"w":"ஒப்புரவு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒப்"},{"k":"I","s":"புர"},{"k":"N","s":"வு"}]},{"w":"கண்ணோட்டம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணோட்"},{"k":"N","s":"டம்"}]},{"w":"வாய்மையொடு","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"வாய்"},{"k":"N","s":"மை"},{"k":"I","s":"யொடு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஐந்துசால் ஊன்றிய தூண்.","err":null,"seers":[{"w":"ஐந்துசால்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஐந்"},{"k":"I","s":"துசால்"}]},{"w":"ஊன்றிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊன்"},{"k":"I","s":"றிய"}]},{"w":"தூண்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தூண்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":984,"ch":99,"l1":"கொல்லா நலத்தது நோன்மை பிறர்தீமை","l2":"சொல்லா நலத்தது சால்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"தவம் ஓர் உயிரையும் கொல்லாத அறத்தை அடிப்படையாகக் கொண்டது, சால்பு பிறருடையத் தீமையை எடுத்துச் சொல்லாத நற்பண்பை அடிப்படையாகக் கொண்டது.","en":"Penance consists in the goodness that kills not , and perfection in the goodness that tells not others' faults","lines":[{"t":"கொல்லா நலத்தது நோன்மை பிறர்தீமை","err":null,"seers":[{"w":"கொல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லா"}]},{"w":"நலத்தது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நலத்"},{"k":"I","s":"தது"}]},{"w":"நோன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோன்"},{"k":"N","s":"மை"}]},{"w":"பிறர்தீமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறர்"},{"k":"N","s":"தீ"},{"k":"N","s":"மை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சொல்லா நலத்தது சால்பு.","err":null,"seers":[{"w":"சொல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லா"}]},{"w":"நலத்தது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நலத்"},{"k":"I","s":"தது"}]},{"w":"சால்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சால்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":985,"ch":99,"l1":"ஆற்றுவார் ஆற்றல் பணிதல் அதுசான்றோர்","l2":"மாற்றாரை மாற்றும் படை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஆற்றலுடையவரின் ஆற்றலாவது பணிவுடன் நடத்தலாகும், அது சான்றோர் தம் பகைவரைப் பகைமையிலிருந்து மாற்றுகின்ற கருவியாகும்.","en":"Stooping (to inferiors) is the strength of those who can accomplish (an undertaking); and that is the weapon with which the great avert their foes","lines":[{"t":"ஆற்றுவார் ஆற்றல் பணிதல் அதுசான்றோர்","err":null,"seers":[{"w":"ஆற்றுவார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆற்"},{"k":"I","s":"றுவார்"}]},{"w":"ஆற்றல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றல்"}]},{"w":"பணிதல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பணி"},{"k":"N","s":"தல்"}]},{"w":"அதுசான்றோர்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அது"},{"k":"N","s":"சான்"},{"k":"N","s":"றோர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாற்றாரை மாற்றும் படை.","err":null,"seers":[{"w":"மாற்றாரை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மாற்"},{"k":"N","s":"றா"},{"k":"N","s":"ரை"}]},{"w":"மாற்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாற்"},{"k":"N","s":"றும்"}]},{"w":"படை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":986,"ch":99,"l1":"சால்பிற்குக் கட்டளை யாதெனின் தோல்வி","l2":"துலையல்லார் கண்ணும் கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"சால்புக்கு உரைகல் போல் மதிப்பிடும் கருவி எது என்றால் தமக்கு ஒப்பில்லாத தாழ்ந்தோரிடத்திலும்தோல்வியை ஏற்றுக் கொள்ளும் பண்பாகும்.","en":"The touch-stone of perfection is to receive a defeat even at the hands of one's inferiors","lines":[{"t":"சால்பிற்குக் கட்டளை யாதெனின் தோல்வி","err":null,"seers":[{"w":"சால்பிற்குக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சால்"},{"k":"N","s":"பிற்"},{"k":"N","s":"குக்"}]},{"w":"கட்டளை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கட்"},{"k":"I","s":"டளை"}]},{"w":"யாதெனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தெனின்"}]},{"w":"தோல்வி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோல்"},{"k":"N","s":"வி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"துலையல்லார் கண்ணும் கொளல்.","err":null,"seers":[{"w":"துலையல்லார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துலை"},{"k":"N","s":"யல்"},{"k":"N","s":"லார்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"கொளல்.","name":"மலர்","cl