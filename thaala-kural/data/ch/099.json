்"},{"k":"N","s":"கு"}]},{"w":"இளிவன்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இளி"},{"k":"N","s":"வன்"},{"k":"N","s":"று"}]},{"w":"சால்பென்னும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சால்"},{"k":"N","s":"பென்"},{"k":"N","s":"னும்"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","வெண்சீர் வெண்டளை"]},{"t":"திண்மை உண் டாகப் பெறின்.","err":null,"seers":[{"w":"திண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"திண்"},{"k":"N","s":"மை"}]},{"w":"உண்","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"உண்"}]},{"w":"டாகப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டா"},{"k":"N","s":"கப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["நேரொன்றிய ஆசிரியத்தளை",null,"இயற்சீர் வெண்டளை"]}]},{"n":989,"ch":99,"l1":"ஊழி பெயரினும் தாம்பெயரார் சான்றாண்மைக்கு","l2":"ஆழி எனப்படு வார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":[null],"mv":"சால்பு என்னும் தன்மைக்குக் கடல் என்று புகழப்படுகின்றவர், ஊழிக்காலத்தின் வேறுபாடுகளே நேர்ந்தாலும் தாம் வேறுபடாமல் இருப்பர்.","en":"Those who are said to be the shore of the sea of perfection will never change, though ages may change","lines":[{"t":"ஊழி பெயரினும் தாம்பெயரார் சான்றாண்மைக்கு","err":null,"seers":[{"w":"ஊழி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"ழி"}]},{"w":"பெயரினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பெய"},{"k":"I","s":"ரினும்"}]},{"w":"தாம்பெயரார்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தாம்"},{"k":"I","s":"பெய"},{"k":"N","s":"ரார்"}]},{"w":"சான்றாண்மைக்கு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"சான்"},{"k":"N","s":"றாண்"},{"k":"N","s":"மைக்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஆழி எனப்படு வார்.","err":null,"seers":[{"w":"ஆழி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"ழி"}]},{"w":"எனப்படு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"எனப்"},{"k":"I","s":"படு"}]},{"w":"வார்.","name":"நாள்","cls":"ஓரசை","a":[{"k"