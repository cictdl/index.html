[{"n":331,"ch":34,"l1":"நில்லாத வற்றை நிலையின என்றுணரும்","l2":"புல்லறி வாண்மை கடை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நிலையில்லாதவைகளை நிலையானவை என்று மயங்கி உணரும் புல்லறிவு உடையவராக இருத்தல் வாழ்க்கையில் இழிந்த நிலையாகும்.","en":"That ignorance which considers those things to be stable which are not so, is dishonourable (to the wise)","lines":[{"t":"நில்லாத வற்றை நிலையின என்றுணரும்","err":null,"seers":[{"w":"நில்லாத","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நில்"},{"k":"N","s":"லா"},{"k":"N","s":"த"}]},{"w":"வற்றை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வற்"},{"k":"N","s":"றை"}]},{"w":"நிலையின","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நிலை"},{"k":"I","s":"யின"}]},{"w":"என்றுணரும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"I","s":"றுண"},{"k":"N","s":"ரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"புல்லறி வாண்மை கடை.","err":null,"seers":[{"w":"புல்லறி","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"புல்"},{"k":"I","s":"லறி"}]},{"w":"வாண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாண்"},{"k":"N","s":"மை"}]},{"w":"கடை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கடை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":332,"ch":34,"l1":"கூத்தாட்டு அவைக்குழாத் தற்றே பெருஞ்செல்வம்","l2":"போக்கும் அதுவிளிந் தற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பெரிய செல்வம் வந்து சேர்தல், கூத்தாடும் இடத்தில் கூட்டம் சேர்வதைப் போன்றது, அது நீங்கிப் போதலும் கூத்து முடிந்ததும் கூட்டம் கலைவதைப் போன்றது.","en":"The acquisition of wealth is like the gathering together of an assembly for a theatre; its expenditure is like the breaking up of that assembly","lines":[{"t":"கூத்தாட்டு அவைக்குழாத் தற்றே பெருஞ்செல்வம்","err":null,"seers":[{"w":"கூத்தாட்டு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கூத்"},{"k":"N","s":"தாட்"},{"k":"N","s":"டு"}]},{"w":"அவைக்குழாத்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அவைக்"},{"k":"I","s":"குழாத்"}]},{"w":"தற்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"றே"}]},{"w":"பெருஞ்செல்வம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெருஞ்"},{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"போக்கும் அதுவிளிந் தற்று.","err":null,"seers":[{"w":"போக்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போக்"},{"k":"N","s":"கும்"}]},{"w":"அதுவிளிந்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அது"},{"k":"I","s":"விளிந்"}]},{"w":"தற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":333,"ch":34,"l1":"அற்கா இயல்பிற்றுச் செல்வம் அதுபெற்றால்","l2":"அற்குப ஆங்கே செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"செல்வம் நிலைக்காத இயல்பை உடையது, அத்தகைய செல்வத்தைப்பெற்றால், பெற்ற அப்போதே நிலையான அறங்களைச் செய்ய வேண்டும்.","en":"Wealth is perishable; let those who obtain it immediately practise those (virtues) which are imperishable","lines":[{"t":"அற்கா இயல்பிற்றுச் செல்வம் அதுபெற்றால்","err":null,"seers":[{"w":"அற்கா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அற்"},{"k":"N","s":"கா"}]},{"w":"இயல்பிற்றுச்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இயல்"},{"k":"N","s":"பிற்"},{"k":"N","s":"றுச்"}]},{"w":"செல்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"அதுபெற்றால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அது"},{"k":"N","s":"பெற்"},{"k":"N","s":"றால்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அற்குப ஆங்கே செயல்.","err":null,"seers":[{"w":"அற்குப","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அற்"},{"k":"I","s":"குப"}]},{"w":"ஆங்கே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆங்"},{"k":"N","s":"கே"}]},{"w":"செயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":334,"ch":34,"l1":"நாளென ஒன்றுபோற் காட்டி உயிர்ஈரும்","l2":"வாளது உணர்வார்ப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வாழ்க்கையை ஆராய்ந்து உணர்வாரைப் பெற்றால் நாள் என்பது ஒரு கால அளவுகோல்காட்டி, உயிரை உடம்பிலிருந்து பிரித்து அறுக்கும் வாளாக உள்ளது.","en":"Time, which shows itself (to the ignorant) as if it were something (real) is in the estimation of the wise (only) a saw which cuts down life","lines":[{"t":"நாளென ஒன்றுபோற் காட்டி உயிர்ஈரும்","err":null,"seers":[{"w":"நாளென","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நா"},{"k":"I","s":"ளென"}]},{"w":"ஒன்றுபோற்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஒன்"},{"k":"I","s":"றுபோற்"}]},{"w":"காட்டி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காட்"},{"k":"N","s":"டி"}]},{"w":"உயிர்ஈரும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உயிர்"},{"k":"N","s":"ஈ"},{"k":"N","s":"ரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வாளது உணர்வார்ப் பெறின்.","err":null,"seers":[{"w":"வாளது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வா"},{"k":"I","s":"ளது"}]},{"w":"உணர்வார்ப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உணர்"},{"k":"N","s":"வார்ப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]}]},{"n":335,"ch":34,"l1":"நாச்செற்று விக்குள்மேல் வாராமுன் நல்வினை","l2":"மேற்சென்று செய்யப் படும்","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"நாவை அடக்கி விக்கல் மேலெழுவதற்கு முன்னே (இறப்பு நெருங்குவதற்கு முன்) நல்ல அறச்செயலை விரைந்து செய்யத்தக்கதாகும்.","en":"Let virtuous deeds be done quickly, before the hiccup comes making the tongue silent","lines":[{"t":"நாச்செற்று விக்குள்மேல் வாராமுன் நல்வினை","err":null,"seers":[{"w":"நாச்செற்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நாச்"},{"k":"N","s":"செற்"},{"k":"N","s":"று"}]},{"w":"விக்குள்மேல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"விக்"},{"k":"N","s":"குள்"},{"k":"N","s":"மேல்"}]},{"w":"வாராமுன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"N","s":"ரா"},{"k":"N","s":"முன்"}]},{"w":"நல்வினை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"வினை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"மேற்சென்று செய்யப் படும்","err":null,"seers":[{"w":"மேற்சென்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மேற்"},{"k":"N","s":"சென்"},{"k":"N","s":"று"}]},{"w":"செய்யப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யப்"}]},{"w":"படும்","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":336,"ch":34,"l1":"நெருநல் உளனொருவன் இன்றில்லை என்னும்","l2":"பெருமை உடைத்துஇவ் வுலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நேற்று இருந்தவன் ஒருவன் இன்று இல்லாமல் இறந்து போனான் என்று சொல்லப்படும் நிலையாமைஆகிய பெருமை உடையது இவ்வுலகம்.","en":"This world possesses the greatness that one who yesterday was is not today","lines":[{"t":"நெருநல் உளனொருவன் இன்றில்லை என்னும்","err":null,"seers":[{"w":"நெருநல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நெரு"},{"k":"N","s":"நல்"}]},{"w":"உளனொருவன்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உள"},{"k":"I","s":"னொரு"},{"k":"N","s":"வன்"}]},{"w":"இன்றில்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"றில்"},{"k":"N","s":"லை"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பெருமை உடைத்துஇவ் வுலகு.","err":null,"seers":[{"w":"பெருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"மை"}]},{"w":"உடைத்துஇவ்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உடைத்"},{"k":"I","s":"துஇவ்"}]},{"w":"வுலகு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வுல"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":337,"ch":34,"l1":"ஒருபொழுதும் வாழ்வது அறியார் கருதுப","l2":"கோடியும் அல்ல பல.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறிவில்லாதவர் ஒரு வேளையாவது வாழ்க்கையின் தன்மையை ஆராய்ந்து அறிவதில்லை.ஆனால் வீணீல் எண்ணுவனவோ ஒரு கோடியும் அல்ல, மிகப்பல எண்ணங்கள்.","en":"Innumerable are the thoughts which occupy the mind of (the unwise), who know not that they shall live another moment","lines":[{"t":"ஒருபொழுதும் வாழ்வது அறியார் கருதுப","err":null,"seers":[{"w":"ஒருபொழுதும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"I","s":"பொழு"},{"k":"N","s":"தும்"}]},{"w":"வாழ்வது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வாழ்"},{"k":"I","s":"வது"}]},{"w":"அறியார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறி"},{"k":"N","s":"யார்"}]},{"w":"கருதுப","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரு"},{"k":"I","s":"துப"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"கோடியும் அல்ல பல.","err":null,"seers":[{"w":"கோடியும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கோ"},{"k":"I","s":"டியும்"}]},{"w":"அல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அல்"},{"k":"N","s":"ல"}]},{"w":"பல.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பல"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":338,"ch":34,"l1":"குடம்பை தனித்துஒழியப் புள்பறந் தற்றே","l2":"உடம்பொடு உயிரிடை நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"உடம்போடு உயிர்க்கு உள்ள உறவு, தான் இருந்த கூடு தனியே இருக்க அதை விட்டு வேறிடத்திற்குப் பறவை பறந்தாற் போன்றது.","en":"The love of the soul to the body is like (the love of) a bird to its egg which it flies away from and leaves empty","lines":[{"t":"குடம்பை தனித்துஒழியப் புள்பறந் தற்றே","err":null,"seers":[{"w":"குடம்பை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குடம்"},{"k":"N","s":"பை"}]},{"w":"தனித்துஒழியப்","name":"கருவிளங்கனி","cls":"கனி","a":[{"k":"I","s":"தனித்"},{"k":"I","s":"துஒ"},{"k":"I","s":"ழியப்"}]},{"w":"புள்பறந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"புள்"},{"k":"I","s":"பறந்"}]},{"w":"தற்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"றே"}]}],"thalai":["இயற்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]},{"t":"உடம்பொடு உயிரிடை நட்பு.","err":null,"seers":[{"w":"உடம்பொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உடம்"},{"k":"I","s":"பொடு"}]},{"w":"உயிரிடை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உயி"},{"k":"I","s":"ரிடை"}]},{"w":"நட்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பு"}]}],"thalai":["நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]}]},{"n":339,"ch":34,"l1":"உறங்கு வதுபோலுஞ் சாக்காடு உறங்கி","l2":"விழிப்பது போலும் பிறப்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"இறப்பு எனப்படுவது ஒருவனுக்குஉறக்கம் வருதலைப் போன்றது, பிறப்பு எனப்படுவது உறக்கம் நீங்கி விழித்துக் கொள்வதைப் போன்றது.","en":"Death is like sleep; birth is like awaking from it","lines":[{"t":"உறங்கு வதுபோலுஞ் சாக்காடு உறங்கி","err":null,"seers":[{"w":"உறங்கு","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உறங்"},{"k":"N","s":"கு"}]},{"w":"வதுபோலுஞ்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வது"},{"k":"N","s":"போ"},{"k":"N","s":"லுஞ்"}]},{"w":"சாக்காடு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சாக்"},{"k":"N","s":"கா"},{"k":"N","s":"டு"}]},{"w":"உறங்கி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உறங்"},{"k":"N","s":"கி"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","கலித்தளை"]},{"t":"விழிப்பது போலும் பிறப்பு.","err":null,"seers":[{"w":"விழிப்பது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விழிப்"},{"k":"I","s":"பது"}]},{"w":"போலும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"லும்"}]},{"w":"பிறப்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிறப்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":340,"ch":34,"l1":"புக்கில் அமைந்தின்று கொல்லோ உடம்பினுள்","l2":"துச்சில் இருந்த உயிர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"(நோய்களுக்கு இடமாகிய) உடம்பில் ஒரு மூலையில் குடியிருந்த உயிர்க்கு, நிலையாகப் புகுந்திருக்கும் வீடு இதுவரையில் அமையவில்லையோ.","en":"It seems as if the soul, which takes a temporary shelter in a body, had not attained a home","lines":[{"t":"புக்கில் அமைந்தின்று கொல்லோ உடம்பினுள்","err":null,"seers":[{"w":"புக்கில்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"புக்"},{"k":"N","s":"கில்"}]},{"w":"அமைந்தின்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அமைந்"},{"k":"N","s":"தின்"},{"k":"N","s":"று"}]},{"w":"கொல்லோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொல்"},{"k":"N","s":"லோ"}]},{"w":"உடம்பினுள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உடம்"},{"k":"I","s":"பினுள்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"துச்சில் இருந்த உயிர்க்கு.","err":null,"seers":[{"w":"துச்சில்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"துச்"},{"k":"N","s":"சில்"}]},{"w":"இருந்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இருந்"},{"k":"N","s":"த"}]},{"w":"உயிர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயிர்க்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]