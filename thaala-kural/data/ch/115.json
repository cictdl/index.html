[{"n":1141,"ch":115,"l1":"அலரெழ ஆருயிர் நிற்கும் அதனைப்","l2":"பலரறியார் பாக்கியத் தால்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"(எம் காதலைப் பற்றி) அலர் எழுவதால் அறிய உயிர் போகாமல் நிற்கின்றது, எம் நல்வினைப் பயனால் பலரும் அறியாமலிருக்கின்றனர்.","en":"My precious life is saved by the raise of rumour, and this, to my good luck no others are aware of","lines":[{"t":"அலரெழ ஆருயிர் நிற்கும் அதனைப்","err":null,"seers":[{"w":"அலரெழ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அல"},{"k":"I","s":"ரெழ"}]},{"w":"ஆருயிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"ருயிர்"}]},{"w":"நிற்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நிற்"},{"k":"N","s":"கும்"}]},{"w":"அதனைப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னைப்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பலரறியார் பாக்கியத் தால்.","err":null,"seers":[{"w":"பலரறியார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பல"},{"k":"I","s":"ரறி"},{"k":"N","s":"யார்"}]},{"w":"பாக்கியத்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பாக்"},{"k":"I","s":"கியத்"}]},{"w":"தால்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1142,"ch":115,"l1":"மலரன்ன கண்ணாள் அருமை அறியாது","l2":"அலரெமக்கு ஈந்ததிவ் வூர்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["கலித்தளை"],"mv":"மலர் போன்ற கண்ணை உடைய இவளுடைய அருமை அறியாமல், இந்த ஊரார் எளியவளாகக் கருதி அலர் கூறி எமக்கு உதவி செய்தனர்.","en":"Not knowing the value of her whose eyes are like flowers this town has got up a rumour about me","lines":[{"t":"மலரன்ன கண்ணாள் அருமை அறியாது","err":null,"seers":[{"w":"மலரன்ன","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மல"},{"k":"N","s":"ரன்"},{"k":"N","s":"ன"}]},{"w":"கண்ணாள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணாள்"}]},{"w":"அருமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரு"},{"k":"N","s":"மை"}]},{"w":"அறியாது","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"N","s":"யா"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அலரெமக்கு ஈந்ததிவ் வூர்.","err":null,"seers":[{"w":"அலரெமக்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அல"},{"k":"I","s":"ரெமக்"},{"k":"N","s":"கு"}]},{"w":"ஈந்ததிவ்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஈந்"},{"k":"I","s":"ததிவ்"}]},{"w":"வூர்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"வூர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1143,"ch":115,"l1":"உறாஅதோ ஊரறிந்த கெளவை அதனைப்","l2":"பெறாஅது பெற்றன்ன நீர்த்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஊரார் எல்லோரும் அறிந்துள்ள அலர் நமக்குப் பொருந்தாதோ, (பொருந்தும்) அந்த அலர் பெறமுடியாமலிருந்து பெற்றார் போன்ற நன்மை உடையதாக இருக்கின்றது.","en":"Will I not get a rumour that is known to the (whole) town ? For what I have not got is as if I had got it (already)","lines":[{"t":"உறாஅதோ ஊரறிந்த கெளவை அதனைப்","err":null,"seers":[{"w":"உறாஅதோ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உறா"},{"k":"I","s":"அதோ"}]},{"w":"ஊரறிந்த","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"ரறிந்"},{"k":"N","s":"த"}]},{"w":"கெளவை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கெள"},{"k":"N","s":"வை"}]},{"w":"அதனைப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னைப்"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"பெறாஅது பெற்றன்ன நீர்த்து.","err":null,"seers":[{"w":"பெறாஅது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பெறா"},{"k":"I","s":"அது"}]},{"w":"பெற்றன்ன","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பெற்"},{"k":"N","s":"றன்"},{"k":"N","s":"ன"}]},{"w":"நீர்த்து.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீர்த்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1144,"ch":115,"l1":"கவ்வையால் கவ்விது காமம் அதுவின்றேல்","l2":"தவ்வென்னும் தன்மை இழந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"எம் காமம் ஊரார் சொல்லுகின்ற அலரால் வளர்வதாயிற்று, அந்த அலர் இல்லையானால் அது தன் தன்மை இழந்து சுருங்கிப் போய்விடும்.","en":"Rumour increases the violence of my passion; without it it would grow weak and waste away","lines":[{"t":"கவ்வையால் கவ்விது காமம் அதுவின்றேல்","err":null,"seers":[{"w":"கவ்வையால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கவ்"},{"k":"N","s":"வை"},{"k":"N","s":"யால்"}]},{"w":"கவ்விது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கவ்"},{"k":"I","s":"விது"}]},{"w":"காமம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"மம்"}]},{"w":"அதுவின்றேல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அது"},{"k":"N","s":"வின்"},{"k":"N","s":"றேல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தவ்வென்னும் தன்மை இழந்து.","err":null,"seers":[{"w":"தவ்வென்னும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தவ்"},{"k":"N","s":"வென்"},{"k":"N","s":"னும்"}]},{"w":"தன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தன்"},{"k":"N","s":"மை"}]},{"w":"இழந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1145,"ch":115,"l1":"களித்தொறும் கள்ளுண்டல் வேட்டற்றால் காமம்","l2":"வெளிப்படுந் தோறும் இனிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"காமம் அலரால் வெளிப்பட இனியதாதல், கள்ளுண்பவர் கள்ளுண்டு மயங்க மயங்க அக் கள்ளுண்பதையே விரும்பினாற் போன்றது.","en":"As drinking liquor is delightful (to one) whenever one is in mirth, so is lust delightful to me whenever it is the subject of rumour","lines":[{"t":"களித்தொறும் கள்ளுண்டல் வேட்டற்றால் காமம்","err":null,"seers":[{"w":"களித்தொறும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"களித்"},{"k":"I","s":"தொறும்"}]},{"w":"கள்ளுண்டல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளுண்"},{"k":"N","s":"டல்"}]},{"w":"வேட்டற்றால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வேட்"},{"k":"N","s":"டற்"},{"k":"N","s":"றால்"}]},{"w":"காமம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"மம்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வெளிப்படுந் தோறும் இனிது.","err":null,"seers":[{"w":"வெளிப்படுந்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"வெளிப்"},{"k":"I","s":"படுந்"}]},{"w":"தோறும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோ"},{"k":"N","s":"றும்"}]},{"w":"இனிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இனி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1146,"ch":115,"l1":"கண்டது மன்னும் ஒருநாள் அலர்மன்னும்","l2":"திங்களைப் பாம்புகொண் டற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"காதலரைக் கண்டது ஒருநாள் தான், அதனால் உண்டாகிய அலரோ, திங்களைப் பாம்பு கொண்ட செய்தி போல் எங்கும் பரந்து விட்டது.","en":"It was but a single day that I looked on (my lover); but the rumour thereof has spread like the seizure of the moon by the serpent","lines":[{"t":"கண்டது மன்னும் ஒருநாள் அலர்மன்னும்","err":null,"seers":[{"w":"கண்டது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கண்"},{"k":"I","s":"டது"}]},{"w":"மன்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மன்"},{"k":"N","s":"னும்"}]},{"w":"ஒருநாள்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"நாள்"}]},{"w":"அலர்மன்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அலர்"},{"k":"N","s":"மன்"},{"k":"N","s":"னும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"திங்களைப் பாம்புகொண் டற்று.","err":null,"seers":[{"w":"திங்களைப்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"திங்"},{"k":"I","s":"களைப்"}]},{"w":"பாம்புகொண்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பாம்"},{"k":"I","s":"புகொண்"}]},{"w":"டற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":11