[{"n":621,"ch":63,"l1":"இடுக்கண் வருங்கால் நகுக அதனை","l2":"அடுத்தூர்வது அஃதொப்ப தில்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"துன்பம் வரும்போது (அதற்காக கலங்காமல்) நகுதல் வேண்டும், அத் துன்பத்தை எதிர்த்து வெல்லவல்லது அதைப் போன்றது வேறு இல்லை.","en":"If troubles come, laugh; there is nothing like that, to press upon and drive away sorrow","lines":[{"t":"இடுக்கண் வருங்கால் நகுக அதனை","err":null,"seers":[{"w":"இடுக்கண்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடுக்"},{"k":"N","s":"கண்"}]},{"w":"வருங்கால்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வருங்"},{"k":"N","s":"கால்"}]},{"w":"நகுக","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நகு"},{"k":"N","s":"க"}]},{"w":"அதனை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அடுத்தூர்வது அஃதொப்ப தில்.","err":null,"seers":[{"w":"அடுத்தூர்வது","name":"புளிமாங்கனி","cls":"கனி","a":[{"k":"I","s":"அடுத்"},{"k":"N","s":"தூர்"},{"k":"I","s":"வது"}]},{"w":"அஃதொப்ப","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"தொப்"},{"k":"N","s":"ப"}]},{"w":"தில்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"தில்"}]}],"thalai":["ஒன்றிய வஞ்சித்தளை","வெண்சீர் வெண்டளை"]}]},{"n":622,"ch":63,"l1":"வெள்ளத் தனைய இடும்பை அறிவுடையான்","l2":"உள்ளத்தின் உள்ளக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வெள்ளம் போல் அளவற்றதாய் வரும் துன்பமும், அறிவுடையவன் தன் உள்ளத்தினால் அத் துன்பத்தின் இயல்பை நினைத்த அளவில் கெடும்.","en":"A flood of troubles will be overcome by the (courageous) thought which the minds of the wise will entertain, even in sorrow","lines":[{"t":"வெள்ளத் தனைய இடும்பை அறிவுடையான்","err":null,"seers":[{"w":"வெள்ளத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வெள்"},{"k":"N","s":"ளத்"}]},{"w":"தனைய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தனை"},{"k":"N","s":"ய"}]},{"w":"இடும்பை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடும்"},{"k":"N","s":"பை"}]},{"w":"அறிவுடையான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வுடை"},{"k":"N","s":"யான்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உள்ளத்தின் உள்ளக் கெடும்.","err":null,"seers":[{"w":"உள்ளத்தின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளத்"},{"k":"N","s":"தின்"}]},{"w":"உள்ளக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளக்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":623,"ch":63,"l1":"இடும்பைக்கு இடும்பை படுப்பர் இடும்பைக்கு","l2":"இடும்பை படாஅ தவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["கலித்தளை"],"mv":"துன்பம் வந்த போது அதற்க்காக வருந்திக் கலங்காதவர் அந்தத் துன்பத்திற்கே துன்பம் உண்டாக்கி அதை வென்று விடுவார்.","en":"They give sorrow to sorrow, who in sorrow do not suffer sorrow","lines":[{"t":"இடும்பைக்கு இடும்பை படுப்பர் இடும்பைக்கு","err":null,"seers":[{"w":"இடும்பைக்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இடும்"},{"k":"N","s":"பைக்"},{"k":"N","s":"கு"}]},{"w":"இடும்பை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடும்"},{"k":"N","s":"பை"}]},{"w":"படுப்பர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"படுப்"},{"k":"N","s":"பர்"}]},{"w":"இடும்பைக்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இடும்"},{"k":"N","s":"பைக்"},{"k":"N","s":"கு"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இடும்பை படாஅ தவர்.","err":null,"seers":[{"w":"இடும்பை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடும்"},{"k":"N","s":"பை"}]},{"w":"படாஅ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"படா"},{"k":"N","s":"அ"}]},{"w":"தவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தவர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":624,"ch":63,"l1":"மடுத்தவா யெல்லாம் பகடன்னான் உற்ற","l2":"இடுக்கண் இடர்ப்பாடு உடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இய