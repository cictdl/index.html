[{"n":1011,"ch":102,"l1":"கருமத்தால் நாணுதல் நாணுந் திருநுதல்","l2":"நல்லவர் நாணுப் பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தகாத செயல் காரணமாக நாணுவதே நாணமாகும், பெண்களுக்கு இயல்பான மற்ற நாணங்கள் வேறு வகையானவை.","en":"True modesty is the fear of (evil) deeds; all other modesty is (simply) the bashfulness of virtuous maids","lines":[{"t":"கருமத்தால் நாணுதல் நாணுந் திருநுதல்","err":null,"seers":[{"w":"கருமத்தால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கரு"},{"k":"N","s":"மத்"},{"k":"N","s":"தால்"}]},{"w":"நாணுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நா"},{"k":"I","s":"ணுதல்"}]},{"w":"நாணுந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணுந்"}]},{"w":"திருநுதல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"திரு"},{"k":"I","s":"நுதல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நல்லவர் நாணுப் பிற.","err":null,"seers":[{"w":"நல்லவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"லவர்"}]},{"w":"நாணுப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணுப்"}]},{"w":"பிற.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பிற"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1012,"ch":102,"l1":"ஊணுடை எச்சம் உயிர்க்கெல்லாம் வேறல்ல","l2":"நாணுடைமை மாந்தர் சிறப்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"உணவும், உடையும் எஞ்சி நிற்கும் மற்றவையும், எல்லா உயிர்களுக்கும் பொதுவானவை, மக்களின் சிறப்பியல்பாக விளங்குவது நாணுடைமையே ஆகும்.","en":"Food, clothing and the like are common to all men but modesty is peculiar to the good","lines":[{"t":"ஊணுடை எச்சம் உயிர்க்கெல்லாம் வேறல்ல","err":null,"seers":[{"w":"ஊணுடை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"ணுடை"}]},{"w":"எச்சம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எச்"},{"k":"N","s":"சம்"}]},{"w":"உயிர்க்கெல்லாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உயிர்க்"},{"k":"N","s":"கெல்"},{"k":"N","s":"லாம்"}]},{"w":"வேறல்ல","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"றல்"},{"k":"N","s":"ல"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நாணுடைமை மாந்தர் சிறப்பு.","err":null,"seers":[{"w":"நாணுடைமை","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"I","s":"ணுடை"},{"k":"N","s":"மை"}]},{"w":"மாந்தர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாந்"},{"k":"N","s":"தர்"}]},{"w":"சிறப்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"சிறப்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1013,"ch":102,"l1":"ஊனைக் குறித்த உயிரெல்லாம் நாண்என்னும்","l2":"நன்மை குறித்தது சால்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"எல்லா உயிர்களும் ஊனாலாகிய உடம்பை இருப்பிடமாகக் கொண்டவை, சால்பு என்பது நாணம் என்று சொல்லப்படும் நல்லப் பண்பை இருப்பிடமாகக் கொண்டது.","en":"As the body is the abode of the spirit, so the excellence of modesty is the abode of perfection","lines":[{"t":"ஊனைக் குறித்த உயிரெல்லாம் நாண்என்னும்","err":null,"seers":[{"w":"ஊனைக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"னைக்"}]},{"w":"குறித்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குறித்"},{"k":"N","s":"த"}]},{"w":"உயிரெல்லாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உயி"},{"k":"N","s":"ரெல்"},{"k":"N","s":"லாம்"}]},{"w":"நாண்என்னும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நாண்"},{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நன்மை குறித்தது சால்பு.","err":null,"seers":[{"w":"நன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"மை"}]},{"w":"குறித்தது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"குறித்"},{"k":"I","s":"தது"}]},{"w":"சால்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சால்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1014,"ch":102,"l1":"அணிஅன்றோ நாணுடைமை சான்றோர்க்கு அஃதின்றேல்","l2":"பிணிஅன்றோ பீடு நடை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["கலித்தளை"],"mv":"சான்றோர்க்கு நாணுடைமை அணிகலம் அன்றோ, அந்த அணிகலம் இல்லையானால் பெருமிதமாக நடக்கும் நடை ஒரு நோய் அன்றோ.","en":"Is not the modesty ornament of the noble ? Without it, their haughtiness would be a pain (to others)","lines":[{"t":"அணிஅன்றோ நாணுடைமை சான்றோர்க்கு அஃதின்றேல்","err":null,"seers":[{"w":"அணிஅன்றோ","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அணி"},{"k":"N","s":"அன்"},{"k":"N","s":"றோ"}]},{"w":"நாணுடைமை","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"I","s":"ணுடை"},{"k":"N","s":"மை"}]},{"w":"சான்றோர்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சான்"},{"k":"N","s":"றோர்க்"},{"k":"N","s":"கு"}]},{"w":"அஃதின்றேல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"தின்"},{"k":"N","s":"றேல்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பிணிஅன்றோ பீடு நடை.","err":null,"seers":[{"w":"பிணிஅன்றோ","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிணி"},{"k":"N","s":"அன்"},{"k":"N","s":"றோ"}]},{"w":"பீடு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பீ"},{"k":"N","s":"டு"}]},{"w":"நடை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"நடை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1015,"ch":102,"l1":"பிறர்பழியும் தம்பழியும் நாணுவார் நாணுக்கு","l2":"உறைபதி என்னும் உலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["கலித்தளை"],"mv":"பிறர்க்கு வரும் பழிக்காகவும், தமக்கு வரும் பழிக்காகவும் நாணுகின்றவர் நாணத்திற்கு உறைவிட மானவர் என்று உலகம் சொல்லும்.","en":"The world regards as the abode of modesty him who fear his own and other's guilt","lines":[{"t":"பிறர்பழியும் தம்பழியும் நாணுவார் நாணுக்கு","err":null,"seers":[{"w":"பிறர்பழியும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறர்"},{"k":"I","s":"பழி"},{"k":"N","s":"யும்"}]},{"w":"தம்பழியும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தம்"},{"k":"I","s":"பழி"},{"k":