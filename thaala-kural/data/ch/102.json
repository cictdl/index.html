் உயிர்மருட்டி அற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மனத்தில் நாணம் இல்லாதவர் உலகத்தில் இயங்குதல், மரத்தால் செய்த பாவையைக் கயிறு கொண்டு ஆட்டி உயிருள்ளதாக மயக்கினாற் போன்றது.","en":"The actions of those who are without modesty at heart are like those of puppet moved by a string","lines":[{"t":"நாண்அகத் தில்லார் இயக்கம் மரப்பாவை","err":null,"seers":[{"w":"நாண்அகத்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நாண்"},{"k":"I","s":"அகத்"}]},{"w":"தில்லார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தில்"},{"k":"N","s":"லார்"}]},{"w":"இயக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இயக்"},{"k":"N","s":"கம்"}]},{"w":"மரப்பாவை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மரப்"},{"k":"N","s":"பா"},{"k":"N","s":"வை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நாணால் உயிர்மருட்டி அற்று.","err":null,"seers":[{"w":"நாணால்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணால்"}]},{"w":"உயிர்மருட்டி","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உயிர்"},{"k":"I","s":"மருட்"},{"k":"N","s":"டி"}]},{"w":"அற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]}]