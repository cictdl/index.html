[{"n":131,"ch":14,"l1":"ஒழுக்கம் விழுப்பந் தரலான் ஒழுக்கம்","l2":"உயிரினும் ஓம்பப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒழுக்கமே எல்லார்க்கும் மேன்மையைத் தருவதாக இருப்பதால், அந்த ஒழுக்கமே உயிரை விடச் சிறந்ததாகப் போற்றப்படும்.","en":"Propriety of conduct leads to eminence, it should therefore be preserved more carefully than life","lines":[{"t":"ஒழுக்கம் விழுப்பந் தரலான் ஒழுக்கம்","err":null,"seers":[{"w":"ஒழுக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழுக்"},{"k":"N","s":"கம்"}]},{"w":"விழுப்பந்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விழுப்"},{"k":"N","s":"பந்"}]},{"w":"தரலான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தர"},{"k":"N","s":"லான்"}]},{"w":"ஒழுக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழுக்"},{"k":"N","s":"கம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உயிரினும் ஓம்பப் படும்.","err":null,"seers":[{"w":"உயிரினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உயி"},{"k":"I","s":"ரினும்"}]},{"w":"ஓம்பப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓம்"},{"k":"N","s":"பப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":132,"ch":14,"l1":"பரிந்தோம்பிக் காக்க ஒழுக்கம் தெரிந்தோம்பித்","l2":"தேரினும் அஃதே துணை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒழுக்கத்தை வருந்தியும் போற்றிக் காக்க வேண்டும்; பலவற்றையும் ஆராய்ந்து போற்றித் தெளிந்தாலும், அந்த ஒழுக்கமே வாழ்க்கையில் துணையாக விளங்கும்.","en":"Let propriety of conduct be laboriously preserved and guarded; though one know and practise and excel in many virtues, that will be an eminent aid","lines":[{"t":"பரிந்தோம்பிக் காக்க ஒழுக்கம் தெரிந்தோம்பித்","err":null,"seers":[{"w":"பரிந்தோம்பிக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பரிந்"},{"k":"N","s":"தோம்"},{"k":"N","s":"பிக்"}]},{"w":"காக்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காக்"},{"k":"N","s":"க"}]},{"w":"ஒழுக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழுக்"},{"k":"N","s":"கம்"}]},{"w":"தெரிந்தோம்பித்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தெரிந்"},{"k":"N","s":"தோம்"},{"k":"N","s":"பித்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தேரினும் அஃதே துணை.","err":null,"seers":[{"w":"தேரினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தே"},{"k":"I","s":"ரினும்"}]},{"w":"அஃதே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"தே"}]},{"w":"துணை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"துணை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":133,"ch":14,"l1":"ஒழுக்கம் உடைமை குடிமை இழுக்கம்","l2":"இழிந்த பிறப்பாய் விடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒழுக்கம் உடையவராக வாழ்வதே உயர்ந்த குடிப்பிறப்பின் தன்மையாகும்; ஒழுக்கம் தவறுதல் இழிந்த குடிப்பிறப்பின் தன்மையாகி விடும்.","en":"Propriety of conduct is true greatness of birth, and impropriety will sink into a mean birth","lines":[{"t":"ஒழுக்கம் உடைமை குடிமை இழுக்கம்","err":null,"seers":[{"w":"ஒழுக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழுக்"},{"k":"N","s":"கம்"}]},{"w":"உடைமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"மை"}]},{"w":"குடிமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குடி"},{"k":"N","s":"மை"}]},{"w":"இழுக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"கம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இழிந்த பிறப்பாய் விடும்.","err":null,"seers":[{"w":"இழிந்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழிந்"},{"k":"N","s":"த"}]},{"w":"பிறப்பாய்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிறப்"},{"k":"N","s":"பாய்"}]},{"w":"விடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":134,"ch":14,"l1":"மறப்பினும் ஓத்துக் கொளலாகும் பார்ப்பான்","l2":"பிறப்பொழுக்கங் குன்றக் கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கற்ற மறைப் பொருளை மறந்தாலும் மீண்டும் அதனை ஓதிக் கற்றுக் கொள்ள முடியும்; ஆனால் மறை ஓதுவனுடைய குடிப்பிறப்பு, ஒழுக்கம் குன்றினால் கெடு்ம்.","en":"A Brahman though he should forget the Vedas may recover it by reading; but, if he fail in propriety of conduct even his high birth will be destroyed","lines":[{"t":"மறப்பினும் ஓத்துக் கொளலாகும் பார்ப்பான்","err":null,"seers":[{"w":"மறப்பினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மறப்"},{"k":"I","s":"பினும்"}]},{"w":"ஓத்துக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓத்"},{"k":"N","s":"துக்"}]},{"w":"கொளலாகும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கொள"},{"k":"N","s":"லா"},{"k":"N","s":"கும்"}]},{"w":"பார்ப்பான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பார்ப்"},{"k":"N","s":"பான்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பிறப்பொழுக்கங் குன்றக் கெடும்.","err":null,"seers":[{"w":"பிறப்பொழுக்கங்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறப்"},{"k":"I","s":"பொழுக்"},{"k":"N","s":"கங்"}]},{"w":"குன்றக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குன்"},{"k":"N","s":"றக்"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":135,"ch":14,"l1":"அழுக்கா றுடையான்கண் ஆக்கம்போன்று இல்லை","l2":"ஒழுக்க மிலான்கண் உயர்வு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொறாமை உடையவனிடத்தில் ஆக்கம் இல்லாதவாறு போல, ஒழுக்கம் இல்லாதவனுடைய வாழ்க்கையில் உயர்வு இல்லையாகும்.","en":"Just as the envious man will be without wealth, so will the man of destitute of propriety of conduct be without greatness","lines":[{"t":"அழுக்கா றுடையான்கண் ஆக்கம்போன்று இல்லை","err":null,"seers":[{"w":"அழுக்கா","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அழுக்"},{"k":"N","s":"கா"}]},{"w":"றுடையான்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"றுடை"},{"k":"N","s":"யான்"},{"k":"N","s":"கண்"}]},{"w":"ஆக்கம்போன்று","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"},{"k":"N","s":"போன்"},{"k":"N","s":"று"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை",null]},{"t":"ஒழுக்க மிலான்கண் உயர்வு.","err":null,"seers":[{"w":"ஒழுக்க","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழுக்"},{"k":"N","s":"க"}]},{"w":"மிலான்கண்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மிலான்"},{"k":"N","s":"கண்"}]},{"w":"உயர்வு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயர்"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":136,"ch":14,"l1":"ஒழுக்கத்தின் ஒல்கார் உரவோர் இழுக்கத்தின்","l2":"ஏதம் படுபாக் கறிந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒழுக்கம் தவறுதலால் குற்றம் உண்டாவதை அறிந்து, மனவலிமை உடைய சான்றோர் ஒழுக்கத்தில் தவறாமல் காத்துக் கொள்வர்.","en":"Those firm in mind will not slacken in their observance of the proprieties of life, knowing, as they do, the misery that flows from the transgression from them","lines":[{"t":"ஒழுக்கத்தின் ஒல்கார் உரவோர் இழுக்கத்தின்","err":null,"seers":[{"w":"ஒழுக்கத்தின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒழுக்"},{"k":"N","s":"கத்"},{"k":"N","s":"தின்"}]},{"w":"ஒல்கார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒல்"},{"k":"N","s":"கார்"}]},{"w":"உரவோர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உர"},{"k":"N","s":"வோர்"}]},{"w":"இழுக்கத்தின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"கத்"},{"k":"N","s":"தின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஏதம் படுபாக் கறிந்து.","err":null,"seers":[{"w":"ஏதம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"தம்"}]},{"w":"படுபாக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"படு"},{"k":"N","s":"பாக்"}]},{"w":"கறிந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கறிந்"},{"k":"N","s":"து"}]}],"thalai"