[{"n":371,"ch":38,"l1":"ஆகூழால் தோன்றும் அசைவின்மை கைப்பொருள்","l2":"போகூழால் தோன்றும் மடி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கைப்பொருள் ஆவதற்க்கு காரணமான ஊழால் சோர்வில்லாத முயற்சி உண்டாகும், கைப்பொருள் போவதற்க்கு காரணமான ஊழால் சோம்பல் ஏற்படும்.","en":"Perseverance comes from a prosperous fate, and idleness from an adverse fate","lines":[{"t":"ஆகூழால் தோன்றும் அசைவின்மை கைப்பொருள்","err":null,"seers":[{"w":"ஆகூழால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கூ"},{"k":"N","s":"ழால்"}]},{"w":"தோன்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோன்"},{"k":"N","s":"றும்"}]},{"w":"அசைவின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அசை"},{"k":"N","s":"வின்"},{"k":"N","s":"மை"}]},{"w":"கைப்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கைப்"},{"k":"I","s":"பொருள்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"போகூழால் தோன்றும் மடி.","err":null,"seers":[{"w":"போகூழால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"போ"},{"k":"N","s":"கூ"},{"k":"N","s":"ழால்"}]},{"w":"தோன்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோன்"},{"k":"N","s":"றும்"}]},{"w":"மடி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"மடி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":372,"ch":38,"l1":"பேதைப் படுக்கும் இழவூழ் அறிவகற்றும்","l2":"ஆகலூழ் உற்றக் கடை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பொருள் இழந்தற்கு காரணமான ஊழ், பேதை யாக்கும் பொருள் ஆவதற்க்கு காரணமான ஊழ் அறிவைப் பெருக்கும்.","en":"An adverse fate produces folly, and a prosperous fate produces enlarged knowledge","lines":[{"t":"பேதைப் படுக்கும் இழவூழ் அறிவகற்றும்","err":null,"seers":[{"w":"பேதைப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பே"},{"k":"N","s":"தைப்"}]},{"w":"படுக்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"படுக்"},{"k":"N","s":"கும்"}]},{"w":"இழவூழ்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழ"},{"k":"N","s":"வூழ்"}]},{"w":"அறிவகற்றும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வகற்"},{"k":"N","s":"றும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆகலூழ் உற்றக் கடை.","err":null,"seers":[{"w":"ஆகலூழ்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"கலூழ்"}]},{"w":"உற்றக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உற்"},{"k":"N","s":"றக்"}]},{"w":"கடை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கடை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":373,"ch":38,"l1":"நுண்ணிய நூல்பல கற்பினும் மற்றுந்தன்","l2":"உண்மை யறிவே மிகும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவன் நுட்பமான நூல் பலவற்றைக் கற்றாலும் ஊழுக்கு ஏற்றவாறு அவனுக்கு உள்ள தாகும் அறிவே மேம்பட்டுத் தோன்றும்.","en":"Although (a man) may study the most polished treatises, the knowledge which fate has decreed to him will still prevail","lines":[{"t":"நுண்ணிய நூல்பல கற்பினும் மற்றுந்தன்","err":null,"seers":[{"w":"நுண்ணிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நுண்"},{"k":"I","s":"ணிய"}]},{"w":"நூல்பல","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நூல்"},{"k":"I","s":"பல"}]},{"w":"கற்பினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கற்"},{"k":"I","s":"பினும்"}]},{"w":"மற்றுந்தன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றுந்"},{"k":"N","s":"தன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உண்மை யறிவே மிகும்.","err":null,"seers":[{"w":"உண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"மை"}]},{"w":"யறிவே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"யறி"},{"k":"N","s":"வே"}]},{"w":"மிகும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"மிகும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":374,"ch":38,"l1":"இருவேறு உலகத்து இயற்கை திருவேறு","l2":"தெள்ளிய ராதலும் வேறு.","ok":true,"reseg":true,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"உலகத்தின் இயற்க்கை ஊழின் காரணமாக இரு வேறு வகைப்படும், செல்வம் உடையவராதலும் வேறு அறிவு உடையவராதலும் வேறு.","en":"There are (through fate) two different natures in the world, hence the difference (observable in men) in (their acquisition of) wealth, and in their attainment of knowledge","lines":[{"t":"இருவேறு உலகத்து இயற்கை திருவேறு","err":null,"seers":[{"w":"இருவே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இரு"},{"k":"N","s":"வே"}]},{"w":"றுலகத்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"றுல"},{"k":"N","s":"கத்"}]},{"w":"தியற்கை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தியற்"},{"k":"N","s":"கை"}]},{"w":"திருவேறு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"திரு"},{"k":"N","s":"வே"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தெள்ளிய ராதலும் வேறு.","err":null,"seers":[{"w":"தெள்ளிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தெள்"},{"k":"I","s":"ளிய"}]},{"w":"ராதலும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ரா"},{"k":"I","s":"தலும்"}]},{"w":"வேறு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வே"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":375,"ch":38,"l1":"நல்லவை எல்லாஅந் தீயவாம் தீயவும்","l2":"நல்லவாம் செல்வம் செயற்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"செல்வத்தை ஈட்டும் முயற்சிக்கு ஊழ்வகையால் நல்லவை எல்லாம் தீயவை ஆதலும் உண்டு, தீயவை நல்லவை ஆதலும் உண்டு.","en":"In the acquisition of property, every thing favourable becomes unfavourable, and (on the other hand) everything unfavourable becomes favourable, (through the power of fate)","lines":[{"t":"நல்லவை எல்லாஅந் தீயவாம் தீயவும்","err":null,"seers":[{"w":"நல்லவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"லவை"}]},{"w":"எல்லாஅந்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லா"},{"k":"N","s":"அந்"}]},{"w":"தீயவாம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"யவாம்"}]},{"w":"தீயவும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"யவும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நல்லவாம் செல்வம் செயற்கு.","err":null,"seers":[{"w":"நல்லவாம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"லவாம்"}]},{"w":"செல்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"செயற்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செயற்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":376,"ch":38,"l1":"பரியினும் ஆகாவாம் பாலல்ல உய்த்துச்","l2":"சொரியினும் போகா தம.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஊழால் தமக்கு உரியவை அல்லாதப் பொருள்கள் வருந்திக்காப்பாற்றினாலும் நில்லாமல் போகும் தமக்கு உரியவை கொண்டு போய்ச் சொரிந்தாலும் போகா.","en":"Whatever is not conferred by fate cannot be preserved although it be guarded with most painful care; and that, which fate has made his, cannot be lost, although one should even take it and throw it away","lines":[{"t":"பரியினும் ஆகாவாம் பாலல்ல உய்த்துச்","err":null,"seers":[{"w":"பரியினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பரி"},{"k":"I","s":"யினும்"}]},{"w":"ஆகாவாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"கா"},{"k":"N","s":"வாம்"}]},{"w":"பாலல்ல","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பா"},{"k":"N","s":"லல்"},{"k":"N","s":"ல"}]},{"w":"உய்த்துச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உய்த்"},{"k":"N","s":"துச்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"சொரியினும் போகா தம.","err":null,"seers":[{"w":"சொரியினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"சொரி"},{"k":"I","s":"யினும்"}]},{"w":"போகா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"கா"}]},{"w":"தம.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தம"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":377,"ch":38,"l1":"வகுத்தான் வகுத்த வகையல்லால் கோடி","l2":"தொகுத்தார்க்கு துய்த்தல் அரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஊழ் ஏற்ப்படுத்திய வகையால் அல்லாமல் முயன்று கோடிக்கணக்கானப் பொருளைச் சேர்த்தவருக்கும் அவற்றை நுகர முடியாது.","en":"Even those who gather together millions will only enjoy them, as it has been determined by the disposer (of all things)","lines":[{"t":"வகுத்தான் வகுத்த வகையல்லால் கோடி","err":null,"seers":[{"w":"வகுத்தான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வகுத்"},{"k":"N","s":"தான்"}]},{"w":"வகுத்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வகுத்"},{"k":"N","s":"த"}]},{"w":"வகையல்லால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வகை"},{"k":"N","s":"யல்"},{"k":"N","s":"லால்"}]},{"w":"கோடி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கோ"},{"k":"N","s":"டி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தொகுத்தார்க்கு துய்த்தல் அரிது.","err":null,"seers":[{"w":"தொகுத்தார்க்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தொகுத்"},{"k":"N","s":"தார்க்"},{"k":"N","s":"கு"}]},{"w":"துய்த்தல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"துய்த்"},{"k":"N","s":"தல்"}]},{"w":"அரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":378,"ch":38,"l1":"துறப்பார்மன் துப்புர வில்லார் உறற்பால","l2":"ஊட்டா கழியு மெனின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வரவேண்டிய துன்பங்கள் வந்து வருத்தாமல் நீங்குமானால் நுகரும் பொருள் இல்லாத வறியவர் துறவறம் மேற்க்கொள்வர்.","en":"The destitute will renounce desire (and become ascetics), if (fate) do not make them suffer the hindrances to which they are liable, and they pass away","lines":[{"t":"துறப்பார்மன் துப்புர வில்லார் உறற்பால","err":null,"seers":[{"w":"துறப்பார்மன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துறப்"},{"k":"N","s":"பார்"},{"k":"N","s":"மன்"}]},{"w":"துப்புர","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"துப்"},{"k":"I","s":"புர"}]},{"w":"வில்லார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வில்"},{"k":"N","s":"லார்"}]},{"w":"உறற்பால","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உறற்"},{"k":"N","s":"பா"},{"k":"N","s":"ல"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஊட்டா கழியு மெனின்.","err":null,"seers":[{"w":"ஊட்டா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊட்"},{"k":"N","s":"டா"}]},{"w":"கழியு","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கழி"},{"k":"N","s":"யு"}]},{"w":"மெனின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"மெனின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":379,"ch":38,"l1":"நன்றாங்கால் நல்லவாக் காண்பவர் அன்றாங்கால்","l2":"அல்லற் படுவ தெவன்?","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நல்வினை விளையும் போது நல்லவை எனக் கருதி மகிழ்கின்றனர், தீவினை விளையும் போது துன்பப்பட்டுக் கலங்குவது ஏனோ.","en":"How is it that those, who are pleased with good fortune, trouble themselves when evil comes, (since both are equally the decree of fate) ?","lines":[{"t":"நன்றாங்கால் நல்லவாக் காண்பவர் அன்றாங்கால்","err":null,"seers":[{"w":"நன்றாங்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றாங்"},{"k":"N","s":"கால்"}]},{"w":"நல்லவாக்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"லவாக்"}]},{"w":"காண்பவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"காண்"},{"k":"I","s":"பவர்"}]},{"w":"அன்றாங்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அன்"},{"k":"N","s":"றாங்"},{"k":"N","s":"கால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அல்லற் படுவ தெவன்?","err":null,"seers":[{"w":"அல்லற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அல்"},{"k":"N","s":"லற்"}]},{"w":"படுவ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"படு"},{"k":"N","s":"வ"}]},{"w":"தெவன்?","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தெவன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":380,"ch":38,"l1":"ஊழிற் பெருவலி யாவுள மற்றொன்று","l2":"சூழினுந் தான்முந் துறும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஊழை விட மிக்க வலிமையுள்ளவை வேறு எவை உள்ளன, ஊழை விலக்கும் பொருட்டு மற்றோரு வழியைஆராய்ந்தாலும் அங்கும் தானே முன் வந்து நிற்கும்.","en":"What is stronger than fate ? If we think of an expedient (to avert it), it will itself be with us before (the thought)","lines":[{"t":"ஊழிற் பெருவலி யாவுள மற்றொன்று","err":null,"seers":[{"w":"ஊழிற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"ழிற்"}]},{"w":"பெருவலி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பெரு"},{"k":"I","s":"வலி"}]},{"w":"யாவுள","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"வுள"}]},{"w":"மற்றொன்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றொன்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சூழினுந் தான்முந் துறும்.","err":null,"seers":[{"w":"சூழினுந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சூ"},{"k":"I","s":"ழினுந்"}]},{"w":"தான்முந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தான்"},{"k":"N","s":"முந்"}]},{"w":"துறும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"துறும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]