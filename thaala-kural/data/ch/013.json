[{"n":121,"ch":13,"l1":"அடக்கம் அமரருள் உய்க்கும் அடங்காமை","l2":"ஆரிருள் உய்த்து விடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அடக்கம் ஒருவனை உயர்த்தித் தேவருள் சேர்க்கும்; அடக்கம் இல்லாதிருத்தல், பொல்லாத இருள் போன்ற தீய வாழ்க்கையில் செலுத்தி விடும்.","en":"Self-control will place (a man) among the Gods; the want of it will drive (him) into the thickest darkness (of hell)","lines":[{"t":"அடக்கம் அமரருள் உய்க்கும் அடங்காமை","err":null,"seers":[{"w":"அடக்கம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அடக்"},{"k":"N","s":"கம்"}]},{"w":"அமரருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அம"},{"k":"I","s":"ரருள்"}]},{"w":"உய்க்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உய்க்"},{"k":"N","s":"கும்"}]},{"w":"அடங்காமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அடங்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆரிருள் உய்த்து விடும்.","err":null,"seers":[{"w":"ஆரிருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"ரிருள்"}]},{"w":"உய்த்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உய்த்"},{"k":"N","s":"து"}]},{"w":"விடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":122,"ch":13,"l1":"காக்க பொருளா அடக்கத்தை ஆக்கம்","l2":"அதனினூஉங் கில்லை உயிர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அடக்கத்தை உறுதிப் பொருளாகக் கொண்டு போற்றிக் ‌காக்க வேண்டும். அந்த அடக்கத்தைவிட மேம்பட்ட ஆக்கம் உயிர்க்கு இல்லை.","en":"Let self-control be guarded as a treasure; there is no greater source of good for man than that","lines":[{"t":"காக்க பொருளா அடக்கத்தை ஆக்கம்","err":null,"seers":[{"w":"காக்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காக்"},{"k":"N","s":"க"}]},{"w":"பொருளா","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளா"}]},{"w":"அடக்கத்தை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அடக்"},{"k":"N","s":"கத்"},{"k":"N","s":"தை"}]},{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அதனினூஉங் கில்லை உயிர்க்கு.","err":null,"seers":[{"w":"அதனினூஉங்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அத"},{"k":"I","s":"னினூ"},{"k":"N","s":"உங்"}]},{"w":"கில்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கில்"},{"k":"N","s":"லை"}]},{"w":"உயிர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயிர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":123,"ch":13,"l1":"செறிவறிந்து சீர்மை பயக்கும் அறிவறிந்து","l2":"ஆற்றின் அடங்கப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அறிய வேண்டியவற்றை அறிந்து, நல்வழியில் அடங்கி ஒழுகப்பெற்றால், அந்த அடக்கம் நல்லோரால் அறியப்பட்டு மேன்மை பயக்கும்.","en":"Knowing that self-control is knowledge, if a man should control himself, in the prescribed course, such self-control will bring him distinction among the wise","lines":[{"t":"செறிவறிந்து சீர்மை பயக்கும் அறிவறிந்து","err":null,"seers":[{"w":"செறிவறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"செறி"},{"k":"I","s":"வறிந்"},{"k":"N","s":"து"}]},{"w":"சீர்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சீர்"},{"k":"N","s":"மை"}]},{"w":"பயக்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பயக்"},{"k":"N","s":"கும்"}]},{"w":"அறிவறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வறிந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆற்றின் அடங்கப் பெறின்.","err":null,"seers":[{"w":"ஆற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றின்"}]},{"w":"அடங்கப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அடங்"},{"k":"N","s":"கப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":124,"ch":13,"l1":"நிலையின் திரியாது அடங்கியான் தோற்றம்","l2":"மலையினும் மாணப் பெரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"தன் நிலையிலிருந்து மாறுபடாமல் அடங்கி ஒழுகுவோனுடைய உயர்வு, மலையின் உயர்வை விட மிகவும் பெரிதாகும்.","en":"More lofty than a mountain will be the greatness of that man who without swerving from his domestic state, controls himself","lines":[{"t":"நிலையின் திரியாது அடங்கியான் தோற்றம்","err":null,"seers":[{"w":"நிலையின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நிலை"},{"k":"N","s":"யின்"}]},{"w":"திரியாது","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"திரி"},{"k":"N","s":"யா"},{"k":"N","s":"து"}]},{"w":"அடங்கியான்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அடங்"},{"k":"I","s":"கியான்"}]},{"w":"தோற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தோற்"},{"k":"N","s":"றம்"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"மலையினும் மாணப் பெரிது.","err":null,"seers":[{"w":"மலையினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மலை"},{"k":"I","s":"யினும்"}]},{"w":"மாணப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மா"},{"k":"N","s":"ணப்"}]},{"w":"பெரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":125,"ch":13,"l1":"எல்லார்க்கும் நன்றாம் பணிதல் அவருள்ளும்","l2":"செல்வர்க்கே செல்வம் தகைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பணிவுடையவராக ஒழுகுதல்பொதுவாக எல்லோர்க்கும் நல்லதாகும்; அவர்களுள் சிறப்பாகச் செல்வர்க்கே மற்றொரு செல்வம் போன்றதாகும்.","en":"Humility is good in all; but especially in the rich it is (the excellence of) higher riches","lines":[{"t":"எல்லார்க்கும் நன்றாம் பணிதல் அவருள்ளும்","err":null,"seers":[{"w":"எல்லார்க்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லார்க்"},{"k":"N","s":"கும்"}]},{"w":"நன்றாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றாம்"}]},{"w":"பணிதல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பணி"},{"k":"N","s":"தல்"}]},{"w":"அவருள்ளும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவ"},{"k":"N","s":"ருள்"},{"k":"N","s":"ளும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செல்வர்க்கே செல்வம் தகைத்து.","err":null,"seers":[{"w":"செல்வர்க்கே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வர்க்"},{"k":"N","s":"கே"}]},{"w":"செல்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"தகைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தகைத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":126,"ch":13,"l1":"ஒருமையுள் ஆமைபோல் ஐந்தடக்கல் ஆற்றின்","l2":"எழுமையும் ஏமாப் புடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒரு பிறப்பில், ஆமைபோல் ஐம்பொறிகளையும் அடக்கியாள வல்லவனானால், அஃது அவனுக்குப் பல பிறப்பிலும் காப்பாகும் சிறப்பு உடையது.","en":"Should one throughout a single birth, like a tortoise keep in his five senses, the fruit of it will prove a safe-guard to him throughout the seven-fold births.","lines":[{"t":"ஒருமையுள் ஆமைபோல் ஐந்தடக்கல் ஆற்றின்","err":null,"seers":[{"w":"ஒருமையுள்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"மை"},{"k":"N","s":"யுள்"}]},{"w":"ஆமைபோல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"மை"},{"k":"N","s":"போல்"}]},{"w":"ஐந்தடக்கல்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஐந்"},{"k":"I","s":"தடக்"},{"k":"N","s":"கல்"}]},{"w":"ஆற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"எழுமையும் ஏமாப் புடைத்து.","err":null,"seers":[{"w":"எழுமையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எழு"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"ஏமாப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"மாப்"}]},{"w":"புடைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புடைத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":127,"ch":13,"l1":"யாகாவா ராயினும் நாகாக்க காவாக்கால்","l2":"சோகாப்பர் சொல்லிழுக்குப் பட்டு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"காக்க வேண்டியவற்றுள் எவற்றைக் காக்கா விட்டாலும் நாவையாவது காக்க வேண்டு்ம்; காக்கத் தவறினால் சொற்குற்றத்தில் அகப்பட்டுத் துன்புறுவர்.","en":"Whatever besides you leave unguarded, guard your tongue; otherwise errors of speech and the consequent misery will ensue","lines":[{"t":"யாகாவா ராயினும் நாகாக்க காவாக்கால்","err":null,"seers":[{"w":"யாகாவா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"N","s":"கா"},{"k":"N","s":"வா"}]},{"w":"ராயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ரா"},{"k":"I","s":"யினும்"}]},{"w":"நாகாக்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நா"},{"k":"N","s":"காக்"},{"k":"N","s":"க"}]},{"w":"காவாக்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"வாக்"},{"k":"N","s":"கால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"சோகாப்பர் சொல்லிழுக்குப் பட்டு.","err":null,"seers":[{"w":"சோகாப்பர்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சோ"},{"k":"N","s":"காப்"},{"k":"N","s":"பர்"}]},{"w":"சொல்லிழுக்குப்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லிழுக்"},{"k":"N","s":"குப்"}]},{"w":"பட்டு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பட்"},{"k":"N","s":"டு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":128,"ch":13,"l1":"ஒன்றானுந் தீச்சொல் பொருட்பயன் உண்டாயின்","l2":"நன்றாகா தாகி விடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தீய ‌சொற்களின் பொருளால் விளையும் தீமை ஒன்றாயினும் ஒருவனிடம் உண்டானால், அதனால் மற்ற அறங்களாலும் நன்மை விளையாமல் போகும்.","en":"If a man's speech be productive of a single evil, all the good by him will be turned into evil","lines":[{"t":"ஒன்றானுந் தீச்சொல் பொருட்பயன் உண்டாயின்","err":null,"seers":[{"w":"ஒன்றானுந்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒன்"},{"k":"N","s":"றா"},{"k":"N","s":"னுந்"}]},{"w":"தீச்சொல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீச்"},{"k":"N","s":"சொல்"}]},{"w":"பொருட்பயன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பொருட்"},{"k":"I","s":"பயன்"}]},{"w":"உண்டாயின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டா"},{"k":"N","s":"யின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நன்றாகா தாகி விடும்.","err":null,"seers":[{"w":"நன்றாகா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றா"},{"k":"N","s":"கா"}]},{"w":"தாகி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"கி"}]},{"w":"விடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":129,"ch":13,"l1":"தீயினாற் சுட்டபுண் உள்ளாறும் ஆறாதே","l2":"நாவினாற் சுட்ட வடு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"தீயினால் சுட்ட புண் புறத்தே வடு இருந்தாலும் உள்ளே ஆறிவிடும்; ஆனால் நாவினால் தீய சொல் கூறிச் சுடும் வடு என்றும் ஆறாது.","en":"The wound which has been burnt in by fire may heal, but a wound burnt in by the tongue will never heal","lines":[{"t":"தீயினாற் சுட்டபுண் உள்ளாறும் ஆறாதே","err":null,"seers":[{"w":"தீயினாற்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தீ"},{"k":"I","s":"யினாற்"}]},{"w":"சுட்டபுண்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சுட்"},{"k":"I","s":"டபுண்"}]},{"w":"உள்ளாறும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உள்"},{"k":"N","s":"ளா"},{"k":"N","s":"றும்"}]},{"w":"ஆறாதே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"றா"},{"k":"N","s":"தே"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நாவினாற் சுட்ட வடு.","err":null,"seers":[{"w":"நாவினாற்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நா"},{"k":"I","s":"வினாற்"}]},{"w":"சுட்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சுட்"},{"k":"N","s":"ட"}]},{"w":"வடு.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வடு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":130,"ch":13,"l1":"கதங்காத்துக் கற்றடங்கல் ஆற்றுவான் செவ்வி","l2":"அறம்பார்க்கும் ஆற்றின் நுழைந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"சினம் தோன்றாமல் காத்து, கல்வி கற்று, அடக்கமுடையவனாக இருக்க வல்லவனுடைய செவ்வியை, அவனுடைய வழியில் சென்று அறம் பார்த்திருக்கும்.","en":"Virtue, seeking for an opportunity, will come into the path of that man who, possessed of learning and self-control, guards himself against anger","lines":[{"t":"கதங்காத்துக் கற்றடங்கல் ஆற்றுவான் செவ்வி","err":null,"seers":[{"w":"கதங்காத்துக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கதங்"},{"k":"N","s":"காத்"},{"k":"N","s":"துக்"}]},{"w":"கற்றடங்கல்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"I","s":"றடங்"},{"k":"N","s":"கல்"}]},{"w":"ஆற்றுவான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆற்"},{"k":"I","s":"றுவான்"}]},{"w":"செவ்வி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செவ்"},{"k":"N","s":"வி"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அறம்பார்க்கும் ஆற்றின் நுழைந்து.","err":null,"seers":[{"w":"அறம்பார்க்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறம்"},{"k":"N","s":"பார்க்"},{"k":"N","s":"கும்"}]},{"w":"ஆற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றின்"}]},{"w":"நுழைந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நுழைந்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]