[{"n":631,"ch":64,"l1":"கருவியும் காலமும் செய்கையும் செய்யும்","l2":"அருவினையும் மாண்டது அமைச்சு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"செயலுக்கு உரிய கருவியும், ஏற்றக் காலமும், செய்யும் வகையும் செய்யப்படும் அறியச் செயலும் சிறப்படையச் செய்ய வல்லவன் அமைச்சன்.","en":"The minister is one who can make an excellent choice of means, time, manner of execution, and the difficult undertaking (itself)","lines":[{"t":"கருவியும் காலமும் செய்கையும் செய்யும்","err":null,"seers":[{"w":"கருவியும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரு"},{"k":"I","s":"வியும்"}]},{"w":"காலமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கா"},{"k":"I","s":"லமும்"}]},{"w":"செய்கையும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"கை"},{"k":"N","s":"யும்"}]},{"w":"செய்யும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அருவினையும் மாண்டது அமைச்சு.","err":null,"seers":[{"w":"அருவினையும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அரு"},{"k":"I","s":"வினை"},{"k":"N","s":"யும்"}]},{"w":"மாண்டது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மாண்"},{"k":"I","s":"டது"}]},{"w":"அமைச்சு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அமைச்"},{"k":"N","s":"சு"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":632,"ch":64,"l1":"வன்கண் குடிகாத்தல் கற்றறிதல் ஆள்வினையோடு","l2":"ஐந்துடன் மாண்டது அமைச்சு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":[null],"mv":"அஞ்சாமையும், குடிபிறப்பும், காக்கும் திறனும், கற்றறிந்த அறிவும் முயற்சியும் ஆகிய இவ்வைந்தும் திருந்தப்பெற்றவன் அமைச்சன்.","en":"The minister is one who in addition to the aforesaid five things excels in the possession of firmness,","lines":[{"t":"வன்கண் குடிகாத்தல் கற்றறிதல் ஆள்வினையோடு","err":null,"seers":[{"w":"வன்கண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வன்"},{"k":"N","s":"கண்"}]},{"w":"குடிகாத்தல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குடி"},{"k":"N","s":"காத்"},{"k":"N","s":"தல்"}]},{"w":"கற்றறிதல்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"I","s":"றறி"},{"k":"N","s":"தல்"}]},{"w":"ஆள்வினையோடு","name":"கூவிளந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"ஆள்"},{"k":"I","s":"வினை"},{"k":"N","s":"யோ"},{"k":"N","s":"டு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஐந்துடன் மாண்டது அமைச்சு.","err":null,"seers":[{"w":"ஐந்துடன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஐந்"},{"k":"I","s":"துடன்"}]},{"w":"மாண்டது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மாண்"},{"k":"I","s":"டது"}]},{"w":"அமைச்சு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அமைச்"},{"k":"N","s":"சு"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":633,"ch":64,"l1":"பிரித்தலும் பேணிக் கொளலும் பிரிந்தார்ப்","l2":"பொருத்தலும் வல்ல தமைச்சு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பகைவர்ககு துணையானவரைப் பிரித்தலும், தம்மிடம் உள்ளவரைக் காத்தலும், பிரிந்து கொண்டவரை மீண்டும் சேர்த்துக்கொள்ளலும் வல்லவன் அமைச்சன்.","en":"The minister is one who can effect discord (among foes), maintain the good-will of his friends and restore to friendship those who have seceded (from him)","lines":[{"t":"பிரித்தலும் பேணிக் கொளலும் பிரிந்தார்ப்","err":null,"seers":[{"w":"பிரித்தலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பிரித்"},{"k":"I","s":"தலும்"}]},{"w":"பேணிக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பே"},{"k":"N","s":"ணிக்"}]},{"w":"கொளலும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கொள"},{"k":"N","s":"லும்"}]},{"w":"பிரிந்தார்ப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிரிந்"},{"k":"N","s":"தார்ப்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பொருத்தலும் வல்ல தமைச்சு.","err":null,"seers":[{"w":"பொருத்தலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பொருத்"},{"k":"I","s":"தலும்"}]},{"w":"வல்ல","name":"தேமா","cls":