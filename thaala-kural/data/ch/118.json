[{"n":1171,"ch":118,"l1":"கண்தாம் கலுழ்வ தெவன்கொலோ தண்டாநோய்","l2":"தாம்காட்ட யாம்கண் டது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"தீராத இக்காமநோய், கண்கள் காட்ட யாம் கண்டதால் விளைந்தது; அவ்வாறிருக்க, காட்டிய கண்கள், இன்று அன்பு கொண்டு உணராமல் துன்பத்தால் வருந்துவது ஏன்?","en":"As this incurable malady has been caused by my eyes which showed (him) to me, why should they now weep for (him)","lines":[{"t":"கண்தாம் கலுழ்வ தெவன்கொலோ தண்டாநோய்","err":null,"seers":[{"w":"கண்தாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"தாம்"}]},{"w":"கலுழ்வ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கலுழ்"},{"k":"N","s":"வ"}]},{"w":"தெவன்கொலோ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தெவன்"},{"k":"I","s":"கொலோ"}]},{"w":"தண்டாநோய்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தண்"},{"k":"N","s":"டா"},{"k":"N","s":"நோய்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தாம்காட்ட யாம்கண் டது.","err":null,"seers":[{"w":"தாம்காட்ட","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தாம்"},{"k":"N","s":"காட்"},{"k":"N","s":"ட"}]},{"w":"யாம்கண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யாம்"},{"k":"N","s":"கண்"}]},{"w":"டது.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"டது"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1172,"ch":118,"l1":"தெரிந்துணரா நோக்கிய உண்கண் பரிந்துணராப்","l2":"பைதல் உழப்பது எவன்?","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஆராய்ந்து உணராமல் அன்று நோக்கிக் காதல் கொண்ட கண்கள், இன்று அன்பு கொண்டு உணராமல் துன்பத்தால் வருந்துவது ஏன்?","en":"The dyed eyes that (then) looked without foresight, why should they now endure sorrow, without feeling sharply (their own fault)","lines":[{"t":"தெரிந்துணரா நோக்கிய உண்கண் பரிந்துணராப்","err":null,"seers":[{"w":"தெரிந்துணரா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தெரிந்"},{"k":"I","s":"துண"},{"k":"N","s":"ரா"}]},{"w":"நோக்கிய","name":"கூவிளம்","cls":"விளம்"