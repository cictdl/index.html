[{"n":771,"ch":78,"l1":"என்னைமுன் நில்லன்மின் தெவ்விர் பலரென்னை","l2":"முன்நின்று கல்நின் றவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பகைவரே! என்னுடைய தலைவர் முன் எதிர்த்து நிற்காதீர்கள், என்னுடைய தலைவர் முன் எதிர்த்து நின்று கல்வடிவாய் நின்றவர் பலர்.","en":"O my foes, stand not before my leader; (for) many are those who did so but afterwards stood (in the shape of) statues","lines":[{"t":"என்னைமுன் நில்லன்மின் தெவ்விர் பலரென்னை","err":null,"seers":[{"w":"என்னைமுன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"N","s":"னை"},{"k":"N","s":"முன்"}]},{"w":"நில்லன்மின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நில்"},{"k":"N","s":"லன்"},{"k":"N","s":"மின்"}]},{"w":"தெவ்விர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தெவ்"},{"k":"N","s":"விர்"}]},{"w":"பலரென்னை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பல"},{"k":"N","s":"ரென்"},{"k":"N","s":"னை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"முன்நின்று கல்நின் றவர்.","err":null,"seers":[{"w":"முன்நின்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"முன்"},{"k":"N","s":"நின்"},{"k":"N","s":"று"}]},{"w":"கல்நின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கல்"},{"k":"N","s":"நின்"}]},{"w":"றவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"றவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":772,"ch":78,"l1":"கான முயலெய்த அம்பினில் யானை","l2":"பிழைத்தவேல் ஏந்தல் இனிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"காட்டில் ஓடுகின்ற முயலை நோக்கி குறிதவறாமல் எய்த அம்பை ஏந்துதலைவிட, வெட்ட வெளியில் நின்ற யானை மேல் எறிந்து தவறிய வேலை ஏந்துதல் சிறந்தது.","en":"It is more pleasant to hold the dart that has missed an elephant than that which has hit hare in the forest","lines":[{"t":"கான முயலெய்த அம்பினில் யானை","err":null,"seers":[{"w":"கான","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"ன"}]},{"w":"முயலெய்த","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முய"},{"k":"N","s":"லெய்"},{"k":"N","s":"த"}]},{"w":"அம்பினில்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அம்"},{"k":"I","s":"பினில்"}]},{"w":"யானை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"னை"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பிழைத்தவேல் ஏந்தல் இனிது.","err":null,"seers":[{"w":"பிழைத்தவேல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பிழைத்"},{"k":"I","s":"தவேல்"}]},{"w":"ஏந்தல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏந்"},{"k":"N","s":"தல்"}]},{"w":"இனிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இனி"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":773,"ch":78,"l1":"பேராண்மை என்ப தறுகண்ஒன் றுற்றக்கால்","l2":"ஊராண்மை மற்றதன் எஃகு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பகைவரை எதிர்த்து நிற்க்கும் வீரத்தை மிக்க ஆண்மை என்று கூறுவர், ஒரு துன்பம் வந்த போது பகைவர்க்கும் உதவிச் செய்தலை அந்த ஆண்மையின் கூர்மை என்று கூறுவர்.","en":"The learned say that fierceness (incontest with a foe) is indeed great valour; but to become a benefactor in case of accident (to a foe) is the extreme (limit) of that valour","lines":[{"t":"பேராண்மை என்ப தறுகண்ஒன் றுற்றக்கால்","err":null,"seers":[{"w":"பேராண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"ராண்"},{"k":"N","s":"மை"}]},{"w":"என்ப","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"ப"}]},{"w":"தறுகண்ஒன்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தறு"},{"k":"N","s":"கண்"},{"k":"N","s":"ஒன்"}]},{"w":"றுற்றக்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"றுற்"},{"k":"N","s":"றக்"},{"k":"N","s":"கால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஊராண்மை மற்றதன் எஃகு.","err":null,"seers":[{"w":"ஊராண்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"ராண்"},{"k":"N","s":"மை"}]},{"w":"மற்றதன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","