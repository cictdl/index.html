[{"n":541,"ch":55,"l1":"ஓர்ந்துகண் ணோடாது இறைபுரிந்து யார்மாட்டும்","l2":"தேர்ந்துசெய் வஃதே முறை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"யாரிடத்திலும் (குற்றம் இன்னதென்று) ஆராய்ந்து, கண்ணோட்டம் செய்யாமல் நடுவுநிலைமைப் பொருந்தி (செய்யத்தக்கதை) ஆராய்ந்து செய்வதே நீதிமுறையாகும்.","en":"To examine into (the crimes which may be committed), to show no favour (to any one), to desire to act with impartiality towards all, and to inflict (such punishments) as may be wisely resolved on,","lines":[{"t":"ஓர்ந்துகண் ணோடாது இறைபுரிந்து யார்மாட்டும்","err":null,"seers":[{"w":"ஓர்ந்துகண்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஓர்ந்"},{"k":"I","s":"துகண்"}]},{"w":"ணோடாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ணோ"},{"k":"N","s":"டா"},{"k":"N","s":"து"}]},{"w":"இறைபுரிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இறை"},{"k":"I","s":"புரிந்"},{"k":"N","s":"து"}]},{"w":"யார்மாட்டும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யார்"},{"k":"N","s":"மாட்"},{"k":"N","s":"டும்"}]}],"thalai":["இயற்சீர் வெண்டளை","கலித்தளை","வெண்சீர் வெண்டளை"]},{"t":"தேர்ந்துசெய் வஃதே முறை.","err":null,"seers":[{"w":"தேர்ந்துசெய்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தேர்ந்"},{"k":"I","s":"துசெய்"}]},{"w":"வஃதே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வஃ"},{"k":"N","s":"தே"}]},{"w":"முறை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"முறை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":542,"ch":55,"l1":"வானோக்கி வாழும் உலகெல்லாம் மன்னவன்","l2":"கோல் நோக்கி வாழுங் குடி.","ok":true,"reseg":true,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"உலகத்தில் உள்ள உயிர்கள் எல்லாம் மழையை நம்பி வாழ்கின்றன, அதுபோல் குடிமக்கள் எல்லாம் அரசனுடைய செங்கோலை நோக்கி வாழ்கின்றனர்.","en":"When there is rain, the living creation thrives; and so when the king rules justly, his subjects thrive","lines":[{"t":"வானோக்கி வாழும் உலகெல்லாம் மன்னவன்","err":null,"seers":[{"w":"வானோக்கி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வா"},{"k":"N","s":"னோக்"},{"k":"N","s":"கி"}]},{"w":"வாழும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ழும்"}]},{"w":"உலகெல்லாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உல"},{"k":"N","s":"கெல்"},{"k":"N","s":"லாம்"}]},{"w":"மன்னவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னவன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கோல் நோக்கி வாழுங் குடி.","err":null,"seers":[{"w":"கோல்நோக்கி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கோல்"},{"k":"N","s":"நோக்"},{"k":"N","s":"கி"}]},{"w":"வாழுங்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ழுங்"}]},{"w":"குடி","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"குடி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":543,"ch":55,"l1":"அந்தணர் நூற்கும் அறத்திற்கும் ஆதியாய்","l2":"நின்றது மன்னவன் கோல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அந்தணர் போற்றும் மறைநூலுக்கும் அறத்திற்கும் அடிப்படையாய் நின்று உலகத்தைக் காப்பது அரசனுடைய செங்கோலாகும்.","en":"The sceptre of the king is the firm support of the Vedas of the Brahmin, and of all virtues therein described","lines":[{"t":"அந்தணர் நூற்கும் அறத்திற்கும் ஆதியாய்","err":null,"seers":[{"w":"அந்தணர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அந்"},{"k":"I","s":"தணர்"}]},{"w":"நூற்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நூற்"},{"k":"N","s":"கும்"}]},{"w":"அறத்திற்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறத்"},{"k":"N","s":"திற்"},{"k":"N","s":"கும்"}]},{"w":"ஆதியாய்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"தியாய்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நின்றது மன்னவன் கோல்.","err":null,"seers":[{"w":"நின்றது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நின்"},{"k":"I","s":"றது"}]},{"w":"மன்னவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னவன்"}]},{"w":"கோல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கோல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":544,"ch":55,"l1":"குடிதழீஇக் கோலோச்சும் மாநில மன்னன்","l2":"அடிதழீஇ நிற்கும் உலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"குடிகளை அன்போடு அணைத்துக் கொண்டு செங்கோல் செலுத்துகின்ற அரசனுடைய அடியைப்பொருந்தி உலகம் நிலை பெறும்.","en":"The world will constantly embrace the feet of the great king who rules over his subjects with love","lines":[{"t":"குடிதழீஇக் கோலோச்சும் மாநில மன்னன்","err":null,"seers":[{"w":"குடிதழீஇக்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குடி"},{"k":"I","s":"தழீ"},{"k":"N","s":"இக்"}]},{"w":"கோலோச்சும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கோ"},{"k":"N","s":"லோச்"},{"k":"N","s":"சும்"}]},{"w":"மாநில","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மா"},{"k":"I","s":"நில"}]},{"w":"மன்னன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மன்"},{"k":"N","s":"னன்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அடிதழீஇ நிற்கும் உலகு.","err":null,"seers":[{"w":"அடிதழீஇ","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அடி"},{"k":"I","s":"தழீ"},{"k":"N","s":"இ"}]},{"w":"நிற்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நிற்"},{"k":"N","s":"கும்"}]},{"w":"உலகு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உல"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":545,"ch":55,"l1":"இயல்புளிக் கோலோச்சும் மன்னவன் நாட்ட","l2":"பெயலும் விளையுளும் தொக்கு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நீதி முறைப்படி செங்கோல் செலுத்தும் அரசனுடைய நாட்டில் பருவ மழையும் நிறைந்த விளைவும் ஒருசேர ஏற்படுவனவாகும்.","en":"Rain and plentiful crops will ever dwell together in the country of the king who sways his sceptre with justice","lines":[{"t":"இயல்புளிக் கோலோச்சும் மன்னவன் நாட்ட","err":null,"seers":[{"w":"இயல்புளிக்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இயல்"},{"k":"I","s":"புளிக்"}]},{"w":"கோலோச்சும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கோ"},{"k":"N","s":"லோச்"},{"k":"N","s":"சும்"}]},{"w":"மன்னவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னவன்"}]},{"w":"நாட்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நாட்"},{"k":"N","s":"ட"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பெயலும் விளையுளும் தொக்கு.","err":null,"seers":[{"w":"பெயலும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெய"},{"k":"N","s":"லும்"}]},{"w":"விளையுளும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விளை"},{"k":"I","s":"யுளும்"}]},{"w":"தொக்கு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தொக்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":546,"ch":55,"l1":"வேலன்று வென்றி தருவது மன்னவன்","l2":"கோலதூஉங் கோடா தெனின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவனுக்கு வெற்றி பெற்றுத் தருவது வேல் அன்று, அரசனுடைய செங்கோலே ஆகும், அச் செங்கோலும் கோணாதிருக்குமாயின்.","en":"It is not the javelin that gives victory, but the king's sceptre, if it do no injustice","lines":[{"t":"வேலன்று வென்றி தருவது மன்னவன்","err":null,"seers":[{"w":"வேலன்று","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"லன்"},{"k":"N","s":"று"}]},{"w":"வென்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வென்"},{"k":"N","s":"றி"}]},{"w":"தருவது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தரு"},{"k":"I","s":"வது"}]},{"w":"மன்னவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னவன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கோலதூஉங் கோடா தெனின்.","err":null,"seers":[{"w":"கோலதூஉங்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கோ"},{"k":"I","s":"லதூ"},{"k":"N","s":"உங்"}]},{"w":"கோடா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கோ"},{"k":"N","s":"டா"}]},{"w":"தெனின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தெனின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":547,"ch":55,"l1":"இறைகாக்கும் வையகம் எல்லாம் அவனை","l2":"முறைகாக்கும் முட்டாச் செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"உலகத்தை எல்லாம் அரசன் காப்பாற்றுவான், நீதிமுறை கெடாதவாறு ஆட்சி செய்வானாயின் அரசனை அந்த முறையே காப்பாற்றும்.","en":"The king defends the whole world; and justice, when administered without defect, defends the king","lines":[{"t":"இறைகாக்கும் வையகம் எல்லாம் அவனை","err":null,"seers":[{"w":"இறைகாக்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இறை"},{"k":"N","s":"காக்"},{"k":"N","s":"கும்"}]},{"w":"வையகம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வை"},{"k":"I","s":"யகம்"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"அவனை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அவ"},{"k":"N","s":"னை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"முறைகாக்கும் முட்டாச் செயின்.","err":null,"seers":[{"w":"முறைகாக்கும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முறை"},{"k":"N","s":"காக்"},{"k":"N","s":"கும்"}]},{"w":"முட்டாச்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"முட்"},{"k":"N","s":"டாச்"}]},{"w":"செயின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":548,"ch":55,"l1":"எண்பதத்தான் ஓரா முறைசெய்யா மன்னவன்","l2":"தண்பதத்தான் தானே கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"எளிய செவ்வி உடையவனாய் ஆராய்ந்து நீதி முறை செய்யாத அரசன், தாழ்ந்த நிலையில் நின்று (பகைவரில்லாமலும் ) தானே கெடுவான்.","en":"The king who gives not facile audience (to those who approach him), and who does not examine and pass judgment (on their complaints), will perish in disgrace","lines":[{"t":"எண்பதத்தான் ஓரா முறைசெய்யா மன்னவன்","err":null,"seers":[{"w":"எண்பதத்தான்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"எண்"},{"k":"I","s":"பதத்"},{"k":"N","s":"தான்"}]},{"w":"ஓரா","name":"தேமா","cls":"மா","a":