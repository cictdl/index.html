],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":550,"ch":55,"l1":"கொலையிற் கொடியாரை வேந்தொறுத்தல் பைங்கூழ்","l2":"களைகட் டதனொடு நேர்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கொடியவர் சிலரைக் கொலைத்தண்டனையால் அரசன் ஒறுத்தல் பயிரைக் காப்பாற்றக் களையைச் களைவதற்க்கு நிகரான செயலாகும்.","en":"For a king to punish criminals with death, is like pulling up the weeds in the green corn","lines":[{"t":"கொலையிற் கொடியாரை வேந்தொறுத்தல் பைங்கூழ்","err":null,"seers":[{"w":"கொலையிற்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கொலை"},{"k":"N","s":"யிற்"}]},{"w":"கொடியாரை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கொடி"},{"k":"N","s":"யா"},{"k":"N","s":"ரை"}]},{"w":"வேந்தொறுத்தல்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வேந்"},{"k":"I","s":"தொறுத்"},{"k":"N","s":"தல்"}]},{"w":"பைங்கூழ்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பைங்"},{"k":"N","s":"கூழ்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"களைகட் டதனொடு நேர்.","err":null,"seers":[{"w":"களைகட்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"களை"},{"k":"N","s":"கட்"}]},{"w":"டதனொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"டத"},{"k":"I","s":"னொடு"}]},{"w":"நேர்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"நேர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]