[{"n":1151,"ch":116,"l1":"செல்லாமை உண்டேல் எனக்குரை மற்றுநின்","l2":"வல்வரவு வாழ்வார்க் குரை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பிரிந்து செல்லாத நிலைமை இருந்தால் எனக்குச் சொல், பிரிந்து சென்று விரைந்து வருதலைப் பற்றியானால் அதுவரையில் உயிர்வாழ வல்லவர்க்குச் சொல்.","en":"If it is not departure, tell me; but if it is your speedy return, tell it to those who would be alive then","lines":[{"t":"செல்லாமை உண்டேல் எனக்குரை மற்றுநின்","err":null,"seers":[{"w":"செல்லாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"லா"},{"k":"N","s":"மை"}]},{"w":"உண்டேல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டேல்"}]},{"w":"எனக்குரை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"எனக்"},{"k":"I","s":"குரை"}]},{"w":"மற்றுநின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மற்"},{"k":"I","s":"றுநின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வல்வரவு வாழ்வார்க் குரை.","err":null,"seers":[{"w":"வல்வரவு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வல்"},{"k":"I","s":"வர"},{"k":"N","s":"வு"}]},{"w":"வாழ்வார்க்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"வார்க்"}]},{"w":"குரை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"குரை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1152,"ch":116,"l1":"இன்கண் உடைத்தவர் பார்வல் பிரிவஞ்சும்","l2":"புன்கண் உடைத்தால் புணர்வு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அவருடைய பார்வை முன்பு இன்பம் உடையதாக இருந்தது, இப்போது அவருடைய கூட்டம் பிரிவுக்கு அஞ்சுகின்ற துன்பம் உடையதாக இருக்கின்றது.","en":"His very look was once pleasing; but (now) even intercourse is painful through fear of separation","lines":[{"t":"இன்கண் உடைத்தவர் பார்வல் பிரிவஞ்சும்","err":null,"seers":[{"w":"இன்கண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"கண்"}]},{"w":"உடைத்தவர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உடைத்"},{"k":"I","s":"தவர்"}]},{"w":"பார்வல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பார்"},{"k":"N","s":"வல்"}]},{"w":"பிரிவஞ்சும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிரி"},{"k":"N","s":"வஞ்"},{"k":"N","s":"சும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"புன்கண் உடைத்தால் புணர்வு.","err":null,"seers":[{"w":"புன்கண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"புன்"},{"k":"N","s":"கண்"}]},{"w":"உடைத்தால்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடைத்"},{"k":"N","s":"தால்"}]},{"w":"புணர்வு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புணர்"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1153,"ch":116,"l1":"அரிதரோ தேற்றம் அறிவுடையார் கண்ணும்","l2":"பிரிவோ ரிடத்துண்மை யான்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறிவுடைய காதலரிடத்தும் பிரிவு ஒரு காலத்தில் உள்ள படியால் அவர் பிரியேன் என்று சொல்லும் உறுதி மொழியை நம்பித் தெளிவது அரிது.","en":"As even the lover who understands (everything) may at times depart, confidence is hardly possible","lines":[{"t":"அரிதரோ தேற்றம் அறிவுடையார் கண்ணும்","err":null,"seers":[{"w":"அரிதரோ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அரி"},{"k":"I","s":"தரோ"}]},{"w":"தேற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தேற்"},{"k":"N","s":"றம்"}]},{"w":"அறிவுடையார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வுடை"},{"k":"N","s":"யார்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பிரிவோ ரிடத்துண்மை யான்.","err":null,"seers":[{"w":"பிரிவோ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிரி"},{"k":"N","s":"வோ"}]},{"w":"ரிடத்துண்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ரிடத்"},{"k":"N","s":"துண்"},{"k":"N","s":"மை"}]},{"w":"யான்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"யான்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1154,"ch":116,"l1":"அளித்தஞ்சல் என்றவர் நீப்பின் தெளித்தசொல்","l2":"தேறியார்க்கு உண்டோ தவறு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அருள் மிகுந்தவராய் அஞ்ச வேண்டா என்று முன் தேற்றியவர் பிரிந்து செல்வாரானால் அவர் கூறிய உறுதிமொழியை நம்பித் தெளிந்தவர்க்கு குற்றம் உண்டோ.","en":"If he who bestowed his love and said \"fear not\" should depart, will it be the fault of those who believed in (his) assuring words ?","lines":[{"t":"அளித்தஞ்சல் என்றவர் நீப்பின் தெளித்தசொல்","err":null,"seers":[{"w":"அளித்தஞ்சல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அளித்"},{"k":"N","s":"தஞ்"},{"k":"N","s":"சல்"}]},{"w":"என்றவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"றவர்"}]},{"w":"நீப்பின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீப்"},{"k":"N","s":"பின்"}]},{"w":"தெளித்தசொல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தெளித்"},{"k":"I","s":"தசொல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தேறியார்க்கு உண்டோ தவறு.","err":null,"seers":[{"w":"தேறியார்க்கு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தே"},{"k":"I","s":"றியார்க்"},{"k":"N","s":"கு"}]},{"w":"உண்டோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டோ"}]},{"w":"தவறு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவ"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1155,"ch":116,"l1":"ஓம்பின் அமைந்தார் பிரிவோம்பல் மற்றவர்","l2":"நீங்கின் அரிதால் புணர்வு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"காத்துக் கொள்வதானால் காதலராக அமைந்தவரின் பிரிவு நேராமல் காக்க வேண்டும், அவர் பிரிந்து நீங்கினால் மீண்டும் கூடுதல் அரிது.","en":"If you would save (my life), delay the departure of my destined (husband); for if he departs, intercourse will become impossible","lines":[{"t":"ஓம்பின் அமைந்தார் பிரிவோம்பல் மற்றவர்","err":null,"seers":[{"w":"ஓம்பின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓம்"},{"k":"N","s":"பின்"}]},{"w":"அமைந்தார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அமைந்"},{"k":"N","s":"தார்"}]},{"w":"பிரிவோம்பல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பிரி"},{"k":"N","s":"வோம்"},{"k":"N","s":"பல்"}]},{"w":"மற்றவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மற்"},{"k":"I","s":"றவர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நீங்கின் அரிதால் புணர்வு.","err":null,"seers":[{"w":"நீங்கின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீங்"},{"k":"N","s":"கின்"}]},{"w":"அரிதால்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"தால்"}]},{"w":"புணர்வு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புணர்"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1156,"ch":116,"l1":"பிரிவுரைக்கும் வன்கண்ணர் ஆயின் அரிதவர்","l2":"நல்குவர் என்னும் நசை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பிரிவைப்பற்றி தெரிவிக்கும் அளவிற்குக் கல் நெஞ்சம் உடையவரானால் , அத்தகையவர் திரும்பிவந்து அன்பு செய்வார் என்னும் ஆசை பயனற்றது.","en":"Is hard, when he could stand, and of departure speak to me","lines":[{"t":"பிரிவுரைக்கும் வன்கண்ணர் ஆயின் அரிதவர்","err":null,"seers":[{"w":"பிரிவுரைக்கும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிரி"},{"k":"I","s":"வுரைக்"},{"k":"N","s":"கும்"}]},{"w":"வன்கண்ணர்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வன்"},{"k":"N","s":"கண்"},{"k":"N","s":"ணர்"}]},{"w":"ஆயின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"யின்"}]},{"w":"அரிதவர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அரி"},{"k":"I","s":"தவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நல்குவர் என்னும் நசை.","err":null,"seers":[{"w":"நல்குவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நல்"},{"k":"I","s":"குவர்"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"நசை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"நசை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1157,"ch":116,"l1":"துறைவன் துறந்தமை தூற்றாகொல் முன்கை","l2":"இறைஇறவா நின்ற வளை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"என் மெலிவால் முன் கையில் இறை கடந்து கழலும் வளையல்கள், தலைவன் விட்டுப் பிரிந்த செய்தியைப் பலரறியத் தெரிவித்துத் தூற்றாமலிருக்குமோ.","en":"Do not the rings that begin to slide down my fingers forebode the separation of my lord ?","lines":[{"t":"துறைவன் துறந்தமை தூற்றாகொல் முன்கை","err":null,"seers":[{"w":"துறைவன்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துறை"},{"k":"N","s":"வன்"}]},{"w":"துறந்தமை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"துறந்"},{"k":"I","s":"தமை"}]},{"w":"தூற்றாகொல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தூற்"},{"k":"N","s":"றா"},{"k":"N","s":"கொல்"}]},{"w":"முன்கை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"முன்"},{"k":"N","s":"கை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இறைஇறவா நின்ற வளை.","err":null,"seers":[{"w":"இறைஇறவா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இறை"},{"k":"I","s":"இற"},{"k":"N","s":"வா"}]},{"w":"நின்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நின்"},{"k":"N","s":"ற"}]},{"w":"வளை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வளை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1158,"ch":116,"l1":"இன்னாது இனன்இல்ஊர் வாழ்தல் அதனினும்","l2":"இன்னாது இனியார்ப் பிரிவு.","ok":true,"reseg":true,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"இனத்தவராக நம்மேல் அன்புடையார் இல்லாத ஊரில் வாழ்தல் துன்பமானது, இனியக் காதலரின் பிரிவு அதை விடத் துன்பமானது.","en":"Painful is it to live in a friendless town; but far more painful is it to part from one's lover","lines":[{"t":"இன்னாது இனன்இல்ஊர் வாழ்தல் அதனினும்","err":null,"seers":[{"w":"இன்னா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"}]},{"w":"தினன்இல்ஊர்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தினன்"},{"k":"N","s":"இல்"},{"k":"N","s":"ஊர்"}]},{"w":"வாழ்