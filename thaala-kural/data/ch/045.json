[{"n":441,"ch":45,"l1":"அறனறிந்து மூத்த அறிவுடையார் கேண்மை","l2":"திறனறிந்து தேர்ந்து கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறம் உணர்ந்தவராய்த் தன்னை விட மூத்தவராய் உள்ள அறிவுடையவரின் நட்பை, கொள்ளும் வகை அறிந்து ஆராய்ந்து கொள்ள வேண்டும்.","en":"Let (a king) ponder well its value, and secure the friendship of men of virtue and of mature knowledge","lines":[{"t":"அறனறிந்து மூத்த அறிவுடையார் கேண்மை","err":null,"seers":[{"w":"அறனறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அற"},{"k":"I","s":"னறிந்"},{"k":"N","s":"து"}]},{"w":"மூத்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மூத்"},{"k":"N","s":"த"}]},{"w":"அறிவுடையார்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வுடை"},{"k":"N","s":"யார்"}]},{"w":"கேண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேண்"},{"k":"N","s":"மை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"திறனறிந்து தேர்ந்து கொளல்.","err":null,"seers":[{"w":"திறனறிந்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"திற"},{"k":"I","s":"னறிந்"},{"k":"N","s":"து"}]},{"w":"தேர்ந்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தேர்ந்"},{"k":"N","s":"து"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":442,"ch":45,"l1":"உற்றநோய் நீக்கி உறாஅமை முற்காக்கும்","l2":"பெற்றியார்ப் பேணிக் கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வந்துள்ள துன்பத்தை நீக்கி, இனித் துன்பம் வராதபடி முன்னதாகவே காக்கவல்ல தன்மையுடையவரைப் போற்றி நட்புக் கொள்ள வேண்டும்.","en":"Let (a king) procure and kindly care for men who can overcome difficulties when they occur, and guard against them before they happen","lines":[{"t":"உற்றநோய் நீக்கி உறாஅமை முற்காக்கும்","err":null,"seers":[{"w":"உற்றநோய்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உற்"},{"k":"I","s":"றநோய்"}]},{"w":"நீக்கி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீக்"},{"k":"N","s":"கி"}]},{"w":"உறாஅமை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உறா"},{"k":"I","s":"அமை"}]},{"w":"முற்காக்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"முற்"},{"k":"N","s":"காக்"},{"k":"N","s":"கும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பெற்றியார்ப் பேணிக் கொளல்.","err":null,"seers":[{"w":"பெற்றியார்ப்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பெற்"},{"k":"I","s":"றியார்ப்"}]},{"w":"பேணிக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பே"},{"k":"N","s":"ணிக்"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":443,"ch":45,"l1":"அரியவற்று ளெல்லாம் அரிதே பெரியாரைப்","l2":"பேணித் தமராக் கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பெரியாரைப் போற்றி தமக்குச் சுற்றத்தாராக்கிக் கொள்ளுதல், பெறத்தக்க அரிய பேறுகள் எல்லாவற்றிலும் அருமையானதாகும்.","en":"To cherish great men and make them his own, is the most difficult of all difficult things","lines":[{"t":"அரியவற்று ளெல்லாம் அரிதே பெரியாரைப்","err":null,"seers":[{"w":"அரியவற்று","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அரி"},{"k":"I","s":"யவற்"},{"k":"N","s":"று"}]},{"w":"ளெல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ளெல்"},{"k":"N","s":"லாம்"}]},{"w":"அரிதே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"தே"}]},{"w":"பெரியாரைப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"யா"},{"k":"N","s":"ரைப்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பேணித் தமராக் கொளல்.","err":null,"seers":[{"w":"பேணித்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பே"},{"k":"N","s":"ணித்"}]},{"w":"தமராக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தம"},{"k":"N","s":"ராக்"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":444,"ch":45,"l1":"தம்மிற் பெரியார் தமரா ஒழுகுதல்","l2":"வன்மையு ளெல்லாந் தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தம்மைவிட (அறிவு முதலியவற்றால் ) பெரியவர் தமக்குச் சுற்றத்தராகுமாறு நடத்தல், வல்லமை எல்லாவற்றிலும் சிறந்ததாகும்.","en":"So to act as to make those men, his own, who are greater than himself is of all powers the highest","lines":[{"t":"தம்மிற் பெரியார் தமரா ஒழுகுதல்","err":null,"seers":[{"w":"தம்மிற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தம்"},{"k":"N","s":"மிற்"}]},{"w":"பெரியார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"யார்"}]},{"w":"தமரா","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தம"},{"k":"N","s":"ரா"}]},{"w":"ஒழுகுதல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"ஒழு"},{"k":"I","s":"குதல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வன்மையு ளெல்லாந் தலை.","err":null,"seers":[{"w":"வன்மையு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வன்"},{"k":"N","s":"மை"},{"k":"N","s":"யு"}]},{"w":"ளெல்லாந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ளெல்"},{"k":"N","s":"லாந்"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":445,"ch":45,"l1":"சூழ்வார்கண் ணாக ஒழுகலான் மன்னவன்","l2":"சூழ்வாரைக் சூழ்ந்து கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தக்க வழிகளை ஆராய்ந்து கூறும் அறிஞரையே உலகம் கண்ணாகக் கொண்டு நடத்தலால், மன்னவனும் அத்தகையாரைக் ஆராய்ந்து நட்புக்கொள்ள வேண்டும்.","en":"As a king must use his ministers as eyes (in managing his kingdom), let him well examine their character and qualifications before he engages them","lines":[{"t":"சூழ்வார்கண் ணாக ஒழுகலான் மன்னவன்","err":null,"seers":[{"w":"சூழ்வார்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சூழ்"},{"k":"N","s":"வார்"},{"k":"N","s":"கண்"}]},{"w":"ணாக","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ணா"},{"k":"N","s":"க"}]},{"w":"ஒழுகலான்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"ஒழு"},{"k":"I"