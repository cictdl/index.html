[{"n":241,"ch":25,"l1":"அருட்செல்வம் செல்வத்துள் செல்வம் பொருட்செல்வம்","l2":"பூரியார் கண்ணும் உள.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பொருள்களாகிய செல்வங்கள் இழிந்தவரிடத்திலும் உள்ளன; (உயர்ந்தவரிடத்தில் மட்டுமே உள்ள) அருளாகிய செல்வமே செல்வங்களில் சிறந்த செல்வமாகும்.","en":"The wealth of kindness is wealth of wealth, in as much as the wealth of property is possessed by the basest of men","lines":[{"t":"அருட்செல்வம் செல்வத்துள் செல்வம் பொருட்செல்வம்","err":null,"seers":[{"w":"அருட்செல்வம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அருட்"},{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"செல்வத்துள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வத்"},{"k":"N","s":"துள்"}]},{"w":"செல்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]},{"w":"பொருட்செல்வம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருட்"},{"k":"N","s":"செல்"},{"k":"N","s":"வம்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பூரியார் கண்ணும் உள.","err":null,"seers":[{"w":"பூரியார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பூ"},{"k":"I","s":"ரியார்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"உள.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"உள"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":242,"ch":25,"l1":"நல்லாற்றாள் நாடி அருளாள்க பல்லாற்றால்","l2":"தேரினும் அஃதே துணை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நல்ல வழியால் ஆராய்ந்து அருளுடையவர்களாக விளங்க வேண்டும்; பலவழிகளால் ஆராய்ந்து கண்டாலும் அருளே வாழ்க்கைக்குத் துணையாக இருக்கும்.","en":"(Stand) in the good path, consider, and be kind. Even considering according to the conflicting tenets of the different sects, kindness will be your best aid, (in the acquisition of heavenly bliss.)","lines":[{"t":"நல்லாற்றாள் நாடி அருளாள்க பல்லாற்றால்","err":null,"seers":[{"w":"நல்லாற்றாள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"N","s":"லாற்"},{"k":"N","s":"றாள்"}]},{"w":"நாடி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டி"}]},{"w":"அருளாள்க","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அரு"},{"k":"N","s":"ளாள்"},{"k":"N","s":"க"}]},{"w":"பல்லாற்றால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பல்"},{"k":"N","s":"லாற்"},{"k":"N","s":"றால்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தேரினும் அஃதே துணை.","err":null,"seers":[{"w":"தேரினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தே"},{"k":"I","s":"ரினும்"}]},{"w":"அஃதே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"தே"}]},{"w":"துணை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"துணை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":243,"ch":25,"l1":"அருள்சேர்ந்த நெஞ்சினார்க் கில்லை இருள்சேர்ந்த","l2":"இன்னா உலகம் புகல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அறியாமையாகிய இருள் பொருந்திய துன்ப உலகில் இருந்து வாழும் வாழ்க்கை, அருள் பொருந்திய நெஞ்சம் உடையவர்களுக்கு இல்லை.","en":"They will never enter the world of darkness and wretchedness whose minds are the abode of kindness","lines":[{"t":"அருள்சேர்ந்த நெஞ்சினார்க் கில்லை இருள்சேர்ந்த","err":null,"seers":[{"w":"அருள்சேர்ந்த","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அருள்"},{"k":"N","s":"சேர்ந்"},{"k":"N","s":"த"}]},{"w":"நெஞ்சினார்க்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நெஞ்"},{"k":"I","s":"சினார்க்"}]},{"w":"கில்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கில்"},{"k":"N","s":"லை"}]},{"w":"இருள்சேர்ந்த","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இருள்"},{"k":"N","s":"சேர்ந்"},{"k":"N","s":"த"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இன்னா உலகம் புகல்.","err":null,"seers":[{"w":"இன்னா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"}]},{"w":"உலகம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உல"},{"k":"N","s":"கம்"}]},{"w":"புகல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"புகல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":244,"ch":25,"l1":"மன்னுயிர் ஓம்பி அருளாள்வார்க்கு இல்லென்ப","l2":"தன்னுயிர் அஞ்சும் வினை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தன் உயிரின் பொருட்டு அஞ்சி வாழ்கின்ற தீவினை, உலகில் நிலைபெற்றுள்ள மற்ற உயிர்களைப் போற்றி அருளுடையவனாக இருப்பவனுக்கு இல்லை.","en":"(The wise) say that the evils, which his soul would dread, will never come upon the man who exercises kindness and protects the life (of other creatures)","lines":[{"t":"மன்னுயிர் ஓம்பி அருளாள்வார்க்கு இல்லென்ப","err":null,"seers":[{"w":"மன்னுயிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னுயிர்"}]},{"w":"ஓம்பி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓம்"},{"k":"N","s":"பி"}]},{"w":"அருளாள்வார்க்கு","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"அரு"},{"k":"N","s":"ளாள்"},{"k":"N","s":"வார்க்"},{"k":"N","s":"கு"}]},{"w":"இல்லென்ப","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லென்"},{"k":"N","s":"ப"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை",null]},{"t":"தன்னுயிர் அஞ்சும் வினை.","err":null,"seers":[{"w":"தன்னுயிர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தன்"},{"k":"I","s":"னுயிர்"}]},{"w":"அஞ்சும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சும்"}]},{"w":"வினை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"வினை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":245,"ch":25,"l1":"அல்லல் அருளாள்வார்க்கு இல்லை வளிவழங்கும்","l2":"மல்லன்மா ஞாலங் கரி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அருளுடையவராக வாழ்கின்றவர்களுக்குத் துன்பம் இல்லை, காற்று இயங்குகின்ற வளம் பெரிய உலகத்தில் வாழ்வோரே இதற்குச் சான்று ஆவர்.","en":"This great rich earth over which the wind blows, is a witness that sorrow never comes upon the kindhearted","lines":[{"t":"அல்லல் அருளாள்வார்க்கு இல்லை வளிவழங்கும்","err":null,"seers":[{"w":"அல்லல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அல்"},{"k":"N","s":"லல்"}]},{"w":"அருளாள்வார்க்கு","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"அரு"},{"k":"N","s":"ளாள்"},{"k":"N","s":"வார்க்"},{"k":"N","s":"கு"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"வளிவழங்கும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வளி"},{"k":"I","s":"வழங்"},{"k":"N","s":"கும்"}]}],"thalai":["இயற்சீர் வெண்டளை",null,"இயற்சீர் வெண்டளை"]},{"t":"மல்லன்மா ஞாலங் கரி.","err":null,"seers":[{"w":"மல்லன்மா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மல்"},{"k":"N","s":"லன்"},{"k":"N","s":"மா"}]},{"w":"ஞாலங்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஞா"},{"k":"N","s":"லங்"}]},{"w":"கரி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கரி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":246,"ch":25,"l1":"பொருள்நீங்கிப் பொச்சாந்தார் என்பர் அருள்நீங்கி","l2":"அல்லவை செய்தொழுகு வார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அருள் இல்லாதவராய் அறமல்லாதவைகளைச் செய்து நடப்பவர்களை, உறுதிப்பொருளாகிய அறத்திலிருந்து நீங்கித் தம் வாழ்க்கையின் குறிக்கோளை மறந்தவர் என்பார்.","en":"(The wise) say that those who neglect kindness and practise cruelties, neglected virtue (in their former birth), and forgot (the sorrows which they must suffer.)","lines":[{"t":"பொருள்நீங்கிப் பொச்சாந்தார் என்பர் அருள்நீங்கி","err":null,"seers":[{"w":"பொருள்நீங்கிப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருள்"},{"k":"N","s":"நீங்"},{"k":"N","s":"கிப்"}]},{"w":"பொச்சாந்தார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொச்"},{"k":"N","s":"சாந்"},{"k":"N","s":"தார்"}]},{"w":"என்பர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"பர்"}]},{"w":"அருள்நீங்கி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அருள்"},{"k":"N","s":"நீங்"},{"k":"N","s":"கி"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அல்லவை செய்தொழுகு வார்.","err":null,"seers":[{"w":"அல்லவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அல்"},{"k":"I","s":"லவை"}]},{"w":"செய்தொழுகு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"தொழு"},{"k":"N","s":"கு"}]},{"w":"வார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"வார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":247,"ch":25,"l1":"அருளில்லார்க்கு அவ்வுலகம் இல்லை பொருளில்லார்க்கு","l2":"இவ்வுலகம் இல்லாகி யாங்கு.","ok":true,"reseg":false,"eetru":"காசு","boundary":[null],"mv":"பொருள் இல்லாதவர்க்கு இவ்வுலகத்து வாழ்க்கை இல்லாதவாறு போல உயிர்களிடத்தில் அருள் இல்லாதவர்க்கு அவ்வுலகத்து வாழ்க்கை இல்லையாம்.","en":"As this world is not for those who are without wealth, so that world is not for those who are without kindness","lines":[{"t":"அருளில்லார்க்கு அவ்வுலகம் இல்லை பொருளில்லார்க்கு","err":null,"seers":[{"w":"அருளில்லார்க்கு","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"அரு"},{"k":"N","s":"ளில்"},{"k":"N","s":"லார்க்"},{"k":"N","s":"கு"}]},{"w":"அவ்வுலகம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"அவ்"},{"k":"I","s":"வுல"},{"k":"N","s":"கம்"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"பொருளில்லார்க்கு","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளில்"},{"k":"N","s":"லார்க்"},{"k":"N","s":"கு"}]}],"thalai":[null,"வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இவ்வுலகம் இல்லாகி யாங்கு.","err":null,"seers":[{"w":"இவ்வுலகம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"இவ்"},{"k":"I","s":"வுல"},{"k":"N","s":"கம்"}]},{"w":"இல்லாகி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"கி"}]},{"w":"யாங்கு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யாங்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":248,"ch":25,"l1":"பொருளற்றார் பூப்பர் ஒருகால் அருளற்றார்","l2":"அற்றார்மற் றாதல் அரிது.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பொருள் இல்லாதவர் ஒரு காலத்தில் வளம் பெற்று விளங்குவர், அருள் இல்லாதவர் வாழ்க்கையின் பயம் அற்றவரே அவர் ஒரு காலத்திலும் சிறந்து விளங்குதல் இல்லை.","en":"Those who are without wealth may, at some future time, become prosperous; those who are destitute of kindness are utterly destitute; for them there is no change","lines":[{"t":"பொருளற்றார் பூப்பர் ஒருகால் அருளற்றார்","err":null,"seers":[{"w":"பொருளற்றார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளற்"},{"k":"N","s":"றார்"}]},{"w":"பூப்பர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பூப்"},{"k":"N","s":"பர்"}]},{"w":"ஒருகால்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"கால்"}]},{"w":"அருளற்றார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அரு"},{"k":"N","s":"ளற்"},{"k":"N","s":"றார்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அற்றார்மற் றாதல் அரிது.","err":null,"seers":[{"w":"அற்றார்மற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அற்"},{"k":"N","s":"றார்"},{"k":"N","s":"மற்"}]},{"w":"றாதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றா"},{"k":"N","s":"தல்"}]},{"w":"அரிது.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அரி"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":249,"ch":25,"l1":"தெருளாதான் மெய்ப்பொருள் கண்டற்றால் தேரின்","l2":"அருளாதான் செய்யும் அறம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அருள் மேற்கொள்ளாதவன் செய்கின்ற அறச்செயலை ஆராய்ந்தால், அஃது அறிவு தெளியாதவன் ஒரு நூலின் உண்மைப் பொருளைக் கண்டாற் போன்றது.","en":"If you consider, the virtue of him who is without kindness is like the perception of the true being by him who is without wisdom","lines":[{"t":"தெருளாதான் மெய்ப்பொருள் கண்டற்றால் தேரின்","err":null,"seers":[{"w":"தெருளாதான்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தெரு"},{"k":"N","s":"ளா"},{"k":"N","s":"தான்"}]},{"w":"மெய்ப்பொருள்","name":"கூவிளம்","cls":"விளம்"