[{"n":1021,"ch":103,"l1":"கருமம் செயஒருவன் கைதூவேன் என்னும்","l2":"பெருமையின் பீடுடையது இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"குடிப் பெருமைக்கு உரிய கடமையைச் செய்வதற்குச் சோர்வடைய மாட்டேன் என்று ஒருவன் முயலும் பெருமையைப் போல மேம்பாடானது வேறொன்றும் இல்லை.","en":"There is no higher greatness than that of one saying I will not cease in my effort (to raise my family)","lines":[{"t":"கருமம் செயஒருவன் கைதூவேன் என்னும்","err":null,"seers":[{"w":"கருமம்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கரு"},{"k":"N","s":"மம்"}]},{"w":"செயஒருவன்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"செய"},{"k":"I","s":"ஒரு"},{"k":"N","s":"வன்"}]},{"w":"கைதூவேன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கை"},{"k":"N","s":"தூ"},{"k":"N","s":"வேன்"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பெருமையின் பீடுடையது இல்.","err":null,"seers":[{"w":"பெருமையின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெரு"},{"k":"N","s":"மை"},{"k":"N","s":"யின்"}]},{"w":"பீடுடையது","name":"கூவிளங்கனி","cls":"கனி","a":[{"k":"N","s":"பீ"},{"k":"I","s":"டுடை"},{"k":"I","s":"யது"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["வெண்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை"]}]},{"n":1022,"ch":103,"l1":"ஆள்வினையும் ஆன்ற அறிவும் எனஇரண்டின்","l2":"நீள்வினையால் நீளும் குடி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"முயற்சி நிறைந்த அறிவு என்று சொல்லப்படும் இரண்டினையும் உடைய இடைவிடாத செயலால் ஒருவனுடைய குடி உயர்ந்து விளங்கும்.","en":"One's family is raised by untiring perseverance in both effort and wise contrivances","lines":[{"t":"ஆள்வினையும் ஆன்ற அறிவும் எனஇரண்டின்","err":null,"seers":[{"w":"ஆள்வினையும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆள்"},{"k":"I","s":"வினை"},{"k":"N","s":"யும்"}]},{"w":"ஆன்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆன்"},{"k":"N","s":"ற"}]},{"w":"அறிவும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வும்"}]},{"w":"எனஇரண்டின்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"என"},{"k":"I","s":"இரண்"},{"k":"N","s":"டின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நீள்வினையால் நீளும் குடி.","err":null,"seers":[{"w":"நீள்வினையால்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நீள்"},{"k":"I","s":"வினை"},{"k":"N","s":"யால்"}]},{"w":"நீளும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீ"},{"k":"N","s":"ளும்"}]},{"w":"குடி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"குடி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1023,"ch":103,"l1":"குடிசெய்வல் என்னும் ஒருவற்குத் தெய்வம்","l2":"மடிதற்றுத் தான்முந் துறும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"என் குடியை உயரச் செய்வேன் என்று முயலும் ஒருவனுக்கு ஊழ், ஆடையைக் கட்டிக் கொண்டு தானே முன் வந்து துணை செய்யும்.","en":"The Deity will clothe itself and appear before him who resolves on raising his family","lines":[{"t":"குடிசெய்வல் என்னும் ஒருவற்குத் தெய்வம்","err":null,"seers":[{"w":"குடிசெய்வல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"குடி"},{"k":"N","s":"செய்"},{"k":"N","s":"வல்"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"ஒருவற்குத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வற்"},{"k":"N","s":"குத்"}]},{"w":"தெய்வம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தெய்"},{"k":"N","s":"வம்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"மடிதற்றுத் தான்முந் துறும்.","err":null,"seers":[{"w":"மடிதற்றுத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மடி"},{"k":"N","s":"தற்"},{"k":"N","s":"றுத்"}]},{"w":"தான்முந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தான்"},{"k":"N","s":"முந்"}]},{"w":"துறும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"துறும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1024,"ch":103,"l1":"சூழாமல் தானே முடிவெய்தும் தம்குடியைத்","l2":"தாழாது உஞற்று பவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"தம் குடி உயர்வதற்கான செயலை விரைந்து முயன்று செய்வோர்க்கு அவர் ஆராயமலே அச் செயல் தானே நிறைவேறும்.","en":"Those who are prompt in their efforts (to better their family) need no deliberation, such efforts will of themselves succeed","lines":[{"t":"சூழாமல் தானே முடிவெய்தும் தம்குடியைத்","err":null,"seers":[{"w":"சூழாமல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சூ"},{"k":"N","s":"ழா"},{"k":"N","s":"மல்"}]},{"w":"தானே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"னே"}]},{"w":"முடிவெய்தும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முடி"},{"k":"N","s":"வெய்"},{"k":"N","s":"தும்"}]},{"w":"தம்குடியைத்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"தம்"},{"k":"I","s":"குடி"},{"k":"N","s":"யைத்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"தாழாது உஞற்று பவர்க்கு.","err":null,"seers":[{"w":"தாழாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தா"},{"k":"N","s":"ழா"},{"k":"N","s":"து"}]},{"w":"உஞற்று","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உஞற்"},{"k":"N","s":"று"}]},{"w":"பவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":1025,"ch":103,"l1":"குற்றம் இலனாய்க் குடிசெய்து வாழ்வானைச்","l2":"சுற்றமாச் சுற்றும் உலகு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"குற்றம் இல்லாதவனாய்க் குடி உயர்வதற்கான செயல் செய்து வாழ்கின்றவனை உலகத்தார் சுற்றமாக விரும்பிச் சூழ்ந்து கொள்வர்.","en":"People will eagerly seek the friendship of the prosperous soul who has raised his family without foul means","lines":[{"t":"குற்றம் இலனாய்க் குடிசெய்து வாழ்வானைச்","err":null,"seers":[{"w":"குற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குற்"},{"k":"N","s":"றம்"}]},{"w":"இலனாய்க்","name":"பு