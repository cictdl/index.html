[{"n":521,"ch":53,"l1":"பற்றற்ற கண்ணும் பழைமைபா ராட்டுதல்","l2":"சுற்றத்தார் கண்ணே உள.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் வறியவனான காலத்திலும் அவனுக்கும் தமக்கும் இருந்த உறவைப் பாராட்டிப் பேசும் பண்புகள் சுற்றத்தாரிடம் உண்டு.","en":"Even when (a man's) property is all gone, relatives will act towards him with their accustomed (kindness)","lines":[{"t":"பற்றற்ற கண்ணும் பழைமைபா ராட்டுதல்","err":null,"seers":[{"w":"பற்றற்ற","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பற்"},{"k":"N","s":"றற்"},{"k":"N","s":"ற"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"பழைமைபா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பழை"},{"k":"N","s":"மை"},{"k":"N","s":"பா"}]},{"w":"ராட்டுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ராட்"},{"k":"I","s":"டுதல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"சுற்றத்தார் கண்ணே உள.","err":null,"seers":[{"w":"சுற்றத்தார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சுற்"},{"k":"N","s":"றத்"},{"k":"N","s":"தார்"}]},{"w":"கண்ணே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணே"}]},{"w":"உள.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"உள"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":522,"ch":53,"l1":"விருப்பறாச் சுற்றம் இயையின் அருப்பறா","l2":"ஆக்கம் பலவும் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அன்பு நீங்காத சுற்றம் ஒருவனுக்குக் கிடைத்தால், அது மேன்மேலும் வளர்ச்சி குறையாத ஆக்கம் பலவற்றையும் அவனுக்குக் கொடுக்கும்.","en":"If (a man's) relatives remain attached to him with unchanging love, it will be a source of everincreasing wealth","lines":[{"t":"விருப்பறாச் சுற்றம் இயையின் அருப்பறா","err":null,"seers":[{"w":"விருப்பறாச்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விருப்"},{"k":"I","s":"பறாச்"}]},{"w":"சுற்றம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சுற்"},{"k":"N","s":"றம்"}]},{"w":"இயையின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இயை"},{"k":"N","s":"யின்"}]},{"w":"அருப்பறா","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அருப்"},{"k":"I","s":"பறா"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆக்கம் பலவும் தரும்.","err":null,"seers":[{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"பலவும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பல"},{"k":"N","s":"வும்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":523,"ch":53,"l1":"அளவளா வில்லாதான் வாழ்க்கை குளவளாக்","l2":"கோடின்றி நீர்நிறைந் தற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"சுற்றத்தாரோடு மனம் கலந்து பழகும் தன்மை இல்லாதவனுடைய வாழ்க்கை, குளப்பரப்பானது கரையில்லாமல் நீர் நிறைந்தாற் போன்றது.","en":"The wealth of one who does not mingle freely with his relatives, will be like the filling of water in a","lines":[{"t":"அளவளா வில்லாதான் வாழ்க்கை குளவளாக்","err":null,"seers":[{"w":"அளவளா","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அள"},{"k":"I","s":"வளா"}]},{"w":"வில்லாதான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வில்"},{"k":"N","s":"லா"},{"k":"N","s":"தான்"}]},{"w":"வாழ்க்கை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாழ்க்"},{"k":"N","s":"கை"}]},{"w":"குளவளாக்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"குள"},{"k":"I","s":"வளாக்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கோடின்றி நீர்நிறைந் தற்று.","err":null,"seers":[{"w":"கோடின்றி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கோ"},{"k":"N","s":"டின்"},{"k":"N","s":"றி"}]},{"w":"நீர்நிறைந்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீர்"},{"k":"I","s":"நிறைந்"}]},{"w":"தற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தற்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":524,"ch":53,"l1":"சுற்றத்தால் சுற்றப் படஒழுகல் செல்வந்தான்","l2":"பெற்றத்தால் பெற்ற பயன்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தக்கவழியில் செய்யப்படாத முயற்சி பலர் துணையாக நின்று(அதை முடிக்குமாறு) காத்த போதிலும் குறையாகிவிடும்.","en":"To live surrounded by relatives, is the advantage to be derived from the acquisition of wealth","lines":[{"t":"சுற்றத்தால் சுற்றப் படஒழுகல் செல்வந்தான்","err":null,"seers":[{"w":"சுற்றத்தால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சுற்"},{"k":"N","s":"றத்"},{"k":"N","s":"தால்"}]},{"w":"சுற்றப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சுற்"},{"k":"N","s":"றப்"}]},{"w":"படஒழுகல்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பட"},{"k":"I","s":"ஒழு"},{"k":"N","s":"கல்"}]},{"w":"செல்வந்தான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வந்"},{"k":"N","s":"தான்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பெற்றத்தால் பெற்ற பயன்.","err":null,"seers":[{"w":"பெற்றத்தால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பெற்"},{"k":"N","s":"றத்"},{"k":"N","s":"தால்"}]},{"w":"பெற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பெற்"},{"k":"N","s":"ற"}]},{"w":"பயன்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பயன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":525,"ch":53,"l1":"கொடுத்தலும் இன்சொலும் ஆற்றின் அடுக்கிய","l2":"சுற்றத்தால் சுற்றப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொருள் கொடுத்தலும் இன்சொல் கூறுதலுமாகிய இரண்டும் செய்யவல்லவனானால் ஒருவன் தொடர்ந்த பலச் சுற்றத்தால் சூழப்படுவான்.","en":"He will be surrounded by numerous relatives who manifests generosity and affability","lines":[{"t":"கொடுத்தலும் இன்சொலும் ஆற்றின் அடுக்கிய","err":null,"seers":[{"w":"கொடுத்தலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கொடுத்"},{"k":"I","s":"தலும்"}]},{"w":"இன்சொலும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இன்"},{"k":"I","s":"சொலும்"}]},{"w":"ஆற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{