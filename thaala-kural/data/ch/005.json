:"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"ஒய்ப்"}]},{"w":"பெறுவ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெறு"},{"k":"N","s":"வ"}]},{"w":"தெவன்?","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தெவன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":47,"ch":5,"l1":"இயல்பினான் இல்வாழ்க்கை வாழ்பவன் என்பான்","l2":"முயல்வாருள் எல்லாம் தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறத்தின் இயல்பொடு இல்வாழ்கை வாழ்கிறவன்- வாழ முயல்கிறவன் பல திறத்தாரிலும் மேம்பட்டு விளங்குகிறவன் ஆவான்.","en":"Among all those who labour (for future happiness) he is greatest who lives well in the household state","lines":[{"t":"இயல்பினான் இல்வாழ்க்கை வாழ்பவன் என்பான்","err":null,"seers":[{"w":"இயல்பினான்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இயல்"},{"k":"I","s":"பினான்"}]},{"w":"இல்வாழ்க்கை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"வாழ்க்"},{"k":"N","s":"கை"}]},{"w":"வாழ்பவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வாழ்"},{"k":"I","s":"பவன்"}]},{"w":"என்பான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"பான்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"முயல்வாருள் எல்லாம் தலை.","err":null,"seers":[{"w":"முயல்வாருள்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முயல்"},{"k":"N","s":"வா"},{"k":"N","s":"ருள்"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":48,"ch":5,"l1":"ஆற்றின் ஒழுக்கி அறனிழுக்கா இல்வாழ்க்கை","l2":"நோற்பாரின் நோன்மை உடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மற்றவரை அறநெறியில் ஒழுகச்செய்து தானும்அறம் தவறாத இல்வாழ்க்கை , தவம் செய்வாரைவிட மிகச்சிறந்த வல்லமை உடைய வாழ்க்கையாகும்.","en":"The householder who, not swerving from virtue, helps the ascetic in his way, endures more than those who endure penance","lines":[{"t":"ஆற்றின் ஒழுக்கி அறனிழுக்கா இல்வாழ்க்கை","err":null,"seers":[{"w":"ஆற்றின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றின்"}]},{"w":"ஒழுக்கி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழுக்"},{"k":"N","s":"கி"}]},{"w":"அறனிழுக்கா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அற"},{"k":"I","s":"னிழுக்"},{"k":"N","s":"கா"}]},{"w":"இல்வாழ்க்கை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"வாழ்க்"},{"k":"N","s":"கை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நோற்பாரின் நோன்மை உடைத்து.","err":null,"seers":[{"w":"நோற்பாரின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நோற்"},{"k":"N","s":"பா"},{"k":"N","s":"ரின்"}]},{"w":"நோன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோன்"},{"k":"N","s":"மை"}]},{"w":"உடைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடைத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":49,"ch":5,"l1":"அறனெனப் பட்டதே இல்வாழ்க்கை அஃதும்","l2":"பிறன்பழிப்ப தில்லாயின் நன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறம் என்று சிறப்பித்து சொல்லப்பட்டது இல்வாழ்க்கையே ஆகும். அதுவும் மற்றவன் பழிக்கும் குற்றம் இல்லாமல் விளங்கினால் மேலும் நன்மையாகும்.","en":"The marriage state is truly called virtue The other state is also good, if others do not reproach it","lines":[{"t":"அறனெனப் பட்டதே இல்வாழ்க்கை அஃதும்","err":null,"seers":[{"w":"அறனெனப்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அற"},{"k":"I","s":"னெனப்"}]},{"w":"பட்டதே","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பட்"},{"k":"I","s":"டதே"}]},{"w":"இல்வாழ்க்கை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"வாழ்க்"},{"k":"N","s":"கை"}]},{"w":"அஃதும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"தும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பிறன்பழிப்ப தில்லாயின் நன்று.","err":null,"seers":[{"w":"பிறன்பழிப்ப","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறன்"},{"k":"I","s":"பழிப்"},{"k":"N","s":"ப"}]},{"w":"தில்லாயின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தில்"},{"k":"N","s":"லா"},{"k":"N","s":"யின்"}]},{"w":"நன்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":50,"ch":5,"l1":"வையத்துள் வாழ்வாங்கு வாழ்பவன் வான்உறையும்","l2":"தெய்வத்துள் வைக்கப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உலகத்தில் வாழவேண்டிய அறநெறியில் நின்று வாழ்கிறவன், வானுலகத்தில் உள்ள தெய்வ முறையில் வைத்து மதிக்கப்படுவான்.","en":"He who on earth has lived in the conjugal state as he should live, will be placed among the Gods who dwell in heaven","lines":[{"t":"வையத்துள் வாழ்வாங்கு வாழ்பவன் வான்உறையும்","err":null,"seers":[{"w":"வையத்துள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வை"},{"k":"N","s":"யத்"},{"k":"N","s":"துள்"}]},{"w":"வாழ்வாங்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வாழ்"},{"k":"N","s":"வாங்"},{"k":"N","s":"கு"}]},{"w":"வாழ்பவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வாழ்"},{"k":"I","s":"பவன்"}]},{"w":"வான்உறையும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"வான்"},{"k":"I","s":"உறை"},{"k":"N","s":"யும்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தெய்வத்துள் வைக்கப் படும்.","err":null,"seers":[{"w":"தெய்வத்துள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தெய்"},{"k":"N","s":"வத்"},{"k":"N","s":"துள்"}]},{"w":"வைக்கப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வைக்"},{"k":"N","s":"கப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]