[{"n":351,"ch":36,"l1":"பொருளல்ல வற்றைப் பொருளென்று உணரும்","l2":"மருளானாம் மாணாப் பிறப்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"மெய்ப்பொருள் அல்லாதவைகளை மெய்ப்பொருள் என்று தவறாக உணர்கின்ற மயக்க உணர்வால் சிறப்பில்லாத துன்பப் பிறவி உண்டாகும்.","en":"Inglorious births are produced by the confusion (of mind) which considers those things to be real which are not real","lines":[{"t":"பொருளல்ல வற்றைப் பொருளென்று உணரும்","err":null,"seers":[{"w":"பொருளல்ல","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளல்"},{"k":"N","s":"ல"}]},{"w":"வற்றைப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வற்"},{"k":"N","s":"றைப்"}]},{"w":"பொருளென்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளென்"},{"k":"N","s":"று"}]},{"w":"உணரும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உண"},{"k":"N","s":"ரும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","கலித்தளை"]},{"t":"மருளானாம் மாணாப் பிறப்பு.","err":null,"seers":[{"w":"மருளானாம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மரு"},{"k":"N","s":"ளா"},{"k":"N","s":"னாம்"}]},{"w":"மாணாப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மா"},{"k":"N","s":"ணாப்"}]},{"w":"பிறப்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிறப்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":352,"ch":36,"l1":"இருள்நீங்கி இன்பம் பயக்கும் மருள்நீங்கி","l2":"மாசறு காட்சி யவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மயக்கம் நீங்கிக் குற்றம் அற்ற மெய்யுணர்வை உடையவர்க்கு, அம் மெய்யுணர்வு அறியாமையை நீக்கி இன்ப நிலையைக்கொடுக்கும்.","en":"A clear, undimmed vision of things will deliver its possessors from the darkness of future births, and confer the felicity (of heaven)","lines":[{"t":"இருள்நீங்கி இன்பம் பயக்கும் மருள்நீங்கி","err":null,"seers":[{"w":"இருள்நீங்கி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இருள்"},{"k":"N","s":"நீங்"},{"k":"N","s":"கி"}]},{"w":"இன்பம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"பம்"}]},{"w":"பயக்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பயக்"},{"k":"N","s":"கும்"}]},{"w":"மருள்நீங்கி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மருள்"},{"k":"N","s":"நீங்"},{"k":"N","s":"கி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மாசறு காட்சி யவர்க்கு.","err":null,"seers":[{"w":"மாசறு","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மா"},{"k":"I","s":"சறு"}]},{"w":"காட்சி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காட்"},{"k":"N","s":"சி"}]},{"w":"யவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"யவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":353,"ch":36,"l1":"ஐயத்தின் நீங்கித் தெளிந்தார்க்கு வையத்தின்","l2":"வானம் நணிய துடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஐயத்திலிருந்து நீங்கி மெய்யுணர்வு பெற்றவர்க்கு அடைந்துள்ள இவ்வுலகை விட அடைய வேண்டிய மேலுலகம் அண்மையில் உள்ளதாகும்.","en":"Heaven is nearer than earth to those men of purified minds who are freed from from doubt","lines":[{"t":"ஐயத்தின் நீங்கித் தெளிந்தார்க்கு வையத்தின்","err":null,"seers":[{"w":"ஐயத்தின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஐ"},{"k":"N","s":"யத்"},{"k":"N","s":"தின்"}]},{"w":"நீங்கித்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீங்"},{"k":"N","s":"கித்"}]},{"w":"தெளிந்தார்க்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தெளிந்"},{"k":"N","s":"தார்க்"},{"k":"N","s":"கு"}]},{"w":"வையத்தின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வை"},{"k":"N","s":"யத்"},{"k":"N","s":"தின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வானம் நணிய துடைத்து.","err":null,"seers":[{"w":"வானம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"னம்"}]},{"w":"நணிய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நணி"},{"k":"N","s":"ய"}]},{"w":"துடைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துடைத்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":354,"ch":36,"l1":"ஐயுணர்வு எய்தியக் கண்ணும் பயமின்றே","l2":"மெய்யுணர்வு இல்லா தவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மெய்யுணர்வு இல்லாதவர்க்கு ஐந்து புலன்களின் வேறுபாட்டால் வளர்ந்த ஐந்து வகை உணர்வும் முற்றப்பெற்ற போதிலும் பயன் இல்லை.","en":"Even those who have all the knowledge which can be attained by the five senses, will derive no benefit from it, if they are without a knowledge of the true nature of things","lines":[{"t":"ஐயுணர்வு எய்தியக் கண்ணும் பயமின்றே","err":null,"seers":[{"w":"ஐயுணர்வு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஐ"},{"k":"I","s":"யுணர்"},{"k":"N","s":"வு"}]},{"w":"எய்தியக்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எய்"},{"k":"I","s":"தியக்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"பயமின்றே","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பய"},{"k":"N","s":"மின்"},{"k":"N","s":"றே"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மெய்யுணர்வு இல்லா தவர்க்கு.","err":null,"seers":[{"w":"மெய்யுணர்வு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மெய்"},{"k":"I","s":"யுணர்"},{"k":"N","s":"வு"}]},{"w":"இல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"}]},{"w":"தவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":355,"ch":36,"l1":"எப்பொருள் எத்தன்மைத் தாயினும் அப்பொருள்","l2":"மெய்ப்பொருள் காண்பது அறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"எப்பொருள் எத்தன்மையதாய்த் தோன்றினாலும் (அத்தோற்றத்தை மட்டும் கண்டுமங்காமல்) அப் பொருளின் உண்மையான இயல்பை அறிவதே மெய்யுணர்வு.","en":"(True) knowledge is the perception concerning every thing of whatever kind, that that thing is the true thing","lines":[{"t":"எப்பொருள் எத்தன்மைத் தாயினும் அப்பொருள்","err":null,"seers":[{"w":"எப்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"எப்"},{"k":"I","s":"பொருள்"}]},{"w":"எத்தன்மைத்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எத்"},{"k":"N","s":"தன்"},{"k":"N","s":"மைத்"}]},{"w":"தாயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தா"},{"k":"I","s":"யினும்"}]},{"w":"அப்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அப்"},{"k":"I","s":"பொருள்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மெய்ப்பொருள் காண்பது அறிவு.","err":null,"seers":[{"w":"மெய்ப்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மெய்ப்"},{"k":"I","s":"பொருள்"}]},{"w":"காண்பது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"காண்"},{"k":"I","s":"பது"}]},{"w":"அறிவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":356,"ch":36,"l1":"கற்றீண்டு மெய்ப்பொருள் கண்டார் தலைப்படுவர்","l2":"மற்றீண்டு வாரா நெறி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கற்க வேண்டிய வற்றைக் கற்று இங்கு மெய்ப் பொருளை உணர்ந்தவர் , மீண்டும் இப்பிறப்பிற்கு வராத வழியை அடைவர்.","en":"They, who in this birth have learned to know the True Being, enter the road which returns not into this world","lines":[{"t":"கற்றீண்டு மெய்ப்பொருள் கண்டார் தலைப்படுவர்","err":null,"seers":[{"w":"கற்றீண்டு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"N","s":"றீண்"},{"k":"N","s":"டு"}]},{"w":"மெய்ப்பொருள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மெய்ப்"},{"k":"I","s":"பொருள்"}]},{"w":"கண்டார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"டார்"}]},{"w":"தலைப்படுவர்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தலைப்"},{"k":"I","s":"படு"},{"k":"N","s":"வர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மற்றீண்டு வாரா நெறி.","err":null,"seers":[{"w":"மற்றீண்டு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றீண்"},{"k":"N","s":"டு"}]},{"w":"வாரா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ரா"}]},{"w":"நெறி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"நெறி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":357,"ch":36,"l1":"ஓர்த்துள்ளம் உள்ளது உணரின் ஒருதலையாப்","l2":"பேர்த்துள்ள வேண்டா பிறப்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒருவனுடைய உள்ளம் உண்மைப் பொருளை ஆராய்ந்து உறுதியாக உணர்ந்தால், அவனுக்கு மீண்டும் பிறப்பு உள்ள தென எண்ண வேண்டா.","en":"Let it not be thought that there is another birth for him whose mind having thoroughly considered (all it has been taught) has known the True Being","lines":[{"t":"ஓர்த்துள்ளம் உள்ளது உணரின் ஒருதலையாப்","err":null,"seers":[{"w":"ஓர்த்துள்ளம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஓர்த்"},{"k":"N","s":"துள்"},{"k":"N","s":"ளம்"}]},{"w":"உள்ளது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளது"}]},{"w":"உணரின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உண"},{"k":"N","s":"ரின்"}]},{"w":"ஒருதலையாப்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒரு"},{"k":"I","s":"தலை"},{"k":"N","s":"யாப்"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"பேர்த்துள்ள வேண்டா பிறப்பு.","err":null,"seers":[{"w":"பேர்த்துள்ள","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பேர்த்"},{"k":"N","s":"துள்"},{"k":"N","s":"ள"}]},{"w":"வேண்டா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டா"}]},{"w":"பிறப்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிறப்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":358,"ch":36,"l1":"பிறப்பென்னும் பேதைமை நீங்கச் சிறப்பென்னும்","l2":"செம்பொருள் காண்பது அறிவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பிறவித்துன்பத்திற்கு காரணமான அறியாமை நீங்குமாறு முக்தி எனும் சிறந்த நிலைக்குக் காரணமான செம் பொருளைக் காண்பதே மெய்யுணர்வு.","en":"True knowledge consists in 