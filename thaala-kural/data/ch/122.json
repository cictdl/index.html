[{"n":1211,"ch":122,"l1":"காதலர் தூதொடு வந்த கனவினுக்கு","l2":"யாதுசெய் வேன்கொல் விருந்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"( யான் பிரிவால் வருந்தி உறங்கியபோது) காதலர் அனுப்பிய தூதோடு வந்த கனவுக்கு உரிய விருந்தாக என்ன செய்து உதவுவேன்?","en":"Where with shall I feast the dream which has brought me my dear one's messenger ?","lines":[{"t":"காதலர் தூதொடு வந்த கனவினுக்கு","err":null,"seers":[{"w":"காதலர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கா"},{"k":"I","s":"தலர்"}]},{"w":"தூதொடு","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தூ"},{"k":"I","s":"தொடு"}]},{"w":"வந்த","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வந்"},{"k":"N","s":"த"}]},{"w":"கனவினுக்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கன"},{"k":"I","s":"வினுக்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"யாதுசெய் வேன்கொல் விருந்து.","err":null,"seers":[{"w":"யாதுசெய்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"துசெய்"}]},{"w":"வேன்கொல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேன்"},{"k":"N","s":"கொல்"}]},{"w":"விருந்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விருந்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1212,"ch":122,"l1":"கயலுண்கண் யானிரப்பத் துஞ்சிற் கலந்தார்க்கு","l2":"உயலுண்மை சாற்றுவேன் மன்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["கலித்தளை"],"mv":"கண்கள் யான் வேண்டுவதுபோல் தூங்குமானால், ( அப்போது வரும் கனவில் காணும்) காதலர்க்கு யான் தப்பிப் பிழைத்திருக்கும்‌ தன்மையைச் சொல்வேன்.","en":"If my fish-like painted eyes should, at my begging, close in sleep, I could fully relate my sufferings to my lord","lines":[{"t":"கயலுண்கண் யானிரப்பத் துஞ்சிற் கலந்தார்க்கு","err":null,"seers":[{"w":"கயலுண்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கய"},{"k":"N","s":"லுண்"},{"k":"N","s":"கண்"}]},{"w":"யானிரப்பத்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"I","s":"னிரப்"},{"k":"N","s":"பத்"}]},{"w":"துஞ்சிற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"துஞ்"},{"k":"N","s":"சிற்"}]},{"w":"கலந்தார்க்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கலந்"},{"k":"N","s":"தார்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உயலுண்மை சாற்றுவேன் மன்.","err":null,"seers":[{"w":"உயலுண்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உய"},{"k":"N","s":"லுண்"},{"k":"N","s":"மை"}]},{"w":"சாற்றுவேன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சாற்"},{"k":"I","s":"றுவேன்"}]},{"w":"மன்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"மன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1213,"ch":122,"l1":"நனவினால் நல்கா தவரைக் கனவினால்","l2":"காண்டலின் உண்டென் உயிர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"நனவில் வந்து அன்பு செய்யாத காதலரைக் கனவில் காண்பதால்தான் என்னுடைய உயிர் இன்னும் நீங்காமல் உள்ளதாகின்றது.","en":"My life lasts because in my dream I behold him who does not favour me in my waking hours","lines":[{"t":"நனவினால் நல்கா தவரைக் கனவினால்","err":null,"seers":[{"w":"நனவினால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நன"},{"k":"I","s":"வினால்"}]},{"w":"நல்கா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நல்"},{"k":"N","s":"கா"}]},{"w":"தவரைக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவ"},{"k":"N","s":"ரைக்"}]},{"w":"கனவினால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கன"},{"k":"I","s":"வினால்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"காண்டலின் உண்டென் உயிர்.","err":null,"seers":[{"w":"காண்டலின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"காண்"},{"k":"I","s":"டலின்"}]},{"w":"உண்டென்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டென்"}]},{"w":"உயிர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"உயிர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1214,"ch":122,"l1":"கனவினான் உண்டாகும் காமம் நனவினான்","l2":"நல