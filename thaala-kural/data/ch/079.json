[{"n":781,"ch":79,"l1":"செயற்கரிய யாவுள நட்பின் அதுபோல்","l2":"வினைக்கரிய யாவுள காப்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நட்பைப்போல் செய்து கொள்வதற்கு அருமையானவை எவை உள்ளன, அதுபோல் தொழிலுக்கு அரிய காவலாக இருப்பவை எவை உள்ளன.","en":"What so sure defence 'gainst all that foe can do?","lines":[{"t":"செயற்கரிய யாவுள நட்பின் அதுபோல்","err":null,"seers":[{"w":"செயற்கரிய","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"செயற்"},{"k":"I","s":"கரி"},{"k":"N","s":"ய"}]},{"w":"யாவுள","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"வுள"}]},{"w":"நட்பின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பின்"}]},{"w":"அதுபோல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அது"},{"k":"N","s":"போல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வினைக்கரிய யாவுள காப்பு.","err":null,"seers":[{"w":"வினைக்கரிய","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வினைக்"},{"k":"I","s":"கரி"},{"k":"N","s":"ய"}]},{"w":"யாவுள","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"வுள"}]},{"w":"காப்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காப்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":782,"ch":79,"l1":"நிறைநீர நீரவர் கேண்மை பிறைமதிப்","l2":"பின்னீர பேதையார் நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறிவுடையவரின் நட்பு பிறை நிறைந்து வருதல் போன்ற தன்மையுடையது, அறிவில்லாதவரின் நட்பு முழுமதி தேய்ந்து பின் செல்லுதல் போன்ற தன்மையுடையன.","en":"The friendship of the wise waxes like the new moon; (but) that of fools wanes like the full moon","lines":[{"t":"நிறைநீர நீரவர் கேண்மை பிறைமதிப்","err":null,"seers":[{"w":"நிறைநீர","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நிறை"},{"k":"N","s":"நீ"},{"k":"N","s":"ர"}]},{"w":"நீரவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீ"},{"k":"I","s":"ரவர்"}]},{"w":"கேண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கேண்"},{"k":"N","s":"மை"}]},{"w":"பிறைமதிப்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பிறை"},{"k":"I","s":"மதிப்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பின்னீர பேதையார் நட்பு.","err":null,"seers":[{"w":"பின்னீர","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பின்"},{"k":"N","s":"னீ"},{"k":"N","s":"ர"}]},{"w":"பேதையார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"யார்"}]},{"w":"நட்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":783,"ch":79,"l1":"நவில்தொறும் நூல்நயம் போலும் பயில்தொறும்","l2":"பண்புடை யாளர் தொடர்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பழகப் பழக நற்பண்பு உடையவரின் நட்பு இன்பம் தருதல், நூலின் நற்பொருள் கற்கக் கற்க மேன்மேலும் இன்பம் தருதலைப் போன்றதாகும்.","en":"Like learning, the friendship of the noble, the more it is cultivated, the more delightful does it become","lines":[{"t":"நவில்தொறும் நூல்நயம் போலும் பயில்தொறும்","err":null,"seers":[{"w":"நவில்தொறும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நவில்"},{"k":"I","s":"தொறும்"}]},{"w":"நூல்நயம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நூல்"},{"k":"I","s":"நயம்"}]},{"w":"போலும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போ"},{"k":"N","s":"லும்"}]},{"w":"பயில்தொறும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பயில்"},{"k":"I","s":"தொறும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பண்புடை யாளர் தொடர்பு.","err":null,"seers":[{"w":"பண்புடை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பண்"},{"k":"I","s":"புடை"}]},{"w":"யாளர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"ளர்"}]},{"w":"தொடர்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தொடர்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":784,"ch":79,"l1":"நகுதற் பொருட்டன்று நட்டல் மிகுதிக்கண்","l2":"மேற்செனறு இடித்தற் பொருட்டு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"நட்புச் செய்தல் ஒருவரோடு ஒருவர் சிரித்து மகிழும் பொருட்டு அன்று, நண்பர் நெறிக்கடந்து செல்லும் போது முற்ப்பட்டுச் சென்று இடித்துரைப்பதற்காகும்.","en":"Friendship is to be practised not for the purpose of laughing but for that of being beforehand in giving one another sharp rebukes in case of transgression","lines":[{"t":"நகுதற் பொருட்டன்று நட்டல் மிகுதிக்கண்","err":null,"seers":[{"w":"நகுதற்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நகு"},{"k":"N","s":"தற்"}]},{"w":"பொருட்டன்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பொருட்"},{"k":"N","s":"டன்"},{"k":"N","s":"று"}]},{"w":"நட்டல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"டல்"}]},{"w":"மிகுதிக்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மிகு"},{"k":"N","s":"திக்"},{"k":"N","s":"கண்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மேற்செனறு இடித்தற் பொருட்டு.","err":null,"seers":[{"w":"மேற்செனறு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மேற்"},{"k":"I","s":"சென"},{"k":"N","s":"று"}]},{"w":"இடித்தற்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடித்"},{"k":"N","s":"தற்"}]},{"w":"பொருட்டு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொருட்"},{"k":"N","s":"டு"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":785,"ch":79,"l1":"புணர்ச்சி பழகுதல் வேண்டா உணர்ச்சிதான்","l2":"நட்பாங் கிழமை தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"நட்புச் செய்வதற்குத் தொடர்பும் பழக்கமும் வேண்டியதில்லை, ஒத்த உணர்ச்சியே நட்பு ஏற்படுத்துவதற்கு வேண்டிய உரிமையைக் கொடுக்கும்.","en":"Living together and holding frequent intercourse are not necessary (for friendship); (mutual) understanding can alone create a claim for it","lines":[{"t":"புணர்ச்சி பழகுதல் வேண்டா உணர்ச்சிதான்","err":null,"seers":[{"w":"புணர்ச்சி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"புணர்ச்"},{"k":"N","s":"சி"}]},{"w":"பழகுதல்","name"