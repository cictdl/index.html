[{"n":31,"ch":4,"l1":"சிறப்புஈனும் செல்வமும் ஈனும் அறத்தினூஉங்கு","l2":"ஆக்கம் எவனோ உயிர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":[null],"mv":"அறம் சிறப்பையும் அளிக்கும்: செல்வத்தையும் அளிக்கும்: ஆகையால் உயிர்க்கு அத்தகைய அறத்தை விட நன்மையானது வேறு யாது?","en":"Virtue will confer heaven and wealth; what greater source of happiness can man possess ?","lines":[{"t":"சிறப்புஈனும் செல்வமும் ஈனும் அறத்தினூஉங்கு","err":null,"seers":[{"w":"சிறப்புஈனும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறப்"},{"k":"I","s":"புஈ"},{"k":"N","s":"னும்"}]},{"w":"செல்வமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செல்"},{"k":"I","s":"வமும்"}]},{"w":"ஈனும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"னும்"}]},{"w":"அறத்தினூஉங்கு","name":"கருவிளந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"அறத்"},{"k":"I","s":"தினூ"},{"k":"N","s":"உங்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆக்கம் எவனோ உயிர்க்கு.","err":null,"seers":[{"w":"ஆக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கம்"}]},{"w":"எவனோ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"எவ"},{"k":"N","s":"னோ"}]},{"w":"உயிர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயிர்க்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":32,"ch":4,"l1":"அறத்தினூஉங்கு ஆக்கமும் இல்லை அதனை","l2":"மறத்தலின் ஊங்கில்லை கேடு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒரு வருடைய வாழ்கைக்கு அறத்தை விட நன்மையானதும் இல்லை: அறத்தை போற்றாமல் மறப்பதை விடக்கொடியதும் இல்லை.","en":"There can be no greater source of good than (the practice of) virtue; there can be no greater source of evil than the forgetfulness of it","lines":[{"t":"அறத்தினூஉங்கு ஆக்கமும் இல்லை அதனை","err":null,"seers":[{"w":"அறத்தினூஉங்கு","name":"கருவிளந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"அறத்"},{"k":"I","s":"தினூ"},{"k":"N","s":"உங்"},{"k":"N","s":"கு"}]},{"w":"ஆக்கமும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆக்"},{"k":"I","s":"கமும்"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"அதனை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அத"},{"k":"N","s":"னை"}]}],"thalai":[null,"இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மறத்தலின் ஊங்கில்லை கேடு.","err":null,"seers":[{"w":"மறத்தலின்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மறத்"},{"k":"I","s":"தலின்"}]},{"w":"ஊங்கில்லை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஊங்"},{"k":"N","s":"கில்"},{"k":"N","s":"லை"}]},{"w":"கேடு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கே"},{"k":"N","s":"டு"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":33,"ch":4,"l1":"ஒல்லும் வகையான் அறவினை ஓவாதே","l2":"செல்லும்வாய் எல்லாஞ் செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"செய்யக்கூடிய வகையால், எக்காரணத்தாலும் விடாமல் செல்லுமிடமெல்லாம் அறச்செயலைப் போற்றிச் செய்ய வேண்டும்.","en":"As much as possible, in every way, incessantly practise virtue","lines":[{"t":"ஒல்லும் வகையான் அறவினை ஓவாதே","err":null,"seers":[{"w":"ஒல்லும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒல்"},{"k":"N","s":"லும்"}]},{"w":"வகையான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வகை"},{"k":"N","s":"யான்"}]},{"w":"அறவினை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அற"},{"k":"I","s":"வினை"}]},{"w":"ஓவாதே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஓ"},{"k":"N","s":"வா"},{"k":"N","s":"தே"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செல்லும்வாய் எல்லாஞ் செயல்.","err":null,"seers":[{"w":"செல்லும்வாய்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"லும்"},{"k":"N","s":"வாய்"}]},{"w":"எல்லாஞ்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாஞ்"}]},{"w":"செயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":34,"ch":4,"l1":"மனத்துக்கண் மாசிலன் ஆதல் அனைத்தறன்","l2":"ஆகுல நீர பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் தன்மனதில் குற்றம் இல்லாதவானாக இருக்க வேண்டும். அறம் அவ்வளவே: மனத்தூய்மை இல்லாத மற்றவை ஆரவாரத் தன்மை உடையவை.","en":"Let him who does virtuous deeds be of spotless mind; to that extent is virtue; all else is vain show","lines":[{"t":"மனத்துக்கண் மாசிலன் ஆதல் அனைத்தறன்","err":null,"seers":[{"w":"மனத்துக்கண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மனத்"},{"k":"N","s":"துக்"},{"k":"N","s":"கண்"}]},{"w":"மாசிலன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மா"},{"k":"I","s":"சிலன்"}]},{"w":"ஆதல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"தல்"}]},{"w":"அனைத்தறன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அனைத்"},{"k":"I","s":"தறன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆகுல நீர பிற.","err":null,"seers":[{"w":"ஆகுல","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"குல"}]},{"w":"நீர","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீ"},{"k":"N","s":"ர"}]},{"w":"பிற.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பிற"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":35,"ch":4,"l1":"அழுக்காறு அவாவெகுளி இன்னாச்சொல் நான்கும்","l2":"இழுக்கா இயன்றது அறம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொறாமை, ஆசை, சினம், கடுஞ்சொல் ஆகிய இந்த நான்கு குற்றங்களுக்கும் இடங்கொடுக்காமல் அவற்றைக் கடித்து ஒழுகுவதே அறமாகும்.","en":"That conduct is virtue which is free from these four things, viz, malice, desire, anger and bitter speech","lines":[{"t":"அழுக்காறு அவாவெகுளி இன்னாச்சொல் நான்கும்","err":null,"seers":[{"w":"அழுக்காறு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அழுக்"},{"k":"N","s":"கா"},{"k":"N","s":"று"}]},{"w":"அவாவெகுளி","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அவா"},{"k":"I","s":"வெகு"},{"k":"N","s":"ளி"}]},{"w":"இன்னாச்சொல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னாச்"},{"k":"N","s":"சொல்"}]},{"w":"நான்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நான்"},{"k":"N","s":"கும்"}]}],"thalai":["கலித்தளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"இழுக்கா இயன்றது அறம்.","err":null,"seers":[{"w":"இழுக்கா","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"கா"}]},{"w":"இயன்றது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இயன்"},{"k":"I","s":"றது"}]},{"w":"அறம்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அறம்"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":36,"ch":4,"l1":"அன்றறிவாம் என்னாது அறஞ்செய்க மற்றது","l2":"பொன்றுங்கால் பொன்றாத் துணை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இளைஞராக உள்ளவர், பிற்காலத்தில் பார்த்து கொள்ளலாம் என்று எண்ணாமல் அறம் செய்ய வேண்டும். அதுவே உடல் அழியும் காலத்தில் அழியா துணையாகும்.","en":"Defer not virtue to another day; receive her now; and at the dying hour she will be your undying friend","lines":[{"t":"அன்றறிவாம் என்னாது அறஞ்செய்க மற்றது","err":null,"seers":[{"w":"அன்றறிவாம்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"அன்"},{"k":"I","s":"றறி"},{"k":"N","s":"வாம்"}]},{"w":"என்னாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"N","s":"னா"},{"k":"N","s":"து"}]},{"w":"அறஞ்செய்க","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறஞ்"},{"k":"N","s":"செய்"},{"k":"N","s":"க"}]},{"w":"மற்றது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மற்"},{"k":"I","s":"றது"}]}],"thalai":["வெண்சீர் வெண்டளை","கலித்தளை","வெண்சீர் வெண்டளை"]},{"t":"பொன்றுங்கால் பொன்றாத் துணை.","err":null,"seers":[{"w":"பொன்றுங்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொன்"},{"k":"N","s":"றுங்"},{"k":"N","s":"கால்"}]},{"w":"பொன்றாத்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பொன்"},{"k":"N","s":"றாத்"}]},{"w":"துணை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"துணை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":37,"ch":4,"l1":"அறத்தாறு இதுவென வேண்டா சிவிகை","l2":"பொறுத்தானோடு ஊர்ந்தான் இடை."