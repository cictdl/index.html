[{"n":701,"ch":71,"l1":"கூறாமை நோக்கக் குறிப்பறிவான் எஞ்ஞான்றும்","l2":"மாறாநீர் வையக் கணி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஓருவர் சொல்லாமலே அவறுடைய முகத்தை நோக்கி அவர் கருதிய குறிப்பை அறிகின்றவன் எப்போதும் உலகத்திற்க்கு ஓர் அணிகலன் ஆவான்.","en":"The minister who by looking (at the king) understands his mind without being told (of it), will be a perpetual ornament to the world which is surrounded by a never-drying sea","lines":[{"t":"கூறாமை நோக்கக் குறிப்பறிவான் எஞ்ஞான்றும்","err":null,"seers":[{"w":"கூறாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கூ"},{"k":"N","s":"றா"},{"k":"N","s":"மை"}]},{"w":"நோக்கக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோக்"},{"k":"N","s":"கக்"}]},{"w":"குறிப்பறிவான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குறிப்"},{"k":"I","s":"பறி"},{"k":"N","s":"வான்"}]},{"w":"எஞ்ஞான்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எஞ்"},{"k":"N","s":"ஞான்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"மாறாநீர் வையக் கணி.","err":null,"seers":[{"w":"மாறாநீர்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மா"},{"k":"N","s":"றா"},{"k":"N","s":"நீர்"}]},{"w":"வையக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வை"},{"k":"N","s":"யக்"}]},{"w":"கணி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கணி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":702,"ch":71,"l1":"ஐயப் படாஅது அகத்தது உணர்வானைத்","l2":"தெய்வத்தோ டொப்பக் கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஐயப்படாமல் மனத்தில் உள்ளதை உணரவல்லவனை (அவன் மனிதனே ஆனாலும்) தெய்வத் தோடு ஒப்பாக கொள்ள வேண்டும்.","en":"He is to be esteemed a god who is able to ascertain without a doubt what is within (one's mind)","lines":[{"t":"ஐயப் படாஅது அகத்தது உணர்வானைத்","err":null,"seers":[{"w":"ஐயப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஐ"},{"k":"N","s":"யப்"}]},{"w":"படாஅது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"படா"},{"k":"I","s":"அது"}]},{"w":"அகத்தது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அகத்"},{"k":"I","s":"தது"}]},{"w":"உணர்வானைத்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உணர்"},{"k":"N","s":"வா"},{"k":"N","s":"னைத்"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","நிரையொன்றிய ஆசிரியத்தளை"]},{"t":"தெய்வத்தோ டொப்பக் கொளல்.","err":null,"seers":[{"w":"தெய்வத்தோ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தெய்"},{"k":"N","s":"வத்"},{"k":"N","s":"தோ"}]},{"w":"டொப்பக்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டொப்"},{"k":"N","s":"பக்"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":703,"ch":71,"l1":"குறிப்பிற் குறிப்புணர் வாரை உறுப்பினுள்","l2":"யாது கொடுத்தும் கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"(முகம் கண் இவற்றின்) குறிப்புக்களால் உள்ள குறிப்பை உணர வல்லவரை நாட்டின் உறுப்புக்களுள் எதைக் கொடுத்தாவது துணையாக பெற்றுக்கொள்ள வேண்டும்.","en":"The king should ever give whatever (is asked) of his belongings and secure him who, by the indications (of his own mind) is able to read those of another","lines":[{"t":"குறிப்பிற் குறிப்புணர் வாரை உறுப்பினுள்","err":null,"seers":[{"w":"குறிப்பிற்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குறிப்"},{"k":"N","s":"பிற்"}]},{"w":"குறிப்புணர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"குறிப்"},{"k":"I","s":"புணர்"}]},{"w":"வாரை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ரை"}]},{"w":"உறுப்பினுள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உறுப்"},{"k":"I","s":"பினுள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"யாது கொடுத்தும் கொளல்.","err":null,"seers":[{"w":"யாது","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"து"}]},{"w":"கொடுத்தும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கொடுத்"},{"k":"N","s":"தும்"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":704,"ch":71,"l1":"குறித்தது கூறாமைக் கொள்வாரோ டேனை","l2":"உறுப்போ ரனையரால் வேறு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் மனதில் கருதியதை அவன் கூறாமலே அறிந்து கொள்ள வல்லவரோடு மற்றவர் உறுப்பால் ஒத்தவராக இருந்தாலும் அறிவால் வேறுபட்டவர் ஆவார்.","en":"Those who understand one's thoughts without being informed (thereof) and those who do not, may (indeed) resemble one another bodily; still are they different (mentally)","lines":[{"t":"குறித்தது கூறாமைக் கொள்வாரோ டேனை","err":null,"seers":[{"w":"குறித்தது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"குறித்"},{"k":"I","s":"தது"}]},{"w":"கூறாமைக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கூ"},{"k":"N","s":"றா"},{"k":"N","s":"மைக்"}]},{"w":"கொள்வாரோ","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"வா"},{"k":"N","s":"ரோ"}]},{"w":"டேனை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டே"},{"k":"N","s":"னை"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"உறுப்போ ரனையரால் வேறு.","err":null,"seers":[{"w":"உறுப்போ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உறுப்"},{"k":"N","s":"போ"}]},{"w":"ரனையரால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"ரனை"},{"k":"I","s":"யரால்"}]},{"w":"வேறு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வே"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":705,"ch":71,"l1":"குறிப்பிற் குறிப்புணரா வாயின் உறுப்பினுள்","l2":"என்ன பயத்தவோ கண்?","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"(முகம் கண் இவற்றின்) குறிப்புக்களால் உள்ளக்குறிப்பை உணராவிட்டால், ஒருவனுடைய உறுப்புகளுள் கண்கள் என்னப் பயன்படும்.","en":"Of what use are the eyes amongst one's members, if they cannot by their own indications dive those of another ?","lines":[{"t":"குறிப்பிற் குறிப்புணரா வாயின் உறுப்பினுள்","err":null,"seers":[{"w":"குறிப்பிற்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குறிப்"},{"k":"N","s":"பிற்"}]},{"w":"குறிப்புணரா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"குறிப்"},{"k":"I","s":"புண"},{"k":"N","s":"ரா"}]},{"w":"வாயின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"யின்"}]},{"w":"உறுப்பினுள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உறுப்"},{"k":"I","s":"பினுள்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"என்ன பயத்தவோ கண்?","err":null,"seers":[{"w":"என்ன","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"ன"}]},{"w":"பயத்தவோ","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பயத்"},{"k":"I","s":"தவோ"}]},{"w":"கண்?","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கண்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":706,"ch":71,"l1":"அடுத்தது காட்டும் பளிங்குபோல் நெஞ்சம்","l2":"கடுத்தது காட்டும் முகம்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தன்னை அடுத்தப் பொருளைத் தன்னிடம் காட்டும் பளிங்கு போல், ஒருவனுடைய நெஞ்சில் மிகுந்துள்ளதை அவனுடைய முகம் காட்டும்.","en":"As the mirror reflects what is near so does the face show what is uppermost in the mind","lines":[{"t":"அடுத்தது காட்டும் பளிங்குபோல் நெஞ்சம்","err":null,"seers":[{"w":"அடுத்தது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அடுத்"},{"k":"I","s":"தது"}]},{"w":"காட்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காட்"},{"k":"N","s":"டும்"}]},{"w":"பளிங்குபோல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பளிங்"},{"k":"I","s":"குபோல்"}]},{"w":"நெஞ்சம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கடுத்தது காட்டும் முகம்.","err":null,"seers":[{"w":"கடுத்தது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கடுத்"},{"k":"I","s":"தது"}]},{"w":"காட்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"காட்"},{"k":"N","s":"டும்"}]},{"w":"முகம்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"முகம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":707,"ch":71,"l1":"முகத்தின் முதுக்குறைந்தது உண்டோ உவப்பினும்","l2":"காயினும் தான்முந் துறும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் விருப்பம் கொண்டாலும், வெறுப்புக் கொண்டாலும் அவனுடைய முகம் முற்ப்பட்டு அதைத் தெரிவிக்கும், அம் முகத்தைவிட அறிவு மிக்கது உண்டோ.","en":"Is there anything so full of knowledge as the face ? (No) it precedes the mind, whether (the latter is) pleased or vexed","lines":[{"t":"முகத்தின் முதுக்குறைந்தது உண்டோ உவப்பினும்","err":null,"seers":[{"w":"முகத்தின்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முகத்"},{"k":"N","s":"தின்"}]},{"w":"முதுக்குறைந்தது","name":"கருவிளங்கனி","cls":"கனி","a":[{"k":"I","s":"முதுக்"},{"k":"I","s":"குறைந்"},{"k":"I","s":"தது"}]},{"w":"உண்டோ","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உண்"},{"k":"N","s":"டோ"}]},{"w":"உவப்பினும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உவப்"},{"k":"I","s":"பினும்"}]}],"thalai":["இயற்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]},{"t":"காயினும் தான்முந் துறும்.","err":null,"seers":[{"w":"காயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கா"},{"k":"I","s":"யினும்"}]},{"w":"தான்முந்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தான்"},{"k":"N","s":"முந்"}]},{"w":"துறும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"துறும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":708,"ch":71,"l1":"முகம்நோக்கி நிற்க அமையும் அகம்நோக்கி","l2":"உற்ற துணர்வார்ப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உள்ளக் குறிப்பை நோக்கி உற்றதை உணரவல்லவரைப் பெற்றால், (அவரிடம் எதையும் கூறாமல்) அவறுடைய முகத்தை நோக்கி நின்றால் போதும்.","en":"If the king gets those who by looking into his mind can understand (and remove) what has occurred (to him) it is enough that he stand looking at their face","lines":[{"t":"முகம்நோக்கி நிற்க அமையும் அகம்நோக்கி","err":null,"seers":[{"w":"முகம்நோக்கி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முகம்"},{"k":"N","s":"நோக்"},{"k":"N","s":"கி"}]},{"w":"நிற்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நிற்"},{"k":"N","s":"க"}]},{"w":"அமையும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அமை"},{"k":"N","s":"யும்"}]},{"w":"அகம்நோக்கி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அகம்"},{"k":"N","s":"நோக்"},{"k":"N","s":"கி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உற்ற துணர்வார்ப் பெறின்.","err":null,"seers":[{"w":"உற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உற்"},{"k":"N","s":"ற"}]},{"w":"துணர்வார்ப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துணர்"},{"k":"N","s":"வார்ப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":709,"ch":71,"l1":"பகைமையும் கேண்மையும் கண்ணுரைக்கும் கண்ணின்","l2":"வகைமை உணர்வார்ப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கண்பார்வையின் வேறுபாடுகளை உணரவல்லவரைப் பெற்றால்( ஒருவனுடைய மனதில் உள்ள) கையையும் நட்பையும் அவனுடைய கண்களே சொல்லி விடும்.","en":"If a king gets ministers who can read the movements of the eye, the eyes (of foreign kings) will (themselves) reveal (to him) their hatred or friendship","lines":[{"t":"பகைமையும் கேண்மையும் கண்ணுரைக்கும் கண்ணின்","err":null,"seers":[{"w":"பகைமையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பகை"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"கேண்மையும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கேண்"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"கண்ணுரைக்கும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"I","s":"ணுரைக்"},{"k":"N","s":"கும்"}]},{"w":"கண்ணின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வகைமை உணர்வார்ப் பெறின்.","err":null,"seers":[{"w":"வகைமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"வகை"},{"k":"N","s":"மை"}]},{"w":"உணர்வார்ப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உணர்"},{"k":"N","s":"வார்ப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":710,"ch":71,"l1":"நுண்ணியம் என்பார் அளக்குங்கோல் காணுங்கால்","l2":"கண்ணல்லது இல்லை பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"யாம் நுட்பமான அறிவுடையேம் என்று பிறர் கருத்தை அறிபவரின் அளக்குங்கோல், ஆராய்ந்து பார்த்தால் அவனுடையக் கண்களே அல்லாமல் வேறு இல்லை.","en":"The measuring-rod of those (ministers) who say \"we are acute\" will on inquiry be found to be their (own) eyes and nothing else","lines":[{"t":"நுண்ணியம் என்பார் அளக்குங்கோல் காணுங்கால்","err":null,"seers":[{"w":"நுண்ணியம்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நுண்"},{"k":"I","s":"ணியம்"}]},{"w":"என்பார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"பார்"}]},{"w":"அளக்குங்கோல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அளக்"},{"k":"N","s":"குங்"},{"k":"N","s":"கோல்"}]},{"w":"காணுங்கால்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கா"},{"k":"N","s":"ணுங்"},{"k":"N","s":"கால்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கண்ணல்லது இல்லை பிற.","err":null,"seers":[{"w":"கண்ணல்லது","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணல்"},{"k":"I","s":"லது"}]},{"w":"இல்லை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லை"}]},{"w":"பிற.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பிற"}]}],"thalai":["ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]}]}]