[{"n":291,"ch":30,"l1":"வாய்மை எனப்படுவது யாதெனின் யாதொன்றும்","l2":"தீமை இலாத சொலல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வாய்மை என்று கூறப்படுவது எது என்றால், அது மற்றவர்க்கு ஒரு சிறிதும் தீங்கு இல்லாத சொற்களைக் சொல்லுதல் ஆகும்.","en":"Truth is the speaking of such words as are free from the least degree of evil (to others)","lines":[{"t":"வாய்மை எனப்படுவது யாதெனின் யாதொன்றும்","err":null,"seers":[{"w":"வாய்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாய்"},{"k":"N","s":"மை"}]},{"w":"எனப்படுவது","name":"கருவிளங்கனி","cls":"கனி","a":[{"k":"I","s":"எனப்"},{"k":"I","s":"படு"},{"k":"I","s":"வது"}]},{"w":"யாதெனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தெனின்"}]},{"w":"யாதொன்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"யா"},{"k":"N","s":"தொன்"},{"k":"N","s":"றும்"}]}],"thalai":["இயற்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]},{"t":"தீமை இலாத சொலல்.","err":null,"seers":[{"w":"தீமை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"மை"}]},{"w":"இலாத","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இலா"},{"k":"N","s":"த"}]},{"w":"சொலல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"சொலல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":292,"ch":30,"l1":"பொய்மையும் வாய்மை யிடத்த புரைதீர்ந்த","l2":"நன்மை பயக்கும் எனின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"குற்றம் தீர்த்த நன்மையை விளைக்குமானால் பொய்யாச் சொற்களும் வாய்மை என்று கருதத் தக்க இடத்தைப் பெறும்.","en":"Even falsehood has the nature of truth, if it confer a benefit that is free from fault","lines":[{"t":"பொய்மையும் வாய்மை யிடத்த புரைதீர்ந்த","err":null,"seers":[{"w":"பொய்மையும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பொய்"},{"k":"N","s":"மை"},{"k":"N","s":"யும்"}]},{"w":"வாய்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வாய்"},{"k":"N","s":"மை"}]},{"w":"யிடத்த","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"யிடத்"},{"k":"N","s":"த"}]},{"w"