[{"n":731,"ch":74,"l1":"தள்ளா விளையுளும் தக்காரும் தாழ்விலாச்","l2":"செல்வரும் சேர்வது நாடு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"குறையாத விளைபொருளும் தக்க அறிஞரும் கேடில்லாத செல்வம் உடையவரும் கூடிப் பொருந்தியுள்ள நாடே நாடாகும்.","en":"A kingdom is that in which (those who carry on) a complete cultivation, virtuous persons, and","lines":[{"t":"தள்ளா விளையுளும் தக்காரும் தாழ்விலாச்","err":null,"seers":[{"w":"தள்ளா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தள்"},{"k":"N","s":"ளா"}]},{"w":"விளையுளும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விளை"},{"k":"I","s":"யுளும்"}]},{"w":"தக்காரும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தக்"},{"k":"N","s":"கா"},{"k":"N","s":"ரும்"}]},{"w":"தாழ்விலாச்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தாழ்"},{"k":"I","s":"விலாச்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"செல்வரும் சேர்வது நாடு.","err":null,"seers":[{"w":"செல்வரும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செல்"},{"k":"I","s":"வரும்"}]},{"w":"சேர்வது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சேர்"},{"k":"I","s":"வது"}]},{"w":"நாடு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":732,"ch":74,"l1":"பெரும்பொருளால் பெட்டக்க தாகி அருங்கேட்டால்","l2":"ஆற்ற விளைவது நாடு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மிக்க பொருள் வளம் உடையதாய், எல்லோரும் விரும்பத்தக்கதாய் கேடு இல்லாததாய், மிகுதியாக விளைபொருள் தருவதே நாடாகும்.","en":"A kingdom is that which is desire for its immense wealth, and which grows greatly in prosperity, being free from destructive causes","lines":[{"t":"பெரும்பொருளால் பெட்டக்க தாகி அருங்கேட்டால்","err":null,"seers":[{"w":"பெரும்பொருளால்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பெரும்"},{"k":"I","s":"பொரு"},{"k":"N","s":"ளால்"}]},{"w":"பெட்டக்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பெட்"},{"k":"N","s":"டக்"},{"k":"N","s":"க"}]},{"w":"தாகி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"கி"}]},{"w":"அருங்கேட்டால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அருங்"},{"k":"N","s":"கேட்"},{"k":"N","s":"டால்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆற்ற விளைவது நாடு.","err":null,"seers":[{"w":"ஆற்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"ற"}]},{"w":"விளைவது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விளை"},{"k":"I","s":"வது"}]},{"w":"நாடு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":733,"ch":74,"l1":"பொறையொருங்கு மேல்வருங்கால் தாங்கி இறைவற்கு","l2":"இறையொருங்கு நேர்வது நாடு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["கலித்தளை"],"mv":"(மற்ற நாட்டு மக்கள் குடியேறுவதால்) சுமை ஒரு சேரத் தன் மேல் வரும் போது தாங்கி, அரசனுக்கு இறைபொருள் முழுதும் தர வல்லது நாடாகும்.","en":"A kingdom is that which can bear any burden that may be pressed on it (from adjoining kingdoms) and (yet) pay the full tribute to its sovereign","lines":[{"t":"பொறையொருங்கு மேல்வருங்கால் தாங்கி இறைவற்கு","err":null,"seers":[{"w":"பொறையொருங்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பொறை"},{"k":"I","s":"யொருங்"},{"k":"N","s":"கு"}]},{"w":"மேல்வருங்கால்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மேல்"},{"k":"I","s":"வருங்"},{"k":"N","s":"கால்"}]},{"w":"தாங்கி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தாங்"},{"k":"N","s":"கி"}]},{"w":"இறைவற்கு","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இறை"},{"k":"N","s":"வற்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இறையொருங்கு நேர்வது நாடு.","err":null,"seers":[{"w":"இறையொருங்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இறை"},{"k":"I","s":"யொருங்"},{"k":"N","s":"கு"}]},{"w":"நேர்வது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நேர்"},{"k":"I","s":"வது"}]},{"w":"நாடு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":734,"ch":74,"l1":"உறுபசியும் ஓவாப் பிணியும் செறுபகையும்","l2":"சேரா தியல்வது நாடு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"மிக்க பசியும், ஓயாத நோயும் (வெளியே வந்து தாக்கி) அழிவு செய்யும் பகையும் தன்னிடம் சேராமல் நல்ல வகையில் நடைபெறுவதே நாடாகும்.","en":"A kingdom is that which continues to be free from excessive starvation, irremediable epidemics, and destructive foes","lines":[{"t":"உறுபசியும் ஓவாப் பிணியும் செறுபகையும்","err":null,"seers":[{"w":"உறுபசியும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உறு"},{"k":"I","s":"பசி"},{"k":"N","s":"யும்"}]},{"w":"ஓவாப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஓ"},{"k":"N","s":"வாப்"}]},{"w":"பிணியும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிணி"},{"k":"N","s":"யும்"}]},{"w":"செறுபகையும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"செறு"},{"k":"I","s":"பகை"},{"k":"N","s":"யும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சேரா தியல்வது நாடு.","err":null,"seers":[{"w":"சேரா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சே"},{"k":"N","s":"ரா"}]},{"w":"தியல்வது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"தியல்"},{"k":"I","s":"வது"}]},{"w":"நாடு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":735,"ch":74,"l1":"பல்குழுவும் பாழ்செய்யும் உட்பகையும் வேந்தலைக்கும்","l2":"கொல்குறும்பும் இல்லது நாடு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பல வகை மாறுபடும் கூட்டங்களும், உடனிருந்தே அழிவு செய்யும் பகையும், அரசனை வருத்துகின்ற கொலைத் தொழில் பொருந்திய குறுநில மன்னரும் இல்லாதது நாடு.","en":"A kingdom is that which is without various (irregular) associations, destructive internal enemies, and murderous savages who (sometimes) harass the sovereign","lines":[{"t":"பல்குழுவும் பாழ்