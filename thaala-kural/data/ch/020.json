[{"n":191,"ch":20,"l1":"பல்லார் முனியப் பயனில சொல்லுவான்","l2":"எல்லாரும் எள்ளப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கேட்டவர் பலரும் வெறுக்கும் படியாகப் பயனில்லாத சொற்களைச் சொல்லுகின்றவன், எல்லாராலும் இகழப்படுவான்","en":"He who to the disgust of many speaks useless things will be despised by all","lines":[{"t":"பல்லார் முனியப் பயனில சொல்லுவான்","err":null,"seers":[{"w":"பல்லார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பல்"},{"k":"N","s":"லார்"}]},{"w":"முனியப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முனி"},{"k":"N","s":"யப்"}]},{"w":"பயனில","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பய"},{"k":"I","s":"னில"}]},{"w":"சொல்லுவான்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லுவான்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எல்லாரும் எள்ளப் படும்.","err":null,"seers":[{"w":"எல்லாரும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லா"},{"k":"N","s":"ரும்"}]},{"w":"எள்ளப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எள்"},{"k":"N","s":"ளப்"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":192,"ch":20,"l1":"பயனில பல்லார்முன் சொல்லல் நயனில","l2":"நட்டார்கண் செய்தலிற் றீது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பலர் முன்னே பயனில்லாத சொற்களைச் சொல்லுதல், நண்பரிடத்தில் அறம் இல்லா செயல்களைச் செய்தலை விடத் தீமையானதாகும்.","en":"To speak useless things in the presence of many is a greater evil than to do unkind things towards friends","lines":[{"t":"பயனில பல்லார்முன் சொல்லல் நயனில","err":null,"seers":[{"w":"பயனில","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பய"},{"k":"I","s":"னில"}]},{"w":"பல்லார்முன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பல்"},{"k":"N","s":"லார்"},{"k":"N","s":"முன்"}]},{"w":"சொல்லல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லல்"}]},{"w":"நயனில","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நய"},{"k":"I","s":"னில"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நட்டார்கண் செய்தலிற் றீது.","err":null,"seers":[{"w":"நட்டார்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நட்"},{"k":"N","s":"டார்"},{"k":"N","s":"கண்"}]},{"w":"செய்தலிற்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"தலிற்"}]},{"w":"றீது.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றீ"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":193,"ch":20,"l1":"நயனிலன் என்பது சொல்லும் பயனில","l2":"பாரித் துரைக்கும் உரை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"ஒருவன் பயனில்லா பொருள்களைப் பற்றி விரிவாகச் சொல்லும் சொற்கள், அவன் அறம் இல்லாதவன் என்பதை அறிவிக்கும்.","en":"That conversation in which a man utters forth useless things will say of him \"he is without virtue.\"","lines":[{"t":"நயனிலன் என்பது சொல்லும் பயனில","err":null,"seers":[{"w":"நயனிலன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நய"},{"k":"I","s":"னிலன்"}]},{"w":"என்பது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பது"}]},{"w":"சொல்லும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லும்"}]},{"w":"பயனில","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பய"},{"k":"I","s":"னில"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பாரித் துரைக்கும் உரை.","err":null,"seers":[{"w":"பாரித்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பா"},{"k":"N","s":"ரித்"}]},{"w":"துரைக்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"துரைக்"},{"k":"N","s":"கும்"}]},{"w":"உரை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"உரை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":194,"ch":20,"l1":"நயன்சாரா நன்மையின் நீக்கும் பயன்சாராப்","l2":"பண்பில்சொல் பல்லா ரகத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"பயனோடு பொருந்தாத பண்பு இல்லாத சொற்களைப் பலரிடத்தும் சொல்லுதல், அறத்தோடு பொருந்தாமல் நன்மையிலிருந்து நீங்கச் செய்யும்.","en":"The words devoid of profit or pleasure which a man speaks will, being inconsistent with virtue,","lines":[{"t":"நயன்சாரா நன்மையின் நீக்கும் பயன்சாராப்","err":null,"seers":[{"w":"நயன்சாரா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நயன்"},{"k":"N","s":"சா"},{"k":"N","s":"ரா"}]},{"w":"நன்மையின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நன்"},{"k":"N","s":"மை"},{"k":"N","s":"யின்"}]},{"w":"நீக்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீக்"},{"k":"N","s":"கும்"}]},{"w":"பயன்சாராப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பயன்"},{"k":"N","s":"சா"},{"k":"N","s":"ராப்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பண்பில்சொல் பல்லா ரகத்து.","err":null,"seers":[{"w":"பண்பில்சொல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பண்"},{"k":"N","s":"பில்"},{"k":"N","s":"சொல்"}]},{"w":"பல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பல்"},{"k":"N","s":"லா"}]},{"w":"ரகத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ரகத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":195,"ch":20,"l1":"சீர்மை சிறப்பொடு நீங்கும் பயனில","l2":"நீர்மை யுடையார் சொலின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பயனில்லாத சொற்களை நல்ல பண்பு உடையவர் சொல்லுவாரானால், அவனுடைய மேம்பாடு அவர்க்குரிய மதிப்போடு நீங்கிவிடும்.","en":"If the good speak vain words their eminence and excellence will leave them","lines":[{"t":"சீர்மை சிறப்பொடு நீங்கும் பயனில","err":null,"seers":[{"w":"சீர்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சீர்"},{"k":"N","s":"மை"}]},{"w":"சிறப்பொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"சிறப்"},{"k":"I","s":"பொடு"}]},{"w":"நீங்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீங்"},{"k":"N","s":"கும்"}]},{"w":"பயனில","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பய"},{"k":"I","s":"னில"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நீர்மை யுடையார் சொலின்.","err":null,"seers":[{"w":"நீர்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீர்"},{"k":"N","s":"மை"}]},{"w":"யுடையார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"யுடை"},{"k":"N","s":"யார்"}]},{"w":"சொலின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"சொலின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":196,"ch":20,"l1":"பயனில்சொல் பாராட்டு வானை மகன்எனல்","l2":"மக்கட் பதடி யெனல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பயனில்லாத சொற்களைப் பலமுறையும் சொல்லுகின்ற ஒருவனை மனிதன் என்று சொல்லக்கூடாது, மக்களுள் பதர் என்று சொல்லவேண்டும்.","en":"Call not him a man who parades forth his empty words Call him the chaff of men","lines":[{"t":"பயனில்சொல் பாராட்டு வானை மகன்எனல்","err":null,"seers":[{"w":"பயனில்சொல்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பய"},{"k":"N","s":"னில்"},{"k":"N","s":"சொல்"}]},{"w":"பாராட்டு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பா"},{"k":"N","s":"ராட்"},{"k":"N","s":"டு"}]},{"w":"வானை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"னை"}]},{"w":"மகன்எனல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"மகன்"},{"k":"I","s":"எனல்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மக்கட் பதடி யெனல்.","err":null,"seers":[{"w":"மக்கட்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மக்"},{"k":"N","s":"கட்"}]},{"w":"பதடி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பத"},{"k":"N","s":"டி"}]},{"w":"யெனல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"யெனல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":197,"ch":20,"l1":"நயனில சொல்லினுஞ் சொல்லுக சான்றோர்","l2":"பயனில சொல்லாமை நன்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறம் இல்லாதவற்றைச் சொன்னாலும் சொல்லலாம், சான்றோர் பயன் இல்லாத சொற்களைச் சொல்லாமல் இருத்தல் நன்மையாகும்.","en":"Let the wise if they will, speak things without excellence; it will be well for them