[{"n":141,"ch":15,"l1":"பிறன்பொருளாள் பெட்டொழுகும் பேதைமை ஞாலத்து","l2":"அறம்பொருள் கண்டார்கண் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["கலித்தளை"],"mv":"பிறனுடைய உரிமையாகிய மனைவியை விரும்பி நடக்கும் அறியாமை, உலகத்தில் அறமும் பொருளும் ஆராய்ந்து கண்டவரிடம் இல்லை.","en":"The folly of desiring her who is the property of another will not be found in those who know (the attributes of) virtue and (the rights of) property","lines":[{"t":"பிறன்பொருளாள் பெட்டொழுகும் பேதைமை ஞாலத்து","err":null,"seers":[{"w":"பிறன்பொருளாள்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"பிறன்"},{"k":"I","s":"பொரு"},{"k":"N","s":"ளாள்"}]},{"w":"பெட்டொழுகும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பெட்"},{"k":"I","s":"டொழு"},{"k":"N","s":"கும்"}]},{"w":"பேதைமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"மை"}]},{"w":"ஞாலத்து","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஞா"},{"k":"N","s":"லத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அறம்பொருள் கண்டார்கண் இல்.","err":null,"seers":[{"w":"அறம்பொருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறம்"},{"k":"I","s":"பொருள்"}]},{"w":"கண்டார்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கண்"},{"k":"N","s":"டார்"},{"k":"N","s":"கண்"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":142,"ch":15,"l1":"அறன்கடை நின்றாருள் எல்லாம் பிறன்கடை","l2":"நின்றாரின் பேதையார் இல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறத்தை விட்டுத் தீநெறியில் நின்றவர் எல்லாரிலும் பிறன் மனைவியை விரும்பி அவனுடைய வாயிலில் சென்று நின்றவரைப் போல் அறிவிலிகள் இல்லை.","en":"Among all those who stand on the outside of virtue, there are no greater fools than those who stand outside their neighbour's door","lines":[{"t":"அறன்கடை நின்றாருள் எல்லாம் பிறன்கடை","err":null,"seers":[{"w":"அறன்கடை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறன்"},{"k":"I","s":"கடை"}]},{"w":"நின்றாருள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நின்"},{"k":"N","s":"றா"},{"k":"N","s":"ருள்"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"பிறன்கடை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பிறன்"},{"k":"I","s":"கடை"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நின்றாரின் பேதையார் இல்.","err":null,"seers":[{"w":"நின்றாரின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நின்"},{"k":"N","s":"றா"},{"k":"N","s":"ரின்"}]},{"w":"பேதையார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"தை"},{"k":"N","s":"யார்"}]},{"w":"இல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"இல்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":143,"ch":15,"l1":"விளிந்தாரின் வேறல்லர் மன்ற தெளிந்தாரில்","l2":"தீமை புரிந்து ஒழுகு வார்.","ok":true,"reseg":true,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஐயமில்லாமல் தெளிந்து நம்பியவருடைய மனைவியிடத்தே விருப்பம் கொண்டு தீமையைச் செய்து நடப்பவர், செத்தவரை விட வேறுபட்டவர் அல்லர்.","en":"Certainly they are no better than dead men who desire evil towards the wife of those who","lines":[{"t":"விளிந்தாரின் வேறல்லர் மன்ற தெளிந்தாரில்","err":null,"seers":[{"w":"விளிந்தாரின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விளிந்"},{"k":"N","s":"தா"},{"k":"N","s":"ரின்"}]},{"w":"வேறல்லர்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வே"},{"k":"N","s":"றல்"},{"k":"N","s":"லர்"}]},{"w":"மன்ற","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மன்"},{"k":"N","s":"ற"}]},{"w":"தெளிந்தாரில்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தெளிந்"},{"k":"N","s":"தா"},{"k":"N","s":"ரில்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தீமை புரிந்து ஒழுகு வார்.","err":null,"seers":[{"w":"தீமை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தீ"},{"k":"N","s":"மை"}]},{"w":"புரிந்தொழுகு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"புரிந்"},{"k":"I","s":"தொழு"},{"k":"N","s":"கு"}]},{"w":"வார்","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"வார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":144,"ch":15,"l1":"எனைத்துணையர் ஆயினும் என்னாம் தினைத்துணையும்","l2":"தேரான் பிறனில் புகல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தினையளவும் ஆராய்ந்து பார்க்காமல் பிறனுடைய மனைவியிடம் செல்லுதல், எவ்வளவு பெருமையை உடையவராயினும் என்னவாக முடியும்?","en":"However great one may be, what does it avail if, without at all considering his guilt, he goes unto the wife of another ?","lines":[{"t":"எனைத்துணையர் ஆயினும் என்னாம் தினைத்துணையும்","err":null,"seers":[{"w":"எனைத்துணையர்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"எனைத்"},{"k":"I","s":"துணை"},{"k":"N","s":"யர்"}]},{"w":"ஆயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"யினும்"}]},{"w":"என்னாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னாம்"}]},{"w":"தினைத்துணையும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"தினைத்"},{"k":"I","s":"துணை"},{"k":"N","s":"யும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"தேரான் பிறனில் புகல்.","err":null,"seers":[{"w":"தேரான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தே"},{"k":"N","s":"ரான்"}]},{"w":"பிறனில்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிற"},{"k":"N","s":"னில்"}]},{"w":"புகல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"புகல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":145,"ch":15,"l1":"எளிதென இல்லிறப்பான் எய்துமெஞ் ஞான்றும்","l2":"விளியாது நிற்கும் பழி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இச்செயல் எளியது என எண்ணிப் பிறனுடைய மனைவியிடம் நெறி தவறிச் செல்கின்றவன், ‌எப்போதும் அழியாமல் நிலைநிற்கும் பழியை அடைவான்","en":"He who thinks lightly of going into the wife of another acquires guilt that will abide with him imperishably and for ever","lines":[{"t":"எளிதென இல்ல