[{"n":551,"ch":56,"l1":"கொலைமேற்கொண் டாரிற் கொடிதே அலைமேற்கொண்டு","l2":"அல்லவை செய்தொழுகும் வேந்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":[null],"mv":"குடிகளை வருத்தும் தொழிலை மேற்கொண்டு, முறையல்லாத செயல்களைச் செய்து நடக்கும் அரசன் கொலைத் தொழிலைக் கொண்டவரை விடக் கொடியவன்.","en":"The king who gives himself up to oppression and acts unjustly (towards his subjects) is more cruel than the man who leads the life of a murderer","lines":[{"t":"கொலைமேற்கொண் டாரிற் கொடிதே அலைமேற்கொண்டு","err":null,"seers":[{"w":"கொலைமேற்கொண்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கொலை"},{"k":"N","s":"மேற்"},{"k":"N","s":"கொண்"}]},{"w":"டாரிற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"டா"},{"k":"N","s":"ரிற்"}]},{"w":"கொடிதே","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கொடி"},{"k":"N","s":"தே"}]},{"w":"அலைமேற்கொண்டு","name":"புளிமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"I","s":"அலை"},{"k":"N","s":"மேற்"},{"k":"N","s":"கொண்"},{"k":"N","s":"டு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"அல்லவை செய்தொழுகும் வேந்து.","err":null,"seers":[{"w":"அல்லவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"அல்"},{"k":"I","s":"லவை"}]},{"w":"செய்தொழுகும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"I","s":"தொழு"},{"k":"N","s":"கும்"}]},{"w":"வேந்து.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":552,"ch":56,"l1":"வேலொடு நின்றான் இடுவென் றதுபோலும்","l2":"கோலொடு நின்றான் இரவு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஆட்சிக்குறிய கோலை ஏந்தி நின்ற அரசன் குடிகளைப் பொருள் கேட்டல் , போகும் வழியில் கள்வன் கொடு என்று கேட்பதைப் போன்றது.","en":"The request (for money) of him who holds the sceptre is like the word of a highway robber who stands with a weapon in hand and says \"give up your wealth\"","lines":[{"t":"வேலொடு நின்றான் இடுவென் றதுபோலும்","err":null,"seers":[{"w":"வேலொடு","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வே"},{"k":"I","s":"லொடு"}]},{"w":"நின்றான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நின்"},{"k":"N","s":"றான்"}]},{"w":"இடுவென்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடு"},{"k":"N","s":"வென்"}]},{"w":"றதுபோலும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"றது"},{"k":"N","s":"போ"},{"k":"N","s":"லும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கோலொடு நின்றான் இரவு.","err":null,"seers":[{"w":"கோலொடு","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கோ"},{"k":"I","s":"லொடு"}]},{"w":"நின்றான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நின்"},{"k":"N","s":"றான்"}]},{"w":"இரவு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இர"},{"k":"N","s":"வு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":553,"ch":56,"l1":"நாடொறும் நாடி முறைசெய்யா மன்னவன்","l2":"நாடொறும் நாடு கெடும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"நாள் தோறும் தன் ஆட்சியில் நன்மை தீமைகளை ஆராய்ந்து முறைசெய்யாத அரசன், நாள் தோறும் (மெல்ல மெல்லத்) தன் நாட்டை இழந்து வருவான்.","en":"The country of the king who does not daily examine into the wrongs done and distribute justice, will daily fall to ruin","lines":[{"t":"நாடொறும் நாடி முறைசெய்யா மன்னவன்","err":null,"seers":[{"w":"நாடொறும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நா"},{"k":"I","s":"டொறும்"}]},{"w":"நாடி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டி"}]},{"w":"முறைசெய்யா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முறை"},{"k":"N","s":"செய்"},{"k":"N","s":"யா"}]},{"w":"மன்னவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னவன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நாடொறும் நாடு கெடும்.","err":null,"seers":[{"w":"நாடொறும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நா"},{"k":"I","s":"டொறும்"}]},{"w":"நாடு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"டு"}]},{"w":"கெடும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கெடும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":554,"ch":56,"l1":"கூழுங் குடியும் ஒருங்கிழக்கும் கோல்கோடிச்","l2":"சூழாது செய்யும் அரசு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"(ஆட்சிமுறை கெட்டுக்) கொடுங்கோலனாகி ஆராயாமல் எதையும் செய்யும் அரசன், பொருளையும் குடிகளையும் ஒரு சேர இழந்து விடுவான்.","en":"The king, who, without reflecting (on its evil consequences), perverts justice, will lose at once both his wealth and his subjects","lines":[{"t":"கூழுங் குடியும் ஒருங்கிழக்கும் கோல்கோடிச்","err":null,"seers":[{"w":"கூழுங்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கூ"},{"k":"N","s":"ழுங்"}]},{"w":"குடியும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குடி"},{"k":"N","s":"யும்"}]},{"w":"ஒருங்கிழக்கும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"ஒருங்"},{"k":"I","s":"கிழக்"},{"k":"N","s":"கும்"}]},{"w":"கோல்கோடிச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கோல்"},{"k":"N","s":"கோ"},{"k":"N","s":"டிச்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"சூழாது செய்யும் அரசு.","err":null,"seers":[{"w":"சூழாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சூ"},{"k":"N","s":"ழா"},{"k":"N","s":"து"}]},{"w":"செய்யும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யும்"}]},{"w":"அரசு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அர"},{"k":"N","s":"சு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":555,"ch":56,"l1":"அல்லற்பட்டு ஆற்றாது அழுதகண் ணீரன்றே","l2":"செல்வத்தைத் தேய்க்கும் படை","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"(முறை செய்யாதவனுடைய) செல்வத்தைத் தேய்த்து அழிக்க வல்ல படை அவனால் பலர் துன்பப்பட்டுத் துன்பம் பொறுக்க முடியாமல் அழுத கண்ணீர் அன்றோ.","en":"Will not the tears, shed by a people who cannot endure the oppression which they suffer (from their king), become a saw to waste away his wealth ?","lines":[{"t":"அல்லற்பட்டு ஆற்றாது அழுதகண் ணீரன்றே","err":null,"seers":[{"w":"அல்லற்பட்டு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"அல்"},{"k":"N","s":"லற்"},{"k":"N","s":"பட்"},{"k":"N","s":"டு"}]},{"w":"ஆற்றாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றா"},{"k":"N","s":"து"}]},{"w":"அழுதகண்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அழு"},{"k":"I","s":"தகண்"}]},{"w":"ணீரன்றே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ணீ"},{"k":"N","s":"ரன்"},{"k":"N","s":"றே"}]}],"thalai":[null,"கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"செல்வத்தைத் தேய்க்கும் படை","err":null,"seers":[{"w":"செல்வத்தைத்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செல்"},{"k":"N","s":"வத்"},{"k":"N","s":"தைத்"}]},{"w":"தேய்க்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தேய்க்"},{"k":"N","s":"கும்"}]},{"w":"படை","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படை"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":556,"ch":56,"l1":"மன்னர்க்கு மன்னுதல் செங்கோன்மை அஃதின்றேல்","l2":"மன்னாவாம் மன்னர்க் கொளி.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அரசர்க்கு புகழ் நிலைபெறக் காரணம் செங்கோல் முறையாகும், அஃது இல்லையானால் அரசர்க்கு புகழ் நிலைபெறாமல் போகும்.","en":"Righteous government gives permanence to (the fame of) kings; without that their fame will have no endurance","lines":[{"t":"மன்னர்க்கு மன்னுதல் செங்கோன்மை அஃதின்றேல்","err":null,"seers":[{"w":"மன்னர்க்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மன்"},{"k":"N","s":"னர்க்"},{"k":"N","s":"கு"}]},{"w":"மன்னுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னுதல்"}]},{"w":"செங்கோன்மை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செங்"},{"k":"N","s":"கோன்"},{"k":"N","s":"மை"}]},{"w":"அஃதின்றேல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அஃ"},{"k":"N","s":"தின்"},{"k":"N","s":"றேல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"மன்னாவாம் மன்னர்க் கொளி.","err":null,"seers":[{"w":"மன்னாவாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மன்"},{"k":"N","s":"னா"},{"k":"N","s":"வாம்"}]},{"w":"மன்னர்க்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மன்"},{"k":"N","s":"னர்க்"}]},{"w":"கொளி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":557,"ch":56,"l1":"துளியின்மை ஞாலத்திற்கு எற்றற்றே வேந்தன்","l2":"அளியின்மை வாழும் உயிர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"மழைத்துளி இல்லாதிருத்தல் உலகத்திற்கு எத்தன்மையானதோ, அத்தன்மையானது நாட்டில் வாழும் குடிமக்களுக்கு அரசனுடைய அருள் இல்லாத ஆட்சி.","en":"As is the world without rain, so live a people whose king is without kindness","lines":[{"t":"துளியின்மை ஞாலத்திற்கு எற்றற்றே வேந்தன்","err":null,"seers":[{"w":"துளியின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"துளி"},{"k":"N","s":"யின்"},{"k":"N","s":"மை"}]},{"w":"ஞாலத்திற்கு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"ஞா"},{"k":"N","s":"லத்"},{"k":"N","s":"திற்"},{"k":"N","s":"கு"}]},{"w":"எற்றற்றே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எற்"},{"k":"N","s":"றற்"},{"k":"N","s":"றே"}]},{"w":"வேந்தன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"தன்"}]}],"thalai":["வெண்சீர் வெண்டளை",null,"வெண்சீர் வெண்டளை"]},{"t":"அளியின்மை வாழும் உயிர்க்கு.","err":null,"seers":[{"w":"அளியின்மை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அளி"},{"k":"N","s":"யின்"},{"k":"N","s":"மை"}]},{"w":"வாழும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"ழும்"}]},{"w":"உயிர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உயிர்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":558,"ch":56,"l1":"இன்மையின் இன்னாது உடைமை முறைசெய்யா","l2":"மன்னவன் கோற்கீழ்ப் படின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"முறை செய்யாத அரசனுடைய கொடுங்கோல் ஆட்சியின் கீழ் இருக்கப் பெற்றால், பொருள் இல்லாத வறுமை நிலையைவிடச் செல்வநிலை துன்பமானதாகும்.","en":"Property gives more sorrow than poverty, to those who live under the sceptre of a king without justice","lines":[{"t":"இன்மையின் இன்னாது உடைமை முறைசெய்யா","err":null,"seers":[{"w":"இன்மையின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"},{"k":"N","s":"யின்"}]},{"w":"இன்னாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"N","s":"து"}]},{"w":"உடைமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"மை"}]},{"w":"முறைசெய்யா","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முறை"},{"k":"N","s":"செய்"},{"k":"N","s":"யா"}]}],"thalai":["வெண்சீர் வெண்டளை","கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"மன்னவன் கோற்கீழ்ப் படின்.","err":null,"seers":[{"w":"மன்னவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னவன்"}]},{"w":"கோற்கீழ்ப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கோற்"},{"k":"N","s":"கீழ்ப்"}]},{"w":"படின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":559,"ch":56,"l1":"முறைகோடி மன்னவன் செய்யின் உறைகோடி","l2":"ஒல்லாது வானம் பெயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"அரசன் முறை தவறி நாட்டை ஆட்சி செய்வானானால், அந்த நாட்டில் பருவமழை தவறி மேகம் மழை பெய்யாமல் போகும்.","en":"If the king acts contrary to justice, rain will become unseasonable, and the heavens will withhold their showers","lines":[{"t":"முறைகோடி மன்னவன் செய்யின் உறைகோடி","err":null,"seers":[{"w":"முறைகோடி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"முறை"},{"k":"N","s":"கோ"},{"k":"N","s":"டி"}]},{"w":"மன்னவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மன்"},{"k":"I","s":"னவன்"}]},{"w":"செய்யின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யின்"}]},{"w":"உறைகோடி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உறை"},{"k":"N","s":"கோ"},{"k":"N","s":"டி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஒல்லாது வானம் பெயல்.","err":null,"seers":[{"w":"ஒல்லாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒல்"},{"k":"N","s":"லா"},{"k":"N","s":"து"}]},{"w":"வானம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வா"},{"k":"N","s":"னம்"}]},{"w":"பெயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெயல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":560,"ch":56,"l1":"ஆபயன் குன்றும் அறுதொழிலோர் நூல்மறப்பர்","l2":"காவலன் காவான் எனின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நாட்டைக் காக்கும் தலைவன் முறைப்படி காக்காவிட்டால், அந் நாட்டில் பசுக்கள் பால் தருதலாகிய பயன் குன்றும், அந்தணரும் அறநூல்களை மறப்பர்.","en":"If the guardian (of the country) neglects to guard it, the produce of the cows will fail, and the men of six duties viz, the Brahmins will forget the vedas","lines":[{"t":"ஆபயன் குன்றும் அறுதொழிலோர் நூல்மறப்பர்","err":null,"seers":[{"w":"ஆபயன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆ"},{"k":"I","s":"பயன்"}]},{"w":"குன்றும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"குன்"},{"k":"N","s":"றும்"}]},{"w":"அறுதொழிலோர்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறு"},{"k":"I","s":"தொழி"},{"k":"N","s":"லோர்"}]},{"w":"நூல்மறப்பர்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"நூல்"},{"k":"I","s":"மறப்"},{"k":"N","s":"பர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"காவலன் காவான் எனின்.","err":null,"seers":[{"w":"காவலன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கா"},{"k":"I","s":"வலன்"}]},{"w":"காவான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"வான்"}]},{"w":"எனின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"எனின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]