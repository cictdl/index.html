[{"n":741,"ch":75,"l1":"ஆற்று பவர்க்கும் அரண்பொருள் அஞ்சித்தற்","l2":"போற்று பவர்க்கும் பொருள்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"(படையெடுத்தும்) போர் செய்யச் செல்பவர்க்கும் அரண் சிறந்ததாகும், (படையெடுத்தவர்க்கு) அஞ்சித் தன்னை புகழிடமாக அடைந்தவர்க்கும் அது சிறந்ததாகும்.","en":"A fort is an object of importance to those who march (against their foes) as well as to those who through fear (of pursuers) would seek it for shelter","lines":[{"t":"ஆற்று பவர்க்கும் அரண்பொருள் அஞ்சித்தற்","err":null,"seers":[{"w":"ஆற்று","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"று"}]},{"w":"பவர்க்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பவர்க்"},{"k":"N","s":"கும்"}]},{"w":"அரண்பொருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அரண்"},{"k":"I","s":"பொருள்"}]},{"w":"அஞ்சித்தற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சித்"},{"k":"N","s":"தற்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"போற்று பவர்க்கும் பொருள்.","err":null,"seers":[{"w":"போற்று","name":"தேமா","cls":"மா","a":[{"k":"N","s":"போற்"},{"k":"N","s":"று"}]},{"w":"பவர்க்கும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பவர்க்"},{"k":"N","s":"கும்"}]},{"w":"பொருள்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பொருள்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":742,"ch":75,"l1":"மணிநீரும் மண்ணும் மலையும் அணிநிழற்","l2":"காடும் உடைய தரண்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மணிபோல் தெளிந்த நீரும், வெட்ட வெளியான நிலமும், மலையும், அழகிய நிழல் உடைய காடும் ஆகிய இவை நான்கும் உள்ளதே அரண் ஆகும்.","en":"A fort is that which has everlasting water, plains, mountains and cool shady forests","lines":[{"t":"மணிநீரும் மண்ணும் மலையும் அணிநிழற்","err":null,"seers":[{"w":"மணிநீரும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மணி"},{"k":"N","s":"நீ"},{"k":"N","s":"ரும்"}]},{"w":"மண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மண்"},{"k":"N","s":"ணும்"}]},{"w":"மலையும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"மலை"},{"k":"N","s":"யும்"}]},{"w":"அணிநிழற்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அணி"},{"k":"I","s":"நிழற்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"காடும் உடைய தரண்.","err":null,"seers":[{"w":"காடும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கா"},{"k":"N","s":"டும்"}]},{"w":"உடைய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"ய"}]},{"w":"தரண்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரண்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":743,"ch":75,"l1":"உயர்வகலம் திண்மை அருமைஇந் நான்கின்","l2":"அமைவரண் என்றுரைக்கும் நூல்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"உயரம், அகலம், உறுதி, பகைவரால் அழிக்க முடியாத அருமை ஆகிய இந்த நான்கும் அமைந்திப்பதே அரண் என்று நூலோர் கூறுவர்.","en":"The learned say that a fortress is an enclosure having these four (qualities) viz, height, breadth, strength and inaccessibility","lines":[{"t":"உயர்வகலம் திண்மை அருமைஇந் நான்கின்","err":null,"seers":[{"w":"உயர்வகலம்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"உயர்"},{"k":"I","s":"வக"},{"k":"N","s":"லம்"}]},{"w":"திண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"திண்"},{"k":"N","s":"மை"}]},{"w":"அருமைஇந்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அரு"},{"k":"N","s":"மை"},{"k":"N","s":"இந்"}]},{"w":"நான்கின்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நான்"},{"k":"N","s":"கின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அமைவரண் என்றுரைக்கும் நூல்.","err":null,"seers":[{"w":"அமைவரண்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அமை"},{"k":"I","s":"வரண்"}]},{"w":"என்றுரைக்கும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"என்"},{"k":"I","s":"றுரைக்"},{"k":"N","s":"கும்"}]},{"w":"நூல்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"நூல்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":744,"ch":75,"l1":"சிறுகாப்பிற் பேரிடத்த தாகி உறுபகை","l2":"ஊக்கம் அழிப்ப தரண்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"காக்க வேண்டிய இடம் சிறியதாய், மற்ற இடம் பெரிய பரப்புள்ளதாய், தன்னை எதிர்த்துவந்த பகைவரிருடைய ஊக்கத்தை அழிக்க வல்லது அரண் ஆகும்.","en":"A fort is that which has an extensive space within, but only small places to be guarded, and such as can destroy the courage of besieging foes","lines":[{"t":"சிறுகாப்பிற் பேரிடத்த தாகி உறுபகை","err":null,"seers":[{"w":"சிறுகாப்பிற்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சிறு"},{"k":"N","s":"காப்"},{"k":"N","s":"பிற்"}]},{"w":"பேரிடத்த","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"I","s":"ரிடத்"},{"k":"N","s":"த"}]},{"w":"தாகி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"கி"}]},{"w":"உறுபகை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உறு"},{"k":"I","s":"பகை"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஊக்கம் அழிப்ப தரண்.","err":null,"seers":[{"w":"ஊக்கம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊக்"},{"k":"N","s":"கம்"}]},{"w":"அழிப்ப","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அழிப்"},{"k":"N","s":"ப"}]},{"w":"தரண்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரண்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":745,"ch":75,"l1":"கொளற்கரிதாய்க் கொண்டகூழ்த் தாகி அகத்தார்","l2":"நிலைக்கெளிதாம் நீரது அரண்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"பகைவரால் கைப்பற்ற முடியாததாய், தன்னிடம் உணவுபொருள் கொண்டதாய், உள்ளிருப்போர் நிலைத்திருப்பதர்க்கு எளிதாகிய தன்மை உடையது அரண்.","en":"A fort is that which cannot be captured, which abounds in suitable provisions, and affords a position of easy defence to its inmates","lines":[{"t":"கொளற்கரிதாய்க் கொண்டகூழ்த் தாகி அகத்தார்","err":null,"seers":[{"w":"கொளற்கரிதாய்க்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கொளற்"},{"k":"I","s":"கரி"},{"k":"N","s":"தாய்க்"}]},{"w":"கொண்டகூழ்த்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கொண்"},{"k":"I","s":"டகூழ்த்"}]},{"w":"தாகி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தா"},{"k":"N","s":"கி"}]},{"w":"அகத்தார்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அகத்"},{"k":"N","s":"தார்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நிலைக்கெளிதாம் நீரது அரண்.","err":null,"seers":[{"w":"நிலைக்கெளிதாம்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நிலைக்"},{"k":"I","s":"கெளி"},{"k":"N","s":"தாம்"}]},{"w":"நீரது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நீ"},{"k":"I","s":"ரது"}]},{"w":"அரண்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அரண்"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":746,"ch":75,"l1":"எல்லாப் பொருளும் உடைத்தாய் இடத்துதவும்","l2":"நல்லாள் உடையது அரண்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தன்னிடம் (உள்ளவர்க்கு) எல்லாப் பொருளும் உடையதாய், போர் நெருக்கடியானவிடத்தில் உதவ வல்ல நல்ல விரர்களை உடையது அரண் ஆகும்.","en":"A fort is that which has all (needful) things, and excellent heroes that can help it against destruction (by foes)","lines":[{"t":"எல்லாப் பொருளும் உடைத்தாய் இடத்துதவும்","err":null,"seers":[{"w":"எல்லாப்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாப்"}]},{"w":"பொருளும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பொரு"},{"k":"N","s":"ளும்"}]},{"w":"உடைத்தாய்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடைத்"},{"k":"N","s":"தாய்"}]},{"w":"இடத்துதவும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"இடத்"},{"k":"I","s":"துத"},{"k":"N","s":"வும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நல்லாள் உடையது அரண்.","err":null,"seers":[{"w":"நல்லாள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நல்"},{"k":"N","s":"லாள்"}]},{"w":"உடையது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உடை"},{"k":"I","s":"யது"}]},{"w":"அரண்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அரண்"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":747,"ch":75,"l1":"முற்றியும் முற்றா தெறிந்தும் அறைப்படுத்தும்","l2":"பற்றற் கரியது அரண்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"முற்றுகையிட்டும் முற்றுகையிடாமல் போர் செய்தும், வஞ்சனை செய்தும் எப்படியும் பகைவரால் கைப்பற்ற முடியாத அருமை உடையது அரண் ஆகும்.","en":"A fort is that which cannot be captured by blockading, assaulting, or undermining it","lines":[{"t":"முற்றியும் முற்றா தெறிந்தும் அறைப்படுத்தும்","err":null,"seers":[{"w":"முற்றியும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"முற்"},{"k":"I","s":"றியும்"}]},{"w":"முற்றா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"முற்"},{"k":"N","s":"றா"}]},{"w":"தெறிந்தும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தெறிந்"},{"k":"N","s":"தும்"}]},{"w":"அறைப்படுத்தும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அறைப்"},{"k":"I","s":"படுத்"},{"k":"N","s":"தும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பற்றற் கரியது அரண்.","err":null,"seers":[{"w":"பற்றற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பற்"},{"k":"N","s":"றற்"}]},{"w":"கரியது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கரி"},{"k":"I","s":"யது"}]},{"w":"அரண்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அரண்"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":748,"ch":75,"l1":"முற்றாற்றி முற்றி யவரையும் பற்றாற்றிப்","l2":"பற்றியார் வெல்வது அரண்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"முற்றுகையிடுவதில் வல்லமை கொண்டு முற்றுகை இட்டவரையும், (உள்ளிருந்தவர் பற்றிய) பற்றை விடாமலிருந்து வெல்வதற்கு உரியது அரண் ஆகும்.","en":"That is a fort whose inmates are able to overcome without losing their ground, even abler men who have besieged it","lines":[{"t":"முற்றாற்றி முற்றி யவரையும் பற்றாற்றிப்","err":null,"seers":[{"w":"முற்றாற்றி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"முற்"},{"k":"N","s":"றாற்"},{"k":"N","s":"றி"}]},{"w":"முற்றி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"முற்"},{"k":"N","s":"றி"}]},{"w":"யவரையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"யவ"},{"k":"N","s":"ரை"},{"k":"N","s":"யும்"}]},{"w":"பற்றாற்றிப்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பற்"},{"k":"N","s":"றாற்"},{"k":"N","s":"றிப்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பற்றியார் வெல்வது அரண்.","err":null,"seers":[{"w":"பற்றியார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"பற்"},{"k":"I","s":"றியார்"}]},{"w":"வெல்வது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"வெல்"},{"k":"I","s":"வது"}]},{"w":"அரண்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அரண்"}]}],"thalai":["இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]},{"n":749,"ch":75,"l1":"முனைமுகத்து மாற்றலர் சாய வினைமுகத்து","l2":"வீறெய்தி மாண்ட தரண்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"போர் முனையில் பகைவர் அழியும் படியாக (உள்ளிருந்தவர்செய்யும்) போர்ச் செயல்வகையால் பெருமைப் பெற்றுச் சிறப்புடையதாய் விளங்குவது அரண் ஆகும்.","en":"A fort is that which derives excellence from the stratagems made (by its inmates) to defeat their enemies in the battlefield","lines":[{"t":"முனைமுகத்து மாற்றலர் சாய வினைமுகத்து","err":null,"seers":[{"w":"முனைமுகத்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"முனை"},{"k":"I","s":"முகத்"},{"k":"N","s":"து"}]},{"w":"மாற்றலர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மாற்"},{"k":"I","s":"றலர்"}]},{"w":"சாய","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சா"},{"k":"N","s":"ய"}]},{"w":"வினைமுகத்து","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"வினை"},{"k":"I","s":"முகத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"வீறெய்தி மாண்ட தரண்.","err":null,"seers":[{"w":"வீறெய்தி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வீ"},{"k":"N","s":"றெய்"},{"k":"N","s":"தி"}]},{"w":"மாண்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மாண்"},{"k":"N","s":"ட"}]},{"w":"தரண்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரண்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":750,"ch":75,"l1":"எனைமாட்சித் தாகியக் கண்ணும் வினைமாட்சி","l2":"இல்லார்கண் இல்லது அரண்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"எத்தகைய பெருமையை உடையதாக இருந்த போதிலும், செயல்வகையால் சிறப்பு இல்லாதவரரிடத்தில் அரண் பயனில்லாததாகும். பொருள் செயல்வகை","en":"Although a fort may possess all (the above-said) excellence, it is, as it were without these, if its inmates possess not the excellence of action","lines":[{"t":"எனைமாட்சித் தாகியக் கண்ணும் வினைமாட்சி","err":null,"seers":[{"w":"எனைமாட்சித்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"எனை"},{"k":"N","s":"மாட்"},{"k":"N","s":"சித்"}]},{"w":"தாகியக்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தா"},{"k":"I","s":"கியக்"}]},{"w":"கண்ணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கண்"},{"k":"N","s":"ணும்"}]},{"w":"வினைமாட்சி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வினை"},{"k":"N","s":"மாட்"},{"k":"N","s":"சி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இல்லார்கண் இல்லது அரண்.","err":null,"seers":[{"w":"இல்லார்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லார்"},{"k":"N","s":"கண்"}]},{"w":"இல்லது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"இல்"},{"k":"I","s":"லது"}]},{"w":"அரண்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"அரண்"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]}]}]