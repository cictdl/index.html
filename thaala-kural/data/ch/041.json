[{"n":401,"ch":41,"l1":"அரங்கின்றி வட்டாடி யற்றே நிரம்பிய","l2":"நூலின்றிக் கோட்டி கொளல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறிவு நிரம்புவதற்குக் காரணமானக் நூல்களைக் கற்காமல் கற்றவரிடம் சென்று பேசதல், சூதாடும் அரங்கு இழைக்காமல் வட்டுக்காயை உருட்டிஆடினார் போன்றது.","en":"To speak in an assembly (of the learned) without fullness of knowledge, is like playing at chess (on a board) without squares","lines":[{"t":"அரங்கின்றி வட்டாடி யற்றே நிரம்பிய","err":null,"seers":[{"w":"அரங்கின்றி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அரங்"},{"k":"N","s":"கின்"},{"k":"N","s":"றி"}]},{"w":"வட்டாடி","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வட்"},{"k":"N","s":"டா"},{"k":"N","s":"டி"}]},{"w":"யற்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யற்"},{"k":"N","s":"றே"}]},{"w":"நிரம்பிய","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நிரம்"},{"k":"I","s":"பிய"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நூலின்றிக் கோட்டி கொளல்.","err":null,"seers":[{"w":"நூலின்றிக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நூ"},{"k":"N","s":"லின்"},{"k":"N","s":"றிக்"}]},{"w":"கோட்டி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கோட்"},{"k":"N","s":"டி"}]},{"w":"கொளல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கொளல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":402,"ch":41,"l1":"கல்லாதான் சொற்கா முறுதல் முலையிரண்டும்","l2":"இல்லாதாள் பெண்காமுற் றற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"(கற்றவரின் அவையில்) கல்லாதவன் ஒன்றைச் சொல்ல விரும்புதல், முலை இரண்டும் இல்லாதவள் பெண் தன்மையை விரும்பினாற் போன்றது.","en":"The desire of the unlearned to speak (in an assembly), is like a woman without breasts desiring (the enjoyment of ) woman-hood","lines":[{"t":"கல்லாதான் சொற்கா முறுதல் முலையிரண்டும்","err":null,"seers":[{"w":"கல்லாதான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லா"},{"k":"N","s":"தான்"}]},{"w":"சொற்கா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொற்"},{"k":"N","s":"கா"}]},{"w":"முறுதல்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"முறு"},{"k":"N","s":"தல்"}]},{"w":"முலையிரண்டும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"முலை"},{"k":"I","s":"யிரண்"},{"k":"N","s":"டும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"இல்லாதாள் பெண்காமுற் றற்று.","err":null,"seers":[{"w":"இல்லாதாள்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லா"},{"k":"N","s":"தாள்"}]},{"w":"பெண்காமுற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பெண்"},{"k":"N","s":"கா"},{"k":"N","s":"முற்"}]},{"w":"றற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"றற்"},{"k":"N","s":"று"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":403,"ch":41,"l1":"கல்லா தவரும் நனிநல்லர் கற்றார்முன்","l2":"சொல்லா திருக்கப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கற்றவரின் முன்னிலையில் ஒன்றையும் சொல்லாமல் அமைதியாக இருக்கப் பெற்றால் கல்லாதவர்களும் மிகவும் நல்லவரே ஆவார்.","en":"The unlearned also are very excellent men, if they know how to keep silence before the learned","lines":[{"t":"கல்லா தவரும் நனிநல்லர் கற்றார்முன்","err":null,"seers":[{"w":"கல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லா"}]},{"w":"தவரும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தவ"},{"k":"N","s":"ரும்"}]},{"w":"நனிநல்லர்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நனி"},{"k":"N","s":"நல்"},{"k":"N","s":"லர்"}]},{"w":"கற்றார்முன்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கற்"},{"k":"N","s":"றார்"},{"k":"N","s":"முன்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"சொல்லா திருக்கப் பெறின்.","err":null,"seers":[{"w":"சொல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லா"}]},{"w":"திருக்கப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"திருக்"},{"k":"N","s":"கப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":404,"ch":41,"l1":"கல்லாதான் ஒட்பம் கழியநன் றாயினும்","l2":"கொள்ளார் அறிவுடை யார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கல்லாதவனுடைய அறிவுடைய ஒருக்கால் மிக நன்றாக இருந்தாலும் அறிவுடையோர் அதனை அறிவின் பகுதியாக ஏற்றுக்கொள்ள மாட்டார்.","en":"Although the natural knowledge of an unlearned man may be very good, the wise will not accept for true knowledge","lines":[{"t":"கல்லாதான் ஒட்பம் கழியநன் றாயினும்","err":null,"seers":[{"w":"கல்லாதான்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லா"},{"k":"N","s":"தான்"}]},{"w":"ஒட்பம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஒட்"},{"k":"N","s":"பம்"}]},{"w":"கழியநன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"கழி"},{"k":"I","s":"யநன்"}]},{"w":"றாயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"றா"},{"k":"I","s":"யினும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கொள்ளார் அறிவுடை யார்.","err":null,"seers":[{"w":"கொள்ளார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கொள்"},{"k":"N","s":"ளார்"}]},{"w":"அறிவுடை","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"வுடை"}]},{"w":"யார்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"யார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":405,"ch":41,"l1":"கல்லா ஒருவன் தகைமை தலைப்பெய்து","l2":"சொல்லாடச் சோர்வு படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கல்லாதவன் ஒருவன் தன்னைத்தான் மகிழ்ந்து பேசும் மதிப்பு ( கற்றவரிடம்) கூடிபேசும் போது அப்பேசினால் கெடும்.","en":"The self-conceit of an unlearned man will fade away, as soon as he speaks in an assembly (of","lines":[{"t":"கல்லா ஒருவன் தகைமை தலைப்பெய்து","err":null,"seers":[{"w":"கல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லா"}]},{"w":"ஒருவன்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வன்"}]},{"w":"தகைமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தகை"},{"k":"N","s":"மை"}]},{"w":"தலைப்பெய்து","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"தலைப்"},{"k":"N","s":"பெய்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சொல்லாடச் சோர்வு படும்.","err":null,"seers":[{"w":"சொல்லாடச்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"சொல்"},{"k":"N","s":"லா"},{"k":"N","s":"டச்"}]},{"w":"சோர்வு","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சோர்"},{"k":"N","s":"வு"}]},{"w":"படும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"படும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":406,"ch":41,"l1":"உளரென்னும் மாத்திரையர் அல்லால் பயவாக்","l2":"களரனையர் கல்லா தவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"கல்லாதவர் உயிரோடிருக்கின்றனர் என்று சொல்லப்படும் அளவினரே அல்லாமல் ஒன்றும் விளையாத களர் நிலத்திற்கு ஒப்பாவர்.","en":"The unlearned are like worthless barren land: all that can be said of them is, that they exist","lines":[{"t":"உளரென்னும் மாத்திரையர் அல்லால் பயவாக்","err":null,"seers":[{"w":"உளரென்னும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உள"},{"k":"N","s":"ரென்"},{"k":"N","s":"னும்"}]},{"w":"மாத்திரையர்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மாத்"},{"k":"I","s":"திரை"},{"k":"N","s":"யர்"}]},{"w":"அல்லால்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அல்"},{"k":"N","s":"லால்"}]},{"w":"பயவாக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பய"},{"k":"N","s":"வாக்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"களரனையர் கல்லா தவர்.","err":null,"seers":[{"w":"களரனையர்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கள"},{"k":"I","s":"ரனை"},{"k":"N","s":"யர்"}]},{"w":"கல்லா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லா"}]},{"w":"தவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தவர்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":407,"ch":41,"l1":"நுண்மாண் நுழைபுலம் இல்லான் எழில்நலம்","l2":"மண்மாண் புனைபாவை யற்று.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"நுட்பமானதாய் மாட்சியுடையதாய் ஆராய வல்லவான அறிவு இல்லாதவனுடைய எழுச்சியான அழகு மண்ணால் சிறப்பாகப் புனையப்பட்ட பாவை போன்றது.","en":"The beauty and goodness of one who is destitute of knowledge by the study of great and exquisite works, is like (the beauty and goodness) of a painted earthen doll","lines":[{"t":"நுண்மாண் நுழைபுலம் இல்லான் எழில்நலம்","err":null,"seers":[{"w":"நுண்மாண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நுண்"},{"k":"N","s":"மாண்"}]},{"w":"நுழைபுலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"நுழை"},{"k":"I","s":"புலம்"}]},{"w":"இல்லான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இல்"},{"k":"N","s":"லான்"}]},{"w":"எழில்நலம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"எழில்"},{"k":"I","s":"நலம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மண்மாண் புனைபாவை யற்று.","err":null,"seers":[{"w":"மண்மாண்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மண்"},{"k":"N","s":"மாண்"}]},{"w":"புனைபாவை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"புனை"},{"k":"N","s":"பா"},{"k":"N","s":"வை"}]},{"w":"யற்று.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யற்"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":408,"ch":41,"l1":"நல்லார்கண் பட்ட வறுமையின் இன்னாதே","l2":"கல்லார்கண் பட் ட திரு.","ok":true,"reseg":true,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"கல்லாதவனிடம் சேர்ந்துள்ள செல்வமானது, கற்றறிந்த நல்லவரிடம் உள்ள வறுமையைவிட மிகத்துன்பம் செய்வதாகும்.","en":"Wealth, gained by the unlearned, will give more sorrow than the poverty which may come upon the learned","lines":[{"t":"நல்லார்கண் பட்ட வறுமையின் இன்னாதே","err":null,"seers":[{"w":"நல்லார்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"N","s":"லார்"},{"k":"N","s":"கண்"}]},{"w":"பட்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பட்"},{"k":"N","s":"ட"}]},{"w":"வறுமையின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வறு"},{"k":"N","s":"மை"},{"k":"N","s":"யின்"}]},{"w":"இன்னாதே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"N","s":"தே"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கல்லார்கண் பட் ட திரு.","err":null,"seers":[{"w":"கல்லார்கண்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லார்"},{"k":"N","s":"கண்"}]},{"w":"பட்ட","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பட்"},{"k":"N","s":"ட"}]},{"w":"திரு","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"திரு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":409,"ch":41,"l1":"மேற்பிறந்தா ராயினும் கல்லாதார் கீழ்ப்பிறந்தும்","l2":"கற்றார் அனைத்திலர் பாடு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"கல்லாதவர் உயர்ந்த குடியில் பிறந்தவராக இருப்பினும் தாழ்ந்த குடியில் பிறந்திருந்தும் கல்விக் கற்றவரைப் போன்ற பெருமை இல்லாதவரே.","en":"The unlearned, though born in a high caste, are not equal in dignity to the learned; though they may have been born in a low caste","lines":[{"t":"மேற்பிறந்தா ராயினும் கல்லாதார் கீழ்ப்பிறந்தும்","err":null,"seers":[{"w":"மேற்பிறந்தா","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மேற்"},{"k":"I","s":"பிறந்"},{"k":"N","s":"தா"}]},{"w":"ராயினும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ரா"},{"k":"I","s":"யினும்"}]},{"w":"கல்லாதார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கல்"},{"k":"N","s":"லா"},{"k":"N","s":"தார்"}]},{"w":"கீழ்ப்பிறந்தும்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கீழ்ப்"},{"k":"I","s":"பிறந்"},{"k":"N","s":"தும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கற்றார் அனைத்திலர் பாடு.","err":null,"seers":[{"w":"கற்றார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கற்"},{"k":"N","s":"றார்"}]},{"w":"அனைத்திலர்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அனைத்"},{"k":"I","s":"திலர்"}]},{"w":"பாடு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பா"},{"k":"N","s":"டு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":410,"ch":41,"l1":"விலங்கொடு மக்கள் அனையர் இலங்குநூல்","l2":"கற்றாரோடு ஏனை யவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அறிவு விளங்குதற்குக் காரணமான நூல்களைக் கற்றவரோடுக் கல்லாதவர், மக்களோடு விலங்குகளுக்கு உள்ள அவ்வளவு வேற்றுமை உடையவர்.","en":"As beasts by the side of men, so are other men by the side of those who are learned in celebrated works","lines":[{"t":"விலங்கொடு மக்கள் அனையர் இலங்குநூல்","err":null,"seers":[{"w":"விலங்கொடு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"விலங்"},{"k":"I","s":"கொடு"}]},{"w":"மக்கள்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மக்"},{"k":"N","s":"கள்"}]},{"w":"அனையர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அனை"},{"k":"N","s":"யர்"}]},{"w":"இலங்குநூல்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இலங்"},{"k":"I","s":"குநூல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கற்றாரோடு ஏனை யவர்.","err":null,"seers":[{"w":"கற்றாரோடு","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"கற்"},{"k":"N","s":"றா"},{"k":"N","s":"ரோ"},{"k":"N","s":"டு"}]},{"w":"ஏனை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"னை"}]},{"w":"யவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"யவர்"}]}],"thalai":[null,"இயற்சீர் வெண்டளை"]}]}]