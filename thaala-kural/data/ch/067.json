[{"n":661,"ch":67,"l1":"வினைத்திட்பம் என்பது ஒருவன் மனத்திட்பம்","l2":"மற்றைய எல்லாம் பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஒரு தொழிலின் திட்பம் என்று சொல்லப்படுவது ஒருவனுடைய மனதின் திட்பமே (உறுதியே) ஆகும், மற்றவை எல்லாம் வேறானவை.","en":"Firmness in action is (simply) one's firmness of mind; all other (abilities) are not of this nature","lines":[{"t":"வினைத்திட்பம் என்பது ஒருவன் மனத்திட்பம்","err":null,"seers":[{"w":"வினைத்திட்பம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"வினைத்"},{"k":"N","s":"திட்"},{"k":"N","s":"பம்"}]},{"w":"என்பது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பது"}]},{"w":"ஒருவன்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒரு"},{"k":"N","s":"வன்"}]},{"w":"மனத்திட்பம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"மனத்"},{"k":"N","s":"திட்"},{"k":"N","s":"பம்"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"மற்றைய எல்லாம் பிற.","err":null,"seers":[{"w":"மற்றைய","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"மற்"},{"k":"N","s":"றை"},{"k":"N","s":"ய"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"பிற.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பிற"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":662,"ch":67,"l1":"ஊறொரால் உற்றபின் ஒல்காமை இவ்விரண்டின்","l2":"ஆறென்பர் ஆய்ந்தவர் கோள்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["வெண்சீர் வெண்டளை"],"mv":"இடையூறு வருவதற்கு முன்பே நீக்குதல், வந்த பின் தளராமை ஆகிய இந்த இரண்டினது வழியே வினைத்திட்பம் பற்றி ஆராய்ந்தவரின் கொள்கையாம்.","en":"Not to perform a ruinous act, and not to be discouraged by the ruinous termination of an act, are the two maxims which, the wise say, from the principles of those who have investigated the subject","lines":[{"t":"ஊறொரால் உற்றபின் ஒல்காமை இவ்விரண்டின்","err":null,"seers":[{"w":"ஊறொரால்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஊ"},{"k":"I","s":"றொரால்"}]},{"w":"உற்றபின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உற்"},{"k":"I","s":"றபின்"}]},{"w":"ஒல்காமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஒல்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"இவ்விரண்டின்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"இவ்"},{"k":"I","s":"விரண்"},{"k":"N","s":"டின்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஆறென்பர் ஆய்ந்தவர் கோள்.","err":null,"seers":[{"w":"ஆறென்பர்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"றென்"},{"k":"N","s":"பர்"}]},{"w":"ஆய்ந்தவர்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆய்ந்"},{"k":"I","s":"தவர்"}]},{"w":"கோள்.","name":"நாள்","cls":"ஓரசை","a":[{"k":"N","s":"கோள்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":663,"ch":67,"l1":"கடைக்கொட்கச் செய்தக்க தாண்மை இடைக்கொட்கின்","l2":"எற்றா விழுமந் தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"செய்யும் செயலை முடிவில் வெளிப்படும் படியாக செய்யும் தகுதியே ஆண்மையாகும், இடையில் வெளிபட்டால் நீங்காத துன்பத்தைக் கொடுக்கும்.","en":"So to perform an act as to publish it (only) at its termination is (true) manliness; for to announce it beforehand, will cause irremediable sorrow","lines":[{"t":"கடைக்கொட்கச் செய்தக்க தாண்மை இடைக்கொட்கின்","err":null,"seers":[{"w":"கடைக்கொட்கச்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கடைக்"},{"k":"N","s":"கொட்"},{"k":"N","s":"கச்"}]},{"w":"செய்தக்க","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தக்"},{"k":"N","s":"க"}]},{"w":"தாண்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தாண்"},{"k":"N","s":"மை"}]},{"w":"இடைக்கொட்கின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இடைக்"},{"k":"N","s":"கொட்"},{"k":"N","s":"கின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எற்றா விழுமந் தரும்.","err":null,"seers":[{"w":"எற்றா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எற்"},{"k":"N","s":"றா"}]},{"w":"விழுமந்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"விழு"},{"k":"N","s":"மந்"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":664,"ch":67,"l1":"சொல்லுதல் யார்க்கும் எளிய அரியவாம்","l2":"சொல்லிய வண்ணம் செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"இச் செயலை இவ்வாறு செய்து முடிக்கலாம் என்று சொல்லுதல் எவர்க்கும் எளியனவாம், சொல்லிய படி செய்து முடித்தல் அரியனவாம்.","en":"To say (how an act is to be performed) is (indeed) easy for any one; but far difficult it is to do according to what has been said","lines":[{"t":"சொல்லுதல் யார்க்கும் எளிய அரியவாம்","err":null,"seers":[{"w":"சொல்லுதல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லுதல்"}]},{"w":"யார்க்கும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யார்க்"},{"k":"N","s":"கும்"}]},{"w":"எளிய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"எளி"},{"k":"N","s":"ய"}]},{"w":"அரியவாம்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அரி"},{"k":"I","s":"யவாம்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"சொல்லிய வண்ணம் செயல்.","err":null,"seers":[{"w":"சொல்லிய","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சொல்"},{"k":"I","s":"லிய"}]},{"w":"வண்ணம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வண்"},{"k":"N","s":"ணம்"}]},{"w":"செயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":665,"ch":67,"l1":"வீறெய்தி மாண்டார் வினைத்திட்பம் வேந்தன்கண்","l2":"ஊறெய்தி உள்ளப் படும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"செயல் திறனால் பெருமைபெற்று உயர்ந்தவரின் வினைத் திட்பமானது நாட்டை ஆளும் அரசனிடத்திலும் எட்டி மதிக்கப்பட்டு விளங்கும்.","en":"The firmness in action of those who have become great by the excellence (of their counsel) will, by attaining its fulfilment in the person of the king, be esteemed (by all).","lines":[{"t":"வீறெய்தி மாண்டார் வினைத்திட்பம் வேந்தன்