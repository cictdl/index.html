[{"n":1041,"ch":105,"l1":"இன்மையின் இன்னாதது யாதெனின் இன்மையின்","l2":"இன்மையே இன்னா தது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"வறுமையைப் போல் துன்பமானது எது என்று கேட்டால், வறுமையைப் போல் துன்பமானது வறுமை ஒன்றே ஆகும்.","en":"There is nothing that afflicts (one) like poverty","lines":[{"t":"இன்மையின் இன்னாதது யாதெனின் இன்மையின்","err":null,"seers":[{"w":"இன்மையின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"},{"k":"N","s":"யின்"}]},{"w":"இன்னாதது","name":"தேமாங்கனி","cls":"கனி","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"},{"k":"I","s":"தது"}]},{"w":"யாதெனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தெனின்"}]},{"w":"இன்மையின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"},{"k":"N","s":"யின்"}]}],"thalai":["வெண்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]},{"t":"இன்மையே இன்னா தது.","err":null,"seers":[{"w":"இன்மையே","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"},{"k":"N","s":"யே"}]},{"w":"இன்னா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"}]},{"w":"தது.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தது"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1042,"ch":105,"l1":"இன்மை எனவொரு பாவி மறுமையும்","l2":"இம்மையும் இன்றி வரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வறுமை என்று சொல்லப்படும் பாவி ஒருவனை நெருங்கினால், அவனுக்கு மறுமையின்பமும், இன்மையின்பமும் இல்லாமற் போகும் நிலைமை வரும்.","en":"When cruel poverty comes on, it deprives one of both the present and future (bliss)","lines":[{"t":"இன்மை எனவொரு பாவி மறுமையும்","err":null,"seers":[{"w":"இன்மை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"மை"}]},{"w":"எனவொரு","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"என"},{"k":"I","s":"வொரு"}]},{"w":"பாவி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பா"},{"k":"N","s":"வி"}]},{"w":"மறுமையும்","name":"புளிமாங்காய