[{"n":801,"ch":81,"l1":"பழைமை எனப்படுவது யாதெனின் யாதும்","l2":"கிழமையைக் கீழ்ந்திடா நட்பு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பழைமை என்று சொல்லப்படுவது எது என்று வினாவினால் அது பழகியவர் உரிமைப் பற்றிச் செய்யும் செயலைக் கீழ்ப்படுத்தாமல் ஏற்கும் நட்பாகும்.","en":"Imtimate friendship is that which cannot in the least be injured by (things done through the) right (of longstanding intimacy)","lines":[{"t":"பழைமை எனப்படுவது யாதெனின் யாதும்","err":null,"seers":[{"w":"பழைமை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பழை"},{"k":"N","s":"மை"}]},{"w":"எனப்படுவது","name":"கருவிளங்கனி","cls":"கனி","a":[{"k":"I","s":"எனப்"},{"k":"I","s":"படு"},{"k":"I","s":"வது"}]},{"w":"யாதெனின்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"யா"},{"k":"I","s":"தெனின்"}]},{"w":"யாதும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யா"},{"k":"N","s":"தும்"}]}],"thalai":["இயற்சீர் வெண்டளை","ஒன்றிய வஞ்சித்தளை","இயற்சீர் வெண்டளை"]},{"t":"கிழமையைக் கீழ்ந்திடா நட்பு.","err":null,"seers":[{"w":"கிழமையைக்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கிழ"},{"k":"N","s":"மை"},{"k":"N","s":"யைக்"}]},{"w":"கீழ்ந்திடா","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"கீழ்ந்"},{"k":"I","s":"திடா"}]},{"w":"நட்பு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":802,"ch":81,"l1":"நட்பிற் குறுப்புக் கெழுதகைமை மற்றதற்கு","l2":"உப்பாதல் சான்றோர் கடன்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"நட்பிற்க்கு உறுப்பாவது நண்பனுடைய உரிமைச் செயலாகும், அந்த உரிமைச் செயலுக்கு உடன்பட்டவராதல் சான்றோரின் கடமையாகும்.","en":"The constituents of friendship are (things done through) the right of intimacy; to be pleased with such a right is the duty of the wise","lines":[{"t":"நட்பிற் குறுப்புக் கெழுதகைமை மற்றதற்கு","err":null,"seers":[{"w":"நட்பிற்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"பிற்"}]},{"w":"குறுப்புக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"குறுப்"},{"k":"N","s":"புக்"}]},{"w":"கெழுதகைமை","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கெழு"},{"k":"I","s":"தகை"},{"k":"N","s":"மை"}]},{"w":"மற்றதற்கு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"மற்"},{"k":"I","s":"றதற்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"உப்பாதல் சான்றோர் கடன்.","err":null,"seers":[{"w":"உப்பாதல்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உப்"},{"k":"N","s":"பா"},{"k":"N","s":"தல்"}]},{"w":"சான்றோர்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சான்"},{"k":"N","s":"றோர்"}]},{"w":"கடன்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கடன்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":803,"ch":81,"l1":"பழகிய நட்பெவன் செய்யுங் கெழுதகைமை","l2":"செய்தாங்கு அமையாக் கடை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பழகியவர் உரிமைப்பற்றிச் செய்யும் செயலைத் தாம் செய்தது போலவேக் கருதி உடன்படாவிட்டால் அவரோடு தாம் பழகிய நட்பு என்ன பயன் தரும்.","en":"Of what avail is long-standing friendship, if friends do not admit as their own actions done through the right of intimacy ?","lines":[{"t":"பழகிய நட்பெவன் செய்யுங் கெழுதகைமை","err":null,"seers":[{"w":"பழகிய","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பழ"},{"k":"I","s":"கிய"}]},{"w":"நட்பெவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நட்"},{"k":"I","s":"பெவன்"}]},{"w":"செய்யுங்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"யுங்"}]},{"w":"கெழுதகைமை","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கெழு"},{"k":"I","s":"தகை"},{"k":"N","s":"மை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"செய்தாங்கு அமையாக் கடை.","err":null,"seers":[{"w":"செய்தாங்கு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"செய்"},{"k":"N","s":"தாங்"},{"k":"N","s":"கு"}]},{"w":"அமையாக்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"அமை"},{"k":"N","s":"யாக்"}]},{"w":"கடை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கடை"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":804,"ch":81,"l1":"விழைதகையான் வேண்டி இருப்பர் கெழுதகையாற்","l2":"கேளாது நட்டார் செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"உரிமையால் கேளாமலே நண்பர் ஒன்றைச் செய்தால், அந்த உரிமையைப் போற்றி விரும்பும் தன்மையோடு அச் செயலையும் விரும்பி உடன்பட்டிருப்பர் அறிஞர்.","en":"If friends, through the right of friendship, do (anything) without being asked, the wise will be pleased with them on account of its desirability","lines":[{"t":"விழைதகையான் வேண்டி இருப்பர் கெழுதகையாற்","err":null,"seers":[{"w":"விழைதகையான்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"விழை"},{"k":"I","s":"தகை"},{"k":"N","s":"யான்"}]},{"w":"வேண்டி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேண்"},{"k":"N","s":"டி"}]},{"w":"இருப்பர்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இருப்"},{"k":"N","s":"பர்"}]},{"w":"கெழுதகையாற்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"கெழு"},{"k":"I","s":"தகை"},{"k":"N","s":"யாற்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"கேளாது நட்டார் செயின்.","err":null,"seers":[{"w":"கேளாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கே"},{"k":"N","s":"ளா"},{"k":"N","s":"து"}]},{"w":"நட்டார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நட்"},{"k":"N","s":"டார்"}]},{"w":"செயின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":805,"ch":81,"l1":"பேதைமை ஒன்றோ பெருங்கிழமை என்றுணர்க","l2":"நோதக்க நட்டார் செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"வருந்ததக்க செயல்களை நண்பர் செய்தால் அதற்குக் காரணம் அறியாமை என்றாவது மிகுந்த உரிமை என்றாவது உணரவேண்டும்.","en":"If friends should perform what is painful, understand that it is owing not only to ignorance, but also to the strong claims of intimacy","lines":[{"t":"பேதைமை ஒன்றோ பெருங்கிழமை என்றுணர்க","err":null,"seers":[{"w":"பேதைமை","name":"தேமாங்காய்","c