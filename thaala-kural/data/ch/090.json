[{"n":891,"ch":90,"l1":"ஆற்றுவார் ஆற்றல் இகழாமை போற்றுவார்","l2":"போற்றலுள் எல்லாம் தலை.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"மேற்கொண்ட செயலைச் செய்து முடிக்க வல்லவரின் ஆற்றலை இகழாதிருத்தல், காப்பவர் செய்து கொள்ளும் காவல் எல்லாவற்றிலும் சிறந்தது.","en":"Not to disregard the power of those who can carry out (their wishes) is more important than all the watchfulness of those who guard (themselves against evil)","lines":[{"t":"ஆற்றுவார் ஆற்றல் இகழாமை போற்றுவார்","err":null,"seers":[{"w":"ஆற்றுவார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஆற்"},{"k":"I","s":"றுவார்"}]},{"w":"ஆற்றல்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றல்"}]},{"w":"இகழாமை","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இக"},{"k":"N","s":"ழா"},{"k":"N","s":"மை"}]},{"w":"போற்றுவார்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"போற்"},{"k":"I","s":"றுவார்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"போற்றலுள் எல்லாம் தலை.","err":null,"seers":[{"w":"போற்றலுள்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"போற்"},{"k":"I","s":"றலுள்"}]},{"w":"எல்லாம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"எல்"},{"k":"N","s":"லாம்"}]},{"w":"தலை.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தலை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":892,"ch":90,"l1":"பெரியாரைப் பேணாது ஒழுகிற் பெரியாரால்","l2":"பேரா இடும்பை தரும்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஆற்றல் மிகுந்த பெரியாரை விரும்பி மதிக்காமல் நடந்தால், அது அப் பெரியாரால் நீங்காத துன்பத்தைத் தருவதாகும்.","en":"To behave without respect for the great (rulers) will make them do (us) irremediable evils","lines":[{"t":"பெரியாரைப் பேணாது ஒழுகிற் பெரியாரால்","err":null,"seers":[{"w":"பெரியாரைப்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"யா"},{"k":"N","s":"ரைப்"}]},{"w":"பேணாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பே"},{"k":"N","s":"ணா"},{"k":"N","s":"து"}]},{"w":"ஒழுகிற்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழு"},{"k":"N","s":"கிற்"}]},{"w":"பெரியாரால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"யா"},{"k":"N","s":"ரால்"}]}],"thalai":["வெண்சீர் வெண்டளை","கலித்தளை","இயற்சீர் வெண்டளை"]},{"t":"பேரா இடும்பை தரும்.","err":null,"seers":[{"w":"பேரா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"பே"},{"k":"N","s":"ரா"}]},{"w":"இடும்பை","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இடும்"},{"k":"N","s":"பை"}]},{"w":"தரும்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"தரும்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":893,"ch":90,"l1":"கெடல்வேண்டின் கேளாது செய்க அடல்வேண்டின்","l2":"ஆற்று பவர்கண் இழுக்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அழிக்க வேண்டுமானால் அவ்வாறே செய்து முடிக்க வல்லவரிடத்தில் தவறு செய்தலை, ஒருவன் கெட வேண்டுமானால் கேளாமலேச் செய்யலாம்.","en":"If a person desires ruin, let him not listen to the righteous dictates of law, but commit crimes against those who are able to slay (other sovereigns)","lines":[{"t":"கெடல்வேண்டின் கேளாது செய்க அடல்வேண்டின்","err":null,"seers":[{"w":"கெடல்வேண்டின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கெடல்"},{"k":"N","s":"வேண்"},{"k":"N","s":"டின்"}]},{"w":"கேளாது","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கே"},{"k":"N","s":"ளா"},{"k":"N","s":"து"}]},{"w":"செய்க","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செய்"},{"k":"N","s":"க"}]},{"w":"அடல்வேண்டின்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அடல்"},{"k":"N","s":"வேண்"},{"k":"N","s":"டின்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"ஆற்று பவர்கண் இழுக்கு.","err":null,"seers":[{"w":"ஆற்று","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"று"}]},{"w":"பவர்கண்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பவர்"},{"k":"N","s":"கண்"}]},{"w":"இழுக்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"இழுக்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":894,"ch":90,"l1":"கூற்றத்தைக் கையால் விளித்தற்றால் ஆற்றுவார்க்கு","l2":"ஆற்றாதார் இன்னா செயல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஆற்றல் உடையவர்க்கு ஆற்றல் இல்லாதவர் தீமை செய்தல், தானே வந்து அழிக்க வல்ல எமனைக் கைகாட்டி அழைத்தாற் போன்றது.","en":"The weak doing evil to the strong is like beckoning Yama to come (and destroy them)","lines":[{"t":"கூற்றத்தைக் கையால் விளித்தற்றால் ஆற்றுவார்க்கு","err":null,"seers":[{"w":"கூற்றத்தைக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கூற்"},{"k":"N","s":"றத்"},{"k":"N","s":"தைக்"}]},{"w":"கையால்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கை"},{"k":"N","s":"யால்"}]},{"w":"விளித்தற்றால்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"விளித்"},{"k":"N","s":"தற்"},{"k":"N","s":"றால்"}]},{"w":"ஆற்றுவார்க்கு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆற்"},{"k":"I","s":"றுவார்க்"},{"k":"N","s":"கு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"ஆற்றாதார் இன்னா செயல்.","err":null,"seers":[{"w":"ஆற்றாதார்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆற்"},{"k":"N","s":"றா"},{"k":"N","s":"தார்"}]},{"w":"இன்னா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"இன்"},{"k":"N","s":"னா"}]},{"w":"செயல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயல்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":895,"ch":90,"l1":"யாண்டுச்சென்று யாண்டும் உளராகார் வெந்துப்பின்","l2":"வேந்து செறப்பட் டவர்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"மிக்க வலிமை உள்ள அரசனால் வெகுளப்பட்டவர், அவனிடமிருந்து தப்புவதற்க்காக எங்கே சென்றாலும் எங்கும் வாழ முடியாது.","en":"Those who have incurred the wrath of a cruel and mighty potentate will not prosper wherever they may go","lines":[{"t":"யாண்டுச்சென்று யாண்டும் உளராகார் வெந்துப்பின்","err":null,"seers":[{"w":"யாண்டுச்சென்று","name":"தேமாந்தண்பூ","cls":"நான்கசை","a":[{"k":"N","s":"யாண்"},{"k":"N","s":"டுச்"},{"k":"N","s":"சென்"},{"k":"N","s":"று"}]},{"w":"யாண்டும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"யாண்"},{"k":"N","s":"டும்"}]},{"w":"உளராகார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உள"},{"k":"N","s":"ரா"},{"k":"N","s":"கார்"}]},{"w":"வெந்துப்பின்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"வெந்"},{"k":"N","s":"துப்"},{"k":"N","s":"பின்"}]}],"thalai":[null,"இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"வேந்து செறப்பட் டவர்.","err":null,"seers":[{"w":"வேந்து","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"து"}]},{"w":"செறப்பட்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"செறப்"},{"k":"N","s":"பட்"}]},{"w":"டவர்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"டவர்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":896,"ch":90,"l1":"எரியால் சுடப்படினும் உய்வுண்டாம் உய்யார்","l2":"பெரியார்ப் பிழைத்தொழுகு வார்.","ok":true,"reseg":false,"eetru":"நாள்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தீயால் சுடப்பட்டாலும் ஒருகால் உயிர் பிழைத்து வாழ முடியும், ஆற்றல் மிகுந்த பெரியவரிடத்தில் தவறு செய்து நடப்பவர் தப்பி பிழைக்க முடியாது.","en":"Though burnt by a fire (from a forest), one may perhaps live; (but) never will he live who has shown disrespect to the great (devotees)","lines":[{"t":"எரியால் சுடப்படினும் உய்வுண்டாம் உய்யார்","err":null,"seers":[{"w":"எரியால்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"எரி"},{"k":"N","s":"யால்"}]},{"w":"சுடப்படினும்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"சுடப்"},{"k":"I","s":"படி"},{"k":"N","s":"னும்"}]},{"w":"உய்வுண்டாம்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"உய்"},{"k":"N","s":"வுண்"},{"k":"N","s":"டாம்"}]},{"w":"உய்யார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"உய்"},{"k":"N","s":"யார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"பெரியார்ப் பிழைத்தொழுகு வார்.","err":null,"seers":[{"w":"பெரியார்ப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பெரி"},{"k":"N","s":"யார்ப்"}]},{"w":"பிழைத்தொழுகு","name":"கருவிளங்காய்","cl