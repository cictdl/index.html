[{"n":111,"ch":12,"l1":"தகுதி எனவொன்று நன்றே பகுதியால்","l2":"பாற்பட்டு ஒழுகப் பெறின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"அந்தந்தப் பகுதிதோறும் முறையோடு பொருந்தி ஒழுகப்பெற்றால், நடுவுநிலைமை என்று கூறப்படும் அறம் நன்மையாகும்.","en":"That equity which consists in acting with equal regard to each of (the three) divisions of men [enemies, strangers and friends] is a pre-eminent virtue","lines":[{"t":"தகுதி எனவொன்று நன்றே பகுதியால்","err":null,"seers":[{"w":"தகுதி","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தகு"},{"k":"N","s":"தி"}]},{"w":"எனவொன்று","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"என"},{"k":"N","s":"வொன்"},{"k":"N","s":"று"}]},{"w":"நன்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றே"}]},{"w":"பகுதியால்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பகு"},{"k":"I","s":"தியால்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பாற்பட்டு ஒழுகப் பெறின்.","err":null,"seers":[{"w":"பாற்பட்டு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"பாற்"},{"k":"N","s":"பட்"},{"k":"N","s":"டு"}]},{"w":"ஒழுகப்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"ஒழு"},{"k":"N","s":"கப்"}]},{"w":"பெறின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பெறின்"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":112,"ch":12,"l1":"செப்பம் உடையவன் ஆக்கஞ் சிதைவின்றி","l2":"எச்சத்திற் கேமாப்பு உடைத்து.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"நடுவுநிலைமை உடையவனின் செல்வவளம் அழிவில்லாமல் அவனுடைய வழியில் உள்ளார்க்கும் உறுதியான நன்மை தருவதாகும்.","en":"The wealth of the man of rectitude will not perish, but will bring happiness also to his posterity","lines":[{"t":"செப்பம் உடையவன் ஆக்கஞ் சிதைவின்றி","err":null,"seers":[{"w":"செப்பம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"செப்"},{"k":"N","s":"பம்"}]},{"w":"உடையவன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உடை"},{"k":"I","s":"யவன்"}]},{"w":"ஆக்கஞ்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கஞ்"}]},{"w":"சிதைவின்றி","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"சிதை"},{"k":"N","s":"வின்"},{"k":"N","s":"றி"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"எச்சத்திற் கேமாப்பு உடைத்து.","err":null,"seers":[{"w":"எச்சத்திற்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எச்"},{"k":"N","s":"சத்"},{"k":"N","s":"திற்"}]},{"w":"கேமாப்பு","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கே"},{"k":"N","s":"மாப்"},{"k":"N","s":"பு"}]},{"w":"உடைத்து.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடைத்"},{"k":"N","s":"து"}]}],"thalai":["வெண்சீர் வெண்டளை","கலித்தளை"]}]},{"n":113,"ch":12,"l1":"நன்றே தரினும் நடுவிகந்தாம் ஆக்கத்தை","l2":"அன்றே யொழிய விடல்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"தீமை பயக்காமல் நன்மையே தருவதானாலும் நடுவு நி‌லைமை தவறி உண்டாகும் ஆக்கத்தை அப்போதே கைவிட வேண்டும்.","en":"Forsake in the very moment (of acquisition) that gain which, though it should bring advantage, is without equity","lines":[{"t":"நன்றே தரினும் நடுவிகந்தாம் ஆக்கத்தை","err":null,"seers":[{"w":"நன்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றே"}]},{"w":"தரினும்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தரி"},{"k":"N","s":"னும்"}]},{"w":"நடுவிகந்தாம்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நடு"},{"k":"I","s":"விகந்"},{"k":"N","s":"தாம்"}]},{"w":"ஆக்கத்தை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"ஆக்"},{"k":"N","s":"கத்"},{"k":"N","s":"தை"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"அன்றே யொழிய விடல்.","err":null,"seers":[{"w":"அன்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அன்"},{"k":"N","s":"றே"}]},{"w":"யொழிய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"யொழி"},{"k":"N","s":"ய"}]},{"w":"விடல்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"விடல்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":114,"ch":12,"l1":"தக்கார் தகவிலர் என்பது அவரவர்","l2"