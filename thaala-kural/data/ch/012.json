":"நெஞ்சத்துக்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சத்"},{"k":"N","s":"துக்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"கோடாமை சான்றோர்க் கணி.","err":null,"seers":[{"w":"கோடாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கோ"},{"k":"N","s":"டா"},{"k":"N","s":"மை"}]},{"w":"சான்றோர்க்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"சான்"},{"k":"N","s":"றோர்க்"}]},{"w":"கணி.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"கணி"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":116,"ch":12,"l1":"கெடுவல்யான் என்பது அறிகதன் நெஞ்சம்","l2":"நடுவொரீஇ அல்ல செயின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"தன் நெஞ்சம் நடுவுநிலை நீங்கித் தவறு செய்ய நினைக்குமாயின், நான் கெடப்போகின்றேன் என்று ஒருவன் அறிய வேண்டும்.","en":"Let him whose mind departing from equity commits sin well consider thus within himself, \"I shall perish.\"","lines":[{"t":"கெடுவல்யான் என்பது அறிகதன் நெஞ்சம்","err":null,"seers":[{"w":"கெடுவல்யான்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"கெடு"},{"k":"N","s":"வல்"},{"k":"N","s":"யான்"}]},{"w":"என்பது","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"என்"},{"k":"I","s":"பது"}]},{"w":"அறிகதன்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அறி"},{"k":"I","s":"கதன்"}]},{"w":"நெஞ்சம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நெஞ்"},{"k":"N","s":"சம்"}]}],"thalai":["வெண்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை","இயற்சீர் வெண்டளை"]},{"t":"நடுவொரீஇ அல்ல செயின்.","err":null,"seers":[{"w":"நடுவொரீஇ","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நடு"},{"k":"I","s":"வொரீ"},{"k":"N","s":"இ"}]},{"w":"அல்ல","name":"தேமா","cls":"மா","a":[{"k":"N","s":"அல்"},{"k":"N","s":"ல"}]},{"w":"செயின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"செயின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":117,"ch":12,"l1":"கெடுவாக வையாது உலகம் நடுவாக","l2":"நன்றிக்கண் தங்கியான் தாழ்வு.","ok":true,"reseg":false,"eetru":"காசு","bou