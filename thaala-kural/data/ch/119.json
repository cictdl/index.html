[{"n":1181,"ch":119,"l1":"நயந்தவர்க்கு நல்காமை நேர்ந்தேன் பசந்தவென்","l2":"பண்பியார்க்கு உரைக்கோ பிற.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["இயற்சீர் வெண்டளை"],"mv":"விரும்பிய காதலர்க்கு அன்று பிரிவை உடன்பட்டேன்; பிரிந்தபின் பசலை உற்ற என் தன்மையை வேறு யார்க்குச் சென்று சொல்வேன்?","en":"I who (then) consented to the absence of my loving lord, to whom can I (now) relate the fact of my having turned sallow","lines":[{"t":"நயந்தவர்க்கு நல்காமை நேர்ந்தேன் பசந்தவென்","err":null,"seers":[{"w":"நயந்தவர்க்கு","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"நயந்"},{"k":"I","s":"தவர்க்"},{"k":"N","s":"கு"}]},{"w":"நல்காமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"நேர்ந்தேன்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நேர்ந்"},{"k":"N","s":"தேன்"}]},{"w":"பசந்தவென்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பசந்"},{"k":"I","s":"தவென்"}]}],"thalai":["வெண்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"பண்பியார்க்கு உரைக்கோ பிற.","err":null,"seers":[{"w":"பண்பியார்க்கு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பண்"},{"k":"I","s":"பியார்க்"},{"k":"N","s":"கு"}]},{"w":"உரைக்கோ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உரைக்"},{"k":"N","s":"கோ"}]},{"w":"பிற.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"பிற"}]}],"thalai":["கலித்தளை","இயற்சீர் வெண்டளை"]}]},{"n":1182,"ch":119,"l1":"அவர்தந்தார் என்னும் தகையால் இவர்தந்தென்","l2":"மேனிமேல் ஊரும் பசப்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அந்தக் காதலர் உண்டாக்கினார் என்னும் பெருமிதத்தோடு இந்தப் பசலை நிறம் என்னுடைய மேனிமேல் ஏறி ஊர்ந்து பரவி வருகிறது.","en":"Sallowness, as if proud of having been caused by him, would now ride on my person","lines":[{"t":"அவர்தந்தார் என்னும் தகையால் இவர்தந்தென்","err":null,"seers":[{"w":"அவர்தந்தார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவர்"},{"k":"N","s":"தந்"},{"k":"N","s":"தார்"}]},{"w":"என்னும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"என்"},{"k":"N","s":"னும்"}]},{"w":"தகையால்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தகை"},{"k":"N","s":"யால்"}]},{"w":"இவர்தந்தென்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"இவர்"},{"k":"N","s":"தந்"},{"k":"N","s":"தென்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மேனிமேல் ஊரும் பசப்பு.","err":null,"seers":[{"w":"மேனிமேல்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"மே"},{"k":"I","s":"னிமேல்"}]},{"w":"ஊரும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஊ"},{"k":"N","s":"ரும்"}]},{"w":"பசப்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பசப்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1183,"ch":119,"l1":"சாயலும் நாணும் அவர்கொண்டார் கைம்மாறா","l2":"நோயும் பசலையும் தந்து.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"காம நோயையும் பசலை நிறத்தையும் எனக்குக் கைம்மாறாக ‌‌கொடுத்து விட்டு, என் சாயலையும் நாணத்தையும் அவர் என்னிடமிருந்து பெற்றுக் கொண்டார்.","en":"He has taken (away) my beauty and modesty, and given me instead disease and sallowness","lines":[{"t":"சாயலும் நாணும் அவர்கொண்டார் கைம்மாறா","err":null,"seers":[{"w":"சாயலும்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"சா"},{"k":"I","s":"யலும்"}]},{"w":"நாணும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நா"},{"k":"N","s":"ணும்"}]},{"w":"அவர்கொண்டார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அவர்"},{"k":"N","s":"கொண்"},{"k":"N","s":"டார்"}]},{"w":"கைம்மாறா","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"கைம்"},{"k":"N","s":"மா"},{"k":"N","s":"றா"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நோயும் பசலையும் தந்து.","err":null,"seers":[{"w":"நோயும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நோ"},{"k":"N","s":"யும்"}]},{"w":"பசலையும்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"பச"},{"k":"N","s":"லை"},{"k":"N","s":"யும்"}]},{"w":"தந்து.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தந்"},{"k":"N","s":"து"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]}]},{"n":1184,"ch":119,"l1":"உள்ளுவன் மன்யான் உரைப்பது அவர்திறமால்","l2":"கள்ளம் பிறவோ பசப்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"யான் அவருடைய நல்லியல்புகளை நினைக்கின்றேன்; யான் உரைப்பதும் அவற்றையே; அவ்வாறிருந்தும் பசலை வந்தது வஞ்சனையோ? வேறு வகையோ?","en":"I think (of him); and what I speak about is but his excellence; still is there sallowness; and this is deceitful","lines":[{"t":"உள்ளுவன் மன்யான் உரைப்பது அவர்திறமால்","err":null,"seers":[{"w":"உள்ளுவன்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"உள்"},{"k":"I","s":"ளுவன்"}]},{"w":"மன்யான்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மன்"},{"k":"N","s":"யான்"}]},{"w":"உரைப்பது","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"உரைப்"},{"k":"I","s":"பது"}]},{"w":"அவர்திறமால்","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அவர்"},{"k":"I","s":"திற"},{"k":"N","s":"மால்"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை","நிரையொன்றிய ஆசிரியத்தளை"]},{"t":"கள்ளம் பிறவோ பசப்பு.","err":null,"seers":[{"w":"கள்ளம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கள்"},{"k":"N","s":"ளம்"}]},{"w":"பிறவோ","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பிற"},{"k":"N","s":"வோ"}]},{"w":"பசப்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பசப்"},{"k":"N","s":"பு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1185,"ch":119,"l1":"உவக்காண்எம் காதலர் செல்வார் இவக்காண்என்","l2":"மேனி பசப்பூர் வது.","ok":true,"reseg":false,"eetru":"காசு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அதோ பார்! எம்முடைய காதலர் பிரிந்து செல்கின்றார்; இதோ பார்! என்னுடைய மேனியில் பசலை நிறம் வந்து படர்கிறது.","en":"Just as my lover departed then, did not sallowness spread here on my person ?","lines":[{"t":"உவக்காண்எம் காதலர் செல்வார் இவக்காண்என்","err":null,"seers":[{"w":"உவக்காண்எம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"உவக்"},{"k":"N","s":"காண்"},{"k":"N","s":"எம்"}]},{"w":"காதலர்","name":"கூவிளம்","cls":"விளம்","a":[{"k"