"k":"N","s":"ஆ"},{"k":"N","s":"வர்"}]},{"w":"எனின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"எனின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":1190,"ch":119,"l1":"பசப்பெனப் பேர்பெறுதல் நன்றே நயப்பித்தார்","l2":"நல்காமை தூற்றார் எனின்.","ok":true,"reseg":false,"eetru":"மலர்","boundary":["வெண்சீர் வெண்டளை"],"mv":"பிரிவுக்கு உடன்படச் செய்த காதலர் பிரிந்து வருத்துதலைப் பிறர் தூற்றாமல் இருப்பாரானால், யான் பசலை உற்றதாக பெயர் எடுத்தல் நல்லதே.","en":"It would be good to be said of me that I have turned sallow, if friends do not reproach with unkindness him who pleased me (then)","lines":[{"t":"பசப்பெனப் பேர்பெறுதல் நன்றே நயப்பித்தார்","err":null,"seers":[{"w":"பசப்பெனப்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"பசப்"},{"k":"I","s":"பெனப்"}]},{"w":"பேர்பெறுதல்","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"பேர்"},{"k":"I","s":"பெறு"},{"k":"N","s":"தல்"}]},{"w":"நன்றே","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நன்"},{"k":"N","s":"றே"}]},{"w":"நயப்பித்தார்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"நயப்"},{"k":"N","s":"பித்"},{"k":"N","s":"தார்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"நல்காமை தூற்றார் எனின்.","err":null,"seers":[{"w":"நல்காமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"நல்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"தூற்றார்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"தூற்"},{"k":"N","s":"றார்"}]},{"w":"எனின்.","name":"மலர்","cls":"ஓரசை","a":[{"k":"I","s":"எனின்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]}]