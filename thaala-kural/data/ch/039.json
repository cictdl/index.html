[{"n":381,"ch":39,"l1":"படைகுடி கூழ்அமைச்சு நட்பரண் ஆறும்","l2":"உடையான் அரசருள் ஏறு.","ok":true,"reseg":false,"eetru":"காசு","boundary":["இயற்சீர் வெண்டளை"],"mv":"படை குடி கூழ் அமைச்சு நட்பு அரண் என்று கூறப்படும் ஆறு அங்கங்களையும் உடையவனே அரசருள் ஆண் சிங்கம் போனறவன்.","en":"He who possesses these six things, an army, a people, wealth, ministers, friends and a fortress, is a lion among kings","lines":[{"t":"படைகுடி கூழ்அமைச்சு நட்பரண் ஆறும்","err":null,"seers":[{"w":"படைகுடி","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"படை"},{"k":"I","s":"குடி"}]},{"w":"கூழ்அமைச்சு","name":"கூவிளங்காய்","cls":"காய்","a":[{"k":"N","s":"கூழ்"},{"k":"I","s":"அமைச்"},{"k":"N","s":"சு"}]},{"w":"நட்பரண்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"நட்"},{"k":"I","s":"பரண்"}]},{"w":"ஆறும்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஆ"},{"k":"N","s":"றும்"}]}],"thalai":["இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"உடையான் அரசருள் ஏறு.","err":null,"seers":[{"w":"உடையான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"யான்"}]},{"w":"அரசருள்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"அர"},{"k":"I","s":"சருள்"}]},{"w":"ஏறு.","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஏ"},{"k":"N","s":"று"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":382,"ch":39,"l1":"அஞ்சாமை ஈகை அறிவூக்கம் இந்நான்கும்","l2":"எஞ்சாமை வேந்தர்க் கியல்பு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"அஞ்சாமை, ஈகை , அறிவுடைமை, ஊக்கமுடைமை இந்த நான்கு பண்புகளும் குறைவு படாமல் இருத்தலே அரசனுக்கு இயல்பாகும்.","en":"Never to fail in these four things, fearlessness, liberality, wisdom, and energy, is the kingly character","lines":[{"t":"அஞ்சாமை ஈகை அறிவூக்கம் இந்நான்கும்","err":null,"seers":[{"w":"அஞ்சாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"அஞ்"},{"k":"N","s":"சா"},{"k":"N","s":"மை"}]},{"w":"ஈகை","name":"தேமா","cls":"மா","a":[{"k":"N","s":"ஈ"},{"k":"N","s":"கை"}]},{"w":"அறிவூக்கம்","name":"புளிமாங்காய்","cls":"காய்","a":[{"k":"I","s":"அறி"},{"k":"N","s":"வூக்"},{"k":"N","s":"கம்"}]},{"w":"இந்நான்கும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இந்"},{"k":"N","s":"நான்"},{"k":"N","s":"கும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"எஞ்சாமை வேந்தர்க் கியல்பு.","err":null,"seers":[{"w":"எஞ்சாமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"எஞ்"},{"k":"N","s":"சா"},{"k":"N","s":"மை"}]},{"w":"வேந்தர்க்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"வேந்"},{"k":"N","s":"தர்க்"}]},{"w":"கியல்பு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"கியல்"},{"k":"N","s":"பு"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":383,"ch":39,"l1":"தூங்காமை கல்வி துணிவுடைமை இம்மூன்றும்","l2":"நீங்கா நிலனான் பவர்க்கு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"காலம் தாழ்த்தாத தன்மை, கல்வியுடைமை, துணிவுடைமை இந்த மூன்று பண்புகளும் நிலத்தை ஆளும் அரசனுக்கு நீங்காமல் இருக்க வேண்டியவை.","en":"These three things, viz, vigilance, learning, and bravery, should never be wanting in the ruler of a country","lines":[{"t":"தூங்காமை கல்வி துணிவுடைமை இம்மூன்றும்","err":null,"seers":[{"w":"தூங்காமை","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"தூங்"},{"k":"N","s":"கா"},{"k":"N","s":"மை"}]},{"w":"கல்வி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"கல்"},{"k":"N","s":"வி"}]},{"w":"துணிவுடைமை","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"துணி"},{"k":"I","s":"வுடை"},{"k":"N","s":"மை"}]},{"w":"இம்மூன்றும்","name":"தேமாங்காய்","cls":"காய்","a":[{"k":"N","s":"இம்"},{"k":"N","s":"மூன்"},{"k":"N","s":"றும்"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","வெண்சீர் வெண்டளை"]},{"t":"நீங்கா நிலனான் பவர்க்கு.","err":null,"seers":[{"w":"நீங்கா","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீங்"},{"k":"N","s":"கா"}]},{"w":"நிலனான்","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"நில"},{"k":"N","s":"னான்"}]},{"w":"பவர்க்கு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"பவர்க்"},{"k":"N","s":"கு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":384,"ch":39,"l1":"அறனிழுக்கா தல்லவை நீக்கி மறனிழுக்கா","l2":"மானம் உடைய தரசு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["வெண்சீர் வெண்டளை"],"mv":"ஆட்சி முறைக்கு உரிய அறத்தில் தவறாமல் அறமல்லாதவற்றை நீக்கி வீரத்தில் குறைபடாத மானத்தை உடையவனே சிறந்த அரசன் ஆவான்.","en":"He is a king who, with manly modesty, swerves not from virtue, and refrains from vice","lines":[{"t":"அறனிழுக்கா தல்லவை நீக்கி மறனிழுக்கா","err":null,"seers":[{"w":"அறனிழுக்கா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"அற"},{"k":"I","s":"னிழுக்"},{"k":"N","s":"கா"}]},{"w":"தல்லவை","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"தல்"},{"k":"I","s":"லவை"}]},{"w":"நீக்கி","name":"தேமா","cls":"மா","a":[{"k":"N","s":"நீக்"},{"k":"N","s":"கி"}]},{"w":"மறனிழுக்கா","name":"கருவிளங்காய்","cls":"காய்","a":[{"k":"I","s":"மற"},{"k":"I","s":"னிழுக்"},{"k":"N","s":"கா"}]}],"thalai":["வெண்சீர் வெண்டளை","இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]},{"t":"மானம் உடைய தரசு.","err":null,"seers":[{"w":"மானம்","name":"தேமா","cls":"மா","a":[{"k":"N","s":"மா"},{"k":"N","s":"னம்"}]},{"w":"உடைய","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"உடை"},{"k":"N","s":"ய"}]},{"w":"தரசு.","name":"புளிமா","cls":"மா","a":[{"k":"I","s":"தர"},{"k":"N","s":"சு"}]}],"thalai":["இயற்சீர் வெண்டளை","இயற்சீர் வெண்டளை"]}]},{"n":385,"ch":39,"l1":"இயற்றலும் ஈட்டலுங் காத்தலும் காத்த","l2":"வகுத்தலும் வல்ல தரசு.","ok":true,"reseg":false,"eetru":"பிறப்பு","boundary":["இயற்சீர் வெண்டளை"],"mv":"பொருள் வரும் வழிகளை மேன்மேலும் இயற்றலும் வந்த பொருள்களைச் சேர்த்தலும், காத்தலும் காத்தவற்றை வகுத்துச் செலவு செய்தலும் வல்லவன் அரசன்.","en":"He is a king who is able to acquire (wealth), to lay it up, to guard, and to distribute it","lines":[{"t":"இயற்றலும் ஈட்டலுங் காத்தலும் காத்த","err":null,"seers":[{"w":"இயற்றலும்","name":"கருவிளம்","cls":"விளம்","a":[{"k":"I","s":"இயற்"},{"k":"I","s":"றலும்"}]},{"w":"ஈட்டலுங்","name":"கூவிளம்","cls":"விளம்","a":[{"k":"N","s":"ஈட்"},{"k":"I","s":"டலுங்"}]},{"w":"காத்